# docgen.llt — Generate per-module Markdown docs for all stdlib modules.
#
# Walks every .llt file under stdlib/, traverses the parsed AST to extract
# exported bindings that carry doc annotations, and writes one .md file per
# module into %docdir.
#
# Uses native AST introspection via `load` (runtime-v2 Part F/G):
#   1. `load` source text → Program (macro-expanded, desugared)
#   2. program.documents → [Seq Document] (skip Type-stage docs)
#   3. Each doc's expressions → [Seq Expression]; take the last Dict expression
#   4. Dict.entries → [Seq Entry] where Entry has key: Expression, value: Expression
#   5. key: Var{name} or Annotated{name, annotation} → binding name + old-style doc
#   6. value: Fn{return-ann, params} → new-style doc + return type + param signatures
#
# The Annotation Variants exposed by load/surface_fields.rs now carry text content:
#   Simple     → payload {text: "TypeName" name: "TypeName"}
#   PropertyDict → payload {text: "..." doc: "..." return: "..."}  (doc/return when present)
#   Annotated  → payload {text: "Name@Inner" name: "Name" inner: "Inner"}
#
# This eliminates all text-parsing that the old docgen relied on.
#
# Usage (from project root via justfile):
#   just docgen

--- caps: [%docdir: @[[all DirCap Writable]]]

# ============================================================================
# Private helpers (not exported)
# ============================================================================

[

io: [include %libdir "io.llt"]

# ── File Discovery ────────────────────────────────────────────────────────

# Collect all .llt paths under a directory prefix (relative to %libdir).
# Returns a Seq of path strings like "strings.llt" or "codecs/json.llt".
scan-dir: [fn [let prefix@String acc]
  [call [fn [let entries]
    [reduce
      [fn [let files entry@[type: String  name: String]]
        [full: [if [= prefix ""] [str entry.name] [str prefix "/" entry.name]]]
        [if [= entry.type "dir"]
          [scan-dir full files]
          [if [ends-with? ".llt" entry.name]
            [cons full files]
            files]]]
      acc
      entries]]
    [collect [list-dir %libdir [if [= prefix ""] "." prefix]]]]]

llt-files: [sort [scan-dir "" []]]

# ── Annotation accessors ──────────────────────────────────────────────────
#
# Annotation Variants (from surface_fields.rs) now expose a payload Dict with:
#   Simple:       {text: "Name"  name: "Name"}
#   PropertyDict: {text: "..."   doc: "..."  return: "..."}  (doc/return optional)
#   Annotated:    {text: "A@B"   name: "A"   inner: "B"}
#
# Dot-access on a Variant auto-unpacks through the payload, so ann.text works.
# We use try-or for safe access when the annotation may be null (no annotation).

# Get the display text of an Annotation Variant (or "" if null/absent).
ann-text: [fn@String [let ann]
  [try-str [fn [let] ann.text]]]

# Get the doc: property from a PropertyDict Annotation (or "" if absent).
ann-doc: [fn@String [let ann]
  [try-str [fn [let] ann.doc]]]

# Get the return: property from a PropertyDict Annotation (or "" if absent).
ann-return-prop: [fn@String [let ann]
  [try-str [fn [let] ann.return]]]

# Safe string extraction: call f, return "" if it errors.
try-str: [fn@String [let f@[Fn@String []]]
  [try-or f ""]]

# Determine the return type text from a return-ann Annotation Variant.
#   Simple      → use ann.text directly (e.g. "String", "Bool")
#   PropertyDict with return: → use ann.return (the explicit return type)
#   PropertyDict without return: → use ann.text (the full display, e.g. "[return: X]")
#   null/absent → "Any"
return-type-text: [fn@String [let return-ann]
  [tag: [try-str [fn [let] [tag-of return-ann]]]]
  [if [= tag ""]
    "Any"
    [if [= tag "PropertyDict"]
      [call [fn@String [let ret@String]
        [if [= ret ""] [ann-text return-ann] ret]]
       [ann-return-prop return-ann]]
      # Simple or Annotated — use display text directly
      [ann-text return-ann]]]]

# ── Parameter signature ───────────────────────────────────────────────────

# Build a parameter signature string from a Parameter Variant.
# Parameter payload: {name: String  variadic: Bool  annotation: Annotation Variant}
# Returns: "name@Type" if typed, "...name" if variadic, "name" if untyped.
param-sig: [fn@String [let p]
  [name:     p.name]
  [variadic: p.variadic]
  [ann-t:    [ann-text p.annotation]]
  [prefix:   [if variadic "..." ""]]
  [if [= ann-t ""]
    [str prefix name]
    [str prefix name "@" ann-t]]]

# Build the full signature string for a Fn expression.
# fn-expr is a Value::Expression with tag "Fn".
# Dot-access via surface_node_get_field returns:
#   .return-ann → Annotation Variant (or null [] if no annotation)
#   .params     → positional Dict of Parameter Variants
build-sig: [fn@String [let fn-expr]
  [ret-text:   [return-type-text fn-expr.return-ann]]
  [params:     fn-expr.params]
  [param-part: [if [empty? params]
    ""
    [str " [let " [join " " [map param-sig params]] "]"]]]
  [str "fn@" ret-text param-part]]

# ── Doc string extraction ─────────────────────────────────────────────────

# Extract doc string from a Fn expression's return-ann (new-style: fn@[doc: "..."]).
fn-ann-doc: [fn@String [let fn-expr]
  [ann-doc fn-expr.return-ann]]

# Extract doc string from an Annotated key expression (old-style: name@[doc: "..."]).
key-ann-doc: [fn@String [let key-expr]
  [try-str [fn [let] [ann-doc key-expr.annotation]]]]

# ── Entry parsing ─────────────────────────────────────────────────────────

# Extract the binding name from a dict entry key Expression.
# Key can be Var{name} or Annotated{name, annotation}. Returns "" for anything else.
entry-name: [fn@String [let key-expr]
  [tag: [try-str [fn [let] [tag-of key-expr]]]]
  [if [= tag "Var"]
    [try-str [fn [let] key-expr.name]]
    [if [= tag "Annotated"]
      [try-str [fn [let] key-expr.name]]
      ""]]]

# Parse one dict Entry Variant into a doc record [name: String sig: String doc: String],
# or [] if the entry has no doc annotation or is not a documented function.
# Entry Variant: [Entry key: Expression value: Expression]
parse-entry: [fn@Dict [let entry]
  [key:   entry.key]
  [value: entry.value]
  [name:  [entry-name key]]
  [if [= name ""]
    []
    [call [fn@Dict [let value-tag@String]
      [if [= value-tag "Fn"]
        # value is a Fn expression. Check for new-style doc (fn@[doc: "..."]).
        [call [fn@Dict [let doc@String]
          [if [= doc ""]
            # No new-style doc — fall back to old-style key annotation: name@[doc: "..."]
            [call [fn@Dict [let key-tag@String]
              [if [= key-tag "Annotated"]
                [call [fn@Dict [let kdoc@String]
                  [if [= kdoc ""]
                    []  # no doc found anywhere — skip this entry
                    # Use fn to break letrec circularity ([name: name] would be circular).
                    [call [fn@Dict [let n d s] [name: n  doc: d  sig: s]]
                     name kdoc [build-sig value]]]]
                 [key-ann-doc key]]
                []]]  # plain Var key with no fn doc — not a documented entry
             [try-str [fn [let] [tag-of key]]]]
            # Found new-style doc
            # Use fn to break letrec circularity ([name: name  doc: doc] would be circular).
            [call [fn@Dict [let n d s] [name: n  doc: d  sig: s]]
             name doc [build-sig value]]]]
         [fn-ann-doc value]]
        []]]  # not a Fn — skip
     [try-str [fn [let] [tag-of value]]]]]]

# Extract all documented entries from one document's last Dict expression.
extract-from-doc: [fn [let doc]
  [exprs: [collect doc.expressions]]
  # Find the last Dict expression — that is the public API dict.
  [last-dict: [reduce
    [fn [let acc expr]
      [t: [try-str [fn [let] [tag-of expr]]]]
      [if [= t "Dict"] expr acc]]
    []
    exprs]]
  [if [null? last-dict]
    []
    [collect [filter
      [fn@Bool [let e] [has? "name" e]]  # filter out [] (skipped entries)
      [map parse-entry last-dict.entries]]]]]

# Extract documented bindings from a Program.
# Skips Type-stage documents. Concatenates entries from all Runtime documents.
extract-from-program: [fn [let program]
  [docs: program.documents]
  [reduce
    [fn [let acc doc]
      [stage-tag: [try-str [fn [let] [tag-of doc.stage]]]]
      [if [= stage-tag "Type"]
        acc
        [reduce [fn [let a e] [cons e a]] acc [extract-from-doc doc]]]]
    []
    docs]]

# ── Markdown Rendering ────────────────────────────────────────────────────

# Strip the ".llt" suffix to get the module name.
mod-name: [fn@String [let full-path@String]
  [get 0 [split ".llt" full-path]]]

# Convert a module name to a flat filename-safe string (replace "/" with "-").
mod-filename: [fn@String [let name@String]
  [join "-" [split "/" name]]]

# Render one doc entry as a Markdown subsection.
render-entry: [fn@String [let e]
  [str
    "\n### `" e.name "`\n\n"
    e.doc "\n\n"
    "```tinct\n"
    e.sig "\n"
    "```\n"]]

# ── Per-Module File Writing ───────────────────────────────────────────────

# Write content to %docdir/<filename>.md and return the module name.
write-module-file: [fn@String [let name@String content@String]
  [w: [@[] [io.write-file %docdir [str [mod-filename name] ".md"] content]]]
  [if [= w w] name name]]

# Load, parse, and write documentation for one stdlib file.
# Returns the module name, or "" if the file has no documented bindings.
write-module: [fn@String [let full-path@String]
  [source:  [str [join "\n" [collect [lines [open %libdir full-path Readable]]]]]]
  [program: [builtin-resolve [load source name: full-path]].resolved]
  [docs:    [extract-from-program program]]
  [name:    [mod-name full-path]]
  [if [empty? docs]
    ""
    [write-module-file name
      [str "# " name "\n"
           [join "" [map render-entry docs]]
           "\n"]]]]

]

# ── Index emission ────────────────────────────────────────────────────────

[emit [str
  "# tinct stdlib Reference\n\n"
  "Auto-generated by AST introspection via `load` in `scripts/docgen.llt`.\n\n"
  "## Modules\n\n"
  [join ""
    [map
      [fn [let name] [if [= name ""] "" [str "- [" name "](lib/" [mod-filename name] ".md)\n"]]]
      [map write-module llt-files]]]
  "\n"]]
