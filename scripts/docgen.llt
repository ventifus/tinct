# docgen.llt — Generate per-module Markdown docs for all stdlib modules.
#
# Walks every .llt file under stdlib/, extracts exported bindings that carry
# doc annotations, and writes one .md file per module into %docdir.
# Emits an index to stdout (redirected to doc/11b-reference.md by the justfile).
#
# Usage (from project root via justfile):
#   just docgen

--- caps: [%root: @DirCap  %docdir: @DirCap]

[
  strings: [include %libdir "strings.llt"]
  path:    [include %libdir "path.llt"]
]

[

# ── File Discovery ────────────────────────────────────────────────────────────

# Collect all .llt paths under a directory prefix (relative to %root).
# Returns a positional dict of path strings like "stdlib/strings.llt".
scan-dir: [fn@Dict [prefix@String acc@Dict]
  [entries: [collect [list-dir %root prefix]]]
  [reduce
    [fn@Dict [files@Dict entry@Dict]
      [full: [str prefix "/" entry.name]]
      [if [= entry.type "dir"]
        [scan-dir full files]
        [if [ends-with? entry.name ".llt"]
          [append files full]
          files]]]
    acc
    entries]]

llt-files: [sorted [scan-dir "stdlib" []]]

# ── Bracket Matching ──────────────────────────────────────────────────────────

# Find the index of the ']' that closes the '[' at position 0 of s.
# Call with depth=1, i=1 (already stepped past the opening '[').
# Returns -1 if unmatched or s is exhausted.
find-close: [fn@Int [s@String depth@Int i@Int]
  [c: [str-slice s i [trunc [+ i 1]]]]
  [if [>= i [length s]]
    -1
    [if [= c "["]
      [find-close s [trunc [+ depth 1]] [trunc [+ i 1]]]
      [if [= c "]"]
        [if [= depth 1] i [find-close s [trunc [- depth 1]] [trunc [+ i 1]]]]
        [find-close s depth [trunc [+ i 1]]]]]]]

# ── String Helpers ────────────────────────────────────────────────────────────

# Text before the first occurrence of needle (returns full s if absent).
before-first: [fn@String [needle@String s@String]
  [get 0 [split needle s]]]

# Text after the first occurrence of needle (returns "" if absent).
after-first: [fn@String [needle@String s@String]
  [parts: [split needle s]]
  [if [= [length parts] 1]
    ""
    [call [fn@String []
      [rest: [slice parts 1 [length parts]]]
      [join needle rest]]]]]

# ── Doc Entry Parsing ─────────────────────────────────────────────────────────

# Parse NEW fn@[return: T doc: "..."] pattern (single-line only).
# Returns [name: String sig: String doc: String] or [].
parse-new-fn: [fn@Dict [line@String]
  [if [not [str-contains? line "fn@["]]
    []
    [if [not [str-contains? line "doc:"]]
      []
      [call [fn@Dict []
        [key-part: [trim [before-first ":" line]]]
        [after-fn: [after-first "fn@[" line]]
        [return-type: [extract-return-from-metadata after-fn]]
        [params: [extract-params-from-line line]]
        [doc-text: [extract-doc-from-metadata after-fn]]
        [sig-text: [if [= params ""]
                [str "fn@" return-type]
                [str "fn@" return-type " [" params "]"]]]
        [name: key-part doc: doc-text sig: sig-text]]]]]]

# Extract return type from fn@[return: T ...] metadata.
extract-return-from-metadata: [fn@String [metadata@String]
  [if [starts-with? [trim metadata] "return:"]
    [call [fn@String []
      [after-return: [trim [after-first "return:" metadata]]]
      [trim [before-first " " after-return]]]]
    "Unknown"]]

# Extract doc string from fn@[... doc: "..."] metadata (first line only).
# Multi-line doc strings (triple-quoted) return just the first line.
extract-doc-from-metadata: [fn@String [metadata@String]
  [if [not [str-contains? metadata "doc:"]]
    ""
    [call [fn@String []
      [after-doc: [trim [after-first "doc:" metadata]]]
      [if [not [starts-with? after-doc "\""]]
        ""
        [call [fn@String []
          [after-quote: [str-slice after-doc 1 [length after-doc]]]
          [if [starts-with? after-quote "\"\""]
            [call [fn@String []
              [content: [trim [str-slice after-quote 2 [length after-quote]]]]
              [if [= content ""]
                "(multi-line doc string - see source)"
                [before-first "\"" content]]]]
            [before-first "\"" after-quote]]]]]]]]]

# Extract parameters from [let ...] portion of line.
extract-params-from-line: [fn@String [line@String]
  [if [not [str-contains? line "[let "]]
    ""
    [call [fn@String []
      [after-let: [after-first "[let " line]]
      [trim [before-first "]" after-let]]]]]]

# Parse OLD name@[doc: "..."] pattern (for backwards compatibility).
parse-old-doc: [fn@Dict [line@String]
  [if [not [str-contains? line "@[doc:"]]
    []
    [call [fn@Dict []
      [raw-key: [trim [before-first "@[doc:" line]]]
      [key-name: [if [starts-with? raw-key "["]
                   [str-slice raw-key 1 [length raw-key]]
                   raw-key]]
      [after-doc: [after-first "doc: \"" line]]
      [doc-text: [before-first "\"" after-doc]]
      [sig-text: [sig-from-old-line line]]
      [name: key-name doc: doc-text sig: sig-text]]]]]

# Build signature from OLD fn@Type [params] pattern.
sig-from-old-line: [fn@String [line@String]
  [if [not [str-contains? line "fn@"]]
    "(value)"
    [call [fn@String []
      [after-fn: [after-first "fn@" line]]
      [ret: [extract-return-old after-fn]]
      [params: [extract-params-old after-fn ret]]
      [if [= params ""]
        [str "fn@" ret]
        [str "fn@" ret " [" params "]"]]]]]]

extract-return-old: [fn@String [s@String]
  [t: [trim s]]
  [close: [find-close t 1 1]]
  [if [starts-with? t "["]
    [if [= close -1] t [str-slice t 0 [trunc [+ close 1]]]]
    [before-first " [" t]]]

extract-params-old: [fn@String [s@String ret@String]
  [after-ret: [trim [str-slice s [length ret] [length s]]]]
  [close: [find-close after-ret 1 1]]
  [if [starts-with? after-ret "["]
    [if [= close -1] "" [str-slice after-ret 1 close]]
    ""]]

# Try both NEW and OLD patterns on each line.
parse-doc-line: [fn@Dict [line@String]
  [new: [parse-new-fn line]]
  [if [not [empty? new]]
    new
    [parse-old-doc line]]]

# Extract all annotated bindings from file text (line-by-line).
extract-docs: [fn@Dict [text@String]
  [collect [filter
    [fn@Bool [e@Dict] [has? e "name"]]
    [map parse-doc-line [split "\n" text]]]]]

# ── Markdown Rendering ────────────────────────────────────────────────────────

# Strip the "stdlib/" prefix and ".llt" suffix to get the module name.
mod-name: [fn@String [full-path@String]
  [before-first ".llt" [after-first "stdlib/" full-path]]]

# Convert a module name to a flat filename-safe string (replace "/" with "-").
mod-filename: [fn@String [name@String]
  [join "-" [split "/" name]]]

# Render one doc entry as a Markdown subsection.
render-entry: [fn@String [e@Dict]
  [str
    "\n### `" e.name "`\n\n"
    e.doc "\n\n"
    "```tinct\n"
    e.sig "\n"
    "```\n"]]

# ── Per-Module File Writing ───────────────────────────────────────────────────

# Write content to %docdir/<filename>.md and return name.
write-module-file: [fn@String [name@String content@String]
  [w: [write %docdir [str [mod-filename name] ".md"] content]]
  [if [= w w] name name]]

# Write documentation for one stdlib file to %docdir and return the module name,
# or "" if the file has no annotated bindings.
write-module: [fn@String [full-path@String]
  [text: [str [slurp [open %root full-path "r"]]]]
  [docs: [extract-docs text]]
  [name: [mod-name full-path]]
  [if [empty? docs]
    ""
    [write-module-file name
      [str "# " name "\n"
           [join "" [map render-entry docs]]
           "\n"]]]]

]

[emit [str
  "# tinct stdlib Reference\n\n"
  "Auto-generated from `@[doc: \"...\"]` annotations in `stdlib/`.\n\n"
  "## Modules\n\n"
  [join ""
    [map
      [fn [name] [if [= name ""] "" [str "- [" name "](lib/" [mod-filename name] ".md)\n"]]]
      [map write-module llt-files]]]
  "\n"]]
