# ============================================================================
# LLT Standard Library (Prelude)
# ============================================================================
#
# TWO dict expressions in one document (public/private split):
#
# 1. Private helpers (first expression, not exported)
#    Pure internal recursive helpers. Only use Rust-native builtins and
#    sibling private helpers — never call public stdlib functions, because
#    at eval time the first dict is materialized before the second dict's
#    bindings exist in scope.
#    Uses builtin-get (not the get wrapper), builtin-if chains (not and/or),
#    and gte-impl (defined below) instead of >= (which is in the public dict).
#    Naming conventions:
#      -impl   Internal recursive helper with extra state arguments.
#      -step   Continuation passed to a Rust sequence builtin.
#      -check  Predicate helper that inspects an intermediate result.
#
# 2. Public API (second expression, exported)
#    All public stdlib functions, plus any private helpers that depend on
#    public functions (co-located for mutual recursion within letrec scope).
#    References private helpers from the first dict by plain name
#    (eval_document injects first-dict bindings into scope for subsequent
#    expressions, and the resolver models this scope chain).
#    Type declarations (like Result) register variant constructors (Ok, Err)
#    in the dict's letrec environment; these are re-exported as dict entries
#    to make them available to code that includes the prelude.
#
# These functions depend on the following Rust-native builtins being available
# in the parent environment:
#
#   Stable builtin-* aliases (used internally by prelude; cannot be shadowed):
#     See standard_builtins() in src/builtins.rs for the authoritative list.
#     Aliases used here include: builtin-lt  builtin-eq  builtin-add  builtin-sub
#     builtin-if  builtin-get  builtin-map  builtin-reduce  builtin-seq
#     builtin-head  builtin-tail  builtin-mul  builtin-div  builtin-filter
#     builtin-take  builtin-drop  builtin-collect  builtin-concat  builtin-join
#     builtin-rest  builtin-cons  builtin-sort
#
#   Primary-name shadowable wrappers (defined in public dict at end of file):
#     <  =  +  -  *  /  if  filter  map  reduce  take  drop
#     seq  head  tail  collect  range  repeat  cycle  iterate  unfold
#     join  concat  first  last  rest  cons  reverse  sort
#   These delegate to the builtin-* aliases above, allowing domain modules
#   to shadow the primary names via include while the prelude continues
#   to work correctly.
#
#   Non-shadowed Rust builtins (commonly used, partial list — see src/builtins.rs):
#     Dict:        keys  length  merge  append  builtin-get
#     Stringing:      str  split
#     Numeric:     floor
#     Runtime:     error  try  type-of
#     Sequences:   each  each-key  each-kv
#     Predicates:  int?  float?  num?  str?  bool?  null?  dict?  fn?  seq?
#
# Design patterns:
#   Shadowable wrappers — functions like <, =, +, if, filter, map etc.
#     wrap the corresponding builtin-* alias so domain stdlib modules can shadow
#     the primary name via include without breaking the prelude's own code.
#     See doc/11-stdlib.md §Rust-Native vs Tinct-Implemented Boundary.
#
#   O(n²) accumulator limitation — LLT-implemented accumulators (e.g. concat via
#     merge inside a fold) are O(n²) because each merge copies the growing
#     accumulator dict. Functions that must be O(n) are implemented as Rust
#     builtins (e.g. builtin_concat, reverse, sort). Prefer the Rust builtins
#     for large collections; the LLT wrappers are for composability and shadowing.
#
# ============================================================================

# ============================================================================
# FIRST DICT: Private helpers (not exported)
# ============================================================================
#
# CONSTRAINT: only Rust-native builtins and sibling helpers may be called here.
# Wrappers like get, >=, and, or, not, empty?, has?, reindex, contains? etc.
# are defined in the PUBLIC dict and are NOT in scope when this dict is evaluated.
#
# Workarounds used here:
#   gte-impl     private >= substitute using builtin-lt
#   builtin-get  instead of the get wrapper
#   builtin-if chains  instead of and/or

[

# ============================================================================
# Private arithmetic helpers
# ============================================================================

# Private >= substitute: a >= b ↔ NOT (a < b)
# Cannot use >= here because it's defined in the public dict.
gte-impl: [fn@Bool [a b] [builtin-if [builtin-lt a b] false true]]

# Internal helper — not part of the public API.
# Construct a single-entry dict from a computed key and value.
# Access expressions like [builtin-get i ks] can't appear in key position syntactically;
# passing through function params makes the key a plain k var_ref.
make-entry: [fn@Dict [k v] [$k: v]]

# `append` is a Rust-native builtin (O(1) amortized insert vs O(n) merge).

# ============================================================================
# Logic helpers (only depend on builtins + siblings)
# ============================================================================

any?-impl: [fn@Bool [pred@Fn xs@Dict ks i@Int len@Int]
    [builtin-if [gte-impl i len]
        false
        [builtin-if [pred [builtin-get [builtin-get i ks] xs]]
            true
            [any?-impl pred xs ks [builtin-add i 1] len]]]]

all?-impl: [fn@Bool [pred@Fn xs@Dict ks i@Int len@Int]
    [builtin-if [gte-impl i len]
        true
        [builtin-if [pred [builtin-get [builtin-get i ks] xs]]
            [all?-impl pred xs ks [builtin-add i 1] len]
            false]]]

# ============================================================================
# Control flow helpers (only depend on builtins + siblings)
# ============================================================================

cond-impl: [fn@Any [pairs@Dict i@Int]
    [builtin-if [gte-impl i [length pairs]]
        []
        [cond-check pairs i [builtin-get i pairs].0 [builtin-get i pairs].1]]]

cond-check: [fn@Any [pairs@Dict i@Int condition result]
    [builtin-if condition
        result
        [cond-impl pairs [builtin-add i 1]]]]

# ============================================================================
# Dict utilities helpers (only depend on builtins + siblings)
# ============================================================================

has?-impl: [fn@Bool [try-result]
    [match try-result
        [Ok _] true
        [Err _] false]]

remove-impl: [fn@Dict [xs@Dict ks exclude i@Int acc@Dict]
    [builtin-if [gte-impl i [length ks]]
        acc
        [remove-step xs ks exclude i acc [builtin-get i ks]]]]

remove-step: [fn@Dict [xs@Dict ks exclude i@Int acc@Dict current-key]
    [builtin-if [builtin-eq current-key exclude]
        [remove-impl xs ks exclude [builtin-add i 1] acc]
        [remove-impl xs ks exclude [builtin-add i 1]
            [merge acc [make-entry current-key [builtin-get current-key xs]]]]]]

values-impl: [fn@Dict [xs@Dict ks i@Int acc@Dict]
    [builtin-if [gte-impl i [length ks]]
        acc
        [values-step xs ks i acc [builtin-get i ks]]]]

values-step: [fn@Dict [xs@Dict ks i@Int acc@Dict current-key]
    [values-impl xs ks [builtin-add i 1]
        [append acc [builtin-get current-key xs]]]]

entries-impl: [fn@Dict [xs@Dict ks i@Int acc@Dict]
    [builtin-if [gte-impl i [length ks]]
        acc
        [entries-step xs ks i acc [builtin-get i ks]]]]

entries-step: [fn@Dict [xs@Dict ks i@Int acc@Dict current-key]
    [entries-impl xs ks [builtin-add i 1]
        [append acc [key: current-key value: [builtin-get current-key xs]]]]]

# ============================================================================
# List helpers (only depend on builtins + siblings)
# ============================================================================

nth-impl: [fn [xs@Dict ks n@Int len@Int]
    [builtin-get [builtin-get [builtin-if [builtin-lt n 0] [builtin-add len n] n] ks] xs]]

reindex-impl: [fn@Dict [xs@Dict ks i@Int acc@Dict]
    [builtin-if [gte-impl i [length ks]]
        acc
        [reindex-step xs ks i acc [builtin-get i ks]]]]

reindex-step: [fn@Dict [xs@Dict ks i@Int acc@Dict current-key]
    [reindex-impl xs ks [builtin-add i 1]
        [append acc [builtin-get current-key xs]]]]

# ============================================================================
# Universal collection helpers (only depend on builtins + siblings)
# ============================================================================

take-while-impl: [fn@Dict [pred@Fn xs@Dict ks i@Int acc@Dict]
    [builtin-if [gte-impl i [length ks]]
        acc
        [take-while-check pred xs ks i acc [builtin-get i ks]]]]

take-while-check: [fn@Dict [pred@Fn xs@Dict ks i@Int acc@Dict current-key]
    [builtin-if [pred [builtin-get current-key xs]]
        [take-while-impl pred xs ks [builtin-add i 1]
            [merge acc [make-entry current-key [builtin-get current-key xs]]]]
        acc]]

drop-while-impl: [fn@Dict [pred@Fn xs@Dict ks i@Int acc@Dict dropping@Bool]
    [builtin-if [gte-impl i [length ks]]
        acc
        [drop-while-check pred xs ks i acc dropping [builtin-get i ks]]]]

drop-while-check: [fn@Dict [pred@Fn xs@Dict ks i@Int acc@Dict dropping@Bool current-key]
    [builtin-if dropping
        [builtin-if [pred [builtin-get current-key xs]]
            [drop-while-impl pred xs ks [builtin-add i 1] acc true]
            [drop-while-impl pred xs ks [builtin-add i 1]
                [merge acc [make-entry current-key [builtin-get current-key xs]]]
                false]]
        [drop-while-impl pred xs ks [builtin-add i 1]
            [merge acc [make-entry current-key [builtin-get current-key xs]]]
            false]]]

map-entries-impl: [fn@Dict [f@Fn xs@Dict ks i@Int acc@Dict]
    [builtin-if [gte-impl i [length ks]]
        acc
        [map-entries-step f xs ks i acc [builtin-get i ks]]]]

map-entries-step: [fn@Dict [f@Fn xs@Dict ks i@Int acc@Dict current-key]
    [map-entries-impl f xs ks [builtin-add i 1]
        [merge acc
            [make-entry current-key
                [f [key: current-key value: [builtin-get current-key xs]]]]]]]

# zip-seq-impl: uses builtin-if chain instead of and
zip-seq-impl: [fn@Any [xs ys]
    [builtin-if [seq? xs]
        [builtin-if [seq? ys]
            [builtin-seq [[builtin-head xs] [builtin-head ys]]
                [zip-seq-impl [builtin-tail xs] [builtin-tail ys]]]
            []]
        []]]

# zip-dict-impl/zip-impl/zip-step: use builtin-if chain instead of or,
# and builtin-get instead of get wrapper
zip-dict-impl: [fn@Dict [xs@Dict ys@Dict]
    [zip-impl xs ys [keys xs] [keys ys] 0 []]]

zip-impl: [fn@Dict [xs@Dict ys@Dict xks yks i@Int acc@Dict]
    [builtin-if [gte-impl i [length xks]]
        acc
        [builtin-if [gte-impl i [length yks]]
            acc
            [zip-step xs ys xks yks i acc [builtin-get i xks] [builtin-get i yks]]]]]

zip-step: [fn@Dict [xs@Dict ys@Dict xks yks i@Int acc@Dict xk yk]
    [zip-impl xs ys xks yks [builtin-add i 1]
        [append acc [[builtin-get xk xs] [builtin-get yk ys]]]]]

# ============================================================================
# Higher-order helpers (only depend on builtins + siblings)
# ============================================================================

partition-step: [fn@Dict [acc@Dict e passes@Bool]
    [builtin-if passes
        [pass: [append acc.pass e]
         fail: acc.fail]
        [pass: acc.pass
         fail: [append acc.fail e]]]]

# ============================================================================
# Aggregate helpers (only depend on builtins + siblings)
# ============================================================================

# transpose-impl uses make-entry, merge, builtin-map — no public functions
transpose-impl: [fn@Dict [rows@Dict col-keys]
    [builtin-reduce
        [fn [acc col-key]
            [merge acc
                [make-entry col-key
                    [builtin-map [fn [row] [builtin-get col-key row]] rows]]]]
        []
        col-keys]]

# ============================================================================
# Error handling helpers (only depend on builtins + siblings)
# ============================================================================

try-or-impl: [fn [try-result default]
    [match try-result
        [Ok v] v
        [Err _] default]]

# ============================================================================
# Stringing search helpers (only depend on builtins + siblings)
# ============================================================================

str-find-impl: [fn@Int [haystack@Stringing needle@Stringing i@Int needle-len@Int haystack-len@Int]
    [builtin-if [builtin-lt i haystack-len]
        [str-find-check haystack needle i needle-len haystack-len]
        [builtin-sub 0 1]]]

str-find-check: [fn@Int [haystack@Stringing needle@Stringing i@Int needle-len@Int haystack-len@Int]
    [builtin-if [builtin-eq needle-len 0]
        0
        [builtin-if [builtin-lt [builtin-add i needle-len] [builtin-add haystack-len 1]]
            [builtin-if [builtin-eq [str-slice haystack i [builtin-add i needle-len]] needle]
                i
                [str-find-impl haystack needle [builtin-add i 1] needle-len haystack-len]]
            [str-find-impl haystack needle [builtin-add i 1] needle-len haystack-len]]]]

]

# ============================================================================
# SECOND DICT: Public API (exported)
# ============================================================================
#
# All public stdlib functions. Private helpers from the first dict are
# accessible by plain name (eval_document injects first-dict bindings into
# scope for subsequent expressions in the same document).
#
# Some internal helpers that depend on public functions also live here,
# co-located with the public functions they call (enabling mutual recursion
# within this dict's letrec scope).
#
# All entries in this dict can reference each other (letrec semantics) AND
# the private helpers defined in the first dict above.

[

# ============================================================================
# Identity
# ============================================================================

# Returns its argument unchanged.
# Type: (a -> a)
# Example: [identity 42] => 42
identity@[doc: "Return argument unchanged"]: [fn [x] x]

# Returns first argument, ignores second. Classic K combinator (K in SKI combinatorics).
# Type: (a -> b -> a)
# Example: [const "hello" "ignored"] => "hello"
# Example: [map [const 0] [1 2 3]] => [0 0 0]
const@[doc: "Return first argument, ignore second (K combinator)"]: [fn [x] [fn [y] x]]

# ============================================================================
# Logic
# ============================================================================

# Boolean negation. Materializes x; returns false if truthy, true if falsy.
# Type: (Any -> Bool)
# Example: [not true] => false
# Example: [not 0] => true
not@[doc: "Boolean negation"]: [fn@Bool [x] [builtin-if x false true]]

# Short-circuit AND: if a is false, b is never evaluated.
# Type: (Any -> a -> Union(a, Bool))
# Example: [and true "yes"] => "yes"
# Example: [and false [expensive]] => false   (expensive never called)
and@[doc: "Short-circuit AND"]: [fn@[a Bool] [p b@a] [builtin-if p b false]]

# Short-circuit OR: if a is truthy, returns a; otherwise returns b.
# Type: (Any -> Any -> Any)
# Example: [or 42 0] => 42
# Example: [or false "default"] => "default"
# NOTE: Both references to `a` in `[builtin-if a a b]` are bound to
# the same parameter — the parameter binding is shared, so the thunk is forced
# at most once (Launchbury 1993). The second reference is a cache hit.
# NOTE: `fn@Unknown` rather than `fn@a [a@a b@a]` because the two arguments
# need not be the same type — `[or nil "default"]` is a common use case.
# A homogeneous-type annotation would emit spurious type errors on mixed-type callers.
or@[doc: "Short-circuit OR"]: [fn@Unknown [a b] [builtin-if a a b]]

# Short-circuit predicate test: returns true if any element satisfies pred.
# Type: ((a -> Bool) -> Dict a -> Bool)
# Errors if xs is a Seq (collect first).
# Example: [any? [fn [x] [> x 0]] [1 -2 3]] => true
# Inherently materializing: short-circuits but materializes elements until condition met.
any?@[doc: "True if any element satisfies predicate"]: [fn@Bool [pred@Fn xs@Dict]
    [builtin-if [seq? xs]
        [error "any?: expected Dict, got Seq -- collect the Seq first"]
        [any?-impl pred xs [keys xs] 0 [length xs]]]]

# Short-circuit predicate test: returns true if all elements satisfy pred.
# Type: ((a -> Bool) -> Dict a -> Bool)
# Errors if xs is a Seq (collect first).
# Example: [all? [fn [x] [> x 0]] [1 2 3]] => true
# Inherently materializing: short-circuits but materializes elements until condition failed.
all?@[doc: "True if all elements satisfy predicate"]: [fn@Bool [pred@Fn xs@Dict]
    [builtin-if [seq? xs]
        [error "all?: expected Dict, got Seq -- collect the Seq first"]
        [all?-impl pred xs [keys xs] 0 [length xs]]]]

# ============================================================================
# Comparison (derived from < and =)
# ============================================================================

# Greater than. Derived by swapping arguments of builtin-lt.
# Type: (Comparable -> Comparable -> Bool)
>@[doc: "Greater than"]: [fn@[return: Bool constraint: [a: Comparable]] [x@a y@a] [builtin-lt y x]]

# Less than or equal. Derived as negation of >.
# Type: (Comparable -> Comparable -> Bool)
<=@[doc: "Less than or equal"]: [fn@[return: Bool constraint: [a: Comparable]] [x@a y@a] [not [builtin-lt y x]]]

# Greater than or equal. Derived as negation of <.
# Type: (Comparable -> Comparable -> Bool)
>=@[doc: "Greater than or equal"]: [fn@[return: Bool constraint: [a: Comparable]] [x@a y@a] [not [builtin-lt x y]]]

# ============================================================================
# Arithmetic (derived from builtin-add, builtin-sub, builtin-mul, builtin-div)
# ============================================================================

# Integer quotient: truncates toward zero (like Clojure's quot).
# Type: (Number -> Number -> Int)
# Uses builtin-div (float division) then trunc (toward-zero truncation to Int).
# Example: [quot 7 2] => 3
# Example: [quot -7 2] => -3
# Contrast with floor-div (truncates toward negative infinity) which does not exist in LLT.
# Inherently materializing: derived from arithmetic operations.
quot@[doc: "Integer quotient (truncate toward zero)"]: [fn@Int [a@Number b@Number] [trunc [builtin-div a b]]]

# Integer remainder with the same sign as the dividend (a), NOT the divisor.
# Type: (Number -> Number -> Number)
# Uses the algebraic identity: mod(a, b) = a - (quot(a, b) * b).
# Clojure/Haskell-rem semantics. Contrast with Python `%` / Haskell `mod` (sign of divisor).
# Example: [mod 7 3] => 1
# Example: [mod -7 3] => -1
# Example: [mod 7 -3] => 1
# Inherently materializing: derived from arithmetic operations.
mod@[doc: "Integer remainder (sign of dividend)"]: [fn@Number [a@Number b@Number] [builtin-sub a [builtin-mul [quot a b] b]]]

# ============================================================================
# Numeric Conversion (derived from floor, round, builtin-add, builtin-sub)
# ============================================================================

# Ceiling: smallest integer >= x. Derived as -floor(-x).
# Type: (Number -> Int)
# Example: [ceil 3.2] => 4
# Example: [ceil -3.2] => -3
# Inherently materializing: derived from arithmetic operations.
ceil@[doc: "Ceiling (smallest integer >= x)"]: [fn@Int [x@Number] [builtin-sub 0 [floor [builtin-sub 0 x]]]]

# Truncate toward zero: floor for non-negative, ceil for negative.
# Type: (Number -> Int)
# Example: [trunc 3.7] => 3
# Example: [trunc -3.7] => -3
# Inherently materializing: derived from arithmetic operations.
trunc@[doc: "Truncate toward zero"]: [fn@Int [x@Number] [builtin-if [>= x 0] [floor x] [ceil x]]]

# Absolute value: non-negative magnitude. Returns -x for negative, x otherwise.
# Type: (Number -> Number)
# Example: [abs -5] => 5
# Example: [abs 3.14] => 3.14
# Inherently materializing: derived from comparison and arithmetic.
abs@[doc: "Absolute value"]: [fn@Number [x@Number] [builtin-if [builtin-lt x 0] [builtin-sub 0 x] x]]

# Sign of a number: -1 for negative, 0 for zero, 1 for positive.
# Type: (Number -> Int)
# Example: [sign -42] => -1
# Example: [sign 0] => 0
# Example: [sign 3.14] => 1
# Inherently materializing: derived from comparison and arithmetic.
sign@[doc: "Sign of number (-1, 0, or 1)"]: [fn@Int [x@Number]
    [cond [
        [[builtin-lt x 0] [builtin-sub 0 1]]
        [[builtin-eq x 0] 0]
        [true 1]]]]

# Clamp a value between lo and hi bounds (inclusive).
# Returns lo if x < lo, hi if x > hi, otherwise x.
# Type: (Number -> Number -> Number -> Number)
# Example: [clamp 0 10 -5] => 0
# Example: [clamp 0 10 15] => 10
# Example: [clamp 0 10 7] => 7
# Inherently materializing: derived from comparison operations.
clamp@[doc: "Clamp value between bounds (inclusive)"]: [fn@Number [lo@Number hi@Number x@Number]
    [builtin-if [builtin-lt x lo]
        lo
        [builtin-if [builtin-lt hi x]
            hi
            x]]]

# ============================================================================
# Stringing (derived from str, split, builtin-filter, builtin-eq)
# ============================================================================

# join: delegates to builtin-join (see wrappers section at bottom of this dict).
# O(n) performance, dual-dispatch on Dict/Seq. Example: [join ", " ["a" "b"]] => "a, b"

# Split a string on spaces, filtering empty strings. Returns a Seq of words.
# Type: (Stringing -> Seq Stringing)
# Example: [collect [words "hello world"]] => ["hello" "world"]
# Example: [collect [words "  spaces  "]] => ["spaces"]
# Inherently materializing: splits string content, derived from split.
words@[doc: "Split string on spaces into words"]: [fn@Seq [s@Stringing]
    [builtin-filter [fn [w] [not [builtin-eq w ""]]] [split " " s]]]

# Stringip common leading indentation from a multi-line string.
# Algorithm: split into lines; the last line (whitespace-only) determines indent depth;
# strip that many characters from each content line; drop first (empty) and last (anchor) lines.
# Type: (Stringing -> Stringing)
# Example: [unindent "\n  line one\n  line two\n  "] => "line one\nline two"
# Inherently materializing: must process all lines to determine indentation and strip.
unindent@[doc: "Stringip common leading indentation from a multi-line string"]: [fn@Stringing [s@Stringing]
    [ls: [split "\n" s]
     last-line: [builtin-last ls]
     indent: [str-length last-line]
     strip-line: [fn [l] [builtin-if [builtin-lt [str-length l] indent] "" [str-slice l indent [str-length l]]]]
     inner: [slice ls 1 [builtin-sub [length ls] 1]]]
    [builtin-join "\n" [builtin-map strip-line inner]]]

# ============================================================================
# Control Flow
# ============================================================================

# Evaluates body if pred is true, otherwise returns [].
# assert: [when true result] => result
# assert: [when false result] => []
when@[doc: "Evaluate body if predicate is true"]: [fn@[a Null] [pred body@a] [builtin-if pred body []]]

# Evaluates body if pred is false, otherwise returns [].
# assert: [unless false result] => result
# assert: [unless true result] => []
unless@[doc: "Evaluate body if predicate is false"]: [fn@[a Null] [pred body@a] [builtin-if pred [] body]]

# Multi-branch conditional. Takes a list of [condition result] pairs.
# Returns [] (empty dict) when no branch matches.
# Usage: [cond [
#   [[> x 10] "big"]
#   [[> x 0]  "positive"]
#   [true     "other"]
# ]]
cond@[doc: "Multi-branch conditional"]: [fn@[a Null] [pairs@Dict] [cond-impl pairs 0]]

# until: Moved to Rust builtin to avoid recursion depth limit.
# The LLT recursive version hit MAX_EVAL_DEPTH at ~230 iterations.
# Now implemented as until in src/builtins.rs with unlimited iterations.

# ============================================================================
# Dict Utilities
# ============================================================================

# Get value by key from a dict.
# Signature: Key → Dict → Any (curried for pipeline composition)
# assert: [get "b" [a: 1  b: 2]] => 2
get@[doc: "Get value by key with error if missing"]: [fn@Unknown [k xs@Dict] [builtin-get k xs]]

# Check if a key exists in a dict. Uses try around get access.
# assert: [has? [x: 1] "x"] => true
# assert: [has? [x: 1] "y"] => false
has?@[doc: "Check if dict has key"]: [fn@Bool [xs@Dict k]
    [has?-impl [try [fn [] [get k xs]]]]]

# Get value by key with a default if key is missing.
# assert: [get-or [x: 1] "x" 99] => 1
# assert: [get-or [x: 1] "y" 99] => 99
get-or@[doc: "Get value by key with default"]: [fn@a [xs@Dict k default@a]
    [builtin-if [has? xs k] [get k xs] default]]

# Traverse nested dicts by a list of keys.
# Returns error when any intermediate key is missing.
# Use get-in-or for a default fallback on missing keys.
# Usage: [get-in data [key1 key2 key3]]
# Inherently materializing: must traverse nested dict path, accessing each level.
get-in@[doc: "Get nested value by path"]: [fn@Unknown [xs path@Dict]
    [builtin-if [builtin-eq [length path] 0]
        xs
        [builtin-if [has? xs path.0]
            [get-in [get path.0 xs] [builtin-rest path]]
            [error [str "key not found: " path.0]]]]]

# Traverse nested dicts by a list of keys with a default fallback.
# Returns default when any intermediate key is missing.
# Usage: [get-in-or data [key1 key2 key3] fallback]
# Inherently materializing: must traverse nested dict path, accessing each level.
get-in-or@[doc: "Get nested value by path with default"]: [fn@Unknown [xs path@Dict default]
    [builtin-if [builtin-eq [length path] 0]
        xs
        [builtin-if [has? xs path.0]
            [get-in-or [get path.0 xs] [builtin-rest path] default]
            default]]]

# Check if a collection is empty.
# Seq values are never empty (always have a head), so return false immediately.
# Inherently materializing: depends on length which counts all entries.
# assert: [empty? []] => true
# assert: [empty? [1 2 3]] => false
empty?@[doc: "Check if collection is empty"]: [fn@Bool [xs] [builtin-if [seq? xs] false [builtin-eq [length xs] 0]]]

# Construct a single-entry dict from a computed key and a value.
# Used internally by set, from-entries, and domain modules that build dicts programmatically.
# assert: [make-entry "x" 42] => [x: 42]
make-entry@[doc: "Construct single-entry dict from key and value"]: [fn@Dict [k v] [$k: v]]

# Set a key in a dict (returns new dict with key added/updated).
# assert: [set [a: 1] "b" 2] => [a: 1  b: 2]
set@[doc: "Set key in dict"]: [fn@Dict [xs@Dict k v] [merge xs [make-entry k v]]]

# Remove a key from a dict (preserves remaining keys).
# assert: [remove [a: 1  b: 2  c: 3] "b"] => [a: 1  c: 3]
remove@[doc: "Remove key from dict"]: [fn@Dict [xs@Dict k] [remove-impl xs [keys xs] k 0 []]]

# Update a key by applying a function to its current value.
# assert: [update [x: 5] "x" [fn [v] [+ v 1]]] => [x: 6]
update@[doc: "Update dict value by applying function"]: [fn@Dict [xs@Dict k f@Fn]
    [set xs k [f [get k xs]]]]

# Get all values from a dict as an integer-indexed list.
# Preserves dict insertion order: values are returned in the same order as keys.
# assert: [values [a: 10  b: 20]] => [10 20]
values@[doc: "Get all dict values as list"]: [fn@Dict [xs@Dict] [values-impl xs [keys xs] 0 []]]

# Get all entries as a list of [key: k  value: v] dicts.
# Preserves dict insertion order: entries appear in the same order as the source dict.
entries@[doc: "Get all entries as key-value pairs"]: [fn@Dict [xs@Dict] [entries-impl xs [keys xs] 0 []]]

# Reconstruct a dict from a list of [key: k value: v] pairs. Inverse of entries.
from-entries@[doc: "Reconstruct dict from key-value pairs"]: [fn@Dict [pairs] [builtin-reduce [fn [acc pair] [merge acc [make-entry pair.key pair.value]]] [] pairs]]

# ============================================================================
# List Operations (integer keys, dense 0..n output)
# ============================================================================

# Get the first element of a list, first character of a string, or first byte of Bytes (as Int).
# first: delegates to builtin-first (see wrappers section at bottom of this dict).
# assert: [first [10 20 30]] => 10
# assert: [first "hello"] => "h"
# assert: [first (str-bytes "A")] => 65

# Get the nth element by insertion-order position.
# Supports negative indices: -1 is last, -2 is second-to-last, etc.
# assert: [nth [10 20 30] 1] => 20
# assert: [nth [10 20 30] -1] => 30
nth@[doc: "Get nth element (supports negative indices)"]: [fn [xs@Dict n@Int]
    [nth-impl xs [keys xs] n [length xs]]]

# Get the last element by insertion-order position, last character of a string, or last byte of Bytes (as Int).
# last: delegates to builtin-last (see wrappers section at bottom of this dict).
# assert: [last [10 20 30]] => 30
# assert: [last "hello"] => "o"
# assert: [last (str-bytes "Z")] => 90

# rest: delegates to builtin-rest (see wrappers section at bottom of this dict).
# cons: delegates to builtin-cons (see wrappers section at bottom of this dict).

# Append an element to the end of a list. Delegates to append.
# Type: (Dict a -> a -> Dict a)
# Example: [conj [1 2 3] 4] => [1 2 3 4]
conj@[doc: "Append element to end of list"]: [fn@Dict [xs@Dict x] [append xs x]]

# concat, reverse, sort: delegate to their builtin-* aliases (see wrappers section).

# Rebuild a collection with dense 0..n integer keys, preserving values and insertion order.
# Useful after drop or sparse slicing to normalize key numbering.
# Type: (Dict a -> Dict a)
# Example: [reindex [a: 1 b: 2 c: 3]] => [0: 1 1: 2 2: 3]
# Inherently materializing: must traverse all entries.
reindex@[doc: "Rebuild with dense 0..n integer keys"]: [fn@Dict [xs@Dict] [reindex-impl xs [keys xs] 0 []]]

# ============================================================================
# Sorting (Mergesort)
# ============================================================================

# sort: delegates to builtin-sort (see wrappers section at bottom of this dict).
# O(n log n) natural ordering mergesort. Errors on Seq input (collect first).
# Example: [sort [3 1 2]] => [1 2 3]
# Example: [sort ["c" "a" "b"]] => ["a" "b" "c"]

# sort-merge depends on empty? (public) — lives in the public dict for mutual recursion.
sort-merge@[doc: "Merge two sorted lists (internal helper)"]: [fn@Dict [cmp@Fn left@Dict right@Dict]
    [builtin-if [empty? left]
        right
        [builtin-if [empty? right]
            left
            [builtin-if [cmp left.0 right.0]
                [builtin-cons left.0 [sort-merge cmp [builtin-rest left] right]]
                [builtin-cons right.0 [sort-merge cmp left [builtin-rest right]]]]]]]

# Sort a list using a custom comparator (mergesort, stable).
# Type: ((a -> a -> Bool) -> Dict a -> Dict a)
# cmp is a less-than function: [cmp a b] returns true if a should come before b.
# Example: [sort-by [fn [a b] [> a b]] [3 1 2]] => [3 2 1]  (descending)
# Inherently materializing: must compare values to determine order.
sort-by@[doc: "Sort with custom comparator"]: [fn@Dict [cmp@Fn xs@Dict]
    [builtin-if [seq? xs]
        [error "sort-by: expected Dict, got Seq -- collect the Seq first"]
        [builtin-if [<= [length xs] 1]
            xs
            [sort-merge cmp
                [sort-by cmp [builtin-take [quot [length xs] 2] xs]]
                [sort-by cmp [reindex [builtin-drop [quot [length xs] 2] xs]]]]]]]

# Like Python's sorted() — accepts both Seq and Dict; collects a Seq first.
# Type: (Seq a | Dict Comparable -> Dict Comparable)
# Example: [sorted [filter [fn [x] [> x 2]] [1 3 2 4]]] => [3 4]
# Example: [sorted [3 1 2]] => [1 2 3]
sorted@[doc: "Sort collection in ascending order"]: [fn@Dict [xs]
    [builtin-sort [builtin-if [seq? xs] [builtin-collect xs] xs]]]

# Like sorted, with a custom comparator.
# Type: ((a -> a -> Bool) -> Seq a | Dict a -> Dict a)
# Example: [sorted-by [fn [a b] [> a b]] [filter [fn [x] [> x 0]] [-1 3 -2 4]]] => [4 3]
sorted-by@[doc: "Sort with custom comparator (accepts Seq or Dict)"]: [fn@Dict [cmp@Fn xs]
    [sort-by cmp [builtin-if [seq? xs] [builtin-collect xs] xs]]]

# ============================================================================
# Universal Collection Operations (preserve keys)
# ============================================================================

# reduce, drop, map, filter are Rust-native builtins (dual-dispatch on Dict/Seq).
# See src/builtins.rs for implementations.

# Take elements from the beginning while predicate holds; stop at first failure.
# Type: ((a -> Bool) -> Dict a -> Dict a)
# Returns the longest prefix of xs where all elements satisfy pred.
# Example: [take-while [fn [x] [< x 3]] [1 2 3 4]] => [0: 1  1: 2]
# Inherently materializing: must check elements until predicate fails.
take-while@[doc: "Take elements while predicate holds"]: [fn@Dict [pred@Fn xs@Dict]
    [builtin-if [seq? xs]
        [error "take-while: expected Dict, got Seq -- collect the Seq first"]
        [take-while-impl pred xs [keys xs] 0 []]]]

# Drop elements from the beginning while predicate holds.
# Type: ((a -> Bool) -> Dict a -> Dict a)
# Returns the remaining suffix starting from the first element that fails pred.
# Example: [drop-while [fn [x] [< x 3]] [1 2 3 4]] => [2: 3  3: 4]
# Inherently materializing: must check elements until predicate fails.
drop-while@[doc: "Drop elements while predicate holds"]: [fn@Dict [pred@Fn xs@Dict]
    [builtin-if [seq? xs]
        [error "drop-while: expected Dict, got Seq -- collect the Seq first"]
        [drop-while-impl pred xs [keys xs] 0 [] true]]]

# Apply a function to every [key: k value: v] entry dict, returning new values under same keys.
# Type: (([key: k value: a] -> b) -> Dict a -> Dict b)
# The function f receives the entry dict and must return the NEW VALUE (not a new entry dict).
# Keys are preserved unchanged.
# Example: [map-entries [fn [e] [* e.value 2]] [a: 1 b: 2]] => [a: 2 b: 4]
# Example: [map-entries [fn [e] e.key] [x: 10 y: 20]] => [x: "x" y: "y"]
map-entries@[doc: "Apply function to each key-value entry"]: [fn@Dict [f@Fn xs@Dict] [map-entries-impl f xs [keys xs] 0 []]]

# Left fold: alias for reduce (Rust-native builtin, dual-dispatch on Dict/Seq).
# Type: ((b -> a -> b) -> b -> Dict a -> b)
# fold and reduce are identical — use whichever name fits your context.
# Both are left folds: f receives (accumulator, element) and the result becomes
# the new accumulator. Starting accumulator is init.
# Example: [fold [fn [acc x] [+ acc x]] 0 [1 2 3 4]] => 10
# NOTE: f@Fn is under-constrained. Ideally f@Fn@a [a Any] to enforce accumulator
# signature, but parameterized function types are not yet expressible.
fold@[doc: "Left fold (alias for reduce)"]: [fn@a [f@Fn init@a xs] [builtin-reduce f init xs]]

# Take a slice by position (start inclusive, end exclusive). Preserves original keys.
# Type: (Dict a -> Int -> Int -> Dict a)
# Example: [slice [a: 1 b: 2 c: 3 d: 4] 1 3] => [b: 2 c: 3]
# slice-impl and slice-step depend on and (public) — live in the public dict.
slice-impl@[doc: "Slice implementation (internal helper)"]: [fn@Dict [xs@Dict ks start@Int end@Int i@Int acc@Dict]
    [builtin-if [gte-impl i [length ks]]
        acc
        [builtin-if [and [gte-impl i start] [builtin-lt i end]]
            [slice-step xs ks start end i acc [get i ks]]
            [slice-impl xs ks start end [builtin-add i 1] acc]]]]

slice-step@[doc: "Slice step (internal helper)"]: [fn@Dict [xs@Dict ks start@Int end@Int i@Int acc@Dict current-key]
    [slice-impl xs ks start end [builtin-add i 1]
        [merge acc [make-entry current-key [get current-key xs]]]]]

slice@[doc: "Take slice by position (preserves keys)"]: [fn@Dict [xs@Dict start@Int end@Int] [slice-impl xs [keys xs] start end 0 []]]

# Pair entries from two collections by position. Returns a list of pairs.
# If both xs and ys are Seq: lazy Seq of pairs.
# Otherwise: collect Seqs to Dicts, then use eager zip-dict-impl.
# annotation deferred to hkt-mappable-appendable
zip@[doc: "Pair entries from two collections by position"]: [fn@Unknown [xs ys]
    [builtin-if [and [seq? xs] [seq? ys]]
        [zip-seq-impl xs ys]
        [zip-dict-impl
            [builtin-if [seq? xs] [builtin-collect xs] xs]
            [builtin-if [seq? ys] [builtin-collect ys] ys]]]]

# Flatten nested lists one level deep.
# flatten-impl/flatten-step depend on reindex (public) — live in public dict.
# Inherently materializing: must inspect each value to check if it is a list.
flatten-impl@[doc: "Flatten implementation (internal helper)"]: [fn@Dict [xs@Dict ks i@Int acc@Dict]
    [builtin-if [gte-impl i [length ks]]
        acc
        [flatten-step xs ks i acc [get i ks]]]]

flatten-step@[doc: "Flatten step (internal helper)"]: [fn@Dict [xs@Dict ks i@Int acc@Dict current-key]
    [builtin-if [dict? [get current-key xs]]
        [flatten-impl xs ks [builtin-add i 1]
            [builtin-concat acc [reindex [get current-key xs]]]]
        [flatten-impl xs ks [builtin-add i 1]
            [append acc [get current-key xs]]]]]

flatten@[doc: "Flatten nested lists one level deep"]: [fn@Dict [xs@Dict]
    [builtin-if [seq? xs]
        [error "flatten: expected Dict, got Seq -- collect the Seq first"]
        [flatten-impl xs [keys xs] 0 []]]]

# Recursively search for a key in nested dicts.
# find-deep helpers depend on find-deep and get (public) — live in public dict.
# Inherently materializing: must traverse nested structure recursively to search.
find-deep-impl@[doc: "Find-deep implementation (internal helper)"]: [fn@Any [xs@Dict target ks i@Int]
    [builtin-if [gte-impl i [length ks]]
        [error [str "key not found: " target]]
        [find-deep-check xs target ks i [get i ks]]]]

find-deep-check@[doc: "Find-deep check (internal helper)"]: [fn@Any [xs@Dict target ks i@Int current-key]
    [builtin-if [builtin-eq current-key target]
        [get current-key xs]
        [builtin-if [dict? [get current-key xs]]
            [find-deep-try [get current-key xs] target xs ks i]
            [find-deep-impl xs target ks [builtin-add i 1]]]]]

find-deep-try@[doc: "Find-deep try (internal helper)"]: [fn@Any [subtree@Dict target parent@Dict ks i@Int]
    [find-deep-try-check
        [try [fn [] [find-deep subtree target]]]
        parent target ks i]]

find-deep-try-check@[doc: "Find-deep try-check (internal helper)"]: [fn@Any [result parent@Dict target ks i@Int]
    [match result
        [Ok v] v
        [Err _] [find-deep-impl parent target ks [builtin-add i 1]]]]

find-deep@[doc: "Recursively search for key in nested dicts"]: [fn@Any [xs@Dict target]
    [find-deep-impl xs target [keys xs] 0]]

# ============================================================================
# Higher-Order Dict/List Utilities
# ============================================================================

# Transform a dict via entries: entries → map(f) → from-entries.
# Each entry passed to f has the shape [key: k value: v].
with-entries@[doc: "Transform dict via entries pipeline"]: [fn@Dict [xs@Dict f@Fn] [from-entries [builtin-map f [entries xs]]]]

# Split a collection into two groups: elements satisfying pred and those that do not.
# Type: ((a -> Bool) -> Dict a -> [pass: Dict a  fail: Dict a])
# Returns a dict with keys `pass` (matching) and `fail` (non-matching).
# Both groups are integer-keyed dicts (eager, not Seqs) for predictable downstream use.
# Example: [partition [fn [x] [> x 0]] [1 -2 3 -4]] => [pass: [1 3]  fail: [-2 -4]]
partition@[doc: "Split collection into pass/fail groups"]: [fn@Dict [pred@Fn xs]
    [builtin-reduce
        [fn [acc e]
            [partition-step acc e [pred e]]]
        [pass: []  fail: []]
        xs]]

# Map a function over a collection and flatten (concatenate) the results.
# Type: ((a -> Dict b) -> Dict a -> Dict b)
# f must return a collection for each element; results are concatenated.
# Example: [flat-map [fn [x] [$x [* x 2]]] [1 2 3]] => [1 2 2 4 3 6]
# Uses concat to accumulate the results of f, avoiding Seq/Dict flush issues.
# Inherently materializing: f must return collections that can be concatenated.
flat-map@[doc: "Map and flatten results"]: [fn@Dict [f@Fn xs]
    [builtin-reduce [fn [acc x] [builtin-concat acc [f x]]] [] xs]]

# Return the first element satisfying pred, or error if none found.
# filter on Dict returns a Seq; head gets the first element (errors if Seq is empty).
find-first@[doc: "Find first element matching predicate; errors if none found"]: [fn@a [pred@Fn xs] [builtin-head [builtin-filter pred xs]]]

# Return the first element satisfying pred, or default if none found.
find-first-or@[doc: "Find first matching element or return default"]: [fn@a [pred@Fn default@a xs]
    [try-or [fn [] [find-first pred xs]] default]]

# Group elements of xs into a dict of lists, keyed by the result of applying f.
# Elements with the same key are collected together (insertion order preserved).
# Inherently materializing: must inspect all elements.
# group-by-step depends on get-or (public) — lives in public dict.
group-by-step@[doc: "Group-by step (internal helper)"]: [fn@Dict [acc@Dict x k]
    [merge acc
        [make-entry k
            [append [get-or acc k []] x]]]]

group-by@[doc: "Group elements by function result"]: [fn@Dict [f@Fn xs]
    [builtin-reduce
        [fn [acc x]
            [group-by-step acc x [f x]]]
        []
        xs]]

# Merge two dicts recursively. Sub-dicts are merged depth-first;
# all other values from b override a (right-biased at each level).
# Inherently materializing: must inspect values to determine if they are dicts.
# deep-merge-step depends on has?/get/deep-merge (public) — lives in public dict.
deep-merge-step@[doc: "Deep-merge step (internal helper)"]: [fn@Dict [acc@Dict a@Dict b@Dict k]
    [merge acc
        [make-entry k
            [builtin-if
                [and
                    [has? a k]
                    [and
                        [dict? [get k a]]
                        [dict? [get k b]]]]
                [deep-merge [get k a] [get k b]]
                [get k b]]]]]

deep-merge@[doc: "Merge dicts recursively"]: [fn@Dict [a@Dict b@Dict]
    [builtin-reduce
        [fn [acc k]
            [deep-merge-step acc a b k]]
        a
        [keys b]]]

# Apply a function bottom-up to every node in a nested dict structure.
# For dicts: recursively transform all values first, then apply f to the resulting dict.
# For non-dicts: apply f directly to the value.
# Inherently materializing: must traverse entire structure.
# walk-dict depends on walk (public) — lives in public dict.
walk-dict@[doc: "Walk nested dict structure (internal helper)"]: [fn@Dict [f@Fn xs@Dict]
    [builtin-reduce
        [fn [acc k]
            [merge acc [make-entry k [walk f [get k xs]]]]]
        []
        [keys xs]]]

walk@[doc: "Apply function bottom-up to nested structure"]: [fn@Any [f@Fn xs]
    [builtin-if [dict? xs]
        [f [walk-dict f xs]]
        [f xs]]]

# Unzip a list of pairs into a pair of lists.
# Takes a list of 2-element dicts [0: a 1: b] and returns [a: [0: a0 1: a1 ...] b: [0: b0 1: b1 ...]].
# Inherently materializing: must map over the entire collection.
unzip@[doc: "Unzip list of pairs into pair of lists"]: [fn@Dict [pairs]
    [a: [builtin-map [fn [p] p.0] pairs]
     b: [builtin-map [fn [p] p.1] pairs]]]

# Transpose a 2D dict structure (flip rows and columns).
# Takes a dict of dicts [[0: [0: a 1: b] 1: [0: c 1: d]]] and returns [[0: [0: a 1: c] 1: [0: b 1: d]]].
# All inner dicts must have the same keys.
# Inherently materializing: must iterate over all rows and columns.
transpose@[doc: "Transpose 2D dict (flip rows and columns)"]: [fn@Dict [rows@Dict]
    [builtin-if [empty? rows]
        []
        [transpose-impl rows [keys [builtin-first [values rows]]]]]]

# ============================================================================
# Aggregates
# ============================================================================

# Sum all elements of a numeric collection.
# Inherently materializing: must reduce all elements.
sum@[doc: "Sum all elements"]: [fn@Number [xs] [builtin-reduce [fn [a b] [builtin-add a b]] 0 xs]]

# Product of all elements in a numeric collection.
# Inherently materializing: must reduce all elements.
product@[doc: "Product of all elements"]: [fn@Number [xs] [builtin-reduce [fn [a b] [builtin-mul a b]] 1 xs]]

# Return the minimum element of a collection.
# Errors on empty collection (no sensible default for polymorphic min).
# NOTE: TypeVar 'a' is not bound via parameter annotation (xs@Seq@a would require
# chained annotations, which are not supported). The constraint is aspirational,
# relying on the type system to infer 'a' from context.
min@[doc: "Minimum element"]: [fn@[return: a constraint: [a: Comparable]] [xs]
    [builtin-reduce
        [fn [a b] [builtin-if [builtin-lt a b] a b]]
        [builtin-first xs]
        [builtin-rest xs]]]

# Return the maximum element of a collection.
# Errors on empty collection (no sensible default for polymorphic max).
# NOTE: TypeVar 'a' is not bound via parameter annotation (xs@Seq@a would require
# chained annotations, which are not supported). The constraint is aspirational,
# relying on the type system to infer 'a' from context.
max@[doc: "Maximum element"]: [fn@[return: a constraint: [a: Comparable]] [xs]
    [builtin-reduce
        [fn [a b] [builtin-if [builtin-lt a b] b a]]
        [builtin-first xs]
        [builtin-rest xs]]]

# Count elements satisfying pred.
# Uses reduce to count, avoiding the Seq→length issue (filter on Dict returns Seq).
count@[doc: "Count elements satisfying predicate"]: [fn@Int [pred@Fn xs]
    [builtin-reduce
        [fn [acc x] [builtin-if [pred x] [builtin-add acc 1] acc]]
        0
        xs]]

# Check if a collection contains val (using structural equality), a string contains a substring,
# or a Bytes value contains a given byte (val must be an Int 0-255).
# Handles Dict input (uses any?), Seq input (uses filter then seq? to check non-empty),
# Stringing input (uses str-contains? for substring search),
# and Bytes input (uses bytes-find to search for a single-byte needle).
contains?@[doc: "Check if collection contains element"]: [fn@Bool [xs val]
    [builtin-if [builtin-eq [type-of xs] "String"]
        [str-contains? xs val]
        [builtin-if [builtin-eq [type-of xs] "Bytes"]
            [builtin-if [int? val]
                [builtin-if [gte-impl val 0]
                    [builtin-if [builtin-lt val 256]
                        [gte-impl [bytes-find xs [bytes-of [0: val]]] 0]
                        [error "contains?: byte value must be in range 0-255"]]
                    [error "contains?: byte value must be in range 0-255"]]
                [error "contains?: needle must be Int (byte value) when haystack is Bytes"]]
            [builtin-if [seq? xs]
                [seq? [builtin-filter [fn [e] [builtin-eq e val]] xs]]
                [any? [fn [e] [builtin-eq e val]] xs]]]]]

# Remove duplicate elements, keeping the first occurrence of each.
# Inherently materializing: O(n²) due to sequential contains? checks.
# uniq-impl/uniq-step depend on contains? (public) — live in public dict.
uniq-impl@[doc: "Uniq implementation (internal helper)"]: [fn@Dict [ks xs@Dict acc@Dict seen@Dict i@Int]
    [builtin-if [gte-impl i [length ks]]
        acc
        [uniq-step ks xs acc seen i [builtin-get [builtin-get i ks] xs]]]]

uniq-step@[doc: "Uniq step (internal helper)"]: [fn@Dict [ks xs@Dict acc@Dict seen@Dict i@Int v]
    [builtin-if [contains? seen v]
        [uniq-impl ks xs acc seen [builtin-add i 1]]
        [uniq-impl ks xs [append acc v] [append seen v] [builtin-add i 1]]]]

uniq@[doc: "Remove duplicates (keep first occurrence)"]: [fn@Dict [xs@Dict]
    [uniq-impl [keys xs] xs [] [] 0]]

# Right fold: fold f over xs from the right, starting with acc.
# Equivalent to fold(f, acc, reverse(xs)).
foldr@[doc: "Right fold"]: [fn [f@Fn acc xs] [builtin-reduce f acc [builtin-reverse xs]]]

# ============================================================================
# Composition
# ============================================================================

# Compose two functions: (compose f g)(x) = f(g(x)).
compose@[doc: "Compose two functions"]: [fn@Fn [f@Fn g@Fn] [fn [x] [f [g x]]]]

# Thread a value through a series of functions.
# Usage: [-> data step1 step2 step3]
->@[doc: "Thread value through functions"]: [fn [x ...stages] [builtin-reduce [fn [acc f] [f acc]] x stages]]

# ============================================================================
# Type Predicates
# ============================================================================

# int?, float?, num?, str?, bool?, null?, dict?, fn?, seq? are Rust-native builtins.
# They are NOT defined here — the native builtins take effect directly.
# See src/builtins.rs for implementations. Each materializes its argument and
# checks the Value variant. fn? returns true for both Function and Builtin.

# Check if a value is a "list-shaped dict" — i.e., a dict whose keys are all integers.
# Returns true for [] (empty dict — vacuously true).
# Example: [list? [1 2 3]] => true (keys 0, 1, 2 are all ints)
# Example: [list? [a: 1 b: 2]] => false (string keys)
# Inherently materializing: must check all keys via all?.
list?@[doc: "Check if dict has all integer keys"]: [fn@Bool [xs]
    [and [dict? xs] [all? [fn [k] [int? k]] [keys xs]]]]

# ============================================================================
# Error Handling
# ============================================================================

# Call a function; if it errors, return the default value.
# Inherently materializing: must materialize body to catch errors.
try-or@[doc: "Call function; return default on error"]: [fn [f@Fn default]
    [try-or-impl [try f] default]]

# ============================================================================
# Result Type and Combinators
# ============================================================================

# Result type declaration: [Ok a] | [Err Stringing]
# Evaluating this type alias registers Ok and Err as callable constructor
# functions in this dict's letrec environment.
Result: [type [Ok a] [Err Stringing]]

# Re-export Ok constructor as a dict entry so it's available to code that
# includes the prelude. The RHS references the Ok constructor registered
# by the Result type declaration above (letrec makes this safe).
Ok: Ok

# Re-export Err constructor as a dict entry.
Err: Err

# Chain a Result: if Ok, apply f to the value; if Err, pass through.
# Result is first (data-flow order); matches Rust's .and_then(f) and Haskell's result >>= f.
# Type: (Result a -> (a -> Result b) -> Result b)
# Example: [and-then [Ok 21] [fn [x] [Ok [* x 2]]]] => [Ok 42]
# Example: [and-then [Err "bad"] [fn [x] [Ok [* x 2]]]] => [Err "bad"]
and-then@[doc: "Chain a Result: if Ok, apply f to the value; if Err, pass through"]: [fn@Unknown [result f]
    [match result
        [Ok v] [f v]
        [Err msg] [Err msg]]]

# Map over Ok value, pass Err through.
# Type: ((a -> b) -> Result a -> Result b)
# Example: [result-map [fn [x] [* x 2]] [Ok 21]] => [Ok 42]
# Example: [result-map [fn [x] [* x 2]] [Err "bad"]] => [Err "bad"]
result-map@[doc: "Map over Ok value, pass Err through"]: [fn@Unknown [f result]
    [match result
        [Ok v] [Ok [f v]]
        [Err msg] [Err msg]]]

# Return Ok value or the default on Err.
# Type: (a -> Result a -> a)
# Example: [result-or 99 [Ok 42]] => 42
# Example: [result-or 99 [Err "bad"]] => 99
result-or@[doc: "Return Ok value or the default on Err"]: [fn@Unknown [default result]
    [match result
        [Ok v] v
        [Err _] default]]

# Wrap a value in Ok.
# Type: (a -> Result a)
# Example: [result-ok 42] => [Ok 42]
result-ok@[doc: "Wrap a value in Ok"]: [fn@Unknown [v] [Ok v]]

# Result monad dict for [do result ...] chains.
# Provides bind (and-then) and pure (result-ok) for the do macro.
# Example: [do result [r: [fetch url]] [data: [from-json r.body]] [get "key" data]]
result@[doc: "Result monad dict for [do result ...] chains"]: [bind: and-then  pure: result-ok]

# ============================================================================
# Type Class Declarations: Mappable
# ============================================================================
#
# Mappable generalizes map over type constructors (Seq, Dict).
# The class parameter `f` has Kind::Operator (pre-registered in InferState::new()
# with Kind::Operator — the LLT class declaration inherits that kind).
# The fmap method signature uses HKT type syntax; the runtime value here is
# the class declaration dict registered in the runtime class registry.
#
# Note: satisfies_constraint in type_unify.rs handles Mappable constraint
# checking via the hardcoded fixed-instance set. These declarations extend
# the runtime class/instance registry so user code can access the method dicts.

Mappable@[doc: "Type class for mappable type constructors (Seq, Dict)"]:
  [class [Mappable f]]

MappableSeq@[doc: "Mappable instance for Seq: fmap = builtin-map"]:
  [instance [Mappable Seq]
    fmap: [fn [f xs] [builtin-map f xs]]]

MappableDict@[doc: "Mappable instance for Dict: fmap = builtin-map"]:
  [instance [Mappable Dict]
    fmap: [fn [f m] [builtin-map f m]]]

# ============================================================================
# Type Class Declarations: Appendable
# ============================================================================
#
# Appendable generalizes concatenation over concrete types (String, Dict, Seq).
# The class parameter `a` has Kind::Type (kind-* typeclass, not Operator-kinded).
# append-one: binary concatenation; empty: the identity element for concatenation.
#
# Note: satisfies_constraint in type_unify.rs handles Appendable constraint
# checking via the hardcoded fixed-instance set.

Appendable@[doc: "Type class for appendable types (String, Dict, Seq)"]:
  [class [Appendable a]]

AppendableStr@[doc: "Appendable instance for String: append-one = str, empty = empty string"]:
  [instance [Appendable String]
    append-one: [fn [a b] [str a b]]
    empty: ""]

AppendableRecord@[doc: "Appendable instance for Dict: append-one = merge, empty = empty dict"]:
  [instance [Appendable Dict]
    append-one: [fn [a b] [merge a b]]
    empty: []]

AppendableSeq@[doc: "Appendable instance for Seq: append-one = concat, empty = empty seq"]:
  [instance [Appendable Seq]
    append-one: [fn [a b] [builtin-concat a b]]
    empty: []]

# ============================================================================
# Sequences
# ============================================================================

# Sequence constructors and list operations are registered as builtin-NAME and
# wrapped below in the "Sequence / List Wrappers" section. The public names
# (seq, head, tail, collect, range, repeat, cycle, iterate, unfold, join,
# concat, first, last, rest, cons, reverse, sort) are all defined as wrappers
# at the bottom of this dict so they can be shadowed by user code via include.

# ============================================================================
# Assertions
# ============================================================================

# Assert a condition; if false, raise an error with the given message.
# Inherently materializing: must materialize condition to check.
assert@[doc: "Assert condition with error message"]: [fn@Unknown [cond msg@Stringing] [builtin-if cond true [error msg]]]

# ============================================================================
# Shadowable Operator Wrappers
# ============================================================================
#
# These wrappers shadow Rust-native builtins to make them overridable by
# user code via include. Each wrapper delegates to a stable builtin-* alias
# that cannot be shadowed.
#
# This enables embedded DSLs (like stdlib/sql.llt) to redefine operators
# in lexical scope while the prelude continues to work correctly by calling
# the builtin-* escape hatches (which the prelude's internal functions use).
#
# Note: overrides apply to the initial dispatch only. Seq corecursion steps
# (map/filter/reduce/take/drop on Seq tails) always call the underlying Rust
# implementation directly via hardcoded function pointers in PendingBuiltin
# continuations, bypassing any include override.
#
# NOTE: Arity errors refer to these wrapper functions, not the underlying
# builtins. This is an accepted trade-off of the overridable-ops design.

# Comparison operators
<@[doc: "Less than"]: [fn@[return: Bool constraint: [a: Comparable]] [x@a y@a] [builtin-lt x y]]
=@[doc: "Equality"]: [fn@[return: Bool constraint: [a: Equatable]] [x@a y@a] [builtin-eq x y]]

# Arithmetic operators
+@[doc: "Addition"]: [fn@Number [a@Number b@Number] [builtin-add a b]]
-@[doc: "Subtraction"]: [fn@Number [a@Number b@Number] [builtin-sub a b]]
*@[doc: "Multiplication"]: [fn@Number [a@Number b@Number] [builtin-mul a b]]
/@[doc: "Division"]: [fn@Number [a@Number b@Number] [builtin-div a b]]

# Control flow
if@[doc: "Conditional (select branch by condition)"]: [fn [c t e] [builtin-if c t e]]

# Higher-order collection functions
filter@[doc: "Keep elements matching predicate"]: [fn [pred@Fn xs] [builtin-filter pred xs]]
map@[doc: "Apply function to each element"]: [fn [f@Fn xs] [builtin-map f xs]]
reduce@[doc: "Reduce collection with binary function"]: [fn [f@Fn init xs] [builtin-reduce f init xs]]
take@[doc: "Take first n elements"]: [fn [n@Int xs] [builtin-take n xs]]
drop@[doc: "Drop first n elements"]: [fn [n@Int xs] [builtin-drop n xs]]

# Reconstruct a Dict from a Seq of key-value pair dicts.
# Takes a Seq of [key: K, value: V] dicts (as produced by each-kv).
# Returns a Dict with those key-value mappings.
# assert: [collect-kv [[key: "a" value: 1] [key: "b" value: 2]]] => [a: 1 b: 2]
collect-kv@[doc: "Reconstruct dict from key-value pairs"]: [fn@Dict [xs] [builtin-reduce [fn [acc kv] [merge acc [make-entry kv.key kv.value]]] [] xs]]

# Repeat a string n times.
# str-repeat: String -> Int -> String
# assert: [str-repeat "x" 3] => "xxx"
# assert: [str-repeat "ab" 2] => "abab"
# assert: [str-repeat "x" 0] => ""
str-repeat@[doc: "Repeat string n times"]: [fn@String [s@String n@Int]
  [builtin-reduce [fn [acc _] [str acc s]] "" [builtin-range 0 n]]]

# Find the first occurrence of needle in haystack.
# Returns the character index of the first match, or -1 if not found.
# str-find: String -> String -> Int
# assert: [str-find "hello world" "world"] => 6
# assert: [str-find "hello world" "x"] => -1
# assert: [str-find "abc" ""] => 0
str-find@[doc: "Find first occurrence of needle in haystack; returns index or -1"]: [fn@Int [haystack@Stringing needle@Stringing]
  [builtin-if [str-contains? haystack needle]
    [str-find-impl haystack needle 0 [length needle] [length haystack]]
    [builtin-sub 0 1]]]

# ============================================================================
# Numeric Range Predicates
# ============================================================================

# between: predicate factory — returns a predicate that checks lo <= v <= hi.
# between: Int -> Int -> (Int -> Bool)
# assert: [[between 0 255] 42] => true
# assert: [[between 0 255] -1] => false
# assert: [[between 0 255] 256] => false
between@[doc: "Predicate factory for range check (inclusive)"]: [fn@Fn [lo hi] [fn [v] [and [>= v lo] [<= v hi]]]]

# non-negative: predicate — checks v >= 0.
# non-negative: Int -> Bool
# assert: [non-negative 0] => true
# assert: [non-negative 42] => true
# assert: [non-negative -1] => false
non-negative@[doc: "Check if value is non-negative"]: [fn@Bool [v] [>= v 0]]

# positive: predicate — checks v > 0.
# positive: Int -> Bool
# assert: [positive 1] => true
# assert: [positive 0] => false
# assert: [positive -1] => false
positive@[doc: "Check if value is positive"]: [fn@Bool [v] [> v 0]]

# ============================================================================
# Sequence / List Wrappers (shadowable wrappers for builtin-NAME functions)
# ============================================================================
#
# Each wrapper delegates to the stable builtin-* alias, making the primary
# name overridable by user code via include while internal prelude code
# continues to work correctly through the builtin-* escape hatch.

# Construct a Seq node from a head element and a tail Seq.
seq@[doc: "Construct a Seq node (head, tail)"]: [fn [h t] [builtin-seq h t]]

# Get the first element of a Seq (errors on empty Seq).
head@[doc: "First element of a Seq"]: [fn [xs] [builtin-head xs]]

# Get the tail of a Seq (all elements after the first; errors on empty Seq).
tail@[doc: "Tail of a Seq (all elements after first)"]: [fn [xs] [builtin-tail xs]]

# Materialize a lazy Seq into an integer-keyed Dict.
collect@[doc: "Materialize Seq into Dict"]: [fn [xs] [builtin-collect xs]]

# Generate a lazy integer range. 1-arg [range start] = infinite; 2-arg [range start end] = finite.
# Example: [collect [range 0 3]] => [0 1 2]
# Example: [take 3 [range 5]] => Seq(5, 6, 7, ...)
range@[doc: "Lazy integer range (1-arg: infinite; 2-arg: finite half-open)"]: [fn [start@Int ...rest]
    [builtin-if [builtin-eq [length rest] 0]
        [builtin-range start]
        [builtin-range start [builtin-get 0 rest]]]]

# Infinite lazy Seq repeating a single value.
repeat@[doc: "Infinite lazy Seq repeating a value"]: [fn [x] [builtin-repeat x]]

# Cycle a collection infinitely.
cycle@[doc: "Cycle collection infinitely"]: [fn [xs] [builtin-cycle xs]]

# Infinite lazy Seq by repeatedly applying f to seed.
iterate@[doc: "Iterate f over seed infinitely"]: [fn [f@Fn x] [builtin-iterate f x]]

# Generate a Seq by unfolding a seed with f (f returns null to stop).
unfold@[doc: "Unfold a Seq from seed using f"]: [fn [f@Fn seed] [builtin-unfold f seed]]

# Join collection elements as strings with a separator.
# Example: [join ", " ["a" "b" "c"]] => "a, b, c"
join@[doc: "Join elements as strings with separator"]: [fn [sep@Stringing xs] [builtin-join sep xs]]

# Concatenate two collections (Dict or Seq).
# Example: [concat [1 2] [3 4]] => [1 2 3 4]
concat@[doc: "Concatenate two collections"]: [fn [xs ys] [builtin-concat xs ys]]

# Get the first element of a Dict, Stringing, or Bytes.
first@[doc: "First element of a collection"]: [fn [xs] [builtin-first xs]]

# Get the last element of a Dict, Stringing, or Bytes.
last@[doc: "Last element of a collection"]: [fn [xs] [builtin-last xs]]

# Get all elements after the first (reindexed from 0).
rest@[doc: "All elements after first (reindexed)"]: [fn [xs] [builtin-rest xs]]

# Prepend an element to a collection.
cons@[doc: "Prepend element to collection"]: [fn [x xs] [builtin-cons x xs]]

# Reverse a collection (reindexed from 0).
reverse@[doc: "Reverse a collection"]: [fn [xs] [builtin-reverse xs]]

# Sort a collection in natural ascending order.
sort@[doc: "Sort collection in natural ascending order"]: [fn [xs] [builtin-sort xs]]

]
