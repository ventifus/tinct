--- stage: "type"  uses: ["core" "meta"]
# ============================================================================
# Type-Stage Prelude
# ============================================================================
#
# This section is evaluated separately from the runtime prelude by
# create_type_stage_env() in src/builtins.rs. It provides type constructors
# and helpers used during type inference and annotation resolution.
#
# Uses --- uses: ["core"] for core builtins. TypeNode constructors are
# defined within this dict via letrec and accessed with qualified names.

[
  # ============================================================================
  # Type-Stage Combinators (T-1061: migrated to TypeNode constructors)
  # ============================================================================
  #
  # These return TypeNode Variant values. Migration is complete as of T-1061.
  # The kind:-keyed dict fallback was removed in T-1200.
  #
  # Naming:
  #   Int, Str, Bool, Float, Never — leaf TypeNode constructors (no payload)
  #   Any     — TypeNode.Top (the sound lattice top — τ <: Top for all τ)
  #   Null    — TypeNode.Dict with empty fields (empty record = null / [])
  #   Seq     — TypeNode.TypeApplication of TypeNode.TypeConstructor "Seq"
  #   Map     — TypeNode.TypeApplication of TypeNode.TypeConstructor "Map"
  #   union   — TypeNode.Union
  #   all     — TypeNode.Intersect
  #   without — TypeNode.Negation
  #
  # Arithmetic resolvers use builtin-tag-of to dispatch on the TypeNode tag string
  # ("TypeNode.Int", "TypeNode.Float", etc.) rather than the old .name field.

  # TypeNode unit constructors — injected by the type-stage evaluator as
  # constructor functions. TypeNode is fully available at runtime since T-1193.
  # Letrec scoping means all entries in this dict are mutually visible.
  Integer: TypeNode.Int
  String:  TypeNode.String
  Float:   TypeNode.Float
  Any:     TypeNode.Top
  Never:   TypeNode.Never
  Unknown: TypeNode.Unknown
  Proxy:   TypeNode.Proxy
  # Any callable — variadic function accepting any arguments
  Callable: TypeNode.Callable
  # Named-field TypeNode constructors: accessed via qualified TypeNode.X names.
  # TypeNode is declared in this same letrec dict, so it is in scope via letrec mutual recursion.
  Null:    [TypeNode.Dict fields: []  open: 0]
  # Dict: open structural dict — accepts any dict with any field types.
  # Uniform(None, Any): any key, any value. This is the top of the dict lattice.
  Dict:    [TypeNode.Dict fields: []  open: 1]
  # Any handle — Handle applied to Unknown capability row
  Handle:  [TypeNode.TypeApplication
    ctor: [TypeNode.TypeConstructor name: "Handle"]
    args: [0: TypeNode.Unknown]]
  Seq:     [fn [let elem]
    [TypeNode.TypeApplication
      ctor: [TypeNode.TypeConstructor name: "Seq"]
      args: [0: elem]]]
  # Map[K: V]: typed uniform dict — all values have type V, keys have type K.
  # Uses TypeNode.Dict with key-type and value-type fields so typenode_value_to_type
  # produces RowTail::Uniform { key: Some(K), value: V } — distinct from bare Record.
  Map:     [fn [let key val]
    [TypeNode.Dict fields: []  open: 1  key-type: key  value-type: val]]
  # _wrap-typenode-value: normalize a raw integer or string value to its TypeNode
  # literal constructor so typenode_value_to_type receives a proper TypeNode variant.
  # Raw values arise when `[or 0 1]` or `[or "ok" "err"]` are written in type position —
  # the type-stage evaluator produces Value::Int / Value::String for the positional args.
  # Using builtin-type-of (returns "Int" / "String") to dispatch avoids importing
  # runtime builtins that are not available in the type-stage evaluator.
  _wrap-typenode-value: [fn [let t]
    [match [builtin-eq-string [builtin-type-of t] "Int"]
      1: [TypeNode.IntLiteral n: t]
      0: [match [builtin-eq-string [builtin-type-of t] "String"]
           1: [TypeNode.StringLiteral s: t]
           0: t]]]
  union:   [fn [let ...types] [TypeNode.Union types: [object-map types _wrap-typenode-value]]]
  or:      [fn [let ...types] [TypeNode.Union types: [object-map types _wrap-typenode-value]]]
  all:     [fn [let ...types] [TypeNode.Intersect types: types]]
  without: [fn [let inner]    [TypeNode.Negation inner: [as-typenode inner]]]

  # Normalize a TypeNode value using its constructor's as-type annotation.
  # Handle raw Int and String values first (they arise when literal values
  # flow into type-stage code), wrapping them as TypeNode.IntLiteral / TypeNode.StringLiteral.
  as-typenode: [fn [let t]
    [match [builtin-eq-string [builtin-type-of t] "Int"]
      1: [TypeNode.IntLiteral n: t]
      0: [match [builtin-eq-string [builtin-type-of t] "String"]
           1: [TypeNode.StringLiteral s: t]
           0: [TypeNode.as-type t]]]]

# Boolean is declared in loader.llt Dict 2 before prelude loads — do not redeclare here.


  # ============================================================================
  # Type-Stage Utilities (equirecursive-annotation-system, S-857)
  # ============================================================================

  # object-map: map a function over the values of a dict, preserving keys.
  # Used by TypeNode.map-children to reconstruct same-shaped TypeNode variants
  # after applying a child-mapping function.
  #
  # Signature: obj@Dict -> f@[Fn [Any] Any] -> Dict
  #
  # Args:
  #   obj — the source dict
  #   f   — called with (value), returns the new value; key is preserved automatically
  #
  # Example:
  #   [object-map [a: 1  b: 2] [fn [let v] [+ v 10]]] => [a: 11  b: 12]
  #
  # Implemented using only core builtins (dict-merge, builtin-keys,
  # builtin-dict-get, builtin-dict-length, builtin-dict-nth, builtin-eq-int,
  # builtin-int-add) so it is available in the type-stage evaluator.
  # Uses match for branching (Boolean.True/False not available at type stage).
  # Uses [$k: v] dynamic key syntax to preserve string keys.
  object-map-step: [fn@Dict [let obj f keys i n builder]
    [match [builtin-eq-int i n]
      0: [call [fn [let]
            [k: [builtin-dict-get i keys]]
            [object-map-step obj f keys [builtin-int-add i 1] n
              [builtin-builder-set k [f [builtin-dict-get k obj]] builder]]]]
      ...: [builtin-builder-finish builder]]]
  object-map: [fn [let obj f]
    [keys: [builtin-keys obj]]
    [object-map-step obj f keys 0 [builtin-dict-length keys] [builtin-make-builder]]]

  # dict-merge: right-biased dict union using builder builtins.
  # Defined here (not imported) so it is available in the type-stage scope.
  dict-merge: [fn [let a b]
    [_step: [fn [let builder d i n]
      [match [builtin-int-gte i n]
        0: [_step [builtin-builder-set [builtin-dict-key-nth d i] [builtin-dict-nth d i] builder] d [builtin-int-add i 1] n]
        ...: builder]]]
    [builtin-builder-finish
      [_step [_step [builtin-make-builder] a 0 [builtin-dict-length a]] b 0 [builtin-dict-length b]]]]

# ============================================================================
  # TypeNode: Primary Type Representation (T-1058, equirecursive-types)
  # ============================================================================
  #
  # TypeNode is the type system's primary representation. The type checker works
  # directly on TypeNode values. CheckerType is simply Node(Value) — a thin
  # wrapper with no separate variant for inference variables. TypeVar IS a
  # TypeNode constructor, making it findable by walk_type and handled uniformly.
  #
  # Each constructor carries @[as-type: fn  guarding: Bool] in its constructor-
  # level annotation. @Child on field names marks TypeNode-valued fields for the
  # traversal protocol (children, map-children) — derived generically by T-1059.
  #
  # Role inference from @Child field type:
  #   @Child on TypeNode           → One      (single child)
  #   @Child on [Map Int TypeNode] → MapValues (map over values, integer-keyed)
  #   @Child on [Map K TypeNode]   → MapValues (map over values, preserve keys)
  # Fields without @Child are NonChild — passed through unchanged by map-children.
  #
  # Protocol functions (children, map-children, as-type) are added in T-1059
  # via [merge TypeNode [...]].

  TypeNode: [type
    # Primitives — leaf constructors: no @Child fields
    Int@[as-type: [fn [let t] t]  guarding: 1]:        []
    Float@[as-type: [fn [let t] t]  guarding: 1]:      []
    String@[as-type: [fn [let t] t]  guarding: 1]:     []
    Bool@[as-type: [fn [let t] t]  guarding: 1]:       []
    Absent@[as-type: [fn [let t] t]  guarding: 1]:     []
    Unknown@[as-type: [fn [let t] t]  guarding: 1]:    []
    Never@[as-type: [fn [let t] t]  guarding: 1]:      []
    # Structural
    Dict@[as-type: [fn [let r] r]  guarding: 1]:
      [fields@Child: [Map String TypeNode]   # @Child on Map → MapValues (map over values, preserve keys)
       open:         Int]                    # 1 = open, 0 = closed; no @Child → NonChild
    Union@[as-type: [fn [let u] u]  guarding: 0]:
      [types@Child: [Map Int TypeNode]]      # @Child on Map → MapValues (map over values)
    Intersect@[as-type: [fn [let i] i]  guarding: 0]:
      [types@Child: [Map Int TypeNode]]  # @Child on Map → MapValues (map over values)
    Negation@[as-type: [fn [let n] n]  guarding: 0]:
      [inner@Child: TypeNode]                # @Child on TypeNode → One
    # TypeConstructor — two roles:
    #   Transient (pre-normalization): bare name lookup result, eliminated by expansion
    #   Leaf identity (post-normalization): qualified name "Color.Red", carries nominal identity
    TypeConstructor@[as-type: [fn [let t] t]  guarding: 1]:
      [name: String]                         # no @Child → leaf
    TypeApplication@[as-type: [fn [let a] a]  guarding: 1]:
      [ctor@Child:  TypeNode                 # @Child on TypeNode → One
       args@Child:  [Map Int TypeNode]]      # @Child on Map → MapValues
    Arrow@[as-type: [fn [let a] a]  guarding: 1]:
      [params@Child: [Map Int TypeNode]      # @Child on Map → MapValues
       result@Child: TypeNode]              # @Child on TypeNode → One
    # Recursive — equirecursive types; body is a concrete TypeNode with
    # RecursiveRef(var) at recursive positions (not a function)
    Recursive@[as-type: [fn [let r] r]  guarding: 1]:
      [var:         String                   # no @Child → NonChild (binder name, not a type child)
       body@Child:  TypeNode]               # @Child on TypeNode → One
    # Internal sentinel — always a leaf; only appears inside Recursive bodies
    RecursiveRef@[as-type: [fn [let r] r]  guarding: 0]:
      [name: String]                         # no @Child → leaf
    # Inference variable — leaf; name and level are not TypeNode children.
    # TypeVar IS a TypeNode constructor — findable by walk_type, handled uniformly
    # with all other TypeNode forms. level is the Kiselyov creation-time level;
    # state.levels is the authoritative mutable current level (never read from payload).
    TypeVar@[as-type: [fn [let t] t]  guarding: 0]:
      [name:  String                         # e.g. "_t42"
       level: Int]
    # Fixed-size bytes refinement type — [Bytes N] in annotation position.
    # Supertype: TypeNode.Bytes. Subtype rule [Bytes N] <: Bytes is derived from
    # the supertype: annotation generically, with no Rust special-case.
    # guarding: 0 — SizedBytes is a leaf structurally (n is Int, not TypeNode child).
    # Two SizedBytes nodes are incompatible when n values differ (M ≠ N) — falls
    # out of generic TypeNode structural equality on the n field.
    SizedBytes@[supertype: TypeNode.Bytes  as-type: [fn [let b] b]  guarding: 0]:
      [n: Int]                               # n: the concrete byte-count N from [Bytes N] annotation
    # Integer literal types — produced by [or 0 1], [or -1 0 1] in type position.
    # Wraps a raw integer value n so typenode_value_to_type can produce Type::IntLiteral.
    # guarding: 0 — leaf node; n is Int, not a TypeNode child.
    IntLiteral@[as-type: [fn [let t] t]  guarding: 0]:
      [n: Int]
    # String literal types — produced by [or "ok" "err"] in type position.
    # Wraps a raw string value s so typenode_value_to_type can produce Type::StringLiteral.
    # guarding: 0 — leaf node; s is String, not a TypeNode child.
    StringLiteral@[as-type: [fn [let t] t]  guarding: 0]:
      [s: String]]

  # ============================================================================
  # Bytes[N]: parameterized type function (T-1355)
  # ============================================================================
  #
  # Registers Bytes as a type-stage function so that [Bytes 32] in annotation
  # position invokes expand_named("Bytes", [32]) → TypeNode.SizedBytes { n: 32 }.
  # N is always a concrete type-stage integer — no Kind::Nat Rust extension needed.
  # Type arithmetic works: [Bytes [+ 16 16]] → TypeNode.SizedBytes { n: 32 }.
  # Bare @Bytes → TypeNode.Bytes (the unparameterized bytes type).
  # @[Bytes N] → TypeNode.SizedBytes { n: N } (sized/refined bytes type).
  # Uses variadic ...args to handle both cases from one declaration.
  Bytes: [fn [let ...args]
    [match [builtin-eq-int [builtin-dict-length args] 0]
      0: TypeNode.Bytes
      ...: [TypeNode.SizedBytes n: [builtin-dict-get 0 args]]]]

  # ============================================================================
  # TypeNode traversal helpers (T-1059, equirecursive-types)
  # ============================================================================
  #
  # These helpers derive the traversal protocol generically from @Child field
  # annotations stored in FnAnnotation.extra["field-annotations"], which is
  # populated at desugar time for fields annotated @Child (T-1124).
  #
  # All helpers use only core builtins (builtin-* prefixed names, `if`, `=`, `+`,
  # and `builtin-has-key?`) — `--- uses: ["core"]` makes these available.
  # Unqualified names like `reduce`, `keys`, `get`, `get?`, `has?` are NOT available
  # here — they are defined in the runtime prelude section further below.

  # TypeNode-ctor: return the TypeNode constructor function for a TypeNode value.
  # Splits the tag string (e.g. "TypeNode.Int") on "." and looks up the last
  # component (e.g. "Int") as a key in the TypeNode dict, returning the constructor.
  TypeNode-ctor: [fn [let t]
    # Tag is always "TypeNode.X"; skip the 9-char "TypeNode." prefix to get "X".
    # builtin-split is in the string module (not core), so use builtin-str-slice instead.
    [tag: [builtin-tag-of t]]
    [builtin-dict-get [builtin-str-slice tag 9 [builtin-str-length tag]] TypeNode]]

  # child-fields: return the Dict of @Child field names for a constructor.
  # Reads the "field-annotations" key from annotation-of(ctor) and returns its keys
  # (a Dict of int-indexed field name strings). Returns [] when no @Child fields exist
  # (i.e., leaf constructors with no @Child field declarations).
  # Uses builtin-has-key? (returns Int 1/0) to avoid the removed builtin-get?.
  child-fields: [fn [let ctor]
    [ann: [builtin-annotation-of ctor]]
    [match [builtin-has-key? "field-annotations" ann]
      0: []
      ...: [builtin-keys [builtin-dict-get "field-annotations" ann]]]]

  # child-role: return the child role string ("One" or "MapValues") for a
  # given @Child field of a constructor.
  #   "One"       — field type is TypeNode (a single child)
  #   "MapValues" — field type is [Map K TypeNode] (map; map over values, preserve keys)
  # The "Seq" role was removed when Intersect.types migrated from [Seq TypeNode] to [Map Int TypeNode].
  child-role: [fn [let ctor field]
    [builtin-dict-get "role"
      [builtin-dict-get field
        [builtin-dict-get "field-annotations" [builtin-annotation-of ctor]]]]]

  # child-field?: return Boolean.True iff field is an @Child field of the constructor.
  # Uses builtin-has-key? (Int 1/0) — builtin-get? no longer exists as a Rust builtin.
  child-field?: [fn [let ctor field]
    [ann: [builtin-annotation-of ctor]]
    [match [builtin-has-key? "field-annotations" ann]
      0: Boolean.False
      ...: [match [builtin-has-key? field [builtin-dict-get "field-annotations" ann]]
        0: Boolean.False
        ...: Boolean.True]]]

]

# ============================================================================
# Type-Stage Prelude (second dict) — TypeNode merge + TypeNodeResolve typeclass
# ============================================================================
#
# This second dict is evaluated after the first dict above. The first dict's
# bindings (TypeNode, object-map, TypeNode-ctor, child-fields, child-role,
# child-field?) are in scope here via the parent environment chain.
#
# Placing TypeNode: [dict-merge TypeNode [...]] here (rather than in the first dict)
# avoids a duplicate-key parse error: the type-stage evaluator uses the doc's
# sequential expression semantics — each dict shadows earlier dicts — so the
# merged TypeNode replaces the original in the exported environment.

[
  # ============================================================================
  # TypeNode merge: protocol functions children, map-children, as-type (T-1059)
  # ============================================================================
  #
  # Merged into the TypeNode dict so callers access them as:
  #   [TypeNode.children t]        — returns Seq of child TypeNode values
  #   [TypeNode.map-children f t]  — returns same-shaped TypeNode with children mapped by f
  #   [TypeNode.as-type t]         — normalizes t using its constructor's as-type annotation
  #
  # The Rust walk_type generic looks up TypeNode.children once at type-stage init time
  # and calls it per node. expand_all_tycon_apps uses TypeNode.map-children for generic
  # reconstruction without enumerating constructors explicitly.

  TypeNode: [dict-merge TypeNode [

    # children: collect all @Child field values into a flat Seq of TypeNode values.
    #
    # Role "One":       wrap the single TypeNode field value in a 1-element Dict
    # Role "MapValues": the field is a Dict of TypeNode values — concat values directly
    #
    # All TypeNode child fields are now [Map Int TypeNode] — no Seq role remains.
    # Leaf constructors (no @Child fields) return [] (empty Dict).
    # builtin-concat(Dict, Dict) reindexes both into a flat integer-keyed Dict.
    # match on string role values — stored as "One"/"MapValues" in field-annotations.
    children-step: [fn@Dict [let t ctor fields i n acc]
      [match [builtin-eq-int i n]
        0: [call [fn [let]
              [field: [builtin-dict-nth fields i]]
              [val:   [builtin-dict-get field t]]
              [children-step t ctor fields [builtin-int-add i 1] n
                [builtin-concat acc
                  [match [child-role ctor field]
                    "One":       [0: val]
                    "MapValues": val]]]]]
        ...: acc]]
    children: [fn [let t]
      [ctor:   [TypeNode-ctor t]]
      [fields: [child-fields ctor]]
      [children-step t ctor fields 0 [builtin-dict-length fields] []]]

    # map-children: apply f to each @Child field value and reconstruct the same-shaped
    # TypeNode variant. Non-@Child fields pass through unchanged.
    #
    # Explicit per-constructor match — no builtin-variant needed. Leaf constructors
    # (Int, Float, String, Bool, Absent, Unknown, Never, TypeConstructor, RecursiveRef,
    # TypeVar, SizedBytes, IntLiteral, StringLiteral) have no @Child fields and return t
    # unchanged via the wildcard arm.
    # Child field roles:
    #   "One"       — single TypeNode child: apply f directly
    #   "MapValues" — Map of TypeNode values: map f over values, preserve keys
    map-children: [fn [let f t]
      [match t
        [case [let p] [TypeNode.Dict p]
          [TypeNode.Dict
            fields: [object-map p.fields f]
            open:   p.open]]
        [case [let p] [TypeNode.Union p]
          [TypeNode.Union
            types: [object-map p.types f]]]
        [case [let p] [TypeNode.Intersect p]
          [TypeNode.Intersect
            types: [object-map p.types f]]]
        [case [let p] [TypeNode.Negation p]
          [TypeNode.Negation
            inner: [f p.inner]]]
        [case [let p] [TypeNode.TypeApplication p]
          [TypeNode.TypeApplication
            ctor: [f p.ctor]
            args: [object-map p.args f]]]
        [case [let p] [TypeNode.Arrow p]
          [TypeNode.Arrow
            params: [object-map p.params f]
            result: [f p.result]]]
        [case [let p] [TypeNode.Recursive p]
          [TypeNode.Recursive
            var:  p.var
            body: [f p.body]]]
        ...: t]]

    # as-type: normalize a TypeNode value using its constructor's as-type annotation.
    # The as-type annotation function (set at TypeNode declaration time on each constructor)
    # maps the TypeNode to an existing built-in form. Built-in TypeNode constructors all
    # carry [as-type: [fn [let t] t]] — the identity function.
    # User-defined constructors (via open ADT extension, R-12) may carry a custom as-type
    # to reduce to an existing TypeNode form before the type checker processes it.
    as-type: [fn [let t]
      [ann: [builtin-annotation-of [TypeNode-ctor t]]]
      [match [builtin-has-key? "as-type" ann]
        0: t
        ...: [[builtin-dict-get "as-type" ann] t]]]]]

  # ============================================================================
  # TypeNodeResolve: typeclass for as-type dispatch (T-1059)
  # ============================================================================
  #
  # Rust eval_type_stage_expr calls TypeNodeResolve.as-type(t) to normalize any
  # TypeNode value produced by type-stage expression evaluation before the type
  # checker receives it. The dispatch goes through this typeclass; the per-constructor
  # instance selects the appropriate as-type implementation.
  #
  # All built-in TypeNode constructors use identity — they return t unchanged.
  # User-defined constructors declare their own instance to reduce to an existing form.
  #
  # A single instance for all TypeNode values suffices because every built-in
  # constructor's as-type is the identity function. The class parameter @TypeNode
  # matches any TypeNode variant value.

  TypeNodeResolve: [class [let t]
    as-type: [fn [let _] ...]]

  TypeNodeResolveAll:
    [instance TypeNodeResolve
      [let t@TypeNode]: [as-type: [fn [let t] t]]]

  # ============================================================================
  # mu: inline recursive type combinator (S-860: equirecursive-types-core)
  # ============================================================================
  #
  # mu constructs a TypeNode.Recursive value from a body function.
  # Usage:
  #   [mu [fn [let self] [record head: Int tail: self]]]
  #   [mu [fn [let self] [or Absent [record head: Int tail: self]]]]
  #
  # f receives a TypeNode.RecursiveRef sentinel (to mark recursive positions).
  # f is called EAGERLY: the result is a concrete TypeNode, not a deferred Fn.
  # mu checks contractiveness before returning the Recursive node.
  #
  # Contractiveness: a recursive type μa.T is contractive iff every path from
  # the root to a RecursiveRef passes through at least one guarding constructor
  # (Record, Arrow, TypeApplication, or any TypeNode with guarding: 1).
  # Non-contractive types (μa.a, μa.(a | Int)) are rejected at construction time
  # with a clear error rather than silently producing a diverging type.
  #
  # is-contractive is a Rust builtin (builtin-is-contractive, registered in
  # builtins_core.rs) because it must inspect TypeNode Value structure directly.
  # The type-stage alias is-contractive is registered alongside the other
  # type-stage utilities via builtin_module("core").
  mu: [fn [let f]
    [var:  [builtin-gensym "𝜇" "rec"]]
    [body: [f [TypeNode.RecursiveRef name: var]]]
    [match [builtin-is-contractive body]
      0: [builtin-raise [builtin-string-concat "non-contractive recursive type: immediate recursion without structural container (binder: " [builtin-string-concat var ")"]]]
      ...: [TypeNode.Recursive var: var  body: body]]]

  # ============================================================================
  # FieldType: type-stage resolver for Indexable FD (T-1889)
  # ============================================================================
  #
  # Given a container TypeNode and a key TypeNode, returns the field type.
  # Used as the resolver for Indexable's (c, k) → v functional dependency.
  # Handles Dict (record field lookup by string literal key), Union (distribute
  # across members), Intersect (distribute across members), and Top (→ Unknown).
  # Returns TypeNode.Unknown when the field type cannot be determined statically.
  FieldType: [fn [let container-typenode key-typenode]
    [match container-typenode
      [case [let p] [TypeNode.Dict p]
        [match [builtin-has-key? "key-type" p]
          1: p.value-type
          0: [match key-typenode
                [case [let k] [TypeNode.StringLiteral k]
                  [match [builtin-has-key? k.s p.fields]
                    1: [builtin-dict-get k.s p.fields]
                    0: TypeNode.Unknown]]
                ...: TypeNode.Unknown]]]
      [case [let p] [TypeNode.Union p]
        [TypeNode.Union types: [object-map p.types [fn [let member] [FieldType member key-typenode]]]]]
      [case [let p] [TypeNode.Intersect p]
        [TypeNode.Intersect types: [object-map p.types [fn [let member] [FieldType member key-typenode]]]]]
      TypeNode.Top: TypeNode.Unknown
      ...: TypeNode.Unknown]]

  # ============================================================================
  # ElementType: type-stage resolver for Indexed FD (T-1921)
  # ============================================================================
  #
  # Given a container TypeNode, returns the element/value type.
  # Used as the resolver for Indexed's (c) → v functional dependency.
  # Handles Dict (delegates to FieldType with the dict's own key-type),
  # Union (distribute), Intersect (distribute), Top (→ Unknown).
  # Returns TypeNode.Unknown when the element type cannot be determined.
  ElementType: [fn [let container-type]
    [match container-type
      [case [let p] [TypeNode.Dict p]
        [match [builtin-has-key? "key-type" p]
          1: [FieldType container-type p.key-type]
          0: TypeNode.Unknown]]
      ...: TypeNode.Unknown]]

  # Indexed: element-type typeclass (c → v) for head/first/last/builtin-dict-nth.
  # Separate from Indexable (c, k → v) which handles get/slice with explicit keys.
  Indexed: [class [let c v]
    [determines: [[[c] v]]  resolver: ElementType]]

]

--- uses: ["core" "io" "math" "meta" "string" "async" "datetime"]

# ============================================================================
# LLT Standard Library (Prelude)
# ============================================================================
#
# TWO dict expressions in one document (public/private split):
#
# 1. Private helpers (first expression, not exported)
#    Pure internal recursive helpers. Only use Rust-native builtins and
#    sibling private helpers — never call public stdlib functions, because
#    at eval time the first dict is materialized before the second dict's
#    bindings exist in scope.
#    Uses builtin-dict-get (not the get wrapper), match for branching (not and/or),
#    and builtin-int-gte instead of >= (which is in the public dict).
#    Naming conventions:
#      -impl   Internal recursive helper with extra state arguments.
#      -step   Continuation passed to a Rust sequence builtin.
#      -check  Predicate helper that inspects an intermediate result.
#
# 2. Public API (second expression, exported)
#    All public stdlib functions, plus any private helpers that depend on
#    public functions (co-located for mutual recursion within letrec scope).
#    References private helpers from the first dict by plain name
#    (eval_document injects first-dict bindings into scope for subsequent
#    expressions, and the resolver models this scope chain).
#    Type declarations (like Result) register variant constructors (Ok, Error)
#    in the dict's letrec environment; these are re-exported as dict entries
#    to make them available to code that includes the prelude.
#
# Rust primitives are pre-injected into the bootstrap env by
# create_stdlib_env_inner() before this file runs. All builtins are available
# in scope via the parent environment chain.
#
#   Stable builtin-* aliases (used internally; pre-injected into bootstrap env):
#     builtin-lt  builtin-eq-int  builtin-eq-string  builtin-int-add  builtin-mul  builtin-div
#     builtin-dict-get  map  reduce
#     builtin-filter  builtin-take  builtin-drop
#     builtin-concat  builtin-join
#     (builtin-seq, builtin-head, builtin-tail, builtin-collect removed in S-893/S-896)
#     (builtin-range, builtin-repeat, builtin-cycle, builtin-iterate, builtin-unfold removed in T-1380 — generators are pure tinct)
#     sort-asc  (and other builtin-NAME forms from the collection module)
#
#   Primary-name shadowable wrappers (defined in public dict at end of file):
#     <  =  +  -  *  /  if  filter  map  reduce  take  drop
#     seq  head  tail  collect  range  repeat  cycle  iterate  unfold  (all pure tinct since T-1380/S-896)
#     join  concat  first  last  rest  cons  reverse  sort
#   range/repeat/cycle/iterate/unfold are now pure tinct — they construct Seq.Cons directly.
#   map/filter/reduce/take/drop/join/concat on Seq paths are now pure tinct wrappers that
#   dispatch to the Seq implementation in prelude; Dict paths still use builtin-* Rust aliases.
#   The builtin-* aliases remain as stable escape hatches for Dict-specific operations.
#
# Design patterns:
#   Shadowable wrappers — functions like <, =, +, if, filter, map etc.
#     wrap the corresponding builtin-* alias so domain stdlib modules can shadow
#     the primary name via include without breaking the prelude's own code.
#     See doc/11-stdlib.md §Rust-Native vs Tinct-Implemented Boundary.
#
#   O(n²) accumulator limitation — LLT-implemented accumulators (e.g. concat via
#     merge inside a fold) are O(n²) because each merge copies the growing
#     accumulator dict. Functions that must be O(n) are implemented as Rust
#     builtins (e.g. builtin_concat, reverse, sort). Prefer the Rust builtins
#     for large collections; the LLT wrappers are for composability and shadowing.
#
# ============================================================================

# ============================================================================
# Bootstrap: Rust primitives are pre-injected by create_stdlib_env_inner()
# ============================================================================
#
# All Rust primitives (arithmetic, comparison, string, collection, etc.) are
# injected directly into the bootstrap env before this file runs. No
# [include %rust "..."] calls are needed — the bindings are already in scope
# via the parent environment chain.

# ============================================================================
# FIRST DICT: Private helpers (not exported)
# ============================================================================
#
# CONSTRAINT: only Rust-native builtins and sibling helpers may be called here.
# Wrappers like get, >=, and, or, not, empty?, has?, reindex, contains? etc.
# are defined in the PUBLIC dict and are NOT in scope when this dict is evaluated.
#
# Layering Rules — private dict restrictions:
#   builtin-int-gte        instead of >= (which is in the public dict)
#   builtin-dict-get   instead of the get wrapper
#   match for branching  instead of and/or
#   builtin-dict-length     instead of length (prelude wrapper not yet in scope)
#   builtin-keys       instead of keys
#   [match x Seq: ...]  instead of seq? (seq? not yet in scope in private dict)
#   [match x Dict: ...] instead of dict? (dict? not yet in scope in private dict)
#   builtin-build-dict instead of build-dict

[

# ============================================================================
# Type declarations needed by private helpers
# ============================================================================
#
# These are declared here (private dict) so private helper functions can
# reference their constructors directly (e.g. Result.Ok, Result.Error, Closed.Closed).
# They are re-exported from the public dict for callers.
# Both dict-1 and dict-2 declare Result to allow cross-dict usage; both produce
# variants with identical tag strings so runtime pattern matching works correctly.

Closed: [type Closed]
Full:   [type Full]
Lagged: [type Lagged: [count: Int]]

# Result type: needed by private helpers (group-by-get-bucket, try-or-impl, retry-impl).
# Declared here so dict-1 match patterns referencing Result.Ok / Result.Error resolve correctly.
# The public dict (dict 2) re-exports Result, Ok, Error under the same names for callers.
# Both declarations produce variants with identical tag strings ("Result.Ok", "Result.Error"),
# so runtime pattern matching works correctly regardless of which declaration constructed a value.
Result: [type [let a]
  Ok:    [value: a]
  Error: [msg: String]]

# Boolean type: needed by private helpers that return Boolean.True/Boolean.False in body positions.
# Declared here (dict 1) so it is visible in both the private and public dicts.
# The public dict re-exports Boolean for callers.
Boolean: [type True False]

# ============================================================================
# Private arithmetic helpers
# ============================================================================

# Internal helper — not part of the public API.
# Construct a single-entry dict from a computed key and value.
# Access expressions like [builtin-dict-get i ks] can't appear in key position syntactically;
# passing through function params makes the key a plain k var_ref.
make-entry: [fn@Dict [let k v] [$k: v]]

# `append` is a Rust-native builtin (O(1) amortized insert vs O(n) merge).

# ============================================================================
# Logic helpers (only depend on builtins + siblings)
# ============================================================================


# ============================================================================
# Control flow helpers (only depend on builtins + siblings)
# ============================================================================


# ============================================================================
# Dict utilities helpers (only depend on builtins + siblings)
# ============================================================================

# bool->int-priv: Boolean.False→0, Int→n (pass-through), anything else→1.
# Defined in the private dict so bootstrap functions (partition-step, etc.) can use it.
bool->int-priv: [fn [let b]
    [match b
      Boolean.False: 0
      [@Integer _]:  b
      ...:             1]]

# raw-to-result: convert the {ok: val} / diagnostic dict returned by builtin-try into
# a Result.Ok / Result.Error variant for downstream match arms to consume.
raw-to-result: [fn [let raw]
    [match [builtin-has-key? "ok" raw]
        0: [Result.Error msg:   [builtin-dict-get "message" raw]]
        ...: [Result.Ok   value: [builtin-dict-get "ok"     raw]]]]

# ============================================================================
# List helpers (only depend on builtins + siblings)
# ============================================================================


# ============================================================================
# Higher-order helpers (only depend on builtins + siblings)
# ============================================================================

# partition-step: append element to pass or fail integer-keyed Dict accumulator.
# acc is a dict with pass/fail keys, each holding an integer-keyed Dict (forward order).
# Uses dict-append for O(1) amortized insert. No Seq construction needed —
# dict-append is a core builtin available in the private dict.

# ── Tinct implementations of formerly-Rust derived builtins ──────────────────
# Private helpers: named without builtin- prefix since they are tinct, not Rust.
# Single-caller functions are folded directly into their public caller (no private needed).

# dict-first / dict-last: used by first, last, min, max, transpose-impl (multiple callers).
dict-first: [fn [let xs@Dict] [builtin-dict-nth xs 0]]
dict-last:  [fn [let xs@Dict] [builtin-dict-nth xs [builtin-int-sub [builtin-dict-length xs] 1]]]

# dict-append: add x at key = length of xs (multiple callers: conj, group-by-insert, partition-step).
dict-append: [fn [let x xs@Dict]
  [n: [builtin-dict-length xs]
   b: [builtin-make-builder]
   fill: [fn [let i]
     [match [builtin-int-gte i n]
       0: [_: [builtin-builder-set i [builtin-dict-nth xs i] b]
              [fill [builtin-int-add i 1]]]
       ...: [builtin-builder-set n x b]]]
   _: [fill 0]
   [builtin-builder-finish b]]]

# dict-merge: right-biased union (multiple callers: merge, group-by-insert).
dict-merge: [fn [let a@Dict b@Dict]
  [_copy: [fn [let builder d n i]
    [match [builtin-int-gte i n]
      0: [_copy
            [builtin-builder-set [builtin-dict-key-nth d i] [builtin-dict-nth d i] builder]
            d n [builtin-int-add i 1]]
      ...: builder]]]
  [builtin-builder-finish
    [_copy [_copy [builtin-make-builder] a [builtin-dict-length a] 0]
           b [builtin-dict-length b] 0]]]


# partition-finish: accumulator is already in forward order — return as-is.
partition-finish: [fn@[bind: [a]  return: a] [let result@a] result]

# group-by-get-bucket: retrieve existing bucket for key k from acc dict, or [] if missing.
group-by-get-bucket: [fn@Dict [let k acc@Dict]
    [match [raw-to-result [builtin-try [builtin-dict-get k acc]]]
        [case [let p] [Result.Ok p]    p.value]
        [case [let _] [Result.Error]   []]]]

# group-by-insert: update key k in plain dict acc with x appended to existing bucket.
# Uses dict-merge (right-biased overlay) to store the updated bucket.
# Separated from group-by-step to keep [let k [f x]] out of the calling function body.
group-by-insert: [fn@Dict [let k x acc@Dict]
    [dict-merge acc [make-entry k [dict-append x [group-by-get-bucket k acc]]]]]

# group-by-step: compute key via f, then delegate to group-by-insert.
# The explicit k parameter keeps the key computation separate from the accumulation step.
group-by-step: [fn@[bind: [a k]  return: Dict] [let f@[Fn@k [a]] acc@Dict x]
    [group-by-insert [f x] x acc]]

# ============================================================================
# Aggregate helpers (only depend on builtins + siblings)
# ============================================================================

# ============================================================================
# Error handling helpers (only depend on builtins + siblings)
# ============================================================================

try-or-impl: [fn@[bind: [a]  return: a] [let try-result default@a]
    [match try-result
        [case [let p] [Result.Ok p]    p.value]
        [case [let _] [Result.Error]   default]]]

# ============================================================================
# Document env helpers
# ============================================================================

# env-to-name-set: convert an env dict to a flat Dict<String,1> for builtin-resolve.
# builtin-resolve now takes a name-set (flat dict of all visible names, values=1)
# rather than a scope-frames array. The env is already a flat dict of name→thunk.

env-to-name-set: [fn [let env]
  [keys: [builtin-keys env]]
  [go: [fn [let n i builder]
    [match [builtin-eq-int i n]
      0: [go n [builtin-int-add i 1]
            [match [builtin-eq-string [builtin-type-of [builtin-dict-get i keys]] "String"]
              1: [builtin-builder-set [builtin-dict-get i keys] 1 builder]
              0: builder]]
      ...: [builtin-builder-finish builder]]]]
  [go [builtin-dict-length keys] 0 [builtin-make-builder]]]

# ============================================================================
# Async private helpers (T-733: moved from stdlib/async.llt)
# ============================================================================

# retry-impl: recursive countdown helper for retry.
# Attempts thunk. On success returns value. On failure, if n > 0 retries.


# Indexable declared here (dict 1) so it is in scope when type-checking dict 1 helpers.
# Re-exported in dict 2 as: Indexable: .Indexable
# builtin-dict-get carries constraint: [$Indexable c k v] (annotated in builtin_core.llt).
# FieldType fires at Indexable instance dispatch call sites (call_dispatch for typed containers),
# via builtin-dict-get (used by dot-access desugaring in typecheck_cek.rs),
# and via the standalone `get` wrapper which also carries constraint: [$Indexable c k v].
Indexable:
  [class [let c k v]
    [determines: [[[c k] v]]  resolver: FieldType]
    get:    [Fn@v      [k c]]
    slice:  [Fn@c      [c Int Int]]
    length: [Fn@Integer    [c]]]

]

# ============================================================================
# SECOND DICT: Public API (exported)
# ============================================================================
#
# All public stdlib functions. Private helpers from the first dict are
# accessible by plain name (eval_document injects first-dict bindings into
# scope for subsequent expressions in the same document).
#
# Some internal helpers that depend on public functions also live here,
# co-located with the public functions they call (enabling mutual recursion
# within this dict's letrec scope).
#
# All entries in this dict can reference each other (letrec semantics) AND
# the private helpers defined in the first dict above.

[

# ============================================================================
# runtime-v2: Native AST Value Types
# ============================================================================
#
# These types correspond to Value::Expression, Value::Document, Value::Program.
# They are returned by `load` (Program) and `ast-of` (Expression),
# and consumed by `eval` ([Seq Expression]).
#
# Expression is self-referential — the type system handles this via its
# recursive alias guard (substitutes a fresh TypeVar at recursive positions).

Span: [type Span: [
  start-line: Int
  start-col:  Int
  end-line:   Int
  end-col:    Int]]

DotKey: [type Ident: [name: String] Index: [index: Int]]

Annotation: [type
  # text: always present — the full display string of the annotation (e.g. "String", "[return: X]", "A@B")
  # Simple: bare type name or TypeVar — name is the identifier string
  Simple:       [text: String  name: String]
  # PropertyDict: bracketed annotation with keys.
  #   parts: integer-keyed Dict of positional Annotation values (the type arguments)
  #   doc: and return: exposed when present as named entries, else null
  PropertyDict: [text: String  parts: [Map Int Any]  doc: Any  return: Any]
  # Annotated: chained @-form — name is the outer identifier, inner is the inner annotation as a string
  Annotated:    [text: String  name: String  inner: String]
  # Unknown: opaque annotation sub-expression that can't be parsed as a typed annotation
  # (e.g. [Map k v] parsed as a Call expression inside a PropertyDict) — only text available
  Unknown:      [text: String]]

Parameter: [type Parameter: [
  name:       String
  annotation: Annotation
  variadic:   Bool
  span:       Span]]

NamedArg: [type NamedArg: [
  name:  String
  value: Expression
  span:  Span]]

Entry: [type Entry: [
  key:   Expression
  value: Expression
  span:  Span]]

MatchArm: [type MatchArm: [
  pattern: Expression
  guard:   Expression
  body:    Expression
  span:    Span]]

Expression: [type
  IntLiteral:   [value: Int    span: Span]
  FloatLiteral: [value: Float  span: Span]
  StrLiteral:   [value: String span: Span]
  Var:          [name: String  escaped: Bool  span: Span]
  DotAccess:    [target: Expression  field: DotKey  span: Span]
  Pipe:         [lhs: Expression  rhs: Expression  span: Span]
  Sequential:   [exprs: [Seq Expression]  span: Span]
  Dict:         [entries: [Seq Entry]  span: Span]
  Call:         [fn: Expression  args: [Seq Expression]  named: [Seq NamedArg]  implied: Bool  span: Span]
  Fn:           [params: [Seq Parameter]  body: Expression  return-ann: Annotation  desugared: Bool  span: Span]
  TypeAssert:   [annotation: Annotation  expr: Expression  span: Span]
  Annotated:    [name: String  annotation: Annotation  span: Span]
  Rest:         [name: String  span: Span]
  Match:        [scrutinee: Expression  arms: [Seq MatchArm]  span: Span]
  Quote:        [expr: Expression  span: Span]
  Unquote:      [expr: Expression  span: Span]
  UnquoteSplice:[expr: Expression  span: Span]
  PatternDecl:  [bindings: [Seq Expression]  span: Span]
  LetDecl:      [bindings: [Seq Expression]  span: Span]
  CaseArm:      [pattern: Expression  body: Expression  span: Span]
  Placeholder:  [span: Span]
  ExprError:    [span: Span]]


Declaration: [type
  TypeAlias:    [params: [Seq String]  body: Expression]
  ClassDecl:    [name: String  params: [Seq String]]
  InstanceDecl: [class-name: String]
  SyntaxClass:  [name: String  pattern: Expression  message: String]
  Splice:       [forms: [Seq Expression]]]

DocumentName: [type Named: [name: String] Unnamed]

Document: [type Document: [
  name:         DocumentName
  expressions:  [Seq Expression]
  declarations: [Seq Declaration]
  output-type:  Annotation
  expects:      Annotation]]

Program: [type Program: [
  documents: [Seq Document]]]

# Expr: complete variant-level view of expression AST nodes.
# Covers all CoreExpr variants so macro transformers can inspect and construct
# any node in the tinct AST. Recursive positions use Any because the type system
# does not yet support iso-recursive types.
# Constructors: Expr.Literal, Expr.VarRef, Expr.Call, etc.
Expr: [type
  # Primitives
  Literal:      [kind: String  bare: Bool  value: Any]
  VarRef:       [name: String]
  # Variant/constructor node: Expr.Variant tag: "Color.Red" payload: []
  Variant:      [tag: String  payload: Any]

  # Compound expressions
  Call:         [fn: Any  args: Any  named-args: Any  implied: Bool]
  Fn:           [params: Any  body: Any  return-ann: Any  desugared: Bool]
  Dict:         [entries: Any]
  DotAccess:    [target: Any  field: String]
  Sequential:   [exprs: Any]

  # Declarations and bindings
  LetDecl:      [bindings: Any]
  PatternDecl:  [bindings: Any]

  # Pattern matching
  Match:        [scrutinee: Any  arms: Any]
  CaseArm:      [let-bindings: Any  pattern: Any  body: Any]

  # Type annotations
  Annotated:    [name: String  annotation: Any]
  TypeAssert:   [annotation: Any  value: Any]

  # Quasiquotation
  Quote:        [expr: Any]
  Unquote:      [expr: Any]
  UnquoteSplice:[expr: Any]

  # Structural helpers (used in Call args, Dict entries, Fn params)
  Entry:        [key: Any  value: Any]
  NamedArg:     [name: String  value: Any]
  Param:        [name: String  variadic: Bool  annotation: Any]
  Rest:         [name: String]

  # Sentinel nodes
  Placeholder                        # the ... form
  ExprError:    [span: Any]]

variant?@[doc: "Check if value is a nominal variant (constructed by a type constructor)."]: [fn@Boolean [let v]
  [match [builtin-variant? v]
    0: Boolean.False
    ...: Boolean.True]]

payload-of@[return: Dict  doc: """
Extract the payload dict from a Variant value.

Example: [payload-of [Shape.Circle r: 5]] => [r: 5]
Example: [payload-of Color.Red] => []

For unit variants (no payload), returns an empty dict [].
For payload variants, returns the payload dict directly.
"""]: [fn [let v]
  [merge v []]]

# ============================================================================
# Identity
# ============================================================================

identity: [fn@[bind: [a]  return: a  doc: """
Return argument unchanged.

Example: [identity 42] => 42
"""] [let x] x]


# ============================================================================
# Logic
# ============================================================================

# Boolean type — re-exported from dict 1 for callers who include prelude.
# Declared in dict 1 so private helpers can use Boolean.True/Boolean.False.
# Re-declared here so the type (and its constructors True, False) are visible
# in the exported letrec scope. Both declarations produce identical tags.
Boolean: [type True False]
# Short-name aliases exported for convenience
True:  Boolean.True
False: Boolean.False

# bool->int: Boolean.False→0, Int→n (pass-through), anything else (including Boolean.True)→1.
bool->int: bool->int-priv

not: [fn@[return: Boolean  doc: """
Boolean negation.

Example: [not Boolean.True] => Boolean.False
Example: [not Boolean.False] => Boolean.True
"""] [let x] [match [bool->int x] 0: Boolean.True ...: Boolean.False]]

and: [fn@[bind: [a b]  return: [or a b]  doc: """
Short-circuit AND.

Example: [and Boolean.True Boolean.True] => Boolean.True
Example: [and Boolean.False [expensive]] => Boolean.False   (expensive never called)

Note: If x is falsy, y is never evaluated. Returns y when x is truthy, Boolean.False
otherwise.
"""] [let x@a y@b] [match [bool->int x] 0: Boolean.False ...: y]]

or: [fn@[bind: [a b]  return: [or a b]  doc: """
Short-circuit OR.

Example: [or Boolean.True "x"] => Boolean.True
Example: [or Boolean.False "default"] => "default"

Note: If x is truthy, returns x; otherwise returns y.
"""] [let x@a y@b] [match [bool->int x] 0: y ...: x]]

any?: [fn@[bind: [a]  return: Boolean  doc: """
Boolean.True if any element satisfies predicate.

Type: ((a -> Boolean) -> Dict a -> Boolean)

Example: [any? [fn [x] [> x 0]] [1 -2 3]] => Boolean.True

Note: Errors if xs is a Seq (collect first). Inherently materializing: short-circuits but materializes elements until condition met.
"""] [let pred@[Fn@Boolean [a]] xs@Dict]
  [impl: [fn [let ks i len]
    [match [builtin-int-gte i len]
      0: [match [bool->int-priv [pred [builtin-dict-get [builtin-dict-get i ks] xs]]]
          0: [impl ks [builtin-int-add i 1] len]
          ...: 1]
      ...: 0]]]
  [if [seq? xs]
    [error "any?: expected Dict, got Seq -- collect the Seq first"]
    [if [impl [keys xs] 0 [length xs]] Boolean.True Boolean.False]]]

all?: [fn@[bind: [a]  return: Boolean  doc: """
Boolean.True if all elements satisfy predicate.

Type: ((a -> Boolean) -> Dict a -> Boolean)

Example: [all? [fn [x] [> x 0]] [1 2 3]] => Boolean.True

Note: Errors if xs is a Seq (collect first). Inherently materializing: short-circuits but materializes elements until condition failed.
"""] [let pred@[Fn@Boolean [a]] xs@Dict]
  [impl: [fn [let ks i len]
    [match [builtin-int-gte i len]
      0: [match [bool->int-priv [pred [builtin-dict-get [builtin-dict-get i ks] xs]]]
          0: 0
          ...: [impl ks [builtin-int-add i 1] len]]
      ...: 1]]]
  [if [seq? xs]
    [error "all?: expected Dict, got Seq -- collect the Seq first"]
    [if [impl [keys xs] 0 [length xs]] Boolean.True Boolean.False]]]

# ============================================================================
# Comparison (derived from < and =)
# ============================================================================
#
# = and < are class methods (Equatable and Comparable respectively).
# The resolver finds them via method_to_instance — no global wrapper needed.
# call_dispatch overrides to the correct instance at each call site.
#
# >, <=, >= are derived functions that call <.

>: [fn@[bind: [a]  return: Boolean  constraint: [a: Comparable]  doc: """
Greater than.

Example: [> 5 3] => True
Example: [> 3 5] => False

Note: Derived by swapping arguments of <.
"""] [let x y] [< y x]]

<=: [fn@[bind: [a]  return: Boolean  constraint: [a: Comparable]  doc: """
Less than or equal.

Example: [<= 3 5] => True
Example: [<= 5 5] => True
Example: [<= 5 3] => False

Note: Derived as negation of >.
"""] [let x y] [not [< y x]]]

>=: [fn@[bind: [a]  return: Boolean  constraint: [a: Comparable]  doc: """
Greater than or equal.

Example: [>= 5 3] => True
Example: [>= 5 5] => True
Example: [>= 3 5] => False

Note: Derived as negation of <.
"""] [let x y] [not [< x y]]]

# ============================================================================
# Arithmetic
# ============================================================================
#
# +, -, *, / are class methods (Addable, Subtractable, Multipliable, Divisible).
# The resolver finds them via method_to_instance — no global wrapper needed.
# call_dispatch overrides to the correct instance at each call site.

quot: [fn@[return: Int  doc: """
Integer quotient (truncate toward zero).

Example: [quot 7 2] => 3
Example: [quot -7 2] => -3

Note: Uses builtin-div (float division) then trunc (toward-zero truncation to Int). Contrast with floor-div (truncates toward negative infinity) which does not exist in LLT. Inherently materializing: derived from arithmetic operations.
"""] [let a@Number b@Number] [trunc [builtin-div a b]]]

mod: [fn@[return: Number  doc: """
Integer remainder (sign of dividend).

Example: [mod 7 3] => 1
Example: [mod -7 3] => -1
Example: [mod 7 -3] => 1

Note: Uses the algebraic identity: mod(a, b) = a - (quot(a, b) * b). Clojure/Haskell-rem semantics. Contrast with Python `%` / Haskell `mod` (sign of divisor). Inherently materializing: derived from arithmetic operations.
"""] [let a@Number b@Number] [- a [* [quot a b] b]]]

# ============================================================================
# Numeric Conversion (derived from floor, round, builtin-int-add, -, *)
# ============================================================================

ceil: [fn@[return: Int  doc: """
Ceiling (smallest integer >= x).

Example: [ceil 3.2] => 4
Example: [ceil -3.2] => -3

Note: Derived as -floor(-x). Inherently materializing: derived from arithmetic operations.
"""] [let x@Number] [- 0 [floor [- 0 x]]]]

trunc: [fn@[return: Int  doc: """
Truncate toward zero.

Example: [trunc 3.7] => 3
Example: [trunc -3.7] => -3

Note: Floor for non-negative, ceil for negative. Inherently materializing: derived from arithmetic operations.
"""] [let x@Number] [if [>= x 0] [floor x] [ceil x]]]

abs: [fn@[return: Number  doc: """
Absolute value.

Example: [abs -5] => 5
Example: [abs 3.14] => 3.14

Note: Returns -x for negative, x otherwise. Inherently materializing: derived from comparison and arithmetic.
"""] [let x@Number] [match [builtin-lt x 0] 0: x ...: [- 0 x]]]

sign: [fn@[return: Integer  doc: """
Sign of number (-1, 0, or 1).

Example: [sign -42] => -1
Example: [sign 0] => 0
Example: [sign 3.14] => 1

Note: Inherently materializing: derived from comparison and arithmetic.
"""] [let x@Number]
    [match [builtin-lt x 0]
      0: [match [builtin-int-gt x 0]
           0: 1
           ...: 0]
      ...: -1]]

clamp: [fn@[return: Number  doc: """
Clamp value between bounds (inclusive).

Example: [clamp 0 10 -5] => 0
Example: [clamp 0 10 15] => 10
Example: [clamp 0 10 7] => 7

Note: Returns lo if x < lo, hi if x > hi, otherwise x. Inherently materializing: derived from comparison operations.
"""] [let lo@Number hi@Number x@Number]
    [match [builtin-lt x lo]
        0: [match [builtin-lt hi x]
            0: x
            ...: hi]
        ...: lo]]

# ============================================================================
# Stringing (derived from str, split, builtin-filter, builtin-eq-string)
# ============================================================================

# join: delegates to builtin-join (see wrappers section at bottom of this dict).
# O(n) performance, dual-dispatch on Dict/Seq. Example: [join ", " ["a" "b"]] => "a, b"


# Split a string on spaces, filtering empty strings. Returns a Seq of words.
# Type: (Stringing -> Seq Stringing)
# Example: [collect [words "hello world"]] => ["hello" "world"]
# Example: [collect [words "  spaces  "]] => ["spaces"]
# Inherently materializing: splits string content, derived from split.
words@[doc: "Split string on spaces into words"]: [fn@[Seq String] [let s@String]
    [filter [fn [let w] [not [builtin-eq-string w ""]]] [split " " s]]]

# Strip common leading indentation from a multi-line string.
# Algorithm: split into lines; the last line (whitespace-only) determines indent depth;
# strip that many characters from each content line; drop first (empty) and last (anchor) lines.
# Type: (Stringing -> Stringing)
# Example: [unindent "\n  line one\n  line two\n  "] => "line one\nline two"
# Inherently materializing: must process all lines to determine indentation and strip.
unindent@[doc: """
Multi-line string indentation stripper. Currently called from the parser (\"\"\"...\"\"\" desugars to [unindent ...]).
Future: implement as a tinct macro using tinct string operations.
"""]: [fn@String [let s@String]
    # The indentation level is the length of the last line (after the final \n).
    # find-last-newline walks the string advancing past each \n to find the last one.
    [str-len:   [builtin-str-length s]
     last-nl:   [unindent-last-newline s 0 -1]
     last-line: [builtin-str-slice s [builtin-int-add last-nl 1] str-len]
     indent:    [str-length last-line]
     ls:        [split "\n" s]
     strip-line: [fn [let l] [if [< [str-length l] indent] "" [str-slice l indent [str-length l]]]]
     inner:     [drop 1 [take [- [length ls] 1] ls]]]
    [join "\n" [map strip-line inner]]]

# Helper for unindent: returns the position of the last "\n" in s (or -1 if none).
# Walks forward, updating last-pos each time a "\n" is found.
unindent-last-newline: [fn [let s pos last-pos]
  [found: [builtin-str-index-of "\n" [builtin-str-slice s pos [builtin-str-length s]]]
   [match [builtin-eq-int found -1]
     0: last-pos
     ...: [unindent-last-newline s
          [builtin-int-add pos [builtin-int-add found 1]]
          [builtin-int-add pos found]]]]]

# ============================================================================
# Control Flow
# ============================================================================

when: [fn@[bind: [a]  return: [or a Null]  doc: """
Evaluate body if predicate is truthy.

Example: [when 1 "result"] => "result"
Example: [when 0 "result"] => []

Note: Returns [] (empty dict) if predicate is falsy.
"""] [let pred body@a] [match [bool->int pred] 0: [] ...: body]]

unless: [fn@[bind: [a]  return: [or a Null]  doc: """
Evaluate body if predicate is falsy.

Example: [unless 0 "result"] => "result"
Example: [unless 1 "result"] => []

Note: Returns [] (empty dict) if predicate is truthy.
"""] [let pred body@a] [match [bool->int pred] 0: body ...: []]]

cond: [fn@[bind: [a]  return: [or a Null]  doc: """
Multi-branch conditional.

Example: [cond [[[> x 10] "big"] [[> x 0] "positive"] [True "other"]]]

Note: Takes a list of [condition result] pairs. Returns the first result where condition is True. Returns [] (empty dict) when no branch matches. Only the matched branch is evaluated (lazy branch evaluation).
"""] [let pairs@Dict]
  [cond-impl: [fn [let i]
    [match [builtin-int-gte i [builtin-dict-length pairs]]
      0: [match [bool->int-priv [builtin-dict-get i pairs].0]
          0: [cond-impl [builtin-int-add i 1]]
          ...: [builtin-dict-get i pairs].1]
      ...: []]]]
  [cond-impl 0]]

# until: re-exported from builtin-until (Rust builtin for performance — avoids per-iteration
# thunk allocation overhead). Registered in src/builtins_core.rs as builtin-until.

# ============================================================================
# Dict Utilities
# ============================================================================

get: [fn@[bind: [c k v]  return: v  constraint: [$Indexable c k v]  doc: """
Get value by key. For typed containers (Dict, List, Map, Bytes), the Indexable FD
resolver (FieldType) fires when c and k are ground, producing the precise field type.

Example: [get "b" [a: 1  b: 2]] => 2
Example: [get 0 ["x" "y" "z"]] => "x"

Note: Positional signature is Key → Collection → v (curried for pipeline composition).
"""] [let k@k c@c]
  [builtin-dict-get k c]]

find-by@[doc: """
Reverse-lookup in a type dict: find the first variant whose named field equals a value.

Example: [find-by rcode: 2 DnsRcode]  => DnsRcode.ServFail
Example: [find-by code: 1 H2FrameType] => H2FrameType.Data
"""]:
  [fn [let type-dict ...selector]
    [field-name:  [get 0 [keys selector]]
     field-value: [builtin-dict-get field-name selector]
     [builtin-get-by-field field-name field-value type-dict]]]

has?: [fn@[return: Boolean  doc: """
Check if dict has key.

Example: [has? "x" [x: 1]] => Boolean.True
Example: [has? "y" [x: 1]] => Boolean.False

Note: Signature is Key -> Dict -> Boolean (key-first for pipeline composition).
"""] [let k xs@Record]
    [match [builtin-has-key? k xs] 0: Boolean.False ...: Boolean.True]]


get-or: [fn@[bind: [a]  return: a  doc: """
Get value by key with default if missing.

Example: [get-or "x" 99 [x: 1]] => 1
Example: [get-or "y" 99 [x: 1]] => 99

Note: Signature is Key -> Default -> Dict -> Any (subject-last for pipeline composition).
Returns default value when key is missing.
"""] [let key default@a dict@Record]
    [if [has? key dict] [get key dict] default]]

get-in: [fn@[bind: [a]  return: a  doc: """
Traverse nested dicts by a list of keys.

Example: [get-in ["a" "b" "c"] [a: [b: [c: 42]]]] => 42

Note: Signature is Path -> Dict -> a (subject-last for pipeline composition).
Returns error when any intermediate key is missing. Use get-in-or for a default fallback on missing keys. Inherently materializing: must traverse nested dict path, accessing each level.
"""] [let path@Dict xs]
    [if [= [length path] 0]
        xs
        [if [has? path.0 xs]
            [get-in [tail path] [get path.0 xs]]
            [error [join "" ["key not found: " path.0]]]]]]

get-in-or: [fn@[bind: [a]  return: a  doc: """
Traverse nested dicts by a list of keys with default fallback.

Example: [get-in-or ["a" "b"] 99 [a: [b: 1]]] => 1
Example: [get-in-or ["a" "c"] 99 [a: [b: 1]]] => 99

Note: Signature is Path -> Default -> Dict -> a (subject-last for pipeline composition).
Returns default when any intermediate key is missing. Inherently materializing: must traverse nested dict path, accessing each level.
"""] [let path@Dict default xs]
    [if [= [length path] 0]
        xs
        [if [has? path.0 xs]
            [get-in-or [tail path] default [get path.0 xs]]
            default]]]

get-in?: [fn@[bind: [a]  return: [or a Absent]  doc: """
Nested optional lookup returning Absent.Absent if any key is missing.

Example: [get-in? [a: [b: [c: 42]]] ["a" "b" "c"]] => 42
Example: [get-in? [a: [b: 1]] ["a" "c"]] => Absent.Absent
Example: [get-in? [] ["x"]] => Absent.Absent

Note: Signature is Dict -> Path -> Any (dict-first, path-second).
Returns Absent.Absent as soon as any key in the path is missing.
Unlike get-in which errors on missing keys, get-in? propagates absence safely.
"""] [let dict@Dict keys]
  [reduce
    [fn [let acc key]
      [if [absent? acc] acc [get? key acc]]]
    dict
    keys]]

pick: [fn@Dict [let keys xs@Record]
  [reduce
    [fn [let acc key]
      [if [has? key xs]
        [set key [get key xs] acc]
        acc]]
    []
    [each-key keys]]]

# Check if a collection is empty.
# Seq values are never empty (always have a head), so return False immediately.
# Inherently materializing: depends on length which counts all entries.
# assert: [empty? []] => True
# assert: [empty? [1 2 3]] => False
empty?@[doc: "Check if collection is empty"]: [fn@Boolean [let xs] [if [seq? xs] Boolean.False [if [builtin-eq-int [length xs] 0] Boolean.True Boolean.False]]]

# Construct a single-entry dict from a computed key and a value.
# Used internally by set, from-entries, and domain modules that build dicts programmatically.
# assert: [make-entry "x" 42] => [x: 42]
make-entry@[doc: "Construct single-entry dict from key and value"]: [fn@Dict [let k v] [$k: v]]

# Merge additional key-value pairs into a dict (returns updated dict).
# Variadic: accepts xs as base dict, and ...kvs as an inline dict of entries to merge in.
# assert: [set [a: 1] b: 2] => [a: 1  b: 2]
set: [fn@Dict [let xs@Record ...kvs] [merge xs kvs]]

remove: [fn@[return: Dict  doc: """
Remove a key from a dict.

Example: [remove "b" [a: 1  b: 2  c: 3]] => [a: 1  c: 3]

Note: Signature is Key -> Dict -> Dict (subject-last for pipeline composition).
Preserves remaining keys in insertion order. Returns dict unchanged if key is not present. O(n) via build-dict.
"""] [let k xs@Record]
  [build-dict [filter [fn [let e] [not [= e.key k]]] [each-kv xs]]]]

# Update a key by applying a function to its current value.
# assert: [update "x" [fn [v] [+ v 1]] [x: 5]] => [x: 6]
update@[doc: "Update dict value by applying function"]: [fn@[bind: [a]  return: Dict] [let k f@[Fn@a [a]] xs@Record]
    [merge xs [make-entry k [f [get k xs]]]]]

values: [fn@[return: [List a]  doc: """
Get all values from a dict as a List.

Example: [values [a: 10  b: 20]] => [10 20]

Note: Preserves dict insertion order: values are returned in the same order as keys. O(n).
"""] [let xs@Record]
  [seq: [fn [let ks i len]
    [match [builtin-int-gte i len]
      0: [Seq.Cons
          head: [builtin-dict-get [builtin-dict-get i ks] xs]
          tail: [seq ks [builtin-int-add i 1] len]]
      ...: Seq.End]]]
  [collect [seq [keys xs] 0 [length [keys xs]]]]]

entries: [fn@[return: [List Dict]  doc: """
Get all entries as a List of [key: k  value: v] dicts.

Example: [entries [a: 10  b: 20]] => [[key: "a"  value: 10]  [key: "b"  value: 20]]

Note: Preserves dict insertion order: entries appear in the same order as the source dict. O(n).
"""] [let xs@Record]
  [seq: [fn [let ks i len]
    [match [builtin-int-gte i len]
      0: [step ks i len [builtin-dict-get i ks]]
      ...: Seq.End]]
   step: [fn [let ks i len k]
    [Seq.Cons
      head: [key: k  value: [builtin-dict-get k xs]]
      tail: [seq ks [builtin-int-add i 1] len]]]]
  [collect [seq [keys xs] 0 [length [keys xs]]]]]

from-entries: [fn@[return: Dict  doc: """
Reconstruct a dict from a list of [key: k value: v] pairs.

Example: [from-entries [[key: "a"  value: 10]  [key: "b"  value: 20]]] => [a: 10  b: 20]

Note: Inverse of entries. O(n) via build-dict builtin.
"""] [let pairs] [build-dict pairs]]

# ============================================================================
# List Operations (integer keys, dense 0..n output)
# ============================================================================

# Get the first element of a list, first character of a string, or first byte of Bytes (as Int).
# first: delegates to dict-first (see wrappers section at bottom of this dict).
# assert: [first [10 20 30]] => 10
# assert: [first "hello"] => "h"
# assert: [first (str-bytes "A")] => 65

# Get the nth element by insertion-order position.
# Supports negative indices: -1 is last, -2 is second-to-last, etc.
# assert: [nth 1 [10 20 30]] => 20
# assert: [nth -1 [10 20 30]] => 30
nth@[doc: "Get nth element (supports negative indices)"]: [fn@[bind: [a]  return: a] [let n@Integer xs@Dict]
  [ks:  [keys xs]
   len: [length xs]]
  [builtin-dict-get [builtin-dict-get [match [builtin-lt n 0] 0: n ...: [builtin-int-add len n]] ks] xs]]

# Get the last element by insertion-order position, last character of a string, or last byte of Bytes (as Int).
# last: delegates to builtin-last (see wrappers section at bottom of this dict).
# assert: [last [10 20 30]] => 30
# assert: [last "hello"] => "o"
# assert: [last (str-bytes "Z")] => 90

# rest: delegates to tail (see wrappers section at bottom of this dict).

# Append an element to the end of a list.
# Type: (a -> Dict a -> Dict a)
# Example: [conj 4 [1 2 3]] => [1 2 3 4]
conj@[doc: "Append element to end of list"]: [fn@[bind: [a]  return: Dict] [let x@a xs@Dict] [dict-append x xs]]

# concat, reverse, sort: delegate to their builtin-* aliases (see wrappers section).


# ============================================================================
# Sorting (Mergesort)
# ============================================================================

# sort: delegates to sort-asc (see wrappers section at bottom of this dict).
# O(n log n) natural ordering sort. Errors on Seq input (collect first).
# Example: [sort [3 1 2]] => [1 2 3]
# Example: [sort ["c" "a" "b"]] => ["a" "b" "c"]

# Sort a list using a custom comparator.
# Type: ((a -> a -> Bool) -> Dict a -> Seq a)
# cmp is a less-than function: [cmp a b] returns True if a should come before b.
# sort-asc: delegates to sort-by with < as comparator (O(n log n) mergesort).
# Callers: sort, sorted.
sort-asc: [fn [let xs@Dict]
  [sort-by [fn [let a b] [< a b]] xs]]

# Example: [sort-by [fn [let a b] [> a b]] [3 1 2]] => [3 2 1]  (descending)
# Inherently materializing: must compare values to determine order.
sort-by@[doc: "Sort with custom comparator (O(n log n) mergesort)"]: [fn@[bind: [a]  return: Dict] [let cmp@[Fn@Boolean [a a]] xs@Dict]
    [if [seq? xs]
        [error "sort-by: expected Dict, got Seq -- collect the Seq first"]
        [n: [builtin-dict-length xs]
         merge-sorted: [fn [let left right li ri out-i builder]
           [ln: [builtin-dict-length left]
            rn: [builtin-dict-length right]
            [match [builtin-int-gte li ln]
              0: [match [builtin-int-gte ri rn]
                0: [lv: [builtin-dict-nth left li]
                    rv: [builtin-dict-nth right ri]
                    [match [bool->int [cmp lv rv]]
                      0: [merge-sorted left right li [builtin-int-add ri 1] [builtin-int-add out-i 1]
                           [builtin-builder-set out-i rv builder]]
                      ...: [merge-sorted left right [builtin-int-add li 1] ri [builtin-int-add out-i 1]
                             [builtin-builder-set out-i lv builder]]]]
                ...: [merge-sorted left right [builtin-int-add li 1] ri [builtin-int-add out-i 1]
                       [builtin-builder-set out-i [builtin-dict-nth left li] builder]]]
              ...: [match [builtin-int-gte ri rn]
                0: [merge-sorted left right li [builtin-int-add ri 1] [builtin-int-add out-i 1]
                     [builtin-builder-set out-i [builtin-dict-nth right ri] builder]]
                ...: builder]]]]
         merge-sort-impl: [fn [let xs n]
           [match [builtin-lte n 1]
             0: [half:  [builtin-shr n 1]
                 left:  [merge-sort-impl [builtin-take half xs] half]
                 right: [merge-sort-impl [builtin-drop half xs] [builtin-int-sub n half]]
                 [builtin-builder-finish [merge-sorted left right 0 0 0 [builtin-make-builder]]]]
             ...: xs]]
         [merge-sort-impl xs n]]]]

# Like Python's sorted() — accepts Seq, List (finger tree), or Dict; returns a sorted List.
# Example: [sorted [filter [fn [x] [> x 2]] [1 3 2 4]]] => [3 4]
# Example: [sorted [3 1 2]] => [1 2 3]
sorted@[doc: "Sort collection in ascending order"]: [fn@[List a] [let xs]
    [collect [each [sort-asc [if [seq? xs]  [collect-dict xs]
                              [if [list? xs] [collect-dict [ft-to-seq xs]]
                                              xs]]]]]]

# Like sorted, with a custom comparator.
# Example: [sorted-by [fn [let a b] [> a b]] [filter [fn [let x] [> x 0]] [-1 3 -2 4]]] => [4 3]
sorted-by@[doc: "Sort with custom comparator (accepts Seq, List, or Dict)"]: [fn@[bind: [a]  return: [List a]] [let cmp@[Fn@Boolean [a a]] xs]
    [collect [each [sort-by cmp [if [seq? xs]  [collect-dict xs]
                                 [if [list? xs] [collect-dict [ft-to-seq xs]]
                                                 xs]]]]]]

# ============================================================================
# Universal Collection Operations (preserve keys)
# ============================================================================

# reduce, drop, map, filter are Rust-native builtins (dual-dispatch on Dict/Seq).
# See src/builtins.rs for implementations.

take-while: [fn@[bind: [a]  return: Dict  doc: """
Take elements from the beginning while predicate holds.

Example: [take-while [fn [x] [< x 3]] [1 2 3 4]] => [0: 1  1: 2]

Note: Returns the longest prefix of xs where all elements satisfy pred. Inherently materializing: must check elements until predicate fails. O(n) via build-dict.
"""] [let pred@[Fn@Boolean [a]] xs@Dict]
    [if [seq? xs]
        [error "take-while: expected Dict, got Seq -- collect the Seq first"]
        [build-dict [take-while-seq pred [each-kv xs]]]]]

drop-while: [fn@[bind: [a]  return: Dict  doc: """
Drop elements from the beginning while predicate holds.

Example: [drop-while [fn [x] [< x 3]] [1 2 3 4]] => [2: 3  3: 4]

Note: Returns the remaining suffix starting from the first element that fails pred. Inherently materializing: must check elements until predicate fails. O(n) via build-dict.
"""] [let pred@[Fn@Boolean [a]] xs@Dict]
    [if [seq? xs]
        [error "drop-while: expected Dict, got Seq -- collect the Seq first"]
        [build-dict [drop-while-seq pred [each-kv xs] True]]]]

map-entries: [fn@[bind: [b]  return: Dict  doc: """
Apply a function to every [key: k value: v] entry, returning new values under same keys.

Example: [map-entries [fn [e] [* e.value 2]] [a: 1 b: 2]] => [a: 2 b: 4]
Example: [map-entries [fn [e] e.key] [x: 10 y: 20]] => [x: "x" y: "y"]

Note: The function f receives the entry dict and must return the NEW VALUE (not a new entry dict). Keys are preserved unchanged. O(n) via build-dict.
"""] [let f@[Fn@b [Record]] xs@Record]
  [build-dict [map [fn [let e] [key: e.key  value: [f e]]] [each-kv xs]]]]

object-map: [fn@[bind: [a b]  return: Dict  doc: """
Map a function over the values of a dict. Keys are preserved automatically.

Args:
  obj — source dict
  f   — called as [f value]; returns the new value for that key

Example: [object-map [a: 1  b: 2] [fn [let v] [+ v 10]]] => [a: 11  b: 12]

Note: Counterpart to map-entries (which passes a single entry dict). Use object-map
for value-only transformations where keys are preserved unchanged. O(n).
"""] [let obj@Dict f@[Fn@b [a]]]
  [build-dict [map [fn [let e] [key: e.key  value: [f e.key e.value]]] [each-kv obj]]]]

# Left fold: alias for reduce (Rust-native builtin, dual-dispatch on Dict/Seq).
# Type: ((b -> a -> b) -> b -> Dict a -> b)
# fold and reduce are identical — use whichever name fits your context.
# Both are left folds: f receives (accumulator, element) and the result becomes
# the new accumulator. Starting accumulator is init.
# Example: [fold [fn [acc x] [+ acc x]] 0 [1 2 3 4]] => 10
fold@[doc: "Left fold (alias for reduce)"]: [fn@[bind: [a b]  return: b] [let f@[Fn@b [b a]] init@b xs] [reduce f init xs]]

slice: [fn@[return: Dict  doc: """
Take a slice by position (start inclusive, end exclusive).

Example: [slice 1 3 [a: 1 b: 2 c: 3 d: 4]] => [b: 2 c: 3]

Note: Signature is Start -> End -> Dict -> Dict (subject-last for pipeline composition).
Preserves original keys. O(n) via build-dict.
"""] [let start@Integer end@Integer xs@Dict]
  [build-dict [take [- end start] [drop start [each-kv xs]]]]]

zip: [fn@[return: [Seq Dict]  doc: """
Pair entries from two collections by position.

Example: [zip ["a" "b" "c"] [1 2 3]] => [["a" 1] ["b" 2] ["c" 3]]

Note: If both xs and ys are Seq: lazy Seq of pairs. Otherwise: materialize to Dict, then collect to List. Stops at the shorter collection's length.
"""] [let xs ys]
  [zip-seq: [fn [let xs ys]
    [match xs
      [case [let px] [Seq.Cons px] [match ys
        [case [let py] [Seq.Cons py] [Seq.Cons
          head: [px.head  py.head]
          tail: [zip-seq px.tail py.tail]]]
        ...: Seq.End]]
      ...: Seq.End]]
   zip-dict: [fn [let dx dy]
    [xks: [builtin-keys dx]
     yks: [builtin-keys dy]
     xlen: [builtin-dict-length xks]
     ylen: [builtin-dict-length yks]
     seq: [fn [let i]
       [match [builtin-int-gte i xlen]
         0: [match [builtin-int-gte i ylen]
             0: [step i [builtin-dict-get i xks] [builtin-dict-get i yks]]
             ...: Seq.End]
         ...: Seq.End]]
     step: [fn [let i xk yk]
       [Seq.Cons
         head: [[builtin-dict-get xk dx] [builtin-dict-get yk dy]]
         tail: [seq [builtin-int-add i 1]]]]]
    [collect [seq 0]]]]
  [if [and [seq? xs] [seq? ys]]
    [zip-seq xs ys]
    [zip-dict
      [if [seq? xs]  [collect-dict xs]
      [if [list? xs] [collect-dict [ft-to-seq xs]] xs]]
      [if [seq? ys]  [collect-dict ys]
      [if [list? ys] [collect-dict [ft-to-seq ys]] ys]]]]]

flatten: [fn@[bind: [a]  return: [Seq a]  doc: """
Flatten nested lists one level deep.

Example: [flatten [[1 2] [3 4]]] => [1 2 3 4]

Note: Input must be a Seq or Dict of Seqs — each element is itself a Seq. O(n) via lazy Seq construction + collect.
"""] [let xs@[Seq [Seq a]]]
    [if [seq? xs]
        [error "flatten: expected Dict, got Seq -- collect the Seq first"]
        [flatten-impl-dict xs]]]

flatten-impl-dict@[doc: "Flatten dict implementation (internal helper)"]: [fn@Dict [let xs@Dict]
    [collect-dict [flatten-seq-impl xs [keys xs] 0 [length xs]]]]

# Recursively search for a key in nested dicts.
# find-deep helpers depend on find-deep and get (public) — live in public dict.
# Inherently materializing: must traverse nested structure recursively to search.
find-deep-impl@[doc: "Find-deep implementation (internal helper)"]: [fn@Any [let xs@Dict target ks i@Integer]
    [match [builtin-int-gte i [length ks]]
        0: [find-deep-check xs target ks i [get i ks]]
        ...: [error [join "" ["key not found: " target]]]]]

find-deep-check@[doc: "Find-deep check (internal helper)"]: [fn@Any [let xs@Dict target ks i@Integer current-key]
    [if [= current-key target]
        [get current-key xs]
        [if [dict? [get current-key xs]]
            [find-deep-try [get current-key xs] target xs ks i]
            [find-deep-impl xs target ks [builtin-int-add i 1]]]]]

find-deep-try@[doc: "Find-deep try (internal helper)"]: [fn@Any [let subtree@Dict target parent@Dict ks i@Integer]
    [find-deep-try-check
        [try [fn [let] [find-deep target subtree]]]
        parent target ks i]]

find-deep-try-check@[doc: "Find-deep try-check (internal helper)"]: [fn@Any [let result parent@Dict target ks i@Integer]
    [match result
        [case [let p] [Result.Ok p]    p.value]
        [case [let _] [Result.Error]   [find-deep-impl parent target ks [builtin-int-add i 1]]]]]

find-deep: [fn@[bind: [a]  return: [or a Null]  doc: """
Recursively search for a key in nested dicts.

Example: [find-deep "c" [a: [b: [c: 42]]]] => 42

Note: Signature is Target -> Dict -> Any (subject-last for pipeline composition).
Depth-first search through nested dict structure. Errors if key not found. Inherently materializing: must traverse nested structure recursively.
"""] [let target xs@Dict]
    [find-deep-impl xs target [keys xs] 0]]

# ============================================================================
# Higher-Order Dict/List Utilities
# ============================================================================

with-entries: [fn@[return: Dict  doc: """
Transform a dict via entries pipeline: entries → map(f) → from-entries.

Example: [with-entries [fn [e] [key: e.key  value: [* e.value 10]]] [a: 1 b: 2]] => [a: 10 b: 20]

Note: Signature is Fn -> Dict -> Dict (subject-last for pipeline composition).
Each entry passed to f has the shape [key: k value: v]. Function f must return a new entry dict.
"""] [let f@[Fn@Dict [Dict]] xs@Dict] [from-entries [map f [entries xs]]]]

partition: [fn@[bind: [a]  return: Dict  doc: """
Split a Seq into two groups: elements satisfying pred and those that do not.

Example: [partition [fn [let x] [> x 0]] [range 0 5]] => [pass: [1 2 3 4]  fail: [0]]

Note: Returns a dict with keys `pass` (matching) and `fail` (non-matching). Both groups are
materialized integer-keyed dicts (eager). O(n) via Seq cons + reverse + collect for each group.
"""] [let pred@[Fn@Boolean [a]] xs]
  [step: [fn [let acc e passes]
    [match [bool->int-priv passes]
      0: [pass: [builtin-dict-get "pass" acc]
          fail: [dict-append e [builtin-dict-get "fail" acc]]]
      ...: [pass: [dict-append e [builtin-dict-get "pass" acc]]
            fail: [builtin-dict-get "fail" acc]]]]]
  [partition-finish
    [reduce
      [fn [let acc e] [step acc e [pred e]]]
      [pass: []  fail: []]
      xs]]]

flat-map: [fn@[bind: [a b]  return: [Seq b]  doc: """
Map f over a Seq and flatten the results one level. Lazy. O(n+m).

Example: [collect [flat-map [fn [let x] [cons x [cons [* x 2] Seq.End]]] [range 1 4]]]
         => [1 2 2 4 3 6]

Note: f must return a Seq for each element; results are lazily concatenated via concat-seq.
Pure tinct (T-1380): uses concat-seq for lazy Seq<>Seq concatenation — no Rust dispatch.
"""] [let f@[Fn@[Seq b] [a]] xs@[Seq a]]
    [match xs
      Seq.End:      Seq.End
      [case [let p] [Seq.Cons p] [concat-seq [f p.head] [flat-map f p.tail]]]]]

# Return the first element satisfying pred, or error if none found.
# filter on Seq returns a Seq; head gets the first element (errors if Seq.End).
find-first@[doc: "Find first element matching predicate; errors if none found"]: [fn@[bind: [a]  return: a] [let pred@[Fn@Boolean [a]] xs] [head [filter pred xs]]]

# Return the first element satisfying pred, or default if none found.
find-first-or@[doc: "Find first matching element or return default"]: [fn@[bind: [a]  return: a] [let pred@[Fn@Boolean [a]] default@a xs]
    [try-or-impl [raw-to-result [builtin-try [find-first pred xs]]] default]]

# Group elements of xs into a dict of lists, keyed by the result of applying f.
# Elements with the same key are collected together (insertion order preserved).
# Inherently materializing: must inspect all elements.
# Uses plain dict accumulation (O(n²) via merge-per-element, but no mutable builder state).

# group-by-finish: accumulate and return dict of lists.
# Separated from group-by to keep the reduce body clean and avoid deep nesting.
# group-by-step/group-by-insert/group-by-get-bucket (private dict) handle per-element work.
# Accumulator starts as [] (empty dict); each step merges one updated bucket entry.
# Buckets are built with append — elements are in insertion order, no reverse needed.
group-by-finish@[doc: "group-by internal helper — not public API"]: [fn@[bind: [a k]  return: Dict] [let f@[Fn@k [a]] xs]
    [reduce [fn@Dict [let acc@Dict x] [group-by-step f acc x]] [] xs]]

group-by: [fn@[bind: [a k]  return: Dict  doc: """
Group elements of xs into a dict of lists, keyed by the result of applying f.

Example: [group-by [fn [x] [mod x 2]] [1 2 3 4 5]] => [0: [2 4]  1: [1 3 5]]

Note: Elements with the same key are collected together (insertion order preserved). O(n²) via repeated merge.
Buckets are accumulated with append — elements appear in insertion order.
"""] [let f@[Fn@k [a]] xs]
    [group-by-finish f xs]]


deep-merge: [fn@[return: Dict  doc: """
Merge two dicts recursively.

Example: [deep-merge [a: [x: 1] b: 2] [a: [y: 3] c: 4]] => [a: [x: 1 y: 3] b: 2 c: 4]

Note: Sub-dicts are merged depth-first; all other values from b override a (right-biased at each level). O(n) via build-dict.
Returns a flat Dict (not an Overlay): keys only in a come first, then all keys from b (merged where both are dicts).
"""] [let a@Record b@Record]
  [step: [fn [let e]
    [key: e.key
     value: [if [and [has? e.key a] [and [dict? [get e.key a]] [dict? e.value]]]
               [deep-merge [get e.key a] e.value]
               e.value]]]]
  [build-dict
    [concat
      [filter [fn [let e] [not [has? e.key b]]] [each-kv a]]
      [map step [each-kv b]]]]]

# Apply a function bottom-up to every node in a nested dict structure.
# For dicts: recursively transform all values first, then apply f to the resulting dict.
# For non-dicts: apply f directly to the value.
# Inherently materializing: must traverse entire structure.
# walk-dict depends on walk (public) — lives in public dict.
walk-dict@[doc: "Walk nested dict structure (internal helper)"]: [fn@[bind: [b]  return: Dict] [let f@[Fn@b [Any]] xs@Dict]
    [build-dict [map [fn [let e] [key: e.key  value: [walk f e.value]]] [each-kv xs]]]]

walk: [fn@[bind: [b]  return: b  doc: """
Apply a function bottom-up to every node in a nested dict structure.

Example: [walk [fn [x] [if [dict? x] [length x] x]] [a: 1 b: [c: 2 d: 3]]] => [a: 1 b: 2]

Note: For dicts: recursively transform all values first, then apply f to the resulting dict. For non-dicts: apply f directly to the value. O(n) via build-dict.
"""] [let f@[Fn@b [Any]] xs]
    [if [dict? xs]
        [f [walk-dict f xs]]
        [f xs]]]

unzip: [fn@[return: Dict  doc: """
Unzip a list of pairs into a pair of lists.

Example: [unzip [["a" 1] ["b" 2] ["c" 3]]] => [a: ["a" "b" "c"]  b: [1 2 3]]

Note: Takes a list of 2-element dicts [0: a 1: b] and returns [a: [0: a0 1: a1 ...] b: [0: b0 1: b1 ...]]. Inherently materializing: must map over the entire collection.
"""] [let pairs@[Seq Dict]]
    [a: [map [fn [let p] p.0] pairs]
     b: [map [fn [let p] p.1] pairs]]]

transpose: [fn@[return: Dict  doc: """
Transpose a 2D dict structure (flip rows and columns).

Example: [transpose [[0: [a: 1 b: 2]] [1: [a: 3 b: 4]]]] => [a: [0: 1  1: 3]  b: [0: 2  1: 4]]

Note: Takes a dict of dicts [[0: [0: a 1: b] 1: [0: c 1: d]]] and returns [[0: [0: a 1: c] 1: [0: b 1: d]]]. All inner dicts must have the same keys. O(n) via build-dict.
"""] [let rows@Dict]
  [impl: [fn [let col-keys]
    [from-entries [map
      [fn [let col-key]
        [key: col-key
         value: [collect [map [fn [let row] [builtin-dict-get col-key row]] rows]]]]
      [each col-keys]]]]]
  [if [empty? rows]
    []
    [impl [keys [dict-first [values rows]]]]]]

# ============================================================================
# Aggregates
# ============================================================================

sum: [fn@[return: Number  doc: """
Sum all elements.

Example: [sum [1 2 3]] => 6
Example: [sum []] => 0

Note: Returns 0 for empty collections. Inherently materializing: must reduce all elements.
"""] [let xs@[Seq Number]] [reduce [fn [let a b] [+ a b]] 0 xs]]

product: [fn@[return: Number  doc: """
Product of all elements.

Example: [product [2 3 4]] => 24
Example: [product []] => 1

Note: Returns 1 for empty collections. Inherently materializing: must reduce all elements.
"""] [let xs@[Seq Number]] [reduce [fn [let a b] [builtin-mul a b]] 1 xs]]

min: [fn@[bind: [a]  return: a  constraint: [a: Comparable]  doc: """
Minimum element.

Example: [min [3 1 2]] => 1
Example: [min ["c" "a" "b"]] => "a"

Note: Errors on empty collection (no sensible default for polymorphic min).
"""] [let xs@Dict]
    [reduce
        [fn [let a b] [match [builtin-lt a b] 0: b ...: a]]
        [dict-first [@Dict xs]]
        [@Dict [tail [@Dict xs]]]]]

max: [fn@[bind: [a]  return: a  constraint: [a: Comparable]  doc: """
Maximum element.

Example: [max [3 1 2]] => 3
Example: [max ["c" "a" "b"]] => "c"

Note: Errors on empty collection (no sensible default for polymorphic max).
"""] [let xs@Dict]
    [reduce
        [fn [let a b] [match [builtin-lt a b] 0: a ...: b]]
        [dict-first [@Dict xs]]
        [@Dict [tail [@Dict xs]]]]]

# Count elements satisfying pred.
# Uses reduce to count, avoiding the Seq→length issue (filter on Dict returns Seq).
count@[doc: "Count elements satisfying predicate"]: [fn@[bind: [a]  return: Integer] [let pred@[Fn@Boolean [a]] xs]
    [reduce
        [fn [let acc x] [if [pred x] [builtin-int-add acc 1] acc]]
        0
        xs]]

# Check if a collection contains val (using structural equality), a string contains a substring,
# or a Bytes value contains a given byte (val must be an Int 0-255).
# Handles Dict input (uses any?), Seq input (uses contains-seq?),
# String input (uses str-contains? for substring search),
# and Bytes input (uses bytes-find to search for a single-byte needle).
# Signature is Val -> Collection -> Bool (subject-last for pipeline composition).
contains?@[doc: "Check if collection contains element"]: [fn@Boolean [let val xs]
    [match [builtin-eq-string [type-of xs] "String"]
        0: [match [builtin-eq-string [type-of xs] "Bytes"]
            0: [if [seq? xs]
                [contains-seq? xs val]
                [any? [fn [let e] [= e val]] xs]]
            ...: [if [int? val]
                [if [>= val 0]
                    [if [< val 256]
                        [match [builtin-int-gte [builtin-bytes-find xs [builtin-bytes-of [0: val]]] 0] 0: Boolean.False ...: Boolean.True]
                        [error "contains?: byte value must be in range 0-255"]]
                    [error "contains?: byte value must be in range 0-255"]]
                [error "contains?: needle must be Int (byte value) when haystack is Bytes"]]]
        ...: [str-contains? val xs]]]

uniq@[doc: "Remove duplicates (keep first occurrence). O(n²) due to O(n) contains-seq? per element, but uses reduce (Rust loop) for performance."]: [fn@Dict [let xs]
  [reduce-step: [fn [let acc v]
    [if [contains-seq? [builtin-dict-get "seen" acc] v]
      acc
      [seen:   [Seq.Cons head: v  tail: [builtin-dict-get "seen" acc]]
       result: [dict-append [builtin-dict-get "result" acc] v]]]]]
  [builtin-dict-get "result"
    [reduce reduce-step [seen: Seq.End  result: []] xs]]]

# Right fold: fold f over xs from the right, starting with acc.
# Equivalent to fold(f, acc, reverse(xs)).
foldr@[doc: "Right fold: foldr f acc [x|xs] = f x (foldr f acc xs)"]: [fn@[bind: [a b]  return: b] [let f@[Fn@b [a b]] acc@b xs@[Seq a]]
    [match xs
        [case [let p] [Seq.Cons p] [f p.head [foldr f acc p.tail]]]
        Seq.End:      acc]]

# ============================================================================
# Composition
# ============================================================================

compose: [fn@[bind: [a b c]  return: [Fn@c [a]]  doc: """
Compose two functions: (compose f g)(x) = f(g(x)).

Example: [[compose [+ _ 1] [* _ 2]] 5] => 11  (first *2=10, then +1=11)

Note: Returns a new function that applies g first, then f. Composition order is right-to-left (mathematical convention).
"""] [let f@[Fn@c [b]] g@[Fn@b [a]]] [fn@[bind: [a]] [let x@a] [f [g x]]]]

->: [fn@[bind: [a b]  return: b  doc: """
Thread value through functions (pipeline operator).

Example: [-> 5 [+ _ 1] [* _ 2]] => 12
Example: [-> [1 2 3] [map [+ _ 1]] [filter [> _ 2]]] => Seq(3, 4)

Note: Threads initial value v through each function in sequence. Each function receives the result of the previous step. Pipeline flows left-to-right.
"""] [let v@a ...stages] [reduce [fn [let acc f] [f acc]] v stages]]

# ============================================================================
# Type Predicates
# ============================================================================

# Type predicates — tinct functions returning Boolean.
# No builtins needed: tinct pattern matching covers all cases.
# null? uses builtin-eq-int on the length — = would go through Equatable which calls null? (cycle).
int?@[doc: "Check if value is Int"]:   [fn@Boolean [let x@[is: Int]] [match x [@Integer _]:      Boolean.True  ...: Boolean.False]]
float?@[doc: "Check if value is Float"]: [fn@Boolean [let x@[is: Float]] [match x [@Float _]:  Boolean.True  ...: Boolean.False]]
str?@[doc: "Check if value is String"]: [fn@Boolean [let x@[is: String]] [match x [@String _]:     Boolean.True  ...: Boolean.False]]
bool?@[doc: "Check if value is Bool"]:  [fn@Boolean [let x@[is: Boolean]] [match x Boolean.True: Boolean.True  Boolean.False: Boolean.True  ...: Boolean.False]]
null?@[doc: "Check if value is null (empty dict [])"]: [fn@Boolean [let x@[is: Null]] [if [dict? x] [match [builtin-eq-int [builtin-dict-length x] 0] 0: Boolean.False ...: Boolean.True] Boolean.False]]
dict?@[doc: "Check if value is Dict"]:  [fn@Boolean [let x@[is: Dict]] [match x [@Dict _]:    Boolean.True  ...: Boolean.False]]
fn?@[doc: "Check if value is a function (Function or Builtin)"]: [fn@Boolean [let x@[is: Callable]] [match x [@Callable _]: Boolean.True  ...: Boolean.False]]
proxy?@[doc: "Check if value is a Proxy"]: [fn@Boolean [let x] [match x [@Proxy _]: Boolean.True  ...: Boolean.False]]
seq?@[doc: "Check if value is a Seq"]:  [fn@Boolean [let x@[is: Seq]] [match x [@Seq _]:     Boolean.True  ...: Boolean.False]]
bytes?@[doc: "Check if value is Bytes"]: [fn@Boolean [let x@[is: Bytes]] [match x [@Bytes _]:  Boolean.True  ...: Boolean.False]]

num?@[doc: "Check if value is numeric (Int or Float)"]: [fn@Boolean [let x] [or [int? x] [float? x]]]

# record?: True if the argument is a Dict (Record at type level, Dict at runtime).
# At runtime, all dicts are Records — the distinction is type-checker-only.
# Delegates to dict? since all runtime Records are Dicts.
# Type: (Any -> Bool)
# Example: [record? [a: 1]] => True
# Example: [record? 42] => False
record?@[doc: "Check if value is a record (Dict at runtime)"]: dict?

# map?: True if the argument is a Dict (Map at type level, Dict at runtime).
# At runtime, all dicts are Maps — the distinction is type-checker-only.
# Delegates to dict? since all runtime Maps are Dicts.
# Type: (Any -> Bool)
# Example: [map? [a: 1]] => True
# Example: [map? 42] => False
map?@[doc: "Check if value is a map (Dict at runtime)"]: dict?

# Check if a value is a "list-shaped dict" — i.e., a dict whose keys are all integers.

# ============================================================================
# Error Handling
# ============================================================================

try-or: [fn@[bind: [a]  return: a  doc: """
Call function; return default on error.

Example: [try-or [fn [] [/ 10 0]] 99] => 99
Example: [try-or [fn [] [/ 10 2]] 99] => 5

Note: Wraps the function call in error handling. Returns the function's result if successful, or the default value if an error occurs. Inherently materializing: must materialize body to catch errors.
"""] [let f@[Fn@a []] default@a]
    [try-or-impl [raw-to-result [builtin-try [f]]] default]]

# ============================================================================
# Seq Type (Lazy Linked-List Sequence)
# ============================================================================

# Seq type: lazy recursive nominal ADT for streaming sequences.
# End is the empty terminal; Cons head tail is a non-empty cell.
# The runtime representation uses Seq.Cons / Seq.End variant tags (S-896).
# Seq a is structurally isomorphic to the recursive type End | [Cons head: a  tail: [Seq a]].
#
# Seq is declared here (public dict) so private Seq-building helpers below can
# reference Seq.End and Seq.Cons directly. Callers who include the prelude get Seq.
Seq: [type [let a]
  Cons: [head: a  tail: [Seq a]]
  End]

# ============================================================================
# Seq helpers — private implementations for collection functions
# ============================================================================
# These helpers were moved from the private dict to the public dict so they can
# reference Seq.End directly (available here since Seq is declared above).


# contains-seq?: Check if a Seq contains val (O(n) linear scan).
contains-seq?: [fn@[bind: [a]  return: Boolean] [let seq@[Seq a] val@a]
    [reduce
        [fn [let found x]
            [match [bool->int found] 0: [match [bool->int [= x val]] 0: Boolean.False ...: Boolean.True] ...: found]]
        Boolean.False
        seq]]


# take-while-seq: Build a lazy Seq of entries while predicate holds (on the .value field).
take-while-seq: [fn@[bind: [a]  return: [Seq Dict]] [let pred@[Fn@Boolean [a]] entries]
    [match entries
        [case [let p] [Seq.Cons p] [if [pred [builtin-dict-get "value" p.head]]
            [Seq.Cons head: p.head  tail: [take-while-seq pred p.tail]]
            Seq.End]]
        Seq.End:      Seq.End]]

# drop-while-seq: Build a lazy Seq of entries after dropping while predicate holds (on .value).
drop-while-seq: [fn@[bind: [a]  return: [Seq Dict]] [let pred@[Fn@Boolean [a]] entries dropping]
    [match entries
        [case [let p] [Seq.Cons p] [if dropping
            [if [pred [builtin-dict-get "value" p.head]]
                [drop-while-seq pred p.tail True]
                [Seq.Cons head: p.head  tail: [drop-while-seq pred p.tail False]]]
            [Seq.Cons head: p.head  tail: [drop-while-seq pred p.tail False]]]]
        Seq.End: Seq.End]]

# flatten-seq-impl / helpers: recursively build a Seq by appending sublists.
flatten-seq-impl: [fn@[bind: [a]  return: [Seq a]] [let xs@Dict ks i@Integer len@Integer]
    [match [builtin-int-gte i len]
        0: [flatten-seq-step xs ks i len [builtin-dict-get i ks]]
        ...: Seq.End]]

flatten-seq-step: [fn@[bind: [a]  return: [Seq a]] [let xs@Dict ks i@Integer len@Integer k]
    [match [builtin-dict-get k xs]
        [@Dict _]: [flatten-seq-append-dict [builtin-dict-get k xs] [flatten-seq-impl xs ks [builtin-int-add i 1] len]]
        ...:         [Seq.Cons
                        head: [builtin-dict-get k xs]
                        tail: [flatten-seq-impl xs ks [builtin-int-add i 1] len]]]]

flatten-seq-start: [fn@[bind: [a]  return: [Seq a]] [let ks d@Dict rest]
    [flatten-seq-concat-values d ks 0 [builtin-dict-length ks] rest]]

flatten-seq-append-dict: [fn@[bind: [a]  return: [Seq a]] [let d@Dict rest]
    [flatten-seq-start [builtin-keys d] d rest]]

flatten-seq-concat-values: [fn@[bind: [a]  return: [Seq a]] [let d@Dict ks i@Integer len@Integer rest@[Seq a]]
    [match [builtin-int-gte i len]
        0: [Seq.Cons
            head: [builtin-dict-get [builtin-dict-get i ks] d]
            tail: [flatten-seq-concat-values d ks [builtin-int-add i 1] len rest]]
        ...: rest]]

# ============================================================================
# Pure-tinct Seq traversal helpers (T-1320, S-896)
# ============================================================================
#
# These replace the eliminated Rust builtins (builtin-seq, builtin-head,
# builtin-tail, builtin-reverse, map on Seq, builtin-filter on Seq,
# reduce on Seq). All implementations use only nominal Seq constructors.
#
# seq-reverse-step: tail-recursive accumulator-based reverse.
# seq-map-lazy:     cons-recursive lazy map (tail suspended as thunk, O(1) per element).
# seq-filter-lazy:  cons-recursive lazy filter (predicate evaluated eagerly per element).


seq-map-lazy@[doc: """
Internal: cons-recursive map helper. Safe on infinite Seqs via laziness.

The recursive call `tail: [seq-map-lazy f p.tail]` is NOT in tail position —
it is embedded inside a Seq.Cons constructor. In tinct's lazy evaluation model,
`tail: expr` suspends `expr` as a thunk without evaluating it. Each force of
`head` on the result creates one Seq.Cons cell and one thunk for the tail.
Stack depth never exceeds one frame. This is laziness, not TCO.
"""]:
  [fn@[bind: [a b]  return: [Seq b]] [let f@[Fn@b [a]] s@[Seq a]]
    [match s
      [case [let p] [Seq.Cons p] [Seq.Cons head: [f p.head]  tail: [seq-map-lazy f p.tail]]]
      Seq.End:      Seq.End]]

seq-filter-lazy@[doc: """
Internal: cons-recursive filter helper. The predicate is evaluated eagerly
(required to decide inclusion). Tail-recursive on consecutive failing elements
via TCO — stack depth O(1) in the common case.
"""]:
  [fn@[bind: [a]  return: [Seq a]] [let f@[Fn@Boolean [a]] s@[Seq a]]
    [match s
      [case [let p] [Seq.Cons p]
        [if [f p.head]
          [Seq.Cons head: p.head  tail: [seq-filter-lazy f p.tail]]
          [seq-filter-lazy f p.tail]]]
      Seq.End: Seq.End]]

# ============================================================================
# Dict-to-Seq iteration — single-step Rust primitives + tinct lazy wrappers
#
# each, each-key, each-kv are defined here as tinct functions that call
# builtin-dict-nth / builtin-dict-key-nth / builtin-dict-kv-nth.
# These builtins are O(1) single-step primitives; the tinct wrappers drive
# laziness by producing Seq.Cons cells recursively.
# ============================================================================


# ============================================================================
# Transport Type (Network Transport Variants)
# ============================================================================

# Transport type: union of network transport variants
# Used by connect builtin to specify connection type
Transport: [type Tcp Udp UnixStream UnixDatagram NamedPipe Icmp]
# Short-name aliases for Transport constructors (injected like Ok/Error/Some/None).
# User code can use bare Tcp, Udp etc. without qualifying with Transport.
Tcp:          Transport.Tcp
Udp:          Transport.Udp
UnixStream:   Transport.UnixStream
UnixDatagram: Transport.UnixDatagram
NamedPipe:    Transport.NamedPipe
Icmp:         Transport.Icmp

# ============================================================================
# Open Mode Constants (File Open Mode Strings)
# ============================================================================


# File — all file I/O type and class declarations in one namespace.
# Flags (Appendable, Exclusive, Binary) and typeclasses (Readable, Writable, Closeable)
# live here so they don't collide with data-structure typeclasses (e.g. Appendable for FingerTree).
File: [
  Closeable@[doc: "Typeclass for handles that can be explicitly closed."]:
    [class [let h]
      close: [Fn@h [h]]]

  Readable@[doc: "Typeclass for readable handles: read-chunk."]:
    [class [let h]
      read-chunk: [Fn@[bytes: Bytes  handle: h] [h Int]]]

  Writable@[doc: "Typeclass for writable handles: write and flush."]:
    [class [let h]
      write: [Fn@h [String h]]
      flush: [Fn@h [h]]]

  Appendable: [type Appendable]   # O_APPEND — writes always go to end
  Exclusive:  [type Exclusive]    # O_EXCL+O_CREAT — fail if file already exists
  Binary:     [type Binary]       # encoding hint: handle yields Bytes not String
]

# File is Closeable, Readable, and Writable.
[instance File.Closeable
  [let h@File]: [close: [fn [let h] [if [builtin-file-close h] h h]]]]

[instance File.Writable
  [let h@File]: [write: [fn [let s h] [builtin-file-write h s]]
                 flush: [fn [let h] [if [builtin-file-flush h] h h]]]]

[instance File.Readable
  [let h@File]: [read-chunk: [fn [let n h] [bytes: [builtin-file-read h n]  handle: h]]]]

# Stdout and Stderr are Writable but NOT Closeable.
[instance File.Writable
  [let h@Stdout]: [write: [fn [let s h] [builtin-write-stdout s h]]
                   flush: [fn [let h] h]]]

[instance File.Writable
  [let h@Stderr]: [write: [fn [let s h] [builtin-write-stderr s h]]
                   flush: [fn [let h] h]]]

# Stdin is Readable but NOT Closeable.
[instance File.Readable
  [let h@Stdin]: [read-chunk: [fn [let n h] [bytes: [builtin-read-stdin n]  handle: h]]]]


# DirCapFlag type: permission flags passed to the [narrow] builtin.
# Controls which capabilities a narrowed DirCap inherits from its source.
DirCapFlag: [type Statable Listable Deletable Renameable]
# Constructors Statable, Listable, Deletable, Renameable are automatically exported
# by the type checker — no explicit re-exports needed.

# ============================================================================
# Result Type and Combinators
# ============================================================================

# Result type: Ok[value: a] | Error[msg: String]
Result: [type [let a]
  Ok:    [value: a]
  Error: [msg: String]]
# T-1086 convenience aliases — explicit bindings so bare Ok/Error remain valid.
# These work now that [type ...] evaluates to a constructor dict (T-1193).
Ok:    Result.Ok
Error: Result.Error

ok?: [fn@[bind: [a]  return: Boolean  doc: """
Check if Result is Ok.

Example: [ok? [Result.Ok 42]] => Boolean.True
Example: [ok? [Result.Error "bad"]] => Boolean.False

Note: Predicate for Result success case.
"""] [let r@[Result a]]
    [match r
        [case [let _] [Result.Ok]    Boolean.True]
        [case [let _] [Result.Error] Boolean.False]]]

error?: [fn@[bind: [a]  return: Boolean  doc: """
Check if Result is Error.

Example: [error? [Result.Error "bad"]] => Boolean.True
Example: [error? [Result.Ok 42]] => Boolean.False

Note: Predicate for Result error case.
"""] [let r@[Result a]]
    [match r
        [case [let _] [Result.Ok]    Boolean.False]
        [case [let _] [Result.Error] Boolean.True]]]

and-then: [fn@[bind: [a b]  return: [Result b]  doc: """
Monad bind for Result (chain computations).

Example: [and-then [fn [x] [Result.Ok [* x 2]]] [Result.Ok 21]] => [Result.Ok 42]
Example: [and-then [fn [x] [Result.Ok [* x 2]]] [Result.Error "bad"]] => [Result.Error "bad"]

Note: Signature is Fn -> Result -> Result (subject-last for pipeline composition).
If Ok, applies f to the value; if Error, passes through. Matches Rust's .and_then(f) and Haskell's result >>= f. Equivalent to MonadResult.bind.
"""] [let f@[Fn@[Result b] [a]] result@[Result a]]
    [match result
        [case [let p]   [Result.Ok p]    [f p.value]]
        [case [let p]   [Result.Error p] [Error msg: p.msg]]]]

result-or: [fn@[bind: [a]  return: a  doc: """
Unwrap Ok value or return default.

Example: [result-or 99 [Result.Ok 42]] => 42
Example: [result-or 99 [Result.Error "bad"]] => 99

Note: Default-value behavior for Result. Returns the Ok value if present, otherwise the default.
"""] [let default@a result]
    [match result
        [case [let p] [Result.Ok p]    p.value]
        [case [let _] [Result.Error]   default]]]

result-map: [fn@[bind: [a b]  return: [Result b]  doc: """
Functor map over Result.

Example: [result-map [fn [x] [* x 2]] [Ok 21]] => Variant(Result.Ok, {value: 42})
Example: [result-map [fn [x] [* x 2]] [Error msg: "bad"]] => Variant(Result.Error, {msg: "bad"})

Note: Maps a function over the Ok value; passes Error through unchanged.
"""] [let f@[Fn@b [a]] result@[Result a]]
    [match result
        [case [let p]   [Result.Ok p]    [Ok value: [f p.value]]]
        [case [let p]   [Result.Error p] [Error msg: p.msg]]]]

result@[doc: "Result monad dict for [do result ...] chains"]:
  [bind: [fn [let r f] [and-then f r]]  pure: Ok]

# ============================================================================
# Type Class Declarations: Functor, Applicative, Monad, Foldable, Traversable
# ============================================================================
#
# Typeclass hierarchy for higher-kinded types (HKT). These classes enable
# generic functions polymorphic over any type constructor (Result, Seq).
#
# See doc/whatif/completed/hkt-monads.md for the full design.

# Maps a function over a wrapped value (fmap)
Functor@[doc: "Type class for type constructors supporting fmap"]:
  [class [let f]]

# Functor instance for Result type
FunctorResult@[doc: "Functor instance for Result"]:
  [instance Functor
    [let f@Result]: [fmap: result-map]]

# Functor instance for Seq type
FunctorSeq@[doc: "Functor instance for Seq"]:
  [instance Functor
    [let f@Seq]: [fmap: map]]

# Lifts values and applies wrapped functions (pure, lift2)
Applicative@[doc: "Type class for applicative functors"]:
  [class [let f]]

# Applicative instance for Result type
ApplicativeResult@[doc: "Applicative instance for Result"]:
  [instance Applicative
    [let f@Result]: [
      pure:  Ok
      lift2: [fn [let f ra rb]
        [and-then [fn [let a]
        [and-then [fn [let b]
          [Ok value: [f a b]]] rb]] ra]]]]

# Applicative instance for Seq type
ApplicativeSeq@[doc: "Applicative instance for Seq"]:
  [instance Applicative
    [let f@Seq]: [
      pure:  [fn [let x] [x]]
      lift2: [fn [let f sa sb]
        [flat-map sa [fn [let a]
          [map [fn [let b] [f a b]] sb]]]]]]

# Sequential composition of wrapped computations (bind)
Monad@[doc: "Type class for monads"]:
  [class [let m]]

# Monad instance for Result type
MonadResult@[doc: "Monad instance for Result"]:
  [instance Monad
    [let m@Result]: [bind: [fn [let r f] [and-then f r]]]]

# Monad instance for Seq type
MonadSeq@[doc: "Monad instance for Seq"]:
  [instance Monad
    [let m@Seq]: [bind: [fn [let xs f] [flat-map f xs]]]]

# Reduces a structure to a single value (fold, to-seq)
Foldable@[doc: "Type class for foldable structures"]:
  [class [let t]]

# Foldable instance for Seq type
FoldableSeq@[doc: "Foldable instance for Seq"]:
  [instance Foldable
    [let t@Seq]: [
      fold:   reduce
      to-seq: [fn [let xs] xs]]]

# Foldable instance for Record (Dict) type
FoldableRecord@[doc: "Foldable instance for Record"]:
  [instance Foldable
    [let t@Record]: [
      fold:   reduce
      to-seq: values]]

# Foldable instance for Result type
FoldableResult@[doc: "Foldable instance for Result"]:
  [instance Foldable
    [let t@Result]: [
      fold:   [fn [let f init r]
        [match r
          [case [let p] [Result.Ok p]    [f init p.value]]
          [case [let _] [Result.Error]   init]]]
      to-seq: [fn [let r]
        [match r
          [case [let p] [Result.Ok p]    [0: p.value]]
          [case [let _] [Result.Error]   []]]]]]

# Traverses a structure applying effects (traverse)
Traversable@[doc: "Type class for traversable structures"]:
  [class [let t]]

# Traversable instance for Seq type
TraversableSeq@[doc: "Traversable instance for Seq"]:
  [instance Traversable
    [let t@Seq]: [
      # Primitive fold-based implementation — NOT via generic sequence/traverse
      # (which would be circular: sequence calls traverse calls t.traverse calls sequence).
      traverse: [fn [let f xs]
        [reduce
          [fn [let acc x]
            [f.lift2 [fn [let as a] [concat as [a]]] acc [f x]]]
          [f.pure []]
          xs]]]]

# Traversable instance for Result type
TraversableResult@[doc: "Traversable instance for Result"]:
  [instance Traversable
    [let t@Result]: [
      traverse: [fn [let f r]
        [match r
          [case [let p] [Result.Ok p]    [f.fmap Ok [f p.value]]]
          [case [let p] [Result.Error p] [f.pure [Error msg: p.msg]]]]]]]

# Absent: sentinel value for missing keys/vars/elements.
# Returned by get?, env, head on empty seq. NOT interchangeable with null? (empty collection).
Absent: [type Absent]

absent?@[doc: "Boolean.True if x is Absent.Absent (a missing value), Boolean.False otherwise."]:
  [fn@Boolean [let x@Unknown]
    [match x
      [Absent.Absent]: Boolean.True
      ...: Boolean.False]]

# ============================================================================
# Common Constructor Aliases (Convenience Bindings)
# ============================================================================
#

# ============================================================================
# Generic Functions for HKT
# ============================================================================
#
# These generic functions are polymorphic over any Functor/Monad/Traversable.
# They require HKT support (rank-1 kind polymorphism) to type-check correctly.

sequence: [fn@[return: Unknown  doc: """
Collect effects: t (f a) → f (t a).

Example: [sequence TraversableSeq [[Result.Ok 1] [Result.Ok 2]]] => [Result.Ok [1 2]]

Note: Generic over any Traversable container (Seq, Result). Defined as [traverse identity]. Turns a traversable of wrapped values into a wrapped traversable.
"""] [let t xs]
  [t.traverse [fn [let x] x] xs]]

traverse: [fn@[return: Unknown  doc: """
Map with effects: (a → f b) → t a → f (t b).

Example: [traverse [fn [x] [Result.Ok [* x 2]]] TraversableSeq [1 2 3]] => [Result.Ok [2 4 6]]

Note: Applies effectful function f to each element of structure xs, collecting results. Generic over any Traversable container. Delegates to t.traverse.
"""] [let f t xs]
  [t.traverse f xs]]

forM: [fn@[return: Unknown  doc: """
Traverse with flipped arguments (function moved to last argument (Traversable instance still first)).

Example: [forM TraversableSeq [1 2 3] [fn [x] [Result.Ok [* x 2]]]] => [Result.Ok [2 4 6]]

Note: Same as traverse but with collection and function arguments swapped for pipeline-friendly ordering.
"""] [let t xs f]
  [traverse f t xs]]

liftM2: [fn@[return: Unknown  doc: """
Lift binary function into monad.

Example: [liftM2 ApplicativeResult + [Result.Ok 1] [Result.Ok 2]] => [Result.Ok 3]

Note: Applies a two-argument function to two wrapped values, combining results. Generic over any Applicative. Requires an explicit Applicative instance dict as the first argument.
"""] [let app f ma mb]
  [app.lift2 f ma mb]]

whenM: [fn@[return: Unknown  doc: """
Conditionally execute monadic action.

Example: [whenM ApplicativeResult True [Result.Ok "done"]] => [Result.Ok "done"]
Example: [whenM ApplicativeResult False [Result.Ok "skip"]] => [Result.Ok []]

Note: Returns action result if condition is True, otherwise returns wrapped empty dict. Generic over any Applicative with pure. Requires an explicit Applicative instance dict as the first argument.
"""] [let app cond action]
  [if cond action [app.pure []]]]

# ============================================================================
# Type Class Declarations: Number
# ============================================================================
#
# Number is a constraint class for numeric types (Int and Float).
# It has no methods — it is a pure presence constraint used by @Number annotations
# to mean "this parameter must be Int or Float". Previously Type::Number existed as
# a Rust-native type variant; this typeclass replaces it so numeric constraints are
# resolved through the standard instance mechanism instead of hardwired Rust logic.

Number@[doc: "Constraint class for numeric types (Int and Float). Empty-method constraint — no methods, just presence."]:
  [class [let n]]

[instance Number [let n@Integer]:   []]
[instance Number [let n@Float]: []]

# ============================================================================
# Type Class Declarations: Arithmetic
# ============================================================================

# Arithmetic type classes with functional dependencies (a, b) → c

Addable@[doc: "Type class for addition with FD (a, b) → c"]:
  [class [let a b c]  [determines: [[[a b] c]]]
    +: [Fn@c [a b]]]

Subtractable@[doc: "Type class for subtraction with FD (a, b) → c"]:
  [class [let a b c]  [determines: [[[a b] c]]]
    -: [Fn@c [a b]]]

Multipliable@[doc: "Type class for multiplication with FD (a, b) → c"]:
  [class [let a b c]  [determines: [[[a b] c]]]
    *: [Fn@c [a b]]]

Divisible@[doc: "Type class for division with FD (a, b) → c"]:
  [class [let a b c]  [determines: [[[a b] c]]]
    /: [Fn@c [a b]]]

# Arithmetic instances for Int/Float combinations

[instance Addable
  [let a@Integer b@Integer c@Integer]: [+: [fn@Integer [let x@Integer y@Integer] [builtin-int-add x y]]]
  [let a@Integer b@Float   c@Float  ]: [+: [fn@Float   [let x@Integer y@Float  ] [builtin-float-add [builtin-int-to-float x] y]]]
  [let a@Float   b@Integer c@Float  ]: [+: [fn@Float   [let x@Float   y@Integer] [builtin-float-add x [builtin-int-to-float y]]]]
  [let a@Float   b@Float   c@Float  ]: [+: [fn@Float   [let x@Float   y@Float  ] [builtin-float-add x y]]]]

[instance Subtractable
  [let a@Integer b@Integer c@Integer]: [-: [fn@Integer [let x@Integer y@Integer] [builtin-int-sub x y]]]
  [let a@Integer b@Float   c@Float  ]: [-: [fn@Float   [let x@Integer y@Float  ] [builtin-float-sub [builtin-int-to-float x] y]]]
  [let a@Float   b@Integer c@Float  ]: [-: [fn@Float   [let x@Float   y@Integer] [builtin-float-sub x [builtin-int-to-float y]]]]
  [let a@Float   b@Float   c@Float  ]: [-: [fn@Float   [let x@Float   y@Float  ] [builtin-float-sub x y]]]]

[instance Multipliable
  [let a@Integer b@Integer c@Integer]: [*: [fn@Integer [let x@Integer y@Integer] [builtin-int-mul x y]]]
  [let a@Integer b@Float   c@Float  ]: [*: [fn@Float   [let x@Integer y@Float  ] [builtin-float-mul [builtin-int-to-float x] y]]]
  [let a@Float   b@Integer c@Float  ]: [*: [fn@Float   [let x@Float   y@Integer] [builtin-float-mul x [builtin-int-to-float y]]]]
  [let a@Float   b@Float   c@Float  ]: [*: [fn@Float   [let x@Float   y@Float  ] [builtin-float-mul x y]]]]

[instance Divisible
  [let a@Integer   b@Integer   c@Integer  ]: [/: [fn       [let x@Integer   y@Integer  ] [builtin-div x y]]]
  [let a@Integer   b@Float c@Float]: [/: [fn@Float [let x@Integer   y@Float] [builtin-div x y]]]
  [let a@Float b@Integer   c@Float]: [/: [fn@Float [let x@Float y@Integer  ] [builtin-div x y]]]
  [let a@Float b@Float c@Float]: [/: [fn@Float [let x@Float y@Float] [builtin-div x y]]]]

# ============================================================================
# Type Class Declarations: Equatable
# ============================================================================

# Types supporting equality comparison (=)
Equatable@[doc: "Type class for types that support equality comparison"]:
  [class [let a]
    =: [Fn@Boolean [a a]]]

# Concrete type Equatable instances — use type-specific equality primitives.
# builtin-eq-int/float/string return Int(1/0); use match for branching to produce Boolean.
# Bool equality: convert to Int via bool->int-priv, then compare with builtin-eq-int.
[instance Equatable
  [let a@Integer]:    [=: [fn [let x@Integer    y@Integer]    [match [builtin-eq-int    x y] 0: Boolean.False ...: Boolean.True]]]
  [let a@Float]:  [=: [fn [let x@Float  y@Float]  [match [builtin-eq-float  x y] 0: Boolean.False ...: Boolean.True]]]
  [let a@String]: [=: [fn [let x@String y@String] [match [builtin-eq-string x y] 0: Boolean.False ...: Boolean.True]]]
  [let a@Boolean]:   [=: [fn [let x@Boolean   y@Boolean]   [match [builtin-eq-int [bool->int-priv x] [bool->int-priv y]] 0: Boolean.False ...: Boolean.True]]]]

# Cross-type catch-all: comparing values of different types always returns Boolean.False
[instance Equatable
  [let a]: [=: [fn [let x y] Boolean.False]]]

# Eval-env fallback for =: called when the type checker cannot resolve the Equatable
# instance (e.g., Unknown type). Not a dispatch function — just a named function in scope.
=: [fn [let x y] Boolean.False]

# ============================================================================
# Type Class Declarations: Matchable
# ============================================================================
#
# Matchable: any type whose values can serve as pattern predicates.
# to-match converts a value to an Int match signal: nonzero = truthy, zero = falsy.
# This is the typeclass gate — only Matchable types are valid as predicate returns.
#
# The Rust runtime (eval.rs::call_to_match) looks up the instance binding directly:
#   instance_binding_name("Matchable", "to-match", [type_name])
# The binding name format is: ɪɴꜱᴛᴀɴᴄᴇ⧼Matchable∷to-match⟨TypeName⟩⧽
# This requires anonymous multi-arm instances so lower.rs emits the binding names.

Matchable@[doc: """
Typeclass for types whose values can serve as pattern predicates.
to-match converts a value to an Int match signal: nonzero = truthy, zero = falsy.
The Rust pattern matching engine looks up the instance binding directly by type name.
"""]:
  [class [let a]
    to-match: [Fn@Integer [a]]]

# Matchable instances for Boolean and Int — anonymous multi-arm so lower.rs emits
# instance_binding_name keys (ɪɴꜱᴛᴀɴᴄᴇ⧼Matchable∷to-match⟨Boolean⟩⧽, etc.).
[instance Matchable
  [let a@Boolean]: [to-match: [fn@Integer [let x@Boolean]
    [match x Boolean.True: 1 ...: 0]]]
  [let a@Integer]:     [to-match: [fn@Integer [let x@Integer] x]]]


# ============================================================================
# Type Class Declarations: Comparable
# ============================================================================

# Comparable = Sortable + Equatable. Defines no new methods — < comes from Sortable.
# Use Sortable directly for types that have ordering but not equality (e.g. Float/NaN).
Comparable@[doc: "Type class for types that support both ordering and equality. Requires Equatable and Sortable. Use Sortable directly for types like Float that have ordering but not equality."]:
  [class [let a] [superclasses: [[Equatable a] [Sortable a]]]]

# ============================================================================
# Type Class Declarations: Castable
# ============================================================================

# General cast protocol: values that can be cast to a target type.
# The two-parameter class (target, source) replaces the old single-parameter
# Showable class. The canonical call form is [@String [cast x]] — the @String
# annotation tells the type checker target=String and dispatches to the
# appropriate Castable String <source> instance.
#
# str is a thin convenience alias: [fn@String [let x] [cast x]].
Castable@[doc: "Typeclass for values that can be cast to a target type"]:
  [class [let target source]
    cast: [Fn@target [source]]]

[instance Castable [let target@String source@Integer]:
  [cast: [fn [let x] [builtin-int->string x]]]]

[instance Castable [let target@String source@Float]:
  [cast: [fn [let x] [builtin-float->string x]]]]

[instance Castable [let target@String source@String]:
  [cast: [fn [let x] x]]]

[instance Castable [let target@String source@Boolean]:
  [cast: [fn [let x] [if x "true" "false"]]]]

[instance Castable [let target@String source@Bytes]:
  [cast: [fn [let x] [builtin-bytes-str x]]]]

[instance Castable [let target@String source@Dict]:
  [cast: [fn [let d]
    [pairs: [map [fn [let k]
        [builtin-string-concat [@String [cast k]] [builtin-string-concat ": " [@String [cast [get k d]]]]]]
      [keys d]]]
    [builtin-string-concat "[" [builtin-string-concat [join "  " pairs] "]"]]]]]

[instance Castable [let target@String source@Map]:
  [cast: [fn [let m]
    [pairs: [map [fn [let k]
        [builtin-string-concat [@String [cast k]] [builtin-string-concat ": " [@String [cast [get k m]]]]]]
      [keys m]]]
    [builtin-string-concat "[" [builtin-string-concat [join "  " pairs] "]"]]]]]

# str: thin convenience alias for [@String [cast x]].
# The @String return annotation drives Castable dispatch to the String target.
str@[doc: "Convert a single value to String via Castable dispatch"]:
  [fn@String [let x] [@String [cast x]]]

# ============================================================================
# Type Class Declarations: Printable
# ============================================================================
#
# Printable is the well-typed typeclass for converting a specific primitive to
# a String via its `print` method. Printable instances use the thin primitives
# `builtin-int->string` and `builtin-float->string` that do no typeclass
# dispatch and cannot recurse. Castable String instances (above) use these
# same primitives, making Castable the general form and Printable the
# primitive-only subset.

Printable@[doc: "Type class for types that can be converted to a String via print"]:
  [class [let a]]

PrintableInt@[doc: "Printable instance for Int: print converts an Int to its decimal string"]:
  [instance Printable
    [let a@Integer]: [print: [fn [let x@Integer] [builtin-int->string x]]]]

PrintableFloat@[doc: "Printable instance for Float: print converts a Float to its string representation"]:
  [instance Printable
    [let a@Float]: [print: [fn [let x@Float] [builtin-float->string x]]]]

PrintableBool@[doc: "Printable instance for Bool: print converts a Bool to \"True\" or \"False\""]:
  [instance Printable
    [let a@Boolean]: [print: [fn [let x] [match [bool->int x] 0: "False" ...: "True"]]]]

PrintableStr@[doc: "Printable instance for String: print is the identity (strings are already strings)"]:
  [instance Printable
    [let a@String]: [print: [fn [let x@String] x]]]

# ============================================================================
# Type Class Declarations: Mappable
# ============================================================================

# Collection-level mapping (map over structures)
Mappable@[doc: "Type class for mappable type constructors (Seq, Dict)"]:
  [class [let f]]

# Mappable instance for Seq type
MappableSeq@[doc: "Mappable instance for Seq: fmap = map"]:
  [instance Mappable
    [let f@Seq]: [fmap: [fn [let f xs] [map f xs]]]]

# Mappable instance for Dict type
MappableDict@[doc: "Mappable instance for Dict: fmap = map"]:
  [instance Mappable
    [let f@Dict]: [fmap: [fn [let f m] [map f m]]]]

# ============================================================================
# Type Class Declarations: Prependable, Appendable, Concatenable (S-897)
# ============================================================================
#
# Prependable: O(1) amortized push-left, peek-left, pop-left.
# Appendable:  O(1) amortized push-right, peek-right, pop-right.
# Concatenable: O(log n) or better join of two collections.
#
# Typeclasses are complexity promises: every method is O(log n) or better.
# A type that is both Prependable and Appendable is a deque.
#
# Instance table:
#   Seq a  — Prependable only (O(1) exact)
#   List a — Prependable + Appendable + Concatenable + Indexable

Prependable@[doc: """
O(1) amortized push-left, peek-left, pop-left.

Typeclasses are complexity promises: every method is O(log n) or better.
A type that is both Prependable and Appendable is a deque.

Instance table:
  Seq a  — Prependable only (O(1) exact)
  List a — Prependable + Appendable + Concatenable + Indexable
"""]:
  [class [let c a]
    push-left: [Fn@c      [a c]]
    peek-left: [Fn@a      [c]]
    pop-left:  [Fn@c      [c]]]

# Prependable instance for Seq: O(1) push-left via Seq.Cons, O(1) peek/pop via match.
PrependableSeq@[doc: "Prependable instance for Seq: push-left = cons, peek-left = head, pop-left = tail"]:
  [instance Prependable
    [let c@[Seq a] a]:
    [push-left: [fn [let x s] [Seq.Cons head: x  tail: s]]
     peek-left: [fn [let s]
       [match s
         [case [let p] [Seq.Cons p] p.head]
         Seq.End:      [raise "peek-left: empty sequence"]]]
     pop-left:  [fn [let s]
       [match s
         [case [let p] [Seq.Cons p] p.tail]
         Seq.End:      [raise "pop-left: empty sequence"]]]]]

Appendable@[doc: "O(1) amortized push-right, peek-right, pop-right"]:
  [class [let c a]
    push-right: [Fn@c      [c a]]
    peek-right: [Fn@a      [c]]
    pop-right:  [Fn@c      [c]]]

Concatenable@[doc: "O(log n) or better join of two collections"]:
  [class [let c]
    <>: [Fn@c [c c]]]

# ============================================================================
# ByteOrder — numeric encoding format for builtin-encode
# ============================================================================
#
# ByteOrder specifies both the numeric type and byte order for binary encoding.
# Used with builtin-encode: [builtin-encode ByteOrder.Int64LE 42] → 8 Bytes.

ByteOrder@[doc: """
Encoding format for builtin-encode: specifies numeric type and byte order.
Unit constructors: Int8, UInt8, Int16LE/BE, UInt16LE/BE, Int32LE/BE, UInt32LE/BE,
Int64LE/BE, UInt64LE/BE, Float32LE/BE, Float64LE/BE.
"""]:
  [type
    Int8   UInt8
    Int16LE   Int16BE   UInt16LE   UInt16BE
    Int32LE   Int32BE   UInt32LE   UInt32BE
    Int64LE   Int64BE   UInt64LE   UInt64BE
    Float32LE   Float32BE
    Float64LE   Float64BE]

# ============================================================================
# encode — prelude wrapper for builtin-encode
# ============================================================================
#
# Converts a ByteOrder variant to its integer discriminant (0–17) and delegates
# to builtin-encode, which accepts only Int discriminants.
# Discriminant mapping:
#   0=Int8   1=UInt8   2=Int16LE  3=Int16BE  4=UInt16LE  5=UInt16BE
#   6=Int32LE  7=Int32BE  8=UInt32LE  9=UInt32BE  10=Int64LE  11=Int64BE
#   12=UInt64LE  13=UInt64BE  14=Float32LE  15=Float32BE  16=Float64LE  17=Float64BE

encode@[doc: """
Encode a numeric value as Bytes using the specified ByteOrder format.

Example: [encode ByteOrder.Int64LE 42] => Bytes (8 bytes, little-endian)
Example: [encode ByteOrder.Float64LE 3.14] => Bytes (8 bytes, IEEE 754)
"""]:
  [fn [let fmt val]
    [builtin-encode
      [match fmt
        ByteOrder.Int8:     0
        ByteOrder.UInt8:    1
        ByteOrder.Int16LE:  2   ByteOrder.Int16BE:  3
        ByteOrder.UInt16LE: 4   ByteOrder.UInt16BE: 5
        ByteOrder.Int32LE:  6   ByteOrder.Int32BE:  7
        ByteOrder.UInt32LE: 8   ByteOrder.UInt32BE: 9
        ByteOrder.Int64LE:  10  ByteOrder.Int64BE:  11
        ByteOrder.UInt64LE: 12  ByteOrder.UInt64BE: 13
        ByteOrder.Float32LE: 14 ByteOrder.Float32BE: 15
        ByteOrder.Float64LE: 16 ByteOrder.Float64BE: 17
        ...: [raise "encode: unknown ByteOrder format"]]
      val]]

# ============================================================================
# float-bits — IEEE 754 bit pattern of a Float as an Int
# ============================================================================
#
# Encodes a Float as 8 bytes (Float64LE = native endian on little-endian systems)
# then reinterprets those bytes as a signed 64-bit integer.
# The result is the raw IEEE 754 bit representation.
#
# Example: [float-bits 1.0] => 4607182418800017408 (0x3FF0000000000000)
# Example: [float-bits 0.0] => 0
# Example: [float-bits -0.0] => -9223372036854775808 (sign bit set)

float-bits@[doc: """
Return the raw IEEE 754 bit pattern of a Float as an Int.

Uses native (little-endian) byte order for the bit extraction.
The sign bit, exponent, and mantissa are accessible via integer arithmetic.

Example: [float-bits 1.0] => 4607182418800017408
Example: [float-bits 0.0] => 0
"""]:
  [fn@Integer [let f@Float]
    [builtin-bytes-to-int [encode ByteOrder.Float64LE f]]]

# ============================================================================
# Type Class Declarations: Hashable
# ============================================================================
# Float is intentionally excluded: NaN != NaN violates Equatable reflexivity.

Hashable@[doc: "Type class for types that can be used as dict keys (hash-consistent with =)"]:
  [class [let k] [superclasses: [[Equatable k]]]
    hash: [Fn@Integer [k]]]

[instance Hashable
  [let k@Integer]:     [hash: [fn [let a@Integer]     a]]
  [let k@String]:  [hash: [fn [let a@String]
    [reduce [fn [let acc b] [mod [+ [* acc 31] b] 2147483647]] 0 [str-bytes a]]]]
  [let k@Boolean]: [hash: [fn [let a@Boolean] [match a Boolean.True: 1 ...: 0]]]]

# ============================================================================
# Type Class Declarations: Sortable
# ============================================================================
#
# Sortable: types with a strict total order.
# Float is Sortable but NOT Equatable (NaN violates reflexivity of =).
# Sortable and Equatable are orthogonal — do not combine them into one class.
#

Sortable@[doc: """
Typeclass for types with a strict total order.
Float is Sortable but NOT Equatable (NaN violates reflexivity).
Sortable and Equatable are orthogonal.
Comparable = Sortable + Equatable.
"""]:
  [class [let k]
    <: [Fn@Boolean [k k]]]

# Sortable instances — anonymous multi-arm for automatic < dispatch.
# Each arm uses its dedicated monomorphic builtin.
# Float is included here (Sortable but not Equatable/Comparable due to NaN).
# All builtins return Int(1/0); match converts to Boolean.
[instance Sortable
  [let k@Integer]: [<: [fn [let a b] [match [builtin-lt a b]       0: Boolean.False ...: Boolean.True]]]
  [let k@Float]:   [<: [fn [let a b] [match [builtin-float-lt a b] 0: Boolean.False ...: Boolean.True]]]
  [let k@String]:  [<: [fn [let a b] [match [builtin-str-lt a b]   0: Boolean.False ...: Boolean.True]]]
  [let k@Boolean]: [<: [fn [let a b] [match [builtin-lt [bool->int a] [bool->int b]] 0: Boolean.False ...: Boolean.True]]]]

# ============================================================================
# Sequences
# ============================================================================

# Sequence constructors and list operations are registered as builtin-NAME and
# wrapped below in the "Sequence / List Wrappers" section. The public names
# (seq, head, tail, collect, range, repeat, cycle, iterate, unfold, join,
# concat, first, last, rest, cons, reverse, sort) are all defined as wrappers
# at the bottom of this dict so they can be shadowed by user code via include.

# ============================================================================
# Assertions
# ============================================================================

assert: [fn@[return: Boolean  doc: """
Assert condition with error message.

Example: [assert True "never fails"] => True
Example: [assert False "fails"] => error "fails"

Note: Returns True if condition is True; raises an error with the given message if False. Inherently materializing: must materialize condition to check.
"""] [let cond msg@String] [match [bool->int cond] 0: [error msg] ...: Boolean.True]]

# ============================================================================
# Shadowable Operator Wrappers
# ============================================================================
#
# These wrappers shadow Rust-native builtins to make them overridable by
# user code via include. Each wrapper delegates to a stable builtin-* alias
# that cannot be shadowed.
#
# This enables embedded DSLs (like stdlib/sql.llt) to redefine operators
# in lexical scope while the prelude continues to work correctly by calling
# the builtin-* escape hatches (which the prelude's internal functions use).
#
# Note: overrides apply to the initial dispatch only. Seq corecursion steps
# (map/filter/reduce/take/drop on Seq tails) always call the underlying Rust
# implementation directly via hardcoded function pointers in PendingBuiltin
# continuations, bypassing any include override.
#
# NOTE: Arity errors refer to these wrapper functions, not the underlying
# builtins. This is an accepted trade-off of the overridable-ops design.

# Note: = and < are NOT defined as prelude functions here — they dispatch via
# Equatable/Comparable multi-method instances registered above. (S-885)

# Control flow
if@[doc: "Conditional (select branch by condition)"]: [fn [let c@Boolean t e] [match c Boolean.True: t Boolean.False: e]]

# Error raising — re-exported so user code and macro-generated code can call [raise "msg"].
raise@[doc: """
Raise a user error with the given message string.

Example: [raise "something went wrong"]

Note: Always fails. The error message must be a String. Use [try f] to catch
user errors from zero-arg functions.
"""]: [fn@Never [let msg@String] [builtin-raise msg]]

# error: alias for raise. Historically used throughout the standard library
# and user code as [error "message"]. Kept for compatibility; prefer [raise] in new code.
error: raise

# Higher-order Seq functions (pure tinct — T-1321, S-896)
# map, filter, reduce, take, drop operate on Seq values via nominal ADT pattern match.
# Dict dispatch uses the builtin-* aliases (for backwards compatibility with Dict callers).

# list?: true iff x is a FingerTree/List value (any FTEmpty/FTSingle/FTDeep variant).
# Used by map/filter/reduce to dispatch on List inputs via ft-to-seq.
list?: [fn [let x]
  [match x
    FingerTree.FTEmpty:      Boolean.True
    [case [let _] [FingerTree.FTSingle _] Boolean.True]
    [case [let _] [FingerTree.FTDeep   _] Boolean.True]
    ...:                                   Boolean.False]]

filter@[return: [Seq a]  doc: """
Keep elements of a Seq satisfying predicate. Lazy — safe on infinite Seqs.

Also accepts List (finger tree) by converting to Seq via ft-to-seq first.

Example: [collect [filter [fn [let x] [> x 2]] [range 0 5]]] => [3 4]

Note: Predicate is evaluated eagerly per element. For Dict inputs use builtin-filter.
"""]: [fn@[bind: [a]  return: [Seq a]] [let f@[Fn@Boolean [a]] s]
    [if [list? s]
      [seq-filter-lazy f [ft-to-seq s]]
      [seq-filter-lazy f s]]]

map@[return: [Seq b]  doc: """
Apply function to each element of a Seq, Dict, or List. Lazy — safe on infinite Seqs.

Also accepts List (finger tree) by converting to Seq via ft-to-seq first.

Example: [collect [map [fn [let x] [* x 2]] [range 0 3]]] => [0 2 4]

Note: O(1) per element consumed. Dict inputs are converted to Seq via each.
"""]: [fn@[bind: [a b]  return: [Seq b]] [let f@[Fn@b [a]] s]
    [if [dict? s]
      [map f [each s]]
      [if [list? s]
        [seq-map-lazy f [ft-to-seq s]]
        [seq-map-lazy f s]]]]

reduce@[return: b  doc: """
Left fold a Seq, Dict, or List with a binary accumulator function. O(n).

Also accepts List (finger tree) by converting to Seq via ft-to-seq first.

Example: [reduce [fn [let acc x] [+ acc x]] 0 [range 0 4]] => 6
"""]: [fn@[bind: [a b]  return: b] [let f@[Fn@b [b a]] acc@b s]
    [if [dict? s]
      [reduce f acc [each s]]
      [if [list? s]
        [reduce f acc [ft-to-seq s]]
        [match s
          Seq.End:      acc
          [case [let p] [Seq.Cons p] [reduce f [f acc p.head] p.tail]]]]]]

take@[return: [Seq a]  doc: """
First n elements of a Seq. Lazy.

Example: [collect [take 3 [range 0 10]]] => [0 1 2]

Note: Returns Seq.End immediately when n=0. Lazy — tail thunk not forced.
"""]: [fn@[bind: [a]  return: [Seq a]] [let n@Integer s@[Seq a]]
    [if [= n 0]
      Seq.End
      [match s
        [case [let p] [Seq.Cons p] [Seq.Cons head: p.head  tail: [take [- n 1] p.tail]]]
        Seq.End:      Seq.End]]]

drop@[return: [Seq a]  doc: """
Skip first n elements of a Seq. O(n) to skip, then lazy.

Example: [collect [drop 2 [range 0 5]]] => [2 3 4]

Note: Returns s immediately when n=0. Tail-recursive on the skipped prefix via TCO.
"""]: [fn@[bind: [a]  return: [Seq a]] [let n@Integer s@[Seq a]]
    [if [= n 0]
      s
      [match s
        [case [let p] [Seq.Cons p] [drop [- n 1] p.tail]]
        Seq.End:      Seq.End]]]

# Primitive collection/string length — re-exported so macro transformers and user code
# can call [length xs] without depending on %rust "collection" being in scope.
length@[doc: """
Number of entries in a dict, string character count, or List element count.

Example: [length [a: 1  b: 2  c: 3]] => 3
Example: [length "hello"] => 5
Example: [length []] => 0
Example: [length [collect [range 0 5]]] => 5  (O(1) via ft-size)

Note: For Seq values, prefer [count identity xs] (length forces a Seq to a Dict first).
"""]: [fn@Integer [let xs]
    [match [builtin-type-of xs]
      "String": [builtin-str-length xs]
      "Bytes":  [builtin-bytes-length xs]
      ...:        [if [list? xs]
                    [ft-size xs]
                    [builtin-dict-length xs]]]]

# Reconstruct a Dict from a Seq of key-value pair dicts.
# Takes a Seq of [key: K, value: V] dicts (as produced by each-kv).
# Returns a Dict with those key-value mappings.
# assert: [collect-kv [[key: "a" value: 1] [key: "b" value: 2]]] => [a: 1 b: 2]
collect-kv@[doc: "Reconstruct dict from key-value pairs"]: [fn@Dict [let xs] [build-dict xs]]

# String search helpers (build on str-index-of primitive)
# str-contains?: String -> String -> Bool
# assert: [str-contains? "world" "hello world"] => True
# assert: [str-contains? "xyz" "hello"] => False
str-contains?@[doc: "Check if haystack contains needle"]: [fn@Boolean [let needle@String haystack@String]
  [if [builtin-int-gte [str-index-of needle haystack] 0] Boolean.True Boolean.False]]

# starts-with?: String -> String -> Boolean
# assert: [starts-with? "he" "hello"] => Boolean.True
# assert: [starts-with? "lo" "hello"] => Boolean.False
starts-with?@[doc: "Check if string starts with prefix"]: [fn@Boolean [let prefix@String s@String]
  [if [= [str-index-of prefix s] 0] Boolean.True Boolean.False]]

# ends-with?: String -> String -> Boolean
# assert: [ends-with? "lo" "hello"] => Boolean.True
# assert: [ends-with? "he" "hello"] => Boolean.False
ends-with?@[doc: "Check if string ends with suffix"]: [fn@Boolean [let suffix@String s@String]
  [if [< [str-length s] [str-length suffix]]
    Boolean.False
    [if [= [str-slice s [- [str-length s] [str-length suffix]] [str-length s]] suffix] Boolean.True Boolean.False]]]

# str-repeat: Int -> String -> String
# assert: [str-repeat 3 "x"] => "xxx"
# assert: [str-repeat 2 "ab"] => "abab"
# assert: [str-repeat 0 "x"] => ""
str-repeat@[doc: "Repeat string n times"]: [fn@String [let n@Integer s@String]
  [reduce [fn [let acc _] [builtin-string-concat acc s]] "" [range 0 n]]]

# Find the first occurrence of needle in haystack.
# Returns the byte index of the first match, or -1 if not found.
# For ASCII strings, byte index equals character index.
# str-find: String -> String -> Int
# assert: [str-find "world" "hello world"] => 6
# assert: [str-find "x" "hello world"] => -1
# assert: [str-find "" "abc"] => 0
str-find@[doc: "Find first occurrence of needle in haystack; returns byte index or -1"]: [fn@Integer [let needle@String haystack@String]
  [str-index-of needle haystack]]

# Split a string by a separator into a dict of substrings (integer-keyed list).
# Delegates to the Rust builtin via the builtin-split alias (from [include %rust "core"]).
# NOTE: This wrapper is essential for the tmpl macro transformer (defined in this file)
# which calls split to parse template strings — split must be in the prelude's public exports.
# split: String -> String -> Dict String
# assert: [split " " "a b c"] => [0: "a"  1: "b"  2: "c"]
# assert: [split "," "one,two,three"] => [0: "one"  1: "two"  2: "three"]
# assert: [split " " ""] => []
split: [fn@[bind: [a]  return: [Seq String]  doc: """
Split string by separator. Returns a lazy Seq of segments.

Example: [collect [split "," "a,b,c"]] => ["a" "b" "c"]
Example: [collect [split "" "hi"]] => ["h" "i"]
"""] [let sep@String s@String]
  [sep-len: [str-length sep]
   s-len:   [str-length s]
   split-from: [fn [let pos]
     [sub:       [str-slice s pos s-len]]
     [found-rel: [builtin-str-index-of sep sub]]
     [if [= found-rel -1]
       [Seq.Cons head: sub  tail: Seq.End]
       [call [fn [let]
         [found: [+ pos found-rel]]
         [Seq.Cons head: [str-slice s pos found]
                   tail: [split-from [+ found sep-len]]]]]]]]
  [if [= sep ""]
    [each [str-chars s]]
    [split-from 0]]]

# Re-export builtins needed by the macro transformers (tmpl, do, >>, etc.)
# defined at the end of this file. These are available from builtin_module("core")
# and must be exported here so the macro transformer bodies can reference them.
str-slice: builtin-str-slice
str-length: builtin-str-length
to-int: builtin-to-int
int->string: builtin-int->string
float->string: builtin-float->string

# ============================================================================
# Prelude Re-exports for User-Visible Builtins (prelude-missing-wrappers)
# ============================================================================
#
# These wrappers re-export Rust-native builtins that user code calls directly.
# Each entry delegates to a stable builtin-* alias so the primary name is
# overridable while the builtin-* alias is always a stable escape hatch.
#
# Required so that user code does not depend on the raw builtin registry being
# in scope — the prelude is the stable public API, not the builtin registry.

# Dict primitives
keys@[doc: "Return the keys of a dict as an integer-keyed dict"]: builtin-keys
merge@[bind: [a b]  return: [or [all a [without b]] b]  doc: """
Merge two dicts right-biased. Fields from b override fields from a.
Return type is (a ∧ ¬b) ∨ b — fields unique to a plus all of b.

Example: [merge [x: 1  y: 2] [y: 3  z: 4]] => [x: 1  y: 3  z: 4]
"""]: [fn@[bind: [a b]  return: [or [all a [without b]] b]] [let a@a b@b]
  [dict-merge a b]]

# Dict iteration — tinct wrappers over single-step Rust primitives
each@[return: [Seq a]  doc: "Iterate over dict values as a lazy Seq"]: [fn@[bind: [a]  return: [Seq a]] [let d@Dict]
  [step: [fn [let i]
    [if [builtin-dict-has-nth? d i]
      [Seq.Cons head: [builtin-dict-nth d i]  tail: [step [+ i 1]]]
      Seq.End]]]
  [step 0]]
each-key@[return: [Seq Any]  doc: "Iterate over dict keys as a lazy Seq"]: [fn@[Seq Any] [let d@Dict]
  [step: [fn [let i]
    [if [builtin-dict-has-key-nth? d i]
      [Seq.Cons head: [builtin-dict-key-nth d i]  tail: [step [+ i 1]]]
      Seq.End]]]
  [step 0]]
each-kv@[return: [Seq Dict]  doc: "Iterate over dict entries as a lazy Seq of [key: k  value: v] dicts"]: [fn@[Seq Dict] [let d@Dict]
  [step: [fn [let i]
    [if [builtin-dict-has-kv-nth? d i]
      [Seq.Cons head: [builtin-dict-kv-nth d i]  tail: [step [+ i 1]]]
      Seq.End]]]
  [step 0]]
# each-kv is now defined above (no longer near Iterable typeclass instances)
build-dict@[return: Dict  doc: "Build a dict from a Seq or Dict of [key: k  value: v] pair dicts"]:
  [fn@Dict [let xs] [reduce [fn [let d kv] [set kv.key kv.value d]] [] xs]]

# Numeric primitives
floor@[doc: "Round Float down to nearest Int"]: builtin-floor
round@[doc: "Round Float to nearest Int"]: builtin-round

# Parsing
to-float@[doc: "Parse String to Float"]: builtin-to-float

# Evaluation control
try@[doc: "Catch errors from a zero-arg function; returns Result.Ok on success or Result.Error on failure"]:
    [fn@[bind: [a]  return: [Result a]] [let f@[Fn@a []]]
        [raw-to-result [builtin-try [f]]]]
apply@[doc: "Apply function to a dict of arguments"]: builtin-apply
partial@[doc: "Pre-fill leading arguments of f. Returns a function that accepts the remaining arguments and calls [f bound... extra...]."]:
    [fn [let f ...bound]
      [n: [length bound]]
      [fn [let ...extra]
        [apply f
          [reduce
            [fn [let acc i] [set [+ i n] [get i extra] acc]]
            bound
            [keys extra]]]]]
materialize@[doc: "Force evaluation to weak-head normal form (WHNF). Use with care — lazy evaluation is preferred."]: builtin-materialize
until@[doc: "Iterative loop primitive: call thunk repeatedly until it returns a non-thunk. Use for fixed-point convergence."]: builtin-until

# Schema validation
validate@[doc: "Validate a value against a schema dict; returns value on success, raises on failure."]: builtin-validate

# Bytes primitives
bytes@[doc: "Construct or concatenate Bytes values. Variadic: [bytes b1 b2 ...] concatenates multiple Bytes."]: builtin-bytes
bytes-find@[doc: "Find needle Bytes in haystack Bytes; returns byte index or -1."]: builtin-bytes-find
bytes-of@[doc: "Convert a Seq or Dict of byte Ints to a Bytes value."]: builtin-bytes-of
bytes-equal?@[doc: "Constant-time equality check for two Bytes values."]: builtin-bytes-equal?
ct-equal?@[doc: "Constant-time equality for two Bytes values (alias for bytes-equal? — cryptographic use)."]: builtin-ct-equal?
bytes-to-int@[doc: "Reinterpret 8 Bytes as a little-endian signed 64-bit integer. Used by float-bits."]: builtin-bytes-to-int

# Dict lookup with optional return (Absent on miss).
# Uses try-or to catch get errors and return Absent.Absent instead.
get?@[return: [or a Absent]  doc: "Get a value by key; returns Absent.Absent if missing (unlike get which errors)."]:
  [fn [let k c] [try-or Absent.Absent [fn [] [get k c]]]]

# Type introspection
type-of@[doc: "Return the type name of a value as a String"]: builtin-type-of
ast-of@[doc: "Return the AST representation of an unevaluated expression as an Expression value"]: builtin-ast-of

annotation-of@[doc: "Get the annotation dict from a function (FnAnnotation.extra + doc) or annotated value"]: builtin-annotation-of

make-annotated@[doc: "Wrap a value in Value::Annotated with the given annotation dict. Used to attach runtime annotations to unit constructor variants (T-1121)."]: builtin-make-annotated

source-of@[doc: "Get the body AST dict from ast-of result. NOTE: only works for unevaluated thunks (macro/quote context), not for fully-evaluated Value::Function — use ast-of directly for functions."]:
  [fn [let val] [get "body" [ast-of val]]]

annotation-value-str@[doc: "Stringify an annotation entry value"]:
  [fn@String [let v]
    [if [str? v] v [llt-repr v]]]

annotation-to-str@[doc: "Stringify a full annotation dict to a display string. Null-safe."]:
  [fn@String [let ann]
    [if [null? ann]
      ""
      [match ann.kind
        "simple": ann.value
        "dict":
          [call [fn [let positional]
            [if [not [empty? positional]]
              [join "" ["[" [join " " [map [fn [let e] [annotation-value-str e.value]] positional]] "]"]]
              [ret: [find-first-or [fn [let e] [= "return" e.key]] [] ann.entries]
                [if [= ret []] "" [annotation-value-str ret.value]]]]]
            [filter [fn [let e] [null? e.key]] ann.entries]]
        ...: ""]]]

sig-from-ast@[doc: "Build a signature string from an ast-of result"]:
  [fn@String [let ast@Dict]
    [ret:    [annotation-to-str [get-or "return-ann" [] ast]]]
    [params: [join "  " [map [fn [let p]
                [if [has? "annotation" p]
                  [join "" [p.name "@" [annotation-to-str p.annotation]]]
                  p.name]]
              ast.params]]]
    [if [= ret ""]
      [join "" ["fn [" params "]"]]
      [join "" ["fn@" ret " [" params "]"]]]]

describe@[doc: "Get introspection dict for a value. For functions: {doc, return-ann, params, sig}. For others: {type}."]:
  [fn [let val]
    [describe-fn: [fn [let val]
      [ast: [@Dict [ast-of val]]]
      [ann: [get-or "return-ann" [] ast]]
      [doc: [if [= ann []] ""
              [if [builtin-eq-string [builtin-dict-get "kind" [@Dict ann]] "dict"]
                [doc-entry: [try-or-impl [raw-to-result [builtin-try [head [filter [fn [let e] [builtin-eq-string [builtin-dict-get "key" e] "doc"]] [builtin-dict-get "entries" [@Dict ann]]]]]] []]
                  [if [= doc-entry []] "" [builtin-dict-get "value" doc-entry]]]
                ""]]]
      [doc:        doc
       return-ann: ann
       params:     [get "params" ast]
       sig:        [sig-from-ast ast]]]]
    [if [fn? val]
      [describe-fn val]
      [type: [type-of val]]]]

# Capability operations
narrow@[doc: "Narrow a capability to a subset of operations"]: builtin-narrow
revocable@[doc: "Wrap a DirCap in a revocable wrapper"]: builtin-revocable
revoke-cap@[doc: "Revoke a RevocableDirCap"]: builtin-revoke-cap

# I/O / parsing
# JSON serialization: use [include %libdir "codecs/json.llt"] for to-json and from-json.
# Tinct SCN serialization: to-tinct converts any materialized value to its canonical tinct source text.
to-tinct@[doc: "Serialize a value to its Self-Contained Normal Form (SCN) tinct source representation"]: builtin-to-tinct

# String trimming
trim@[doc: "Remove leading and trailing whitespace from a string"]: builtin-trim

# ============================================================================
# I/O Primitives (B-168: builtin-privacy I/O renaming)
# ============================================================================
#
# All I/O builtins are now registered under builtin-* names and re-exported
# here so user code can access them with bare names.

# Core I/O operations
# NOTE: emit is now injected by loader.llt's eval-program (not exported from prelude)
# to ensure it closes over the actual emit channel created in eval-programs.
env@[doc: "Read an environment variable by name. Returns Absent.Absent if not set or not allowed."]:
  [fn@[or String Absent] [let name@String]
    [if [builtin-env-has? name]
      [builtin-env name]
      Absent.Absent]]
list-dir@[doc: "List directory entries under a DirCap. Returns a Seq of {name: String, type: String} dicts."]: builtin-list-dir

# open: Open a file via DirCap, returning a Value::File handle directly.
# Flags are from the File namespace: File.Readable, File.Writable, File.Appendable,
# File.Exclusive, File.Binary.
open@[doc: """
Open a file under a DirCap with explicit capability flags.
Flags: File.Readable, File.Writable, File.Appendable, File.Exclusive, File.Binary.
Examples:
  [open %cwd \"file.txt\" File.Readable]
  [open %cwd \"log.txt\" File.Writable File.Appendable]
  [open %cwd \"lock\" File.Writable File.Exclusive]
  [open %cwd \"data.bin\" File.Binary File.Readable]
"""]: [fn@File [let cap@DirCap path@String ...flags@[or File.Readable File.Writable File.Appendable File.Exclusive File.Binary]]
  [flag->modes: [fn [let acc f]
     [match f
       File.Readable.Readable:     [builtin-concat acc ["read"]]
       File.Writable.Writable:     [builtin-concat acc ["write" "create" "truncate"]]
       File.Appendable.Appendable: [builtin-concat acc ["append" "create"]]
       File.Exclusive.Exclusive:   [builtin-concat acc ["create-new"]]
       File.Binary.Binary:         acc
       ...:                        acc]]
   opts: [reduce flag->modes [] [values flags]]]
  [if [null? opts]
    [raise "open: must specify at least File.Readable or File.Writable"]
    [builtin-file-open cap path opts -1 -1]]]

read-all@[doc: "Read all content from a file handle. Returns [content: String  handle: h]."]:
  [fn@[content: String  handle: Any] [let h]
    [read-all-loop: [fn [let handle acc]
      [result: [read-chunk 65536 handle]]
      [if [builtin-eq-int [length result.bytes] 0]
        [content: [bytes-str acc]  handle: handle]
        [read-all-loop result.handle [builtin-bytes-concat acc result.bytes]]]]]
    [read-all-loop h [builtin-bytes]]]

# Filesystem operations
write-file@[doc: "Write a string to a file under a DirCap"]: builtin-write
write-file-atomic@[doc: "Atomically write a string to a file (via temp file + rename)"]: builtin-write-atomic
# write, flush, close are Writable typeclass methods — injected by the class declaration.
# read-chunk, close are Readable typeclass methods — injected by the class declaration.
# Instances for File, StringWriter.Writer, Stdout, Stderr defined alongside their types.
# write-handle removed — replaced by typeclass-dispatched write (content first, handle last).
seek@[doc: "Seek to a position in a seekable file handle."]:
  [fn [let pos h]
    [if [= [builtin-type-of h] "File"]
      [if [builtin-file-seek h pos] h h]
      [h.seek pos h]]]
stat@[doc: "Get file metadata under a DirCap"]: builtin-stat
exists@[doc: "Check if a path exists under a DirCap"]: builtin-exists
stat-symlink@[doc: "Get symlink metadata (does not follow the link)"]: builtin-stat-symlink
copy-file@[doc: "Copy a file from source to destination under DirCaps"]: builtin-copy-file
symlink@[doc: "Create a symbolic link"]: builtin-symlink
set-permissions@[doc: "Set file permissions (Unix mode)"]: builtin-set-permissions
make-dir@[doc: "Create a directory under a DirCap"]: builtin-make-dir
rename@[doc: "Rename a file or directory"]: builtin-rename
link@[doc: "Create a hard link"]: builtin-link
read-link@[doc: "Read the target of a symbolic link"]: builtin-read-link

# Extended attributes (xattrs)
get-xattr@[doc: "Get an extended attribute value"]: builtin-get-xattr
set-xattr@[doc: "Set an extended attribute"]: builtin-set-xattr
remove-xattr@[doc: "Remove an extended attribute"]: builtin-remove-xattr
list-xattrs@[doc: "List all extended attribute names"]: builtin-list-xattrs

# Low-level file operations
# raw-create, seek, seek-end, position removed — operated on Value::Handle which no longer exists.
# Use seek (pos h) for file handles — defined above alongside write, flush, close.


# Handle utilities
# string-handle removed — created Value::Handle which no longer exists.
# read-chunk is a Readable typeclass method — injected by the class declaration.

# Meta primitives: parse/desugar/resolve/eval for AST introspection and meta-programming.
parse@[doc: "Parse source bytes into a Program. Args: bytes source-name. Returns {program, diagnostics}."]: builtin-parse
desugar@[doc: "Desugar a parsed Program, expanding syntactic sugar. Args: program. Returns desugared Program."]: builtin-desugar
program-docs@[doc: "Extract all documents from a desugared Program as a Dict of Document values."]: builtin-program-docs
resolve@[doc: "Resolve a Document against a name-set, returning {doc, diagnostics}. name-set: flat Dict<String,1> of all visible names. diagnostics: errors only (undefined variables). Args: doc name-set."]: builtin-resolve
lower@[doc: "Lower a resolved+typechecked Document to a CoreDocument. Must be called after typecheck-doc and before eval."]: builtin-lower
program@[doc: "Construct a Program value from a sequence of Document values. Used for program transformation."]: builtin-program
eval@[doc: "Evaluate a lowered CoreDocument with an env dict. Args: lowered env. Returns the exports Dict directly (raises on error)."]: builtin-eval
eval-types@[doc: "Evaluate expressions in the type-stage environment"]: builtin-eval-types
blake3@[doc: "Compute the BLAKE3 cryptographic hash of a string, returning a hex-encoded digest."]: builtin-blake3
cap-identity@[doc: "Return a stable string identity for a DirCap (used for content-addressed caching keys)."]: builtin-cap-identity
# cap-data removed: operated on Value::Handle/WriteHandle which no longer exist.
# env-to-name-set: Convert a flat env dict to a Dict<String,1> for builtin-resolve.
# Replaces the old scope-to-frames helper — env is already a flat dict of name→thunk.
env-to-name-set@[doc: "Convert an accumulated env dict to a flat Dict<String,1> for builtin-resolve. All visible names map to 1 (values ignored by resolver)."]: env-to-name-set

# module: resolve a module name to its export dict (used to build eval scope from doc.uses).
module@[doc: "Resolve a builtin module name to its export dict."]: builtin-module

# update-named: Accumulate named sections from --- %name document headers.
# Takes (state, val, meta) where meta is the result of [builtin-doc-meta doc env].
# Returns the updated named dict (or unchanged state.named if no name in meta).
# Mirrors the definition in stdlib/loader.llt.
update-named: [fn@Dict [let state val meta]
  [name: [get-or "" "name" meta]]
  [if [= name ""]
    state.named
    [dict-merge state.named [make-entry [str "%" name] val]]]]

# uses-scope: compute the runtime bindings contributed by a --- uses: [...] declaration.
# Takes a list of module names and returns a merged dict of builtin implementations.
# Mirrors the definition in stdlib/loader.llt (runtime-only — no typecheck here).
uses-scope: [fn@Dict [let module-names]
    [reduce dict-merge [] [map builtin-module module-names]]]

# eval-program: Evaluate all documents in a desugared Program, threading % via env-dict.
# Uses the env-dict protocol: builtin-resolve takes name-set, builtin-eval takes
# (lowered, env) and returns the exports Dict directly.
# Cannot be a simple re-export alias — in a letrec dict, `eval-program: eval-program`
# is self-referential (circular thunk [E070]). Full implementation required.
eval-program@[doc: """
Evaluate all documents in a Program, threading % via env-dict accumulation.

prog:          Program value (already desugared via desugar)
initial-input: initial % value for the first document
env:           Dict — the accumulated env dict (e.g. from prelude loading)
tc:            TypeContext — accumulated type state (from builtin-make-type-ctx)

Returns the final document's result.
Named document sections (--- name: "foo") accumulate as %foo bindings in env.
"""]: [fn [let prog initial-input env tc]
  [docs: [program-docs prog]]
  [state: [reduce
    [fn [let st doc]
      [meta:     [builtin-doc-meta doc st.env]]
      [uses:     [uses-scope [get-or [] "uses" meta]]]
      [doc-env:  [dict-merge st.env [dict-merge uses [%: st.percent]]]]
      [name-set: [env-to-name-set doc-env]]
      [res:      [builtin-resolve doc name-set]]
      [tc-result: [builtin-typecheck-doc res.doc tc doc-env]]
      [typed:     tc-result.doc]
      [lowered:   [builtin-lower typed]]
      [exports:   [builtin-eval lowered doc-env]]
      [doc-name:  [get-or "" "name" meta]]
      [next-env:  [dict-merge doc-env
                    [if [= "" doc-name]
                      [%: exports]
                      [dict-merge [make-entry [str "%" doc-name] exports] [%: exports]]]]]
      [env: next-env  percent: exports]]
    [env: env  percent: initial-input]
    docs]]
  state.percent]

# eval-programs: Evaluate a sequence of Programs in pipeline order, threading %.
# Full implementation mirroring stdlib/loader.llt multi-program pattern.
# Cannot be a simple re-export alias — in a letrec dict, `eval-programs: eval-programs`
# is self-referential (circular thunk [E070]). Full implementation required.
eval-programs@[doc: """
Evaluate a sequence of Programs in pipeline order, threading %.

programs:      Seq of Program values (already desugared)
initial-input: initial % value for the first Program
env:           Dict — the accumulated env dict (e.g. from prelude loading)
tc:            TypeContext — accumulated type state

Returns the final Program's result.
"""]: [fn [let programs initial-input env tc]
  [reduce
    [fn [let percent prog]
      [eval-program prog percent env tc]]
    initial-input
    programs]]

# ============================================================================
# Builder Primitives (B-168: builtin-privacy I/O renaming)
# ============================================================================
#
# Transient mutable builders for efficient dict construction. All registered
# as builtin-* and re-exported here.

make-builder@[doc: "Create a new empty transient builder"]: builtin-make-builder
builder-set@[doc: "Set a key in a builder (mutating)"]: builtin-builder-set
builder-delete@[doc: "Delete a key from a builder (mutating)"]: builtin-builder-delete
builder-finish@[doc: "Finish a builder, returning an immutable dict"]: builtin-builder-finish
builder-snapshot@[doc: "Create a snapshot dict from a builder without finishing it"]: builtin-builder-snapshot
builder-has?@[doc: "Check if a key exists in a builder"]: builtin-builder-has?
builder-get@[doc: "Get a value from a builder (errors if missing)"]: builtin-builder-get
builder-get-or@[doc: "Get a value from a builder with a default"]: builtin-builder-get-or

# ============================================================================
# String Primitives (builtin-privacy-operators-and-io sprint)
# ============================================================================
#
# These were previously registered as bare names in standard_builtins().
# Now registered as builtin-* and re-exported here so user code continues
# to work without changes. stdlib/strings.llt and stdlib/encoding.llt use
# these wrappers (or builtin-* directly) instead of the bare builtin names.

# Character encoding/decoding
char-code@[doc: "Return the Unicode codepoint of the first character of a string as an Int"]: builtin-char-code
chr@[doc: "Return a single-character string for the given Unicode codepoint Int"]: builtin-chr

# String inspection (sequence of characters, byte sequence)
str-chars@[doc: "Return a lazy Seq of single-character strings from a string"]: [fn@[Seq String] [let s@String]
  [step: [fn [let i]
    [if [builtin-str-has-nth? s i]
      [Seq.Cons head: [builtin-str-nth-char s i]  tail: [step [+ i 1]]]
      Seq.End]]]
  [step 0]]
str-bytes@[doc: "Return a lazy Seq of UTF-8 byte values (Ints 0–255) from a string"]: [fn@[Seq Integer] [let s@String]
  [step: [fn [let i]
    [if [builtin-str-has-nth-byte? s i]
      [Seq.Cons head: [builtin-str-nth-byte s i]  tail: [step [+ i 1]]]
      Seq.End]]]
  [step 0]]
str-bytes-raw@[doc: "Return the raw Bytes value for a string (UTF-8 encoded)"]: builtin-str-bytes
bytes-str@[doc: "Return a String decoded from a Bytes value (UTF-8)"]: builtin-bytes-str

# String search
str-index-of@[doc: "Return the byte index of the first occurrence of needle in haystack, or -1 if not found. Args: needle haystack (subject-last)."]: builtin-str-index-of

# String trimming (per-side)
trim-start@[doc: "Remove leading whitespace from a string"]: builtin-trim-start
trim-end@[doc: "Remove trailing whitespace from a string"]: builtin-trim-end

# Character-level case conversion (single-character strings)
str-to-upper-char@[doc: "Convert a single-character string to uppercase"]: builtin-str-to-upper-char
str-to-lower-char@[doc: "Convert a single-character string to lowercase"]: builtin-str-to-lower-char

# Character-level string mapping
str-map-chars@[doc: "Apply a function to each character of a string, returning a new string"]: builtin-str-map-chars

# Regular expression matching
regex-match?@[doc: "Return True if the string matches the regular expression pattern"]: builtin-regex-match?

# String concatenation (two-arg primitive)
string-concat@[doc: "Concatenate two strings"]: builtin-string-concat

# String replacement (all occurrences)
replace@[doc: "Replace all occurrences of pattern with replacement in input"]: builtin-replace

# ============================================================================
# Bitwise Primitives (builtin-privacy-operators-and-io sprint)
# ============================================================================
#
# Integer bitwise operations. Previously registered as bare names; now
# registered as builtin-* and re-exported here.

band@[doc: "Bitwise AND of two Ints"]: builtin-band
bor@[doc: "Bitwise OR of two Ints"]: builtin-bor
bxor@[doc: "Bitwise XOR of two Ints"]: builtin-bxor
bnot@[doc: "Bitwise NOT of an Int (two's complement: ~n = -(n+1))"]: [fn@Integer [let n@Integer] [- -1 n]]
shl@[doc: "Left shift: value shl bits"]: builtin-shl
shr@[doc: "Logical right shift (zero-fill): value shr bits"]: builtin-shr

# N-ary bitwise operators — eliminate nested [bor a [bor b [bor c d]]] patterns.
# These use a typed variadic (...args@Integer) with no untyped fallback.
# Non-Integer arguments produce a runtime exhaustiveness error (no bucket accepts them).
bor-all@[doc: "Bitwise OR of any number of Ints (identity: 0)"]:  [fn@Integer [let ...args@Integer] [reduce bor  0  args]]
band-all@[doc: "Bitwise AND of any number of Ints (identity: -1)"]: [fn@Integer [let ...args@Integer] [reduce band -1 args]]
bxor-all@[doc: "Bitwise XOR of any number of Ints (identity: 0)"]: [fn@Integer [let ...args@Integer] [reduce bxor 0  args]]

# read-int: arbitrary-width integer decode with explicit byte order.
# For fixed-width reads, prefer uint16/uint32/uint64 (builtin, faster).
# Byte order: "big" for big-endian, "little" for little-endian.
read-int@[doc: "Decode integer from b[offset..offset+len] with explicit byte order."]:
  [fn@Integer [let order@String b@Bytes offset@Integer len@Integer]
    [if [= order "big"]
      [reduce [fn [let acc i] [bor [shl acc 8] [get [+ offset i] b]]] 0 [range 0 len]]
      [reduce [fn [let acc i] [bor acc [shl [get [+ offset i] b] [* i 8]]]] 0 [range 0 len]]]]

# sub: offset+length slice. Subject last so it works with pipelines.
sub@[doc: "s[offset..offset+len] — subsequence of len elements starting at offset. Subject last."]:
  [fn@Dict [let offset@Integer len@Integer s] [build-dict [take len [drop offset [each-kv s]]]]]

# ============================================================================
# Type Conversion (builtin-privacy-operators-and-io sprint)
# ============================================================================

float@[doc: "Explicit Int to Float conversion (or Float pass-through). Allows precision loss."]: builtin-float

# ============================================================================
# Numeric Range Predicates
# ============================================================================

between: [fn@[bind: [a]  return: Fn  doc: """
Predicate factory for range check (inclusive).

Example: [[between 0 255] 42] => True
Example: [[between 0 255] -1] => False
Example: [[between 0 255] 256] => False

Note: Returns a predicate that checks lo <= v <= hi.
"""] [let lo@a hi@a] [fn@[bind: [a]  return: Boolean] [let v@a] [and [>= v lo] [<= v hi]]]]

# non-negative: predicate — checks v >= 0.
# non-negative: Int -> Bool
# assert: [non-negative 0] => True
# assert: [non-negative 42] => True
# assert: [non-negative -1] => False
non-negative@[doc: "Check if value is non-negative"]: [fn@Boolean [let v] [>= v 0]]

# positive: predicate — checks v > 0.
# positive: Int -> Bool
# assert: [positive 1] => True
# assert: [positive 0] => False
# assert: [positive -1] => False
positive@[doc: "Check if value is positive"]: [fn@Boolean [let v] [> v 0]]

# ============================================================================
# Sequence / List Wrappers (shadowable wrappers for builtin-NAME functions)
# ============================================================================
#
# Each wrapper delegates to the stable builtin-* alias, making the primary
# name overridable by user code via include while internal prelude code
# continues to work correctly through the builtin-* escape hatch.

cons@[return: [Seq a]  doc: """
Prepend an element to a Seq. O(1).

Example: [cons 1 Seq.End] => Seq(1)
Example: [cons 1 [cons 2 Seq.End]] => Seq(1, 2)

Note: Constructs a Seq.Cons cell — purely tinct, no Rust dispatch.
"""]: [fn@[bind: [a]  return: [Seq a]] [let x@a rest@[Seq a]] [Seq.Cons head: x  tail: rest]]

head@[return: v  doc: """
First element of a Seq or Dict. Raises on empty.

Example: [head [cons 1 [cons 2 Seq.End]]] => 1
Example: [head [10 20 30]] => 10

Note: For Seq, errors on Seq.End and forces evaluation of the head element only.
For Dict, returns the value at key 0 and errors if empty.
"""]: [fn@[bind: [v]  return: v  constraint: [$Indexed c v]] [let s]
    [if [seq? s]
      [match s
        [case [let p] [Seq.Cons p] p.head]
        Seq.End:      [raise "head: empty sequence"]]
      [if [builtin-eq-int [builtin-dict-length s] 0]
        [raise "head: empty dict"]
        [builtin-dict-get 0 s]]]]

tail@[return: Any  doc: """
All elements after the first. Raises on empty.

Example: [head [tail [cons 1 [cons 2 [cons 3 Seq.End]]]]] => 2
Example: [tail [10 20 30]] => [0: 20  1: 30]

Note: For Seq, errors on Seq.End and returns a Seq (lazy; does not force tail elements).
For Dict, errors if empty and returns a new Dict with keys reindexed starting from 0.
"""]: [fn@[return: Any] [let s]
    [if [seq? s]
      [match s
        [case [let p] [Seq.Cons p] p.tail]
        Seq.End:      [raise "tail: empty sequence"]]
      [if [builtin-eq-int [builtin-dict-length s] 0]
        [raise "tail: empty dict"]
        [builtin-drop 1 s]]]]

# collect-dict: internal helper — materializes a lazy Seq into an integer-keyed Dict.
# Used by prelude functions that must return a Dict (sort, bytes-concat, entries, values, etc.)
# The public `collect` now returns [List a] (finger tree); use collect-dict when a Dict is required.
collect-dict@[doc: "Internal: materialize a Seq into an integer-keyed Dict. Prefer collect for user code."]:
  [fn@[bind: [a]  return: Dict] [let xs@[Seq a]] [reduce [fn [let acc x] [dict-append x acc]] [] xs]]

collect@[return: [List a]  doc: """
Materialize a lazy Seq into a List (2-3 finger tree). O(n).

After collect, length is O(1) and index access is O(log n) via ft-index.

Note: Forces evaluation of the entire Seq. Use with caution on infinite sequences.
Breaking change from prior API: collect now returns [List a], not an
integer-keyed Dict. Existing code using [get i [collect s]] continues to work
via the Indexable instance. Code pattern-matching on the raw Dict structure
must use collect-dict instead.
"""]:
  [fn@[bind: [a]  return: [List a]] [let xs@[Seq a]]
    [reduce [fn [let tree x] [push-right x tree]] FingerTree.FTEmpty xs]]

range@[return: [Seq Integer]  doc: """
Lazy half-open integer range [start, end). Pure tinct — no Rust dispatch.

Example: [collect [range 0 3]] => [0 1 2]
Example: [collect [take 3 [range 5 1000]]] => [5 6 7]

Note: Returns Seq.End immediately when start >= end. Tail is a thunk — infinite generation
is safe. Purely tinct (T-1321, S-896): constructs Seq.Cons variants directly.
"""]: [fn@[Seq Integer] [let start@Integer end@Integer]
    [if [>= start end]
      Seq.End
      [Seq.Cons head: start  tail: [range [+ start 1] end]]]]

repeat: [fn@[bind: [a]  return: [Seq a]  doc: """
Infinite lazy Seq repeating a value. Pure tinct — no Rust dispatch (T-1380).

Example: [collect [take 3 [repeat "x"]]] => ["x" "x" "x"]

Note: Produces an infinite sequence. Must be consumed with take, drop, or other limiting operations.
Purely tinct: tail is a thunk — each consumer force creates one Seq.Cons cell without
evaluating the entire sequence. Stack depth O(1) per element via laziness.
"""] [let x@a] [Seq.Cons head: x  tail: [repeat x]]]

cycle: [fn@[bind: [a]  return: [Seq a]  doc: """
Cycle a Dict's values infinitely. Pure tinct — no Rust dispatch (T-1380).

Example: [collect [take 5 [cycle ["a" "b"]]]] => ["a" "b" "a" "b" "a"]

Note: Repeats the collection elements in order infinitely. Must be consumed with take,
drop, or other limiting operations.
Accepts a Dict (integer-keyed or string-keyed). Raises on empty collection.
"""] [let xs]
  [ks: [keys xs]
   len: [length xs]
   step: [fn [let i]
     [Seq.Cons
       head: [builtin-dict-get [builtin-dict-get i ks] xs]
       tail: [step [mod [+ i 1] len]]]]]
  [if [empty? xs]
    [raise "cycle: empty collection"]
    [step 0]]]

iterate: [fn@[bind: [a]  return: [Seq a]  doc: """
Infinite lazy Seq by repeatedly applying f to seed. Pure tinct — no Rust dispatch (T-1380).

Example: [collect [take 4 [iterate [fn [let n] [+ n 1]] 0]]] => [0 1 2 3]

Note: Produces the sequence [x, f(x), f(f(x)), ...]. Infinite; must be consumed with
take, drop, or other limiting operations.
Purely tinct: tail is a thunk — [iterate f [f x]] is suspended until the consumer forces
the next element. Stack depth O(1) per element consumed.
"""] [let f@[Fn@a [a]] x@a] [Seq.Cons head: x  tail: [iterate f [f x]]]]

unfold: [fn@[bind: [a s]  return: [Seq a]  doc: """
Unfold a Seq from seed using f. Pure tinct — no Rust dispatch (T-1380).

Example: [collect [unfold [fn [let n] [if [< n 5] [0: n  1: [+ n 1]] []]] 0]] => [0 1 2 3 4]

Note: f receives state, returns [0: value  1: next-state] to continue, or [] to stop.
Lazy; generates elements on demand.
Purely tinct (T-1380): dispatches on empty? of step result rather than Rust variant introspection.
"""] [let f@[Fn@Dict [s]] seed@s]
  [step: [fn [let s]
    [result: [f s]]
    [if [empty? result]
      Seq.End
      [Seq.Cons head: result.0  tail: [step result.1]]]]]
  [step seed]]

# concat-seq: Concatenate two Seqs lazily (O(1) initial). Pure tinct (T-1380).
# Used by concat when both inputs are Seq.
concat-seq: [fn@[bind: [a]  return: [Seq a]] [let a@[Seq a] b@[Seq a]]
  [match a
    [case [let p] [Seq.Cons p] [Seq.Cons head: p.head  tail: [concat-seq p.tail b]]]
    Seq.End:      b]]

join: [fn@[bind: [a]  return: String  doc: """
Join collection elements as strings with a separator.

Example: [join ", " ["a" "b" "c"]] => "a, b, c"

Note: Converts each element to a string via Castable dispatch, then concatenates
with separator between elements. Works on any Iterable collection (Dict, Seq, List, Map)
via the Iterable typeclass.
"""] [let sep@String xs@[Iterable a constraint: [Castable String a]]]
  [join-seq: [fn [let s]
    [match s
      Seq.End:      ""
      [case [let p] [Seq.Cons p] [reduce
                      [fn [let acc x] [builtin-string-concat acc [builtin-string-concat sep [str x]]]]
                      [str p.head]
                      p.tail]]]]]
  [join-seq [each xs]]]

concat: [fn@[bind: [a]  return: [Seq a]  doc: """
Concatenate two or more collections.

Example: [concat [1 2] [3 4]] => [1 2 3 4]
Example: [concat [1 2] [3 4] [5 6]] => [1 2 3 4 5 6]

Note: Works on Dict (reindexed), Seq (lazy), String, or Bytes. Return type matches inputs.
Accepts 0 args (empty dict), 1 arg (identity), or 2+ args (left fold).
Seq path is pure tinct (T-1380): uses concat-seq for lazy Seq concatenation.
"""] [let ...args]
  [if [empty? args]
    []
    [reduce
      [fn [let acc x]
        [if [and [seq? acc] [seq? x]]
          [concat-seq acc x]
          [builtin-concat acc x]]]
      [head args]
      [tail args]]]]

first: [fn@[bind: [v]  return: v  constraint: [$Indexed c v]  doc: """
First element of a collection.

Example: [first [10 20 30]] => 10
Example: [first "hello"] => "h"
Example: [first (str-bytes "A")] => 65

Note: Works on Dict (by insertion order), String (first char), or Bytes (first byte as Int).
"""] [let xs]
  [match [builtin-type-of xs]
    "String": [builtin-str-slice xs 0 1]
    ...:        [dict-first xs]]]

last: [fn@[bind: [v]  return: v  constraint: [$Indexed c v]  doc: """
Last element of a collection.

Example: [last [10 20 30]] => 30
Example: [last "hello"] => "o"
Example: [last (str-bytes "Z")] => 90

Note: Works on Dict (by insertion order), String (last char), or Bytes (last byte as Int).
"""] [let xs]
  [match [builtin-type-of xs]
    "String": [builtin-str-slice xs [builtin-int-sub [builtin-str-length xs] 1] [builtin-str-length xs]]
    ...:        [dict-last xs]]]

rest: [fn@[return: Any  doc: """
All elements after first (reindexed from 0).

Example: [rest [10 20 30]] => [0: 20  1: 30]

Note: Returns a new Dict with keys reindexed starting from 0. Removes the first element.
"""] [let xs@Dict] [builtin-drop 1 xs]]

reverse: [fn@[return: Dict  doc: """
Reverse a collection (reindexed from 0).

Example: [reverse [1 2 3]] => [0: 3  1: 2  2: 1]

Note: Returns a new Dict with elements in reverse order, keys reindexed from 0.
"""] [let xs@Dict]
  [n:    [builtin-dict-length xs]
   fill: [fn [let i b]
     [match [builtin-int-gte i n]
       0: [fill [builtin-int-add i 1]
               [builtin-builder-set i [builtin-dict-nth xs [builtin-int-sub [builtin-int-sub n 1] i]] b]]
       ...: [builtin-builder-finish b]]]
  [fill 0 [builtin-make-builder]]]]

sort: [fn@[bind: [a]  return: Dict  constraint: [a: Comparable]  doc: """
Sort collection in natural ascending order.

Example: [sort [3 1 2]] => [0: 1  1: 2  2: 3]
Example: [sort ["c" "a" "b"]] => [0: "a"  1: "b"  2: "c"]

Note: Returns a new Dict with elements sorted, keys reindexed from 0. Uses natural ordering (<).
"""] [let xs@[Seq a]] [sort-asc xs]]

# ============================================================================
# Meta Primitives (shadowable wrappers for meta introspection)
# ============================================================================

gensym: [fn@[return: String  doc: """
Generate a unique symbol name with the standard ℊ scope and the default "gensym" prefix.

Examples:
  [gensym]  => "ℊꜱʏᴍ⧼gensym⧽0"
  [gensym]  => "ℊꜱʏᴍ⧼gensym⧽1"

Scope ℊ (U+210A) marks user-facing gensyms. The counter is global and shared with
all internal call sites. Each call produces a globally unique identifier.

For a custom prefix, use gensym-with-prefix instead.
"""] [let]
  [builtin-gensym "ℊ" "gensym"]]

gensym-with-prefix: [fn@[return: String  doc: """
Generate a unique symbol name with the standard ℊ scope and a custom prefix.

Args:
  prefix: String — Label embedded in the name

Examples:
  [gensym-with-prefix "foo"]      => "ℊꜱʏᴍ⧼foo⧽0"
  [gensym-with-prefix "do-infer"] => "ℊꜱʏᴍ⧼do-infer⧽1"

Scope ℊ (U+210A) marks user-facing gensyms. The counter is global and shared with
all internal call sites. Each call produces a globally unique identifier.
"""] [let prefix@String]
  [builtin-gensym "ℊ" prefix]]

gensym-with-scope: [fn@[return: String  doc: """
Generate a unique symbol name with an explicit scope character.

Args:
  scope:  String — Single Unicode character encoding provenance
  prefix: String — Label embedded in the name

Scope characters: ℊ user prelude, 𝜇 μ-binders, 𝒩 nominal validation, 𝒻 formatter.
Used by mu and other type-stage combinators that want distinct provenance markers.
"""] [let scope@String prefix@String]
  [builtin-gensym scope prefix]]

macro-injects: [fn@[return: [Seq String]  doc: """
Get the names deliberately injected into the caller's scope by a macro.

Takes a macro name (String). Returns a Seq of the injected binding names declared
via `inject:` in the macro's params annotation. Returns an empty Seq (Seq.End) if
the macro has no `inject:` declaration (i.e. it uses only gensym hygiene).

Example:
  [macro-injects "aif"]   => Seq("it")    (if aif has inject: it)
  [macro-injects "swap"]  => Seq.End      (if swap uses only gensym hygiene)
  [macro-injects "foo"]   => Seq("x" "y") (if foo has inject: [x y])

Note: Reflection primitive for anaphoric macros per doc/feature/macros.md §Hygiene.
Used by documentation tools and callers that need to be aware of introduced bindings.
"""] [let macro-name] [builtin-macro-injects macro-name]]

llt-repr: [fn@[return: String  doc: """
Convert value to LLT source representation.

Example: [llt-repr [1 2 3]] => "[0: 1  1: 2  2: 3]"

Note: Produces valid LLT syntax that could be parsed back into the original structure.
"""] [let value] [builtin-llt-repr value]]

tag-of: [fn@[return: String  doc: """
Get the variant tag name.

Example: [tag-of Color.Red] => "Color.Red"

Note: Returns the tag string for a variant value. Errors on non-variant values.
"""] [let value] [builtin-tag-of value]]

span-of: [fn@[return: Dict  doc: """
Extract source span from an Expression (AST node).

Returns a dict with structure:
  {file: String, start-line: Int, start-col: Int, end-line: Int, end-col: Int}

Example: [span-of [ast-of x]] => {file: "input.llt", start-line: 1, start-col: 5, end-line: 1, end-col: 10}

Note: Returns empty dict [] for non-Expression values. The file field is "" if unavailable.
This can be used when you need the span as a dict value, though macro-error can now
accept AST nodes directly without needing to extract the span first.
"""] [let value] [builtin-span-of value]]

decimal: [fn@[return: Decimal  doc: """
Convert to arbitrary-precision decimal.

Example: [decimal "0.1"] => 0.1 (exact)
Example: [decimal 123] => 123.0

Note: Provides exact decimal arithmetic, avoiding floating-point rounding errors.
"""] [let value] [builtin-decimal value]]

big-int: [fn@[return: BigInt  doc: """
Convert to arbitrary-precision integer.

Example: [big-int "12345678901234567890"] => 12345678901234567890
Example: [big-int 42] => 42

Note: Supports integers beyond the range of 64-bit Int.
"""] [let value] [builtin-big-int value]]

proxy: [fn@[return: Proxy  doc: """
Create a capability proxy.

Example: [proxy handler-fn]

Note: Wraps a function as a proxy. Field access calls the handler. Used for capability-based security patterns.
"""] [let handler] [builtin-proxy handler]]

# StringWriter: a purely functional string accumulation type.
# Each write creates a new StringWriter with the content appended.
# Access accumulated string via h.cells.
# Created via [StringWriter.Writer cells: ""] or make-string-writer.
StringWriter: [type Writer: [cells: String]]

make-string-writer@[doc: "Create an empty StringWriter for accumulating string output."]:
  [fn [] [StringWriter.Writer cells: ""]]

# Writable instance for StringWriter.Writer — purely functional accumulation.
[instance File.Writable
  [let h@StringWriter.Writer]: [write: [fn [let s h] [StringWriter.Writer cells: [builtin-string-concat h.cells s]]]
                                flush: [fn [let h] h]
                                close: [fn [let h] h]]]

wrap-in-let: [fn@[return: Unknown  doc: """
Wrap a list of expressions in a LetDecl AST node.

Constructs a LetDecl Variant with the given bindings dict.
Used by let-softening macros to convert flat parameter lists into
binding declarations.

Example:
  [wrap-in-let [0: x-node  1: y-node]]  => LetDecl(bindings: {0: x, 1: y})
"""] [let elems]
  [Expr.LetDecl bindings: elems]]

let-decl-elems: [fn@[return: Unknown  doc: """
Extract the bindings sequence from a LetDecl AST node.

Inverse of wrap-in-let. Returns the integer-indexed dict of binding
expressions from a LetDecl Variant.

Example:
  [let-decl-elems let-decl-node]  => {0: first-binding, 1: second-binding, ...}
"""] [let decl]
  [get "bindings" decl]]

first-or: [fn@[bind: [a]  return: a  doc: """
Return the first element of a sequence, or a default value if empty.

Safe alternative to first that doesn't error on empty sequences.

Example:
  [first-or [1 2 3] 99]  => 1
  [first-or [] 99]       => 99

Note: Works with both Dict and Seq. For Dict, returns first value by insertion order.
"""] [let xs default@a]
  [if [empty? xs]
      default
      [first xs]]]

macro-error: [fn@[return: Never  doc: """
Signal a compile-time macro expansion error with precise span information.

Terminates macro expansion with an error, reporting the message to the user.
If a node argument is provided, the error is reported at that node's source
location; otherwise, the error is reported at the macro-error call site.

Example:
  [macro-error "expected a literal value" bad-arg]
  [macro-error "invalid syntax"]
"""] [let message@String ...node]
  [if [empty? node]
    [builtin-macro-error message]
    [builtin-macro-error message [first node]]]]

# ============================================================================
# Self-Hosted Include
# ============================================================================
#
# include: load, resolve, and evaluate a tinct file from a DirCap.
# Uses the env-dict protocol. Errors propagate naturally.
#
# %prelude: an env dict injected by the loader containing all prelude exports.
# Included files start with % = [] (they do not inherit the caller's pipeline input).
include: [fn@[return: Any  doc: """
Load, resolve, and evaluate a tinct file from a DirCap.

cap:  DirCap — confines filesystem access
path: String — file path relative to cap

Included files start with % = [] (fresh pipeline input).
Requires %prelude (env Dict) to be in scope — injected by the loader.
"""] [let cap@DirCap path@String integrity-hash@[default: Absent.Absent]]
  [read-result: [read-all [open cap path "read"]]]
  [source: read-result.content]
  [_verify: [if [absent? integrity-hash] []
    [call [fn [let actual-hash]
      [if [= actual-hash integrity-hash] []
        [raise [join "" ["hash mismatch for " path ": expected " integrity-hash " got " actual-hash]]]]]
    [blake3 source]]]]
  [pr:        [parse [str-bytes-raw source] path]]
  [desugared: [desugar pr.program]]
  [docs:      [program-docs desugared]]
  [tc:        [builtin-make-type-ctx]]
  [eval-program desugared [] %prelude tc]]

# lines: Read all lines from a protocol dict handle. Returns a Seq of String.
# Reads the entire content via read-all, then splits on newlines.
# Note: not lazy — reads entire content at once. For large files, use chunks instead.
lines@[doc: "Read all lines from a protocol dict handle. Returns [lines: Seq[String]  handle: h]."]:
  [fn@[lines: Any  handle: Any] [let h]
    [result: [read-all h]]
    [lines: [filter [fn [let line] [not [= line ""]]] [split "\n" result.content]]
     handle: result.handle]]

# Lazily read fixed-size byte chunks from a Handle. Returns a Seq of Bytes.
# Returns empty Seq when EOF reached.
chunks@[doc: "Lazily read fixed-size byte chunks from a handle. Returns a Seq of Bytes."]:
  [fn@[Seq Bytes] [let h n@Integer]
    [result: [read-chunk n h]]
    [match [builtin-eq-int [builtin-bytes-length result.bytes] 0]
      0:   [Seq.Cons head: result.bytes  tail: [chunks result.handle n]]
      ...: Seq.End]]

# Concatenate a Seq or Dict of Bytes values into a single Bytes value.
# Uses the variadic `bytes` builtin (via builtin-bytes) after collecting the sequence eagerly.
# collect-dict is used here because builtin-apply requires an integer-keyed Dict.
# Example: [bytes-concat [collect [chunks handle 65536]]]
bytes-concat@[doc: "Concatenate a Seq or Dict of Bytes values into a single Bytes value"]:
  [fn [let chunks-seq]
    [if [seq? chunks-seq]
      [apply builtin-bytes [collect-dict chunks-seq]]
      [if [list? chunks-seq]
        [apply builtin-bytes [collect-dict [ft-to-seq chunks-seq]]]
        [apply builtin-bytes chunks-seq]]]]

# Datetime functions — loaded via builtin-module "datetime".
# Each calls [builtin-module "datetime"] inline to access the datetime module's functions.
timestamp-nanos:   [get "timestamp-nanos"   [builtin-module "datetime"]]
duration-nanos:    [get "duration-nanos"    [builtin-module "datetime"]]
duration-seconds:  [get "duration-seconds"  [builtin-module "datetime"]]
duration-minutes:  [get "duration-minutes"  [builtin-module "datetime"]]
duration-hours:    [get "duration-hours"    [builtin-module "datetime"]]
duration-days:     [get "duration-days"     [builtin-module "datetime"]]
timestamp->unix:   [get "timestamp->unix"   [builtin-module "datetime"]]
unix->timestamp:   [get "unix->timestamp"   [builtin-module "datetime"]]
timestamp-add:     [get "timestamp-add"     [builtin-module "datetime"]]
timestamp-diff:    [get "timestamp-diff"    [builtin-module "datetime"]]
timestamp<?:       [fn@Boolean [let a@Dict b@Dict] [apply [get "timestamp<?"  [builtin-module "datetime"]] [0: a  1: b]]]
timestamp>?:       [fn@Boolean [let a@Dict b@Dict] [apply [get "timestamp>?"  [builtin-module "datetime"]] [0: a  1: b]]]
timestamp=?:       [fn@Boolean [let a@Dict b@Dict] [apply [get "timestamp=?"  [builtin-module "datetime"]] [0: a  1: b]]]
timestamp-year:    [get "timestamp-year"    [builtin-module "datetime"]]
timestamp-month:   [get "timestamp-month"   [builtin-module "datetime"]]
timestamp-day:     [get "timestamp-day"     [builtin-module "datetime"]]
timestamp-hour:    [get "timestamp-hour"    [builtin-module "datetime"]]
timestamp-minute:  [get "timestamp-minute"  [builtin-module "datetime"]]
timestamp-second:  [get "timestamp-second"  [builtin-module "datetime"]]
timestamp-parts:   [get "timestamp-parts"   [builtin-module "datetime"]]
parse-timestamp:   [get "parse-timestamp"   [builtin-module "datetime"]]
format-timestamp:  [get "format-timestamp"  [builtin-module "datetime"]]
duration->nanos:   [get "duration->nanos"   [builtin-module "datetime"]]
duration->seconds: [get "duration->seconds" [builtin-module "datetime"]]
now:               [get "now"               [builtin-module "datetime"]]
fixed-clock:       [get "fixed-clock"       [builtin-module "datetime"]]
load-tz:           [get "load-tz"           [builtin-module "datetime"]]
timestamp-in-tz:   [get "timestamp-in-tz"   [builtin-module "datetime"]]
local->timestamp:  [get "local->timestamp"  [builtin-module "datetime"]]
local-tz-name:     [get "local-tz-name"     [builtin-module "datetime"]]

# ============================================================================
# Async concurrency primitives
#
# Async utilities (select, retry, finally, await-all, recv-all, par-map,
# par-filter, exit, graceful-exit) live in this prelude — stdlib/async.llt was
# deleted and its contents merged here in the builtin-privacy-stdlib sprint.
# Bare-name wrappers over builtin-* stable aliases are also re-exported here.
# ============================================================================

# Signal type: POSIX signal variants for signal-channel
# Used to specify which signal to listen for when creating a signal channel.
# Supported on Unix platforms only (macOS, Linux, BSD).
Signal: [type SIGTERM SIGINT SIGHUP SIGQUIT SIGUSR1 SIGUSR2]
# Short-name aliases for Signal constructors (like Ok/Error/Some/None/Tcp etc.)
SIGTERM: Signal.SIGTERM
SIGINT:  Signal.SIGINT
SIGHUP:  Signal.SIGHUP
SIGQUIT: Signal.SIGQUIT
SIGUSR1: Signal.SIGUSR1
SIGUSR2: Signal.SIGUSR2

# Action: zero-arg side-effecting function (Moggi/Haskell IO distinction)
Action: [type Fn]

# Channel recv/select result types — declared in private dict.
# Callers use fully-qualified constructors: Closed.Closed, Full.Full, Lagged.Lagged.

CancelHandle: [type [child-ctx: Context  cancel: Context]]  # return value of with-cancel; cancel is a Context, not an Action — fire with [cancel-task pair.cancel]
# SelectSource: [type [let t r] [SelectSource  ch: [Channel t]  handler: [Fn@r [t]]]]  — one source entry for select-once

# Task lifecycle
# task is a fn@Expr (below) supporting multi-body [task e1 e2 e3].
# Single-arg [task e] passes through to builtin-task directly.
await:         builtin-await
par:           builtin-par
par-map: [fn [let f xs]
  [tasks: [map [fn [let x] [task [fn [] [f x]]]] xs]]
  [map await tasks]]

par-filter: [fn [let pred xs]
  [pairs: [par-map [fn [let x] [x [pred x]]] xs]]
  [map [fn [let p] p.0] [filter [fn [let p] p.1] pairs]]]

# Channels
channel:            builtin-channel
send:               builtin-send
recv:               builtin-recv
broadcast-channel:  builtin-broadcast-channel
oneshot-channel:    builtin-oneshot-channel
try-send:           builtin-try-send
# builtin-select-once returns {ok: result} | {closed: []}.
# The public select-once unwraps {ok: v} to v, and {closed: []} to Closed.Closed,
# preserving the original protocol (handler_result | Closed.Closed) for callers.
select-once: [fn@Any [let ctx sources]
    [call [fn [let raw]
        [match [builtin-has-key? "ok" raw]
            0: Closed.Closed
            [case [let _] ... [builtin-dict-get "ok" raw]]]]
        [builtin-select-once ctx sources]]]

# Emit function: write to stdout. The CLI may override this via the %emit channel.
# Uses builtin-emit directly for standalone use; CLI loader.llt overrides with channel-based version.
emit@[doc: "Print a value to stdout"]: builtin-emit

# Event-source channels
signal-channel:  builtin-signal-channel
timer-channel:   builtin-timer-channel
watch-channel:   builtin-watch-channel

# Reactive cells (T-831) — last-write-wins broadcast via tokio::sync::watch
reactive-cell:   builtin-reactive-cell
cell-get:        builtin-cell-get
cell-set:        builtin-cell-set

# Cancellation contexts
context:         builtin-context
with-cancel:     builtin-with-cancel
with-timeout:    [fn@Context [let clock@ClockCap ctx@Context dur@Integer]   [builtin-with-timeout  clock ctx dur]]
with-deadline:   [fn@Context [let clock@ClockCap ctx@Context ts@Integer]    [builtin-with-deadline clock ctx ts]]
with-context:    builtin-with-context
non-cancellable@[doc: "Create a fresh root Context that will never be cancelled. Used for cleanup code that must run even when the main context is cancelled."]: [fn@Any [let] [apply builtin-non-cancellable []]]
cancelled?:      builtin-cancelled-q
cancel-task:     builtin-cancel-task

# Process lifecycle
cancel-root:   builtin-cancel-root
drain@[doc: "Await all background tasks until complete. Waits indefinitely."]: [fn@Any [let] [apply builtin-drain []]]
exit-now:      builtin-exit-now

# ============================================================================
# Async Utilities (T-733: moved from stdlib/async.llt)
# ============================================================================
#
# High-level async utilities built on the async builtins above.
# Private helpers (retry-impl, select-impl) are in the private dict.

# await-all: wait for all tasks in parallel, return a Seq of results.
# Each element of tasks must be a Task value produced by [task ...].
# Results are returned in the same order as the input tasks.
#
# Type: ([Seq [Task T]] -> [Seq T])
# Example: [await-all [[task [+ 1 2]] [task [* 3 4]]]] => [3 12]
await-all@[doc: """
Wait for all tasks and return a Seq of results in submission order.

Example: [await-all [[task [+ 1 2]] [task [* 3 4]]]] => [3 12]

Note: Each element must be a Task value. Results are in input order.
The map drives evaluation; for parallel work, spawn tasks before calling await-all.
"""]: [fn@[bind: [a]  return: [Seq a]] [let tasks]
    [map await [collect tasks]]]

# recv-all: receive exactly n items from a channel, returning them as a Seq.
# Blocks until all n items have been received.
#
# Type: ([Channel T] -> Int -> [Seq T])
# Example: [recv-all ch 3] => Seq of 3 received values
recv-all@[doc: """
Receive exactly n items from a channel, returning them as a Seq in receive order.

Example: [recv-all ch 3]

Note: Blocks until all n items have been received. Uses reduce over [range 0 n]
to collect results; the accumulator grows by one item per step.
"""]: [fn@[bind: [a]  return: [Seq a]] [let ch n@Integer]
    [reduce [fn [let acc _] [concat-seq acc [cons [recv ch] Seq.End]]] Seq.End [range 0 n]]]

# exit: graceful shutdown — cancel all tasks, wait for drain, then exit.
#
# Type: (Int -> Null)
# Example: [exit 0]
exit@[doc: """
Graceful shutdown: cancel all tasks, drain, then exit with code.

Example: [exit 0]

Note: Waits indefinitely for tasks to drain. For bounded wait, use graceful-exit.
"""]: [fn@Never [let code@Integer]
    [cancel-root]
    [drain]
    [exit-now code]]

# graceful-exit: bounded graceful shutdown with an explicit drain timeout.
#
# Type: (Int Int -> Null)
# Example: [graceful-exit 0 5000]
graceful-exit@[doc: """
Bounded graceful shutdown: cancel tasks, drain with timeout, then exit.

Example: [graceful-exit 0 5000]  # 5-second drain timeout

Args:
- code: exit code
- timeout-ms: maximum milliseconds to wait for drain (requires %clock capability in caller scope;
              pass it as the first arg to [with-timeout %clock ctx dur] for bounded drain)

Note: timeout-ms is accepted for API compatibility. The drain runs in a try-or context;
callers that need a hard timeout should call [with-timeout clock [context] timeout-ms] directly.
If drain times out, exits immediately without waiting for remaining tasks.
"""]: [fn@Never [let code@Integer timeout-ms@Integer]
  [cancel-root]
  [try [fn [let] [drain]]]
  [exit-now code]]

# select: repeatedly call select-once on sources until the context is
# cancelled. On each iteration the handler is called with the received value.
# Tail-recursive implementation with O(1) stack depth via TCO.
#
# Type: (Context -> [Seq {ch: Channel  handler: Fn}] -> Fn -> Null)
# Example:
#   [select [context]
#     [seq [ch: sig-ch  handler: [fn [let _] [exit 0]]] []]
#     identity]
select@[doc: """
Repeatedly select from channels until the context is cancelled.

Sources must be a Seq of dicts with `ch:` (Channel) and `handler:` (Fn) fields.

Example:
  [select [context]
    [seq [ch: sig-ch   handler: [fn [let _] [exit 0]]]
     [seq [ch: req-ch  handler: [fn [let req] [task [handle req]]]] []]]
    identity]

Note: Tail-recursive with O(1) stack depth. TCO was implemented in tco-proper sprint.
"""]: [fn@Any [let ctx sources@[Seq Dict] handler@[Fn@Any [Any]]]
  [go: [fn [let]
    [match [builtin-cancelled-q ctx]
      0: [call [fn [let raw]
            [match [builtin-has-key? "ok" raw]
              0: Closed.Closed
              [case [let _] ...
                [call [fn [let _ignored] [go]]
                      [handler [builtin-dict-get "ok" raw]]]]]]
           [builtin-select-once ctx sources]]
      ...: []]]]
  [go]]

# retry: run thunk; on error, retry up to n more times.
# Returns the first successful value, or raises "retry limit exceeded" after
# n+1 total attempts fail.
#
# Type: (Int -> [Fn -> T] -> T)
# Example: [retry 3 [fn [] [flaky-operation]]]
retry@[doc: """
Retry a zero-arg function up to n times on error.

Example: [retry 3 [fn [] [flaky-operation]]]

Note: Makes up to n+1 total attempts (1 initial + n retries).
Raises "retry limit exceeded" if all attempts fail.
Inherently materializing: must force each attempt to catch errors.
"""]: [fn@[bind: [a]  return: a] [let n@Integer thunk@[Fn@a []]]
  [go: [fn [let n]
    [match [raw-to-result [builtin-try [thunk]]]
      [case [let p] [Result.Ok p]  p.value]
      [case [let _] [Result.Error] [match [builtin-int-gte n 1]
                     0: [builtin-raise "retry limit exceeded"]
                     ...: [go [builtin-int-sub n 1]]]]]]]
  [go n]]

# finally: run cleanup regardless of whether body succeeds or errors.
# Returns the body's result on success, re-raises on error.
# Cleanup receives no arguments and its return value is discarded.
#
# Type: ([Fn -> Null] -> [Fn -> T] -> T)
# Example:
#   [finally [fn [] [close-conn conn]] [fn [] [do-work]]]
finally@[doc: """
Run cleanup regardless of whether body succeeds or errors, then return/re-raise.

Example:
  [finally
    [fn [] [close-conn conn]]
    [fn [] [do-work-with conn]]]

Note: cleanup runs in a non-cancellable context — it will complete even if
the parent context is cancelled. Cleanup return value is discarded.
Rust-level EvalErrors bypass finally.
"""]: [fn@[bind: [a]  return: a] [let cleanup@[Fn@Any []] body@[Fn@a []]]
    [match [try body]
        # Run cleanup as a zero-arg thunk in non-cancellable context, then return result.
        # with-context takes (context, thunk) where thunk is a fn [let] that runs cleanup.
        # null? forces the with-context result; [if c v v] always returns v.
        [case [let p] [Result.Ok p]    [if [null? [with-context [non-cancellable] [fn [let] [cleanup]]]] p.value p.value]]
        [case [let p] [Result.Error p] [if [null? [with-context [non-cancellable] [fn [let] [cleanup]]]] [raise p.msg] [raise p.msg]]]]]

# ============================================================================
# Macro transformer helpers and public transformers
# (formerly stdlib/macros.llt — merged into prelude)
# ============================================================================
#
# These helpers are evaluated in the stdlib context, which means they have
# access to all prelude public functions above (str-contains?, starts-with?,
# str-slice, split, length, append, collect, reduce, map, cons, reindex,
# slice, tag-of, gensym, Expr.* constructors, etc.).
#
# The public transformer functions (tmpl, do, >>, syntax-fn, syntax-class,
# syntax-type) are exported from this dict and available in the stdlib env.
#
# ============================================================================
# Difference list — O(1) snoc, O(n) finalization
# ============================================================================
#
# A DList is a function (Seq → Seq). dlist-empty is the identity; dlist-snoc
# appends one element to the back by composing a new cons onto the front of
# the tail passed in at finalization time. dlist-to-seq applies the DList to
# the empty Seq terminator, producing a lazy Seq in insertion order.
#
# Complexity: O(1) per snoc (closure allocation only), O(n) to finalize.
# Used by the tmpl accumulator to avoid the O(n²) cost of repeated [append].

dlist-empty: [fn@[bind: [a]  return: [Seq a]] [let xs@[Seq a]] xs]
dlist-snoc:  [fn@[bind: [a]] [let dl x@a] [fn@[bind: [a]  return: [Seq a]] [let xs@[Seq a]] [dl [cons x xs]]]]
dlist-to-seq: [fn@[bind: [a]  return: [Seq a]] [let dl] [dl Seq.End]]

# ============================================================================
# Finger tree — O(1) amortized push/pop, O(log n) index (Hinze & Paterson 2006)
# ============================================================================
#
# A 2-3 finger tree is a purely-functional persistent sequence representation
# that provides O(1) amortized push-left, push-right, peek-left, peek-right,
# pop-left, pop-right, plus O(log n) indexed access and concatenation.
#
# Structure:
#   FingerTree a  ::=  FTEmpty
#                   |  FTSingle a
#                   |  FTDeep (size: Int) (Digit a) (FingerTree (FNode a)) (Digit a)
#
# FTDeep.size stores the TOTAL LEAF COUNT for the entire subtree.
# This invariant enables O(1) length and O(log n) index without traversal.
# It is maintained by every push, pop, and concat operation.
#
# The spine is a FingerTree of FNode values — a lazy polymorphic recursion.
# tinct's pervasive laziness means spine updates are thunks, never forced
# unless needed, giving the amortized O(1) guarantee naturally.
#
# Complexity:
#   push-left / push-right / peek-left / peek-right / pop-left / pop-right:
#                           O(1) amortized
#   ft-size:                O(1) (reads precomputed size)
#   ft-index:               O(log n)
#   collect:                O(n)
#   ft-concat:              O(log n)
#   ft-to-seq:              O(log n) amortized per element
#
# Reference: Hinze, R. & Paterson, R. (2006). Finger Trees: A Simple General-
# purpose Data Structure. JFP 16(2), 197-217.

# ============================================================================
# Finger tree type declarations (S-897)
# ============================================================================

Digit@[doc: "Internal: 1–4 element buffer used as prefix/suffix in a FingerTree spine."]:
  [type [let a]
    One:   [a: a]
    Two:   [a: a  b: a]
    Three: [a: a  b: a  c: a]
    Four:  [a: a  b: a  c: a  d: a]]

FNode@[doc: "Internal: 2- or 3-child spine node carrying a precomputed subtree leaf count in the size field."]:
  [type [let a]
    FNode2: [size: Int  left: a  right: a]
    FNode3: [size: Int  left: a  mid: a  right: a]]

FingerTree@[doc: """
Internal: 2-3 finger tree (Hinze & Paterson 2006). Backing structure for List.

Every FTDeep node carries the total leaf count of its subtree in the size field,
enabling O(1) length and O(log n) index navigation without traversal.
Purely tinct — no Rust builtins required.
"""]:
  [type [let a]
    FTEmpty
    FTSingle: [value: a]
    FTDeep:   [size: Int  prefix: [Digit a]  spine: [FingerTree [FNode a]]  suffix: [Digit a]]]

List@[doc: """
Ordered finite sequence with O(1) amortized push and O(log n) index access.

Implemented as a 2-3 finger tree (Hinze & Paterson 2006). Every node stores
a precomputed subtree size, so length is O(1) and index access navigates the
tree in O(log n) comparisons.

List vs Seq:
  List — O(log n) index, O(1) amortized push/pop, always finite
  Seq  — O(1) head/tail, potentially infinite, no index access
"""]:
  [type [let a] FingerTree]

# ============================================================================
# Finger tree internal helpers (S-897)
# ============================================================================

# ── Size helpers ──────────────────────────────────────────────────────────────

ft-size@[doc: "O(1) total leaf count of a FingerTree, read from the precomputed size field."]:
  [fn@[bind: [a]  return: Integer] [let t@[FingerTree a]]
    [match t
      FingerTree.FTEmpty:      0
      [FingerTree.FTSingle _]: 1
      [case [let p] [FingerTree.FTDeep p]   p.size]]]

fnode-size@[doc: "Internal: O(1) leaf count of an FNode, read from its precomputed size field."]:
  [fn@[bind: [a]  return: Integer] [let n@[FNode a]]
    [match n
      [case [let p] [FNode.FNode2 p] p.size]
      [case [let p] [FNode.FNode3 p] p.size]]]

digit-size@[doc: "Internal: O(1) total leaf count of a Digit, summing per-element sizes via elem-size."]:
  [fn [let d elem-size]
    [match d
      [case [let p] [Digit.One   p] [elem-size p.a]]
      [case [let p] [Digit.Two   p] [+ [elem-size p.a] [elem-size p.b]]]
      [case [let p] [Digit.Three p] [+ [elem-size p.a] [+ [elem-size p.b] [elem-size p.c]]]]
      [case [let p] [Digit.Four  p] [+ [elem-size p.a] [+ [elem-size p.b] [+ [elem-size p.c] [elem-size p.d]]]]]]]

# ── Traversal helpers — ft-to-seq, ft-digit-seq, ft-spine-seq ────────────────

ft-to-seq@[doc: "Lazy left-to-right traversal of a FingerTree. O(log n) amortized per element."]:
  [fn@[bind: [a]  return: [Seq a]] [let t@[FingerTree a]]
    [match t
      FingerTree.FTEmpty:      Seq.End
      [case [let p] [FingerTree.FTSingle p] [Seq.Cons head: p.value  tail: Seq.End]]
      [case [let p] [FingerTree.FTDeep p]
        [ft-digit-seq p.prefix
          [ft-spine-seq p.spine
            [ft-digit-seq p.suffix Seq.End]]]]]]

ft-digit-seq@[doc: "Internal: flatten a Digit into a lazy Seq, appending rest."]:
  [fn [let d rest]
    [match d
      [case [let p] [Digit.One   p] [Seq.Cons head: p.a  tail: rest]]
      [case [let p] [Digit.Two   p] [Seq.Cons head: p.a  tail: [Seq.Cons head: p.b  tail: rest]]]
      [case [let p] [Digit.Three p] [Seq.Cons head: p.a  tail: [Seq.Cons head: p.b  tail: [Seq.Cons head: p.c  tail: rest]]]]
      [case [let p] [Digit.Four  p] [Seq.Cons head: p.a  tail: [Seq.Cons head: p.b  tail: [Seq.Cons head: p.c  tail: [Seq.Cons head: p.d  tail: rest]]]]]]]

ft-spine-seq@[doc: "Internal: flatten a spine (FingerTree of FNode) into a lazy Seq of leaf elements."]:
  [fn [let spine rest]
    [match [ft-to-seq spine]
      Seq.End: rest
      [case [let np] [Seq.Cons np]
        [match np.head
          [case [let n] [FNode.FNode2 n] [Seq.Cons head: n.left  tail: [Seq.Cons head: n.right  tail: [ft-spine-seq-tail np.tail rest]]]]
          [case [let n] [FNode.FNode3 n] [Seq.Cons head: n.left  tail: [Seq.Cons head: n.mid    tail: [Seq.Cons head: n.right tail: [ft-spine-seq-tail np.tail rest]]]]]]]]]

ft-spine-seq-tail@[doc: "Internal: continue flattening a spine Seq into leaf elements."]:
  [fn [let spine-seq rest]
    [match spine-seq
      Seq.End: rest
      [case [let np] [Seq.Cons np]
        [match np.head
          [case [let n] [FNode.FNode2 n] [Seq.Cons head: n.left  tail: [Seq.Cons head: n.right  tail: [ft-spine-seq-tail np.tail rest]]]]
          [case [let n] [FNode.FNode3 n] [Seq.Cons head: n.left  tail: [Seq.Cons head: n.mid    tail: [Seq.Cons head: n.right tail: [ft-spine-seq-tail np.tail rest]]]]]]]]]

# ── Construction ─────────────────────────────────────────────────────────────

digit-push-right@[doc: "Internal: append one element to the right of a Digit (not Four)."]:
  [fn [let x d]
    [match d
      [case [let s] [Digit.One   s] [Digit.Two   a: s.a  b: x]]
      [case [let s] [Digit.Two   s] [Digit.Three a: s.a  b: s.b  c: x]]
      [case [let s] [Digit.Three s] [Digit.Four  a: s.a  b: s.b  c: s.c  d: x]]
      ...: [raise "digit-push-right: digit is full (Four)"]]]

digit-push-left@[doc: "Internal: prepend one element to the left of a Digit (not Four)."]:
  [fn [let x d]
    [match d
      [case [let s] [Digit.One   s] [Digit.Two   a: x  b: s.a]]
      [case [let s] [Digit.Two   s] [Digit.Three a: x  b: s.a  c: s.b]]
      [case [let s] [Digit.Three s] [Digit.Four  a: x  b: s.a  c: s.b  d: s.c]]
      ...: [raise "digit-push-left: digit is full (Four)"]]]

digit-first@[doc: "Internal: leftmost element of a Digit."]:
  [fn [let d]
    [match d
      [case [let p] [Digit.One   p] p.a]
      [case [let p] [Digit.Two   p] p.a]
      [case [let p] [Digit.Three p] p.a]
      [case [let p] [Digit.Four  p] p.a]]]

digit-last@[doc: "Internal: rightmost element of a Digit."]:
  [fn [let d]
    [match d
      [case [let p] [Digit.One   p] p.a]
      [case [let p] [Digit.Two   p] p.b]
      [case [let p] [Digit.Three p] p.c]
      [case [let p] [Digit.Four  p] p.d]]]

push-right@[return: [List a]  doc: "Append an element to the right end of a List. O(1) amortized."]:
  [fn@[bind: [a]] [let x@a t@[List a]]
    [ft-push-right-sized x 1 t]]

ft-push-right-sized@[doc: """
Internal: size-aware right push. x-size is the leaf count x contributes —
1 at the outermost level (x is a leaf), fnode-size(x) at spine level (x is
an FNode). Maintains the invariant: FTDeep.size = total leaf count at every level.
"""]:
  [fn [let x x-size t]
    [match t
      FingerTree.FTEmpty:
        [FingerTree.FTSingle value: x]
      [case [let p] [FingerTree.FTSingle p]
        [FingerTree.FTDeep
          size:   [+ 1 x-size]
          prefix: [Digit.One a: p.value]
          spine:  FingerTree.FTEmpty
          suffix: [Digit.One a: x]]]
      [case [let p] [FingerTree.FTDeep p]
        [match p.suffix
          [case [let s] [Digit.Four s]
            [FingerTree.FTDeep
              size:   [+ p.size x-size]
              prefix: p.prefix
              spine:  [ft-push-right-sized [FNode.FNode3 size: 3  left: s.a  mid: s.b  right: s.c] 3 p.spine]
              suffix: [Digit.Two a: s.d  b: x]]]
          ...:
            [FingerTree.FTDeep
              size:   [+ p.size x-size]
              prefix: p.prefix
              spine:  p.spine
              suffix: [digit-push-right x p.suffix]]]]]]

ft-push-left@[doc: "Internal: prepend element x to the left end of a FingerTree. O(1) amortized."]:
  [fn@[bind: [a]] [let x@a t@[List a]]
    [ft-push-left-sized x 1 t]]

ft-push-left-sized@[doc: "Internal: size-aware left push."]:
  [fn [let x x-size t]
    [match t
      FingerTree.FTEmpty:
        [FingerTree.FTSingle value: x]
      [case [let p] [FingerTree.FTSingle p]
        [FingerTree.FTDeep
          size:   [+ x-size 1]
          prefix: [Digit.One a: x]
          spine:  FingerTree.FTEmpty
          suffix: [Digit.One a: p.value]]]
      [case [let p] [FingerTree.FTDeep p]
        [match p.prefix
          [case [let s] [Digit.Four s]
            [FingerTree.FTDeep
              size:   [+ p.size x-size]
              prefix: [Digit.Two a: x  b: s.a]
              spine:  [ft-push-left-sized [FNode.FNode3 size: 3  left: s.b  mid: s.c  right: s.d] 3 p.spine]
              suffix: p.suffix]]
          ...:
            [FingerTree.FTDeep
              size:   [+ p.size x-size]
              prefix: [digit-push-left x p.prefix]
              spine:  p.spine
              suffix: p.suffix]]]]]

# ── Index access ─────────────────────────────────────────────────────────────

ft-index@[doc: """
O(log n) index into a FingerTree using precomputed size annotations.

Invariant: FTDeep.size stores the total leaf count at every level.
This invariant is maintained by push-left, push-right, and ft-concat.
"""]:
  [fn@[bind: [a]  return: a] [let i@Integer t@[FingerTree a]]
    [ft-index-by-size i t [fn [let _] 1] [fn [let x _] x]]]

elem-size-at-level@[doc: "Internal: leaf count for an element at any spine depth."]:
  [fn@Integer [let x]
    [match x
      [case [let p] [FNode.FNode2 p] p.size]
      [case [let p] [FNode.FNode3 p] p.size]
      ...:               1]]

fnode-elem-get@[doc: "Internal: self-similar descent into nested FNodes to reach a leaf."]:
  [fn [let node i]
    [match node
      [case [let fn2] [FNode.FNode2 fn2] [fnode2-elem-get fn2.left fn2.right i]]
      [case [let fn3] [FNode.FNode3 fn3] [fnode3-elem-get fn3.left fn3.mid fn3.right i]]
      ...:                  node]]

fnode2-elem-get@[doc: "Internal: index into a 2-child FNode."]:
  [fn [let left right i]
    [ls: [elem-size-at-level left]]
    [if [< i ls]
      [fnode-elem-get left i]
      [fnode-elem-get right [- i ls]]]]

fnode3-elem-get@[doc: "Internal: index into a 3-child FNode."]:
  [fn [let left mid right i]
    [ls: [elem-size-at-level left]]
    [ms: [elem-size-at-level mid]]
    [i2: [- i ls]]
    [if [< i ls]
      [fnode-elem-get left i]
      [if [< i2 ms]
        [fnode-elem-get mid i2]
        [fnode-elem-get right [- i2 ms]]]]]

ft-index-by-size@[doc: """
Internal: generalized O(log n) index parameterized by elem-size and elem-get.
elem-size: a → Int — how many leaves does this element cover.
elem-get:  a → Int → leaf — navigate into element to reach the leaf at offset i.
"""]:
  [fn [let i t elem-size elem-get]
    [match t
      FingerTree.FTEmpty:      [raise "ft-index: index out of bounds"]
      [case [let p] [FingerTree.FTSingle p] [elem-get p.value i]]
      [case [let p] [FingerTree.FTDeep p]   [ft-index-deep i p elem-size elem-get]]]]

ft-index-deep@[doc: "Internal: navigate into an FTDeep node."]:
  [fn [let i p elem-size elem-get]
    [pre-size:         [digit-size p.prefix elem-size]]
    [suf-size:         [digit-size p.suffix elem-size]]
    [spine-leaf-count: [- p.size [+ pre-size suf-size]]]
    [i2:               [- i pre-size]]
    [if [< i pre-size]
      [digit-index i p.prefix elem-size elem-get]
      [if [< i2 spine-leaf-count]
        [ft-index-by-size i2 p.spine elem-size-at-level fnode-elem-get]
        [digit-index [- i2 spine-leaf-count] p.suffix elem-size elem-get]]]]

digit-index-two@[doc: "Internal: index into a two-element Digit."]:
  [fn [let i a b elem-size elem-get]
    [sa: [elem-size a]]
    [if [< i sa] [elem-get a i] [elem-get b [- i sa]]]]

digit-index-three@[doc: "Internal: index into a three-element Digit."]:
  [fn [let i a b c elem-size elem-get]
    [sa: [elem-size a]]
    [sb: [elem-size b]]
    [i2: [- i sa]]
    [if [< i sa]
      [elem-get a i]
      [if [< i2 sb] [elem-get b i2] [elem-get c [- i2 sb]]]]]

digit-index-four@[doc: "Internal: index into a four-element Digit."]:
  [fn [let i a b c d elem-size elem-get]
    [sa: [elem-size a]]
    [sb: [elem-size b]]
    [sc: [elem-size c]]
    [i2: [- i sa]]
    [i3: [- i2 sb]]
    [if [< i sa]
      [elem-get a i]
      [if [< i2 sb]
        [elem-get b i2]
        [if [< i3 sc]
          [elem-get c i3]
          [elem-get d [- i3 sc]]]]]]

digit-index@[doc: "Internal: dispatch indexed access into any Digit."]:
  [fn [let i d elem-size elem-get]
    [match d
      [case [let p] [Digit.One   p] [elem-get p.a i]]
      [case [let p] [Digit.Two   p] [digit-index-two   i p.a p.b         elem-size elem-get]]
      [case [let p] [Digit.Three p] [digit-index-three i p.a p.b p.c     elem-size elem-get]]
      [case [let p] [Digit.Four  p] [digit-index-four  i p.a p.b p.c p.d elem-size elem-get]]]]

# ── Concatenation ─────────────────────────────────────────────────────────────

digit-to-seq@[doc: "Internal: convert a Digit to a lazy Seq of its elements."]:
  [fn [let d]
    [match d
      [case [let p] [Digit.One   p] [Seq.Cons head: p.a  tail: Seq.End]]
      [case [let p] [Digit.Two   p] [Seq.Cons head: p.a  tail: [Seq.Cons head: p.b  tail: Seq.End]]]
      [case [let p] [Digit.Three p] [Seq.Cons head: p.a  tail: [Seq.Cons head: p.b  tail: [Seq.Cons head: p.c  tail: Seq.End]]]]
      [case [let p] [Digit.Four  p] [Seq.Cons head: p.a  tail: [Seq.Cons head: p.b  tail: [Seq.Cons head: p.c  tail: [Seq.Cons head: p.d  tail: Seq.End]]]]]]]

chunk-fnodes@[doc: """
Internal: group a Seq of elements into FNode2/FNode3 values.

elem-size: a → Int — leaf count contributed by each input element.
At the outermost level elem-size = [fn[_]1] (plain leaf values).
At spine level elem-size = fnode-size (FNodes cover 2–3 leaves).

The size field of each output FNode is the SUM of its children's elem-size values.
This maintains the invariant: FTDeep.size = total leaf count at every level.

Prefers FNode3 when exactly 3 elements remain; otherwise FNode2.
Two digits yield 4–8 elements, so chunking always terminates cleanly
(Hinze & Paterson 2006).
"""]:
  [fn [let s elem-size]
    [match s
      Seq.End: Seq.End
      [case [let p1] [Seq.Cons p1]
        [match p1.tail
          Seq.End: [raise "chunk-fnodes: lone element — digit sizes must be 2–4"]
          [case [let p2] [Seq.Cons p2]
            [match p2.tail
              Seq.End:
                [Seq.Cons head: [FNode.FNode2
                                  size:  [+ [elem-size p1.head] [elem-size p2.head]]
                                  left:  p1.head
                                  right: p2.head]
                          tail: Seq.End]
              [case [let p3] [Seq.Cons p3]
                [match p3.tail
                  Seq.End:
                    [Seq.Cons head: [FNode.FNode3
                                      size:  [+ [elem-size p1.head] [+ [elem-size p2.head] [elem-size p3.head]]]
                                      left:  p1.head
                                      mid:   p2.head
                                      right: p3.head]
                              tail: Seq.End]
                  ...:
                    [Seq.Cons head: [FNode.FNode2
                                      size:  [+ [elem-size p1.head] [elem-size p2.head]]
                                      left:  p1.head
                                      right: p2.head]
                              tail: [chunk-fnodes p2.tail elem-size]]]]]]]]]]

ft-add-digits@[doc: "Internal: spine-level inner-concat (Hinze & Paterson 2006). Chunks the middle elements (left suffix + right prefix) into FNodes, folds them into the left spine, then catenates with the right spine. elem-size is threaded to chunk-fnodes to correctly compute FNode sizes at any depth."]:
  [fn [let left left-sf right-pf right elem-size]
    [mids:  [concat left-sf right-pf]]
    [nodes: [chunk-fnodes mids elem-size]]
    [ft-add-nodes left nodes right]]

ft-add-nodes@[return: Any  doc: "Internal: fold FNodes into the left spine then catenate with the right spine. Uses fnode-size (not 1) when pushing into the spine, maintaining the leaf-count invariant at every level."]:
  [fn@Dict [let left nodes right]
    [match nodes
      Seq.End:
        [match left
          FingerTree.FTEmpty: right
          ...:
            [match right
              FingerTree.FTEmpty: left
              ...: [ft-concat-sized left right fnode-size]]]
      [case [let p] [Seq.Cons p]
        [ft-add-nodes [ft-push-right-sized p.head [fnode-size p.head] left] p.tail right]]]]

ft-concat-sized@[doc: "Internal: FingerTree catenation parameterized by elem-size. At the outermost level elem-size = [fn[_]1]; at spine level elem-size = fnode-size, since elements are FNodes covering 2–3 leaves. elem-size is threaded to ft-add-digits → chunk-fnodes to maintain size invariant at every depth."]:
  [fn [let a b elem-size]
    [match a
      FingerTree.FTEmpty: b
      [case [let pa] [FingerTree.FTSingle pa]
        [ft-push-left-sized pa.value [elem-size pa.value] b]]
      [case [let pa] [FingerTree.FTDeep pa]
        [match b
          FingerTree.FTEmpty: a
          [case [let pb] [FingerTree.FTSingle pb]
            [ft-push-right-sized pb.value [elem-size pb.value] a]]
          [case [let pb] [FingerTree.FTDeep pb]
            [FingerTree.FTDeep
              size:   [+ pa.size pb.size]
              prefix: pa.prefix
              spine:  [ft-add-digits pa.spine [digit-to-seq pa.suffix] [digit-to-seq pb.prefix] pb.spine elem-size]
              suffix: pb.suffix]]]]]]

ft-concat@[doc: "Internal: concatenate two FingerTrees at the outermost level (each element is 1 leaf)."]:
  [fn [let a@[List a] b@[List a]]
    [ft-concat-sized a b [fn [let _] 1]]]

# ── viewL / viewR — Hinze & Paterson 2006 ────────────────────────────────────

digit-tail-or-null@[doc: "Internal: remove the leftmost element from a Digit. Returns the remaining Digit, or [] if it was a One."]:
  [fn [let d]
    [match d
      [case [let _] [Digit.One   _] []]
      [case [let p] [Digit.Two   p] [Digit.One   a: p.b]]
      [case [let p] [Digit.Three p] [Digit.Two   a: p.b  b: p.c]]
      [case [let p] [Digit.Four  p] [Digit.Three a: p.b  b: p.c  c: p.d]]]]

digit-init-or-null@[doc: "Internal: remove the rightmost element from a Digit. Returns the remaining Digit, or [] if it was a One."]:
  [fn [let d]
    [match d
      [case [let _] [Digit.One   _] []]
      [case [let p] [Digit.Two   p] [Digit.One   a: p.a]]
      [case [let p] [Digit.Three p] [Digit.Two   a: p.a  b: p.b]]
      [case [let p] [Digit.Four  p] [Digit.Three a: p.a  b: p.b  c: p.c]]]]

fnode-to-digit@[doc: "Internal: convert an FNode into a Digit of its children. Self-similar — works at any spine depth."]:
  [fn [let node]
    [match node
      [case [let p] [FNode.FNode2 p] [Digit.Two   a: p.left  b: p.right]]
      [case [let p] [FNode.FNode3 p] [Digit.Three a: p.left  b: p.mid   c: p.right]]]]

digit-to-tree@[doc: "Internal: rebuild a FingerTree from a Digit when the spine is exhausted during viewL/viewR. elem-size is passed through to maintain the size invariant at any depth."]:
  [fn [let d elem-size]
    [match d
      [case [let p] [Digit.One   p]
        [FingerTree.FTSingle value: p.a]]
      [case [let p] [Digit.Two   p]
        [FingerTree.FTDeep
          size:   [+ [elem-size p.a] [elem-size p.b]]
          prefix: [Digit.One a: p.a]
          spine:  FingerTree.FTEmpty
          suffix: [Digit.One a: p.b]]]
      [case [let p] [Digit.Three p]
        [FingerTree.FTDeep
          size:   [+ [elem-size p.a] [+ [elem-size p.b] [elem-size p.c]]]
          prefix: [Digit.Two a: p.a  b: p.b]
          spine:  FingerTree.FTEmpty
          suffix: [Digit.One a: p.c]]]
      [case [let p] [Digit.Four  p]
        [FingerTree.FTDeep
          size:   [+ [elem-size p.a] [+ [elem-size p.b] [+ [elem-size p.c] [elem-size p.d]]]]
          prefix: [Digit.Two a: p.a  b: p.b]
          spine:  FingerTree.FTEmpty
          suffix: [Digit.Two a: p.c  b: p.d]]]]]

ft-view-left-borrow@[doc: "Internal: borrow leftmost FNode from spine to form a new prefix. Called when prefix digit is exhausted."]:
  [fn [let p head elem-sz elem-size]
    [spine-view: [ft-view-left-sized p.spine fnode-size]]
    [elem: head
     rest: [FingerTree.FTDeep
             size:   [- p.size elem-sz]
             prefix: [fnode-to-digit spine-view.elem]
             spine:  spine-view.rest
             suffix: p.suffix]]]

ft-view-left-deep@[doc: "Internal: viewL for the FTDeep case. Extracted to allow multi-body intermediate bindings (match case arms accept only one body expression)."]:
  [fn [let p elem-size]
    [head:     [digit-first p.prefix]]
    [tail-dig: [digit-tail-or-null p.prefix]]
    [elem-sz:  [elem-size head]]
    [if [not [null? tail-dig]]
      [elem: head
       rest: [FingerTree.FTDeep
               size:   [- p.size elem-sz]
               prefix: tail-dig
               spine:  p.spine
               suffix: p.suffix]]
      [if [= 0 [ft-size p.spine]]
        [elem: head
         rest: [digit-to-tree p.suffix elem-size]]
        [ft-view-left-borrow p head elem-sz elem-size]]]]

ft-view-left-sized@[doc: "Internal: viewL (Hinze & Paterson 2006). Peels the leftmost element from a FingerTree, returning [elem: a  rest: FingerTree]. Raises on empty tree. Recursive spine calls use fnode-size as elem-size."]:
  [fn [let t elem-size]
    [match t
      [case [let _] FingerTree.FTEmpty
        [raise "pop-left: empty List"]]
      [case [let p] [FingerTree.FTSingle p]
        [elem: p.value  rest: FingerTree.FTEmpty]]
      [case [let p] [FingerTree.FTDeep p]
        [ft-view-left-deep p elem-size]]]]

ft-view-right-borrow@[doc: "Internal: borrow rightmost FNode from spine to form a new suffix. Called when suffix digit is exhausted."]:
  [fn [let p last elem-sz elem-size]
    [spine-view: [ft-view-right-sized p.spine fnode-size]]
    [elem: last
     rest: [FingerTree.FTDeep
             size:   [- p.size elem-sz]
             prefix: p.prefix
             spine:  spine-view.rest
             suffix: [fnode-to-digit spine-view.elem]]]]

ft-view-right-deep@[doc: "Internal: viewR for the FTDeep case. Extracted to allow multi-body intermediate bindings."]:
  [fn [let p elem-size]
    [last:     [digit-last p.suffix]]
    [init-dig: [digit-init-or-null p.suffix]]
    [elem-sz:  [elem-size last]]
    [if [not [null? init-dig]]
      [elem: last
       rest: [FingerTree.FTDeep
               size:   [- p.size elem-sz]
               prefix: p.prefix
               spine:  p.spine
               suffix: init-dig]]
      [if [= 0 [ft-size p.spine]]
        [elem: last
         rest: [digit-to-tree p.prefix elem-size]]
        [ft-view-right-borrow p last elem-sz elem-size]]]]

ft-view-right-sized@[doc: "Internal: viewR (Hinze & Paterson 2006). Peels the rightmost element from a FingerTree. Symmetric to ft-view-left-sized."]:
  [fn [let t elem-size]
    [match t
      [case [let _] FingerTree.FTEmpty
        [raise "pop-right: empty List"]]
      [case [let p] [FingerTree.FTSingle p]
        [elem: p.value  rest: FingerTree.FTEmpty]]
      [case [let p] [FingerTree.FTDeep p]
        [ft-view-right-deep p elem-size]]]]

ft-pop-left@[doc: "Internal: remove leftmost leaf from a List."]:
  [fn [let t@[List a]] [ft-view-left-sized  t [fn [let _] 1]].rest]

ft-pop-right@[doc: "Internal: remove rightmost leaf from a List."]:
  [fn [let t@[List a]] [ft-view-right-sized t [fn [let _] 1]].rest]

# ── List typeclass instances ──────────────────────────────────────────────────

PrependableList@[doc: "Prependable instance for List: push-left = ft-push-left, peek-left = first element, pop-left = ft-pop-left"]:
  [instance Prependable [let c@[List a] a]:
    [push-left: [fn [let x t] [ft-push-left x t]]
     peek-left: [fn [let t]
       [match t
         [case [let _] FingerTree.FTEmpty      [raise "peek-left: empty List"]]
         [case [let p] [FingerTree.FTSingle p] p.value]
         [case [let p] [FingerTree.FTDeep p]   [digit-first p.prefix]]]]
     pop-left:  [fn [let t] [ft-pop-left t]]]]

AppendableList@[doc: "Appendable instance for List: push-right = push-right, peek-right = last element, pop-right = ft-pop-right"]:
  [instance Appendable [let c@[List a] a]:
    [push-right: push-right
     peek-right: [fn [let t]
       [match t
         [case [let _] FingerTree.FTEmpty      [raise "peek-right: empty List"]]
         [case [let p] [FingerTree.FTSingle p] p.value]
         [case [let p] [FingerTree.FTDeep p]   [digit-last p.suffix]]]]
     pop-right:  [fn [let t] [ft-pop-right t]]]]

ConcatenableList@[doc: "Concatenable instance for List: <> = ft-concat, O(log n)"]:
  [instance Concatenable [let c@[List a]]:
    [<>: [fn [let a b] [ft-concat a b]]]]

# ── Indexable typeclass ───────────────────────────────────────────────────────

Indexable@[doc: """
Types supporting O(log n) or better keyed access. Indexable[c k v] means
collection c maps keys of type k to values of type v.

The functional dependency (c, k) → v is required: given the collection type
and key type together, the element type is determined.

Seq has no Indexable instance by design — this is a feature, not an omission.
The type error on [get i seq] tells the caller: "you must collect into a List first."
"""]: .Indexable

IndexableList@[doc: "Indexable instance for List: O(log n) get by Int index, O(1) length."]:
  [instance Indexable [let c@[List a] k@Integer v@a]:
    [get:    [fn [let i t]            [ft-index i t]]
     slice:  [fn [let t start len]    [collect [take len [drop start [ft-to-seq t]]]]]
     length: [fn [let t]              [ft-size t]]]]

IndexableMap@[doc: "Indexable instance for Map: O(1) get by key, O(1) length."]:
  [instance Indexable [let c@[Map k v] k v]:
    [get:    [fn [let k d]            [builtin-dict-get k d]]
     slice:  [fn [let d start len]    d]
     length: [fn [let d]              [builtin-dict-length d]]]]

# ── Indexable[Bytes N, Int, Int] ──────────────────────────────────────────────
# Bytes is a fixed-size byte sequence. O(1) get and slice via builtin-bytes-get /
# builtin-bytes-slice (zero-copy subslice via Rc<[u8]> offset adjustment).
# v = Int (byte value 0..255); UInt8 is a future refinement type once declared in prelude.
IndexableBytes@[doc: """
Indexable instance for Bytes: O(1) random access via builtin-bytes-get and
builtin-bytes-slice. v = Int (byte value 0..255).
"""]:
  [instance Indexable [let c@Bytes k@Integer v@Integer]:
    [get:    [fn [let i b]            [builtin-bytes-get i b]]
     slice:  [fn [let b start len]    [builtin-bytes-slice b start len]]
     length: [fn [let b]              [builtin-bytes-length b]]]]

IndexableDict@[doc: "Indexable instance for Dict: O(1) get by key, O(1) length."]:
  [instance Indexable [let c@Dict k v]:
    [get:    [fn [let k d]          [builtin-dict-get k d]]
     slice:  [fn [let d _start _len] [raise "Dict does not support integer-range slicing"]]
     length: [fn [let d]            [builtin-dict-length d]]]]

# ── Record typeclass ──────────────────────────────────────────────────────────
# Record is an empty typeclass (no methods) with a structural discharge rule:
# only closed dicts (RowTail::Empty — specific known fields, no extras) satisfy it.
# Open dicts (Dict = Uniform) do NOT satisfy Record.
#
# When @Record is used in a parameter annotation, the type checker creates a fresh
# TypeVar constrained by Record. At call sites, the TypeVar is unified with the
# specific closed record type of the argument, preserving field types through
# inference. HasField constraints then enable field-type extraction.
#
# structural: "closed-dict" — the Rust constraint solver checks RowTail::Empty.

Record@[doc: "Typeclass for closed structural records with known fields. @Record creates a fresh TypeVar unified with the caller's specific closed dict type."]:
  [class [let r] structural: "closed-dict"]

# ── Iterable typeclass ────────────────────────────────────────────────────────

Iterable@[doc: """
Typeclass for collections that produce a lazy Seq view via `each`.

Typeclasses in tinct are complexity promises: every method is O(log n) or
better. `each` is O(1) to initiate — it produces a lazy Seq whose elements
are forced on demand.

map, filter, reduce and other O(n) operations are plain prelude functions
that accept Seq — not typeclass methods — because they cannot be O(log n).
To apply them to a List or Map, call each first:

  [filter pred [each my-list]]             # lazy Seq result
  [collect [filter pred [each my-list]]]   # materialized List result
"""]:
  [class [let c a] [determines: [[[c] a]]]
    each: [Fn@[Seq a] [c]]]

IterableList@[doc: "Iterable instance for List: each = ft-to-seq (lazy traversal)"]:
  [instance Iterable
    [let c@[List a] a]:
      [each: [fn [let list] [ft-to-seq list]]]]

IterableMap@[doc: "Iterable instance for Map: each = each-kv (lazy key-value pairs)"]:
  [instance Iterable
    [let c@[Map k v] a]:
      [each: each-kv]]

IterableSeq@[doc: "Iterable instance for Seq: each = identity (a Seq is already a Seq)"]:
  [instance Iterable
    [let c@[Seq a] a]:
      [each: [fn [let xs] xs]]]

each-val@[return: [Seq v]  doc: "Lazy Seq of Map values in insertion order."]:
  [fn@[bind: [k v]  return: [Seq v]] [let d@[Map k v]]
    [map [fn [let k] [builtin-dict-get k d]] [builtin-keys d]]]

# ft-from-seq: O(n) — build a finger tree from a Seq by repeated push-right.
ft-from-seq@[return: [List a]  doc: """
Build a List (finger tree) from a Seq by repeated push-right.

Example: [ft-size [ft-from-seq [range 0 5]]] => 5
"""]:
  [fn@[bind: [a]  return: [List a]] [let xs@[Seq a]]
    [reduce [fn [let tree x] [push-right x tree]] FingerTree.FTEmpty xs]]

# ft-empty: the empty finger tree (List).
ft-empty: FingerTree.FTEmpty

# ============================================================================
# tmpl macro — string interpolation
# ============================================================================
#
# The desugar pass converts i"Hello $name" to [tmpl "Hello $name"].
# tmpl receives a single template string with $name in-band variable markers
# and $$ for literal dollar signs. No extra expression arguments are passed.
#
# Template string encoding:
#   $$    — literal $ escape
#   $name — variable reference (name stops at whitespace, brackets, and common punctuation)
#
# Implementation strategy (split on "$"):
#   1. Split template on "$" → [prefix, piece1, piece2, ...]
#   2. Prefix (piece 0) is always a literal
#   3. For each subsequent piece:
#      - empty string → $$ escape: emit literal "$", skip next piece as literal
#      - otherwise    → $name variable reference: parse ident up to stop char
#   4. Return [quote [str-parts parts...]] for evaluation in the call-site scope

# Stop-character test for variable names in interpolated strings.
# Complement of the allow-list in desugar.rs build_interpolated_string_node:
#   allow = alphanumeric | _ | -
#   stop  = NOT allow (any char that is not alphanumeric, _, or -)
# The allow-list char-code ranges: a-z (97-122), A-Z (65-90), 0-9 (48-57),
# _ (95), - (45). Any codepoint outside these ranges is a stop character.
# This exactly mirrors the desugar pass (D-3 protocol contract).
tmpl-is-stop: [fn [let c]
  [code: [char-code c]]
  [not [or [and [>= code 97] [<= code 122]]
           [or [and [>= code 65] [<= code 90]]
               [or [and [>= code 48] [<= code 57]]
                   [or [= code 95]
                       [= code 45]]]]]]]

# Find the byte-length of the variable name at the start of string s.
# Walks from index i until a stop char is found or end of string.
# Returns i when done (i = number of ident chars consumed).
tmpl-var-len: [fn [let s len i]
  [if [< i len]
    [if [tmpl-is-stop [str-slice s i [+ i 1]]]
      i
      [tmpl-var-len s len [+ i 1]]]
    i]]

# Build a string literal AST Variant node.
tmpl-str-node: [fn [let text]
  [Expr.Literal kind: "str"  value: text  bare: False]]

# Build a var reference AST Variant node.
# KNOWN ISSUE (MH11): VarRef nodes emitted here have synthetic spans.
# Undefined $name variables produce errors pointing to origin (0:0),
# not to the $name position in the template string.
tmpl-var-node: [fn [let var-name]
  [Expr.VarRef name: var-name]]

# Append an optional suffix literal to nodes (only if suffix is non-empty).
# Returns the updated nodes dlist.
tmpl-append-suffix: [fn [let nodes suffix]
  [if [= suffix ""]
    nodes
    [dlist-snoc nodes [tmpl-str-node suffix]]]]

# Process a piece that represents a variable reference ($name).
# Appends the var-node (and optional suffix literal) to nodes.
# Returns the updated nodes list.
tmpl-process-var-piece: [fn [let piece nodes]
  [tmpl-process-var-split piece nodes [length piece]]]

tmpl-process-var-split: [fn [let piece nodes len]
  [tmpl-process-var-emit piece nodes [tmpl-var-len piece len 0] len]]

tmpl-process-var-emit: [fn [let piece nodes var-end len]
  [tmpl-append-suffix
    [dlist-snoc nodes [tmpl-var-node [str-slice piece 0 var-end]]]
    [str-slice piece var-end len]]]

# Accumulator step function for building the tmpl AST node list.
# acc = {nodes: <DList>, skip: False, is-first: True}
#   nodes    — accumulated DList of AST nodes (finalized by dlist-to-seq in tmpl-emit-call)
#   skip     — True after a $$ escape; the next piece is a literal continuation, not a var
#   is-first — True for the first piece (always a literal prefix, not preceded by "$")
#
# Returns the updated accumulator.
tmpl-reduce-step: [fn [let acc piece]
  [if acc.is-first
    # First piece: always a literal prefix (may be empty — skip if so)
    [tmpl-step-literal acc piece]
    [if acc.skip
      # This piece is the literal continuation after a $$ escape (not a var name).
      [tmpl-step-literal acc piece]
      [if [= piece ""]
        # Empty piece = $$ escape: emit literal "$" and mark next piece as skip.
        [nodes: [dlist-snoc acc.nodes [tmpl-str-node "$"]]  skip: True  is-first: False]
        # $name variable reference
        [nodes: [tmpl-process-var-piece piece acc.nodes]  skip: False  is-first: False]
      ]
    ]
  ]
]

# Append piece as a literal to acc.nodes (empty string → skip).
# Returns a new accumulator with is-first=False and skip=False.
tmpl-step-literal: [fn [let acc piece]
  [nodes: [if [= piece ""] acc.nodes [dlist-snoc acc.nodes [tmpl-str-node piece]]]
   skip: False
   is-first: False]]

# Split template string on "$" and fold pieces into AST arg nodes.
tmpl-expand: [fn [let template-str]
  [tmpl-emit-call
    [reduce
      tmpl-reduce-step
      [nodes: dlist-empty  skip: False  is-first: True]
      [split "$" template-str]]]]

# str-parts: variadic helper used by tmpl-generated code to join interpolated string
# fragments. i"Hello $name" expands to [str-parts "Hello " name], and str-parts joins
# all its parts with an empty separator. str is a single-argument Castable wrapper;
# str-parts handles the variadic concatenation that [str a b c] previously performed.
str-parts: [fn@String [let ...parts] [join "" parts]]

# Wrap the collected AST nodes in a [str-parts ...] call Expression.
# Uses quasiquoting: [quote [str-parts [unquote-splice nodes]]] splices all
# accumulated AST nodes as positional args to str-parts, returning a Value::Expression
# directly. result.nodes is a DList (function Seq→Seq); dlist-to-seq finalizes
# it into a lazy Seq accepted by unquote-splice / collect_seq_elements.
tmpl-emit-call: [fn [let result]
  [quote [str-parts [unquote-splice [dlist-to-seq result.nodes]]]]]

# ============================================================================
# [do] macro helpers — AST node builders for monadic do-notation desugaring
# ============================================================================
#
# These helpers build AST dict nodes without ever accessing runtime values.
# All arena-crossing is avoided: we only construct dicts with string/bool
# literals and the AST dicts passed in as macro arguments.
#
# AST node schemas (from src/ast_dict.rs):
#   var-node:        {type: "var",        name: <str>}
#   literal-str:     {type: "literal",    kind: "str", value: <str>, bare: False}
#   dot-access-node: {type: "dot-access", target: <ast>, field: <str>}
#   call-node:       {type: "call",       fn: <ast>, args: <list>, named-args: {}, implied: True}
#   fn-node:         {type: "fn",         params: <list>, body: <ast>, return-ann: {}, desugared: False}
#   param-node:      {name: <str>,        annotation: {}, variadic: False}
#   list (0-elem):   {}
#   list (1-elem):   {0: <item>}
#   list (2-elem):   {0: <item0>, 1: <item1>}

# Build a var-reference AST Variant node.
# Uses p-name (not 'name') to avoid letrec key-shadowing: [name: name] would
# create a circular dependency where the dict's own 'name' key tries to reference itself.
# This is the same pattern used in do-params-1 with 'p-name'.
# do-infer-placeholder: 1 — signals to the type checker (via surface_convert.rs) that this
# VarRef is the do-desugar inferred monad sentinel.  The type checker dispatches on the flag
# instead of the gensym name prefix (protocol §7 in doc/16b-rust-tinct-protocol.md).
do-var-node: [fn [let p-name]
  [Expr.VarRef name: p-name  do-infer-placeholder: 1]]

# Build a single-param list (integer-keyed dict with one entry).
# p-name is a VarRef AST node; pass it as the "name" value.
# The conversion code will extract the actual name string from the VarRef.
do-params-1: [fn [let p-name]
  [0: [name: p-name  annotation: []  variadic: False]]]

# Build a fn AST Variant node: [fn [param-name] body].
# Uses p-name/p-body to avoid letrec key-shadowing of 'params'/'body' keys.
do-fn-node: [fn [let p-name p-body]
  [Expr.Fn params: [do-params-1 p-name]  body: p-body  return-ann: []  desugared: False]]

# Build a dot-access AST Variant node: target.field
# Uses p-target/p-field to avoid letrec key-shadowing of 'target'/'field' keys.
do-access-node: [fn [let p-target p-field]
  [Expr.DotAccess target: p-target  field: p-field]]

# Build a 1-element list (integer-keyed dict).
do-list-1: [fn [let a]
  [0: a]]

# Build a 2-element list (integer-keyed dict).
do-list-2: [fn [let a b]
  [0: a  1: b]]

# Build a call AST Variant node with exactly one positional arg.
do-call-1: [fn [let p-func arg0]
  [Expr.Call fn: p-func  args: [do-list-1 arg0]  named-args: []  implied: True]]

# Build a call AST Variant node with exactly two positional args.
do-call-2: [fn [let func arg0 arg1]
  [Expr.Call fn: func  args: [do-list-2 arg0 arg1]  named-args: []  implied: True]]

# Build an empty dict AST Variant node (represents [] — the unit value for pure).
do-empty-dict-node: [fn [let]
  [Expr.Dict entries: []]]

# Check if a step AST is a binding step (a dict literal with at least one entry).
# A binding step was written as [name: expr] in the do-block.
do-is-binding: [fn [let step]
  [match step [Dict _]: Boolean.True ...: Boolean.False]]

# Check if the first arg looks like an inferred-form step rather than an explicit monad.
# Explicit monad args are Var or DotAccess.
# Inferred form: the first arg is a binding dict or any other expression.
# Returns True if this is the inferred form (no explicit monad given).
do-is-inferred-form: [fn [let first-arg]
  [match first-arg
    [Var _]:       Boolean.False
    [DotAccess _]: Boolean.False
    ...:             Boolean.True]]

# Extract the binding name from a binding step.
# For Value::Expression(Dict): step.entries returns {0: Entry{key, value, span}}.
# The key entry is a Var expression whose "name" field is the binding name.
# Return the VarRef AST node itself; the conversion code will extract the name.
do-binding-name: [fn [let step]
  step.entries.0.key]

# Extract the bound expression AST from a binding step.
do-binding-expr: [fn [let step]
  step.entries.0.value]

# Wrap a single step and the desugared inner expression into a bind call:
#   binding [x: expr]: [monad.bind expr [fn [x] inner]]
#   non-binding expr:  [monad.bind expr [fn [_] inner]]
do-wrap: [fn [let monad-ast step inner]
  [if [do-is-binding step]
    [do-call-2
      [do-access-node monad-ast "bind"]
      [do-binding-expr step]
      [do-fn-node [do-binding-name step] inner]]
    [do-call-2
      [do-access-node monad-ast "bind"]
      step
      [do-fn-node "_" inner]]]]

# Recursively desugar steps (a Dict of AST nodes with integer keys 0..n-1) into nested bind calls.
# Base case: single step remaining — return it as-is.
# Recursive case: wrap first step around the desugaring of the rest.
do-fold: [fn [let monad-ast steps]
  [if [builtin-eq-int [builtin-dict-length steps] 1]
    [get 0 steps]
    [do-wrap monad-ast [get 0 steps] [do-fold monad-ast [collect-dict [each [builtin-drop 1 steps]]]]]]]

# Desugar the inferred [do] form: emit bind chain with unique sentinel monad.
# Called when the first arg is NOT a monad (it's a binding step or other expression).
# All args are steps (passed as an integer-keyed Dict). The type checker detects the
# sentinel, resolves the monad, and wires it to eval.
# Sentinel name uses gensym for uniqueness: `ℊꜱʏᴍ⧼do-infer⧽0`, `ℊꜱʏᴍ⧼do-infer⧽1`, etc.
# This avoids span collision in do_infer_resolutions HashMap (all sentinels
# would share Span::origin() if we used a fixed name).
# Returns: [ℊꜱʏᴍ⧼do-infer⧽N.bind step0 [fn [name] [ℊꜱʏᴍ⧼do-infer⧽N.bind step1 [...]]]] or
#          [ℊꜱʏᴍ⧼do-infer⧽N.bind step0 [fn [name] last-step]] for a 2-step do block.
do-desugar-inferred: [fn [let steps]
  [sentinel: [do-var-node [gensym-with-prefix "do-infer"]]]
  [do-fold sentinel steps]]

# ============================================================================
# Public macro transformer exports (fn@Expr convention — T-1395)
# ============================================================================
#
# Macros are ordinary fn functions whose parameters annotated @Expr receive
# the raw AST (as Expr.* Variant values) rather than evaluated thunks.
# The evaluator automatically injects two implicit named args into any call
# that targets a function with @Expr params:
#   ᴍᴀᴄʀᴏ∷env  — the call-site Value::Environment (gensym-safe name)
#   ᴍᴀᴄʀᴏ∷span — the call-site span dict {file, start-line, ...}
#
# These names contain '∷' (a Unicode character illegal in tinct identifiers),
# so they can only be injected by the Rust runtime and cannot shadow user names.
# bind_args_thunks binds them into the macro function's call_env via BIND-SYSTEM
# (eval_call.rs), making them available to builtin-eval-macro-ast via caller_env.
#
# Each macro body constructs an Expr.* Variant representing the desugared expression,
# then evaluates it in the call-site environment by calling eval-macro-ast.
# Macro function signatures no longer need __call-env__ / __call-span__ params.

# eval-macro-ast: evaluate an Expr.* Variant in the call-site scope.
# Thin wrapper over builtin-eval-macro-ast, which reads ᴍᴀᴄʀᴏ∷env from
# the caller_env environment chain (bound by BIND-SYSTEM when any @Expr function
# was invoked).  Falls back to the immediate caller's env when called outside a
# macro context (useful for testing).
eval-macro-ast@[doc: "Evaluate a macro-produced AST in the call-site scope."]:
  builtin-eval-macro-ast

# tmpl macro transformer: string interpolation i"...$var..." syntax.
# i"..." strings desugar at the desugar pass to [tmpl "raw-template"].
# The raw template encodes $name variable references literally and $$ for literal $.
# tmpl-expand splits on "$", builds Expr.VarRef nodes for $name references,
# and returns [quote [str-parts parts...]] for evaluation in the call-site scope.
#
# template@Expr — Expr.Literal for the raw template string; template.value gives the str
tmpl: [fn [let template@Expr]
  [eval-macro-ast [tmpl-expand template.value]]]

# do macro transformer: monadic do-notation desugaring.
#
# Syntax: [do monad step1 step2 ... final]
#   monad — a var reference or any expression that evaluates to a monad dict
#   steps — zero or more binding steps [name: expr] or expression steps expr
#   final — the last expression (returned from the do block)
#
# Desugaring (right-fold over steps):
#   [do m [x: e1] [y: e2] e3]
#   → [m.bind e1 [fn [x] [m.bind e2 [fn [y] e3]]]]
#
# The macro operates entirely at the AST level: it never accesses the runtime
# monad dict. The dot-access (m.bind, m.pure) is generated as an AST node and
# resolved at evaluation time. This avoids any arena-crossing ThunkId issues.
# Uses typed variadics (first@Expr, ...rest@Expr) — all args must be Expr values.
do: [fn [let first@Expr ...rest@Expr]
  # collect-dict is used here (not collect) because do-fold uses builtin-dict-length/get
  # which require an integer-keyed Dict. rest is already a Dict (variadic arg), but
  # collect-dict is idempotent on Dict inputs: it iterates via each and reindexes.
  [ast: [if [do-is-inferred-form first]
    [do-desugar-inferred [cons first [collect-dict [each rest]]]]
    [if [builtin-eq-int [builtin-dict-length rest] 0]
      [do-call-1
        [do-access-node first "pure"]
        [do-empty-dict-node]]
      [do-fold first rest]]]]
  [eval-macro-ast ast]]

# >>: lazy multi-body in expression position.
# [>> e1 e2 e3] desugars to [call [fn [let] e1 e2 e3]] — an immediately-invoked
# zero-arg lambda. The fn [let] body provides lazy sequential multi-body scoping
# (intermediate dicts create bindings visible to subsequent expressions).
# Note: [[fn ...]] is a dict in tinct (bracket-in-head-position → dict entry);
# [call [fn ...]] is the explicit IIFE form.
# Uses a typed variadic (...body@Expr) with no fallback — all args must be Expr values
# (produced by the macro system when called as [>> e1 e2 e3]).
>>: [fn [let ...body@Expr]
  [eval-macro-ast
    [quote [call [fn [let] [unquote-splice body]]]]]]

# begin is the canonical name for >>; >> is the operator alias.
# Both evaluate expressions left-to-right for side effects and return the last value.
# Inherits the Expr-typed variadic constraint from >>; non-Expr arguments produce a
# runtime exhaustiveness error, not a type coercion.
begin: >>

# task macro transformer: multi-body task support.
# [task e1 e2 e3] desugars to [builtin-task [>> e1 e2 e3]].
# Single-arg [task e] passes through to builtin-task directly.
# Uses typed variadics (...first@Expr, ...rest@Expr) — all args must be Expr values.
task: [fn [let first@Expr ...rest@Expr]
  [ast: [if [empty? rest]
    [quote [builtin-task [unquote first]]]
    [quote [builtin-task [>> [unquote first] [unquote-splice rest]]]]]]
  [eval-macro-ast ast]]

]
