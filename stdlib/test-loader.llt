# stdlib/test-loader.llt
#
# Self-contained corpus test runner — an alternative init program for use with:
#   tinct run --init stdlib/test-loader.llt tests/corpus/eval/*.llt-eval
#
# Receives the same initial environment as loader.llt:
#   %programs  — integer-keyed Dict of ProgramItem variants (one per test file)
#   %args      — CLI flags dict
#   %cwd       — DirCap for working directory
#   %libdir    — DirCap for stdlib

--- stage: "type"
# Type-stage definitions for primitive types available in this init program.
[
  TypeNode: [type
    Int
    String
    Float
    Bytes
    Never
    Top
    Unknown
    Proxy
    AnyFn
    [Dict fields: Any  open: Any  key-type: Any  value-type: Any]
    [TypeConstructor name: Any]
    [TypeApplication ctor: Any  args: Any]]

  Integer: TypeNode.Int
  String:  TypeNode.String
  Float:   TypeNode.Float
  Bytes:   TypeNode.Bytes
  Never:   TypeNode.Never
  Any:     TypeNode.Top
  Unknown: TypeNode.Unknown
  Proxy:   TypeNode.Proxy
  Dict:    [TypeNode.Dict fields: []  open: 1  key-type: TypeNode.Top  value-type: TypeNode.Top]
]

---
#   %stdout    — protocol dict for output (write, flush, close methods)
#
# Test file format (*.llt-eval):
#   <tinct source>
#   === out
#   <expected repr string>
#   === warn          (optional)
#   <expected warning substring>
#
# If === warn is absent, the test asserts zero typecheck warnings.
# If === warn is present, it asserts the substring appears in the joined warnings.
#
# Path-based section enforcement:
#   === warn sections are only permitted in tests under a warnings/ path component.
#   ERROR: output  is only permitted in tests under an errors/ path component.
#   Normal tests (all other paths) must produce clean output with zero warnings.
#
# Each test is run as a two-program pipeline: [test.llt, cli/out/llt.llt]
# with prelude threaded through both — exactly as the CLI does. The formatter
# output is captured via a string-handle replacing %stdout during the run.
#
# Structure — THREE DICTS:
#   Dict 1: private helpers (loader-level builtins only)
#   Dict 2: test pipeline functions (sees Dict 1 + initial env)
#   Dict 3: load prelude, run all tests, write summary to %stdout

# ============================================================================
# Dict 1 — Private helpers (loader-level builtins only)
# ============================================================================

[
  # Boolean declared here so dict 1 helpers can use Boolean.True/False.
  Boolean: [type True False]

  # reduce and join defined here using core builtins only.
  # Dict 1 helpers need these but prelude is not yet loaded.
  _reduce-loop: [fn@[bind: [a]] [let f acc@a xs@Dict i@Integer len@Integer]
    [match [builtin-int-gte i len]
      0: [_reduce-loop f [f acc [builtin-get i xs]] xs [builtin-int-add i 1] len]
      _: acc]]
  reduce: [fn [let f init xs] [_reduce-loop f init xs 0 [builtin-dict-length xs]]]

  _join-loop: [fn [let sep@String acc@String xs@Dict i@Integer len@Integer]
    [match [builtin-int-gte i len]
      0: [_join-loop sep
            [match [builtin-eq-int i 0]
              0: [builtin-string-concat acc [builtin-string-concat sep [builtin-get i xs]]]
              _: [builtin-get 0 xs]]
            xs [builtin-int-add i 1] len]
      _: acc]]
  join: [fn [let sep xs] [_join-loop sep "" xs 0 [builtin-dict-length xs]]]

  # bool->int: Boolean.False→0, Int pass-through, anything else→1.
  bool->int: [fn [let b] [match b Boolean.False: 0 [@Integer _]: b _: 1]]

  # %stdout and %stderr: protocol dicts wrapping the stateless Rust builtins.
  # These MUST be defined here because test-loader runs as --init and main.rs
  # does not inject %stdout/%stderr (that's loader.llt's job for normal runs).
  %stdout: [write:  [fn [let s h] [builtin-write-stdout s h]]
            flush:  [fn [let h] h]
            close:  [fn [let h] h]]
  %stderr: [write:  [fn [let s h] [builtin-write-stderr s h]]
            flush:  [fn [let h] h]
            close:  [fn [let h] h]]

  bytes-empty?: [fn [let b] [builtin-eq-int [builtin-bytes-length b] 0]]

  # null?: test if value is [] (empty dict). Same definition as loader.llt Dict 1.
  null?: [fn [let x]
    [match [builtin-eq-string [builtin-type-of x] "Dict"]
      0: 0
      _: [builtin-eq-int [builtin-dict-length x] 0]]]

  # make-entry: construct single-entry dict from key and value.
  # Defined here for Dict 1 because it runs before prelude is loaded.
  make-entry: [fn [let k v] [$k: v]]

  # get-or: safe dict access with default value
  get-or: [fn [let default key dict]
    [match [builtin-has-key? key dict]
      0: default
      _: [builtin-get key dict]]]

  # _shift-keys: shift all integer keys in dict d by +1.
  # {0: v} → {1: v}, {0: a, 1: b} → {1: a, 2: b}
  # Used by _scope-to-frames-inner to make room for new outermost frame at key 0.
  _shift-keys: [fn [let d@Dict n@Integer i@Integer builder@BuilderHandle]
    [match [builtin-eq-int i n]
      0: [_shift-keys d n [builtin-int-add i 1]
            [builtin-builder-set [builtin-int-add [builtin-dict-key-nth d i] 1]
                                 [builtin-dict-nth d i]
                                 builder]]
      _: [builtin-builder-finish builder]]]

  # scope-to-frames: build frames array from scope-id for builtin-resolve.
  # Walks from innermost to outermost via builtin-scope-parent, prepends each
  # level's names, producing [outermost-names, ..., innermost-names].
  # This matches resolve.rs ordering: initial_frames[0] = outermost.
  _scope-to-frames-inner: [fn [let scope-id@Integer acc@Dict]
    [acc-next: [merge [make-entry 0 [builtin-scope-names scope-id]]
                      [_shift-keys acc [builtin-dict-length acc] 0 [builtin-make-builder]]]]
    [parent: [builtin-scope-parent scope-id]]
    [match [null? parent]
      0: [_scope-to-frames-inner parent acc-next]
      _: acc-next]]
  scope-to-frames: [fn [let scope-id]
    [_scope-to-frames-inner scope-id []]]

  # object-map: map over dict values, preserving keys. Used by scope-to-frames
  # to shift frame indices when prepending a new outermost frame.
  _object-map-step: [fn [let obj@Dict f keys@Dict i@Integer n@Integer builder@BuilderHandle]
    [match [builtin-eq-int i n]
      0: [call [fn [let]
            [k: [builtin-get i keys]]
            [_object-map-step obj f keys [builtin-int-add i 1] n
              [builtin-builder-set k [f k [builtin-get k obj]] builder]]]]
      _: [builtin-builder-finish builder]]]
  object-map: [fn [let obj f]
    [keys: [builtin-keys obj]]
    [_object-map-step obj f keys 0 [builtin-dict-length keys] [builtin-make-builder]]]

  merge: [fn [let a b]
    [_copy: [fn [let builder@BuilderHandle d@Dict n@Integer i@Integer]
      [match [builtin-int-gte i n]
        0: [_copy
              [builtin-builder-set [builtin-dict-key-nth d i] [builtin-dict-nth d i] builder]
              d n [builtin-int-add i 1]]
        _: builder]]]
    [builtin-builder-finish
      [_copy [_copy [builtin-make-builder] a [builtin-dict-length a] 0]
             b [builtin-dict-length b] 0]]]

  read-file: [fn [let handle acc@Bytes]
    [chunk: [builtin-file-read handle 65536]]
    [match [bytes-empty? chunk]
      0: [read-file handle [builtin-bytes-concat acc chunk]]
      _: acc]]

  # make-string-handle: a write handle backed by a builder that accumulates to a string.
  # Uses ONLY core builtins — no prelude functions. Safe in Dict 1 bootstrap context.
  make-string-handle: [fn []
    [buf: [builtin-make-builder]]
    [self:
      [write:  [fn [let s h]
                 [wrote: [builtin-builder-set [builtin-dict-length [builtin-builder-snapshot buf]] s buf]]
                 [match [builtin-int-gt [builtin-dict-length [builtin-builder-snapshot wrote]] -1]
                   0: h
                   _: h]]
       flush:  [fn [let h] h]
       close:  [fn [let h] h]
       read:   [fn []
                 [snap: [builtin-builder-snapshot buf]]
                 [reduce
                   [fn [let acc k] [builtin-string-concat acc [builtin-get k snap]]]
                   ""
                   [builtin-keys snap]]]]]
    self]

  # strip-trailing-newline: remove one trailing \n from a string.
  strip-trailing-newline: [fn [let s]
    [n: [builtin-str-length s]]
    [match [builtin-int-gt n 0]
      0: s
      _: [builtin-str-slice s 0 [builtin-int-sub n 1]]]]

  # Format a single diagnostic dict as a human-readable error line.
  format-diagnostic: [fn [let d]
    [s: d.span]
    [file-part: [match [builtin-eq-int [builtin-dict-length s.file] 0]
      0: [builtin-string-concat s.file ":"]
      _: "<unknown>:"]]
    [loc: [builtin-string-concat file-part [builtin-string-concat [builtin-int->string s.start-line] [builtin-string-concat ":" [builtin-int->string s.start-col]]]]]
    [stack-empty: [builtin-eq-int [builtin-dict-length d.call-stack] 0]]
    [label: [match [builtin-eq-string d.kind "resolve-error"]
              0: [match [builtin-eq-string d.kind "undefined-variable"]
                   0: [match [builtin-eq-string d.kind "user-error"]
                        0: d.kind
                        _: "error"]
                   _: [match stack-empty
                        0: "runtime"
                        _: "resolve"]]
              _: "resolve"]]
    [base-line: [builtin-string-concat loc [builtin-string-concat ": " [builtin-string-concat label [builtin-string-concat ": " [builtin-string-concat d.message "\n"]]]]]]
    [notes-empty: [builtin-eq-int [builtin-dict-length d.notes] 0]]
    [with-notes: [match notes-empty
      0: [reduce
            [fn [let acc note] [builtin-string-concat acc [builtin-string-concat note "\n"]]]
            base-line
            d.notes]
      _: base-line]]
    [match stack-empty
      0: [reduce
            [fn [let acc frame]
              [frame-file: [match [builtin-eq-int [builtin-dict-length frame.span.file] 0]
                0: [builtin-string-concat frame.span.file ":"]
                _: ""]]
              [builtin-string-concat acc [builtin-string-concat "  in " [builtin-string-concat frame.label [builtin-string-concat " at " [builtin-string-concat frame-file [builtin-string-concat [builtin-int->string frame.span.start-line] [builtin-string-concat ":" [builtin-string-concat [builtin-int->string frame.span.start-col] "\n"]]]]]]]]]
            with-notes
            d.call-stack]
      _: with-notes]]

  # _emit-loop: index-based recursion that writes each diagnostic and returns the
  # count of items written. The count is USED by callers (in n-total) so it is on
  # the materialization path — this is what forces all the writes.
  # Each iteration: write d_i, use the write result's length (always >= 0) as proof
  # the write happened, add 1 to the running count.
  _emit-loop: [fn@Integer [let diags@Dict i@Integer len@Integer acc@Integer]
    [match [builtin-int-gte i len]
      0: [_emit-loop diags [builtin-int-add i 1] len
            [builtin-int-add acc
              [builtin-int-gte
                [builtin-dict-length [%stderr.write [format-diagnostic [builtin-get i diags]] %stderr]]
                0]]]
      _: acc]]

  # emit-diagnostics: write all diagnostics to stderr, return the count written.
  # Returns 0 for empty (n + _e = 0 iff both are zero — no errors and no writes).
  emit-diagnostics: [fn [let diagnostics]
    [_emit-loop diagnostics 0 [builtin-dict-length diagnostics] 0]]

  # uses-scope: for each module name, parse+typecheck its declaration file and
  # accumulate a flat Dict of runtime builtin implementations.
  # Declaration files (builtin_NAME.llt) are optional — if absent, builtin-try
  # catches the error. Typecheck is forced via typed.warnings data dependency (no >>).
  # seed-tc: the TypeContext to use for all module type-checks.
  # seed-scope-id: the parent scope to use for declaration file scopes.
  # Caller builds it explicitly — no implicit global fallback. This is the same
  # pattern as the init program controlling what environments downstream sees.
  uses-scope: [fn [let module-names seed-tc seed-scope-id]
    [reduce
      [fn [let acc name]
        [decl-path:   [builtin-string-concat "builtin_" [builtin-string-concat name ".llt"]]
         tc-result:   [builtin-try [call [fn []
             [decl-handle:    [builtin-file-open %libdir decl-path "read"]]
             [decl-bytes:     [read-file decl-handle [builtin-bytes]]]
             [parse-result:   [builtin-parse decl-bytes decl-path]]
             [desugared:      [builtin-desugar parse-result.program]]
             [decl-docs:      [builtin-program-docs desugared]]
             # Seed scope with field-get/slot-get builtins for dot-access
             [decl-scope-id:  [builtin-scope-new seed-scope-id [field-get: .field-get  slot-get: .slot-get]]]
             [resolve-errors: [reduce
               [fn [let acc doc]
                 [frames: [scope-to-frames decl-scope-id]]
                 [r: [builtin-resolve doc frames]]
                 [builtin-int-add acc [builtin-dict-length r.errors]]]
               0
               decl-docs]]
             [typed-docs:  [reduce
               [fn [let acc doc]
                 [frames: [scope-to-frames decl-scope-id]]
                 [r: [builtin-resolve doc frames]]
                 [tc-result: [builtin-typecheck-doc r.doc seed-tc]]
                 [merge acc [make-entry [builtin-dict-length acc] tc-result]]]
               []
               decl-docs]]
             [warnings: [reduce
               [fn [let acc tdoc] [merge acc tdoc.warnings]]
               []
               typed-docs]]
             [match [builtin-eq-int resolve-errors 0]
               0: warnings
               _: warnings]]]]
         warnings:    [match [builtin-has-key? "ok" tc-result]
             0: []
             _: [builtin-get "ok" tc-result]]
         n-w:         [emit-diagnostics warnings]
         module-impl: [builtin-module name]]
        # n-w (count of warnings written) is the condition — forces all writes before merge.
        [match [builtin-int-gte n-w 0]
          0: [merge acc module-impl]
          _: [merge acc module-impl]]]
      []
      module-names]]

  # Discover the root scope-id: the only scope with a null parent in builtin-scopes.
  # Mirrors the loader.llt pattern — no hardcoded scope IDs.
  _all-scopes: [builtin-scopes]
  _root-scope-entries: [reduce
    [fn [let acc entry]
      [scope-id: [builtin-get 0 entry]]
      [parent:   [builtin-get 1 entry]]
      [match [null? parent]
        0: [merge acc [make-entry [builtin-dict-length acc] scope-id]]
        _: acc]]
    []
    [reduce
      [fn [let acc k]
        [merge acc [make-entry [builtin-dict-length acc] [0: k  1: [builtin-get k _all-scopes]]]]]
      []
      [builtin-keys _all-scopes]]]
  root-scope-id: [builtin-get 0 _root-scope-entries]

  # Fundamental-types TypeContext: start from an empty TypeContext and populate
  # it by type-checking builtin_core.llt. Same pattern as loader.llt — no
  # implicit Rust back-channel. Core types (DirCap, Int, Bytes, etc.) are
  # available to all downstream builtin-typecheck calls via this explicit seed.
  _fundamental-base-tc: [builtin-make-type-ctx]
  fundamental-tc: [match [builtin-int-gte [builtin-dict-length [uses-scope ["core"] _fundamental-base-tc root-scope-id]] 0]
    0: _fundamental-base-tc
    _: _fundamental-base-tc]

  # ── Pipeline infrastructure ──────────────────────────────────────────────────
  # if-ok: pipeline combinator. Used as [prev-state | [if-ok f pre-args...]].
  # The | operator appends prev-state as the last positional arg, so if-ok receives
  # [f pre-arg0 ... pre-argN state] all variadic in ...args. State is always last.
  # Calls [f pre-arg0 ... pre-argN state] when state.errors is empty; passes state
  # through unchanged on failure. Supports 0, 1, or 2 pre-args before state.
  if-ok: [fn [let f ...args]
    [n:     [builtin-dict-length args]]
    [state: [builtin-dict-nth args [builtin-int-sub n 1]]]
    [match [builtin-eq-int [builtin-dict-length state.errors] 0]
      0: state
      _: [match [builtin-int-sub n 1]
           0: [f state]
           1: [f [builtin-dict-nth args 0] state]
           2: [f [builtin-dict-nth args 0] [builtin-dict-nth args 1] state]
           _: [builtin-raise "if-ok: only 0, 1, or 2 pre-args supported"]]]]

  # ── Stage: load-bytes ─────────────────────────────────────────────────────────
  # Opens state.path under cap and reads all bytes. Logs path to stderr.
  load-bytes: [fn [let cap state]
    [_log: [%stderr.write [builtin-string-concat "loading: " [builtin-string-concat state.path "\n"]] %stderr]]
    [handle: [match [builtin-int-gte [builtin-dict-length _log] 0]
      0: [builtin-file-open cap state.path "read"]
      _: [builtin-file-open cap state.path "read"]]]
    [merge state [bytes: [read-file handle [builtin-bytes]]]]]

  # ── Stage: load-from-string ───────────────────────────────────────────────────
  # Converts a source string to bytes in state (for test programs, not files).
  load-from-string: [fn [let source state]
    [merge state [bytes: [builtin-str-bytes source]]]]

  # ── Stage: parse-source ───────────────────────────────────────────────────────
  # Parses state.bytes into state.parsed and desugars the program.
  # On parse errors: emits diagnostics and sets state.errors (as an error-message string).
  parse-source: [fn [let state]
    [r:  [builtin-parse state.bytes state.path]]
    [n:  [builtin-dict-length r.errors]]
    [_e: [emit-diagnostics r.errors]]
    [match [builtin-eq-int [builtin-int-add n _e] 0]
      0: [merge state [errors: [make-entry 0
            [reduce [fn [let acc d] [builtin-string-concat acc [format-diagnostic d]]]
                    "" r.errors]]]]
      _: [call [fn [let]
           [desugared: [builtin-desugar r.program]]
           [docs: [builtin-program-docs desugared]]
           [merge state [parsed: [program: r.program  documents: docs]]]]]]]

  # ── Stage: eval-program ───────────────────────────────────────────────────────
  # Two-pass eval on state.parsed: type-stage documents first, then runtime.
  # Uses new thin meta API: builtin-scope-new, builtin-doc-meta, builtin-typecheck-doc.
  # Resolve and eval errors raise immediately — a broken program cannot be loaded.
  # Adds: scope-id, last-result, _tc.
  eval-program: [fn [let extras tc state]
    [seed-scope-id: [builtin-scope-new root-scope-id
      [merge extras [field-get: .field-get  slot-get: .slot-get]]]]
    [ts-seed: [builtin-scope-new seed-scope-id
      [Boolean: Boolean  True: Boolean.True  False: Boolean.False]]]
    [eval-doc: [fn [let acc doc]
      [meta:    [builtin-doc-meta doc acc.scope-id]]
      [uses:    [uses-scope [get-or [] "uses" meta] acc.tc acc.scope-id]]
      [scope:   [builtin-scope-new acc.scope-id uses]]
      [frames:  [scope-to-frames scope]]
      [res:     [builtin-resolve doc frames]]
      [n-re:    [builtin-dict-length res.errors]]
      [_re:     [emit-diagnostics res.errors]]
      [match [builtin-eq-int [builtin-int-add n-re _re] 0]
        0: [builtin-raise [reduce [fn [let acc d] [builtin-string-concat acc [format-diagnostic d]]]
                                  "" res.errors]]
        _: [call [fn [let]
             [tc-result: [builtin-typecheck-doc res.doc acc.tc]]
             [typed:     tc-result.doc]
             [ev:        [builtin-eval typed scope]]
             [match [null? ev.errors]
               0: [builtin-raise [builtin-get 0 ev.errors]]
               _: [call [fn [let]
                    [doc-name: [get-or "" "name" meta]]
                    [next-scope: [builtin-scope-new ev.scope-id
                                   [match [builtin-eq-string doc-name ""]
                                     0: [%: ev.result]
                                     _: [make-entry doc-name ev.result]]]]
                    [merge acc [scope-id: next-scope  tc: acc.tc  last-result: ev.result]]]]]]]]]]
    # Split documents by stage: check meta.stage string (not doc.stage tag)
    [split: [reduce
      [fn [let acc doc]
        [meta: [builtin-doc-meta doc ts-seed]]
        [stage: [get-or "runtime" "stage" meta]]
        [match [builtin-eq-string stage "type"]
          0: [ts: [merge acc.ts [make-entry [builtin-dict-length acc.ts] doc]]  rt: acc.rt]
          _: [ts: acc.ts  rt: [merge acc.rt [make-entry [builtin-dict-length acc.rt] doc]]]]]
      [ts: []  rt: []]
      state.parsed.documents]]
    # Pass 1: evaluate type-stage documents
    [ts-acc: [reduce eval-doc [scope-id: ts-seed  tc: tc  last-result: []] split.ts]]
    # Wire ts scope-id into the TypeContext
    [_tc: [builtin-tc-with-scope ts-acc.tc ts-acc.scope-id]]
    # Pass 2: evaluate runtime documents
    [final-acc: [reduce eval-doc [scope-id: ts-acc.scope-id  tc: _tc  last-result: []] split.rt]]
    # final-acc tracks last-result from the most recent eval-doc call
    [merge state
      [scope-id:    final-acc.scope-id
       last-result: final-acc.last-result
       _tc:         _tc]]]

  # ── Stage: export ─────────────────────────────────────────────────────────────
  # Promotes the last document's exported dict entries into the env.
  # Adds: full-scope-id.
  export: [fn [let state]
    [exported: [match [builtin-eq-string [builtin-type-of state.last-result] "Dict"]
      0: []
      _: state.last-result]]
    [merge state [full-scope-id: [builtin-scope-new state.scope-id exported]]]]

  # ── Stage: typecheck-program ──────────────────────────────────────────────────
  # Typechecks each document in state.parsed.documents using state._tc.
  # Uses builtin-typecheck-doc (per-document API).
  # Adds: tc-warnings.
  typecheck-program: [fn [let state]
    [typed-docs: [reduce
      [fn [let acc doc]
        [frames: [scope-to-frames state.scope-id]]
        [res: [builtin-resolve doc frames]]
        [typed: [builtin-typecheck-doc res.doc state._tc]]
        [merge acc [make-entry [builtin-dict-length acc] typed]]]
      []
      state.parsed.documents]]
    [all-warnings: [reduce
      [fn [let acc tdoc]
        [reduce
          [fn [let wacc w] [merge wacc [make-entry [builtin-dict-length wacc] w]]]
          acc
          tdoc.warnings]]
      []
      typed-docs]]
    [_e: [emit-diagnostics all-warnings]]
    [match [builtin-int-gte _e 0]
      0: [merge state [tc-warnings: all-warnings]]
      _: [merge state [tc-warnings: all-warnings]]]]
]

# ============================================================================
# Dict 2 — Test runner functions
# ============================================================================
# Closures here capture Dict 1 + initial env. Prelude-specific names are
# passed as parameters so that tests run with the full prelude in scope.

[
  Boolean: [type True False]

  ProgramItem: [type
    [File path: String  handle: File]
    [Expr src:  String]
  ]

  Result: [type [let a] [Ok a] [Error String]]

  write-str: [fn [let h s] [h.write s]]

  # extract-source: given file content, return everything before "\n=== ".
  extract-source: [fn [let content]
    [sep-pos: [builtin-str-index-of "\n=== " content]]
    [match [builtin-eq-int sep-pos -1]
      0: [builtin-str-slice content 0 sep-pos]
      _: content]]

  section-strip-nl: [fn [let sv sl]
    [match [builtin-eq-int sl 0]
      0: [match [builtin-eq-string [builtin-str-slice sv [builtin-int-add sl -1] sl] "\n"]
           0: sv
           _: [builtin-str-slice sv 0 [builtin-int-add sl -1]]]
      _: sv]]

  section-cut-at: [fn [let sv si]
    [match [builtin-eq-int si -1]
      0: [builtin-str-slice sv 0 si]
      _: sv]]

  section-trim: [fn [let bt]
    [section-strip-nl
      [section-cut-at bt [builtin-str-index-of "\n=== " bt]]
      [builtin-str-length [section-cut-at bt [builtin-str-index-of "\n=== " bt]]]]]

  extract-section: [fn [let content label]
    [sep: [join "" ["\n=== " label "\n"]]]
    [match [builtin-eq-int [builtin-str-index-of sep content] -1]
      0: [section-trim
            [builtin-str-slice
              content
              [builtin-int-add
                [builtin-str-index-of sep content]
                [builtin-str-length sep]]
              [builtin-str-length content]]]
      _: ""]]

  # ── Test pipeline stages ──────────────────────────────────────────────────────
  # These operate on the same state dict as the prelude pipeline stages (if-ok,
  # load-from-string, parse-source from Dict 1) but are test-specific:
  # eval-docs uses builtin-try to capture errors as data rather than raises,
  # manages the per-test arena, and handles caps/expects validation.

  # eval-docs: resolve+eval all documents against base-scope.
  # Errors are captured into state.errors (String) rather than propagated as raises.
  # Adds: scope-id, last-result, program.
  eval-docs: [fn [let base-scope state]
    [try-result: [builtin-try [call [fn []
      [test-state: [reduce
        [fn [let st doc]
          [meta:  [builtin-doc-meta doc st.scope-id]]
          [uses:  [uses-scope [get-or [] "uses" meta] fundamental-tc st.scope-id]]
          [scope: [builtin-scope-new st.scope-id uses]]
          [frames: [scope-to-frames scope]]
          [r:     [builtin-resolve doc frames]]
          [n-re:  [builtin-dict-length r.errors]]
          [_re:   [emit-diagnostics r.errors]]
          [match [builtin-eq-int [builtin-int-add n-re _re] 0]
            0: [builtin-raise [reduce [fn [let acc d] [builtin-string-concat acc [format-diagnostic d]]]
                                      "" r.errors]]
            _: [call [fn [let]
                 [typed: [builtin-typecheck-doc r.doc st.tc]]
                 [ev:    [builtin-eval typed scope]]
                 [match [null? ev.errors]
                   0: [builtin-raise [builtin-get 0 ev.errors]]
                   _: [call [fn [let]
                        # T-1507: Validate --- caps: declarations against the evaluated scope.
                        [caps-list: [get-or [] "caps" meta]]
                        [_caps-ok: [reduce [fn [let _ cap-name]
                          [match [builtin-cap-env-has? cap-name scope]
                            Boolean.False: [builtin-raise [builtin-string-concat "missing required capability: " cap-name]]
                            _: 0]]
                          0 [builtin-keys caps-list]]]
                        # T-1506: Validate --- expects: type annotation against the document result.
                        # builtin-check-type raises on mismatch; passes return the value unchanged.
                        [expects: [get-or [] "expects" meta]]
                        [_expects-forced: [match [builtin-eq-int [builtin-dict-length expects] 0]
                          0: [builtin-int-gte [builtin-dict-length [builtin-type-of [builtin-check-type expects ev.result]]] _caps-ok]
                          _: _caps-ok]]
                        [match [builtin-int-gte _expects-forced 0]
                          0: [scope-id: ev.scope-id  last-result: ev.result  tc: st.tc]
                          _: [scope-id: ev.scope-id  last-result: ev.result  tc: st.tc]]]]]]]]]
        [scope-id: base-scope  last-result: []  tc: fundamental-tc]
        state.parsed.documents]]
      [scope-id:   test-state.scope-id
       last-result: test-state.last-result
       tc:         test-state.tc
       documents:  state.parsed.documents]]]]]
    [match [builtin-has-key? "ok" try-result]
      0: [merge state [errors: [make-entry 0 [builtin-get "error" try-result]]]]
      _: [merge state
           [scope-id:   [builtin-get "ok" try-result].scope-id
            last-result: [builtin-get "ok" try-result].last-result
            tc:         [builtin-get "ok" try-result].tc
            documents:  state.parsed.documents]]]]

  # typecheck-docs: typecheck state.documents against base-scope.
  # Adds: tc-warnings.
  typecheck-docs: [fn [let tc base-scope state]
    [typed-docs: [match [builtin-int-gte [builtin-dict-length [builtin-type-of state.scope-id]] 0]
      0: []
      _: [reduce
           [fn [let acc doc]
             [frames: [scope-to-frames state.scope-id]]
             [res: [builtin-resolve doc frames]]
             [typed: [builtin-typecheck-doc res.doc tc]]
             [merge acc [make-entry [builtin-dict-length acc] typed]]]
           []
           state.documents]]]
    [all-warnings: [reduce
      [fn [let acc tdoc]
        [reduce
          [fn [let wacc w] [merge wacc [make-entry [builtin-dict-length wacc] w]]]
          acc
          tdoc.warnings]]
      []
      typed-docs]]
    [_e: [emit-diagnostics all-warnings]]
    [match [builtin-int-gte _e 0]
      0: [merge state [tc-warnings: all-warnings]]
      _: [merge state [tc-warnings: all-warnings]]]]

  # format-output: format state.last-result into state.output using builtin-llt-repr.
  format-output: [fn [let state]
    [merge state [output: [builtin-string-concat [builtin-llt-repr state.last-result] "\n"]]]]

  # run-test-pipeline: evaluate a test source string through the full pipeline.
  # Returns a state dict with output and tc-warnings on success, or errors on failure.
  # No builtin-try at this level — eval-docs captures errors as data internally.
  run-test-pipeline: [fn [let source path prelude-scope-id]
    [capture: [make-string-handle]]
    [base-scope-id: [builtin-scope-new prelude-scope-id
                      [%cwd:    %cwd
                       %libdir: %libdir
                       %stdout: capture
                       %stderr: %stderr
                       %args:   %args]]]
    [[path: path  errors: []]
     | [if-ok load-from-string source]
     | [if-ok parse-source]
     | [if-ok eval-docs base-scope-id]
     | [if-ok typecheck-docs fundamental-tc base-scope-id]
     | [if-ok format-output]]]

  # path-has-component: true if path contains "/component/" as a path segment.
  path-has-component: [fn [let path component]
    [match [builtin-eq-int [builtin-str-index-of [join "" ["/" component "/"] ] path] -1]
      0: Boolean.True
      _: Boolean.False]]

  # check-path-sections: enforce that warn/error sections only appear in
  # appropriately named directories.
  check-path-sections: [fn [let path expected-warn expected-error actual-out]
    [in-warnings: [path-has-component path "warnings"]]
    [in-errors:   [path-has-component path "errors"]]
    [warn-ok: [match [builtin-eq-string expected-warn ""]
                0: in-warnings
                _: Boolean.True]]
    [error-ok: [match [builtin-eq-string expected-error ""]
                  0: in-errors
                  _: [match [builtin-eq-int [builtin-str-index-of "ERROR:" actual-out] 0]
                       0: Boolean.True
                       _: in-errors]]]
    [match [bool->int warn-ok]
      0: [join "" ["=== warn section not allowed outside warnings/ directory: " path]]
      _: [match [bool->int error-ok]
           0: [match [builtin-eq-string expected-error ""]
                0: [join "" ["=== error section not allowed outside errors/ directory: " path]]
                _: [join "" ["ERROR: output not allowed outside errors/ directory: " path]]]
           _: ""]]]

  # check-warn: validate typecheck warnings against the expected-warn section.
  check-warn: [fn [let warnings expected-warn]
    [warn-count: [builtin-dict-length warnings]]
    [warn-text: [reduce
      [fn [let acc w] [builtin-string-concat acc [builtin-string-concat [match [builtin-eq-string acc ""]
                                                                           0: "\n"
                                                                           _: ""] w.message]]]
      ""
      warnings]]
    [match [builtin-eq-string expected-warn ""]
      0: [match [builtin-eq-int [builtin-str-index-of expected-warn warn-text] -1]
           0: ""
           _: [join "" ["expected warning not found:\n  " expected-warn "\nactual:\n  " warn-text]]]
      _: [match [builtin-eq-int warn-count 0]
           0: [join "" ["expected no warnings, got:\n" warn-text]]
           _: ""]]]

  # run-test-file: execute a single file ProgramItem as a corpus test.
  run-test-file: [fn [let p prelude-scope-id]
    [bytes:          [read-file p.handle [builtin-bytes]]]
    [content:        [builtin-bytes-str bytes]]
    [source:         [extract-source content]]
    [expected-out:   [extract-section content "out"]]
    [expected-warn:  [extract-section content "warn"]]
    [expected-error: [extract-section content "error"]]

    # Run test through the pipeline. Errors are returned as state.errors (no builtin-try needed).
    [pipe-result: [run-test-pipeline source p.path prelude-scope-id]]

    [try-ok: [builtin-eq-int [builtin-dict-length pipe-result.errors] 0]]

    # Extract the formatter output or an ERROR: prefix.
    [raw-output: [match try-ok
        0: [builtin-string-concat "ERROR: " pipe-result.errors.0]
        _: pipe-result.output]]

    # Strip trailing newline from formatter output (formatters add a final \n).
    [actual: [match try-ok
        0: raw-output
        _: [strip-trailing-newline raw-output]]]

    [eval-warnings: [match try-ok 0: [] _: pipe-result.tc-warnings]]

    # === error: substring match; === out: exact match
    [out-passed: [match [builtin-eq-string expected-error ""]
                   0: [match [builtin-eq-int [builtin-str-index-of expected-error actual] -1]
                        0: 1
                        _: 0]
                   _: [builtin-eq-string actual expected-out]]]

    [path-fail: [check-path-sections p.path expected-warn expected-error actual]]
    [path-passed: [builtin-eq-string path-fail ""]]

    [warn-fail: [match try-ok
      0: ""
      _: [check-warn eval-warnings expected-warn]]]
    [warn-passed: [builtin-eq-string warn-fail ""]]

    [r-path:    p.path]
    [r-passed:  [match out-passed
      0: 0
      _: [match warn-passed
           0: 0
           _: path-passed]]]
    [r-actual:  [match path-passed
                  0: [join "" ["out: " actual "\npath: " path-fail]]
                  _: [join "" [
                       [match out-passed
                         0: [join "" ["out: "  actual    "\n"]]
                         _: ""]
                       [match warn-passed
                         0: [join "" ["warn: " warn-fail "\n"]]
                         _: ""]]]]]
    [r-expected: [match path-passed
                   0: [join "" ["out: "
                         [match [builtin-eq-string expected-error ""]
                           0: expected-error
                           _: expected-out]]]
                   _: [join "" [
                        [match out-passed
                          0: [join "" ["out: "
                               [match [builtin-eq-string expected-error ""]
                                 0: expected-error
                                 _: expected-out]
                               "\n"]]
                          _: ""]
                        [match warn-passed
                          0: [join "" ["warn: " expected-warn "\n"]]
                          _: ""]]]]]
    [path: r-path  passed: r-passed  actual: r-actual  expected: r-expected]]

  # run-test: run one ProgramItem as a corpus test.
  run-test: [fn [let item prelude-scope-id]
    [p:    [match [builtin-eq-string [builtin-tag-of item] "ProgramItem.File"]
             0: item.path
             _: "<expr>"]]
    [_log: [%stderr.write [builtin-string-concat "test:    " [builtin-string-concat p "\n"]] %stderr]]
    [match [builtin-int-gte [builtin-dict-length _log] 0]
      0: [match item
           [ProgramItem.File _]: [run-test-file item prelude-scope-id]
           [ProgramItem.Expr _]: [path: "<expr>"  passed: Boolean.True  actual: ""  expected: ""]]
      _: [match item
           [ProgramItem.File _]: [run-test-file item prelude-scope-id]
           [ProgramItem.Expr _]: [path: "<expr>"  passed: Boolean.True  actual: ""  expected: ""]]]]

  # format-result: render test outcome line.
  format-result: [fn [let r]
    [builtin-string-concat r.path
      [builtin-string-concat " ... "
        [match [bool->int r.passed]
          0: [builtin-string-concat "FAIL\n"
               [builtin-string-concat "  expected: "
                 [builtin-string-concat r.expected
                   [builtin-string-concat "\n  actual:   "
                     [builtin-string-concat r.actual "\n"]]]]]
          _: "pass\n"]]]]

  # check-llt-eval: true if a filename ends with ".llt-eval".
  check-llt-eval: [fn [let name]
    [len: [builtin-str-length name]]
    [match [builtin-lt len 9]
      0: [builtin-eq-string [builtin-str-slice name [builtin-int-sub len 9] len] ".llt-eval"]
      _: 0]]

  # find-corpus-files: recursively walk cap/dir-path, accumulate .llt-eval files.
  find-corpus-files: [fn@Dict [let cap dir-path state@Dict]
    [entries: [builtin-list-dir cap dir-path]]
    [reduce
      [fn [let st entry]
        [full: [join "" [$dir-path "/" entry.name]]]
        [match [builtin-eq-string entry.type "dir"]
          0: [match [check-llt-eval entry.name]
               0: st
               _: [merge st [make-entry [builtin-dict-length st] [ProgramItem.File path: full  handle: [builtin-file-open cap full "read"]]]]]
          _: [find-corpus-files cap full st]]]
      state
      entries]]
]

# ============================================================================
# Dict 3 — Load prelude, pre-parse formatter, run tests
# ============================================================================

[
  # Prelude loading pipeline. Each stage short-circuits via if-ok when errors is non-empty.
  # %prelude is a lazy forward reference to _prelude — safe because prelude captures it in
  # closures but never forces it during its own loading (only at user call-time).
  _prelude-result: [[path: "prelude.llt"  errors: []]
    | [if-ok load-bytes %libdir]
    | [if-ok parse-source]
    | [if-ok eval-program
        [%prelude: _prelude  Boolean: Boolean  True: True  False: False]
        fundamental-tc]
    | [if-ok export]
    | [if-ok typecheck-program]]

  # _prelude-scope-id: pre-export scope-id used as display-chain seed for test programs.
  _prelude-scope-id: _prelude-result.scope-id

  # Fatal boundary: typecheck warnings on prelude mean execution is undefined behavior.
  # Raise here (outside any builtin-try) so the error propagates to the top level.
  _prelude: [match [builtin-eq-int [builtin-int-add
                                      [builtin-dict-length _prelude-result.errors]
                                      [builtin-dict-length _prelude-result.tc-warnings]] 0]
    0: [builtin-raise [join "" ["prelude failed — cannot continue\n"
          [reduce [fn [let acc d] [builtin-string-concat acc [builtin-string-concat d "\n"]]]
                  "" _prelude-result.errors]]]]
    _: _prelude-result.full-scope-id]

  _prelude-ok: [builtin-int-gte [builtin-dict-length [builtin-type-of _prelude]] 0]

  # Pre-parse cli/out/llt.llt once (parse only — NOT resolved).
  # Resolution happens per-test inside run-test-pipeline with fmt-env
  # (prelude + % = test result + capture stdout), exactly as the CLI does.
  _llt-formatter-expanded: [call [fn []
    [parse-result:  [builtin-parse
                      [read-file [builtin-file-open %libdir "cli/out/llt.llt" "read"] [builtin-bytes]]
                      "cli/out/llt.llt"]]
    # Emit parse errors as a data dependency (no >> needed).
    [_pe:           [emit-diagnostics parse-result.errors]]
    [match [builtin-int-gte _pe 0]
      0: parse-result.program
      _: parse-result.program]]]

  # Bootstrap check: verify the formatter loaded correctly.
  # On failure, print the actual error from builtin-try and raise — never silently swallow it.
  _formatter-ok: [call [fn [let _raw]
      [match [builtin-has-key? "ok" _raw]
        0: [call [fn [let _w]
                    [match [builtin-int-gte [builtin-dict-length _w] 0]
                      0: [builtin-raise "llt.llt formatter failed to load"]
                      _: [builtin-raise "llt.llt formatter failed to load"]]]
              [%stderr.write
                [builtin-string-concat "\nbootstrap error: llt.llt formatter failed to load\nCannot run corpus tests.\nCause: "
                  [builtin-string-concat
                    [match [builtin-has-key? "error" _raw]
                      0: "(unknown — try result has no error field)"
                      _: _raw.error]
                    "\n"]] %stderr]]
        _: 1]]
    [builtin-try [builtin-program-docs _llt-formatter-expanded]]]

  # Discover test files (or use the ones given on the command line).
  # _prelude-ok is a data dependency.
  test-programs: [match [builtin-eq-int [builtin-int-add _formatter-ok _prelude-ok] 2]
    0: []
    _: [match [builtin-eq-int [builtin-dict-length %programs] 0]
         0: %programs
         _: [find-corpus-files
               [builtin-narrow %cwd "tests/corpus"]
               "."
               []]]]

  final-state: [reduce
    [fn [let state item]
      [result: [run-test item _prelude-scope-id]]
      # Force the write as a data dependency (no >> needed).
      # %stdout.write returns the handle (%stdout protocol dict).
      # Force it by reading the handle's key count (always >= 0).
      [wrote: [%stdout.write [format-result result] %stdout]]
      [match [builtin-int-gte [builtin-dict-length wrote] 0]
        0: [idx:    [builtin-int-add state.idx 1]
             total:  [builtin-int-add state.total 1]
             passed: state.passed
             first-fail: state.first-fail]
        _: [idx:    [builtin-int-add state.idx 1]
             total:  [builtin-int-add state.total 1]
             passed: [match [bool->int result.passed]
                        0: state.passed
                        _: [builtin-int-add state.passed 1]]
             first-fail: [match [builtin-eq-string state.first-fail ""]
                            0: state.first-fail
                            _: [match [bool->int result.passed]
                                 0: [builtin-string-concat result.path [builtin-string-concat "\n  expected: " [builtin-string-concat result.expected [builtin-string-concat "\n  actual:   " result.actual]]]]
                                 _: ""]]]]]
    [idx: 0  total: 0  passed: 0  first-fail: ""]
    test-programs]
]

# ============================================================================
# Final expression — summary + exit code
# ============================================================================

[wrote: [%stdout.write [join "" [
    "\n"
    [builtin-int->string final-state.passed] "/" [builtin-int->string final-state.total] " tests passed"
    [match [builtin-eq-int final-state.passed final-state.total]
      0: [join "" [", " [builtin-int->string [builtin-int-sub final-state.total final-state.passed]] " failed\n"]]
      _: "\n"]]]
  %stdout]]
[match [builtin-int-gte [builtin-dict-length wrote] 0]
  0: []
  _: [match [builtin-eq-int final-state.passed final-state.total]
       0: [builtin-raise [join "" [
             [builtin-int->string [builtin-int-sub final-state.total final-state.passed]] " test(s) failed\n"
             final-state.first-fail]]]
       _: []]]
