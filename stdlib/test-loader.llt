# stdlib/test-loader.llt
#
# Self-contained corpus test runner — an alternative init program for use with:
#   tinct run --init stdlib/test-loader.llt tests/corpus/eval/*.llt-eval
#
# Receives the same initial environment as loader.llt:
#   %programs  — integer-keyed Dict of ProgramItem variants (one per test file)
#   %args      — CLI flags dict
#   %cwd       — DirCap for working directory
#   %libdir    — DirCap for stdlib
#   %stdout    — protocol dict for output (write, flush, close methods)
#
# Test file format (*.llt-eval):
#   <tinct source>
#   === out
#   <expected repr string>
#   === warn          (optional)
#   <expected warning substring>
#
# If === warn is absent, the test asserts zero typecheck warnings.
# If === warn is present, it asserts the substring appears in the joined warnings.
#
# Path-based section enforcement:
#   === warn sections are only permitted in tests under a warnings/ path component.
#   ERROR: output  is only permitted in tests under an errors/ path component.
#   Normal tests (all other paths) must produce clean output with zero warnings.
#
# Each test is run as a two-program pipeline: [test.llt, cli/out/llt.llt]
# with prelude threaded through both — exactly as the CLI does. The formatter
# output is captured via a string-handle replacing %stdout during the run.
#
# Structure — THREE DICTS:
#   Dict 1: private helpers (loader-level builtins only)
#   Dict 2: test pipeline functions (sees Dict 1 + initial env)
#   Dict 3: load prelude, run all tests, write summary to %stdout

--- uses: ["core"]

# ============================================================================
# Dict 1 — Private helpers (loader-level builtins only)
# ============================================================================

[
  # Boolean declared here so dict 1 helpers can use Boolean.True/False.
  Boolean: [type True False]

  # reduce and join defined here using core builtins only.
  # Dict 1 helpers need these but prelude is not yet loaded.
  _reduce-loop: [fn [let f acc xs i len]
    [builtin-if [builtin-gte i len]
      acc
      [_reduce-loop f [f acc [builtin-get i xs]] xs [builtin-add i 1] len]]]
  reduce: [fn [let f init xs] [_reduce-loop f init xs 0 [builtin-length xs]]]

  _join-loop: [fn [let sep acc xs i len]
    [builtin-if [builtin-gte i len]
      acc
      [_join-loop sep
        [builtin-if [builtin-eq-int i 0]
          [builtin-get 0 xs]
          [builtin-string-concat acc [builtin-string-concat sep [builtin-get i xs]]]]
        xs [builtin-add i 1] len]]]
  join: [fn [let sep xs] [_join-loop sep "" xs 0 [builtin-length xs]]]

  # bool->int: Boolean.False→0, Int pass-through, anything else→1.
  bool->int: [fn [let b] [match b Boolean.False: 0 [@Int _]: b _: 1]]

  # %stdout and %stderr: protocol dicts wrapping the stateless Rust builtins.
  # These MUST be defined here because test-loader runs as --init and main.rs
  # does not inject %stdout/%stderr (that's loader.llt's job for normal runs).
  %stdout: [write:  [fn [let s h] [builtin-write-stdout s h]]
            flush:  [fn [let h] h]
            close:  [fn [let h] h]]
  %stderr: [write:  [fn [let s h] [builtin-write-stderr s h]]
            flush:  [fn [let h] h]
            close:  [fn [let h] h]]

  bytes-empty?: [fn [let b] [builtin-eq-int [builtin-length b] 0]]

  # make-entry: construct single-entry dict from key and value.
  # Defined here for Dict 1 because it runs before prelude is loaded.
  make-entry: [fn [let k v] [$k: v]]

  read-file: [fn [let handle acc]
    [chunk: [builtin-file-read handle 65536]]
    [builtin-if [bytes-empty? chunk]
      acc
      [read-file handle [builtin-bytes-concat acc chunk]]]]

  # make-string-handle: a write handle backed by a builder that accumulates to a string.
  # Uses ONLY core builtins — no prelude functions. Safe in Dict 1 bootstrap context.
  make-string-handle: [fn []
    [buf: [builtin-make-builder]]
    [self:
      [write:  [fn [let s h]
                 [wrote: [builtin-builder-set [builtin-length [builtin-builder-snapshot buf]] s buf]]
                 [builtin-if [builtin-gt [builtin-length [builtin-builder-snapshot wrote]] -1] h h]]
       flush:  [fn [let h] h]
       close:  [fn [let h] h]
       read:   [fn []
                 [snap: [builtin-builder-snapshot buf]]
                 [reduce
                   [fn [let acc k] [builtin-string-concat acc [builtin-get k snap]]]
                   ""
                   [builtin-keys snap]]]]]
    self]

  # strip-trailing-newline: remove one trailing \n from a string.
  strip-trailing-newline: [fn [let s]
    [n: [builtin-str-length s]]
    [builtin-if [builtin-gt n 0]
      [builtin-str-slice s 0 [builtin-sub n 1]]
      s]]

  # Format a single diagnostic dict as a human-readable error line.
  format-diagnostic: [fn [let d]
    [s: d.span]
    [file-part: [builtin-if [builtin-eq-int [builtin-length s.file] 0] "" [builtin-string-concat s.file ":"]]]
    [loc: [builtin-string-concat file-part [builtin-string-concat [builtin-int->string s.start-line] [builtin-string-concat ":" [builtin-int->string s.start-col]]]]]
    [stack-empty: [builtin-eq-int [builtin-length d.call-stack] 0]]
    [label: [builtin-if [builtin-eq-string d.kind "resolve-error"]
              "resolve"
              [builtin-if [builtin-eq-string d.kind "undefined-variable"]
                [builtin-if stack-empty "resolve" "runtime"]
                [builtin-if [builtin-eq-string d.kind "user-error"]
                  "error"
                  d.kind]]]]
    [base-line: [builtin-string-concat loc [builtin-string-concat ": " [builtin-string-concat label [builtin-string-concat ": " [builtin-string-concat d.message "\n"]]]]]]
    [builtin-if stack-empty
      base-line
      [reduce
        [fn [let acc frame]
          [frame-file: [builtin-if [builtin-eq-int [builtin-length frame.span.file] 0] "" [builtin-string-concat frame.span.file ":"]]]
          [builtin-string-concat acc [builtin-string-concat "  in " [builtin-string-concat frame.label [builtin-string-concat " at " [builtin-string-concat frame-file [builtin-string-concat [builtin-int->string frame.span.start-line] [builtin-string-concat ":" [builtin-string-concat [builtin-int->string frame.span.start-col] "\n"]]]]]]]]]
        base-line
        d.call-stack]]]

  # _emit-loop: index-based recursion that writes each diagnostic and returns the
  # count of items written. The count is USED by callers (in n-total) so it is on
  # the materialization path — this is what forces all the writes.
  # Each iteration: write d_i, use the write result's length (always >= 0) as proof
  # the write happened, add 1 to the running count.
  _emit-loop: [fn [let diags i len acc]
    [builtin-if [builtin-gte i len]
      acc
      [_emit-loop diags [builtin-add i 1] len
        [builtin-add acc
          [builtin-gte
            [builtin-length [%stderr.write [format-diagnostic [builtin-get i diags]] %stderr]]
            0]]]]]

  # emit-diagnostics: write all diagnostics to stderr, return the count written.
  # Returns 0 for empty (so bare-eval's [n-parse + _pe = 0] check still works).
  emit-diagnostics: [fn [let diagnostics]
    [_emit-loop diagnostics 0 [builtin-length diagnostics] 0]]

  # uses-scope: for each module name, parse+typecheck its declaration file and
  # accumulate a flat Dict of runtime builtin implementations.
  # Declaration files (builtin_NAME.llt) are optional — if absent, builtin-try
  # catches the error. Typecheck is forced via typed.warnings data dependency (no >>).
  uses-scope: [fn [let module-names]
    [reduce
      [fn [let acc name]
        [decl-path:   [builtin-string-concat "builtin_" [builtin-string-concat name ".llt"]]
         tc-result:   [builtin-try [fn []
             [decl-handle:    [builtin-file-open %libdir decl-path "read"]]
             [decl-bytes:     [read-file decl-handle [builtin-bytes]]]
             [parse-result:   [builtin-parse decl-bytes decl-path]]
             # builtin-resolve requires Value::Environment for env: — use empty root env.
             [decl-env:       [builtin-extend-env [] []]]
             [resolve-errors: [reduce
               [fn [let acc doc]
                 [r: [builtin-resolve doc env: decl-env]]
                 [builtin-add acc [builtin-length r.errors]]]
               0
               parse-result.program.documents]]
             [typed:          [builtin-typecheck parse-result.program [builtin-get-type-context]]]
             [builtin-if [builtin-eq-int resolve-errors 0] typed.warnings typed.warnings]]]
         warnings:    [builtin-if [builtin-eq-string [builtin-tag-of tc-result] "Result.Ok"]
             [builtin-variant-payload tc-result]
             []]
         n-w:         [emit-diagnostics warnings]
         module-impl: [builtin-module name]]
        # n-w (count of warnings written) is the condition — forces all writes before merge.
        [builtin-if [builtin-gte n-w 0]
          [builtin-merge acc module-impl]
          [builtin-merge acc module-impl]]]
      []
      module-names]]

  # bare-eval: load and evaluate a tinct file with an explicit seed env extension.
  # extras: dict of additional bindings injected into the seed before evaluation.
  # --- uses: headers are applied per-document in the eval loop below.
  # parse-result.program.documents is an integer-keyed Dict (field-get on Program returns Dict, not Seq).
  # builtin-reduce on a Dict is correct here.
  bare-eval: [fn [let cap path extras]
    [handle:        [builtin-file-open cap path "read"]]
    [bytes:         [read-file handle [builtin-bytes]]]
    [parse-result:  [builtin-parse bytes path]]
    # Stop on parse errors. n-parse + _pe = 0 iff no errors (both are counts from emit-diagnostics).
    [n-parse:  [builtin-length parse-result.errors]
     _pe:      [emit-diagnostics parse-result.errors]
     seed-env: [builtin-if [builtin-eq-int [builtin-add n-parse _pe] 0]
       [builtin-extend-env [] extras]
       [builtin-raise [join "" [[builtin-int->string n-parse] " parse error(s) in " path]]]]]
    # Per-document: each document gets its own module builtins via uses-scope.
    # Accumulator is {env, last-result} so we have direct access to the last document's
    # exported value without hardcoding any output variable name.
    [final-state: [reduce
      [fn [let state doc]
        [done:       [builtin-eq-string [builtin-tag-of doc.stage] "DocStage.Type"]
         env:        state.env
         doc-env:    [builtin-extend-env env [uses-scope doc.uses]]
         resolved:   [builtin-resolve doc env: doc-env]
         n-re:       [builtin-length resolved.errors]
         _re:        [emit-diagnostics resolved.errors]
         eval-result:[builtin-if [builtin-eq-int [builtin-add n-re _re] 0]
           [builtin-eval resolved.doc env: doc-env]
           [builtin-raise [join "" [[builtin-int->string n-re] " resolve error(s) in " path]]]]]
        [builtin-if done
          state
          [builtin-if [builtin-eq-string [builtin-type-of eval-result.error] "String"]
            [builtin-raise eval-result.error]
            [new-env: [builtin-extend-env eval-result.env
              [make-entry
                [builtin-if [builtin-eq-string eval-result.doc-name ""] "%" eval-result.doc-name]
                eval-result.result]]]
            [env: new-env  last-result: eval-result.result]]]]
      [env: seed-env  last-result: []]
      parse-result.program.documents]]
    # Promote last document's exported dict entries into the env so bare names resolve.
    [final-env: final-state.env]
    [exported: [builtin-if [builtin-eq-string [builtin-type-of final-state.last-result] "Dict"]
      final-state.last-result
      []]]
    [full-env: [builtin-extend-env final-env exported]]
    # Resolve each document individually with full-env (document path, not program path).
    # builtin-resolve now only accepts Document — the program path was removed.
    # Errors are emitted immediately and counted. AST nodes are mutated in-place with
    # de Bruijn coords so the typecheck pass can read them from parse-result.program.
    [tc-error-count: [reduce
      [fn [let total doc]
        [r:        [builtin-resolve doc env: full-env]
         n-e:      [builtin-length r.errors]
         _emitted: [emit-diagnostics r.errors]]
        # Force _emitted (writes errors) then add n-e to the running total.
        [builtin-if [builtin-gte [builtin-add n-e _emitted] 0]
          [builtin-add total n-e]
          [builtin-add total n-e]]]
      0
      parse-result.program.documents]]
    # Typecheck the now-resolved program (documents have inline coords from above).
    [typed: [builtin-typecheck parse-result.program [builtin-get-type-context] env: full-env]]
    # Return errors and warnings as data. tc-errors is a count (Int): resolve errors
    # were already emitted during the per-document resolve loop above.
    [env:          full-env
     tc-errors:    tc-error-count
     tc-warnings:  typed.warnings]]
]

# ============================================================================
# Dict 2 — Test runner functions
# ============================================================================
# Closures here capture Dict 1 + initial env. Prelude-specific names are
# passed as parameters so that tests run with the full prelude in scope.

[
  Boolean: [type True False]

  ProgramItem: [type
    [File path: String  handle: File]
    [Expr src:  String]
  ]

  Result: [type [let a] [Ok a] [Error String]]

  write-str: [fn [let h s] [h.write s]]

  # validate-prelude-result: check bare-eval result for type errors.
  # Emits all diagnostics and raises if any errors/warnings found.
  # Returns the env on success. Use this as a named function instead of
  # [call [fn [] ...]] — cleaner and testable independently.
  validate-prelude-result: [fn [let result]
    # tc-errors is now an Int (count of resolve errors, already emitted during resolution).
    # n-warn is from builtin-typecheck warnings (a dict — emit-diagnostics returns count).
    # n-total forces both emit calls and is non-zero when any errors exist.
    [n-tc:          result.tc-errors
     n-warn:        [builtin-length result.tc-warnings]
     n-tc-emitted:  result.tc-errors
     n-warn-emitted: [emit-diagnostics result.tc-warnings]
     n-total:       [builtin-add [builtin-add n-tc n-warn]
                      [builtin-add n-tc-emitted n-warn-emitted]]]
    [builtin-if [builtin-eq-int n-total 0]
      result.env
      [builtin-raise [join "" ["prelude has "
        [builtin-int->string [builtin-add n-tc n-warn]]
        " type error(s) — see above"]]]]]

  # extract-source: given file content, return everything before "\n=== ".
  extract-source: [fn [let content]
    [sep-pos: [builtin-str-index-of "\n=== " content]]
    [builtin-if [builtin-eq-int sep-pos -1]
      content
      [builtin-str-slice content 0 sep-pos]]]

  section-strip-nl: [fn [let sv sl]
    [builtin-if [builtin-eq-int sl 0] sv
      [builtin-if [builtin-eq-string [builtin-str-slice sv [builtin-add sl -1] sl] "\n"]
        [builtin-str-slice sv 0 [builtin-add sl -1]]
        sv]]]

  section-cut-at: [fn [let sv si]
    [builtin-if [builtin-eq-int si -1] sv [builtin-str-slice sv 0 si]]]

  section-trim: [fn [let bt]
    [section-strip-nl
      [section-cut-at bt [builtin-str-index-of "\n=== " bt]]
      [builtin-str-length [section-cut-at bt [builtin-str-index-of "\n=== " bt]]]]]

  extract-section: [fn [let content label]
    [sep: [join "" ["\n=== " label "\n"]]]
    [builtin-if [builtin-eq-int [builtin-str-index-of sep content] -1]
      ""
      [section-trim
        [builtin-str-slice
          content
          [builtin-add
            [builtin-str-index-of sep content]
            [builtin-str-length sep]]
          [builtin-str-length content]]]]]

  # run-test-pipeline: evaluate a test source through the full CLI pipeline:
  #   test-source → cli/out/llt.llt (formatter)
  # This mirrors exactly what the CLI does: both programs run with prelude in
  # scope, %stdout is a capture handle, and the formatter writes the repr.
  #
  # Parameters:
  #   source   — tinct source string (from === out section, without the sections)
  #   path     — file path for error messages
  #   prelude  — loaded prelude (Value::Environment from include %libdir "prelude.llt")
  #   llt-formatter-expanded — parsed+expanded cli/out/llt.llt (SurfaceProgram)
  #   warn-box — builder to accumulate typecheck warnings (for check-warn)
  #
  # Returns: the captured output from the formatter (the LLT repr of the result).
  # Raises on error (caught by builtin-try in run-test-file).
  run-test-pipeline: [fn [let source path prelude llt-formatter-expanded warn-box]
    # Per-test capture handle — replaces %stdout so formatter output is captured.
    [capture: [make-string-handle]]

    # Base env for test program: prelude + caps + capture as %stdout.
    # This is the same env the CLI uses for each user program.
    [base-env: [builtin-extend-env prelude
                 [%cwd:    %cwd
                  %libdir: %libdir
                  %stdout: capture
                  %stderr: %stderr
                  %args:   %args]]]

    # Parse the test source (no expand step).
    [parse-result:  [builtin-parse [builtin-str-bytes source] path]]

    # Resolve per-document to write de Bruijn coords inline on AST nodes.
    # builtin-resolve only accepts Document — accumulate resolve errors across all docs.
    [resolve-errors: [reduce
      [fn [let acc doc]
        [r: [builtin-resolve doc env: base-env]]
        [builtin-merge acc [reduce [fn [let a i] [builtin-merge a [[builtin-add [builtin-length acc] i]: [builtin-get i r.errors]]]] [] [builtin-keys r.errors]]]]
      []
      parse-result.program.documents]]

    # Typecheck the now-resolved program (OnceLocks set above).
    [typed: [builtin-typecheck parse-result.program [builtin-get-type-context prelude] env: base-env]]

    # Accumulate resolve errors + typecheck warnings into warn-box.
    [resolve-count: [builtin-length resolve-errors]]
    [all-warnings:  [reduce
      [fn [let acc i]
        [builtin-merge acc [[builtin-add resolve-count i]: [builtin-get i typed.warnings]]]]
      resolve-errors
      [builtin-keys typed.warnings]]]
    # Force warn-box update as a data dependency (no >> needed).
    # builtin-builder-set writes to the builder and returns the builder object.
    # We force it by reading the builder snapshot length (always >= 0).
    [_wb:           [builtin-builder-set 0 all-warnings warn-box]]
    [_wb-forced:    [builtin-if [builtin-gte [builtin-length [builtin-builder-snapshot _wb]] 0] 1 1]]

    # Evaluate test source document by document, threading env.
    # The final env has .% = the last expression's result value.
    # Use typed.documents (not resolved-prog.documents) to create an explicit data
    # dependency on the typecheck pass. This ensures call_dispatch annotations are
    # written to AST nodes before the lowerer reads them during builtin-eval.
    [test-state: [reduce
      [fn [let state doc]
        [eval-result: [builtin-eval doc env: state.env]]
        [builtin-if [builtin-eq-string [builtin-type-of eval-result.error] "String"]
          [builtin-raise eval-result.error]
          [call [fn [let]
            # T-1507: caps check against current eval env.
            [_caps-ok: [reduce
              [fn [let ok cap-name]
                [full-name: [builtin-string-concat "%" cap-name]]
                [builtin-if [builtin-cap-env-has? full-name state.env]
                  ok
                  [builtin-raise [join "" [full-name " is required but not provided"]]]]]
              Boolean.True
              [builtin-keys doc.caps]]
             # T-1506: expects check against incoming value. Identical branches are intentional —
             # builtin-check-type is forced for its raise side-effect; result always Boolean.True.
             _expects-ok: [builtin-if [builtin-eq-string [builtin-type-of doc.expects] "String"]
               [builtin-if [builtin-gte [builtin-length [builtin-type-of [builtin-check-type doc.expects state.last-result]]] 0]
                 Boolean.True
                 Boolean.True]
               Boolean.True]]
            [builtin-if [builtin-eq-string [builtin-tag-of _caps-ok] "Boolean.True"]
              [builtin-if [builtin-eq-string [builtin-tag-of _expects-ok] "Boolean.True"]
                [new-env: [builtin-extend-env eval-result.env
                  [make-entry
                    [builtin-if [builtin-eq-string eval-result.doc-name ""] "%" eval-result.doc-name]
                    eval-result.result]]]
                [env: new-env  last-result: eval-result.result]
                [builtin-raise "unreachable"]]
              [builtin-raise "unreachable"]]]]]]
      [env: base-env  last-result: []]
      typed.documents]]

    # Format the test result directly using builtin-llt-repr (core builtin, always available).
    # Avoids llt.llt formatter which needs prelude functions not available in bare-eval scope.
    [result-val: test-state.last-result]
    [output: [builtin-string-concat [builtin-llt-repr result-val] "\n"]]
    [wrote: [capture.write output capture]]
    [builtin-if [builtin-gte [builtin-add _wb-forced [builtin-if [builtin-gte [builtin-length wrote] 0] 1 1]] 2]
      [capture.read]
      [capture.read]]]

  # path-has-component: true if path contains "/component/" as a path segment.
  path-has-component: [fn [let path component]
    [builtin-if [builtin-eq-int [builtin-str-index-of [join "" ["/" component "/"] ] path] -1]
      Boolean.False
      Boolean.True]]

  # check-path-sections: enforce that warn/error sections only appear in
  # appropriately named directories.
  check-path-sections: [fn [let path expected-warn expected-error actual-out]
    [in-warnings: [path-has-component path "warnings"]]
    [in-errors:   [path-has-component path "errors"]]
    [warn-ok: [builtin-if [builtin-eq-string expected-warn ""]
                Boolean.True
                in-warnings]]
    [error-ok: [builtin-if [builtin-eq-string expected-error ""]
                  [builtin-if [builtin-eq-int [builtin-str-index-of "ERROR:" actual-out] 0]
                    in-errors
                    Boolean.True]
                  in-errors]]
    [builtin-if [bool->int warn-ok]
      [builtin-if [bool->int error-ok]
        ""
        [builtin-if [builtin-eq-string expected-error ""]
          [join "" ["ERROR: output not allowed outside errors/ directory: " path]]
          [join "" ["=== error section not allowed outside errors/ directory: " path]]]]
      [join "" ["=== warn section not allowed outside warnings/ directory: " path]]]]

  # check-warn: validate typecheck warnings against the expected-warn section.
  check-warn: [fn [let warnings expected-warn]
    [warn-count: [builtin-length warnings]]
    [warn-text: [reduce
      [fn [let acc w] [builtin-string-concat acc [builtin-string-concat [builtin-if [builtin-eq-string acc ""] "" "\n"] w.message]]]
      ""
      warnings]]
    [builtin-if [builtin-eq-string expected-warn ""]
      [builtin-if [builtin-eq-int warn-count 0]
        ""
        [join "" ["expected no warnings, got:\n" warn-text]]]
      [builtin-if [builtin-eq-int [builtin-str-index-of expected-warn warn-text] -1]
        [join "" ["expected warning not found:\n  " expected-warn "\nactual:\n  " warn-text]]
        ""]]]

  # run-test-file: execute a single file ProgramItem as a corpus test.
  run-test-file: [fn [let p prelude llt-formatter-expanded]
    [bytes:          [read-file p.handle [builtin-bytes]]]
    [content:        [builtin-bytes-str bytes]]
    [source:         [extract-source content]]
    [expected-out:   [extract-section content "out"]]
    [expected-warn:  [extract-section content "warn"]]
    [expected-error: [extract-section content "error"]]

    # warn-box captures typecheck warnings as a side effect of run-test-pipeline.
    [warn-box: [builtin-make-builder]]

    # Run test through the full [test.llt → llt.llt] pipeline.
    # builtin-try catches eval errors and returns Result.Error with the message.
    [try-result: [builtin-try [fn [] [run-test-pipeline source p.path prelude llt-formatter-expanded warn-box]]]]

    [try-ok: [match try-result
        [Result.Ok _]:    1
        [Result.Error _]: 0]]

    # Extract the formatter output or an ERROR: prefix.
    [raw-output: [builtin-if try-ok
        [builtin-variant-payload try-result]
        [builtin-string-concat "ERROR: " [builtin-variant-payload try-result]]]]

    # Strip trailing newline from formatter output (formatters add a final \n).
    [actual: [builtin-if try-ok
        [strip-trailing-newline raw-output]
        raw-output]]

    # Warnings were stored in warn-box by run-test-pipeline.
    [eval-warnings: [builtin-if try-ok [builtin-get 0 [builtin-builder-snapshot warn-box]] []]]

    # === error: substring match; === out: exact match
    [out-passed: [builtin-if [builtin-eq-string expected-error ""]
                   [builtin-eq-string actual expected-out]
                   [builtin-if [builtin-eq-int [builtin-str-index-of expected-error actual] -1]
                     0
                     1]]]

    [path-fail: [check-path-sections p.path expected-warn expected-error actual]]
    [path-passed: [builtin-eq-string path-fail ""]]

    [warn-fail: [builtin-if try-ok
      [check-warn eval-warnings expected-warn]
      ""]]
    [warn-passed: [builtin-eq-string warn-fail ""]]

    [r-path:    p.path]
    [r-passed:  [builtin-if out-passed [builtin-if warn-passed path-passed 0] 0]]
    [r-actual:  [builtin-if path-passed
                  [join "" [
                    [builtin-if out-passed  "" [join "" ["out: "  actual    "\n"]]]
                    [builtin-if warn-passed "" [join "" ["warn: " warn-fail "\n"]]]]]
                  [join "" ["out: " actual "\npath: " path-fail]]]]
    [r-expected: [builtin-if path-passed
                   [join "" [
                     [builtin-if out-passed  "" [join "" ["out: "
                       [builtin-if [builtin-eq-string expected-error ""] expected-out expected-error] "\n"]]]
                     [builtin-if warn-passed "" [join "" ["warn: " expected-warn "\n"]]]]]
                   [join "" ["out: "
                     [builtin-if [builtin-eq-string expected-error ""] expected-out expected-error]]]]]
    [path: r-path  passed: r-passed  actual: r-actual  expected: r-expected]]

  # run-test: run one ProgramItem as a corpus test.
  run-test: [fn [let item prelude llt-formatter-expanded]
    [match item
      [ProgramItem.File _]: [run-test-file item prelude llt-formatter-expanded]
      [ProgramItem.Expr _]: [path: "<expr>"  passed: Boolean.True  actual: ""  expected: ""]]]

  # format-result: render test outcome line.
  format-result: [fn [let r]
    [builtin-string-concat r.path
      [builtin-string-concat " ... "
        [builtin-if [bool->int r.passed]
          "pass\n"
          [builtin-string-concat "FAIL\n"
            [builtin-string-concat "  expected: "
              [builtin-string-concat r.expected
                [builtin-string-concat "\n  actual:   "
                  [builtin-string-concat r.actual "\n"]]]]]]]]]

  # check-llt-eval: true if a filename ends with ".llt-eval".
  check-llt-eval: [fn [let name]
    [len: [builtin-str-length name]]
    [builtin-if [builtin-lt len 9]
      0
      [builtin-eq-string [builtin-str-slice name [builtin-sub len 9] len] ".llt-eval"]]]

  # find-corpus-files: recursively walk cap/dir-path, accumulate .llt-eval files.
  find-corpus-files: [fn [let cap dir-path state]
    [entries: [builtin-list-dir cap dir-path]]
    [reduce
      [fn [let st entry]
        [full: [join "" [$dir-path "/" entry.name]]]
        [builtin-if [builtin-eq-string entry.type "dir"]
          [find-corpus-files cap full st]
          [builtin-if [check-llt-eval entry.name]
            [builtin-append
              [ProgramItem.File path: full  handle: [builtin-file-open cap full "read"]]
              st]
            st]]]
      state
      entries]]]

# ============================================================================
# Dict 3 — Load prelude, pre-parse formatter, run tests
# ============================================================================

[
  # Thread Boolean/True/False from loader scope so prelude can use them unqualified.
  # %prelude is a lazy forward reference — safe because prelude only forces it at call time.
  # IMPORTANT: _prelude must remain a simple field access (_prelude-result.env) so that
  # the forward reference %prelude: _prelude in the extras dict is safe. If _prelude were
  # an IIFE ([call [fn [] ...]]), prelude code that accesses %prelude during loading would
  # force _prelude → force _prelude-result (pending) → cycle. Keep it simple.
  _prelude-result: [bare-eval %libdir "prelude.llt"
    [%prelude: _prelude  Boolean: Boolean  True: True  False: False]]

  _prelude: _prelude-result.env

  # _prelude-validated: the env to use for test runs.
  # validate-prelude-result is defined in Dict 2 as a named function — cleaner than
  # [call [fn [] ...]] (IIFE). Memoized: check runs once, then result is reused.
  _prelude-validated: [validate-prelude-result _prelude-result]

  # _prelude-ok: forces prelude validation BEFORE the test reduce starts, outside
  # any builtin-try. builtin-type-of forces _prelude-validated; builtin-gte makes
  # an Int for use as a data dependency in test-programs.
  # If _prelude-validated raises, it propagates HERE (Dict 3 level, no try catches it).
  _prelude-ok: [builtin-gte [builtin-length [builtin-type-of _prelude-validated]] 0]

  # Pre-parse cli/out/llt.llt once (parse only — NOT resolved).
  # Resolution happens per-test inside run-test-pipeline with fmt-env
  # (prelude + % = test result + capture stdout), exactly as the CLI does.
  _llt-formatter-expanded: [call [fn []
    [parse-result:  [builtin-parse
                      [read-file [builtin-file-open %libdir "cli/out/llt.llt" "read"] [builtin-bytes]]
                      "cli/out/llt.llt"]]
    # Emit parse errors as a data dependency (no >> needed).
    [_pe:           [emit-diagnostics parse-result.errors]]
    [builtin-if [builtin-gte _pe 0]
      parse-result.program
      parse-result.program]]]

  # Bootstrap check: verify the formatter loaded correctly.
  _formatter-ok: [match [builtin-try [fn [] _llt-formatter-expanded.documents]]
    [Result.Ok _]:    1
    [Result.Error _]:
      # Force the stderr write by calling the helper inline; write returns the handle.
      [call [fn [let _w] [builtin-if [builtin-gte [builtin-length _w] 0] 0 0]]
        [%stderr.write "\nbootstrap error: llt.llt formatter failed to load\nCannot run corpus tests.\n" %stderr]]]

  # Discover test files (or use the ones given on the command line).
  # _prelude-ok is a data dependency: forces prelude validation BEFORE the reduce
  # starts, outside any builtin-try. If prelude has errors, the raise propagates
  # here (Dict 3 level) and the test run aborts with full error details visible.
  test-programs: [builtin-if [builtin-eq-int [builtin-add _formatter-ok _prelude-ok] 2]
    [builtin-if [builtin-eq-int [builtin-length %programs] 0]
      [find-corpus-files
        [builtin-narrow %cwd "tests/corpus"]
        "."
        []]
      %programs]
    []]

  final-state: [reduce
    [fn [let state item]
      [result: [run-test item _prelude-validated _llt-formatter-expanded]]
      # Force the write as a data dependency (no >> needed).
      # %stdout.write returns the handle (%stdout protocol dict).
      # Force it by reading the handle's key count (always >= 0).
      [wrote: [%stdout.write [format-result result] %stdout]]
      [builtin-if [builtin-gte [builtin-length wrote] 0]
        [idx:    [builtin-add state.idx 1]
         total:  [builtin-add state.total 1]
         passed: [builtin-if [bool->int result.passed]
                    [builtin-add state.passed 1]
                    state.passed]
         first-fail: [builtin-if [builtin-eq-string state.first-fail ""]
                        [builtin-if [bool->int result.passed]
                          ""
                          [builtin-string-concat result.path [builtin-string-concat "\n  expected: " [builtin-string-concat result.expected [builtin-string-concat "\n  actual:   " result.actual]]]]]
                        state.first-fail]]
        [idx:    [builtin-add state.idx 1]
         total:  [builtin-add state.total 1]
         passed: state.passed
         first-fail: state.first-fail]]]
    [idx: 0  total: 0  passed: 0  first-fail: ""]
    test-programs]
]

# ============================================================================
# Final expression — summary + exit code
# ============================================================================

[wrote: [%stdout.write [join "" [
    "\n"
    [builtin-int->string final-state.passed] "/" [builtin-int->string final-state.total] " tests passed"
    [builtin-if [builtin-eq-int final-state.passed final-state.total]
      "\n"
      [join "" [", " [builtin-int->string [builtin-sub final-state.total final-state.passed]] " failed\n"]]]]]
  %stdout]]
[builtin-if [builtin-gte [builtin-length wrote] 0]
  [builtin-if [builtin-eq-int final-state.passed final-state.total]
    []
    [builtin-raise [join "" [
      [builtin-int->string [builtin-sub final-state.total final-state.passed]] " test(s) failed\n"
      final-state.first-fail]]]]
  []]
