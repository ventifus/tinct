# stdlib/test-loader.llt
#
# Self-contained corpus test runner — an alternative init program for use with:
#   tinct run --init stdlib/test-loader.llt tests/corpus/eval/*.llt-eval
#
# Receives the same initial environment as loader.llt:
#   %programs  — integer-keyed Dict of ProgramItem variants (one per test file)
#   %args      — CLI flags dict
#   %cwd       — DirCap for working directory
#   %libdir    — DirCap for stdlib

--- stage: "type"
# Type-stage definitions for primitive types available in this init program.
[
  TypeNode: [type
    Int
    String
    Float
    Bytes
    Never
    Top
    Unknown
    Proxy
    Callable
    Dict: [fields: Any  open: Any  key-type: Any  value-type: Any]
    TypeConstructor: [name: Any]
    TypeApplication: [ctor: Any  args: Any]
    IntLiteral:    [n: Any]
    StringLiteral: [s: Any]]

  Integer: TypeNode.Int
  String:  TypeNode.String
  Float:   TypeNode.Float
  Bytes:   TypeNode.Bytes
  Never:   TypeNode.Never
  Any:     TypeNode.Top
  Unknown: TypeNode.Unknown
  Proxy:   TypeNode.Proxy
  Dict:    [TypeNode.Dict fields: []  open: 1  key-type: TypeNode.Top  value-type: TypeNode.Top]
  Callable: TypeNode.Callable
]

---
#   %stdout    — protocol dict for output (write, flush, close methods)
#
# Test file format (*.llt-eval):
#   <tinct source>
#   === out
#   <expected repr string>
#   === warn          (optional)
#   <expected warning substring>
#
# If === warn is absent, the test asserts zero typecheck warnings.
# If === warn is present, it asserts the substring appears in the joined warnings.
#
# Path-based section enforcement:
#   === warn sections are only permitted in tests under a warnings/ path component.
#   ERROR: output  is only permitted in tests under an errors/ path component.
#   Normal tests (all other paths) must produce clean output with zero warnings.
#
# Each test is run as a two-program pipeline: [test.llt, cli/out/llt.llt]
# with prelude threaded through both — exactly as the CLI does. The formatter
# output is captured via a string-handle replacing %stdout during the run.
#
# Structure — THREE DICTS:
#   Dict 1: private helpers (loader-level builtins only)
#   Dict 2: test pipeline functions (sees Dict 1 + initial env)
#   Dict 3: load prelude, run all tests, write summary to %stdout

# ============================================================================
# Dict 1 — Private helpers (loader-level builtins only)
# ============================================================================

[
  # Boolean declared here so dict 1 helpers can use Boolean.True/False.
  Boolean: [type True False]

  # StringWriter declared here so Dict 2 fn annotations can reference StringWriter.Writer.
  # Mirrors the prelude.llt declaration so annotations in Dict 2 work without prelude loaded.
  StringWriter: [type Writer: [cells: String]]

  # reduce and join defined here using core builtins only.
  # Dict 1 helpers need these but prelude is not yet loaded.
  reduce: [fn@[bind: [a b]  return: a] [let f@[Fn@a [a b]] init@a xs@Dict]
    [n: [builtin-dict-length xs]]
    [loop: [fn [let acc i]
      [match [builtin-int-gte i n]
        0: [loop [f acc [builtin-dict-get i xs]] [builtin-int-add i 1]]
        1: acc]]]
    [loop init 0]]

  join: [fn@String [let sep@String xs@Dict]
    [n: [builtin-dict-length xs]]
    [loop: [fn@String [let acc@String i]
      [match [builtin-int-gte i n]
        0: [loop
              [match [builtin-eq-int i 0]
                0: [builtin-string-concat acc [builtin-string-concat sep [builtin-dict-get i xs]]]
                1: [builtin-dict-get 0 xs]]
              [builtin-int-add i 1]]
        1: acc]]]
    [loop "" 0]]

  # bool->int: Boolean.False→0, Boolean.True→1.
  bool->int: [fn@Integer [let b@Boolean] [match b Boolean.False: 0 Boolean.True: 1]]

  # %stdout and %stderr: protocol dicts wrapping the stateless Rust builtins.
  # These MUST be defined here because test-loader runs as --init and main.rs
  # does not inject %stdout/%stderr (that's loader.llt's job for normal runs).
  %stdout: [write:  [fn@[bind: [h] return: h] [let s@String h] [builtin-write-stdout s h]]
            flush:  [fn@[bind: [h] return: h] [let h] h]
            close:  [fn@[bind: [h] return: h] [let h] h]]
  %stderr: [write:  [fn@[bind: [h] return: h] [let s@String h] [builtin-write-stderr s h]]
            flush:  [fn@[bind: [h] return: h] [let h] h]
            close:  [fn@[bind: [h] return: h] [let h] h]]

  bytes-empty?: [fn [let b] [builtin-eq-int [builtin-bytes-length b] 0]]

  # null?: test if value is [] (empty dict). Same definition as loader.llt Dict 1.
  null?: [fn [let x]
    [match x
      Dict: [builtin-eq-int [builtin-dict-length x] 0]
      ...:  0]]


  # get-or: safe dict access with default value
  get-or: [fn [let default key dict]
    [match [builtin-has-key? key dict]
      0: default
      1: [builtin-dict-get key dict]]]

  # log-step: write msg to state.stderr and return state with updated handle.
  # The returned state.stderr is the genuine consumer — it is forced when the next
  # stage (or the reduce's passed computation) accesses state.stderr.
  log-step: [fn [let msg@String state@[stderr: Any]]
    [merge state [stderr: [call [builtin-dict-get "write" %stderr] [builtin-string-concat msg "\n"] state.stderr]]]]

  # env-to-name-set: build name-set Dict<String,1> from env for builtin-resolve.
  # builtin-resolve now takes a flat Dict<String,1> of all visible names (values ignored).
  # Replaces the old scope-to-frames walk — env is already a flat dict of all bindings.
  env-to-name-set: [fn [let env@Dict]
    [keys: [builtin-keys env]]
    [n:    [builtin-dict-length keys]]
    [loop: [fn [let i@Integer builder]
      [match [builtin-eq-int i n]
        0: [loop [builtin-int-add i 1]
                 [builtin-builder-set [@String [builtin-dict-get i keys]] 1 builder]]
        1: [builtin-builder-finish builder]]]]
    [loop 0 [builtin-make-builder]]]

  merge: [fn [let a b]
    [_copy: [fn [let builder d@Dict n@Integer i@Integer]
      [match [builtin-int-gte i n]
        0: [_copy
              [builtin-builder-set [builtin-dict-key-nth d i] [builtin-dict-nth d i] builder]
              d n [builtin-int-add i 1]]
        1: builder]]]
    [builtin-builder-finish
      [_copy [_copy [builtin-make-builder] a [builtin-dict-length a] 0]
             b [builtin-dict-length b] 0]]]

  read-file: [fn [let handle acc]
    [chunk: [builtin-file-read handle 65536]]
    [match [bytes-empty? chunk]
      0: [read-file handle [builtin-bytes-concat acc chunk]]
      ...: acc]]

  # make-string-handle: a write handle backed by a builder that accumulates to a string.
  # Uses ONLY core builtins — no prelude functions. Safe in Dict 1 bootstrap context.
  make-string-handle: [fn []
    [buf: [builtin-make-builder]]
    [self:
      [write:  [fn [let s h]
                 [wrote: [builtin-builder-set [builtin-dict-length [builtin-builder-snapshot buf]] s buf]]
                 [match [builtin-int-gt [builtin-dict-length [builtin-builder-snapshot wrote]] -1]
                   0: h
                   1: h]]
       flush:  [fn [let h] h]
       close:  [fn [let h] h]
       read:   [fn []
                 [snap: [builtin-builder-snapshot buf]]
                 [reduce
                   [fn [let acc k] [builtin-string-concat acc [builtin-dict-get k snap]]]
                   ""
                   [builtin-keys snap]]]]]
    self]

  # strip-trailing-newline: remove one trailing \n from a string.
  strip-trailing-newline: [fn@String [let s@String]
    [n: [builtin-str-length s]]
    [match [builtin-int-gt n 0]
      0: s
      1: [builtin-str-slice s 0 [builtin-int-sub n 1]]]]

  # Format a single diagnostic dict as a human-readable error line.
  format-diagnostic: [fn@String [let d@[level: String  kind: String  message: String  span: Any  call-stack: Any  notes: Any  help: Any  blame: Any  macro-expand: Any  secondary-spans: Any]]
    [s: [@[file: String  start-line: Integer  start-col: Integer  end-line: Integer  end-col: Integer] d.span]]
    [file-part: [match [builtin-eq-int [builtin-str-length s.file] 0]
      0: [builtin-string-concat s.file ":"]
      1: "<unknown>:"]]
    [loc: [builtin-string-concat file-part [builtin-string-concat [builtin-int->string s.start-line] [builtin-string-concat ":" [builtin-int->string s.start-col]]]]]
    [call-stack: [@Dict d.call-stack]]
    [level:      [@String d.level]]
    [kind:       [@String d.kind]]
    [message:    [@String d.message]]
    [notes:      [@Dict d.notes]]
    [stack-empty: [builtin-eq-int [builtin-dict-length call-stack] 0]]
    [base-line: [builtin-string-concat loc [builtin-string-concat ": " [builtin-string-concat level [builtin-string-concat ": " [builtin-string-concat kind [builtin-string-concat " — " [builtin-string-concat message "\n"]]]]]]]]
    [notes-empty: [builtin-eq-int [builtin-dict-length notes] 0]]
    [with-notes: [match notes-empty
      0: [reduce
            [fn [let acc note] [builtin-string-concat acc [builtin-string-concat note "\n"]]]
            base-line
            notes]
      1: base-line]]
    # Render secondary-spans (e.g. "previously defined here") as note: lines.
    [secondary-spans: [get-or [] "secondary-spans" d]]
    [with-secondary: [match [builtin-eq-int [builtin-dict-length secondary-spans] 0]
      0: [reduce
            [fn [let acc ss]
              [sf: [@[file: String  start-line: Integer  start-col: Integer] ss.span]]
              [ss-file: [match [builtin-eq-int [builtin-str-length sf.file] 0]
                0: [builtin-string-concat sf.file ":"]
                1: ""]]
              [ss-loc: [builtin-string-concat ss-file [builtin-string-concat [builtin-int->string sf.start-line] [builtin-string-concat ":" [builtin-int->string sf.start-col]]]]]
              [builtin-string-concat acc [builtin-string-concat "  note: " [builtin-string-concat [@String ss.label] [builtin-string-concat " at " [builtin-string-concat ss-loc "\n"]]]]]]
            with-notes
            secondary-spans]
      1: with-notes]]
    [match stack-empty
      0: [reduce
            [fn [let acc frame]
              [fs: [@[file: String  start-line: Integer  start-col: Integer] frame.span]]
              [frame-file: [match [builtin-eq-int [builtin-str-length fs.file] 0]
                0: [builtin-string-concat fs.file ":"]
                1: ""]]
              [builtin-string-concat acc [builtin-string-concat "  in " [builtin-string-concat [@String frame.label] [builtin-string-concat " at " [builtin-string-concat frame-file [builtin-string-concat [builtin-int->string fs.start-line] [builtin-string-concat ":" [builtin-string-concat [builtin-int->string fs.start-col] "\n"]]]]]]]]]
            with-secondary
            call-stack]
      1: with-secondary]]

  # emit-diagnostics: write all diagnostics to h, return the updated stderr handle.
  # The returned handle is the genuine consumer — whoever accesses state.stderr next
  # forces this chain.
  emit-diagnostics: [fn [let diagnostics@Dict h]
    [n: [builtin-dict-length diagnostics]]
    [loop: [fn [let i h]
      [match [builtin-int-gte i n]
        0: [loop [builtin-int-add i 1]
              [call [builtin-dict-get "write" %stderr] [format-diagnostic [builtin-dict-get i diagnostics]] h]]
        1: h]]]
    [loop 0 h]]

  count-errors: [fn@Integer [let diags@Dict]
    [n: [builtin-dict-length diags]]
    [loop: [fn@Integer [let i acc@Integer]
      [match [builtin-int-gte i n]
        0: [loop [builtin-int-add i 1]
              [match [builtin-eq-string [@String [builtin-dict-nth diags i].level] "error"]
                0: acc
                1: [builtin-int-add acc 1]]]
        1: acc]]]
    [loop 0 0]]

  # append-one: append a single value to an integer-keyed accumulator dict.
  append-one: [fn [let acc v] [merge acc [[builtin-dict-length acc]: v]]]

  append-diags: [fn [let acc@Dict new-diags@Dict]
    [n:      [builtin-dict-length new-diags]]
    [offset: [builtin-dict-length acc]]
    [loop: [fn [let result i]
      [match [builtin-int-gte i n]
        0: [loop
              [merge result [[builtin-int-add offset i]: [builtin-dict-nth new-diags i]]]
              [builtin-int-add i 1]]
        1: result]]]
    [loop acc 0]]

  # uses-scope: for each module name, parse+typecheck its declaration file and
  # accumulate a flat Dict of runtime builtin implementations.
  # Declaration files (builtin_NAME.llt) are optional — if absent, builtin-try
  # catches the error. Typecheck is forced via the has-key? check on result (no >>).
  # tc:  the TypeContext to use for all module type-checks.
  # env: the accumulated env dict to use for declaration file doc-meta/resolve.
  # err: the current stderr handle (threads through for write chaining).
  #
  # Matches loader.llt's design: type-check each doc (TypeContext updated as side effect),
  # return runtime module bindings. The type-stage scope is pre-seeded via the Rust
  # bootstrap (see lib.rs init_type_context call) — no explicit builtin-tc-update-type-stage-env
  # needed. Attempting to call builtin-tc-update-type-stage-env with type-stage letrec exports
  # causes circular-dependency errors because materializing letrec thunks in the same group
  # creates mutual dependencies that the evaluator detects as cycles (T-1646).
  uses-scope: [fn [let module-names@Dict tc env@Dict err]
    [reduce
      [fn [let acc@[impls: Dict  stderr: Any] name]
        # Intermediate dict: path and result (type-checking side effect).
        # builtin-typecheck-doc updates tc as a side effect — TypeContext is mutable.
        # The type-stage scope is pre-seeded by lib.rs; no builtin-tc-update-type-stage-env needed.
        # result is forced via the has-key? check in impls: so that the TypeContext side-effect runs.
        # Callers access .impls; that access forces result and thus the typecheck.
        [path:   [builtin-string-concat "builtin_" [builtin-string-concat name ".llt"]]
         result: [builtin-try [call [fn []
                       [decl-handle:  [builtin-file-open %libdir path ["read"] -1 -1]]
                       [decl-bytes:   [read-file decl-handle [builtin-bytes]]]
                       [parse-result: [builtin-parse decl-bytes path]]
                       [desugared:    [builtin-desugar parse-result.program]]
                       [docs:         [builtin-program-docs desugared]]
                       [name-set:     [env-to-name-set env]]
                       [reduce
                         [fn [let acc doc]
                           [res: [builtin-resolve doc name-set]]
                           [builtin-int-add acc [builtin-dict-length [@Dict [builtin-typecheck-doc res.doc tc env].diagnostics]]]]
                         0
                         docs]]]]]
        # Return value: merge module runtime bindings into acc.impls.
        # Force result via the impls: field (TypeContext side-effect runs before impls is returned).
        # Callers that access uses-result.impls force this chain; core-tc accesses .impls explicitly.
        [impls:  [match [builtin-has-key? "ok" result]
                   0: [merge acc.impls [builtin-module name]]
                   1: [merge acc.impls [builtin-module name]]]
         stderr: acc.stderr]]
      [@[impls: Dict  stderr: Any] [impls: []  stderr: err]]
      module-names]]

  # core-tc: TypeContext pre-initialized by lib.rs with the builtin_core type-stage scope
  # (Integer, String, DirCap, Any, etc.). lib.rs calls init_type_context before running the
  # init program, so builtin-make-type-ctx is idempotent. uses-scope ["core"] enriches it
  # further with TypeSchemes from core's runtime docs (type-checking as side effect via
  # builtin-typecheck-doc). Accessing .impls forces the reduce and typecheck side-effects.
  # core-tc0 is kept so the same object is passed to uses-scope AND returned — both arms
  # of the match return the original TypeContext.
  core-tc0: [builtin-make-type-ctx]
  core-tc: [match [builtin-int-gte [builtin-dict-length [uses-scope ["core"] core-tc0 [] %stderr].impls] 0]
    0: core-tc0
    1: core-tc0]

  # ── Pragma helpers ───────────────────────────────────────────────────────────
  # pragma-no-prelude?: true if the first document in a parsed state carries
  #   pragma: ["no-prelude"]
  # builtin-doc-meta is called with [] (empty env) so pragma values must be plain literals.
  # check-pragma-docs: scan the first document's pragma list for "no-prelude".
  # Returns Boolean.True if found, Boolean.False otherwise.
  # Extracted helper so pragma-no-prelude? has no multi-body match arms.
  check-pragma-docs: [fn@Boolean [let docs]
    [meta:    [builtin-doc-meta [builtin-dict-get 0 docs] []]]
    [pragmas: [get-or [] "pragma" meta]]
    [n:       [builtin-dict-length pragmas]]
    [find: [fn@Boolean [let i]
      [match [builtin-int-gte i n]
        0: [match [builtin-eq-string [get-or "" i pragmas] "no-prelude"]
             0: [find [builtin-int-add i 1]]
             1: Boolean.True]
        1: Boolean.False]]]
    [find 0]]

  # Returns Boolean.True if the first document carries pragma: ["no-prelude"], Boolean.False otherwise.
  pragma-no-prelude?: [fn@Boolean [let state@[diagnostics: Dict  parsed: [documents: Dict]]]
    [match [builtin-eq-int [count-errors [@Dict state.diagnostics]] 0]
      0: Boolean.False  # parse failed — treat as no pragma
      1: [match [builtin-eq-int [builtin-dict-length state.parsed.documents] 0]
           1: Boolean.False  # no documents → no pragma
           0: [check-pragma-docs state.parsed.documents]]]]

  # ── Pipeline infrastructure ──────────────────────────────────────────────────
  # if-ok: pipeline combinator. Used as [prev-state | [if-ok f pre-args...]].
  # The | operator appends prev-state as the last positional arg, so if-ok receives
  # [f pre-arg0 ... pre-argN state] all variadic in ...args. State is always last.
  # Calls [f pre-arg0 ... pre-argN state] when state.diagnostics has no errors; passes state
  # through unchanged on failure. Supports 0, 1, or 2 pre-args before state.
  if-ok: [fn [let f@Callable ...args]
    [n:     [builtin-dict-length args]]
    [state: [@[diagnostics: Dict] [builtin-dict-nth args [builtin-int-sub n 1]]]]
    [match [builtin-eq-int [count-errors state.diagnostics] 0]
      0: state
      1: [match [builtin-int-sub n 1]
           0: [f state]
           1: [f [builtin-dict-nth args 0] state]
           2: [f [builtin-dict-nth args 0] [builtin-dict-nth args 1] state]
           ...: [builtin-raise "if-ok: only 0, 1, or 2 pre-args supported"]]]]

  # ── Stage: load-bytes ─────────────────────────────────────────────────────────
  # Opens state.path under cap and reads all bytes. Adds: bytes.
  load-bytes: [fn [let cap state@[path: String  diagnostics: Dict  stderr: Any]]
    [merge state [bytes: [read-file [builtin-file-open cap state.path ["read"] -1 -1] [builtin-bytes]]]]]

  # ── Stage: load-from-string ───────────────────────────────────────────────────
  # Converts a source string to bytes in state (for test programs, not files).
  load-from-string: [fn [let source state@Dict]
    [merge state [bytes: [builtin-str-bytes source]]]]

  # ── Stage: parse-source ───────────────────────────────────────────────────────
  # Parses state.bytes into state.parsed and desugars the program.
  # On parse errors: emits diagnostics via state.stderr and sets state.diagnostics.
  parse-source: [fn [let state@[path: String  bytes: Bytes  diagnostics: Dict  stderr: Any]]
    [r:     [builtin-parse state.bytes state.path]]
    [diags: [@Dict r.diagnostics]]
    [n:     [builtin-dict-length diags]]
    [err:   [emit-diagnostics diags state.stderr]]
    [match [builtin-eq-int n 0]
      0: [merge state [diagnostics: diags  stderr: err]]
      1: [call [fn [let]
           [desugared: [builtin-desugar r.program]]
           [docs: [builtin-program-docs desugared]]
           [merge state [parsed: [program: r.program  documents: docs]  stderr: err]]]]]]

  # ── Stage: eval-program ───────────────────────────────────────────────────────
  # Two-pass eval on state.parsed: type-stage documents first, then runtime.
  # Uses env-dict protocol: builtin-resolve takes name-set, builtin-eval takes
  # (lowered, env) and returns the exports Dict directly.
  # Adds: env, last-result.
  eval-program: [fn [let seed tc state@[parsed: [documents: Dict]  stderr: Any  diagnostics: Dict]]
    # Capture Boolean from the outer closure before any inner dict could shadow it.
    # bool-type ≠ Boolean, so this is not a self-reference.
    [bool-type: Boolean]
    # Seed env: seed (e.g. %prelude env ref) merged with Boolean/True/False from
    # eval-program's own closure (Dict 2's Boolean). Boolean/True/False are needed so
    # runtime docs can match on Boolean.True/Boolean.False. They are NOT forwarded to
    # builtin-tc-update-type-stage-env (which would create circular-dependency errors) —
    # uses-scope passes only the type-stage module's own exports to
    # builtin-tc-update-type-stage-env, never the full env. See uses-scope.
    [env: [merge seed [Boolean: bool-type  True: bool-type.True  False: bool-type.False]]]
    [step: [fn [let acc@[env: Dict  tc: Any  last-result: Any  stderr: Any  diagnostics: Dict] doc]
      # Short-circuit: if a previous doc in this pass already has errors, skip remaining docs.
      [match [builtin-eq-int [count-errors acc.diagnostics] 0]
        0: acc
        1: [call [fn [let]
          [hdr:   [builtin-doc-meta doc acc.env]]
          [mods:  [@[impls: Dict  stderr: Any] [uses-scope [get-or [] "uses" hdr] acc.tc acc.env acc.stderr]]]
          [scope: [merge acc.env mods.impls]]
          [names: [env-to-name-set scope]]
          [res:   [builtin-resolve doc names]]
          [err:   [emit-diagnostics res.diagnostics mods.stderr]]
          [match [builtin-eq-int [count-errors res.diagnostics] 0]
            0: [merge acc [diagnostics: [append-diags acc.diagnostics res.diagnostics]  stderr: err]]
            1: [call [fn [let]
                 [checked: [builtin-typecheck-doc res.doc acc.tc scope]]
                 [lowered: [builtin-lower checked.doc]]
                 [evaled:  [builtin-try [call [fn [] [builtin-eval lowered scope]]]]]
                 [match evaled
                   [case [let exports] [ok: exports]
                     [call [fn [let]
                       [name: [get-or "" "name" hdr]]
                       # Build env: merge exports into current env, add %: last-result and
                       # optional named doc entry so subsequent docs can reference this doc's output.
                       [env: [merge scope
                                [merge [%: exports]
                                  [match [builtin-eq-string name ""]
                                    0: [$name: exports]
                                    1: []]]]]
                       [merge acc [env: .env  tc: acc.tc  last-result: exports  stderr: err]]]]]
                   # Catch-all: evaled is an error Diagnostic. Accumulate without formatting
                   # (format-diagnostic requires narrowed Diagnostic type; evaled is a union).
                   ...: [call [fn [let]
                     [merge acc [diagnostics: [append-diags acc.diagnostics [$evaled]]  stderr: err]]]]]]]]]]]]]
    # Split documents by stage: check hdr.stage string.
    # Stage headers (--- stage: "type") are string literals — no env needed.
    # Using env here creates a circular dependency: docs forces env from the same
    # evaluation chain that ts uses env in its initial acc. Use [...] (open empty dict)
    # so the forward-reference thunk (%prelude: _prelude-env) in env is unreachable
    # from docs, breaking the cycle.
    [docs: [reduce
      [fn [let acc@[ts: Dict  rt: Dict] doc]
        [acc-ts: [@Dict [builtin-dict-get "ts" acc]]]
        [acc-rt: [@Dict [builtin-dict-get "rt" acc]]]
        [hdr:   [builtin-doc-meta doc []]]
        [stage: [get-or "runtime" "stage" hdr]]
        [match [builtin-eq-string stage "type"]
          0: [ts: acc-ts  rt: [merge acc-rt [[builtin-dict-length acc-rt]: doc]]]
          1: [ts: [merge acc-ts [[builtin-dict-length acc-ts]: doc]]  rt: acc-rt]]]
      [@[ts: Dict  rt: Dict] [ts: []  rt: []]]
      state.parsed.documents]]
    # Pass 1: evaluate type-stage documents. Accumulator threads env dict.
    [ts: [reduce step [@[env: Dict  tc: Any  last-result: Any  stderr: Any  diagnostics: Dict] [env: .env  tc: .tc  last-result: []  stderr: state.stderr  diagnostics: []]] docs.ts]]
    # Force ts once via ts-tc before rt's initial acc accesses ts multiple times.
    # Without this, rt's initial acc forces ts.env/ts.tc/ts.stderr/ts.diagnostics
    # concurrently — a diamond-DAG that triggers false InProgress cycle detection (T-1646).
    # ts-tc forces ts.tc → ts is materialized → rt's other ts.* accesses see cached value.
    [ts-tc: ts.tc]
    # Pass 2: evaluate runtime documents. Seed diagnostics from ts so pass-1 errors
    # short-circuit pass-2 docs immediately.
    [rt: [reduce step [env: ts.env  tc: ts-tc  last-result: []  stderr: ts.stderr  diagnostics: ts.diagnostics] docs.rt]]
    # Merge accumulated diagnostics into state so if-ok sees them in subsequent stages.
    [merge state
      [env:         rt.env
       last-result: rt.last-result
       stderr:      rt.stderr
       diagnostics: [append-diags state.diagnostics rt.diagnostics]]]]

  # ── Stage: export ─────────────────────────────────────────────────────────────
  # Records the exported bindings from the last document's result into state.
  # Adds: full-env — the final accumulated env with all exports merged in.
  # Callers use state.full-env wherever they previously used state.full-scope-id.
  #
  # % is stripped from full-env to prevent it leaking into test document scopes.
  # eval-program's step merges [%: exports] into env for inter-document threading,
  # but that % must not appear in the prelude-env used as the test scope — it would
  # point to the last prelude doc's result, causing abandoned-input warnings.
  # Since tinct has no dict-delete builtin, we rebuild env using a key-scan loop.
  export: [fn [let state@[last-result: Any  env: Any]]
    [exported: state.last-result]
    # Rebuild env excluding % to prevent it leaking into test document scopes.
    [keys: [builtin-keys state.env]]
    [n:    [builtin-dict-length keys]]
    [clean-env: [call [fn []
      [loop: [fn [let i b]
        [match [builtin-int-gte i n]
          0: [k: [builtin-dict-get i keys]]
             [match [builtin-eq-string k "%"]
               1: [loop [builtin-int-add i 1] b]
               0: [loop [builtin-int-add i 1] [builtin-builder-set k [builtin-dict-get k state.env] b]]]
          1: [builtin-builder-finish b]]]]
      [loop 0 [builtin-make-builder]]]]]
    [merge state [full-env: [merge clean-env exported]]]]

  # ── Stage: set-tc-ready ───────────────────────────────────────────────────────
  # Wire tc-ready without re-typechecking. eval-program already called
  # builtin-typecheck-doc for each doc in step, so tc is already enriched.
  # A second typecheck pass over the prelude is redundant and extremely expensive.
  set-tc-ready: [fn [let tc state@Dict]
    [merge state [tc-ready: tc  tc-diagnostics: []]]]]


# ============================================================================
# Dict 2 — Test runner functions
# ============================================================================
# Closures here capture Dict 1 + initial env. Prelude-specific names are
# passed as parameters so that tests run with the full prelude in scope.

[
  Boolean: [type True False]

  ProgramItem: [type
    File: [path: String  handle: Handle]
    Expr: [src:  String]
  ]

  Result: [type [let a]
    Ok:    [value: a]
    Error: [msg: String]]

  write-str: [fn [let h@[write: Callable] s] [call [builtin-dict-get "write" h] s h]]

  # extract-source: given file content, return everything before "\n=== ".
  extract-source: [fn [let content]
    [sep-pos: [builtin-str-index-of "\n=== " content]]
    [match [builtin-eq-int sep-pos -1]
      0: [builtin-str-slice content 0 sep-pos]
      1: content]]

  section-strip-nl: [fn [let sv sl]
    [match [builtin-eq-int sl 0]
      0: [match [builtin-eq-string [builtin-str-slice sv [builtin-int-add sl -1] sl] "\n"]
           0: sv
           1: [builtin-str-slice sv 0 [builtin-int-add sl -1]]]
      1: sv]]

  section-cut-at: [fn [let sv si]
    [match [builtin-eq-int si -1]
      0: [builtin-str-slice sv 0 si]
      1: sv]]

  section-trim: [fn [let bt]
    [section-strip-nl
      [section-cut-at bt [builtin-str-index-of "\n=== " bt]]
      [builtin-str-length [section-cut-at bt [builtin-str-index-of "\n=== " bt]]]]]

  extract-section: [fn [let content label]
    [sep: [join "" ["\n=== " label "\n"]]]
    [match [builtin-eq-int [builtin-str-index-of sep content] -1]
      0: [section-trim
            [builtin-str-slice
              content
              [builtin-int-add
                [builtin-str-index-of sep content]
                [builtin-str-length sep]]
              [builtin-str-length content]]]
      1: ""]]

  # ── Test pipeline stages ──────────────────────────────────────────────────────
  # These operate on the same state dict as the prelude pipeline stages (if-ok,
  # load-from-string, parse-source from Dict 1) but are test-specific:
  # eval-docs uses builtin-try to capture errors as data rather than raises,
  # manages the per-test arena, and handles caps/expects validation.

  # eval-docs: resolve+eval all documents against base-env.
  # Errors are accumulated into state.diagnostics rather than raised.
  # In tinct, match arm bodies are lazy, so a raise inside a match arm escapes any
  # surrounding builtin-try boundary. The correct pattern (matching eval-program) is
  # to accumulate resolve errors into st.diagnostics — if-ok then short-circuits
  # at the pipeline level when diagnostics has errors.
  # builtin-eval errors ARE caught via a nested builtin-try per-document.
  # Adds: env, last-result, diagnostics, doc-results, documents.
  eval-docs: [fn [let base-env@Dict state@[stderr: Any  parsed: [documents: Dict]]]
    [test-state: [@[env: Any  last-result: Any  tc: Any  stderr: Any  diagnostics: Dict  doc-index: Integer  doc-results: Any] [reduce
      [fn [let s@[env: Any  last-result: Any  tc: Any  stderr: Any  diagnostics: Dict  doc-index: Integer  doc-results: Any] doc]
        [env:     [builtin-dict-get "env"         s]]
        [prev:    [builtin-dict-get "last-result" s]]
        [tc:      [builtin-dict-get "tc"          s]]
        [err:     [builtin-dict-get "stderr"      s]]
        [diags:   [@Dict    [builtin-dict-get "diagnostics" s]]]
        [idx:     [@Integer [builtin-dict-get "doc-index"   s]]]
        [history: [builtin-dict-get "doc-results" s]]
        # Short-circuit: if a previous doc already has errors, skip remaining docs.
        [match [builtin-eq-int [count-errors diags] 0]
          0: s
          1: [call [fn [let]
            [hdr:   [builtin-doc-meta doc env]]
            [mods:  [@[impls: Dict  stderr: Any] [uses-scope [get-or [] "uses" hdr] core-tc env err]]]
            # Inject %: prev into env for non-first documents.
            # The first document (idx == 0) has no upstream %; later documents receive
            # the previous document's result as %, mirroring how prelude.llt threads % through
            # a multi-document pipeline.
            [scope: [merge env [merge mods.impls
                         [match [builtin-eq-int idx 0]
                           0: [%: prev]
                           1: []]]]]
            [names: [env-to-name-set scope]]
            [r:     [builtin-resolve doc names]]
            [err:   [emit-diagnostics r.diagnostics mods.stderr]]
            [match [builtin-eq-int [count-errors r.diagnostics] 0]
              # Resolve errors: accumulate into diagnostics (don't raise — raise is lazy
              # and escapes builtin-try; accumulation lets if-ok short-circuit at the
              # pipeline level).
              0: [merge s [diagnostics: [append-diags diags r.diagnostics]
                             stderr: err]]
              1: [call [fn [let]
                   [checked: [builtin-typecheck-doc r.doc tc scope].doc]
                   [lowered: [builtin-lower checked]]
                   # Wrap builtin-eval in builtin-try to capture eval errors as diagnostics.
                   [evaled:  [builtin-try [call [fn [] [builtin-eval lowered scope]]]]]
                   [match evaled
                     [case [let exports] [ok: exports]
                       [call [fn [let]
                          # Validate --- caps: declarations.
                          [caps-list: [get-or [] "caps" hdr]]
                          [caps-validated: [reduce
                            [fn [let result cap-name]
                              [match [builtin-cap-env-has? cap-name scope]
                                0: [builtin-raise [builtin-string-concat "missing required capability: " cap-name]]
                                1: result]]
                            exports
                            [builtin-keys caps-list]]]
                          # Validate --- expects: type annotation.
                          [expects: [get-or [] "expects" hdr]]
                          [result: [match [builtin-eq-int [builtin-dict-length expects] 0]
                            0: [builtin-check-type expects caps-validated]
                            1: caps-validated]]
                          # Update next state via merge so the return inherits s's annotated type.
                          # The type checker accepts [] initial values for diagnostics/doc-results
                          # through the s@[...] parameter annotation rather than re-verifying literals.
                          # result may be non-Dict (e.g. %.x selects a field value). Only merge
                          # result's entries into scope when it IS a Dict; always inject %: result.
                          [scope-ext: [match result Dict: result  ...: []]]
                          [merge s [env:         [merge scope [merge scope-ext [%: result]]]
                                    last-result:  result
                                    stderr:      err
                                    doc-index:   [builtin-int-add idx 1]
                                    doc-results: [merge history [$idx: result]]]]
                           ]]]
                     # Catch-all: evaled is an error Diagnostic. Accumulate without formatting.
                     ...: [call [fn [let]
                       [merge s [diagnostics: [append-diags diags [$evaled]]
                                  stderr: err]]]]]]]]]]]]
      [@[env: Any  last-result: Any  tc: Any  stderr: Any  diagnostics: Dict  doc-index: Integer  doc-results: Any]
       [env:         base-env
        last-result: []
        tc:         [get-or core-tc "tc" state]
        stderr:     state.stderr
        doc-index:  0
        diagnostics: []
        doc-results: []]]
      state.parsed.documents]]]
    [merge state
      [env:         test-state.env
       last-result:  test-state.last-result
       tc:          test-state.tc
       stderr:      test-state.stderr
       diagnostics: test-state.diagnostics
       doc-results: test-state.doc-results
       documents:   state.parsed.documents]]]

  # typecheck-docs: typecheck state.documents using tc (the ready TypeContext).
  # tc must be the enriched TypeContext from prel.tc-ready (set by set-tc-ready) —
  # so that prelude's type schemes are available for resolution.
  # Adds: tc-diagnostics.
  # tc-diagnostics includes both resolver diagnostics (res.diagnostics: errors and warnings,
  # level="error"/"warning") and typecheck diagnostics so that === warn/error sections can
  # match either kind. Callers distinguish severity by reading d.level on each entry.
  # Also runs the pipeline stage lint (builtin-lint-pipeline-docs) to emit
  # abandoned-output warnings for pipeline keys not consumed by the next stage.
  typecheck-docs: [fn [let tc base-env@Dict state@[env: Any  documents: Dict  stderr: Any  last-result: Any]]
    # doc-results from eval-docs: dict of {doc-index → result}. Used to inject % per-document
    # so abandoned-input errors only fire when the CORRECT document ignores its pipeline %.
    [doc-results: [get-or [] "doc-results" state]]
    [per-doc-diags: [match [builtin-has-key? "env" state]
      0: []
      1: [reduce
           [fn [let acc doc]
             # doc-index = number of docs already processed (length of accumulator).
             [doc-index: [builtin-dict-length acc]]
             # Per-document name-set injection: inject %: prev-result for non-first
             # documents so the resolver sees % in scope.
             [resolve-env: [match [builtin-eq-int doc-index 0]
               0: [merge state.env [%: [builtin-dict-get [builtin-int-sub doc-index 1] doc-results]]]
               1: state.env]]
             [name-set: [env-to-name-set resolve-env]]
             [res: [builtin-resolve doc name-set]]
             [typed: [builtin-typecheck-doc res.doc tc resolve-env]]
             # If % was in scope (non-first doc) but never referenced, emit abandoned-input warning.
             [input-warn-diags: [@Dict [match [builtin-int-gt doc-index 0]
               0: []
               1: [match [builtin-has-key? "%" res.unreferenced]
                    0: []
                    1: [[level: "warning"
                          kind: "abandoned-input"
                          message: "document does not reference pipeline input %"
                          span: res.doc-span
                          notes: []
                          help: []
                          secondary-spans: []
                          call-stack: []
                          macro-expand: []
                          blame: []]]]]]]
             # Collect all resolver diagnostics (res.diagnostics: errors + warnings) AND
             # typecheck diagnostics into a single list for this document.
             # res.diagnostics is the unified bag; callers read d.level to filter by severity.
             [base-diags: [reduce
               append-one
               res.diagnostics
               input-warn-diags]]
             [doc-diags: [reduce
               append-one
               base-diags
               typed.diagnostics]]
             [merge acc [[builtin-dict-length acc]: doc-diags]]]
           []
           state.documents]]]
    [all-diagnostics: [reduce
      [fn [let acc doc-diags]
        [reduce
          append-one
          acc
          doc-diags]]
      []
      per-doc-diags]]
    # Run the cross-document pipeline stage lint after per-doc resolution.
    # builtin-lint-pipeline-docs examines consecutive document pairs to detect
    # produced keys that the next stage never consumes (abandoned-output warnings).
    [pipeline-lint-diags: [builtin-lint-pipeline-docs state.documents pipeline-input: "%"]]
    [all-with-lint: [reduce
      append-one
      all-diagnostics
      pipeline-lint-diags]]
    [new-stderr: [emit-diagnostics all-with-lint state.stderr]]
    [merge state [tc-diagnostics: all-with-lint  stderr: new-stderr]]]

  # run-test-pipeline: evaluate a test source string through the full pipeline.
  # Returns a state dict with output, tc-diagnostics, and stderr: final-handle.
  # Mirrors loader.llt's cli-pipeline exactly: test program runs first, then
  # cli/out/llt.llt runs as the output formatter with % = last-result.
  # The formatter writes llt-repr(%) to a StringWriter (prelude's functional
  # string capture). Output = formatter's StringWriter.cells — same as the CLI.
  run-test-pipeline: [fn@[diagnostics: Dict  output: String  tc-diagnostics: Dict  stderr: Any] [let source path prelude-env@Dict prelude-tc stderr-h]
    [out: [make-string-handle]]
    # Parse first so pragma headers are available before the env is constructed.
    # .path references the function parameter from the parent scope, not the letrec
    # binding 'path' that this dict creates — avoiding a trivial self-reference.
    [state: [[path: .path  diagnostics: []  stderr: stderr-h]
                    | [if-ok load-from-string source]
                    | [if-ok log-step "  parsing"]
                    | [if-ok parse-source]]]
    # pragma: ["no-prelude"] → use empty env (no prelude); default → prelude.
    [env: [match [pragma-no-prelude? state]
                   Boolean.False: prelude-env
                   Boolean.True:  []]]
    # For no-prelude tests, use core-tc (no prelude types needed).
    [tc: [match [pragma-no-prelude? state]
                 Boolean.False: prelude-tc
                 Boolean.True:  core-tc]]
    # Create an emit channel for the test program. The test program sends emitted
    # values here via [emit v]; the formatter drains it via recv-all.
    [emit-ch: [builtin-channel]]
    [scope: [merge env
                  [%cwd:          .%cwd
                   %libdir:       .%libdir
                   %stdout:       out
                   %stderr:       .%stderr
                   %args:         .%args
                   %emit-channel: emit-ch]]]
    [test-result: [$state
      | [if-ok log-step "  evaluating"]
      | [if-ok eval-docs scope]
      | [if-ok log-step "  typechecking"]
      | [if-ok typecheck-docs tc scope]]]
    # Run cli/out/llt.llt as the output formatter (second pipeline stage).
    # Only runs when the test program succeeded (no eval errors).
    # %stdout is a StringWriter.Writer (prelude's functional string capture);
    # llt.llt writes llt-repr(%) to it. The flushed writer is last-result;
    # .cells contains the formatted output string.
    [match [builtin-eq-int [count-errors test-result.diagnostics] 0]
      0: [merge test-result [output: ""  tc-diagnostics: []]]
      1: [call [fn [let]
           [sw: [StringWriter.Writer cells: ""]]
           [fmt-scope: [merge scope [%: test-result.last-result  %stdout: sw  %emit-channel: emit-ch]]]
           [fmt-result: [[path: "cli/out/llt.llt"  diagnostics: []  stderr: test-result.stderr  tc: prelude-tc]
             | [if-ok load-bytes %libdir]
             | [if-ok log-step "  formatting"]
             | [if-ok parse-source]
             | [if-ok eval-docs fmt-scope]]]
           [output: [match [builtin-eq-int [count-errors fmt-result.diagnostics] 0]
             0: ""
             1: fmt-result.last-result.cells]]
           [merge test-result [output: .output
                                stderr: fmt-result.stderr
                                diagnostics: [append-diags test-result.diagnostics fmt-result.diagnostics]]]]]]]

  # path-has-component: true if path contains "/component/" as a path segment.
  path-has-component: [fn [let path component]
    [match [builtin-eq-int [builtin-str-index-of [join "" ["/" component "/"] ] path] -1]
      0: Boolean.True
      1: Boolean.False]]

  # check-path-sections: enforce that warn/error sections only appear in
  # appropriately named directories.
  check-path-sections: [fn [let path expected-warn expected-error actual-out]
    [in-warnings: [path-has-component path "warnings"]]
    [in-errors:   [path-has-component path "errors"]]
    [warn-ok: [match [builtin-eq-string expected-warn ""]
                0: in-warnings
                1: Boolean.True]]
    [error-ok: [match [builtin-eq-string expected-error ""]
                  0: in-errors
                  1: [match [builtin-eq-int [builtin-str-index-of "ERROR:" actual-out] 0]
                       0: Boolean.True
                       1: in-errors]]]
    [match [bool->int warn-ok]
      0: [join "" ["=== warn section not allowed outside warnings/ directory: " path]]
      ...: [match [bool->int error-ok]
           0: [match [builtin-eq-string expected-error ""]
                0: [join "" ["=== error section not allowed outside errors/ directory: " path]]
                1: [join "" ["ERROR: output not allowed outside errors/ directory: " path]]]
           ...: ""]]]

  # check-warn: validate typecheck warnings against the expected-warn section.
  check-warn: [fn [let warnings@Dict expected-warn]
    [warn-count: [builtin-dict-length warnings]]
    [warn-text: [reduce
      [fn [let acc w@[message: String]] [builtin-string-concat acc [builtin-string-concat [match [builtin-eq-string acc ""]
                                                                           0: "\n"
                                                                           1: ""] w.message]]]
      ""
      warnings]]
    [match [builtin-eq-string expected-warn ""]
      0: [match [builtin-eq-int [builtin-str-index-of expected-warn warn-text] -1]
           0: ""
           1: [join "" ["expected warning not found:\n  " expected-warn "\nactual:\n  " warn-text]]]
      1: [match [builtin-eq-int warn-count 0]
           0: [join "" ["expected no warnings, got:\n" warn-text]]
           1: ""]]]

  # run-test-file: execute a single file ProgramItem. Takes stderr-h from run-test.
  # Returns result dict including stderr: err so the cascade continues.
  run-test-file: [fn [let p prelude-env@Dict prelude-tc stderr-h]
    [bytes:          [read-file p.handle [builtin-bytes]]]
    [content:        [builtin-bytes-str bytes]]
    [source:         [extract-source content]]
    [expected-out:   [extract-section content "out"]]
    [expected-warn:  [extract-section content "warn"]]
    [expected-error: [extract-section content "error"]]

    # Run test through the pipeline. Errors are returned as state.diagnostics (no builtin-try needed).
    [run:      [@[diagnostics: Dict  output: String  tc-diagnostics: Dict  stderr: Any] [run-test-pipeline source p.path prelude-env prelude-tc stderr-h]]]
    [diags:    [@Dict run.diagnostics]]
    [output:   [@String run.output]]
    [tc-diags: [@Dict run.tc-diagnostics]]
    [err:      run.stderr]

    [ok: [builtin-eq-int [count-errors diags] 0]]

    # Extract the formatter output or a formatted diagnostic on error.
    # Use format-diagnostic (not just .message) so the error output includes definition
    # span, evaluation chain (secondary-spans), and call-stack — not just the bare message.
    [raw-output: [match ok
        0: [format-diagnostic [builtin-dict-nth diags 0]]
        1: output]]

    # Strip trailing newline from formatter output (formatters add a final \n).
    [actual: [match ok
        0: raw-output
        1: [strip-trailing-newline raw-output]]]

    [eval-warnings: [match ok 0: [] 1: tc-diags]]

    # === error: substring match; === out: exact match
    [out-passed: [match [builtin-eq-string expected-error ""]
                   0: [match [builtin-eq-int [builtin-str-index-of expected-error actual] -1]
                        0: 1
                        1: 0]
                   1: [builtin-eq-string actual expected-out]]]

    [path-fail: [check-path-sections p.path expected-warn expected-error actual]]
    [path-passed: [builtin-eq-string path-fail ""]]

    [warn-fail: [match ok
      0: ""
      1: [check-warn eval-warnings expected-warn]]]
    [warn-passed: [builtin-eq-string warn-fail ""]]

    [r-path:    p.path]
    [r-passed:  [match out-passed
      0: Boolean.False
      1: [match warn-passed
           0: Boolean.False
           1: [match path-passed
                0: Boolean.False
                1: Boolean.True]]]]
    [r-actual:  [match path-passed
                  0: [join "" ["out: " actual "\npath: " path-fail]]
                  1: [join "" [
                       [match out-passed
                         0: [join "" ["out: "  actual    "\n"]]
                         1: ""]
                       [match warn-passed
                         0: [join "" ["warn: " warn-fail "\n"]]
                         1: ""]]]]]
    [r-expected: [match path-passed
                   0: [join "" ["out: "
                         [match [builtin-eq-string expected-error ""]
                           0: expected-error
                           1: expected-out]]]
                   1: [join "" [
                        [match out-passed
                          0: [join "" ["out: "
                               [match [builtin-eq-string expected-error ""]
                                 0: expected-error
                                 1: expected-out]
                               "\n"]]
                          1: ""]
                        [match warn-passed
                          0: [join "" ["warn: " expected-warn "\n"]]
                          1: ""]]]]]
    [path: r-path  passed: r-passed  actual: r-actual  expected: r-expected
     stderr: err]]

  # run-test: run one ProgramItem as a corpus test.
  # Takes stderr-h so the "test: path" log write threads into the data-flow cascade.
  # Returns result dict including stderr: updated-handle so the outer reduce can chain it.
  run-test: [fn [let item prelude-env@Dict prelude-tc stderr-h]
    [p:         [match item
                  ProgramItem.File: item.path
                  ...:              "<expr>"]]
    [new-stderr: [call [builtin-dict-get "write" %stderr] [builtin-string-concat "test:    " [builtin-string-concat p "\n"]] stderr-h]]
    [base-result: [match item
      ProgramItem.File: [run-test-file item prelude-env prelude-tc new-stderr]
      ProgramItem.Expr: [path: "<expr>"  passed: Boolean.True  actual: ""  expected: ""  stderr: new-stderr]]]
    base-result]

  # format-result: render test outcome line.
  format-result: [fn [let r@[path: String  passed: Boolean  actual: String  expected: String]]
    [builtin-string-concat r.path
      [builtin-string-concat " ... "
        [match r.passed
          Boolean.False: [builtin-string-concat "FAIL\n"
               [builtin-string-concat "  expected: "
                 [builtin-string-concat r.expected
                   [builtin-string-concat "\n  actual:   "
                     [builtin-string-concat r.actual "\n"]]]]]
          Boolean.True: "pass\n"]]]]

  # check-llt-eval: true if a filename ends with ".llt-eval".
  check-llt-eval: [fn [let name]
    [len: [builtin-str-length name]]
    [match [builtin-lt len 9]
      0: [builtin-eq-string [builtin-str-slice name [builtin-int-sub len 9] len] ".llt-eval"]
      1: 0]]

  # find-corpus-files: recursively walk cap/dir-path, accumulate .llt-eval files.
  # Each discovered file is wrapped as ProgramItem.File { path, handle } matching
  # the protocol from main.rs. The handle is a pre-opened readable file.
  find-corpus-files: [fn@Dict [let cap dir-path state@Dict]
    [entries: [builtin-list-dir cap dir-path]]
    [reduce
      [fn [let st entry@[name: String  type: String]]
        [full: [join "" [$dir-path "/" entry.name]]]
        [match [builtin-eq-string entry.type "dir"]
          0: [match [check-llt-eval entry.name]
               0: st
               1: [merge st [[builtin-dict-length st]:
                      [ProgramItem.File path: full  handle: [builtin-file-open cap full ["read"] -1 -1]]]]]
          1: [find-corpus-files cap full st]]]
      state
      entries]]
]

# ============================================================================
# Dict 3 — Load prelude, pre-parse formatter, run tests
# ============================================================================

[
  # Prelude loading pipeline. Each stage short-circuits via if-ok when diagnostics has errors.
  # B-688: TypeAssert weakened to [diagnostics: Dict  stderr: Any] — the fields that are
  # always present regardless of which if-ok stage short-circuits. full-env and tc-ready are
  # only added by export/set-tc-ready (late stages); on early failure they don't exist.
  # Dummy %prelude: [] seed — breaks the B-688 cycle (prelude-env → prel.full-env →
  # eval-program → prelude-env). During prelude's own loading, %prelude is only captured
  # in the `include` closure, never forced. A [] placeholder satisfies the resolver so
  # prelude docs can reference %prelude without a resolve error.
  prel: [@[diagnostics: Dict  stderr: Any] [[path: "prelude.llt"  diagnostics: []  stderr: %stderr]
    | [if-ok log-step "prelude: loading"]
    | [if-ok load-bytes %libdir]
    | [if-ok log-step "prelude: parsing"]
    | [if-ok parse-source]
    | [if-ok log-step "prelude: evaluating"]
    | [if-ok eval-program
        [%prelude: []]
        core-tc]
    | [if-ok export]
    | [if-ok set-tc-ready core-tc]
    | [if-ok log-step "prelude: ready"]]]

  # Fatal boundary: typecheck ERRORS on prelude mean execution is undefined behavior.
  # Type-checker warnings (tc-diagnostics) are advisory and non-fatal — valid prelude functions
  # may produce warnings (e.g. exhaustiveness warnings for intentionally type-restricted
  # variadics like bor-all). Only errors prevent loading.
  # Raise here (outside any builtin-try) so the error propagates to the top level.
  # prelude-env is the gating name: all test code that uses prelude goes through it so
  # prelude loading errors propagate rather than being caught by per-test builtin-try.
  prelude-env: [match [builtin-eq-int [count-errors [@Dict prel.diagnostics]] 0]
    0: [builtin-raise [join "" ["prelude failed — cannot continue\n"
          [reduce [fn [let acc d] [builtin-string-concat acc [builtin-string-concat [format-diagnostic d] "\n"]]]
                  "" [@Dict prel.diagnostics]]]]]
    1: prel.full-env]

  # Pre-parse cli/out/llt.llt once (parse only — NOT resolved).
  # Resolution happens per-test inside run-test-pipeline with fmt-env
  # (prelude + % = test result + capture stdout), exactly as the CLI does.
  formatter-src: [call [fn []
    [parse-result: [builtin-parse
                     [read-file [builtin-file-open %libdir "cli/out/llt.llt" ["read"] -1 -1] [builtin-bytes]]
                     "cli/out/llt.llt"]]
    # If the formatter has parse errors, raise — formatter-ok's builtin-try catches this.
    # The raise message includes formatted diagnostics so the error is not silently swallowed.
    # On success (no errors), return the program directly; no emit needed for empty diagnostics.
    [match [builtin-eq-int [builtin-dict-length parse-result.diagnostics] 0]
      0: [builtin-raise [reduce [fn [let acc d] [builtin-string-concat acc [format-diagnostic d]]]
                                 "cli/out/llt.llt parse errors:\n" parse-result.diagnostics]]
      1: parse-result.program]]]

  # Bootstrap check: verify the formatter loaded correctly.
  # On failure, print the actual error from builtin-try and raise — never silently swallow it.
  formatter-ok: [call [fn [let _raw]
      [match [builtin-has-key? "ok" _raw]
        0: [call [fn [let _w]
                    [match [builtin-int-gte [builtin-dict-length _w] 0]
                      0: [builtin-raise "llt.llt formatter failed to load"]
                      1: [builtin-raise "llt.llt formatter failed to load"]]]
              [call [builtin-dict-get "write" %stderr]
                [builtin-string-concat "\nbootstrap error: llt.llt formatter failed to load\nCannot run corpus tests.\nCause: "
                  [builtin-string-concat
                    [match [builtin-has-key? "message" _raw]
                      0: "(unknown — try result has no message field)"
                      1: [@String [@[message: String] _raw].message]]
                    "\n"]] %stderr]]
        1: 1]]
    [builtin-try [builtin-program-docs formatter-src]]]

  # Discover test files (or use the ones given on the command line).
  # Both formatter-ok and prelude diagnostics are hard gates: any prelude error
  # means the test environment is undefined — running tests would produce false results.
  tests: [match [builtin-eq-int formatter-ok 1]
    0: []
    1: [match [builtin-eq-int [count-errors [@Dict prel.diagnostics]] 0]
      0: [builtin-raise [join "" ["\nprelude has "
            [builtin-int->string [count-errors [@Dict prel.diagnostics]]]
            " error(s) — cannot run tests\n"
            [reduce
              [fn [let acc d@[level: String  kind: String  message: String  span: Any  call-stack: Any  notes: Any  help: Any  blame: Any  macro-expand: Any  secondary-spans: Any]]
                [match [builtin-eq-string d.level "error"]
                  0: acc
                  1: [builtin-string-concat acc [builtin-string-concat [format-diagnostic d] "\n"]]]]
              "" [@Dict prel.diagnostics]]]]]
      1: [match [null? %programs]
           0: %programs
           ...: [find-corpus-files
                 [builtin-narrow %cwd "tests/corpus"]
                 "."
                 []]]]]

  run: [reduce
    [fn [let s@[idx: Any  total: Any  passed: Any  first-fail: Any  stdout: Any  stderr: Any] item]
      # run-test takes the current stderr handle and returns result including result.stderr.
      [result: [@[path: String  passed: Boolean  actual: String  expected: String  stderr: Any] [run-test item prelude-env prel.tc-ready s.stderr]]]
      # Thread stdout and stderr handles forward — each write returns the next handle.
      # Both chains collapse when the final dict's stdout/stderr fields are forced.
      [new-stdout: [call [builtin-dict-get "write" %stdout] [format-result result] s.stdout]]
      [delta: [match result.passed Boolean.False: 0 Boolean.True: 1]]
      [idx:        [builtin-int-add s.idx 1]
       total:      [builtin-int-add s.total 1]
       passed:     [builtin-int-add s.passed delta]
       first-fail: [match [builtin-eq-string s.first-fail ""]
                     0: s.first-fail
                     1: [match result.passed
                          Boolean.False: [join "" [$result.path "\n  expected: " $result.expected "\n  actual:   " $result.actual]]
                          Boolean.True:  ""]]
       stdout:     new-stdout
       stderr:     result.stderr]]
    # Seed stderr with prel.stderr so the prelude loading chain and each
    # test's chain are linked: the first test's result.stderr forces prel.stderr,
    # and subsequent tests chain from there. Both streams share a single contiguous handle chain.
    [idx: 0  total: 0  passed: 0  first-fail: ""  stdout: %stdout  stderr: prel.stderr]
    tests]
]

# ============================================================================
# Final expression — summary + exit code
# ============================================================================

# The final result dict contains the flush results for both streams.
# Any consumer of the result accesses both fields, naturally evaluating both flush chains.
[prelude-error-count:
  [reduce [fn [let acc d@[level: String]] [builtin-int-add acc [match [builtin-eq-string d.level "error"] 0: 0 1: 1]]]
          0
          [@Dict prel.diagnostics]]]
[n-failed: [builtin-int-add prelude-error-count [builtin-int-sub run.total run.passed]]]
[summary-stdout: [call [builtin-dict-get "write" %stdout] [join "" [
    "\n"
    [builtin-int->string run.passed] "/" [builtin-int->string run.total] " tests passed"
    [match [builtin-eq-int n-failed 0]
      0: [join "" [", " [builtin-int->string n-failed] " failed\n" run.first-fail "\n"]]
      1: "\n"]]]
  run.stdout]]
[merge [%stdout.flush summary-stdout] [%stderr.flush [@[stderr: Any] run].stderr]]
