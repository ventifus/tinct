# stdlib/test-loader.llt
#
# Self-contained corpus test runner — an alternative init program for use with:
#   tinct run --init stdlib/test-loader.llt tests/corpus/eval/*.llt-eval
#
# Receives the same initial environment as loader.llt:
#   %programs  — integer-keyed Dict of ProgramItem variants (one per test file)
#   %args      — CLI flags dict
#   %cwd       — DirCap for working directory
#   %libdir    — DirCap for stdlib
#   %stdout    — protocol dict for output (write, flush, close methods)
#
# Test file format (*.llt-eval):
#   <tinct source>
#   === out
#   <expected repr string>
#   === warn          (optional)
#   <expected warning substring>
#
# If === warn is absent, the test asserts zero typecheck warnings.
# If === warn is present, it asserts the substring appears in the joined warnings.
#
# Path-based section enforcement:
#   === warn sections are only permitted in tests under a warnings/ path component.
#   ERROR: output  is only permitted in tests under an errors/ path component.
#   Normal tests (all other paths) must produce clean output with zero warnings.
#
# Each test is run as a two-program pipeline: [test.llt, cli/out/llt.llt]
# with prelude threaded through both — exactly as the CLI does. The formatter
# output is captured via a string-handle replacing %stdout during the run.
#
# Structure — THREE DICTS:
#   Dict 1: private helpers (loader-level builtins only)
#   Dict 2: test pipeline functions (sees Dict 1 + initial env)
#   Dict 3: load prelude, run all tests, write summary to %stdout

# ============================================================================
# Dict 1 — Private helpers (loader-level builtins only)
# ============================================================================

[
  # Boolean declared here so dict 1 helpers can use Boolean.True/False.
  Boolean: [type True False]

  # reduce and join defined here using core builtins only.
  # Dict 1 helpers need these but prelude is not yet loaded.
  _reduce-loop: [fn [let f acc xs i len]
    [match [builtin-int-gte i len]
      0: [_reduce-loop f [f acc [builtin-get i xs]] xs [builtin-int-add i 1] len]
      _: acc]]
  reduce: [fn [let f init xs] [_reduce-loop f init xs 0 [builtin-dict-length xs]]]

  _join-loop: [fn [let sep acc xs i len]
    [match [builtin-int-gte i len]
      0: [_join-loop sep
            [match [builtin-eq-int i 0]
              0: [builtin-string-concat acc [builtin-string-concat sep [builtin-get i xs]]]
              _: [builtin-get 0 xs]]
            xs [builtin-int-add i 1] len]
      _: acc]]
  join: [fn [let sep xs] [_join-loop sep "" xs 0 [builtin-dict-length xs]]]

  # bool->int: Boolean.False→0, Int pass-through, anything else→1.
  bool->int: [fn [let b] [match b Boolean.False: 0 [@Integer _]: b _: 1]]

  # %stdout and %stderr: protocol dicts wrapping the stateless Rust builtins.
  # These MUST be defined here because test-loader runs as --init and main.rs
  # does not inject %stdout/%stderr (that's loader.llt's job for normal runs).
  %stdout: [write:  [fn [let s h] [builtin-write-stdout s h]]
            flush:  [fn [let h] h]
            close:  [fn [let h] h]]
  %stderr: [write:  [fn [let s h] [builtin-write-stderr s h]]
            flush:  [fn [let h] h]
            close:  [fn [let h] h]]

  bytes-empty?: [fn [let b] [builtin-eq-int [builtin-dict-length b] 0]]

  # make-entry: construct single-entry dict from key and value.
  # Defined here for Dict 1 because it runs before prelude is loaded.
  make-entry: [fn [let k v] [$k: v]]

  # dot-access-env: minimal env with only field-get and slot-get for use as seed base.
  # T-1571: builtin-extend-env now returns {env, flat-env-id}; extract .env and flat-env-id
  dot-access-env-result: [builtin-extend-env [] [field-get: .field-get  slot-get: .slot-get]]
  dot-access-env: dot-access-env-result.env
  dot-access-flat-env-id: dot-access-env-result.flat-env-id

  merge: [fn [let a b]
    [_copy: [fn [let builder d n i]
      [match [builtin-int-gte i n]
        0: builder
        _: [_copy
              [builtin-builder-set builder [builtin-dict-nth d i] [builtin-dict-key-nth d i]]
              d n [builtin-int-add i 1]]]]]
    [builtin-builder-finish
      [_copy [_copy [builtin-make-builder] a [builtin-dict-length a] 0]
             b [builtin-dict-length b] 0]]]

  read-file: [fn [let handle acc]
    [chunk: [builtin-file-read handle 65536]]
    [match [bytes-empty? chunk]
      0: [read-file handle [builtin-bytes-concat acc chunk]]
      _: acc]]

  # make-string-handle: a write handle backed by a builder that accumulates to a string.
  # Uses ONLY core builtins — no prelude functions. Safe in Dict 1 bootstrap context.
  make-string-handle: [fn []
    [buf: [builtin-make-builder]]
    [self:
      [write:  [fn [let s h]
                 [wrote: [builtin-builder-set [builtin-dict-length [builtin-builder-snapshot buf]] s buf]]
                 [match [builtin-int-gt [builtin-dict-length [builtin-builder-snapshot wrote]] -1]
                   0: h
                   _: h]]
       flush:  [fn [let h] h]
       close:  [fn [let h] h]
       read:   [fn []
                 [snap: [builtin-builder-snapshot buf]]
                 [reduce
                   [fn [let acc k] [builtin-string-concat acc [builtin-get k snap]]]
                   ""
                   [builtin-keys snap]]]]]
    self]

  # strip-trailing-newline: remove one trailing \n from a string.
  strip-trailing-newline: [fn [let s]
    [n: [builtin-str-length s]]
    [match [builtin-int-gt n 0]
      0: s
      _: [builtin-str-slice s 0 [builtin-int-sub n 1]]]]

  # Format a single diagnostic dict as a human-readable error line.
  format-diagnostic: [fn [let d]
    [s: d.span]
    [file-part: [match [builtin-eq-int [builtin-dict-length s.file] 0]
      0: [builtin-string-concat s.file ":"]
      _: "<unknown>:"]]
    [loc: [builtin-string-concat file-part [builtin-string-concat [builtin-int->string s.start-line] [builtin-string-concat ":" [builtin-int->string s.start-col]]]]]
    [stack-empty: [builtin-eq-int [builtin-dict-length d.call-stack] 0]]
    [label: [match [builtin-eq-string d.kind "resolve-error"]
              0: [match [builtin-eq-string d.kind "undefined-variable"]
                   0: [match [builtin-eq-string d.kind "user-error"]
                        0: d.kind
                        _: "error"]
                   _: [match stack-empty
                        0: "runtime"
                        _: "resolve"]]
              _: "resolve"]]
    [base-line: [builtin-string-concat loc [builtin-string-concat ": " [builtin-string-concat label [builtin-string-concat ": " [builtin-string-concat d.message "\n"]]]]]]
    [notes-empty: [builtin-eq-int [builtin-dict-length d.notes] 0]]
    [with-notes: [match notes-empty
      0: [reduce
            [fn [let acc note] [builtin-string-concat acc [builtin-string-concat note "\n"]]]
            base-line
            d.notes]
      _: base-line]]
    [match stack-empty
      0: [reduce
            [fn [let acc frame]
              [frame-file: [match [builtin-eq-int [builtin-dict-length frame.span.file] 0]
                0: [builtin-string-concat frame.span.file ":"]
                _: ""]]
              [builtin-string-concat acc [builtin-string-concat "  in " [builtin-string-concat frame.label [builtin-string-concat " at " [builtin-string-concat frame-file [builtin-string-concat [builtin-int->string frame.span.start-line] [builtin-string-concat ":" [builtin-string-concat [builtin-int->string frame.span.start-col] "\n"]]]]]]]]]
            with-notes
            d.call-stack]
      _: with-notes]]

  # _emit-loop: index-based recursion that writes each diagnostic and returns the
  # count of items written. The count is USED by callers (in n-total) so it is on
  # the materialization path — this is what forces all the writes.
  # Each iteration: write d_i, use the write result's length (always >= 0) as proof
  # the write happened, add 1 to the running count.
  _emit-loop: [fn [let diags i len acc]
    [match [builtin-int-gte i len]
      0: [_emit-loop diags [builtin-int-add i 1] len
            [builtin-int-add acc
              [builtin-int-gte
                [builtin-dict-length [%stderr.write [format-diagnostic [builtin-get i diags]] %stderr]]
                0]]]
      _: acc]]

  # emit-diagnostics: write all diagnostics to stderr, return the count written.
  # Returns 0 for empty (so bare-eval's [n-parse + _pe = 0] check still works).
  emit-diagnostics: [fn [let diagnostics]
    [_emit-loop diagnostics 0 [builtin-dict-length diagnostics] 0]]

  # uses-scope: for each module name, parse+typecheck its declaration file and
  # accumulate a flat Dict of runtime builtin implementations.
  # Declaration files (builtin_NAME.llt) are optional — if absent, builtin-try
  # catches the error. Typecheck is forced via typed.warnings data dependency (no >>).
  # seed-tc: the TypeContext to use for all module type-checks.
  # Caller builds it explicitly — no implicit global fallback. This is the same
  # pattern as full-env: the init program controls what environments downstream sees.
  uses-scope: [fn [let module-names seed-tc]
    [reduce
      [fn [let acc name]
        [decl-path:   [builtin-string-concat "builtin_" [builtin-string-concat name ".llt"]]
         tc-result:   [builtin-try [fn []
             [decl-handle:    [builtin-file-open %libdir decl-path "read"]]
             [decl-bytes:     [read-file decl-handle [builtin-bytes]]]
             [parse-result:   [builtin-parse decl-bytes decl-path]]
             # builtin-resolve requires Value::Environment for env: — use empty root env.
             [decl-env-result: [builtin-extend-env dot-access-env [] flat-env: dot-access-flat-env-id]]
             [decl-env:        decl-env-result.env]
             [resolve-errors: [reduce
               [fn [let acc doc]
                 [r: [builtin-resolve doc env: decl-env]]
                 [builtin-int-add acc [builtin-dict-length r.errors]]]
               0
               parse-result.program.documents]]
             [typed:          [builtin-typecheck parse-result.program seed-tc]]
             [match [builtin-eq-int resolve-errors 0]
               0: typed.warnings
               _: typed.warnings]]]
         warnings:    [match [builtin-has-key? "ok" tc-result]
             0: []
             _: [builtin-get "ok" tc-result]]
         n-w:         [emit-diagnostics warnings]
         module-impl: [builtin-module name]]
        # n-w (count of warnings written) is the condition — forces all writes before merge.
        [match [builtin-int-gte n-w 0]
          0: [merge acc module-impl]
          _: [merge acc module-impl]]]
      []
      module-names]]

  # Fundamental-types TypeContext: start from an empty TypeContext and populate
  # it by type-checking builtin_core.llt. Same pattern as loader.llt — no
  # implicit Rust back-channel. Core types (DirCap, Int, Bytes, etc.) are
  # available to all downstream builtin-typecheck calls via this explicit seed.
  _fundamental-base-tc: [builtin-make-type-ctx]
  fundamental-tc: [match [builtin-int-gte [builtin-dict-length [uses-scope ["core"] _fundamental-base-tc]] 0]
    0: _fundamental-base-tc
    _: _fundamental-base-tc]

  # bare-eval: load and evaluate a tinct file with an explicit seed env extension.
  # extras: dict of additional bindings injected into the seed before evaluation.
  # --- uses: headers are applied per-document in the eval loop below.
  # parse-result.program.documents is an integer-keyed Dict (field-get on Program returns Dict, not Seq).
  # builtin-reduce on a Dict is correct here.
  bare-eval: [fn [let cap path extras]
    [handle:        [builtin-file-open cap path "read"]]
    [bytes:         [read-file handle [builtin-bytes]]]
    [parse-result:  [builtin-parse bytes path]]
    # Stop on parse errors. n-parse + _pe = 0 iff no errors (both are counts from emit-diagnostics).
    [n-parse:  [builtin-dict-length parse-result.errors]
     _pe:      [emit-diagnostics parse-result.errors]
     seed-env-result: [match [builtin-eq-int [builtin-int-add n-parse _pe] 0]
       0: [builtin-raise [join "" [[builtin-int->string n-parse] " parse error(s) in " path]]]
       _: [builtin-extend-env dot-access-env extras flat-env: dot-access-flat-env-id]]
     seed-env: seed-env-result.env
     seed-flat-env-id: seed-env-result.flat-env-id]
    # Pass 1 (type-stage): evaluate type-stage documents to build ts-env.
    # Seed with Boolean/True/False so TypeNode annotation dicts (guarding: True/False)
    # can be resolved correctly. These are needed for the type-stage dict to evaluate.
    # acc is {env, flat-env-id} to thread display ancestry through each doc (T-1563).
    [ts-seed-result: [builtin-extend-env seed-env
      [Boolean: Boolean  True: Boolean.True  False: Boolean.False]
      flat-env: seed-flat-env-id]
     ts-seed: ts-seed-result.env
     ts-seed-flat-env-id: ts-seed-result.flat-env-id]
    [ts-acc: [reduce
      [fn [let acc doc]
        [doc-env-result: [builtin-extend-env acc.env [uses-scope doc.uses fundamental-tc] flat-env: acc.flat-env-id]
         doc-env:        doc-env-result.env
         doc-flat-env-id: doc-env-result.flat-env-id
         resolved:       [builtin-resolve doc env: doc-env]
         n-re:       [builtin-dict-length resolved.errors]
         _re:        [emit-diagnostics resolved.errors]
         eval-result:[match [builtin-eq-int [builtin-int-add n-re _re] 0]
           0: [builtin-raise [join "" [[builtin-int->string n-re] " resolve error(s) in " path]]]
           _: [match [builtin-eq-string [builtin-type-of acc.flat-env-id] "Int"]
                0: [builtin-eval resolved.doc env: doc-env]
                _: [builtin-eval resolved.doc env: doc-env flat-env: acc.flat-env-id]]]]
        [match [builtin-eq-string [builtin-type-of eval-result.error] "String"]
          0: [env-result:  [builtin-extend-env eval-result.env
                             [make-entry
                               [match [builtin-eq-string eval-result.doc-name ""]
                                 0: eval-result.doc-name
                                 _: "%"]
                               eval-result.result]
                             flat-env: doc-flat-env-id]
              env:         env-result.env
              flat-env-id: eval-result.flat-env-id]
          _: [builtin-raise eval-result.error]]]
      [env: ts-seed  flat-env-id: ts-seed-flat-env-id]
      [reduce
        [fn [let acc doc]
          [match [builtin-eq-string [builtin-tag-of doc.stage] "DocStage.Type"]
            0: acc
            _: [merge acc [make-entry [builtin-dict-length acc] doc]]]]
        []
        parse-result.program.documents]]]
    # ts-env: the env built from the type-stage pass. ts-acc carries both env + flat-env-id.
    [ts-env: ts-acc.env]
    # Wire ts-env into the TypeContext so type-stage functions are available during type-checking.
    [_tc: [builtin-tc-with-type-stage-env fundamental-tc ts-env]]
    # Pass 2 (runtime): evaluate all non-type-stage documents starting from ts-acc.
    # state is {env, flat-env-id, last-result} to thread display ancestry (T-1563).
    [final-state: [reduce
      [fn [let state doc]
        [done:           [builtin-eq-string [builtin-tag-of doc.stage] "DocStage.Type"]
         env:            state.env
         doc-env-result: [builtin-extend-env env [uses-scope doc.uses fundamental-tc] flat-env: state.flat-env-id]
         doc-env:        doc-env-result.env
         doc-flat-env-id: doc-env-result.flat-env-id
         resolved:       [builtin-resolve doc env: doc-env]
         n-re:       [builtin-dict-length resolved.errors]
         _re:        [emit-diagnostics resolved.errors]
         eval-result:[match [builtin-eq-int [builtin-int-add n-re _re] 0]
           0: [builtin-raise [join "" [[builtin-int->string n-re] " resolve error(s) in " path]]]
           _: [match [builtin-eq-string [builtin-type-of state.flat-env-id] "Int"]
                0: [builtin-eval resolved.doc env: doc-env]
                _: [builtin-eval resolved.doc env: doc-env flat-env: state.flat-env-id]]]
         new-env-result: [builtin-extend-env eval-result.env
           [make-entry
             [match [builtin-eq-string eval-result.doc-name ""]
               0: eval-result.doc-name
               _: "%"]
             eval-result.result]
           flat-env: doc-flat-env-id]
         new-env:        new-env-result.env]
        [match done
          0: [match [builtin-eq-string [builtin-type-of eval-result.error] "String"]
               0: [env: new-env  flat-env-id: eval-result.flat-env-id  last-result: eval-result.result]
               _: [builtin-raise eval-result.error]]
          _: state]]
      [env: ts-env  flat-env-id: ts-acc.flat-env-id  last-result: []]
      parse-result.program.documents]]
    # Promote last document's exported dict entries into the env so bare names resolve.
    [final-env: final-state.env]
    [exported: [match [builtin-eq-string [builtin-type-of final-state.last-result] "Dict"]
      0: []
      _: final-state.last-result]]
    [full-env-result: [builtin-extend-env final-env exported flat-env: final-state.flat-env-id]]
    [full-env: full-env-result.env]
    # Resolve each document individually with full-env (document path, not program path).
    # builtin-resolve now only accepts Document — the program path was removed.
    # Errors are emitted immediately and counted. AST nodes are mutated in-place with
    # de Bruijn coords so the typecheck pass can read them from parse-result.program.
    [tc-error-count: [reduce
      [fn [let total doc]
        [r:        [builtin-resolve doc env: full-env]
         n-e:      [builtin-dict-length r.errors]
         _emitted: [emit-diagnostics r.errors]]
        # Force _emitted (writes errors) then add n-e to the running total.
        [match [builtin-int-gte [builtin-int-add n-e _emitted] 0]
          0: [builtin-int-add total n-e]
          _: [builtin-int-add total n-e]]]
      0
      parse-result.program.documents]]
    [typed: [builtin-typecheck parse-result.program _tc env: full-env]]
    # Return errors and warnings as data. tc-errors is a count (Int): resolve errors
    # were already emitted during the per-document resolve loop above.
    # flat-env-id from the last evaluated doc is threaded for T-1563 display chaining.
    [env:          full-env
     flat-env-id:  final-state.flat-env-id
     tc-errors:    tc-error-count
     tc-warnings:  typed.warnings]]
]

# ============================================================================
# Dict 2 — Test runner functions
# ============================================================================
# Closures here capture Dict 1 + initial env. Prelude-specific names are
# passed as parameters so that tests run with the full prelude in scope.

[
  Boolean: [type True False]

  ProgramItem: [type
    [File path: String  handle: File]
    [Expr src:  String]
  ]

  Result: [type [let a] [Ok a] [Error String]]

  write-str: [fn [let h s] [h.write s]]

  # validate-prelude-result: check bare-eval result for type errors.
  # Emits all diagnostics and raises if any errors/warnings found.
  # Returns the env on success. Use this as a named function instead of
  # [call [fn [] ...]] — cleaner and testable independently.
  validate-prelude-result: [fn [let result]
    # tc-errors is now an Int (count of resolve errors, already emitted during resolution).
    # n-warn is from builtin-typecheck warnings (a dict — emit-diagnostics returns count).
    # n-total forces both emit calls and is non-zero when any errors exist.
    [n-tc:          result.tc-errors
     n-warn:        [builtin-dict-length result.tc-warnings]
     n-tc-emitted:  result.tc-errors
     n-warn-emitted: [emit-diagnostics result.tc-warnings]
     n-total:       [builtin-int-add [builtin-int-add n-tc n-warn]
                      [builtin-int-add n-tc-emitted n-warn-emitted]]]
    [match [builtin-eq-int n-total 0]
      0: [builtin-raise [join "" ["prelude has "
            [builtin-int->string [builtin-int-add n-tc n-warn]]
            " type error(s) — see above"]]]
      _: result.env]]

  # extract-source: given file content, return everything before "\n=== ".
  extract-source: [fn [let content]
    [sep-pos: [builtin-str-index-of "\n=== " content]]
    [match [builtin-eq-int sep-pos -1]
      0: [builtin-str-slice content 0 sep-pos]
      _: content]]

  section-strip-nl: [fn [let sv sl]
    [match [builtin-eq-int sl 0]
      0: [match [builtin-eq-string [builtin-str-slice sv [builtin-int-add sl -1] sl] "\n"]
           0: sv
           _: [builtin-str-slice sv 0 [builtin-int-add sl -1]]]
      _: sv]]

  section-cut-at: [fn [let sv si]
    [match [builtin-eq-int si -1]
      0: [builtin-str-slice sv 0 si]
      _: sv]]

  section-trim: [fn [let bt]
    [section-strip-nl
      [section-cut-at bt [builtin-str-index-of "\n=== " bt]]
      [builtin-str-length [section-cut-at bt [builtin-str-index-of "\n=== " bt]]]]]

  extract-section: [fn [let content label]
    [sep: [join "" ["\n=== " label "\n"]]]
    [match [builtin-eq-int [builtin-str-index-of sep content] -1]
      0: [section-trim
            [builtin-str-slice
              content
              [builtin-int-add
                [builtin-str-index-of sep content]
                [builtin-str-length sep]]
              [builtin-str-length content]]]
      _: ""]]

  # run-test-pipeline: evaluate a test source through the full CLI pipeline:
  #   test-source → cli/out/llt.llt (formatter)
  # This mirrors exactly what the CLI does: both programs run with prelude in
  # scope, %stdout is a capture handle, and the formatter writes the repr.
  #
  # Parameters:
  #   source   — tinct source string (from === out section, without the sections)
  #   path     — file path for error messages
  #   prelude  — loaded prelude (Value::Environment from include %libdir "prelude.llt")
  #   llt-formatter-expanded — parsed+expanded cli/out/llt.llt (SurfaceProgram)
  #   warn-box — builder to accumulate typecheck warnings (for check-warn)
  #
  # Returns: the captured output from the formatter (the LLT repr of the result).
  # Raises on error (caught by builtin-try in run-test-file).
  # prelude-flat-env-id: the flat-env-id from the prelude evaluation (T-1563 display chain).
  #   Pass [] if unknown; pass an Int to enable VarRef resolution via display ancestry.
  run-test-pipeline: [fn [let source path prelude llt-formatter-expanded warn-box prelude-flat-env-id]
    # Per-test capture handle — replaces %stdout so formatter output is captured.
    [capture: [make-string-handle]]

    # Base env for test program: prelude + caps + capture as %stdout.
    # This is the same env the CLI uses for each user program.
    [base-env-result: [builtin-extend-env prelude
                        [%cwd:    %cwd
                         %libdir: %libdir
                         %stdout: capture
                         %stderr: %stderr
                         %args:   %args]
                        flat-env: prelude-flat-env-id]
     base-env:        base-env-result.env
     base-flat-env-id: base-env-result.flat-env-id]

    # Parse the test source (no expand step).
    [parse-result:  [builtin-parse [builtin-str-bytes source] path]]

    # Combined resolve+eval loop: resolve each document against the env it will be
    # evaluated with, then evaluate it. Threading the env ensures de Bruijn coordinates
    # from the resolve pass match the evaluation env for each document.
    # state is {env, flat-env-id, last-result} to thread display ancestry (T-1563).
    #
    # Errors (both resolve and eval) surface immediately via emit-diagnostics and raise.
    [test-state: [reduce
      [fn [let state doc]
        [r:           [builtin-resolve doc env: state.env]]
        [n-re:        [builtin-dict-length r.errors]
         _re:         [emit-diagnostics r.errors]]
        [eval-result: [match [builtin-eq-int [builtin-int-add n-re _re] 0]
          0: [builtin-raise [join "" [[builtin-int->string n-re] " resolve error(s) in " path]]]
          _: [match [builtin-eq-string [builtin-type-of state.flat-env-id] "Int"]
               0: [builtin-eval r.doc env: state.env]
               _: [builtin-eval r.doc env: state.env flat-env: state.flat-env-id]]]]
        [match [builtin-eq-string [builtin-type-of eval-result.error] "String"]
          0: [call [fn [let]
                # T-1507: caps check against current eval env.
                [_caps-ok: [reduce
                  [fn [let ok cap-name]
                    [full-name: [builtin-string-concat "%" cap-name]]
                    [match [builtin-cap-env-has? full-name state.env]
                      0: [builtin-raise [join "" [full-name " is required but not provided"]]]
                      _: ok]]
                  Boolean.True
                  [builtin-keys doc.caps]]
                 # T-1506: expects check against incoming value. Identical branches are intentional —
                 # builtin-check-type is forced for its raise side-effect; result always Boolean.True.
                 _expects-ok: [match [builtin-eq-string [builtin-type-of doc.expects] "String"]
                   0: Boolean.True
                   _: [match [builtin-int-gte [builtin-dict-length [builtin-type-of [builtin-check-type doc.expects state.last-result]]] 0]
                        0: Boolean.True
                        _: Boolean.True]]
                 new-env-result: [builtin-extend-env eval-result.env
                   [make-entry
                     [match [builtin-eq-string eval-result.doc-name ""]
                       0: eval-result.doc-name
                       _: "%"]
                     eval-result.result]
                   flat-env: eval-result.flat-env-id]
                 new-env:        new-env-result.env]
                [match [builtin-eq-string [builtin-tag-of _caps-ok] "Boolean.True"]
                  0: [builtin-raise "unreachable"]
                  _: [match [builtin-eq-string [builtin-tag-of _expects-ok] "Boolean.True"]
                       0: [builtin-raise "unreachable"]
                       _: [env: new-env  flat-env-id: eval-result.flat-env-id  last-result: eval-result.result]]]]]
          _: [builtin-raise eval-result.error]]]
      [env: base-env  flat-env-id: prelude-flat-env-id  last-result: []]
      parse-result.program.documents]]

    # Typecheck for call_dispatch annotations and warnings.
    # Depends on test-state.env so typecheck only runs after the combined loop above
    # has fully resolved and evaluated all documents (OnceLocks set, eval thunks created).
    # call_dispatch annotations are written here; they are read by the lowerer when the
    # lazy result thunks are forced below (after _wb-forced runs typecheck first).
    [typed:      [match [builtin-int-gte [builtin-dict-length [builtin-type-of test-state.env]] 0]
      0: []
      _: [builtin-typecheck parse-result.program fundamental-tc env: base-env]]]
    # Accumulate typecheck warnings into warn-box.
    [all-warnings: typed.warnings]
    # Force warn-box update as a data dependency (no >> needed).
    # builtin-builder-set writes to the builder and returns the builder object.
    # We force it by reading the builder snapshot length (always >= 0).
    [_wb:           [builtin-builder-set 0 all-warnings warn-box]]
    [_wb-forced:    [match [builtin-int-gte [builtin-dict-length [builtin-builder-snapshot _wb]] 0]
      0: 1
      _: 1]]

    # Format the test result directly using builtin-llt-repr (core builtin, always available).
    # Avoids llt.llt formatter which needs prelude functions not available in bare-eval scope.
    [result-val: test-state.last-result]
    [output: [builtin-string-concat [builtin-llt-repr result-val] "\n"]]
    [wrote: [capture.write output capture]]
    [match [builtin-int-gte [builtin-int-add _wb-forced [match [builtin-int-gte [builtin-dict-length wrote] 0]
                                                   0: 1
                                                   _: 1]] 2]
      0: [capture.read]
      _: [capture.read]]]

  # path-has-component: true if path contains "/component/" as a path segment.
  path-has-component: [fn [let path component]
    [match [builtin-eq-int [builtin-str-index-of [join "" ["/" component "/"] ] path] -1]
      0: Boolean.True
      _: Boolean.False]]

  # check-path-sections: enforce that warn/error sections only appear in
  # appropriately named directories.
  check-path-sections: [fn [let path expected-warn expected-error actual-out]
    [in-warnings: [path-has-component path "warnings"]]
    [in-errors:   [path-has-component path "errors"]]
    [warn-ok: [match [builtin-eq-string expected-warn ""]
                0: in-warnings
                _: Boolean.True]]
    [error-ok: [match [builtin-eq-string expected-error ""]
                  0: in-errors
                  _: [match [builtin-eq-int [builtin-str-index-of "ERROR:" actual-out] 0]
                       0: Boolean.True
                       _: in-errors]]]
    [match [bool->int warn-ok]
      0: [join "" ["=== warn section not allowed outside warnings/ directory: " path]]
      _: [match [bool->int error-ok]
           0: [match [builtin-eq-string expected-error ""]
                0: [join "" ["=== error section not allowed outside errors/ directory: " path]]
                _: [join "" ["ERROR: output not allowed outside errors/ directory: " path]]]
           _: ""]]]

  # check-warn: validate typecheck warnings against the expected-warn section.
  check-warn: [fn [let warnings expected-warn]
    [warn-count: [builtin-dict-length warnings]]
    [warn-text: [reduce
      [fn [let acc w] [builtin-string-concat acc [builtin-string-concat [match [builtin-eq-string acc ""]
                                                                           0: "\n"
                                                                           _: ""] w.message]]]
      ""
      warnings]]
    [match [builtin-eq-string expected-warn ""]
      0: [match [builtin-eq-int [builtin-str-index-of expected-warn warn-text] -1]
           0: ""
           _: [join "" ["expected warning not found:\n  " expected-warn "\nactual:\n  " warn-text]]]
      _: [match [builtin-eq-int warn-count 0]
           0: [join "" ["expected no warnings, got:\n" warn-text]]
           _: ""]]]

  # run-test-file: execute a single file ProgramItem as a corpus test.
  run-test-file: [fn [let p prelude llt-formatter-expanded prelude-flat-env-id]
    [bytes:          [read-file p.handle [builtin-bytes]]]
    [content:        [builtin-bytes-str bytes]]
    [source:         [extract-source content]]
    [expected-out:   [extract-section content "out"]]
    [expected-warn:  [extract-section content "warn"]]
    [expected-error: [extract-section content "error"]]

    # warn-box captures typecheck warnings as a side effect of run-test-pipeline.
    [warn-box: [builtin-make-builder]]

    # Run test through the full [test.llt → llt.llt] pipeline.
    # builtin-try catches eval errors and returns {error: message} on failure.
    [try-result: [builtin-try [fn [] [run-test-pipeline source p.path prelude llt-formatter-expanded warn-box prelude-flat-env-id]]]]

    [try-ok: [match [builtin-has-key? "ok" try-result]
        0: 0
        _: 1]]

    # Extract the formatter output or an ERROR: prefix.
    [raw-output: [match try-ok
        0: [builtin-string-concat "ERROR: " [builtin-get "error" try-result]]
        _: [builtin-get "ok" try-result]]]

    # Strip trailing newline from formatter output (formatters add a final \n).
    [actual: [match try-ok
        0: raw-output
        _: [strip-trailing-newline raw-output]]]

    # Warnings were stored in warn-box by run-test-pipeline.
    [eval-warnings: [match try-ok
      0: []
      _: [builtin-get 0 [builtin-builder-snapshot warn-box]]]]

    # === error: substring match; === out: exact match
    [out-passed: [match [builtin-eq-string expected-error ""]
                   0: [match [builtin-eq-int [builtin-str-index-of expected-error actual] -1]
                        0: 1
                        _: 0]
                   _: [builtin-eq-string actual expected-out]]]

    [path-fail: [check-path-sections p.path expected-warn expected-error actual]]
    [path-passed: [builtin-eq-string path-fail ""]]

    [warn-fail: [match try-ok
      0: ""
      _: [check-warn eval-warnings expected-warn]]]
    [warn-passed: [builtin-eq-string warn-fail ""]]

    [r-path:    p.path]
    [r-passed:  [match out-passed
      0: 0
      _: [match warn-passed
           0: 0
           _: path-passed]]]
    [r-actual:  [match path-passed
                  0: [join "" ["out: " actual "\npath: " path-fail]]
                  _: [join "" [
                       [match out-passed
                         0: [join "" ["out: "  actual    "\n"]]
                         _: ""]
                       [match warn-passed
                         0: [join "" ["warn: " warn-fail "\n"]]
                         _: ""]]]]]
    [r-expected: [match path-passed
                   0: [join "" ["out: "
                         [match [builtin-eq-string expected-error ""]
                           0: expected-error
                           _: expected-out]]]
                   _: [join "" [
                        [match out-passed
                          0: [join "" ["out: "
                               [match [builtin-eq-string expected-error ""]
                                 0: expected-error
                                 _: expected-out]
                               "\n"]]
                          _: ""]
                        [match warn-passed
                          0: [join "" ["warn: " expected-warn "\n"]]
                          _: ""]]]]]
    [path: r-path  passed: r-passed  actual: r-actual  expected: r-expected]]

  # run-test: run one ProgramItem as a corpus test.
  run-test: [fn [let item prelude llt-formatter-expanded prelude-flat-env-id]
    [match item
      [ProgramItem.File _]: [run-test-file item prelude llt-formatter-expanded prelude-flat-env-id]
      [ProgramItem.Expr _]: [path: "<expr>"  passed: Boolean.True  actual: ""  expected: ""]]]

  # format-result: render test outcome line.
  format-result: [fn [let r]
    [builtin-string-concat r.path
      [builtin-string-concat " ... "
        [match [bool->int r.passed]
          0: [builtin-string-concat "FAIL\n"
               [builtin-string-concat "  expected: "
                 [builtin-string-concat r.expected
                   [builtin-string-concat "\n  actual:   "
                     [builtin-string-concat r.actual "\n"]]]]]
          _: "pass\n"]]]]

  # check-llt-eval: true if a filename ends with ".llt-eval".
  check-llt-eval: [fn [let name]
    [len: [builtin-str-length name]]
    [match [builtin-lt len 9]
      0: [builtin-eq-string [builtin-str-slice name [builtin-int-sub len 9] len] ".llt-eval"]
      _: 0]]

  # find-corpus-files: recursively walk cap/dir-path, accumulate .llt-eval files.
  find-corpus-files: [fn [let cap dir-path state]
    [entries: [builtin-list-dir cap dir-path]]
    [reduce
      [fn [let st entry]
        [full: [join "" [$dir-path "/" entry.name]]]
        [match [builtin-eq-string entry.type "dir"]
          0: [match [check-llt-eval entry.name]
               0: st
               _: [merge st [make-entry [builtin-dict-length st] [ProgramItem.File path: full  handle: [builtin-file-open cap full "read"]]]]]
          _: [find-corpus-files cap full st]]]
      state
      entries]]]

# ============================================================================
# Dict 3 — Load prelude, pre-parse formatter, run tests
# ============================================================================

[
  # Thread Boolean/True/False from loader scope so prelude can use them unqualified.
  # %prelude is a lazy forward reference — safe because prelude only forces it at call time.
  # IMPORTANT: _prelude must remain a simple field access (_prelude-result.env) so that
  # the forward reference %prelude: _prelude in the extras dict is safe. If _prelude were
  # an IIFE ([call [fn [] ...]]), prelude code that accesses %prelude during loading would
  # force _prelude → force _prelude-result (pending) → cycle. Keep it simple.
  _prelude-result: [bare-eval %libdir "prelude.llt"
    [%prelude: _prelude  Boolean: Boolean  True: True  False: False]]

  _prelude: _prelude-result.env

  # _prelude-flat-env-id: the flat-env-id from the prelude evaluation, for T-1563 display chaining.
  # Passed as prelude-flat-env-id to run-test → run-test-pipeline → builtin-eval.
  _prelude-flat-env-id: _prelude-result.flat-env-id

  # _prelude-validated: the env to use for test runs.
  # validate-prelude-result is defined in Dict 2 as a named function — cleaner than
  # [call [fn [] ...]] (IIFE). Memoized: check runs once, then result is reused.
  _prelude-validated: [validate-prelude-result _prelude-result]

  # _prelude-ok: forces prelude validation BEFORE the test reduce starts, outside
  # any builtin-try. builtin-type-of forces _prelude-validated; builtin-int-gte makes
  # an Int for use as a data dependency in test-programs.
  # If _prelude-validated raises, it propagates HERE (Dict 3 level, no try catches it).
  _prelude-ok: [builtin-int-gte [builtin-dict-length [builtin-type-of _prelude-validated]] 0]

  # Pre-parse cli/out/llt.llt once (parse only — NOT resolved).
  # Resolution happens per-test inside run-test-pipeline with fmt-env
  # (prelude + % = test result + capture stdout), exactly as the CLI does.
  _llt-formatter-expanded: [call [fn []
    [parse-result:  [builtin-parse
                      [read-file [builtin-file-open %libdir "cli/out/llt.llt" "read"] [builtin-bytes]]
                      "cli/out/llt.llt"]]
    # Emit parse errors as a data dependency (no >> needed).
    [_pe:           [emit-diagnostics parse-result.errors]]
    [match [builtin-int-gte _pe 0]
      0: parse-result.program
      _: parse-result.program]]]

  # Bootstrap check: verify the formatter loaded correctly.
  _formatter-ok: [call [fn [let _raw]
      [match [builtin-has-key? "ok" _raw]
        0: [call [fn [let _w] [match [builtin-int-gte [builtin-dict-length _w] 0]
                                0: 0
                                _: 0]]
              [%stderr.write "\nbootstrap error: llt.llt formatter failed to load\nCannot run corpus tests.\n" %stderr]]
        _: 1]]
    [builtin-try [fn [] _llt-formatter-expanded.documents]]]

  # Discover test files (or use the ones given on the command line).
  # _prelude-ok is a data dependency: forces prelude validation BEFORE the reduce
  # starts, outside any builtin-try. If prelude has errors, the raise propagates
  # here (Dict 3 level) and the test run aborts with full error details visible.
  test-programs: [match [builtin-eq-int [builtin-int-add _formatter-ok _prelude-ok] 2]
    0: []
    _: [match [builtin-eq-int [builtin-dict-length %programs] 0]
         0: %programs
         _: [find-corpus-files
               [builtin-narrow %cwd "tests/corpus"]
               "."
               []]]]

  final-state: [reduce
    [fn [let state item]
      [result: [run-test item _prelude-validated _llt-formatter-expanded _prelude-flat-env-id]]
      # Force the write as a data dependency (no >> needed).
      # %stdout.write returns the handle (%stdout protocol dict).
      # Force it by reading the handle's key count (always >= 0).
      [wrote: [%stdout.write [format-result result] %stdout]]
      [match [builtin-int-gte [builtin-dict-length wrote] 0]
        0: [idx:    [builtin-int-add state.idx 1]
             total:  [builtin-int-add state.total 1]
             passed: state.passed
             first-fail: state.first-fail]
        _: [idx:    [builtin-int-add state.idx 1]
             total:  [builtin-int-add state.total 1]
             passed: [match [bool->int result.passed]
                        0: state.passed
                        _: [builtin-int-add state.passed 1]]
             first-fail: [match [builtin-eq-string state.first-fail ""]
                            0: state.first-fail
                            _: [match [bool->int result.passed]
                                 0: [builtin-string-concat result.path [builtin-string-concat "\n  expected: " [builtin-string-concat result.expected [builtin-string-concat "\n  actual:   " result.actual]]]]
                                 _: ""]]]]]
    [idx: 0  total: 0  passed: 0  first-fail: ""]
    test-programs]
]

# ============================================================================
# Final expression — summary + exit code
# ============================================================================

[wrote: [%stdout.write [join "" [
    "\n"
    [builtin-int->string final-state.passed] "/" [builtin-int->string final-state.total] " tests passed"
    [match [builtin-eq-int final-state.passed final-state.total]
      0: [join "" [", " [builtin-int->string [builtin-int-sub final-state.total final-state.passed]] " failed\n"]]
      _: "\n"]]]
  %stdout]]
[match [builtin-int-gte [builtin-dict-length wrote] 0]
  0: []
  _: [match [builtin-eq-int final-state.passed final-state.total]
       0: [builtin-raise [join "" [
             [builtin-int->string [builtin-int-sub final-state.total final-state.passed]] " test(s) failed\n"
             final-state.first-fail]]]
       _: []]]
