# ============================================================================
# LLT TOML-Lite Parser (stdlib/toml-lite.llt)
# ============================================================================
#
# Pure-tinct TOML parser that handles a subset of TOML features.
#
# Supported TOML features:
#   - [section] headers → nested dict
#   - [[array-table]] → array of dicts under that key
#   - key = "string-value" → string values (quoted)
#   - key = value → bare values (integers, booleans, bare strings)
#   - # comments → ignored
#   - Blank lines → ignored
#
# Available Rust builtins used here:
#   String:      str, split, trim, str-slice, str-contains?, starts-with?, length
#   Arithmetic:  builtin-add, builtin-sub, builtin-mul, builtin-div
#   Comparison:  builtin-lt, builtin-eq
#   Control:     builtin-if
#   Dict:        keys, merge, append, builtin-get
#   Sequences:   builtin-reduce, collect
#   Numeric:     to-int
#
# All functions in this dict can reference each other (letrec semantics).
# ============================================================================

[

# ============================================================================
# Main Parser Entry Point
# ============================================================================

# Parse a TOML-lite document into a nested dict structure.
# Type: (String -> Dict)
# Example: [parse-toml-lite "key = \"value\""] => [key: "value"]
# Example: [parse-toml-lite "[section]\nkey = 42"] => [section: [key: 42]]
parse-toml-lite: [fn@Dict [text@String]
    [parse-toml-lines
        [collect
            [builtin-filter [fn [line] [not-blank-or-comment line]]
                [builtin-map [fn [line] [trim line]]
                    [split "\n" text]]]]]]

# ============================================================================
# Line-by-Line Parser
# ============================================================================

# Process a list of non-blank, non-comment lines.
# Type: (Dict String -> Dict)
parse-toml-lines: [fn@Dict [lines]
    [parse-lines-impl lines 0 [length lines] [] []]]

# Recursive line processor with accumulator.
# Type: (Dict String -> Int -> Int -> Dict -> Dict String -> Dict)
parse-lines-impl: [fn@Dict [lines i@Int len@Int acc@Dict current-path]
    [builtin-if [>= i len]
        acc
        [parse-line-dispatch lines i len acc current-path [builtin-get i lines]]]]

# Dispatch on line type: [section], [[array-table]], or key = value.
# Type: (Dict String -> Int -> Int -> Dict -> Dict String -> String -> Dict)
parse-line-dispatch: [fn@Dict [lines i@Int len@Int acc@Dict current-path line@String]
    [builtin-if [starts-with? line "[["]
        # Array table: [[name]]
        [parse-lines-impl lines [builtin-add i 1] len
            [toml-append-array-table acc [parse-array-table-header line]]
            [parse-array-table-header line]]
        [builtin-if [starts-with? line "["]
            # Section: [name]
            [parse-lines-impl lines [builtin-add i 1] len acc [parse-section-header line]]
            # Key-value pair
            [parse-lines-impl lines [builtin-add i 1] len
                [toml-set-at-path acc current-path [parse-key-value line]]
                current-path]]]]

# ============================================================================
# Line Predicates
# ============================================================================

# Check if a line is blank or a comment.
# Type: (String -> Bool)
not-blank-or-comment: [fn@Bool [line@String]
    [builtin-if [builtin-eq [length line] 0]
        false
        [not [starts-with? line "#"]]]]

# ============================================================================
# Section Header Parsing
# ============================================================================

# Parse a [section] header into a path list.
# Type: (String -> Dict String)
# Example: "[server]" => ["server"]
# Example: "[database.options]" => ["database" "options"]
parse-section-header: [fn@Dict [line@String]
    [parse-section-name [trim [str-slice line 1 [builtin-sub [length line] 1]]]]]

# Parse section name, splitting on dots for nested sections.
# Type: (String -> Dict String)
parse-section-name: [fn@Dict [name@String]
    [builtin-if [str-contains? name "."]
        [collect [split "." name]]
        [0: name]]]

# ============================================================================
# Array Table Header Parsing
# ============================================================================

# Parse a [[array-table]] header into a path list.
# Type: (String -> Dict String)
# Example: "[[items]]" => ["items"]
parse-array-table-header: [fn@Dict [line@String]
    [parse-section-name [trim [str-slice line 2 [builtin-sub [length line] 2]]]]]

# ============================================================================
# Key-Value Parsing
# ============================================================================

# Parse a key = value line into a single-entry dict.
# Type: (String -> Dict)
# Example: "key = \"value\"" => [key: "value"]
# Example: "count = 42" => [count: 42]
parse-key-value: [fn@Dict [line@String]
    [parse-kv-split line [str-find line "="]]]

# Split on = and build the key-value entry.
# Type: (String -> Int -> Dict)
parse-kv-split: [fn@Dict [line@String eq-pos@Int]
    [parse-kv-build
        [trim [str-slice line 0 eq-pos]]
        [trim [str-slice line [builtin-add eq-pos 1] [length line]]]]]

# Build the key-value dict entry.
# Type: (String -> String -> Dict)
parse-kv-build: [fn@Dict [key@String value@String]
    [make-entry key [parse-value value]]]

# ============================================================================
# Value Parsing
# ============================================================================

# Parse a TOML value (string, integer, boolean, or bare string).
# Type: (String -> Any)
# Example: "\"hello\"" => "hello"
# Example: "42" => 42
# Example: "true" => true
parse-value: [fn [value@String]
    [builtin-if [starts-with? value "\""]
        # Quoted string: strip quotes
        [str-slice value 1 [builtin-sub [length value] 1]]
        # Try parsing as integer
        [parse-value-try-int value]]]

# Try parsing as integer, fall back to boolean or bare string.
# Type: (String -> Any)
parse-value-try-int: [fn [value@String]
    [try-or
        [fn [] [to-int value]]
        [parse-value-try-bool value]]]

# Try parsing as boolean, fall back to bare string.
# Type: (String -> Any)
parse-value-try-bool: [fn [value@String]
    [builtin-if [builtin-eq value "true"]
        true
        [builtin-if [builtin-eq value "false"]
            false
            value]]]

# ============================================================================
# Path-Based Dict Mutation
# ============================================================================

# Set a key-value pair at a nested path.
# Type: (Dict -> Dict String -> Dict -> Dict)
# Example: [toml-set-at-path [] ["server"] [port: 8080]] => [server: [port: 8080]]
toml-set-at-path: [fn@Dict [root@Dict path kv@Dict]
    [builtin-if [builtin-eq [type-of path] "String"]
        # Single-key path (leaf)
        [merge root kv]
        # Multi-level path (nested)
        [builtin-if [builtin-eq [length path] 0]
            [merge root kv]
            [toml-set-at-path-impl root path kv 0]]]]

# Recursive path setter.
# Type: (Dict -> Dict String -> Dict -> Int -> Dict)
toml-set-at-path-impl: [fn@Dict [root@Dict path kv@Dict depth@Int]
    [builtin-if [builtin-eq depth [builtin-sub [length path] 1]]
        # Last segment: check if target is an array table, merge into last element if so
        [toml-set-at-path-final root [builtin-get depth path] kv]
        # Intermediate segment: recurse
        [merge root [make-entry [builtin-get depth path]
            [toml-set-at-path-impl
                [get-or root [builtin-get depth path] []]
                path
                kv
                [builtin-add depth 1]]]]]]

# Final path segment: check if target is an array, merge into last element.
# Type: (Dict -> String -> Dict -> Dict)
toml-set-at-path-final: [fn@Dict [root@Dict key@String kv@Dict]
    [toml-set-at-path-final-check root key kv [get-or root key []]]]

toml-set-at-path-final-check: [fn@Dict [root@Dict key@String kv@Dict target]
    [builtin-if [is-array? target]
        # Target is an array: merge kv into last element (if non-empty)
        [builtin-if [> [length target] 0]
            [merge root [make-entry key [toml-merge-into-last target kv]]]
            # Empty array: just merge kv directly (shouldn't happen in valid TOML)
            [merge root [make-entry key [merge target kv]]]]
        # Target is not an array: merge kv directly
        [merge root [make-entry key [merge target kv]]]]]

# Merge kv into the last element of an array (integer-keyed dict).
# Type: (Dict -> Dict -> Dict)
toml-merge-into-last: [fn@Dict [arr@Dict kv@Dict]
    [toml-merge-into-last-impl arr kv [builtin-sub [length arr] 1]]]

toml-merge-into-last-impl: [fn@Dict [arr@Dict kv@Dict last-idx@Int]
    [merge arr [make-entry last-idx [merge [builtin-get last-idx arr] kv]]]]

# Check if a value is an array (dict with all integer keys and non-empty).
# Type: (Any -> Bool)
is-array?: [fn@Bool [xs]
    [and [dict? xs] [is-array?-check-keys xs]]]

is-array?-check-keys: [fn@Bool [xs@Dict]
    [builtin-if [builtin-eq [length xs] 0]
        false  # Empty dicts are not considered arrays
        [all? int? [keys xs]]]]

# Type predicate: check if value is a dict.
# Note: dict? is a Rust builtin, but we need all? which is from prelude.
# We'll inline all? here to avoid dependency issues.
all?: [fn@Bool [pred@Fn xs@Dict]
    [builtin-if [seq? xs]
        [error "all?: expected Dict, got Seq"]
        [all?-impl pred xs [keys xs] 0 [length xs]]]]

all?-impl: [fn@Bool [pred@Fn xs@Dict ks i@Int len@Int]
    [builtin-if [>= i len]
        true
        [builtin-if [pred [builtin-get i ks]]
            [all?-impl pred xs ks [builtin-add i 1] len]
            false]]]

# ============================================================================
# Array Table Support
# ============================================================================

# Append a new dict to an array table at the given path.
# Type: (Dict -> Dict String -> Dict)
# Example: [toml-append-array-table [] ["items"]] => [items: [[]]]
toml-append-array-table: [fn@Dict [root@Dict path]
    [builtin-if [builtin-eq [type-of path] "String"]
        # Single-key path
        [merge root [make-entry path [append [get-or root path []] []]]]
        # Multi-level path
        [builtin-if [builtin-eq [length path] 0]
            root
            [toml-append-array-impl root path 0]]]]

# Recursive array table appender.
# Type: (Dict -> Dict String -> Int -> Dict)
toml-append-array-impl: [fn@Dict [root@Dict path depth@Int]
    [builtin-if [builtin-eq depth [builtin-sub [length path] 1]]
        # Last segment: append empty dict to array
        [merge root [make-entry [builtin-get depth path]
            [append [get-or root [builtin-get depth path] []] []]]]
        # Intermediate segment: recurse
        [merge root [make-entry [builtin-get depth path]
            [toml-append-array-impl
                [get-or root [builtin-get depth path] []]
                path
                [builtin-add depth 1]]]]]]

# ============================================================================
# Utility Functions (from prelude and stdlib/strings.llt)
# ============================================================================

# These are duplicated from prelude.llt to avoid circular dependency.

# Internal helper: construct single-entry dict.
make-entry: [fn@Dict [k v] [$k: v]]

# Find the first occurrence of a substring. Returns character index or -1.
# Simplified version from stdlib/strings.llt, inlined to avoid include complexity.
str-find: [fn@Int [haystack@String needle@String]
    [builtin-if [str-contains? haystack needle]
        [str-find-impl haystack needle 0 [length needle] [length haystack]]
        [builtin-sub 0 1]]]

str-find-impl: [fn@Int [haystack@String needle@String i@Int needle-len@Int haystack-len@Int]
    [builtin-if [builtin-lt i haystack-len]
        [str-find-check haystack needle i needle-len haystack-len]
        [builtin-sub 0 1]]]

str-find-check: [fn@Int [haystack@String needle@String i@Int needle-len@Int haystack-len@Int]
    [builtin-if [builtin-eq needle-len 0]
        0
        [builtin-if [builtin-lt [builtin-add i needle-len] [builtin-add haystack-len 1]]
            [builtin-if [builtin-eq [str-slice haystack i [builtin-add i needle-len]] needle]
                i
                [str-find-impl haystack needle [builtin-add i 1] needle-len haystack-len]]
            [str-find-impl haystack needle [builtin-add i 1] needle-len haystack-len]]]]

# Get with default.
get-or: [fn [xs@Dict k default]
    [builtin-if [has? xs k] [builtin-get k xs] default]]

# Check if key exists.
has?: [fn@Bool [xs@Dict k]
    [has?-impl [try [fn [] [builtin-get k xs]]]]]

has?-impl: [fn@Bool [try-result@Dict]
    [builtin-eq [first [keys try-result]] "ok"]]

# Boolean negation.
not: [fn@Bool [x] [builtin-if x false true]]

# Short-circuit AND.
and: [fn [a b] [builtin-if a b false]]

# Greater-than-or-equal.
>=: [fn@Bool [a b] [not [builtin-lt a b]]]

# Greater-than.
>: [fn@Bool [a b] [builtin-lt b a]]

# Try with fallback.
try-or: [fn [f@Fn default]
    [try-or-impl [try f] default]]

try-or-impl: [fn [try-result@Dict default]
    [builtin-if [builtin-eq [first [keys try-result]] "ok"]
        try-result.ok
        default]]

# First element.
first: [fn [xs] xs.0]

]
