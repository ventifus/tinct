# ENV Formatter
# Convert a flat dict to KEY=VALUE format for .env files

[
# Internal: format a single entry
env-entry: [fn@Str [k@Str v]
  [str k "=" v "\n"]]

# Internal: format all entries
env-entries: [fn@Str [d@Dict ks@Dict i@Int acc@Str]
  [if [>= i [length ks]]
    acc
    [env-entries d ks [+ i 1]
      [str acc [env-entry [get i ks] [get [get i ks] d]]]]]]

# Public API: format flat dict to ENV format
env: [fn@Str [d@Dict]
  [if [empty? d]
    ""
    [env-entries d [keys d] 0 ""]]]
]
