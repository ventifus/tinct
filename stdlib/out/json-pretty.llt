# JSON Pretty Formatter
# Convert a tinct value to indented JSON string

[
# Internal: escape a string for JSON
# Escapes: " \ newline tab carriage-return
json-escape: [fn [s]
  [replace "\r" "\\r"
    [replace "\t" "\\t"
      [replace "\n" "\\n"
        [replace "\"" "\\\""
          [replace "\\" "\\\\" s]]]]]]

# Internal: quote and escape a string for JSON
json-quote: [fn [s]
  [str "\"" [json-escape s] "\""]]

# Internal: format a single value to JSON
json-value: [fn [val indent]
  [cond [
    [[null? val] "null"]
    [[bool? val] [if val "true" "false"]]
    [[int? val] [str val]]
    [[float? val] [str val]]
    [[str? val] [json-quote val]]
    [[dict? val] [json-object val indent]]
    [true "null"]
  ]]]

# Internal: check if dict is list-shaped (integer keys only)
is-list?: [fn [d]
  [if [empty? d]
    true
    [all? [fn [k] [int? k]] [keys d]]]]

# Internal: format dict as JSON object or array
json-object: [fn [d indent]
  [if [is-list? d]
    [json-array d indent]
    [json-dict d indent]]]

# Internal: format dict as JSON array
json-array: [fn [d indent]
  [if [empty? d]
    "[]"
    [json-array-body d indent]]]

json-array-body: [fn [d indent]
  [str
    "[\n"
    [json-array-items d [+ indent 2] 0]
    [join "" [take indent [repeat " "]]]
    "]"]]

json-array-items: [fn [d indent i]
  [if [>= i [length d]]
    ""
    [json-array-item d indent i]]]

json-array-item: [fn [d indent i]
  [str
    [join "" [take indent [repeat " "]]]
    [json-value [get i d] indent]
    [if [< [+ i 1] [length d]] ",\n" "\n"]
    [json-array-items d indent [+ i 1]]]]

# Internal: format dict as JSON object
json-dict: [fn [d indent]
  [if [empty? d]
    "{}"
    [json-dict-body d indent]]]

json-dict-body: [fn [d indent]
  [str
    "{\n"
    [json-dict-entries d [+ indent 2] [keys d] 0]
    [join "" [take indent [repeat " "]]]
    "}"]]

json-dict-entries: [fn [d indent ks i]
  [if [>= i [length ks]]
    ""
    [json-dict-entry d indent ks i]]]

json-dict-entry: [fn [d indent ks i]
  [str
    [join "" [take indent [repeat " "]]]
    [json-quote [str [get i ks]]]
    ": "
    [json-value [get [get i ks] d] indent]
    [if [< [+ i 1] [length ks]] ",\n" "\n"]
    [json-dict-entries d indent ks [+ i 1]]]]

# Public API: format value to pretty JSON (returns String)
json-pretty: [fn [val]
  [json-value val 0]]

# When used as a formatter pipeline stage: emit the result
[emit [str [json-pretty %] "\n"]]
]
