# I/O utilities — depends on io-phase1 builtins
# Requires: open, lines, emit, str (all Rust builtins)

[
# Read a file as a lazy sequence of lines.
# cap: DirCap, path: String
# Returns: [Ok seq] or [Error message]
read-lines@[doc: "Read a file as a lazy sequence of lines"]: [fn@Dict [let cap@DirCap path@String]
  [try [fn [let] [lines [open cap path "read"]].lines]]]

# Print a string followed by a newline to stdout.
println@[doc: "Print a string followed by a newline to stdout"]: [fn@Null [let s@String]
  [emit [str s "\n"]]]

# Print any value as a string followed by a newline to stdout.
println-val@[doc: "Print any value as a string followed by a newline to stdout"]: [fn@Null [let v@Any]
  [emit [str v "\n"]]]

# Write a string to a file (creates or truncates).
# cap: DirCap, path: String, content: String
write-file@[doc: "Write a string to a file (creates or truncates)"]: [fn@Null [let cap@DirCap path@String content@String]
  [write cap path content]]

# Atomically write a string to a file (write-to-temp + rename).
# cap: DirCap, path: String, content: String
write-file-atomic@[doc: "Atomically write a string to a file (write-to-temp + rename)"]: [fn@Null [let cap@DirCap path@String content@String]
  [write-atomic cap path content]]

# Write a line to a file handle, appending a newline and flushing.
# line: String, h: handle (content first, handle last for pipeline chaining)
write-line@[doc: "Write a line to a file handle, appending a newline and flushing (line first, handle last)"]: [fn [let line@String h]
  [$h | [write [str line "\n"]] | flush]]

# Append content to a file (creates if doesn't exist).
# cap: DirCap, path: String, content: String
append-file@[doc: "Append content to a file (creates if doesn't exist)"]: [fn@Null [let cap@DirCap path@String content@String]
  [h: [open cap path "append"]]
  [$h | [write content] | close]]

# Open a file for writing (creates or truncates, returns protocol dict handle).
# cap: DirCap, path: String
# Returns: protocol dict {read-chunk, write, flush, close, seek}
open-write@[doc: "Open a file for writing (creates or truncates, returns handle dict)"]: [fn [let cap@DirCap path@String]
  [open cap path "write"]]

# Open a file for appending (creates if doesn't exist, returns protocol dict handle).
# cap: DirCap, path: String
# Returns: protocol dict {read-chunk, write, flush, close, seek}
open-append@[doc: "Open a file for appending (creates if doesn't exist, returns handle dict)"]: [fn [let cap@DirCap path@String]
  [open cap path "append"]]

# Write a sequence of lines to a protocol dict handle.
# handle: protocol dict (from open), lines: Seq of String
write-lines@[doc: "Write a sequence of lines to a file handle"]: [fn [let handle lines-seq]
  [reduce [fn [let h line] [$h | [write [str line "\n"]]]] handle lines-seq]]

# has-cap? removed — Handle/WriteHandle capability dict is gone.
# Protocol dict handles (from `open`) use has? to check for method existence.
has-cap?@[doc: "Check if a method key exists on a protocol dict handle."]: [fn@Boolean [let h cap@String]
  [has? cap h]]

# Copy a file from src to dst.
# cap: DirCap, src: String source path, dst: String destination path
# Reads the source file content and writes it to the destination (create/truncate).
copy@[doc: "Copy a file from src to dst"]: [fn@Null [let cap@DirCap src@String dst@String]
  [read-result: [read-all [open cap src "read"]]]
  [write cap dst read-result.content]]
]
