# I/O utilities — depends on io-phase1 builtins
# Requires: open, slurp, lines, emit, str (all Rust builtins)
[
# Read an entire file as a string.
# cap: DirCap, path: String
read-file@[doc: "Read an entire file as a string"]: [fn@String [cap@DirCap path@String]
  [slurp [open cap path "r"]]]

# Read a file as a lazy sequence of lines.
# cap: DirCap, path: String
read-lines@[doc: "Read a file as a lazy sequence of lines"]: [fn@Any [cap@DirCap path@String]
  [lines [open cap path "r"]]]

# Print a string followed by a newline to stdout.
println@[doc: "Print a string followed by a newline to stdout"]: [fn@Any [s@String]
  [emit [str s "\n"]]]

# Print any value as a string followed by a newline to stdout.
println-val@[doc: "Print any value as a string followed by a newline to stdout"]: [fn@Any [v@Any]
  [emit [str v "\n"]]]

# Write a string to a file (creates or truncates).
# cap: DirCap, path: String, content: String
write-file@[doc: "Write a string to a file (creates or truncates)"]: [fn@Any [cap@DirCap path@String content@String]
  [write cap path content]]

# Atomically write a string to a file (write-to-temp + rename).
# cap: DirCap, path: String, content: String
write-file-atomic@[doc: "Atomically write a string to a file (write-to-temp + rename)"]: [fn@Any [cap@DirCap path@String content@String]
  [write-atomic cap path content]]

# Write a line to a WriteHandle, appending a newline and flushing.
# handle: WriteHandle, line: String
write-line@[doc: "Write a line to a WriteHandle, appending a newline and flushing"]: [fn [handle@WriteHandle line@String]
  [flush [write-handle handle [str line "\n"]]]]
]
