# stdlib/codecs/json.llt — JSON codec (post-runtime-v2)
#
# Public API:
#   to-json:   tinct value → compact JSON string
#   from-json: JSON string → structural tinct value
#
# str-length comes from prelude (builtin-str-length alias). str-slice comes from
# prelude (builtin-str-slice alias, (string, start, end) semantics).
# Character access uses json-char-at (defined in the dict below) which wraps
# builtin-str-slice, avoiding any dependency on strings.llt str-at.
# from-json produces only: Dict, Seq, String, Int, Float, Bool, [] (null).
# Not every tinct type round-trips through JSON — Expression/Program/Document/Fn/
# Handle/Task/etc. have no JSON representation. Schema-directed reconstruction
# (JSON → nominal type) is the caller's responsibility.

[include %libdir "strings.llt"]

[

# ---- Serializer helpers ----

json-escape: [fn [let s@String]
  [replace "\\" "\\\\"
  [replace "\"" "\\\""
  [replace "\n" "\\n"
  [replace "\r" "\\r"
  [replace "\t" "\\t"
    s]]]]]]

json-string: [fn [let s@String]
  [builtin-str "\"" [json-escape s] "\""]]

json-variant: [fn [let tag@String fields]
  [builtin-str "{" [json-string tag] ":" [to-json fields] "}"]]

json-span: [fn [let s@Span]
  [builtin-str "{\"file\":"        [json-string s.file]
       ",\"start-line\":"  [builtin-str s.start-line]
       ",\"start-col\":"   [builtin-str s.start-col]
       ",\"end-line\":"    [builtin-str s.end-line]
       ",\"end-col\":"     [builtin-str s.end-col] "}"]]

to-json-dict: [fn [let d@Dict]
  [builtin-str "{"
    [join ","
      [map [fn [let pair] [builtin-str [json-string pair[0]] ":" [to-json pair[1]]]]
           [entries d]]]
    "}"]]

to-json-seq: [fn [let s]
  [builtin-str "[" [join "," [map to-json [collect s]]] "]"]]

# ---- Pretty-print helpers (indent tracking) ----

make-indent-impl: [fn [let depth@Int acc@String]
  [builtin-if [builtin-eq depth 0]
    acc
    [make-indent-impl [builtin-sub depth 1] [builtin-str acc "  "]]]]

make-indent: [fn [let depth@Int]
  [make-indent-impl depth ""]]

to-json-pretty-dict-nonempty: [fn [let d@Dict depth@Int]
  [current-indent: [make-indent depth]]
  [next-indent:    [make-indent [builtin-add depth 1]]]
  [pairs: [map [fn [let pair]
                 [builtin-str "\n" next-indent
                   [json-string pair[0]] ": "
                   [to-json-pretty-impl pair[1] [builtin-add depth 1]]]]
               [entries d]]]
  [builtin-str "{" [join "," pairs] "\n" current-indent "}"]]

to-json-pretty-dict: [fn [let d@Dict depth@Int]
  [builtin-if [builtin-eq [builtin-length d] 0]
    "{}"
    [to-json-pretty-dict-nonempty d depth]]]

to-json-pretty-seq-nonempty: [fn [let collected depth@Int]
  [current-indent: [make-indent depth]]
  [next-indent:    [make-indent [builtin-add depth 1]]]
  [items: [map [fn [let item]
                 [builtin-str "\n" next-indent
                   [to-json-pretty-impl item [builtin-add depth 1]]]]
               [values collected]]]
  [builtin-str "[" [join "," items] "\n" current-indent "]"]]

to-json-pretty-seq: [fn [let s depth@Int]
  [collected: [collect s]]
  [builtin-if [builtin-eq [builtin-length collected] 0]
    "[]"
    [to-json-pretty-seq-nonempty collected depth]]]

to-json-pretty-primitive: [fn [let v depth@Int]
  [cond [
    [[builtin-eq v []]     "null"]
    [[bool? v]    [builtin-if v "true" "false"]]
    [[int?  v]    [builtin-str v]]
    [[float? v]   [builtin-str v]]
    [[str?   v]   [json-string v]]
    [[seq?   v]   [to-json-pretty-seq v depth]]
    [[dict?  v]   [to-json-pretty-dict v depth]]
    [true         "null"]]]]

to-json-pretty-impl: [fn [let v depth@Int]
  [match v
    [Program  _]:   [json-program v]
    [Document _]:   [json-document v]
    [Expression _]: [json-expression v]
    _:              [to-json-pretty-primitive v depth]]]

# ---- Back to regular serializer helpers ----

json-annotation: [fn [let a@Annotation] [to-json a]]

json-dotkey: [fn [let k@DotKey]
  [match k
    [Ident s]: [json-variant "Ident" [v: s]]
    [Index i]: [json-variant "Index" [v: i]]]]

json-parameter: [fn [let p@Parameter]
  [to-json-dict
    [name:       p.name
     annotation: [json-annotation p.annotation]
     variadic:   p.variadic
     span:       [json-span p.span]]]]

json-named-arg: [fn [let a@NamedArg]
  [to-json-dict
    [name:  a.name
     value: [json-expression a.value]
     span:  [json-span a.span]]]]

json-entry: [fn [let e@Entry]
  [to-json-dict
    [key:   [to-json e.key]
     value: [json-expression e.value]
     span:  [json-span e.span]]]]

json-match-arm: [fn [let a@MatchArm]
  [to-json-dict
    [pattern: [json-expression a.pattern]
     guard:   [json-expression a.guard]
     body:    [json-expression a.body]
     span:    [json-span a.span]]]]

json-expression: [fn [let expr@Expression]
  [match expr
    [IntLiteral   value: v  span: s]: [json-variant "IntLiteral"   [value: v  span: [json-span s]]]
    [FloatLiteral value: v  span: s]: [json-variant "FloatLiteral" [value: v  span: [json-span s]]]
    [BoolLiteral  value: v  span: s]: [json-variant "BoolLiteral"  [value: v  span: [json-span s]]]
    [StrLiteral   value: v  span: s]: [json-variant "StrLiteral"   [value: v  span: [json-span s]]]
    [Var name: n  escaped: e  span: s]:
      [json-variant "Var" [name: n  escaped: e  span: [json-span s]]]
    [DotAccess target: t  field: f  span: s]:
      [json-variant "DotAccess"
        [target: [json-expression t]  field: [json-dotkey f]  span: [json-span s]]]
    [Pipe lhs: l  rhs: r  span: s]:
      [json-variant "Pipe" [lhs: [json-expression l]  rhs: [json-expression r]  span: [json-span s]]]
    [Sequential exprs: es  span: s]:
      [json-variant "Sequential" [exprs: [to-json-seq [map json-expression es]]  span: [json-span s]]]
    [Dict entries: es  span: s]:
      [json-variant "Dict" [entries: [to-json-seq [map json-entry es]]  span: [json-span s]]]
    [Call fn: f  args: a  named: na  implied: impl  span: s]:
      [json-variant "Call"
        [fn: [json-expression f]  args: [to-json-seq [map json-expression a]]
         named: [to-json-seq [map json-named-arg na]]  implied: impl  span: [json-span s]]]
    [Fn params: ps  body: b  return-ann: ann  desugared: d  span: s]:
      [json-variant "Fn"
        [params: [to-json-seq [map json-parameter ps]]  body: [json-expression b]
         return-ann: [json-annotation ann]  desugared: d  span: [json-span s]]]
    [TypeAssert annotation: ann  expr: e  span: s]:
      [json-variant "TypeAssert" [annotation: [json-annotation ann]  expr: [json-expression e]  span: [json-span s]]]
    [Annotated name: n  annotation: ann  span: s]:
      [json-variant "Annotated" [name: n  annotation: [json-annotation ann]  span: [json-span s]]]
    [Rest name: n  span: s]:
      [json-variant "Rest" [name: n  span: [json-span s]]]
    [Match scrutinee: e  arms: as  span: s]:
      [json-variant "Match" [scrutinee: [json-expression e]  arms: [to-json-seq [map json-match-arm as]]  span: [json-span s]]]
    [Quote         expr: e  span: s]: [json-variant "Quote"         [expr: [json-expression e]  span: [json-span s]]]
    [Unquote       expr: e  span: s]: [json-variant "Unquote"       [expr: [json-expression e]  span: [json-span s]]]
    [UnquoteSplice expr: e  span: s]: [json-variant "UnquoteSplice" [expr: [json-expression e]  span: [json-span s]]]
    [TypeApp fn: f  arg: a  span: s]:
      [json-variant "TypeApp" [fn: [json-expression f]  arg: [json-expression a]  span: [json-span s]]]
    [PatternDecl bindings: bs  span: s]:
      [json-variant "PatternDecl" [bindings: [to-json-seq [map json-expression bs]]  span: [json-span s]]]
    [LetDecl     bindings: bs  span: s]:
      [json-variant "LetDecl"     [bindings: [to-json-seq [map json-expression bs]]  span: [json-span s]]]
    [CaseArm pattern: p  body: b  span: s]:
      [json-variant "CaseArm" [pattern: [json-expression p]  body: [json-expression b]  span: [json-span s]]]
    [Placeholder  span: s]: [json-variant "Placeholder" [span: [json-span s]]]
    [Error        span: s]: [json-variant "Error"        [span: [json-span s]]]
    # DefMacro, MacroDecl, Splice, SyntaxClass are Declaration forms —
    # they appear in Document.declarations, not expressions. See json-declaration.
    ]]

json-declaration: [fn [let d@Declaration]
  [match d
    [TypeAlias params: ps  body: b]:
      [json-variant "TypeAlias" [params: [to-json ps]  body: [json-expression b]]]
    [ClassDecl name: n  params: ps  superclasses: sc  methods: ms
               determines: ds  resolver: r  resolver-injective: ri]:
      [json-variant "ClassDecl"
        [name: n  params: [to-json ps]  superclasses: [to-json sc]  resolver-injective: ri]]
    [InstanceDecl class-name: cn  arms: as]:
      [json-variant "InstanceDecl" [class-name: cn]]
    [DefMacro  name: n  params: p  body: b]:
      [json-variant "DefMacro"  [name: n  params: [json-expression p]  body: [json-expression b]]]
    [MacroDecl name: n  params: p  body: b]:
      [json-variant "MacroDecl" [name: n  params: [json-expression p]  body: [json-expression b]]]
    [Splice forms: fs]:
      [json-variant "Splice" [forms: [to-json-seq [map json-expression fs]]]]
    [SyntaxClass name: n  pattern: p  message: m]:
      [json-variant "SyntaxClass" [name: n  pattern: [json-expression p]  message: m]]]]

json-document: [fn [let d@Document]
  [to-json-dict
    [stage:        [match d.stage Runtime: "Runtime" Type: "Type"]
     name:         [match d.name [Named n]: n  Unnamed: []]
     expressions:  [to-json-seq [map json-expression  d.expressions]]
     declarations: [to-json-seq [map json-declaration d.declarations]]]]]

json-program: [fn [let p@Program]
  [to-json-dict [documents: [to-json-seq [map json-document p.documents]]]]]

to-json-primitive: [fn [let v]
  [cond [
    [[builtin-eq v []]     "null"]
    [[bool? v]    [builtin-if v "true" "false"]]
    [[int?  v]    [builtin-str v]]
    [[float? v]   [builtin-str v]]
    [[str?   v]   [json-string v]]
    [[seq?   v]   [to-json-seq v]]
    [[dict?  v]   [to-json-dict v]]
    # Variant values (Program/Document/Expression) are handled by the match dispatch in
    # to-json above. All other variant values (user-defined, Ok/Error, etc.) produce "null"
    # here — payload-of is now available in prelude (added in runtime-v2-rebase sprint);
    # Variant serialization can be improved to use it in a future sprint.
    [true         "null"]]]]

# ---- Deserializer helpers ----
# Uses str-length and builtin-str-slice from prelude (both available without strings.llt).
# Each json-parse-* function takes remaining input and returns [value: v  rest: r].

# json-char-at: extract the character at index n (0-based) from string s.
# Uses builtin-str-slice directly (prelude builtin) to avoid dependency on strings.llt str-at.
json-char-at: [fn [let n@Int s@String]
  [builtin-str-slice s n [builtin-add n 1]]]

json-ws?: [fn [let c@String]
  [or [builtin-eq c " "] [or [builtin-eq c "\t"] [or [builtin-eq c "\n"] [builtin-eq c "\r"]]]]]

json-skip-ws: [fn [let s@String]
  [builtin-if [or [builtin-eq [str-length s] 0] [not [json-ws? [json-char-at 0 s]]]]
    s
    [json-skip-ws [builtin-str-slice s 1 [str-length s]]]]]

json-parsed: [fn [let parsed-value parsed-rest@String]
  [value: parsed-value  rest: parsed-rest]]

json-rest: [fn [let s@String n@Int]
  [builtin-str-slice s n [str-length s]]]

json-starts-with: [fn [let prefix@String s@String]
  [builtin-if [builtin-lt [str-length s] [str-length prefix]]
    false
    [builtin-eq [builtin-str-slice s 0 [str-length prefix]] prefix]]]

json-parse-null: [fn [let s@String]
  [builtin-if [json-starts-with "null" s]
    [json-parsed [] [json-rest s 4]]
    [builtin-raise "JSON: expected 'null'"]]]

json-parse-true: [fn [let s@String]
  [builtin-if [json-starts-with "true" s]
    [json-parsed true [json-rest s 4]]
    [builtin-raise "JSON: expected 'true'"]]]

json-parse-false: [fn [let s@String]
  [builtin-if [json-starts-with "false" s]
    [json-parsed false [json-rest s 5]]
    [builtin-raise "JSON: expected 'false'"]]]

json-digit?: [fn [let c@String]
  [and [>= c "0"] [<= c "9"]]]

json-num-char?: [fn [let c@String]
  [or [json-digit? c]
      [or [builtin-eq c "."] [or [builtin-eq c "e"] [or [builtin-eq c "E"]
      [or [builtin-eq c "-"] [builtin-eq c "+"]]]]]]]

json-scan-num: [fn [let s@String i@Int]
  [builtin-if [or [>= i [str-length s]] [not [json-num-char? [json-char-at i s]]]]
    i
    [json-scan-num s [builtin-add i 1]]]]

json-parse-number: [fn [let s@String]
  [len:     [json-scan-num s 0]]
  [num-str: [builtin-str-slice s 0 len]]
  [rest:    [json-rest s len]]
  [float?:  [or [str-contains? "." num-str]
                [or [str-contains? "e" num-str]
                    [str-contains? "E" num-str]]]]
  [json-parsed
    [builtin-if float? [to-float num-str] [to-int num-str]]
    rest]]

json-unescape: [fn [let c@String]
  [cond [
    [[builtin-eq c "\""] "\""]
    [[builtin-eq c "\\"] "\\"]
    [[builtin-eq c "/"]  "/"]
    [[builtin-eq c "n"]  "\n"]
    [[builtin-eq c "r"]  "\r"]
    [[builtin-eq c "t"]  "\t"]
    [[builtin-eq c "b"]  [chr 8]]
    [[builtin-eq c "f"]  [chr 12]]
    [true [builtin-raise [builtin-str "JSON: unknown escape \\" c]]]]]]

# Convert a single ASCII hex character ('0'-'9', 'a'-'f', 'A'-'F') to its integer value.
json-hex-digit-val: [fn [let c@String]
  [code: [char-code c]]
  [cond [
    [[and [>= code 48] [<= code 57]]  [builtin-sub code 48]]         # '0'-'9'
    [[and [>= code 97] [<= code 102]] [builtin-add 10 [builtin-sub code 97]]]   # 'a'-'f'
    [[and [>= code 65] [<= code 70]]  [builtin-add 10 [builtin-sub code 65]]]   # 'A'-'F'
    [true [builtin-raise [builtin-str "JSON: invalid hex digit: " c]]]]]]

# Parse 4 consecutive hex chars from string s into an integer (0x0000-0xFFFF).
json-hex4-to-int: [fn [let s@String]
  [builtin-add
    [builtin-mul [json-hex-digit-val [json-char-at 0 s]] 4096]
  [builtin-add
    [builtin-mul [json-hex-digit-val [json-char-at 1 s]] 256]
  [builtin-add
    [builtin-mul [json-hex-digit-val [json-char-at 2 s]] 16]
    [json-hex-digit-val [json-char-at 3 s]]]]]]

json-parse-string-body: [fn [let s@String acc@String]
  [builtin-if [builtin-eq [str-length s] 0]
    [builtin-raise "JSON: unterminated string"]
    [cond [
      [[builtin-eq [json-char-at 0 s] "\""]
       [json-parsed acc [json-rest s 1]]]
      [[builtin-eq [json-char-at 0 s] "\\"]
       [builtin-if [builtin-lt [str-length s] 2]
         [builtin-raise "JSON: incomplete escape"]
         [builtin-if [builtin-eq [json-char-at 1 s] "u"]
           # \uXXXX Unicode escape — consume 6 chars total (\uXXXX)
           [builtin-if [builtin-lt [str-length s] 6]
             [builtin-raise "JSON: incomplete \\uXXXX escape"]
             [json-parse-string-body
               [json-rest s 6]
               [builtin-str acc [chr [json-hex4-to-int [builtin-str-slice s 2 6]]]]]]
           # Other single-char escapes — consume 2 chars
           [json-parse-string-body
             [json-rest s 2]
             [builtin-str acc [json-unescape [json-char-at 1 s]]]]]]]
      [true
       [json-parse-string-body [json-rest s 1] [builtin-str acc [json-char-at 0 s]]]]]]]]

json-parse-string: [fn [let s@String]
  # s starts with "
  [json-parse-string-body [json-rest s 1] ""]]

json-parse-array-items: [fn [let s@String i@Int bld]
  # Uses builder-set for O(1) insertion with computed integer key.
  [item: [json-parse-value s]]
  [bld2: [builder-set bld i item.value]]
  [s2:   [json-skip-ws item.rest]]
  [cond [
    [[builtin-eq [json-char-at 0 s2] "]"] [json-parsed [builder-finish bld2] [json-rest s2 1]]]
    [[builtin-eq [json-char-at 0 s2] ","] [json-parse-array-items [json-skip-ws [json-rest s2 1]] [builtin-add i 1] bld2]]
    [true [builtin-raise "JSON: expected ',' or ']' in array"]]]]]

json-parse-array: [fn [let s@String]
  # s starts with [
  [s2: [json-skip-ws [json-rest s 1]]]
  [builtin-if [builtin-eq [json-char-at 0 s2] "]"]
    [json-parsed [] [json-rest s2 1]]
    [json-parse-array-items s2 0 [make-builder]]]]

json-parse-object-pairs: [fn [let s@String bld]
  # Uses builder-set for O(1) insertion with computed string key.
  [k:    [json-parse-string
            [builtin-if [not [builtin-eq [json-char-at 0 s] "\""]]
              [builtin-raise "JSON: expected string key in object"]
              s]]]
  [s2:   [json-skip-ws k.rest]]
  [v:    [json-parse-value
            [builtin-if [not [builtin-eq [json-char-at 0 s2] ":"]]
              [builtin-raise "JSON: expected ':' after object key"]
              [json-skip-ws [json-rest s2 1]]]]]
  [bld2: [builder-set bld k.value v.value]]
  [s3:   [json-skip-ws v.rest]]
  [cond [
    [[builtin-eq [json-char-at 0 s3] "}"] [json-parsed [builder-finish bld2] [json-rest s3 1]]]
    [[builtin-eq [json-char-at 0 s3] ","] [json-parse-object-pairs [json-skip-ws [json-rest s3 1]] bld2]]
    [true [builtin-raise "JSON: expected ',' or '}' in object"]]]]]

json-parse-object: [fn [let s@String]
  # s starts with {
  [s2: [json-skip-ws [json-rest s 1]]]
  [builtin-if [builtin-eq [json-char-at 0 s2] "}"]
    [json-parsed [] [json-rest s2 1]]
    [json-parse-object-pairs s2 [make-builder]]]]

json-parse-value: [fn [let s@String]
  [s2: [json-skip-ws s]]
  [builtin-if [builtin-eq [str-length s2] 0]
    [builtin-raise "JSON: unexpected end of input"]
    [cond [
      [[builtin-eq [json-char-at 0 s2] "n"]  [json-parse-null s2]]
      [[builtin-eq [json-char-at 0 s2] "t"]  [json-parse-true s2]]
      [[builtin-eq [json-char-at 0 s2] "f"]  [json-parse-false s2]]
      [[builtin-eq [json-char-at 0 s2] "\""] [json-parse-string s2]]
      [[builtin-eq [json-char-at 0 s2] "["]  [json-parse-array s2]]
      [[builtin-eq [json-char-at 0 s2] "{"]  [json-parse-object s2]]
      [[or [builtin-eq [json-char-at 0 s2] "-"] [json-digit? [json-char-at 0 s2]]] [json-parse-number s2]]
      [true [builtin-raise [builtin-str "JSON: unexpected character: " [json-char-at 0 s2]]]]]]]]

# ---- Public API ----

to-json@[doc: "Serialize any tinct value to a compact JSON string.
Expression, Document, and Program values use the Variant encoding {\"Tag\": {fields}}.
Primitive types serialize directly. Not every tinct type is serializable to JSON —
Fn, Handle, Task, Channel etc. produce null."]:
  [fn [let v]
    [match v
      [Program  _]:   [json-program v]
      [Document _]:   [json-document v]
      [Expression _]: [json-expression v]
      _:              [to-json-primitive v]]]

to-json-pretty@[doc: "Serialize any tinct value to a pretty-printed JSON string with 2-space indentation.
Expression, Document, and Program values use the Variant encoding {\"Tag\": {fields}}.
Primitive types serialize directly. Not every tinct type is serializable to JSON —
Fn, Handle, Task, Channel etc. produce null.
Empty dicts render as {}, empty arrays as [] (compact, no newlines)."]:
  [fn [let v]
    [to-json-pretty-impl v 0]]

# from-json: Pure-tinct JSON parser implementation.
# Takes a JSON string and returns a tinct value (Dict, Seq, String, Int, Float, Bool, or []).
# The parser uses str-length and builtin-str-slice from prelude, and json-char-at from this dict.
from-json@[doc: "Parse a JSON string into a tinct value.

Parameters:
  s@String — JSON string to parse

Returns:
  Any — Parsed value (Dict, Seq, String, Int, Float, Bool, or [] for null)

Raises error on invalid JSON syntax."]:
  [fn [let s@String]
    [parsed: [json-parse-value s]]
    parsed.value]

]
