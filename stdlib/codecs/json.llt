# stdlib/codecs/json.llt — JSON codec (post-runtime-v2)
#
# Public API (second dict):
#   to-json:   tinct value → compact JSON string
#   from-json: JSON string → structural tinct value
#
# str-at/str-length come from strings.llt (included above). str-slice comes from
# prelude (builtin-str-slice alias, (string, start, end) semantics). The dead-code
# parser below uses builtin-str-slice directly for clarity.
# from-json produces only: Dict, Seq, String, Int, Float, Bool, [] (null).
# Not every tinct type round-trips through JSON — Expression/Program/Document/Fn/
# Handle/Task/etc. have no JSON representation. Schema-directed reconstruction
# (JSON → nominal type) is the caller's responsibility.

[include %libdir "strings.llt"]

# ---- Internal helpers ----
[

# ---- Serializer helpers ----

json-escape: [fn [s@String]
  [str-replace "\\" "\\\\"
  [str-replace "\"" "\\\""
  [str-replace "\n" "\\n"
  [str-replace "\r" "\\r"
  [str-replace "\t" "\\t"
    s]]]]]]

json-string: [fn [s@String]
  [str "\"" [json-escape s] "\""]]

json-variant: [fn [tag@String fields]
  [str "{" [json-string tag] ":" [to-json fields] "}"]]

json-span: [fn [s@Span]
  [str "{\"file\":"        [json-string s.file]
       ",\"start-line\":"  [str s.start-line]
       ",\"start-col\":"   [str s.start-col]
       ",\"end-line\":"    [str s.end-line]
       ",\"end-col\":"     [str s.end-col] "}"]]

to-json-dict: [fn [d@Dict]
  [str "{"
    [join ","
      [map [fn [pair] [str [json-string pair[0]] ":" [to-json pair[1]]]]
           [entries d]]]
    "}"]]

to-json-seq: [fn [s]
  [str "[" [join "," [map to-json [collect s]]] "]"]]

json-annotation: [fn [a@Annotation] [to-json a]]

json-dotkey: [fn [k@DotKey]
  [match k
    [Ident s]: [json-variant "Ident" [v: s]]
    [Index i]: [json-variant "Index" [v: i]]]]

json-parameter: [fn [p@Parameter]
  [to-json-dict
    [name:       p.name
     annotation: [json-annotation p.annotation]
     variadic:   p.variadic
     span:       [json-span p.span]]]]

json-named-arg: [fn [a@NamedArg]
  [to-json-dict
    [name:  a.name
     value: [json-expression a.value]
     span:  [json-span a.span]]]]

json-entry: [fn [e@Entry]
  [to-json-dict
    [key:   [to-json e.key]
     value: [json-expression e.value]
     span:  [json-span e.span]]]]

json-match-arm: [fn [a@MatchArm]
  [to-json-dict
    [pattern: [json-expression a.pattern]
     guard:   [json-expression a.guard]
     body:    [json-expression a.body]
     span:    [json-span a.span]]]]

json-expression: [fn [expr@Expression]
  [match expr
    [IntLiteral   value: v  span: s]: [json-variant "IntLiteral"   [value: v  span: [json-span s]]]
    [FloatLiteral value: v  span: s]: [json-variant "FloatLiteral" [value: v  span: [json-span s]]]
    [BoolLiteral  value: v  span: s]: [json-variant "BoolLiteral"  [value: v  span: [json-span s]]]
    [StrLiteral   value: v  span: s]: [json-variant "StrLiteral"   [value: v  span: [json-span s]]]
    [Var name: n  escaped: e  span: s]:
      [json-variant "Var" [name: n  escaped: e  span: [json-span s]]]
    [DotAccess target: t  field: f  span: s]:
      [json-variant "DotAccess"
        [target: [json-expression t]  field: [json-dotkey f]  span: [json-span s]]]
    [Pipe lhs: l  rhs: r  span: s]:
      [json-variant "Pipe" [lhs: [json-expression l]  rhs: [json-expression r]  span: [json-span s]]]
    [Sequential exprs: es  span: s]:
      [json-variant "Sequential" [exprs: [to-json-seq [map json-expression es]]  span: [json-span s]]]
    [Dict entries: es  span: s]:
      [json-variant "Dict" [entries: [to-json-seq [map json-entry es]]  span: [json-span s]]]
    [Call fn: f  args: a  named: na  implied: impl  span: s]:
      [json-variant "Call"
        [fn: [json-expression f]  args: [to-json-seq [map json-expression a]]
         named: [to-json-seq [map json-named-arg na]]  implied: impl  span: [json-span s]]]
    [Fn params: ps  body: b  return-ann: ann  desugared: d  span: s]:
      [json-variant "Fn"
        [params: [to-json-seq [map json-parameter ps]]  body: [json-expression b]
         return-ann: [json-annotation ann]  desugared: d  span: [json-span s]]]
    [TypeAssert annotation: ann  expr: e  span: s]:
      [json-variant "TypeAssert" [annotation: [json-annotation ann]  expr: [json-expression e]  span: [json-span s]]]
    [Annotated name: n  annotation: ann  span: s]:
      [json-variant "Annotated" [name: n  annotation: [json-annotation ann]  span: [json-span s]]]
    [Rest name: n  span: s]:
      [json-variant "Rest" [name: n  span: [json-span s]]]
    [Match scrutinee: e  arms: as  span: s]:
      [json-variant "Match" [scrutinee: [json-expression e]  arms: [to-json-seq [map json-match-arm as]]  span: [json-span s]]]
    [Quote         expr: e  span: s]: [json-variant "Quote"         [expr: [json-expression e]  span: [json-span s]]]
    [Unquote       expr: e  span: s]: [json-variant "Unquote"       [expr: [json-expression e]  span: [json-span s]]]
    [UnquoteSplice expr: e  span: s]: [json-variant "UnquoteSplice" [expr: [json-expression e]  span: [json-span s]]]
    [TypeApp fn: f  arg: a  span: s]:
      [json-variant "TypeApp" [fn: [json-expression f]  arg: [json-expression a]  span: [json-span s]]]
    [PatternDecl bindings: bs  span: s]:
      [json-variant "PatternDecl" [bindings: [to-json-seq [map json-expression bs]]  span: [json-span s]]]
    [LetDecl     bindings: bs  span: s]:
      [json-variant "LetDecl"     [bindings: [to-json-seq [map json-expression bs]]  span: [json-span s]]]
    [CaseArm pattern: p  body: b  span: s]:
      [json-variant "CaseArm" [pattern: [json-expression p]  body: [json-expression b]  span: [json-span s]]]
    [Placeholder  span: s]: [json-variant "Placeholder" [span: [json-span s]]]
    [Error        span: s]: [json-variant "Error"        [span: [json-span s]]]
    # DefMacro, MacroDecl, Splice, SyntaxClass are Declaration forms —
    # they appear in Document.declarations, not expressions. See json-declaration.
    ]]

json-declaration: [fn [d@Declaration]
  [match d
    [TypeAlias params: ps  body: b]:
      [json-variant "TypeAlias" [params: [to-json ps]  body: [json-expression b]]]
    [ClassDecl name: n  params: ps  superclasses: sc  methods: ms
               determines: ds  resolver: r  resolver-injective: ri]:
      [json-variant "ClassDecl"
        [name: n  params: [to-json ps]  superclasses: [to-json sc]  resolver-injective: ri]]
    [InstanceDecl class-name: cn  arms: as]:
      [json-variant "InstanceDecl" [class-name: cn]]
    [DefMacro  name: n  params: p  body: b]:
      [json-variant "DefMacro"  [name: n  params: [json-expression p]  body: [json-expression b]]]
    [MacroDecl name: n  params: p  body: b]:
      [json-variant "MacroDecl" [name: n  params: [json-expression p]  body: [json-expression b]]]
    [Splice forms: fs]:
      [json-variant "Splice" [forms: [to-json-seq [map json-expression fs]]]]
    [SyntaxClass name: n  pattern: p  message: m]:
      [json-variant "SyntaxClass" [name: n  pattern: [json-expression p]  message: m]]]]

json-document: [fn [d@Document]
  [to-json-dict
    [stage:        [match d.stage Runtime: "Runtime" Type: "Type"]
     name:         [match d.name [Named n]: n  Unnamed: []]
     expressions:  [to-json-seq [map json-expression  d.expressions]]
     declarations: [to-json-seq [map json-declaration d.declarations]]]]]

json-program: [fn [p@Program]
  [to-json-dict [documents: [to-json-seq [map json-document p.documents]]]]]

to-json-primitive: [fn [v]
  [cond
    [[= v []]     "null"]
    [[bool? v]    [if v "true" "false"]]
    [[int?  v]    [str v]]
    [[float? v]   [str v]]
    [[str?   v]   [json-string v]]
    [[seq?   v]   [to-json-seq v]]
    [[dict?  v]   [to-json-dict v]]
    # Variant values (Program/Document/Expression) are handled by the match dispatch in
    # to-json above. All other variant values (user-defined, Ok/Error, etc.) produce "null"
    # here — payload-of is now available in prelude (added in runtime-v2-rebase sprint);
    # Variant serialization can be improved to use it in a future sprint.
    [true         "null"]]]

# ---- Deserializer helpers ----
# Uses str-at/str-length from strings.llt and builtin-str-slice from prelude.
# Each json-parse-* function takes remaining input and returns [value: v  rest: r].

json-ws?: [fn [c@String]
  [or [= c " "] [or [= c "\t"] [or [= c "\n"] [= c "\r"]]]]]

json-skip-ws: [fn [s@String]
  [if [or [= [str-length s] 0] [not [json-ws? [str-at 0 s]]]]
    s
    [json-skip-ws [builtin-str-slice s 1 [str-length s]]]]]

json-parsed: [fn [value rest@String]
  [value: value  rest: rest]]

json-rest: [fn [s@String n@Int]
  [builtin-str-slice s n [str-length s]]]

json-starts-with: [fn [prefix@String s@String]
  [if [< [str-length s] [str-length prefix]]
    false
    [= [builtin-str-slice s 0 [str-length prefix]] prefix]]]

json-parse-null: [fn [s@String]
  [if [json-starts-with "null" s]
    [json-parsed [] [json-rest s 4]]
    [raise "JSON: expected 'null'"]]]

json-parse-true: [fn [s@String]
  [if [json-starts-with "true" s]
    [json-parsed true [json-rest s 4]]
    [raise "JSON: expected 'true'"]]]

json-parse-false: [fn [s@String]
  [if [json-starts-with "false" s]
    [json-parsed false [json-rest s 5]]
    [raise "JSON: expected 'false'"]]]

json-digit?: [fn [c@String]
  [and [>= c "0"] [<= c "9"]]]

json-num-char?: [fn [c@String]
  [or [json-digit? c]
      [or [= c "."] [or [= c "e"] [or [= c "E"]
      [or [= c "-"] [= c "+"]]]]]]]

json-scan-num: [fn [s@String i@Int]
  [if [or [>= i [str-length s]] [not [json-num-char? [str-at i s]]]]
    i
    [json-scan-num s [+ i 1]]]]

json-parse-number: [fn [s@String]
  [len:     [json-scan-num s 0]]
  [num-str: [builtin-str-slice s 0 len]]
  [rest:    [json-rest s len]]
  [float?:  [or [str-contains? "." num-str]
                [or [str-contains? "e" num-str]
                    [str-contains? "E" num-str]]]]
  [json-parsed
    [if float? [to-float num-str] [to-int num-str]]
    rest]]

json-unescape: [fn [c@String]
  [cond
    [[= c "\""] "\""]
    [[= c "\\"] "\\"]
    [[= c "/"]  "/"]
    [[= c "n"]  "\n"]
    [[= c "r"]  "\r"]
    [[= c "t"]  "\t"]
    [[= c "b"]  [chr 8]]
    [[= c "f"]  [chr 12]]
    [true [raise [str "JSON: unknown escape \\" c]]]]]

json-parse-string-body: [fn [s@String acc@String]
  [if [= [str-length s] 0]
    [raise "JSON: unterminated string"]
    [c: [str-at 0 s]]
    [cond
      [[= c "\""]
       [json-parsed acc [json-rest s 1]]]
      [[= c "\\"]
       [if [< [str-length s] 2]
         [raise "JSON: incomplete escape"]
         [json-parse-string-body
           [json-rest s 2]
           [str acc [json-unescape [str-at 1 s]]]]]]
      [true
       [json-parse-string-body [json-rest s 1] [str acc c]]]]]]

json-parse-string: [fn [s@String]
  # s starts with "
  [json-parse-string-body [json-rest s 1] ""]]

json-parse-array-items: [fn [s@String i@Int acc@Dict]
  [item:  [json-parse-value s]]
  [acc:   [merge acc [[i]: item.value]]]
  [s:     [json-skip-ws item.rest]]
  [c:     [str-at 0 s]]
  [cond
    [[= c "]"] [json-parsed acc [json-rest s 1]]]
    [[= c ","] [json-parse-array-items [json-skip-ws [json-rest s 1]] [+ i 1] acc]]
    [true [raise "JSON: expected ',' or ']' in array"]]]]

json-parse-array: [fn [s@String]
  # s starts with [
  [s: [json-skip-ws [json-rest s 1]]]
  [if [= [str-at 0 s] "]"]
    [json-parsed [] [json-rest s 1]]
    [json-parse-array-items s 0 []]]]

json-parse-object-pairs: [fn [s@String acc@Dict]
  [if [not [= [str-at 0 s] "\""]]
    [raise "JSON: expected string key in object"]
    [k:    [json-parse-string s]]
    [s:    [json-skip-ws k.rest]]
    [if [not [= [str-at 0 s] ":"]]
      [raise "JSON: expected ':' after object key"]
      [v:   [json-parse-value [json-skip-ws [json-rest s 1]]]]
      [acc: [merge acc [[k.value]: v.value]]]
      [s:   [json-skip-ws v.rest]]
      [c:   [str-at 0 s]]
      [cond
        [[= c "}"] [json-parsed acc [json-rest s 1]]]
        [[= c ","] [json-parse-object-pairs [json-skip-ws [json-rest s 1]] acc]]
        [true [raise "JSON: expected ',' or '}' in object"]]]]]]

json-parse-object: [fn [s@String]
  # s starts with {
  [s: [json-skip-ws [json-rest s 1]]]
  [if [= [str-at 0 s] "}"]
    [json-parsed [] [json-rest s 1]]
    [json-parse-object-pairs s []]]]

json-parse-value: [fn [s@String]
  [s: [json-skip-ws s]]
  [if [= [str-length s] 0]
    [raise "JSON: unexpected end of input"]
    [c: [str-at 0 s]]
    [cond
      [[= c "n"]  [json-parse-null s]]
      [[= c "t"]  [json-parse-true s]]
      [[= c "f"]  [json-parse-false s]]
      [[= c "\""] [json-parse-string s]]
      [[= c "["]  [json-parse-array s]]
      [[= c "{"]  [json-parse-object s]]
      [[or [= c "-"] [json-digit? c]] [json-parse-number s]]
      [true [raise [str "JSON: unexpected character: " c]]]]]]

]

# ---- Public API ----
[

to-json@[doc: "Serialize any tinct value to a compact JSON string.
Expression, Document, and Program values use the Variant encoding {\"Tag\": {fields}}.
Primitive types serialize directly. Not every tinct type is serializable to JSON —
Fn, Handle, Task, Channel etc. produce null."]:
  [fn [v]
    [match v
      [Program  _]:   [json-program v]
      [Document _]:   [json-document v]
      [Expression _]: [json-expression v]
      _:              [to-json-primitive v]]]

# from-json: Pure-tinct JSON parser implementation.
# Takes a JSON string and returns a tinct value (Dict, Seq, String, Int, Float, Bool, or []).
# The parser uses str-at/str-length from strings.llt and builtin-str-slice from prelude.
from-json@[doc: "Parse a JSON string into a tinct value.

Parameters:
  s@String — JSON string to parse

Returns:
  Any — Parsed value (Dict, Seq, String, Int, Float, Bool, or [] for null)

Raises error on invalid JSON syntax."]:
  [fn [s@String]
    [json-parse-value [json-skip-ws s]].value]

]
