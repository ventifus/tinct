# ============================================================================
# LLT TOML-Lite Parser (stdlib/toml-lite.llt)
# ============================================================================
#
# Pure-tinct TOML parser that handles a subset of TOML features.
#
# Supported TOML features:
#   - [section] headers → nested dict
#   - [[array-table]] → array of dicts under that key
#   - key = "string-value" → string values (quoted)
#   - key = value → bare values (integers, booleans, bare strings)
#   - # comments → ignored
#   - Blank lines → ignored
#
# Depends on prelude functions (loaded before this module):
#   Logic:       not, and
#   Comparison:  >=, >
#   Control:     if
#   Arithmetic:  +, -
#   Dict:        keys, length, merge, append, get, get-or, has?, make-entry
#   String:      str, split, trim, str-slice, str-contains?, starts-with?
#   Sequences:   collect, filter, map
#   Numeric:     to-int
#   Error:       try-or
#   List:        first
#   Collections: all?
#
# ============================================================================

# ============================================================================
# FIRST DICT: Private helpers (not exported)
# ============================================================================

[

# Check if a line is blank or a comment.
# Type: (String -> Bool)
not-blank-or-comment: [fn@Bool [let line@String]
    [builtin-if [builtin-eq [length line] 0]
        false
        [not [starts-with? "#" line]]]]

# Parse section name, splitting on dots for nested sections.
# Type: (String -> Dict String)
parse-section-name: [fn@Dict [let name@String]
    [builtin-if [str-contains? "." name]
        [collect [split "." name]]
        [0: name]]]

# Parse a [[array-table]] header into a path list.
# Type: (String -> Dict String)
parse-array-table-header: [fn@Dict [let line@String]
    [parse-section-name [trim [str-slice 2 [builtin-sub [length line] 2] line]]]]

# Split on = and build the key-value entry.
# Type: (String -> Int -> Dict)
parse-kv-split: [fn@Dict [let line@String eq-pos@Int]
    [parse-kv-build
        [trim [str-slice 0 eq-pos line]]
        [trim [str-slice [builtin-add eq-pos 1] [length line] line]]]]

# Build the key-value dict entry.
# Type: (String -> String -> Dict)
parse-kv-build: [fn@Dict [let key@String value@String]
    [make-entry key [parse-value-impl value]]]

# Try parsing as integer, fall back to boolean or bare string.
# Type: (String -> Any)
parse-value-try-int: [fn [let value@String]
    [try-or
        [fn [let] [to-int value]]
        [parse-value-try-bool value]]]

# Try parsing as boolean, fall back to bare string.
# Type: (String -> Any)
parse-value-try-bool: [fn [let value@String]
    [builtin-if [builtin-eq value "true"]
        true
        [builtin-if [builtin-eq value "false"]
            false
            value]]]

# Parse a TOML value — internal impl.
# Type: (String -> Any)
parse-value-impl: [fn [let value@String]
    [builtin-if [starts-with? "\"" value]
        [str-slice 1 [builtin-sub [length value] 1] value]
        [parse-value-try-int value]]]

# Parse a key = value line into a single-entry dict — internal impl.
# Type: (String -> Dict)
parse-key-value-impl: [fn@Dict [let line@String]
    [parse-kv-split line [str-find line "="]]]

# Recursive line processor with accumulator.
# Type: (Dict String -> Int -> Int -> Dict -> Dict String -> Dict)
parse-lines-impl: [fn@Dict [let lines i@Int len@Int acc@Dict current-path]
    [builtin-if [>= i len]
        acc
        [parse-line-dispatch lines i len acc current-path [get i lines]]]]

# Dispatch on line type: [section], [[array-table]], or key = value.
# Type: (Dict String -> Int -> Int -> Dict -> Dict String -> String -> Dict)
parse-line-dispatch: [fn@Dict [let lines i@Int len@Int acc@Dict current-path line@String]
    [builtin-if [starts-with? "[[" line]
        # Array table: [[name]]
        [parse-lines-impl lines [builtin-add i 1] len
            [toml-append-array-table-impl acc [parse-array-table-header line]]
            [parse-array-table-header line]]
        [builtin-if [starts-with? "[" line]
            # Section: [name]
            [parse-lines-impl lines [builtin-add i 1] len acc [parse-section-header-impl line]]
            # Key-value pair
            [parse-lines-impl lines [builtin-add i 1] len
                [toml-set-at-path-impl-entry acc current-path [parse-key-value-impl line]]
                current-path]]]]

# Parse a [section] header into a path list — internal impl.
# Type: (String -> Dict String)
parse-section-header-impl: [fn@Dict [let line@String]
    [parse-section-name [trim [str-slice 1 [builtin-sub [length line] 1] line]]]]

# Process a list of non-blank, non-comment lines — internal impl.
# Type: (Dict String -> Dict)
parse-toml-lines-impl: [fn@Dict [let lines]
    [parse-lines-impl lines 0 [length lines] [] []]]

# Recursive path setter — entry point.
# Type: (Dict -> Dict String -> Dict -> Dict)
toml-set-at-path-impl-entry: [fn@Dict [let root@Dict path kv@Dict]
    [builtin-if [builtin-eq [type-of path] "String"]
        [merge root kv]
        [builtin-if [builtin-eq [length path] 0]
            [merge root kv]
            [toml-set-at-path-rec root path kv 0]]]]

# Recursive path setter — recursive step.
# Type: (Dict -> Dict String -> Dict -> Int -> Dict)
toml-set-at-path-rec: [fn@Dict [let root@Dict path kv@Dict depth@Int]
    [builtin-if [builtin-eq depth [builtin-sub [length path] 1]]
        [toml-set-at-path-final root [get depth path] kv]
        [merge root [make-entry [get depth path]
            [toml-set-at-path-rec
                [get-or [get depth path] [] root]
                path
                kv
                [builtin-add depth 1]]]]]]

# Final path segment: check if target is an array, merge into last element.
# Type: (Dict -> String -> Dict -> Dict)
toml-set-at-path-final: [fn@Dict [let root@Dict key@String kv@Dict]
    [toml-set-at-path-final-check root key kv [get-or key [] root]]]

toml-set-at-path-final-check: [fn@Dict [let root@Dict key@String kv@Dict target]
    [builtin-if [is-array? target]
        [builtin-if [> [length target] 0]
            [merge root [make-entry key [toml-merge-into-last-impl target kv]]]
            [merge root [make-entry key [merge target kv]]]]
        [merge root [make-entry key [merge target kv]]]]]

toml-merge-into-last-impl: [fn@Dict [let arr@Dict kv@Dict]
    [merge arr [make-entry [builtin-sub [length arr] 1] [merge [get [builtin-sub [length arr] 1] arr] kv]]]]

# Check if a value is an array (dict with all integer keys and non-empty).
# Type: (Any -> Bool)
is-array?: [fn@Bool [let xs]
    [and [dict? xs] [is-array?-check-keys xs]]]

is-array?-check-keys: [fn@Bool [let xs@Dict]
    [builtin-if [builtin-eq [length xs] 0]
        false
        [all? int? [keys xs]]]]

# Recursive array table appender — recursive step.
# Type: (Dict -> Dict String -> Int -> Dict)
toml-append-array-rec: [fn@Dict [let root@Dict path depth@Int]
    [builtin-if [builtin-eq depth [builtin-sub [length path] 1]]
        [merge root [make-entry [get depth path]
            [append [] [get-or [get depth path] [] root]]]]
        [merge root [make-entry [get depth path]
            [toml-append-array-rec
                [get-or [get depth path] [] root]
                path
                [builtin-add depth 1]]]]]]

# Append a new dict to an array table at the given path — internal impl.
# Type: (Dict -> Dict String -> Dict)
toml-append-array-table-impl: [fn@Dict [let root@Dict path]
    [builtin-if [builtin-eq [type-of path] "String"]
        [merge root [make-entry path [append [] [get-or path [] root]]]]
        [builtin-if [builtin-eq [length path] 0]
            root
            [toml-append-array-rec root path 0]]]]

]

# ============================================================================
# SECOND DICT: Public API (exported)
# ============================================================================

[

# Parse a TOML-lite document into a nested dict structure.
# Returns: [Ok dict] or [Error message]
parse-toml-lite@[doc: "Parse a TOML-lite document into a nested dict structure"]: [fn [let input]
    [try [fn [let] [parse-toml-lines-impl
        [collect
            [filter [fn [let line] [not-blank-or-comment line]]
                [map [fn [let line] [trim line]]
                    [if [seq? input]
                        input
                        [split "\n" input]]]]]]]]]

# Process a list of non-blank, non-comment lines.
# Type: (Dict String -> Dict)
parse-toml-lines: [fn@Dict [let lines]
    [parse-toml-lines-impl lines]]

# Parse a [section] header into a path list.
# Type: (String -> Dict String)
# Example: "[server]" => ["server"]
# Example: "[database.options]" => ["database" "options"]
parse-section-header: [fn@Dict [let line@String]
    [parse-section-header-impl line]]

# Parse a key = value line into a single-entry dict.
# Type: (String -> Dict)
# Example: "key = \"value\"" => [key: "value"]
# Example: "count = 42" => [count: 42]
parse-key-value: [fn@Dict [let line@String]
    [parse-key-value-impl line]]

# Parse a TOML value (string, integer, boolean, or bare string).
# Type: (String -> Any)
# Example: "\"hello\"" => "hello"
# Example: "42" => 42
# Example: "true" => true
parse-value: [fn [let value@String]
    [parse-value-impl value]]

# Set a key-value pair at a nested path.
# Type: (Dict -> Dict String -> Dict -> Dict)
# Example: [toml-set-at-path [] ["server"] [port: 8080]] => [server: [port: 8080]]
toml-set-at-path: [fn@Dict [let root@Dict path kv@Dict]
    [toml-set-at-path-impl-entry root path kv]]

# Merge kv into the last element of an array (integer-keyed dict).
# Type: (Dict -> Dict -> Dict)
toml-merge-into-last: [fn@Dict [let arr@Dict kv@Dict]
    [toml-merge-into-last-impl arr kv]]

# Append a new dict to an array table at the given path.
# Type: (Dict -> Dict String -> Dict)
# Example: [toml-append-array-table [] ["items"]] => [items: [[]]]
toml-append-array-table: [fn@Dict [let root@Dict path]
    [toml-append-array-table-impl root path]]

]
