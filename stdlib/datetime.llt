# Date-time helpers (pure tinct, depends on builtins)
--- uses: ["datetime"]
[
# Internal helper dict — provides pad-left utility
pad-left: [include %libdir "strings.llt"].pad-left
]

# Public API dict
[days-between@[doc: "Calculate days between two timestamps"]: [fn@Integer [let a@Timestamp b@Timestamp] [duration->seconds [timestamp-diff b a]]]
 timestamp-in-range?@[doc: "Check if a timestamp is within a range"]: [fn@Boolean [let t@Timestamp start@Timestamp end@Timestamp] [and [timestamp<? start t] [timestamp<? t end]]]
 format-date@[doc: "Format a timestamp as YYYY-MM-DD HH:MM:SS"]: [fn@String [let t@Timestamp]
   [str [timestamp-year t]
        "-"
        [pad-left [str [timestamp-month t]] 2 "0"]
        "-"
        [pad-left [str [timestamp-day t]] 2 "0"]
        " "
        [pad-left [str [timestamp-hour t]] 2 "0"]
        ":"
        [pad-left [str [timestamp-minute t]] 2 "0"]
        ":"
        [pad-left [str [timestamp-second t]] 2 "0"]]]
]
