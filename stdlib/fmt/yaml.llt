# YAML Formatter
# Convert a tinct value to YAML 1.2 string

[
# Internal: check if string needs quoting
yaml-needs-quote?: [fn [s]
  [or
    [= s ""]
    [or [= s "true"] [or [= s "false"] [or [= s "null"]
      [or [= s "~"] [= s "yes"]]]]]]]

# Internal: quote a string for YAML
yaml-quote: [fn [s]
  [if [yaml-needs-quote? s]
    [str "\"" s "\""]
    s]]

# Internal: check if dict is list-shaped (integer keys only)
yaml-list?: [fn [d]
  [if [empty? d]
    false
    [all? [fn [k] [int? k]] [keys d]]]]

# Internal: format a value at given indentation level
yaml-value: [fn [val indent]
  [cond [
    [[null? val] "null"]
    [[bool? val] [if val "true" "false"]]
    [[int? val] [str val]]
    [[float? val] [str val]]
    [[str? val] [yaml-quote val]]
    [[dict? val] [yaml-object val indent]]
    [true "null"]
  ]]]

# Internal: format dict as YAML object or list
yaml-object: [fn [d indent]
  [if [yaml-list? d]
    [yaml-list d indent]
    [yaml-dict d indent]]]

# Internal: format dict as YAML list
yaml-list: [fn [d indent]
  [if [empty? d]
    "[]"
    [str "\n" [yaml-list-items d indent 0]]]]

yaml-list-items: [fn [d indent i]
  [if [>= i [length d]]
    ""
    [yaml-list-item d indent i]]]

yaml-list-item: [fn [d indent i]
  [str
    [join "" [take indent [repeat " "]]]
    "- "
    [yaml-list-value [get i d] [+ indent 2]]
    [if [< [+ i 1] [length d]] "\n" ""]
    [yaml-list-items d indent [+ i 1]]]]

yaml-list-value: [fn [val indent]
  [if [dict? val]
    [if [yaml-list? val]
      [yaml-list val indent]
      [yaml-dict-inline val indent]]
    [yaml-value val indent]]]

# Internal: format inline dict (after list item)
yaml-dict-inline: [fn [d indent]
  [if [empty? d]
    "{}"
    [yaml-dict-entries d indent [keys d] 0]]]

# Internal: format dict as YAML mapping
yaml-dict: [fn [d indent]
  [if [empty? d]
    "{}"
    [str "\n" [yaml-dict-entries d indent [keys d] 0]]]]

yaml-dict-entries: [fn [d indent ks i]
  [if [>= i [length ks]]
    ""
    [yaml-dict-entry d indent ks i]]]

yaml-dict-entry: [fn [d indent ks i]
  [str
    [join "" [take indent [repeat " "]]]
    [get i ks]
    ": "
    [yaml-dict-value [get [get i ks] d] [+ indent 2]]
    [if [< [+ i 1] [length ks]] "\n" ""]
    [yaml-dict-entries d indent ks [+ i 1]]]]

yaml-dict-value: [fn [val indent]
  [if [dict? val]
    [if [yaml-list? val]
      [yaml-list val indent]
      [yaml-dict val indent]]
    [yaml-value val indent]]]

# Public API: format value to YAML
yaml: [fn [val]
  [if [dict? val]
    [if [yaml-list? val]
      [str [yaml-list val 0] "\n"]
      [str [yaml-dict val 0] "\n"]]
    [str [yaml-value val 0] "\n"]]]
]
