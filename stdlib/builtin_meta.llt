# builtin_meta.llt — AST, evaluation, reflection, and macro primitives.
# Bodies are Placeholder — valid tinct, errors if forced (builtins are Rust-side).

[
  # ── Opaque runtime types ──────────────────────────────────────────────────
  # Program: a parsed+resolved AST (output of builtin-parse / builtin-resolve).
  Program:     [type Program]
  # TypeContext: accumulated type-checker state (type env + type-stage env).
  TypeContext:  [type TypeContext]

  # ── AST and evaluation ─────────────────────────────────────────────────────
  # parse: parse source bytes at path, return Program with documents and errors.
  builtin-parse:             [fn@Program  [let src@Bytes path@String] ...]
  # resolve: resolve VarRef de Bruijn coords in a document against an env.
  builtin-resolve:           [fn@Dict     [let prog@Any ...opts] ...]
  # eval: evaluate a resolved document; returns {env, result, doc-name, error}.
  builtin-eval:              [fn@Dict     [let prog@Any ...opts] ...]
  # eval-types: evaluate only type-stage documents, returning a Program.
  builtin-eval-types:        [fn@Program  [let prog@Any] ...]
  # load: load+parse source bytes or string, return Program.
  builtin-load:              [fn@Program  [let src@String ...opts] ...]
  # eval-macro-ast: evaluate a macro-produced Expr.* AST in the call-site scope.
  builtin-eval-macro-ast:    [fn@Any      [let ast@Any] ...]

  # ── Type-checking context ──────────────────────────────────────────────────
  # typecheck: run type-checking on prog using ctx; returns typed Program.
  builtin-typecheck:              [fn@Program    [let prog@Any ctx@TypeContext ...opts] ...]
  # get-type-context: retrieve the EvalContext's TypeContext handle.
  builtin-get-type-context:       [fn@TypeContext [let ...args] ...]
  # make-type-ctx: create a fresh TypeContext seeded with core type definitions.
  builtin-make-type-ctx:          [fn@TypeContext [] ...]
  # fork-type-ctx: create child TypeContext inheriting parent; mutations don't propagate up.
  builtin-fork-type-ctx:          [fn@TypeContext [let ctx@TypeContext] ...]
  # tc-with-type-stage-env: replace the TypeContext's type-stage env, return updated ctx.
  builtin-tc-with-type-stage-env: [fn@TypeContext [let ctx@TypeContext env@Any] ...]
  # validate: validate program AST structure; returns Program or error.
  builtin-validate:               [fn@Program    [let prog@Any ctx@TypeContext] ...]

  # ── Reflection and introspection ───────────────────────────────────────────
  # tag-of: return the variant tag string (e.g. "Boolean.True") or type name.
  builtin-tag-of:            [fn@String  [let x@Any] ...]
  # type-of: return a string describing the runtime value type ("Int", "Dict", etc.).
  builtin-type-of:           [fn@String  [let x@Any] ...]
  # annotation-of: return the PropertyDict annotation stored on a value (or []).
  builtin-annotation-of:     [fn@Dict    [let x@Any] ...]
  # make-annotated: wrap x with ann as its runtime annotation dict; returns x.
  builtin-make-annotated:    [fn@Any     [let x@Any ann@Dict] ...]
  # llt-repr: return the tinct literal representation of x as a String.
  builtin-llt-repr:          [fn@String  [let x@Any] ...]

  # ── Macro support ─────────────────────────────────────────────────────────
  # gensym: generate a fresh unique name with scope and prefix.
  builtin-gensym:            [fn@String  [let scope@String prefix@String] ...]
  # macro-error: raise a macro-level error with message and offending form. Never returns.
  builtin-macro-error:       [fn@Never   [let msg@String form@Any] ...]
  # eval-ast: evaluate a quoted AST node in the current scope; returns the result.
  builtin-eval-ast:          [fn@Any     [let ast@Any] ...]
  # is-contractive: check if a recursive type body is contractive (non-immediately-recursive).
  builtin-is-contractive:    [fn@Integer [let ty@Any] ...]

  # ── Apply and meta-call ────────────────────────────────────────────────────
  # apply: call f with args dict as positional arguments.
  builtin-apply:             [fn@Any     [let f@Any args@Dict] ...]
  # proxy: create a proxy value that intercepts field access via a handler dict.
  builtin-proxy:             [fn@Any     [let handler@Dict] ...]

  # ── Capability and identity ────────────────────────────────────────────────
  # cap-identity: return a stable string identity for a DirCap (for content-addressed caching).
  # Note: builtin-narrow and builtin-cap-env-has? are Core-46 — declared in builtin_core.llt.
  builtin-cap-identity:      [fn@String  [let cap@DirCap] ...]

  # ── Include cache ─────────────────────────────────────────────────────────
  # include-cache-get: get a cached include result by content hash.
  builtin-include-cache-get: [fn@Any     [let key@String] ...]
  # include-cache-put: store an include result at content hash key.
  builtin-include-cache-put: [fn@Any     [let key@String val@Any] ...]

  # ── Hashing ───────────────────────────────────────────────────────────────
  builtin-blake3:            [fn@String  [let s@String] ...]

  # ── Numeric coercions ─────────────────────────────────────────────────────
  builtin-decimal:           [fn@Decimal [let x@Any] ...]
  builtin-big-int:           [fn@BigInt  [let x@Any] ...]
]
