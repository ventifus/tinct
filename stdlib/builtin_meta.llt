# builtin_meta.llt — AST, evaluation, reflection, and macro primitives.
# Bodies are Placeholder — valid tinct, errors if forced (builtins are Rust-side).

[
  # ── AST and evaluation ─────────────────────────────────────────────────────
  # eval-types: evaluate only type-stage documents, returning a Program.
  builtin-eval-types:        [fn@Program  [let prog@Program] ...]
  # eval-macro-ast: evaluate a macro-produced Expr.* AST in the call-site scope.
  builtin-eval-macro-ast:    [fn@Any      [let ast@Dict] ...]

  # ── Type-checking context ──────────────────────────────────────────────────
  # Note: builtin-get-type-context and builtin-make-type-ctx are Core-46 —
  # declared in builtin_core.llt.
  # fork-type-ctx: create child TypeContext inheriting parent; mutations don't propagate up.
  builtin-fork-type-ctx:     [fn@TypeContext [let ctx@TypeContext] ...]
  # validate: validate program AST structure; returns Program or error.
  builtin-validate:          [fn@Program    [let prog@Program ctx@TypeContext] ...]

  # ── Reflection and introspection ───────────────────────────────────────────
  # Note: builtin-tag-of, builtin-variant?, builtin-type-of, builtin-llt-repr
  # are Core-46 — declared in builtin_core.llt.
  # annotation-of: return the PropertyDict annotation stored on a value (or []).
  builtin-annotation-of:     [fn@Dict    [let x@Any] ...]
  # make-annotated: wrap x with ann as its runtime annotation dict; returns x.
  builtin-make-annotated:    [fn@Any     [let x@Any ann@Dict] ...]

  # ── Macro support ─────────────────────────────────────────────────────────
  # gensym: generate a fresh unique name with scope and prefix.
  builtin-gensym:            [fn@String  [let scope@String prefix@String] ...]
  # macro-error: raise a macro-level error with message and offending form. Never returns.
  builtin-macro-error:       [fn@Never   [let msg@String form@Any] ...]
  # eval-ast: evaluate a quoted AST node in the current scope; returns the result.
  builtin-eval-ast:          [fn@Any     [let ast@Dict] ...]
  # is-contractive: check if a recursive type body is contractive (non-immediately-recursive).
  builtin-is-contractive:    [fn@Integer [let ty@Dict] ...]

  # ── Meta-call ───────────────────────────────────────────────────────────────
  # proxy: create a proxy value that intercepts field access via a handler dict.
  builtin-proxy:             [fn@Proxy   [let handler@Dict] ...]

  # ── Capability and identity ────────────────────────────────────────────────
  # cap-identity: return a stable string identity for a DirCap (for content-addressed caching).
  # Note: builtin-narrow and builtin-cap-env-has? are Core-46 — declared in builtin_core.llt.
  builtin-cap-identity:      [fn@String  [let cap@DirCap] ...]

# ── Hashing ───────────────────────────────────────────────────────────────
  builtin-blake3:            [fn@String  [let s@String] ...]

  # ── Numeric coercions ─────────────────────────────────────────────────────
  builtin-decimal:           [fn@Decimal [let x@Any] ...]
  builtin-big-int:           [fn@BigInt  [let x@Any] ...]

  # ── Evaluation control ────────────────────────────────────────────────────
  builtin-materialize:       [fn@Any     [let x@Any] ...]

  # ── AST operations ────────────────────────────────────────────────────────
  builtin-ast-of:            [fn@Dict    [let x@Any] ...]
  builtin-ast-to-program:    [fn@Program [let x@Dict] ...]
  builtin-program:           [fn@Program [let ...docs] ...]
  builtin-to-tinct:          [fn@String  [let x@Any] ...]

  # ── Macro support (additional) ────────────────────────────────────────────
  builtin-macro-injects:     [fn@Any     [let x@Any] ...]
  builtin-span-of:           [fn@Dict    [let x@Any] ...]
  builtin-sequential:        [fn@Any     [let x@Any] ...]

  # Scope operations moved to builtin_core.llt (loader programs need them).
]
