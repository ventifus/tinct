# ============================================================================
# LLT Regular Expression Engine (stdlib/regex.llt)
# ============================================================================
#
# A simplified pure-tinct regex engine for basic pattern matching.
# Current implementation: literal string matching only (MVP).
#
# Supported syntax (initially):
#   Literal:     abc (exact string match)
#
# Future: dot, quantifiers, anchors, character classes.
# ============================================================================

# ============================================================================
# FIRST DICT: Private helpers (not exported)
# ============================================================================

[

# Ensure pattern is a string (extracts .pattern from compiled dict, or passes through)
re-ensure-pattern: [fn@String [let pattern@Unknown]
    [if [str? pattern]
        pattern
        [if [has? "pattern" pattern]
            pattern.pattern
            pattern]]]

# Test if string contains pattern anywhere (recursive position scan)
re-match-impl: [fn@Boolean [let pat@String haystack@String i@Integer len@Integer]
    [if [> i len]
        false
        [re-match-try pat haystack i len]]]

re-match-try: [fn@Boolean [let pat@String haystack@String i@Integer len@Integer]
    [re-match-check pat haystack i len [+ i [length pat]]]]

re-match-check: [fn@Boolean [let pat@String haystack@String i@Integer len@Integer end-pos@Integer]
    [if [> end-pos len]
        [re-match-impl pat haystack [+ i 1] len]
        [if [= pat [str-slice haystack i end-pos]]
            true
            [re-match-impl pat haystack [+ i 1] len]]]]

# Find first match — returns [] if no match
re-find-impl: [fn@Dict [let pat@String haystack@String i@Integer len@Integer]
    [if [> i len]
        []
        [re-find-try pat haystack i len]]]

re-find-try: [fn@Dict [let pat@String haystack@String i@Integer len@Integer]
    [re-find-check pat haystack i len [+ i [length pat]]]]

re-find-check: [fn@Dict [let pat@String haystack@String i@Integer len@Integer end-pos@Integer]
    [if [> end-pos len]
        [re-find-impl pat haystack [+ i 1] len]
        [if [= pat [str-slice haystack i end-pos]]
            [match: pat  start: i  end: end-pos]
            [re-find-impl pat haystack [+ i 1] len]]]]

# Find all matches — returns dict of match result dicts
re-findall-impl: [fn@Dict [let pat@String haystack@String i@Integer len@Integer acc@Dict]
    [if [> i len]
        acc
        [re-findall-try pat haystack i len acc]]]

re-findall-try: [fn@Dict [let pat@String haystack@String i@Integer len@Integer acc@Dict]
    [re-findall-check pat haystack i len acc [+ i [length pat]]]]

re-findall-check: [fn@Dict [let pat@String haystack@String i@Integer len@Integer acc@Dict end-pos@Integer]
    [if [> end-pos len]
        [re-findall-impl pat haystack [+ i 1] len acc]
        [if [= pat [str-slice haystack i end-pos]]
            [re-findall-impl pat haystack end-pos len
                [append [match: pat  start: i  end: end-pos] acc]]
            [re-findall-impl pat haystack [+ i 1] len acc]]]]

]

# ============================================================================
# SECOND DICT: Public API (exported)
# ============================================================================

[

# Compile a pattern (currently a no-op, just returns the pattern)
re-compile@[doc: "Compile a pattern (currently a no-op, just returns the pattern)"]: [fn@Dict [let pattern@String]
    [pattern: pattern]]

# Test if string contains pattern anywhere
re-match@[doc: "Test if string contains pattern anywhere"]: [fn@Boolean [let pattern@Unknown haystack@String]
    [re-match-impl [re-ensure-pattern pattern] haystack 0 [length haystack]]]

# Find first match (returns [match: String start: Int end: Int] or [])
re-find@[doc: "Find first match"]: [fn@Dict [let pattern@Unknown haystack@String]
    [re-find-impl [re-ensure-pattern pattern] haystack 0 [length haystack]]]

# Find all matches (returns dict of match result dicts)
re-findall@[doc: "Find all matches (returns dict for simplicity)"]: [fn@Dict [let pattern@Unknown haystack@String]
    [re-findall-impl [re-ensure-pattern pattern] haystack 0 [length haystack] []]]

# Replace all matches with replacement string
re-replace@[doc: "Replace all matches"]: [fn@String [let pattern@Unknown replacement@String haystack@String]
    [replace [re-ensure-pattern pattern] replacement haystack]]

# Split on pattern
re-split@[doc: "Split on pattern"]: [fn@Dict [let pattern@Unknown haystack@String]
    [split [re-ensure-pattern pattern] haystack]]

# Escape replacement string (escape backslashes)
re-escape-replacement@[doc: "Escape replacement string"]: [fn@String [let s@String]
    [replace "\\" "\\\\" s]]

]
