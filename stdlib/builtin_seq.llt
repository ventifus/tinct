# builtin_seq.llt — Sequence-oriented view of collection operations.
# Same Rust function surface as builtin_dict; distinct module for conceptual clarity.
# Bodies are Placeholder — valid tinct, errors if forced (builtins are Rust-side).

[
  # ── Key/index access ───────────────────────────────────────────────────────
  builtin-get:             [fn@Any     [let k@Any xs@Any] ...]
  builtin-has-key?:        [fn@Integer [let k@Any xs@Any] ...]
  builtin-dict-nth:        [fn@Any     [let d@Any i@Integer] ...]
  builtin-dict-key-nth:    [fn@Any     [let d@Any i@Integer] ...]
  builtin-dict-kv-nth:     [fn@Any     [let d@Any i@Integer] ...]
  builtin-dict-has-nth?:   [fn@Integer [let d@Any i@Integer] ...]
  builtin-dict-has-key-nth?: [fn@Integer [let d@Any i@Integer] ...]
  builtin-dict-has-kv-nth?:  [fn@Integer [let d@Any i@Integer] ...]

  # ── Structural operations ──────────────────────────────────────────────────
  builtin-length:          [fn@Integer [let x@Any] ...]
  builtin-reverse:         [fn@Dict    [let xs@Dict] ...]
  builtin-sort:            [fn@Dict    [let xs@Dict] ...]
  builtin-concat:          [fn@Any     [let a@Any b@Any] ...]
  builtin-append:          [fn@Dict    [let d@Dict v@Any] ...]
  builtin-first:           [fn@Any     [let xs@Dict] ...]
  builtin-last:            [fn@Any     [let xs@Dict] ...]
  builtin-rest:            [fn@Dict    [let xs@Dict] ...]

  # ── Higher-order sequence ops ──────────────────────────────────────────────
  builtin-map:             [fn@Dict    [let f@Any xs@Any] ...]
  builtin-filter:          [fn@Dict    [let pred@Any xs@Any] ...]
  builtin-reduce:          [fn@Any     [let f@Any init@Any xs@Any] ...]
  builtin-take:            [fn@Dict    [let n@Integer xs@Any] ...]
  builtin-drop:            [fn@Dict    [let n@Integer xs@Any] ...]
  builtin-join:            [fn@String  [let sep@String xs@Any] ...]
]
