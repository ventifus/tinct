# Network utilities — depends on io-phase2 builtins
# Requires: net-cap, connect (io-phase2) and write, slurp (io-phase1)
#
# Note: This module provides the foundation for HTTP client code.
# Full HTTP fetch requires the `write` builtin from io-phase1, which
# writes data to a Handle and returns the Handle for sequencing.
#
# Phase 2 provides: net-cap (create NetCap), connect (TCP connection)
# Deferred to io-phase1 completion: write builtin, working fetch

# Placeholder fetch — will work once $write builtin is implemented (io-phase1)
# For now, demonstrates the pattern:
#   1. Parse URL to extract host, port, path
#   2. Open TCP connection via $connect
#   3. Send HTTP request via $write (NOT YET AVAILABLE)
#   4. Read response via $slurp
#   5. Parse response to extract body

fetch: [fn [cap url]
  # TODO(io-phase1): requires $write builtin to send HTTP request
  [error "fetch: requires $write builtin from io-phase1 (not yet implemented)"]
]

