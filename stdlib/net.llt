# Network utilities — depends on io-phase2 builtins
# Requires: net-cap, connect, tls-connect (io-phase2)
# Requires: write-handle, slurp, str-bytes, bytes-str (io-phase1)
# Requires prelude: if, or, make-entry, merge, set, split, join, rest,
#                   length, to-int, str, get, builtin-eq, builtin-add, error
#
# Provides:
#   parse-url-port        — extract port from colon-split result
#   parse-url-path        — reconstruct path from slash-split result
#   parse-url             — "http://host:port/path" -> [scheme: host: port: path:]
#   build-http-request    — method + path + host -> raw HTTP/1.0 request String
#   parse-status-line     — "HTTP/1.0 200 OK" -> 200
#   parse-header-fields   — recursive header dict builder
#   parse-http-response   — raw response String -> [status: headers: body:]
#   http-get              — plain TCP: connect + write-handle + slurp + parse
#   fetch                 — parse-url + http-get (http) or tls-connect (https)

[
  # Parse optional port from [split ":" host-port] result.
  # Returns [] (null) if no colon in host-port, else Int.
  parse-url-port: [fn [colon-parts]
    [if [builtin-eq [length colon-parts] 1]
      []
      [to-int colon-parts.1]]]

  # Reconstruct path string from [rest [split "/" after-scheme]].
  # Returns "/" if no path segments, else "/" prepended to joined segments.
  parse-url-path: [fn [path-tail]
    [if [builtin-eq [length path-tail] 0]
      "/"
      [str "/" [join "/" path-tail]]]]

  # Parse "scheme://host[:port][/path]" into components.
  # Returns [scheme: ... host: ... port: ... path: ...].
  # port is [] (null) if absent in the URL.
  parse-url: [fn@Dict [url@String]
    [scheme-split: [split "://" url]
    [slash-parts:  [split "/" scheme-split.1]
    [colon-parts:  [split ":" slash-parts.0]
    [set [set [set [set []
      "scheme" scheme-split.0]
      "host"   colon-parts.0]
      "port"   [parse-url-port colon-parts]]
      "path"   [parse-url-path [rest slash-parts]]]]]]]

  # Build a minimal HTTP/1.0 GET request string.
  build-http-request: [fn@String [method@String path@String host@String]
    [str method " " path " HTTP/1.0\r\nHost: " host "\r\nUser-Agent: tinct/0.1\r\nConnection: close\r\n\r\n"]]

  # Extract HTTP status code Int from the first response line.
  # "HTTP/1.0 200 OK" -> 200
  parse-status-line: [fn@Int [line@String]
    [to-int [get 1 [split " " line]]]]

  # Recursively parse header lines into accumulator dict.
  # Each line "Name: value" — skips malformed lines.
  parse-header-fields: [fn@Dict [lines@Dict i@Int n@Int acc@Dict]
    [if [builtin-eq i n]
      acc
      [if [builtin-eq [length [split ": " [get i lines]]] 1]
        [parse-header-fields lines [builtin-add i 1] n acc]
        [parse-header-fields lines [builtin-add i 1] n
          [merge acc
            [make-entry
              [get 0 [split ": " [get i lines]]]
              [join ": " [rest [split ": " [get i lines]]]]]]]]]]

  # Parse raw HTTP response string into {status headers body}.
  # Returns status 0 and body=response if no header/body separator found.
  parse-http-response: [fn@Dict [response@String]
    [sections: [split "\r\n\r\n" response]
    [if [builtin-eq [length sections] 1]
      [set [set [set [] "status" 0] "headers" []] "body" response]
      [hdr-lines: [split "\r\n" sections.0]
      [set [set [set []
        "status"  [parse-status-line hdr-lines.0]]
        "headers" [parse-header-fields [rest hdr-lines] 0 [length [rest hdr-lines]] []]]
        "body"    sections.1]]]]]

  # Make an HTTP GET request to host:port/path using cap.
  # Returns parsed response dict.
  http-get: [fn@Dict [cap@NetCap host@String port@Int path@String]
    [parse-http-response
      [bytes-str [slurp [write-handle
        [connect cap host port]
        [str-bytes [build-http-request "GET" path host]]]]]]]

  # Parse URL and dispatch to http-get (http) or tls-connect (https).
  # Default port 80/443, default path "/".
  fetch: [fn@Dict [cap@NetCap url@String]
    [parsed: [parse-url url]
    [if [builtin-eq parsed.scheme "https"]
      [parse-http-response
        [bytes-str [slurp [write-handle
          [tls-connect cap Tcp parsed.host [or parsed.port 443] []]
          [str-bytes [build-http-request "GET" [or parsed.path "/"] parsed.host]]]]]]
      [http-get cap parsed.host [or parsed.port 80] [or parsed.path "/"]]]]]
]
