# Network utilities — depends on io-phase2 builtins
# Requires: net-cap, connect, http2-session, http-request (io-phase2)
# Requires: write, str-bytes, bytes-str, bytes-concat, chunks (io-phase1 + prelude)
# Requires prelude: make-entry, set, null? (prelude functions, not raw builtins)
# Uses prelude wrapper names for all Rust primitives (per builtin-privacy design).
#
# Provides:
#   build-http-request    — method + path + host -> raw HTTP/1.0 request String
#   parse-status-line     — "HTTP/1.0 200 OK" -> 200
#   parse-header-fields   — recursive header dict builder
#   parse-http-response   — raw response String -> [status: headers: body:]
#   http-get              — url-based HTTP GET (dispatches on url.scheme)
#   fetch                 — url + http-get (http) or http2-session (https)
--- uses: ["net"]
# Internal helpers — not exported
[
  # Recursively parse header lines into accumulator dict.
  # Each line "Name: value" — skips malformed lines.
  parse-header-fields-impl: [fn@Dict [let lines@Dict i@Integer n@Integer acc@Dict]
    [if [= i n]
      acc
      [if [= [length [split ": " [get i lines]]] 1]
        [parse-header-fields-impl lines [+ i 1] n acc]
        [parse-header-fields-impl lines [+ i 1] n
          [merge acc
            [make-entry
              [get 0 [split ": " [get i lines]]]
              [join ": " [rest [split ": " [get i lines]]]]]]]]]]

  # Helper to parse header+body section when separator exists.
  # Input: sections dict with 0 (headers) and 1 (body).
  parse-header-body: [fn@Dict [let sections@Dict]
    [hdr-lines: [split "\r\n" [get 0 sections]]
    [set []
      status:  [to-int [get 1 [split " " [get 0 hdr-lines]]]]
      headers: [parse-header-fields-impl [rest hdr-lines] 0 [length [rest hdr-lines]] []]
      body:    [get 1 sections]]]]
]

# Public API
[
  # Build a minimal HTTP/1.0 GET request string.
  build-http-request: [fn@String [let method@String path@String host@String]
    [str method " " path " HTTP/1.0\r\nHost: " host "\r\nUser-Agent: tinct/0.1\r\nConnection: close\r\n\r\n"]]

  # Parse raw HTTP response string into {status headers body}.
  # Returns status 0 and body=response if no header/body separator found.
  parse-http-response: [fn@Dict [let response@String]
    [sections: [split "\r\n\r\n" response]
    [if [= [length sections] 1]
      [set [] status: 0 headers: [] body: response]
      [parse-header-body sections]]]]

  # Make an HTTP GET request using url@Url.
  # Dispatches on url.scheme:
  #   https — uses http2-session (reqwest, HTTP/2 via ALPN, connection pooled)
  #             returns {ok: {status headers body}} or {err: msg}
  #   http  — uses raw TCP connect + HTTP/1.0 request string
  #             returns parsed response dict (throws on network error)
  #   other — throws "unsupported scheme"
  # http-get: returns {ok: {status headers body}} or {err: msg} in all cases.
  # HTTPS path: http-request returns Result directly (no try needed).
  # HTTP path: TCP ops may raise — wrapped in try.
  # Bad scheme: returns {err: ...}.
  http-get: [fn [let cap@NetCap url@Url]
    [if [= url.scheme "https"]
      # Session creation may fail (cert load, cap check) — wrap in try.
      # http-request returns {ok: resp} or {err: msg} directly; and-then flattens without double-wrapping.
      [and-then
        [fn [let session]
          [http-request session "GET"
            [str url.path [if [null? url.query] "" [str "?" url.query]]]
            [make-entry "user-agent" "tinct/0.1"]
            ""]]
        [try [fn [let] [http2-session cap [uri-origin url]]]]
      [if [= url.scheme "http"]
        [try [fn [let]
          [parse-http-response
            [bytes-str [bytes-concat [collect [chunks
              [write
                [str-bytes [build-http-request "GET" url.path url.host]]
                [connect cap Transport.Tcp url.host url.port]]
              65536]]]]]]]
        [Error [str "http-get: unsupported scheme: " url.scheme]]]]]

  # Parse URL string and call http-get.
  # Returns {ok: response-dict} or {err: message} — http-get returns Result directly.
  # URL parse errors propagate as hard errors (programming errors, not network errors).
  fetch: [fn [let cap@NetCap url-string@String]
    [http-get cap [url url-string]]]

  # Parse query string into a Dict of key-value pairs.
  # Returns empty dict if query is null.
  uri-params: [fn@Dict [let u@Url]
    [if [null? u.query]
      []
      [pairs: [split u.query "&"]
      [reduce [fn [let acc pair]
        [kv: [split pair "="]
        [merge acc [make-entry [get 0 kv] [if [= [length kv] 1] "" [get 1 kv]]]]]]
        [] pairs]]]]

  # Create an SPKI pin dict for certificate pinning.
  # algorithm: HashAlgorithm variant (e.g. [Sha256]), fingerprint: Bytes
  # Returns: {algorithm: variant, fingerprint: bytes}
  spki-pin: [fn@Dict [let algorithm fingerprint]
    [set [] algorithm: algorithm fingerprint: fingerprint]]

  # Return "scheme://host:port" (origin).
  # Port is omitted if null.
  uri-origin: [fn@String [let u@Url]
    [if [null? u.port]
      [str u.scheme "://" u.host]
      [str u.scheme "://" u.host ":" u.port]]]

  # Reconstruct full URI string from components.
  uri->string: [fn@String [let u@Url]
    [str u.scheme "://"
      [if [null? u.host] "" u.host]
      [if [null? u.port] "" [str ":" u.port]]
      u.path
      [if [null? u.query] "" [str "?" u.query]]
      [if [null? u.fragment] "" [str "#" u.fragment]]]]

  # ============================================================================
  # SocketAddress and UdpDatagram types (T-1377)
  # ============================================================================

  SocketAddress: [type
    IPv4: [host: String  port: Int]
    IPv6: [host: String  port: Int]
    Unix: [path: String]]

  UdpDatagram: [type
    UdpDatagram: [data: Bytes  source: SocketAddress]]

  # ============================================================================
  # Datagram typeclass (T-1359)
  # ============================================================================
  #
  # Unordered, unreliable packet socket. Each send and receive is a discrete unit
  # with its own source/destination address. UdpSocket is the base instance.
  # Net-specific instances (UdpSocket, QuicDatagramHandle) are defined separately.
  #
  # send: fire-and-forget to addr; returns Null (no delivery guarantee)
  # recv: blocks until a packet arrives; returns UdpDatagram {data source}
  Datagram@[doc: "Unordered, unreliable packet socket."]:
    [class [let Datagram d]
      send: [Fn@Null [d@d  addr@SocketAddress  data@Bytes]]
      recv: [Fn@UdpDatagram [d]]]

  # ============================================================================
  # Codec typeclass (T-1360)
  # ============================================================================
  #
  # Data transform between IO shapes: encode/decode + name.
  # Every codec bridges two IO shapes: ByteStream, Datagram, MessageStream, or
  # another codec stage. The input/output type parameters name which shapes
  # are connected (e.g. GzipCodec: ByteStream → ByteStream, input=Bytes output=Bytes).
  #
  # encode: forward transform — input → output
  # decode: reverse transform — reads from a Bytes buffer at `offset`, returns
  #         {value: decoded-output, next: new-offset}. The `handler` argument is
  #         called on invalid input; pass Absent to use the codec's built-in default.
  # codec-name: human-readable name for logging and debugging

  # CodecInvalidHandler: error recovery callback parameterized by codec input/output.
  # Called when decode encounters invalid or incomplete data. Returns {value: fallback, next: Int}.
  CodecInvalidHandler: [type [let input output] [Fn@[value: input  next: Int] [output Int]]]

  Codec@[doc: "Data transform between IO shapes: encode/decode + name."]:
    [class [let Codec c input output]
      encode:     [Fn@output [c input]]
      decode:     [Fn@[value: output  next: Int]
                   [c input Int [or [CodecInvalidHandler input output] Absent]]]
      codec-name: [Fn@String [c]]]

  # codec: wrap a Codec instance into a pipeline-stage function input → output.
  # The returned function encodes a single input value using inst.encode.
  # Used in pipeline composition: [data | [codec GzipCodec] | [sink %stdout]]
  # Type: forall c i o. [Codec c i o] → [Fn@o [i]]
  codec: [fn [let inst]
    [fn [let x] [inst.encode x]]]
]
