# Network utilities — depends on io-phase2 builtins
# Requires: net-cap, connect, http2-session, http-request (io-phase2)
# Requires: write-handle, slurp, str-bytes, bytes-str (io-phase1)
# Requires prelude: if, or, make-entry, merge, set, split, join, rest,
#                   length, to-int, str, get, error
#
# Provides:
#   build-http-request    — method + path + host -> raw HTTP/1.0 request String
#   parse-status-line     — "HTTP/1.0 200 OK" -> 200
#   parse-header-fields   — recursive header dict builder
#   parse-http-response   — raw response String -> [status: headers: body:]
#   http-get              — url-based HTTP GET (dispatches on url.scheme)
#   fetch                 — url + http-get (http) or http2-session (https)
#
# Internal helpers — not exported
[
  # Recursively parse header lines into accumulator dict.
  # Each line "Name: value" — skips malformed lines.
  parse-header-fields-impl: [fn@Dict [lines@Dict i@Int n@Int acc@Dict]
    [if [= i n]
      acc
      [if [= [length [split ": " [get i lines]]] 1]
        [parse-header-fields-impl lines [+ i 1] n acc]
        [parse-header-fields-impl lines [+ i 1] n
          [merge acc
            [make-entry
              [get 0 [split ": " [get i lines]]]
              [join ": " [rest [split ": " [get i lines]]]]]]]]]]

  # Helper to parse header+body section when separator exists.
  # Input: sections dict with 0 (headers) and 1 (body).
  parse-header-body: [fn@Dict [sections@Dict]
    [hdr-lines: [split "\r\n" [get 0 sections]]
    [set [set [set []
      "status"  [to-int [get 1 [split " " [get 0 hdr-lines]]]]]
      "headers" [parse-header-fields-impl [rest hdr-lines] 0 [length [rest hdr-lines]] []]]
      "body"    [get 1 sections]]]]
]

# Public API
[
  # Build a minimal HTTP/1.0 GET request string.
  build-http-request: [fn@String [method@String path@String host@String]
    [str method " " path " HTTP/1.0\r\nHost: " host "\r\nUser-Agent: tinct/0.1\r\nConnection: close\r\n\r\n"]]

  # Parse raw HTTP response string into {status headers body}.
  # Returns status 0 and body=response if no header/body separator found.
  parse-http-response: [fn@Dict [response@String]
    [sections: [split "\r\n\r\n" response]
    [if [= [length sections] 1]
      [set [set [set [] "status" 0] "headers" []] "body" response]
      [parse-header-body sections]]]]

  # Make an HTTP GET request using url@Url.
  # Dispatches on url.scheme:
  #   https — uses http2-session (reqwest, HTTP/2 via ALPN, connection pooled)
  #             returns {ok: {status headers body}} or {err: msg}
  #   http  — uses raw TCP connect + HTTP/1.0 request string
  #             returns parsed response dict (throws on network error)
  #   other — throws "unsupported scheme"
  http-get: [fn@Dict [cap@NetCap url@Url]
    [if [= url.scheme "https"]
      [http-request
        [http2-session cap [uri-origin url] []]
        "GET"
        [str url.path [if [null? url.query] "" [str "?" url.query]]]
        []
        ""]
      [if [= url.scheme "http"]
        [parse-http-response
          [bytes-str [slurp [write-handle
            [connect cap url.host url.port]
            [str-bytes [build-http-request "GET" url.path url.host]]]]]]
        [error [str "http-get: unsupported scheme: " url.scheme]]]]]

  # Parse URL string and call http-get.
  # Returns: {ok: response-dict} or {err: message}
  fetch: [fn@Dict [cap@NetCap url-string@String]
    [try [fn [] [http-get cap [url url-string]]]]]

  # Parse query string into a Dict of key-value pairs.
  # Returns empty dict if query is null.
  uri-params: [fn@Dict [u@Url]
    [if [null? u.query]
      []
      [pairs: [split u.query "&"]
      [reduce [fn [let acc pair]
        [kv: [split pair "="]
        [set acc [get 0 kv] [if [= [length kv] 1] "" [get 1 kv]]]]]
        [] pairs]]]]

  # Create an SPKI pin dict for certificate pinning.
  # algorithm: HashAlgorithm variant (e.g. [Sha256]), fingerprint: Bytes
  # Returns: {algorithm: variant, fingerprint: bytes}
  spki-pin: [fn@Dict [algorithm fingerprint]
    [set [set [] "algorithm" algorithm] "fingerprint" fingerprint]]

  # Return "scheme://host:port" (origin).
  # Port is omitted if null.
  uri-origin: [fn@String [u@Url]
    [if [null? u.port]
      [str u.scheme "://" u.host]
      [str u.scheme "://" u.host ":" u.port]]]

  # Reconstruct full URI string from components.
  uri->string: [fn@String [u@Url]
    [str u.scheme "://"
      [if [null? u.host] "" u.host]
      [if [null? u.port] "" [str ":" u.port]]
      u.path
      [if [null? u.query] "" [str "?" u.query]]
      [if [null? u.fragment] "" [str "#" u.fragment]]]]
]
