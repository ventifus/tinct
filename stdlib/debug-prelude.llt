--- uses: ["core"]

# Investigate: why does Boolean get typed as Fn@ExprError in Comparable instance bodies?
# Runs as: just run-init stdlib/debug-prelude.llt

[
  %stderr: [write: [fn [let s h] [builtin-write-stderr s h]]
            flush:  [fn [let h] h]
            close:  [fn [let h] h]]
]

[
  # Minimal reproducer: type with payload constructor before Boolean, then instance references Boolean.True
  src: "[\n  ErrorType: [type [Error span: Any]]\n  Boolean: [type True False]\n  MyClass: [class [let a]]\n  [instance MyClass\n    [let a@Integer]: [method: [fn [let x] Boolean.True]]]\n]\n[Boolean.True]\n"

  parse:  [builtin-parse [builtin-str-bytes src] "repro.llt"]
  result: [builtin-resolve parse.program]
  n:      [builtin-length result.errors]

  _loop: [fn [let i errors h]
    [done: [builtin-gte i [builtin-length errors]]
     e:    [builtin-get i errors]
     s:    e.span
     line: [builtin-string-concat s.file
              [builtin-string-concat ":"
              [builtin-string-concat [builtin-int->string s.start-line]
              [builtin-string-concat ":" [builtin-string-concat e.message "\n"]]]]]
     h2:   [%stderr.write line h]]
    [builtin-if done h [_loop [builtin-add i 1] errors h2]]]
]

[
  h1: [_loop 0 result.errors %stderr]
  h2: [%stderr.write [builtin-string-concat [builtin-int->string n] " resolve errors\n"] h1]
]

[builtin-if [builtin-gte [builtin-length h2] 0] n 0]
