# builtin_core.llt — Core types and fundamental primitives.
# These are the Rust-level irreducibles that type-foundations requires.
# ... bodies are Placeholder — valid tinct, errors if forced (never called).

[
  # ── Rust-backed primitive types ───────────────────────────────────────────────────────
  Int:     [type Int]
  Float:   [type Float]
  Bytes:   [type Bytes]

  # ── Capability types ─────────────────────────────────────────────────────────────────
  DirCap:  [type DirCap]
  NetCap:  [type NetCap]
  ClockCap:[type ClockCap]
  Handle:  [type Handle]
  Url:     [type Url]

  # ── Opaque Rust handle types ─────────────────────────────────────────────────────────
  BuilderHandle: [type BuilderHandle]
  Task:          [type [let a] Task]
  Channel:       [type [let a] Channel]
  Context:       [type Context]
  ReactiveCell:  [type [let a] ReactiveCell]
  QuicSession:   [type QuicSession]
  Http2Session:  [type Http2Session]
  Http3Session:  [type Http3Session]
  Timezone:      [type Timezone]
  Uri:           [type Uri]
  Urn:           [type Urn]
  Decimal:       [type Decimal]
  BigInt:        [type BigInt]

  # ── Control flow ─────────────────────────────────────────────────────────────────────
  builtin-raise: [fn@Never  [let msg@String] ...]
  builtin-try:   [fn@[bind: [a]  return: [union a [Error msg: String]]] [let f@[Fn@a []]] ...]
  # builtin-if takes Int condition: 0 = false, nonzero = true (not Boolean).
  builtin-if:    [fn@[bind: [a]  return: a] [let cond@Integer then@a else@a] ...]


  # ── String primitives ────────────────────────────────────────────────────────────────
  builtin-str-bytes:[fn@Bytes [let s@String] ...]
  builtin-str-hash: [fn@Integer   [let s@String] ...]

  # ── Comparison primitives — all return Int (1=true, 0=false) ────────────────────────
  builtin-lt:         [fn@Integer [let a@Integer    b@Integer]    ...]
  builtin-eq-int:     [fn@Integer [let a@Integer    b@Integer]    ...]
  builtin-eq-float:   [fn@Integer [let a@Float  b@Float]  ...]
  builtin-eq-string:  [fn@Integer [let a@String b@String] ...]
]
