# builtin_core.llt — Core types and fundamental primitives.
# This is the source of truth for all "core" module builtin type declarations.
# Every entry in core_builtins() in src/builtins_core.rs must be declared here.
# Bodies are Placeholder — valid tinct, errors if forced (builtins are Rust-side).

--- stage: "type"
# Type-stage definitions for primitive types.
# These TypeNode values are evaluated first by the two-pass loader so that
# @Integer, @String, etc. in the runtime section resolve to concrete types.
[
  # Minimal TypeNode declaration for bootstrap — full declaration is in prelude.llt.
  # Constructors used by this type-stage section only.
  TypeNode: [type repr: 52
    Int
    String
    Float
    Bytes
    Never
    Top
    Unknown
    Proxy
    Callable
    # Absent: the empty closed dict type — the Rust-protocol encoding of the absent/null sentinel.
    # Maps to Type::Dict(Row { fields: {}, tail: RowTail::Empty }).
    # The empty dict `[]` is `Value::Dict({})` at runtime; @Absent is its static type.
    # TODO: This is wrong, rust should not have any knowlede of "Absent" or "Null", and the comment here erroneously defined Absent as exactly the same as `[]`
    Absent # FIXME: prelude leak
    Union:        [types: TypeNode]
    Intersect:    [types: TypeNode]
    Negation:     [inner: TypeNode]
    Arrow:        [params: TypeNode  result: TypeNode]
    Recursive:    [var: String  body: TypeNode]
    RecursiveRef: [name: String]
    Dict: [fields: Dict  open: Integer  key-type: TypeNode  value-type: TypeNode  repr@[default: 0]: Integer]
    TypeConstructor: [name: String]
    TypeApplication: [ctor: TypeNode  args: TypeNode]
    # Kind-annotated type variable sentinel: resolves to a fresh TypeVar of the given kind.
    # kind: "Operator" | "Label" — string keys matching crate::type_def::Kind variants.
    TypeVar: [kind: String]
    # Literal type constructors — produced by [or 0 1], [or "ok" "err"], [or 1.5 2.5] in type position.
    IntLiteral:    [n: Integer]
    StringLiteral: [s: String]
    FloatLiteral:  [value: Float]]

  # ── Primitive type aliases ────────────────────────────────────────────────
  # These are simple TypeNode leaf aliases. They depend only on TypeNode (declared
  # above) and must come BEFORE the structural types that use them as key-type/value-type
  # arguments. The type-stage evaluation is letrec but classify_type_stage_entry processes
  # entries in declaration order — an entry must be settled before a later entry's
  # typenode_value_to_type call can observe it (see imports.rs: scope_so_far comment).
  Integer:      TypeNode.Int
  # NativeInt/NativeUInt/Float64: low-level Rust variant aliases.
  # These resolve to the same types as Integer/Float — NativeInt and NativeUInt alias
  # TypeNode.Int, and Float64 aliases TypeNode.Float. This allows @NativeInt, @NativeUInt,
  # and @Float64 annotations in builtin_core.llt to typecheck correctly against the
  # Integer and Float types in user programs.
  NativeInt:    TypeNode.Int
  NativeUInt:   TypeNode.Int
  Float64:      TypeNode.Float
  String:       TypeNode.String
  Float:        TypeNode.Float
  Bytes:        TypeNode.Bytes
  Never:        TypeNode.Never
  Any:          TypeNode.Top
  Unknown:      TypeNode.Unknown
  Absent:       TypeNode.Absent # FIXME: prelude leak
  Proxy:        TypeNode.Proxy
  # Kind sentinels: @Operator and @Label resolve to fresh TypeVars of the given kind.
  # Consumed by typenode_typevar_kind in type_normalize.rs → TypeStageEntry::TypeVar.
  Operator:     [TypeNode.TypeVar kind: "Operator"]
  Label:        [TypeNode.TypeVar kind: "Label"]
  Dict:         [TypeNode.Dict fields: []  open: 1  key-type: TypeNode.Top  value-type: TypeNode.Top  repr: 5]
  # ── Structural protocol types ────────────────────────────────────────────
  # These depend on the primitive aliases above (via key-type/value-type fields
  # that are forced during classify_type_stage_entry → typenode_value_to_type).
  # They must be declared AFTER the primitives they reference.
  #
  # Span: source location produced by parser and carried on every diagnostic.
  Span: [TypeNode.Dict
    fields: [file:       TypeNode.String
             start-line: TypeNode.Int
             start-col:  TypeNode.Int
             end-line:   TypeNode.Int
             end-col:    TypeNode.Int]
    open: 1
    key-type: TypeNode.Top
    value-type: TypeNode.Top]

  # CallFrame: one entry in a diagnostic's call-stack (function name + source location).
  CallFrame: [TypeNode.Dict
    fields: [span:  Span
             label: TypeNode.String]
    open: 1
    key-type: TypeNode.Top
    value-type: TypeNode.Top]

  # SecondarySpan: a secondary source location with an annotation label.
  SecondarySpan: [TypeNode.Dict
    fields: [span:  Span
             label: TypeNode.String]
    open: 1
    key-type: TypeNode.Top
    value-type: TypeNode.Top]

  # MacroExpand: macro expansion provenance carried on a diagnostic.
  # Either absent ([]) or {name: String, span: Span}.
  MacroExpand: [TypeNode.Dict
    fields: [name: TypeNode.String
             span: Span]
    open: 1
    key-type: TypeNode.Top
    value-type: TypeNode.Top]

  # Diagnostic: a single type error, warning, or info message.
  Diagnostic: [TypeNode.Dict
    fields: [level:           TypeNode.String
             kind:            TypeNode.String
             message:         TypeNode.String
             span:            Span
             help:            TypeNode.Top
             notes:           TypeNode.Top
             secondary-spans: TypeNode.Top
             call-stack:      TypeNode.Top
             macro-expand:    TypeNode.Top
             blame:           TypeNode.Top]
    open: 1
    key-type: TypeNode.Top
    value-type: TypeNode.Top]

  # Diagnostics: auto-indexed collection of Diagnostic dicts.
  Diagnostics: [TypeNode.Dict
    fields: []
    open: 1
    key-type: TypeNode.Int
    value-type: Diagnostic]

  # Documents: auto-indexed collection of Document values (produced by builtin-program-docs).
  # value-type is Top — Document is an opaque runtime type declared via [type repr: ...]
  # in the runtime section, not a TypeNode constructor.
  Documents: [TypeNode.Dict
    fields: []
    open: 1
    key-type: TypeNode.Int
    value-type: TypeNode.Top]
]

---
[
  # ── Opaque types ──────────────────────────────────────────────────────────
  # Opaque Rust value types (Program, Document, TypeContext, DirCap, etc.)
  # are declared below as [type repr: "Value::X"] in the native runtime types
  # section. Primitive types (Integer, String, Float, Bytes, etc.) are
  # type-stage aliases in the section above.

  # Url is a tinct nominal type (not an opaque Rust Value variant) — kept here.
  Url: [type Url]

  # ── Control flow ──────────────────────────────────────────────────────────
  builtin-raise: [fn@Never  [let diag@Diagnostic] ...]
  builtin-try:   [fn@[bind: [a]  return: [or [ok: a] Diagnostic]] [let expr@a] ...]

  # ── Arithmetic — monomorphic typed variants ───────────────────────────────
  # Each variant handles exactly one type combination. Cross-type arithmetic
  # (Integer+Float) is handled in tinct by explicit conversion + float variant.
  builtin-int-add:      [fn@NativeInt [let a@NativeInt b@NativeInt] ...]
  builtin-float-add:    [fn@Float64   [let a@Float64   b@Float64  ] ...]
  builtin-int-sub:      [fn@NativeInt [let a@NativeInt b@NativeInt] ...]
  builtin-float-sub:    [fn@Float64   [let a@Float64   b@Float64  ] ...]
  builtin-int-mul:      [fn@NativeInt [let a@NativeInt b@NativeInt] ...]
  builtin-float-mul:    [fn@Float64   [let a@Float64   b@Float64  ] ...]
  builtin-int-to-float: [fn@Float64   [let n@NativeInt] ...]
  builtin-float-to-int: [fn@NativeInt [let n@Float64  ] ...]

  # ── Comparison — monomorphic typed variants ───────────────────────────────
  # Rust returns 1 (true) or 0 (false) as Integer — typed as [or 0 1] for precision.
  builtin-lt:        [fn@[or 0 1] [let a@NativeInt b@NativeInt] ...]
  builtin-int-gt:    [fn@[or 0 1] [let a@NativeInt b@NativeInt] ...]
  builtin-float-gt:  [fn@[or 0 1] [let a@Float64   b@Float64  ] ...]
  builtin-str-gt:    [fn@[or 0 1] [let a@String    b@String   ] ...]
  builtin-int-gte:   [fn@[or 0 1] [let a@NativeInt b@NativeInt] ...]
  builtin-float-gte: [fn@[or 0 1] [let a@Float64   b@Float64  ] ...]
  builtin-str-gte:   [fn@[or 0 1] [let a@String    b@String   ] ...]
  builtin-eq-int:    [fn@[or 0 1] [let a@NativeInt b@NativeInt] ...]
  builtin-eq-string: [fn@[or 0 1] [let a@String    b@String  ] ...]

  # ── Dict primitives ───────────────────────────────────────────────────────
  builtin-keys:              [fn@Dict    [let xs@Dict] ...]
  builtin-dict-length:       [fn@Integer [let xs@Dict] ...]
  builtin-str-length:        [fn@Integer [let s@String] ...]
  builtin-bytes-length:      [fn@Integer [let b@Bytes] ...]
  # builtin-merge: implemented in tinct prelude and loader/test-loader (using builder API).
  # builtin-append: implemented in tinct prelude (derived from builtin-merge).
  builtin-dict-get:           [fn@Any [let k@Any xs@Dict] ...]
  builtin-has-key?:          [fn@[or 0 1] [let k@Any xs@Dict] ...]
  builtin-get-by-field:      [fn@Any      [let field@String k@Any xs@Dict] ...]
  builtin-dict-has-nth?:     [fn@[or 0 1] [let d@Dict n@Integer] ...]
  builtin-dict-nth:          [fn@Any [let d@Dict n@Integer] ...]
  builtin-dict-has-key-nth?: [fn@[or 0 1] [let d@Dict n@Integer] ...]
  builtin-dict-key-nth:      [fn@Any      [let d@Dict n@Integer] ...]
  builtin-dict-has-kv-nth?:  [fn@[or 0 1] [let d@Dict n@Integer] ...]
  builtin-dict-kv-nth:       [fn@Any     [let d@Dict n@Integer] ...]
  builtin-build-dict:        [fn@Dict    [let entries@Dict] ...]
  builtin-dict-merge:        [fn@Dict    [let a@Dict b@Dict] ...]

  # ── Builder ops ───────────────────────────────────────────────────────────
  builtin-make-builder:      [fn@BuilderHandle [] ...]
  builtin-builder-set:       [fn@BuilderHandle [let key@Any value@Any builder@BuilderHandle] ...]
  builtin-builder-delete:    [fn@BuilderHandle [let builder@BuilderHandle key@Any] ...]
  builtin-builder-finish:    [fn@Dict          [let builder@BuilderHandle] ...]
  builtin-builder-snapshot:  [fn@Dict          [let builder@BuilderHandle] ...]
  builtin-builder-has?:      [fn@[or 0 1]      [let builder@BuilderHandle key@Any] ...]
  builtin-builder-get:       [fn@Any           [let builder@BuilderHandle key@Any] ...]
  builtin-builder-get-or:    [fn@Any           [let builder@BuilderHandle default@Any key@Any] ...]

  # ── String primitives ─────────────────────────────────────────────────────
  builtin-str-bytes:     [fn@Bytes   [let s@String] ...]
  builtin-str-hash:      [fn@Integer [let s@String] ...]
  builtin-int->string:   [fn@String  [let n@NativeInt] ...]
  builtin-str-slice:     [fn@String  [let s@String start@Integer end@Integer] ...]
  builtin-bytes-str:     [fn@String  [let b@Bytes] ...]
  builtin-str-index-of:  [fn@Integer [let needle@String s@String] ...]
  builtin-string-concat: [fn@String  [let a@String b@String] ...]

  # ── Bytes ─────────────────────────────────────────────────────────────────
  builtin-bytes:        [fn@Bytes [] ...]
  builtin-bytes-concat: [fn@Bytes [let a@Bytes b@Bytes] ...]

  # ── Type introspection ─────────────────────────────────────────────────────
  # These accept any value — the Any is genuine (type dispatch happens in Rust).
  builtin-type-of:         [fn@TypeValue [let x@Any] ...]
  builtin-check-type:      [fn@Any     [let type-name@String x@Any] ...]
  builtin-variant-payload: [fn@Any     [let variant@Any] ...]
  builtin-tag-of:          [fn@String  [let x@Any] ...]
  builtin-variant?:        [fn@[or 0 1] [let x@Any] ...]
  builtin-llt-repr:        [fn@String   [let x@Any] ...]
  builtin-debug-repr:      [fn@String   [let x@Any] ...]

  # ── Capability ─────────────────────────────────────────────────────────────
  # cap-env-has?: true (1) if the named capability key is present in the env scope.
  # env: SymbolTable — the accumulated scope passed to builtin-eval.
  builtin-cap-env-has?:  [fn@[or 0 1] [let name@String env@SymbolTable] ...]

  # ── I/O ───────────────────────────────────────────────────────────────────
  builtin-narrow:        [fn@DirCap  [let cap@DirCap path@String] ...]
  builtin-list-dir:      [fn@Dict    [let cap@DirCap path@String] ...]
  builtin-file-open:     [fn@File    [let cap@DirCap path@String modes@Dict mode@Integer flags@Integer] ...]
  builtin-file-read:     [fn@Bytes   [let file@File n@Integer] ...]
  builtin-write-stdout:  [fn@[bind: [h] return: h] [let s@String h] ...]
  builtin-write-stderr:  [fn@[bind: [h] return: h] [let s@String h] ...]

  # ── Pipeline primitives ────────────────────────────────────────────────────
  # parse: parse source bytes at path, return {program, diagnostics}.
  builtin-parse:          [fn@[program: Program  diagnostics: Diagnostics] [let src@Bytes path@String] ...]
  # desugar: desugar a Program (apply $_ transformation, pipe lowering, etc.).
  builtin-desugar:        [fn@Program  [let prog@Program] ...]
  # expand: expand declarations in a desugared Program (type decls, class decls, etc.).
  builtin-expand:         [fn@Program  [let prog@Program] ...]
  # resolve: resolve VarRef de Bruijn coords in a document against a scope.
  # scope: SymbolTable — opaque scope with name-to-slot mapping for all visible names.
  # Returns {doc, diagnostics, unreferenced}.
  # diagnostics: error-level diagnostics only (undefined variables).
  builtin-resolve:        [fn@[doc: Document  diagnostics: Diagnostics  unreferenced: Dict] [let doc@Document scope@SymbolTable] ...]
  # lower: lower a resolved+typechecked Document to a CoreDocument.
  # Must be called after builtin-typecheck-doc and before builtin-eval.
  builtin-lower:          [fn@CoreDocument [let typed@Document] ...]
  # eval: evaluate a lowered CoreDocument with a scope.
  # scope: SymbolTable — opaque scope with slots and name mapping.
  # Returns {table: SymbolTable, diagnostics: Diagnostics} after evaluation.
  builtin-eval:           [fn@[table: SymbolTable  diagnostics: Diagnostics]  [let lowered@CoreDocument scope@SymbolTable] ...]
  # typecheck-doc: type-check a single resolved document against a TypeContext.
  # Required third arg: doc-env Dict — provides eval-stage scope for type-stage expressions.
  # Returns {doc, diagnostics}.
  # tc: the TypeContext carrying accumulated type-stage state for this document.
  builtin-typecheck-doc:  [fn@[doc: Document  diagnostics: Diagnostics] [let doc@Document tc@TypeContext doc-env@SymbolTable] ...]
  # lint-pipeline-docs: cross-document pipeline stage lint.
  # Checks that keys produced by each stage are consumed by the next.
  # Required named arg pipeline-input: String — the variable name to track (e.g. "%").
  # Returns Dict of diagnostic dicts (empty when no warnings).
  builtin-lint-pipeline-docs: [fn@Dict [let docs@Dict pipeline-input@String] ...]
  # program-docs: return auto-indexed dict of documents in a Program.
  builtin-program-docs:      [fn@Documents [let prog@Program] ...]
  # doc-meta: evaluate a document's --- header, returning the result dict.
  # Header values are literals — no env injection needed.
  builtin-doc-meta:          [fn@Dict     [let doc@Document] ...]
  # doc-expressions: return auto-indexed dict of Expr-variant values from a document's expression items.
  # Decl items (type declarations, class/instance declarations, etc.) are skipped.
  builtin-doc-expressions:   [fn@Dict     [let doc@Document] ...]

  # ── Module system ─────────────────────────────────────────────────────────
  builtin-module:         [fn@Dict    [let name@String] ...]

  # ── TypeContext bootstrap ──────────────────────────────────────────────────
  builtin-get-type-context: [fn@TypeContext [] ...]
  builtin-make-type-ctx:    [fn@TypeContext [] ...]
  builtin-tc-update-type-stage-env: [fn@TypeContext [let tc@TypeContext env@Dict] ...]

  # ── Sequences (core collection ops) ───────────────────────────────────────
  builtin-take:    [fn@Dict [let n@Integer xs@Dict] ...]
  builtin-drop:    [fn@Dict [let n@Integer xs@Dict] ...]
  builtin-concat:  [fn@Any  [let a@Any b@Any] ...]
  # builtin-dict-first, builtin-dict-last, builtin-str-first, builtin-str-last:
  # Implemented in tinct prelude (derived from builtin-dict-nth, builtin-str-slice).
  # builtin-reverse, builtin-sort: implemented in tinct prelude. rest is a tinct alias for tail.

  # ── Async ─────────────────────────────────────────────────────────────────
  builtin-channel: [fn@[Channel Any] [] ...]
  builtin-send:    [fn@Any [let ch@[Channel Any] val@Any] ...]

  # ── Type system representation types ─────────────────────────────────────

  # TypeValue: runtime representation of types in the type system.
  # Used by the type checker (InferenceContext, type_unify.rs, bas.rs, etc.)
  # as Arc<Value> with ctor tags matching these constructor names.
  TypeValue: [type
    Repr:         [repr: String  is: [or [] Fn]]
    Phantom:      []
    Var:          [name: String]
    Fn:           [params: Dict  return: TypeValue  param-names: Dict  variadic: [or [] true]]
    App:          [op: TypeValue  arg: TypeValue]
    Op:           [name: String]
    Record:       [fields: Dict  tail: [or [] TypeValue]]
    Union:        [members: Dict]
    Inter:        [members: Dict]
    Neg:          [of: TypeValue]
    Scheme:       [vars: Dict  constraints: Dict  body: TypeValue  narrowings: [or [] Dict]  doc: [or [] String]]
    IntLit:       [value: Integer]
    FloatLit:     [value: Float64]
    StrLit:       [value: String]
    Recursive:       [body: TypeValue]
    RecursiveRef:    [depth: Integer]
    NominalVariant:  [tycon: String  ctor: String  fields: [or [] Dict]]
    Unknown
    Never
    Top]

  # RowTail: tail of a record type row (extensible or closed).
  # Corresponds to src/types.rs RowTail enum.
  RowTail: [type
    Closed
    Var:     [name: String]
    Uniform: [key: [or [] TypeValue]  value-type: TypeValue]]

  # Row: phantom type for row kinds. Not instantiated at runtime.
  Row: [type]

  # VarDecl: a single type variable binding in a polymorphic scheme.
  # Used as values in TypeValue.Scheme.vars (a Dict mapping var name → VarDecl).
  VarDecl: [type
    name: String
    kind: TypeValue]

  # ConstraintDecl: a typeclass constraint in a polymorphic scheme.
  # Used as values in TypeValue.Scheme.constraints (a Dict).
  ConstraintDecl: [type
    class: TypeValue
    args:  Dict]

  # Type: abstract typeclass for type-level operations.
  Type: [class [let t]]

  # ── Native runtime types (repr: declarations) ─────────────────────────────
  # These shadow the type-stage aliases above. The repr: key triggers the
  # CoreExpr::ReprDecl mechanism — these are nominal types that match specific
  # Value enum variants by their numeric TYPE_ID constant.

  Decimal:           [type repr: 14]
  BigInt:            [type repr: 15]
  Fn:                [type repr: 7]
  Builtin:           [type repr: 8]
  DirCap:            [type repr: 10]
  RevocableDirCap:   [type repr: 13]
  NetCap:            [type repr: 11]
  File:              [type repr: 12]
  ClockCap:          [type repr: 20]
  Task:              [type repr: 29]
  Channel:           [type repr: 30]
  BroadcastChannel:  [type repr: 31]
  OneshotSender:     [type repr: 32]
  OneshotReceiver:   [type repr: 33]
  Context:           [type repr: 34]
  ReactiveCell:      [type repr: 35]
  QuicSession:       [type repr: 22]
  Http2Session:      [type repr: 23]
  Http3Session:      [type repr: 24]
  QuicDatagramHandle: [type repr: 25]
  Uri:               [type repr: 17]
  Timestamp:         [type repr: 18]
  Duration:          [type repr: 19]
  Timezone:          [type repr: 21]
  Program:           [type repr: 26]
  Document:          [type repr: 27]
  Expression:        [type repr: 28]
  CoreDocument:      [type repr: 38]
  TypeContext:       [type repr: 37]
  SymbolTable:       [type repr: 39]
  BuilderHandle:     [type repr: 6]

  # ── Callable typeclass ────────────────────────────────────────────────────
  # Abstracts over function-like values (Fn and Builtin).
  Callable: [class [let a]]
  [instance Callable [let k@Fn]:      []]
  [instance Callable [let k@Builtin]: []]

  # ── SymbolTable operations ─────────────────────────────────────────────────
  builtin-empty-symbol-table:    [fn@SymbolTable  [let] ...]
  builtin-symbol-table-extend:   [fn@SymbolTable  [let scope@SymbolTable additions@Dict] ...]
  builtin-symbol-table-get:      [fn               [let scope@SymbolTable name@String] ...]
]
