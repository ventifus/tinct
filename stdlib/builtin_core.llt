# builtin_core.llt — Core types and fundamental primitives.
# These are the Rust-level irreducibles that type-foundations requires.
# ... bodies are Placeholder — valid tinct, errors if forced (never called).

[
  # ── Rust-backed primitive types ───────────────────────────────────────────────────────
  Int:     [type Int]
  Float:   [type Float]
  Bytes:   [type Bytes]

  # ── Capability types ─────────────────────────────────────────────────────────────────
  DirCap:  [type DirCap]
  NetCap:  [type NetCap]
  ClockCap:[type ClockCap]
  Handle:  [type Handle]
  Url:     [type Url]

  # ── Opaque Rust handle types ─────────────────────────────────────────────────────────
  BuilderHandle: [type BuilderHandle]
  Task:          [type [let a] Task]
  Channel:       [type [let a] Channel]
  Context:       [type Context]
  ReactiveCell:  [type [let a] ReactiveCell]
  QuicSession:   [type QuicSession]
  Http2Session:  [type Http2Session]
  Http3Session:  [type Http3Session]
  Timezone:      [type Timezone]
  Uri:           [type Uri]
  Urn:           [type Urn]
  Decimal:       [type Decimal]
  BigInt:        [type BigInt]

  # ── Control flow ─────────────────────────────────────────────────────────────────────
  builtin-raise: [fn@Never  [let msg@String] ...]
  # builtin-try returns {ok: value} on success or {error: message} on failure (both Dicts).
  # The prelude `try` wrapper converts this to Result.Ok / Result.Error for callers.
  builtin-try:   [fn@[bind: [a]] [let f@[Fn@a []]] ...]

  # ── String primitives ────────────────────────────────────────────────────────────────
  builtin-str-bytes:[fn@Bytes   [let s@String] ...]
  builtin-str-hash: [fn@Integer [let s@String] ...]

  # ── Comparison primitives — all return Integer (1=true, 0=false) ─────────────────────
  # Note: builtin-eq-float is in the "math" module (not Core-46).
  builtin-lt:        [fn@Integer [let a@Integer b@Integer] ...]
  builtin-eq-int:    [fn@Integer [let a@Integer b@Integer] ...]
  builtin-eq-string: [fn@Integer [let a@String  b@String]  ...]

  # ── Stateless stdio ───────────────────────────────────────────────────────────────────
  # write-stdout/stderr: writes s to the stream, returns h (handle pass-through for chaining).
  # h is not materialized — it flows through unchanged so callers can pipeline I/O.
  # Note: builtin-read-stdin is in the "io" module (not Core-46).
  builtin-write-stdout: [fn@[bind: [h]  return: h] [let s@String h] ...]
  builtin-write-stderr: [fn@[bind: [h]  return: h] [let s@String h] ...]

  # ── Value inspection ─────────────────────────────────────────────────────────────────
  # eval-repr: evaluate prog in env: and return llt-repr of the last result as a String.
  builtin-eval-repr:       [fn@String [let prog@Any ...opts] ...]
  # variant-payload: extract the payload dict from a Variant value. Errors on non-Variant.
  builtin-variant-payload: [fn@Any    [let variant@Any] ...]

  # ── TypeContext bootstrap ───────────────────────────────────────────────────────────────
  # make-type-ctx: create a fresh TypeContext. Loader needs this to build the seed-tc
  # that is passed explicitly to uses-scope (no fallback to global ctx.type_context).
  builtin-make-type-ctx:   [fn@TypeContext [] ...]

  # ── Environment access ───────────────────────────────────────────────────────────────
  # current-env: returns the caller's lexical environment. Zero positional args.
  builtin-current-env:     [fn@Any  [] ...]
  # var-resolution: given byte offset and resolved Program, return {level: N, slot: M} or [].
  builtin-var-resolution:  [fn@Dict [let offset@Integer env@Any] ...]
]
