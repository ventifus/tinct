# builtin_core.llt — Core types and fundamental primitives.
# These are the Rust-level irreducibles that type-foundations requires.
# ... bodies are Placeholder — valid tinct, errors if forced (never called).

[
  # ── Rust-backed primitive types ───────────────────────────────────────────────────────
  Int:     [type Int]
  Float:   [type Float]
  Bytes:   [type Bytes]

  # ── Capability types ─────────────────────────────────────────────────────────────────
  DirCap:  [type DirCap]
  NetCap:  [type NetCap]
  ClockCap:[type ClockCap]
  Handle:  [type Handle]
  Url:     [type Url]

  # ── Opaque Rust handle types ─────────────────────────────────────────────────────────
  BuilderHandle: [type BuilderHandle]
  Task:          [type [let a] Task]
  Channel:       [type [let a] Channel]
  Context:       [type Context]
  ReactiveCell:  [type [let a] ReactiveCell]
  QuicSession:   [type QuicSession]
  Http2Session:  [type Http2Session]
  Http3Session:  [type Http3Session]
  Timezone:      [type Timezone]
  Uri:           [type Uri]
  Urn:           [type Urn]
  Decimal:       [type Decimal]
  BigInt:        [type BigInt]

  # ── Control flow ─────────────────────────────────────────────────────────────────────
  builtin-raise: [fn@Never  [let msg@String] ...]
  builtin-try:   [fn@[union a [Error msg: String]] [let f@[Fn@a []]] ...]
  builtin-if:    [fn@a      [let cond@Boolean then@a else@a] ...]

  # ── String primitives ────────────────────────────────────────────────────────────────
  builtin-str:      [fn@String  [let ...args@Any] ...]
  builtin-str-bytes:[fn@Bytes   [let s@String] ...]
  builtin-str-eq:   [fn@Boolean [let a@String b@String] ...]
  builtin-str-hash: [fn@Int     [let s@String] ...]
  builtin-str-lt:   [fn@Boolean [let a@String b@String] ...]

  # ── Comparison primitives (backing typeclass instances) ──────────────────────────────
  builtin-int-eq:   [fn@Boolean [let a@Int b@Int] ...]
  builtin-lt:       [fn@Int     [let a@Int b@Int] ...]
  builtin-float-lt: [fn@Boolean [let a@Float b@Float] ...]
]
