# ============================================================================
# LLT Encoding Utilities (stdlib/encoding.llt)
# ============================================================================
#
# Pure-tinct encoding functions for hex, base64, and simple XOR masking.
# Since Value::Bytes doesn't exist yet, all functions work with strings.
#
# No raw builtin-* calls — uses prelude-exported names only (T002 compliant).
#   String:      str, str-slice, str-length
#   Arithmetic:  +, -, *
#   Comparison:  <, =, >=, <=
#   Control:     if
#   Sequences:   range
#   Character:   char-code, chr, bxor
#   Higher-order: quot, mod, and
#
# Encoding conventions:
#   hex-*        Hexadecimal encoding (lowercase a-f)
#   base64-*     Base64 encoding (RFC 4648, standard alphabet with padding)
#   mask-apply   Simple XOR masking (repeating key cipher)
# ============================================================================

# ============================================================================
# Private helpers — not exported
# ============================================================================
[

# ============================================================================
# Hexadecimal Encoding — helpers
# ============================================================================

hex-encode-impl: [fn@String [let s@String i@Int len@Int acc@String]
    [if [< i len]
        [hex-encode-step s i len acc [char-code [str-slice i [+ i 1] s]]]
        acc]]

hex-encode-step: [fn@String [let s@String i@Int len@Int acc@String code@Int]
    [hex-encode-impl s [+ i 1] len
        [str acc [int-to-hex code]]]]

# Convert an integer (0-255) to a 2-digit hex string.
# Type: (Int -> String)
# Example: [int-to-hex 104] => "68"  (h)
# Example: [int-to-hex 15] => "0f"
# Example: [int-to-hex 255] => "ff"
int-to-hex: [fn@String [let n@Int]
    [str [hex-digit [quot n 16]]
         [hex-digit [mod n 16]]]]

# Convert a single hex digit (0-15) to its character.
# Type: (Int -> String)
hex-digit: [fn@String [let n@Int]
    [if [< n 10]
        [chr [+ 48 n]]           # '0'-'9' (48 = '0')
        [chr [+ 87 n]]]]         # 'a'-'f' (97 = 'a', 97-10=87)

hex-decode-impl: [fn@String [let s@String i@Int len@Int acc@String]
    [if [< i len]
        [hex-decode-step s i len acc
            [hex-digit-to-int [str-slice i [+ i 1] s]]
            [hex-digit-to-int [str-slice [+ i 1] [+ i 2] s]]]
        acc]]

hex-decode-step: [fn@String [let s@String i@Int len@Int acc@String hi@Int lo@Int]
    [hex-decode-impl s [+ i 2] len
        [str acc [chr [+ [* hi 16] lo]]]]]

# Convert a hex digit character to an integer (0-15).
# Type: (String -> Int)
# Accepts: '0'-'9', 'a'-'f', 'A'-'F'
hex-digit-to-int: [fn@Int [let c@String]
    [hex-digit-to-int-impl c [char-code c]]]

hex-digit-to-int-impl: [fn@Int [let c@String code@Int]
    [if [and [>= code 48] [<= code 57]]           # '0'-'9'
        [- code 48]
        [if [and [>= code 97] [<= code 102]]      # 'a'-'f'
            [- code 87]
            [if [and [>= code 65] [<= code 70]]   # 'A'-'F'
                [- code 55]
                [error [str "hex-decode: invalid hex digit: " c]]]]]]

# ============================================================================
# Base64 Encoding (RFC 4648) — helpers
# ============================================================================

# Base64 alphabet (indices 0-63)
# A-Z (0-25), a-z (26-51), 0-9 (52-61), + (62), / (63)
base64-alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

base64-encode-impl: [fn@String [let s@String i@Int len@Int acc@String]
    [if [< i len]
        [base64-encode-group s i len acc]
        acc]]

# Encode a group of up to 3 bytes.
base64-encode-group: [fn@String [let s@String i@Int len@Int acc@String]
    [if [< [+ i 2] len]
        # Full 3-byte group
        [base64-encode-3bytes s i len acc
            [char-code [str-slice i [+ i 1] s]]
            [char-code [str-slice [+ i 1] [+ i 2] s]]
            [char-code [str-slice [+ i 2] [+ i 3] s]]]
        [if [= [+ i 1] len]
            # Single byte remaining
            [base64-encode-1byte s i len acc
                [char-code [str-slice i [+ i 1] s]]]
            # Two bytes remaining
            [base64-encode-2bytes s i len acc
                [char-code [str-slice i [+ i 1] s]]
                [char-code [str-slice [+ i 1] [+ i 2] s]]]]]]

base64-encode-3bytes: [fn@String [let s@String i@Int len@Int acc@String b1@Int b2@Int b3@Int]
    [base64-encode-impl s [+ i 3] len
        [str acc
            [base64-char [quot b1 4]]                                              # top 6 bits of b1
            [base64-char [+ [* [mod b1 4] 16] [quot b2 16]]]   # bottom 2 of b1 + top 4 of b2
            [base64-char [+ [* [mod b2 16] 4] [quot b3 64]]]   # bottom 4 of b2 + top 2 of b3
            [base64-char [mod b3 64]]]]]                                                   # bottom 6 bits of b3

base64-encode-2bytes: [fn@String [let s@String i@Int len@Int acc@String b1@Int b2@Int]
    [base64-encode-impl s [+ i 2] len
        [str acc
            [base64-char [quot b1 4]]
            [base64-char [+ [* [mod b1 4] 16] [quot b2 16]]]
            [base64-char [* [mod b2 16] 4]]
            "="]]]

base64-encode-1byte: [fn@String [let s@String i@Int len@Int acc@String b1@Int]
    [base64-encode-impl s [+ i 1] len
        [str acc
            [base64-char [quot b1 4]]
            [base64-char [* [mod b1 4] 16]]
            "=="
        ]]]

# Get the base64 character for index n (0-63).
# Type: (Int -> String)
base64-char: [fn@String [let n@Int]
    [str-slice n [+ n 1] base64-alphabet]]

base64-decode-impl: [fn@String [let s@String i@Int len@Int acc@String]
    [if [< i len]
        [base64-decode-group s i len acc]
        acc]]

# Decode a group of 4 base64 characters.
base64-decode-group: [fn@String [let s@String i@Int len@Int acc@String]
    [if [< [+ i 3] len]
        [base64-decode-4chars s i len acc
            [base64-char-to-int [str-slice i [+ i 1] s]]
            [base64-char-to-int [str-slice [+ i 1] [+ i 2] s]]
            [base64-char-to-int [str-slice [+ i 2] [+ i 3] s]]
            [base64-char-to-int [str-slice [+ i 3] [+ i 4] s]]]
        [error "base64-decode: invalid input length (must be multiple of 4)"]]]

base64-decode-4chars: [fn@String [let s@String i@Int len@Int acc@String c1@Int c2@Int c3@Int c4@Int]
    [if [= c4 [- 0 1]]           # c4 is padding ('=')
        [if [= c3 [- 0 1]]       # c3 is also padding ('==')
            # Single byte encoded
            [base64-decode-impl s [+ i 4] len
                [str acc [chr [+ [* c1 4] [quot c2 16]]]]]
            # Two bytes encoded
            [base64-decode-impl s [+ i 4] len
                [str acc
                    [chr [+ [* c1 4] [quot c2 16]]]
                    [chr [+ [* [mod c2 16] 16] [quot c3 4]]]]]]
        # Three bytes encoded
        [base64-decode-impl s [+ i 4] len
            [str acc
                [chr [+ [* c1 4] [quot c2 16]]]
                [chr [+ [* [mod c2 16] 16] [quot c3 4]]]
                [chr [+ [* [mod c3 4] 64] c4]]]]]]

# Convert a base64 character to its index (0-63), or -1 for padding ('=').
# Type: (String -> Int)
base64-char-to-int: [fn@Int [let c@String]
    [if [= c "="]
        [- 0 1]
        [base64-char-to-int-search c 0]]]

base64-char-to-int-search: [fn@Int [let c@String i@Int]
    [if [< i 64]
        [if [= c [str-slice i [+ i 1] base64-alphabet]]
            i
            [base64-char-to-int-search c [+ i 1]]]
        [error [str "base64-decode: invalid character: " c]]]]

# ============================================================================
# XOR Masking — helpers
# ============================================================================

mask-apply-impl: [fn@String [let data@String mask@String i@Int data-len@Int mask-len@Int acc@String]
    [if [< i data-len]
        [mask-apply-step data mask i data-len mask-len acc
            [char-code [str-slice i [+ i 1] data]]
            [char-code [str-slice [mod i mask-len] [+ [mod i mask-len] 1] mask]]]
        acc]]

mask-apply-step: [fn@String [let data@String mask@String i@Int data-len@Int mask-len@Int acc@String data-code@Int mask-code@Int]
    [mask-apply-impl data mask [+ i 1] data-len mask-len
        [str acc [chr [bxor data-code mask-code]]]]]

]

# ============================================================================
# Public API — exported
# ============================================================================
[

# Convert a string to its hexadecimal representation.
# Each character's codepoint is encoded as 2 hex digits (lowercase).
# Only supports ASCII (codepoints 0-255).
# Type: (String -> String)
# Example: [hex-encode "hello"] => "68656c6c6f"
# Example: [hex-encode "A"] => "41"
# Example: [hex-encode ""] => ""
hex-encode@[doc: "Convert a string to its hexadecimal representation"]: [fn@String [let s@String]
    [hex-encode-impl s 0 [str-length s] ""]]

# Decode a hexadecimal string back to its original form.
# Takes pairs of hex digits and converts them to characters.
# Type: (String -> String)
# Example: [hex-decode "68656c6c6f"] => "hello"
# Example: [hex-decode "41"] => "A"
# Example: [hex-decode ""] => ""
hex-decode@[doc: "Decode a hexadecimal string back to its original form"]: [fn@String [let s@String]
    [if [= [mod [str-length s] 2] 0]
        [hex-decode-impl s 0 [str-length s] ""]
        [error "hex-decode: input length must be even"]]]

# Convert a string to base64 encoding.
# Groups bytes in threes (24 bits) and encodes as 4 base64 characters.
# Pads with '=' to align to 4-character boundary.
# Type: (String -> String)
# Example: [base64-encode "hello"] => "aGVsbG8="
# Example: [base64-encode "hi"] => "aGk="
# Example: [base64-encode "a"] => "YQ=="
base64-encode@[doc: "Convert a string to base64 encoding"]: [fn@String [let s@String]
    [base64-encode-impl s 0 [length s] ""]]

# Decode a base64 string back to its original form.
# Type: (String -> String)
# Example: [base64-decode "aGVsbG8="] => "hello"
# Example: [base64-decode "aGk="] => "hi"
# Example: [base64-decode "YQ=="] => "a"
base64-decode@[doc: "Decode a base64 string back to its original form"]: [fn@String [let s@String]
    [base64-decode-impl s 0 [length s] ""]]

# Apply an XOR mask to a string.
# Each character in data is XOR'd with the corresponding character in mask.
# The mask repeats cyclically if shorter than data.
# Type: (String -> String -> String)
# Example: [mask-apply "hello" "key"] => (encrypted string)
# Example: [mask-apply [mask-apply "hello" "key"] "key"] => "hello"  (double XOR recovers original)
mask-apply@[doc: "Apply an XOR mask to a string (repeating-key cipher)"]: [fn@String [let data@String mask@String]
    [if [= [length mask] 0]
        [error "mask-apply: mask cannot be empty"]
        [mask-apply-impl data mask 0 [length data] [length mask] ""]]]

]
