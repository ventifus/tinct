# ============================================================================
# LLT Standard Library Macros (stdlib/macros.llt)
# ============================================================================
#
# Compile-time AST transformations via macro declarations.
#
# NOTE: All macros in this file use [defmacro ...] instead of [macro ... [let params]]
# because they require variadic arguments, and variadic [let ...args] patterns are not
# yet supported in macro parameter lists (as of macros-v2-stdlib sprint).
# Once variadic support is added, these should be migrated to:
#   [macro tmpl [let template@Expr ...exprs@[Seq Expr]] ...]
#   [macro do [let monad@Expr ...steps@[Seq Expr]] ...]
#   [macro begin [let ...exprs@[Seq Expr]] ...]
#
# Each defmacro transformer receives a single `args` parameter (dict with integer
# keys, one per positional argument at the call site).
#
# Loaded automatically via create_stdlib_env(). All prelude functions
# (str, split, str-slice, str-length, str-contains?, starts-with?,
#  append, reduce, if, =, +, get, to-int, length) are available here.
#
# ============================================================================
# tmpl macro — string interpolation
# ============================================================================
#
# The parser converts i"Hello $name" to [tmpl "Hello $name"].
# tmpl expands [tmpl "raw-template" expr0 expr1 ...] to
# [str segment1 var1 segment2 ...].
#
# Raw template encoding (set by the parser in emit_tmpl_call):
#   $$    — literal $ (re-encoded from InterpolatedPart::Literal segments containing $)
#   $name — variable reference
#   ${N}  — expression placeholder where N is the 0-based index into extra args
#
# args layout:
#   args[0] = AST dict for the template string literal
#   args[1..] = AST dicts for ${N} expression args (if any)
#
# Implementation strategy (split on "$"):
#   1. Split template on "$" → [prefix, piece1, piece2, ...]
#   2. Prefix (piece 0) is always a literal
#   3. For each subsequent piece:
#      - empty string  → $$ escape: emit literal "$", skip next piece as literal
#      - starts with { → ${N} expr placeholder: lookup args[N+1]
#      - otherwise     → $name variable reference: parse ident up to stop char
#   4. Return {type: "call", fn: {type: "var", name: "str"}, args: [...], named-args: [], implied: true}
#
# ============================================================================

# Private helpers (first dict — not exported as public bindings)

[

# true if character c is a stop character for variable names in interpolated strings.
# Mirrors the stop-char set in src/lexer.rs lex_interpolated_string VarRef branch.
tmpl-is-stop: [fn [let c]
  [str-contains? " \t\n[]:#;\"@.,!?" c]]

# Find the byte-length of the variable name at the start of string s.
# Walks from index i until a stop char is found or end of string.
# Returns i when done (i = number of ident chars consumed).
tmpl-var-len: [fn [let s len i]
  [if [< i len]
    [if [tmpl-is-stop [str-slice s i [+ i 1]]]
      i
      [tmpl-var-len s len [+ i 1]]]
    i]]

# Build a string literal AST dict node.
tmpl-str-node: [fn [let text]
  [type: "literal"  kind: "str"  value: text  bare: false]]

# Build a var reference AST dict node.
tmpl-var-node: [fn [let var-name]
  [type: "var"  name: var-name]]

# Append an optional suffix literal to nodes (only if suffix is non-empty).
# Returns the updated nodes list.
tmpl-append-suffix: [fn [let nodes suffix]
  [if [= suffix ""]
    nodes
    [append nodes [tmpl-str-node suffix]]]]

# Process a piece that starts with "{N}" (an expression placeholder).
# Appends the expression AST node (and optional suffix literal) to nodes.
# Returns the updated nodes list.
# Called when the piece starts with "{" after splitting on "$".
tmpl-process-expr-piece: [fn [let piece macro-args nodes]
  [if [str-contains? piece "}"]
    [tmpl-process-expr-with-close piece macro-args nodes]
    # Malformed ${}: no closing "}" found — emit "$" + piece as a literal
    [append nodes [tmpl-str-node [str "$" piece]]]
  ]]

# Helper: piece has a "}" — extract index and suffix.
# split "}" on "{0}suffix" → [{0: "{0", 1: "suffix"}]
tmpl-process-expr-with-close: [fn [let piece macro-args nodes]
  [tmpl-process-expr-parts [split "}" piece] macro-args nodes]]

tmpl-process-expr-parts: [fn [let brace-split macro-args nodes]
  [tmpl-process-expr-idx
    [get 0 brace-split]
    [get 1 brace-split]
    macro-args
    nodes]]

# idx-part is "{N", suffix is the text after "}"
tmpl-process-expr-idx: [fn [let idx-part suffix macro-args nodes]
  [tmpl-process-expr-insert
    [get [+ [to-int [str-slice idx-part 1 [length idx-part]]] 1] macro-args]
    suffix
    nodes]]

# Insert the expression node and optional suffix into nodes.
tmpl-process-expr-insert: [fn [let expr-node suffix nodes]
  [tmpl-append-suffix [append nodes expr-node] suffix]]

# Process a piece that represents a variable reference ($name).
# Appends the var-node (and optional suffix literal) to nodes.
# Returns the updated nodes list.
tmpl-process-var-piece: [fn [let piece nodes]
  [tmpl-process-var-split piece nodes [length piece]]]

tmpl-process-var-split: [fn [let piece nodes len]
  [tmpl-process-var-emit piece nodes [tmpl-var-len piece len 0] len]]

tmpl-process-var-emit: [fn [let piece nodes var-end len]
  [tmpl-append-suffix
    [append nodes [tmpl-var-node [str-slice piece 0 var-end]]]
    [str-slice piece var-end len]]]

# Accumulator step function for building the tmpl args node list.
# acc = {nodes: [...], skip: false, is-first: true}
#   nodes    — accumulated list of AST nodes
#   skip     — true after a $$ escape; the next piece is a literal continuation, not a var
#   is-first — true for the first piece (always a literal prefix, not preceded by "$")
#
# Returns the updated accumulator.
tmpl-reduce-step: [fn [let args] [fn [let acc piece]
  [if acc.is-first
    # First piece: always a literal prefix (may be empty — skip if so)
    [tmpl-step-literal acc piece]
    [if acc.skip
      # This piece is the literal continuation after a $$ escape (not a var name).
      [tmpl-step-literal acc piece]
      [if [= piece ""]
        # Empty piece = $$ escape: emit literal "$" and mark next piece as skip.
        [nodes: [append acc.nodes [tmpl-str-node "$"]]  skip: true  is-first: false]
        [if [starts-with? piece "{"]
          # ${N} expression placeholder
          [nodes: [tmpl-process-expr-piece piece args acc.nodes]  skip: false  is-first: false]
          # $name variable reference
          [nodes: [tmpl-process-var-piece piece acc.nodes]  skip: false  is-first: false]
        ]
      ]
    ]
  ]
]]

# Append piece as a literal to acc.nodes (empty string → skip).
# Returns a new accumulator with is-first=false and skip=false.
tmpl-step-literal: [fn [let acc piece]
  [nodes: [if [= piece ""] acc.nodes [append acc.nodes [tmpl-str-node piece]]]
   skip: false
   is-first: false]]

# Split template string on "$" and fold pieces into AST arg nodes.
tmpl-expand: [fn [let template-str args]
  [tmpl-emit-call
    [reduce
      [tmpl-reduce-step args]
      [nodes: []  skip: false  is-first: true]
      [split "$" template-str]]]]

# Wrap the collected AST nodes in a [str ...] call AST dict.
tmpl-emit-call: [fn [let result]
  [type: "call"
   fn:         [type: "var"  name: "str"]
   args:       result.nodes
   named-args: []
   implied:    true]]

]

# ============================================================================
# [do] macro helpers — AST node builders for monadic do-notation desugaring
# ============================================================================
#
# These helpers build AST dict nodes without ever accessing runtime values.
# All arena-crossing is avoided: we only construct dicts with string/bool
# literals and the AST dicts passed in as macro arguments.
#
# AST node schemas (from src/ast_dict.rs):
#   var-node:        {type: "var",        name: <str>}
#   literal-str:     {type: "literal",    kind: "str", value: <str>, bare: false}
#   dot-access-node: {type: "dot-access", target: <ast>, field: <str>}
#   call-node:       {type: "call",       fn: <ast>, args: <list>, named-args: {}, implied: true}
#   fn-node:         {type: "fn",         params: <list>, body: <ast>, return-ann: {}, desugared: false}
#   param-node:      {name: <str>,        annotation: {}, variadic: false}
#   list (0-elem):   {}
#   list (1-elem):   {0: <item>}
#   list (2-elem):   {0: <item0>, 1: <item1>}

[

# Build a var-reference AST node.
do-var-node: [fn [let name]
  [type: "var"  name: name]]

# Build a single-param list (integer-keyed dict with one entry).
# Uses p-name (not 'name') to avoid letrec key-shadowing: [name: name] would
# shadow the outer 'name' binding with the dict's own letrec 'name' thunk.
do-params-1: [fn [let p-name]
  [0: [name: p-name  annotation: []  variadic: false]]]

# Build a fn AST node: [fn [param-name] body].
# Uses p-name/p-body to avoid letrec key-shadowing of 'params'/'body' keys.
do-fn-node: [fn [let p-name p-body]
  [type: "fn"
   params: [do-params-1 p-name]
   body: p-body
   return-ann: []
   desugared: false]]

# Build a dot-access AST node: target.field
# Uses p-target/p-field to avoid letrec key-shadowing of 'target'/'field' keys.
do-access-node: [fn [let p-target p-field]
  [type: "dot-access"  target: p-target  field: p-field]]

# Build a 1-element list (integer-keyed dict).
do-list-1: [fn [let a]
  [0: a]]

# Build a 2-element list (integer-keyed dict).
do-list-2: [fn [let a b]
  [0: a  1: b]]

# Build a call AST node with exactly one positional arg.
do-call-1: [fn [let p-func arg0]
  [type: "call"
   fn: p-func
   args: [do-list-1 arg0]
   named-args: []
   implied: true]]

# Build a call AST node with exactly two positional args.
do-call-2: [fn [let func arg0 arg1]
  [type: "call"
   fn: func
   args: [do-list-2 arg0 arg1]
   named-args: []
   implied: true]]

# Build an empty dict AST node (represents [] — the unit value for pure).
do-empty-dict-node: [fn [let]
  [type: "dict"  entries: []]]

# Check if a step AST is a binding step (a dict literal with at least one entry).
# A binding step was written as [name: expr] in the do-block.
# Its quoted AST has type "dict".
do-is-binding: [fn [let step]
  [= [get "type" step] "dict"]]

# Check if the first arg looks like an inferred-form step rather than an explicit monad.
# Explicit monad args are usually VarRef ("var") or DotAccess ("dot-access").
# Inferred form: the first arg is a binding dict ("dict") or any other expression.
# Returns true if this is the inferred form (unsupported).
do-is-inferred-form: [fn [let first-arg]
  [type: [get "type" first-arg]]
  # Explicit monad types: "var" and "dot-access"
  # Everything else is inferred form
  [if [= type "var"]
    false
    [if [= type "dot-access"]
      false
      true]]]

# Extract the binding name from a binding step.
# step.entries[0].key is the key expr: {type: "literal", kind: "str", value: "name", bare: true}
# We read the "value" field of that key literal to get the string name.
do-binding-name: [fn [let step]
  [get "value" [get "key" [get 0 [get "entries" step]]]]]

# Extract the bound expression AST from a binding step.
# step.entries[0].value is the value expr.
do-binding-expr: [fn [let step]
  [get "value" [get 0 [get "entries" step]]]]

# Wrap a single step and the desugared inner expression into a bind call:
#   binding [x: expr]: [monad.bind expr [fn [x] inner]]
#   non-binding expr:  [monad.bind expr [fn [_] inner]]
do-wrap: [fn [let monad-ast step inner]
  [if [do-is-binding step]
    [do-call-2
      [do-access-node monad-ast "bind"]
      [do-binding-expr step]
      [do-fn-node [do-binding-name step] inner]]
    [do-call-2
      [do-access-node monad-ast "bind"]
      step
      [do-fn-node "_" inner]]]]

# Recursively desugar steps[i..n-1] into nested bind calls.
# Base case: i == n-1 — return the final step expression as-is.
# Recursive case: wrap step[i] around the desugaring of step[i+1..n-1].
do-fold: [fn [let monad-ast steps i n]
  [if [= i [- n 1]]
    [get i steps]
    [do-wrap monad-ast [get i steps] [do-fold monad-ast steps [+ i 1] n]]]]

# Desugar the inferred [do] form: emit bind chain with %do-infer sentinel monad.
# Called when args[0] is NOT a monad (it's a binding step or other expression).
# All n args are steps; the %do-infer sentinel is prepended as the monad.
# The type checker detects %do-infer, resolves the monad, and wires it to eval.
# Returns: [%do-infer.bind step1 [fn [name] [%do-infer.bind step2 [...]]]] or
#          [%do-infer.bind step1 [fn [name] last-step]] for a 2-step do block.
do-desugar-inferred: [fn [let n args]
  [sentinel: [do-var-node "%do-infer"]]
  [new-n: [+ n 1]]
  [new-args: [reduce [fn [let acc i] [set acc [+ i 1] [get i args]]] [set [] 0 sentinel] [range 0 n]]]
  [do-fold sentinel new-args 1 new-n]]

]

# ============================================================================
# Public macro transformer exports
# ============================================================================
#
# These are registered by expand_macros via register_stdlib_macros_from_env.
# Each function receives a single `args` parameter: a dict with integer keys
# (one per positional argument at the call site) where each value is an AST dict.

[

# tmpl macro transformer: string interpolation i"...$var..." syntax
tmpl: [fn [let args]
  # args[0] = AST dict for the template string literal
  # args[1..] = AST dicts for ${N} expression placeholders (if any)
  [tmpl-expand
    [get "value" [get 0 args]]
    args]]

# do macro transformer: monadic do-notation desugaring.
#
# Syntax: [do monad step1 step2 ... final]
#   monad — a var reference or any expression that evaluates to a monad dict
#   steps — zero or more binding steps [name: expr] or expression steps expr
#   final — the last expression (returned from the do block)
#
# Desugaring (right-fold over steps):
#   [do m [x: e1] [y: e2] e3]
#   → [m.bind e1 [fn [x] [m.bind e2 [fn [y] e3]]]]
#
# The macro operates entirely at the AST level: it never accesses the runtime
# monad dict. The dot-access (m.bind, m.pure) is generated as an AST node and
# resolved at evaluation time. This avoids any arena-crossing ThunkId issues.
do: [fn [let args]
  [n: [length args]]
  [if [= n 0]
    # Error: need at least the monad argument
    [type: "call"
     fn: [type: "var" name: "error"]
     args: [0: [type: "literal" kind: "str" value: "do requires at least a monad argument" bare: false]]
     named-args: []
     implied: true]
    # Check if args[0] is an inferred-form step (dict binding or other non-monad expression)
    # vs an explicit monad argument (var reference).
    # Explicit monad: args[0].type == "var" or "dot-access"
    # Inferred form: args[0].type == "dict" (binding step) or anything else
    [if [do-is-inferred-form [get 0 args]]
      # Inferred [do] form: emit bind chain with %do-infer sentinel.
      # do-desugar-inferred builds {0:sentinel, 1:step1, ...} and calls do-fold.
      # The type checker detects %do-infer, resolves the monad, wires it to eval.
      [do-desugar-inferred n args]
      [if [= n 1]
        # [do monad] with no steps → [monad.pure []]
        [do-call-1
          [do-access-node [get 0 args] "pure"]
          [do-empty-dict-node]]
        # [do monad step1 ... final] → nested bind calls
        [do-fold
          [get 0 args]
          args
          1
          n]]]]]

# begin macro transformer: sequential expression grouping
begin: [fn [let args]
  # [begin e1 e2 ...] → {type: "sequential", exprs: [e1, e2, ...]}
  [n: [length args]]
  [arglist: [reduce [fn [let acc i] [append acc [get i args]]] [] [range 0 n]]]
  [type: "sequential"  exprs: arglist]]

]
