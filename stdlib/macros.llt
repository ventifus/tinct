# ============================================================================
# LLT Standard Library Macros (stdlib/macros.llt)
# ============================================================================
#
# Compile-time AST transformations exported as transformer functions.
#
# All macros use new-style argument passing with variadic parameters:
#   tmpl: [fn [let template ...parts] ...]
#   do:   [fn [let first ...rest] ...]
#   begin: [fn [let ...exprs] ...]
#
# Each transformer receives individually-quoted AST Variant nodes as arguments.
# Variadic parameters (e.g., ...parts, ...rest, ...exprs) collect remaining args
# into a Seq of AST nodes.
#
# These functions are exported from the final dict and registered by
# register_stdlib_macros_from_env() in src/expand.rs with new_style=true.
#
# Loaded automatically via create_stdlib_env(). All prelude functions are available.
#
# ============================================================================
# tmpl macro — string interpolation
# ============================================================================
#
# The parser converts i"Hello $name" to [tmpl "Hello $name"].
# tmpl expands [tmpl "raw-template" expr0 expr1 ...] to
# [str segment1 var1 segment2 ...].
#
# Raw template encoding (set by the parser in emit_tmpl_call):
#   $$    — literal $ (re-encoded from InterpolatedPart::Literal segments containing $)
#   $name — variable reference
#   ${N}  — expression placeholder where N is the 0-based index into extra args
#
# args layout:
#   args[0] = AST dict for the template string literal
#   args[1..] = AST dicts for ${N} expression args (if any)
#
# Implementation strategy (split on "$"):
#   1. Split template on "$" → [prefix, piece1, piece2, ...]
#   2. Prefix (piece 0) is always a literal
#   3. For each subsequent piece:
#      - empty string  → $$ escape: emit literal "$", skip next piece as literal
#      - starts with { → ${N} expr placeholder: lookup args[N+1]
#      - otherwise     → $name variable reference: parse ident up to stop char
#   4. Return {type: "call", fn: {type: "var", name: "str"}, args: [...], named-args: [], implied: true}
#
# ============================================================================

# Include meta builtins (builtin-variant, tag-of, etc.) for AST construction
[include %rust "meta"]

# Private helpers (first dict — not exported as public bindings)

[

# true if character c is a stop character for variable names in interpolated strings.
# Mirrors the stop-char set in src/lexer.rs lex_interpolated_string VarRef branch.
tmpl-is-stop: [fn [let c]
  [str-contains? " \t\n[]:#;\"@.,!?" c]]

# Find the byte-length of the variable name at the start of string s.
# Walks from index i until a stop char is found or end of string.
# Returns i when done (i = number of ident chars consumed).
tmpl-var-len: [fn [let s len i]
  [if [< i len]
    [if [tmpl-is-stop [str-slice s i [+ i 1]]]
      i
      [tmpl-var-len s len [+ i 1]]]
    i]]

# Build a string literal AST Variant node.
tmpl-str-node: [fn [let text]
  [builtin-variant "Literal" [kind: "str"  value: text  bare: false]]]

# Build a var reference AST Variant node.
tmpl-var-node: [fn [let var-name]
  [builtin-variant "VarRef" [name: var-name]]]

# Append an optional suffix literal to nodes (only if suffix is non-empty).
# Returns the updated nodes list.
tmpl-append-suffix: [fn [let nodes suffix]
  [if [= suffix ""]
    nodes
    [append nodes [tmpl-str-node suffix]]]]

# Process a piece that starts with "{N}" (an expression placeholder).
# Appends the expression AST node (and optional suffix literal) to nodes.
# Returns the updated nodes list.
# Called when the piece starts with "{" after splitting on "$".
tmpl-process-expr-piece: [fn [let piece macro-args nodes]
  [if [str-contains? piece "}"]
    [tmpl-process-expr-with-close piece macro-args nodes]
    # Malformed ${}: no closing "}" found — emit "$" + piece as a literal
    [append nodes [tmpl-str-node [str "$" piece]]]
  ]]

# Helper: piece has a "}" — extract index and suffix.
# split "}" on "{0}suffix" → [{0: "{0", 1: "suffix"}]
tmpl-process-expr-with-close: [fn [let piece macro-args nodes]
  [tmpl-process-expr-parts [split "}" piece] macro-args nodes]]

tmpl-process-expr-parts: [fn [let brace-split macro-args nodes]
  [tmpl-process-expr-idx
    [get 0 brace-split]
    [get 1 brace-split]
    macro-args
    nodes]]

# idx-part is "{N", suffix is the text after "}"
tmpl-process-expr-idx: [fn [let idx-part suffix macro-args nodes]
  [tmpl-process-expr-insert
    [get [+ [to-int [str-slice idx-part 1 [length idx-part]]] 1] macro-args]
    suffix
    nodes]]

# Insert the expression node and optional suffix into nodes.
tmpl-process-expr-insert: [fn [let expr-node suffix nodes]
  [tmpl-append-suffix [append nodes expr-node] suffix]]

# Process a piece that represents a variable reference ($name).
# Appends the var-node (and optional suffix literal) to nodes.
# Returns the updated nodes list.
tmpl-process-var-piece: [fn [let piece nodes]
  [tmpl-process-var-split piece nodes [length piece]]]

tmpl-process-var-split: [fn [let piece nodes len]
  [tmpl-process-var-emit piece nodes [tmpl-var-len piece len 0] len]]

tmpl-process-var-emit: [fn [let piece nodes var-end len]
  [tmpl-append-suffix
    [append nodes [tmpl-var-node [str-slice piece 0 var-end]]]
    [str-slice piece var-end len]]]

# Accumulator step function for building the tmpl args node list.
# acc = {nodes: [...], skip: false, is-first: true}
#   nodes    — accumulated list of AST nodes
#   skip     — true after a $$ escape; the next piece is a literal continuation, not a var
#   is-first — true for the first piece (always a literal prefix, not preceded by "$")
#
# Returns the updated accumulator.
tmpl-reduce-step: [fn [let args] [fn [let acc piece]
  [if acc.is-first
    # First piece: always a literal prefix (may be empty — skip if so)
    [tmpl-step-literal acc piece]
    [if acc.skip
      # This piece is the literal continuation after a $$ escape (not a var name).
      [tmpl-step-literal acc piece]
      [if [= piece ""]
        # Empty piece = $$ escape: emit literal "$" and mark next piece as skip.
        [nodes: [append acc.nodes [tmpl-str-node "$"]]  skip: true  is-first: false]
        [if [starts-with? piece "{"]
          # ${N} expression placeholder
          [nodes: [tmpl-process-expr-piece piece args acc.nodes]  skip: false  is-first: false]
          # $name variable reference
          [nodes: [tmpl-process-var-piece piece acc.nodes]  skip: false  is-first: false]
        ]
      ]
    ]
  ]
]]

# Append piece as a literal to acc.nodes (empty string → skip).
# Returns a new accumulator with is-first=false and skip=false.
tmpl-step-literal: [fn [let acc piece]
  [nodes: [if [= piece ""] acc.nodes [append acc.nodes [tmpl-str-node piece]]]
   skip: false
   is-first: false]]

# Split template string on "$" and fold pieces into AST arg nodes.
tmpl-expand: [fn [let template-str args]
  [tmpl-emit-call
    [reduce
      [tmpl-reduce-step args]
      [nodes: []  skip: false  is-first: true]
      [split "$" template-str]]]]

# Wrap the collected AST nodes in a [str ...] call AST Variant.
tmpl-emit-call: [fn [let result]
  [builtin-variant "Call" [fn: [builtin-variant "VarRef" [name: "str"]]  args: result.nodes  named-args: []  implied: true]]]

]

# ============================================================================
# [do] macro helpers — AST node builders for monadic do-notation desugaring
# ============================================================================
#
# These helpers build AST dict nodes without ever accessing runtime values.
# All arena-crossing is avoided: we only construct dicts with string/bool
# literals and the AST dicts passed in as macro arguments.
#
# AST node schemas (from src/ast_dict.rs):
#   var-node:        {type: "var",        name: <str>}
#   literal-str:     {type: "literal",    kind: "str", value: <str>, bare: false}
#   dot-access-node: {type: "dot-access", target: <ast>, field: <str>}
#   call-node:       {type: "call",       fn: <ast>, args: <list>, named-args: {}, implied: true}
#   fn-node:         {type: "fn",         params: <list>, body: <ast>, return-ann: {}, desugared: false}
#   param-node:      {name: <str>,        annotation: {}, variadic: false}
#   list (0-elem):   {}
#   list (1-elem):   {0: <item>}
#   list (2-elem):   {0: <item0>, 1: <item1>}

[

# Build a var-reference AST Variant node.
# Uses p-name (not 'name') to avoid letrec key-shadowing: [name: name] would
# create a circular dependency where the dict's own 'name' key tries to reference itself.
# This is the same pattern used in do-params-1 with 'p-name'.
do-var-node: [fn [let p-name]
  [builtin-variant "VarRef" [name: p-name]]]

# Build a single-param list (integer-keyed dict with one entry).
# Uses p-name (not 'name') to avoid letrec key-shadowing: [name: name] would
# shadow the outer 'name' binding with the dict's own letrec 'name' thunk.
do-params-1: [fn [let p-name]
  [0: [name: p-name  annotation: []  variadic: false]]]

# Build a fn AST Variant node: [fn [param-name] body].
# Uses p-name/p-body to avoid letrec key-shadowing of 'params'/'body' keys.
do-fn-node: [fn [let p-name p-body]
  [builtin-variant "Fn" [params: [do-params-1 p-name]  body: p-body  return-ann: []  desugared: false]]]

# Build a dot-access AST Variant node: target.field
# Uses p-target/p-field to avoid letrec key-shadowing of 'target'/'field' keys.
do-access-node: [fn [let p-target p-field]
  [builtin-variant "DotAccess" [target: p-target  field: p-field]]]

# Build a 1-element list (integer-keyed dict).
do-list-1: [fn [let a]
  [0: a]]

# Build a 2-element list (integer-keyed dict).
do-list-2: [fn [let a b]
  [0: a  1: b]]

# Build a call AST Variant node with exactly one positional arg.
do-call-1: [fn [let p-func arg0]
  [builtin-variant "Call" [fn: p-func  args: [do-list-1 arg0]  named-args: []  implied: true]]]

# Build a call AST Variant node with exactly two positional args.
do-call-2: [fn [let func arg0 arg1]
  [builtin-variant "Call" [fn: func  args: [do-list-2 arg0 arg1]  named-args: []  implied: true]]]

# Build an empty dict AST Variant node (represents [] — the unit value for pure).
do-empty-dict-node: [fn [let]
  [builtin-variant "Dict" [entries: []]]]

# Check if a step AST is a binding step (a dict literal with at least one entry).
# A binding step was written as [name: expr] in the do-block.
# Its quoted AST has variant tag "Dict".
do-is-binding: [fn [let step]
  [= [tag-of step] "Dict"]]

# Check if the first arg looks like an inferred-form step rather than an explicit monad.
# Explicit monad args are usually VarRef or DotAccess.
# Inferred form: the first arg is a binding dict or any other expression.
# Returns true if this is the inferred form (no explicit monad given).
do-is-inferred-form: [fn [let first-arg]
  # Explicit monad types: VarRef and DotAccess
  # Everything else is inferred form
  [if [= [tag-of first-arg] "VarRef"]
    false
    [if [= [tag-of first-arg] "DotAccess"]
      false
      true]]]

# Extract the binding name from a binding step.
# step is now a Variant("Dict", {entries: [...]}) where the payload is auto-unpacked by [get ...].
# step.entries[0].key is the key expr: Variant("Literal", {kind: "str", value: "name", bare: true})
# We read the "value" field of that key literal to get the string name.
do-binding-name: [fn [let step]
  [get "value" [get "key" [get 0 [get "entries" step]]]]]

# Extract the bound expression AST from a binding step.
# step.entries[0].value is the value expr.
do-binding-expr: [fn [let step]
  [get "value" [get 0 [get "entries" step]]]]

# Wrap a single step and the desugared inner expression into a bind call:
#   binding [x: expr]: [monad.bind expr [fn [x] inner]]
#   non-binding expr:  [monad.bind expr [fn [_] inner]]
do-wrap: [fn [let monad-ast step inner]
  [if [do-is-binding step]
    [do-call-2
      [do-access-node monad-ast "bind"]
      [do-binding-expr step]
      [do-fn-node [do-binding-name step] inner]]
    [do-call-2
      [do-access-node monad-ast "bind"]
      step
      [do-fn-node "_" inner]]]]

# Recursively desugar steps (a Dict of AST nodes with integer keys 0..n-1) into nested bind calls.
# Base case: single step remaining — return it as-is.
# Recursive case: wrap first step around the desugaring of the rest.
do-fold: [fn [let monad-ast steps]
  [n: [length steps]]
  [if [= n 1]
    [get 0 steps]
    [do-wrap monad-ast [get 0 steps] [do-fold monad-ast [reindex [slice steps 1 n]]]]]]

# Desugar the inferred [do] form: emit bind chain with %do-infer sentinel monad.
# Called when the first arg is NOT a monad (it's a binding step or other expression).
# All args are steps (passed as a Seq). The type checker detects %do-infer,
# resolves the monad, and wires it to eval.
# Returns: [%do-infer.bind step0 [fn [name] [%do-infer.bind step1 [...]]]] or
#          [%do-infer.bind step0 [fn [name] last-step]] for a 2-step do block.
do-desugar-inferred: [fn [let steps]
  [sentinel: [do-var-node "%do-infer"]]
  [do-fold sentinel steps]]

# ============================================================================
# [fn] / [class] / [type] let-softening helpers
# ============================================================================
#
# These helpers support the fn, class, and type macros which normalize
# "bare" param lists ([x y]) to explicit [let x y] LetDecl form.
#
# Key naming: all function params are prefixed with p- to avoid letrec
# key-shadowing when the param name matches a key in the output AST dict.
# For example, [builtin-variant "Fn" [params: ...]] uses p-params (not params)
# for the macro arg, since "params" is a key in the Fn Variant payload.
#
# All helpers are defined here (private dict) so they run in the stdlib
# context, avoiding the arena-crossing circular-dependency issue that arises
# when macro body thunks reference user-code arena thunks.

# Convert a single binding AST Variant to a param dict {name, annotation, variadic}.
# Used by fn-binding-to-param, which is mapped over the flat bindings list.
fn-binding-to-param: [fn [let p-b]
  [match [tag-of p-b]
    # VarRef: plain parameter like x
    "VarRef":    [name: [get "name" p-b]  annotation: []  variadic: false]
    # Annotated: typed parameter like x@Int
    "Annotated": [name: [get "name" p-b]  annotation: [get "annotation" p-b]  variadic: false]
    # Rest: variadic parameter like ...rest
    "Rest":      [name: [get "name" p-b]  annotation: []  variadic: true]
    # Unknown binding form — emit placeholder name
    _:           [name: "???"             annotation: []  variadic: false]]]

# Flatten a params expression to a list of binding Variants.
# Handles all param forms the parser can produce:
#   LetDecl — extract bindings directly
#   Call    — prepend fn to args ([x y z] → [x, y, z])
#   Dict    — extract entry values (annotation dict forms)
#   VarRef  — single-param: wrap in singleton list
#   other   — wrap in singleton list
fn-flatten-params: [fn [let p-params]
  [match [tag-of p-params]
    "LetDecl": [get "bindings" p-params]
    "Call":    [concat [0: [get "fn" p-params]] [get "args" p-params]]
    "Dict":    [map [fn [let p-e] [get "value" p-e]] [get "entries" p-params]]
    "VarRef":  [0: p-params]
    _:         [0: p-params]]]

]

# ============================================================================
# Public macro transformer exports
# ============================================================================
#
# These are registered by expand_macros via register_stdlib_macros_from_env.
# Each function receives individually-quoted AST Variant nodes as separate positional
# arguments. Variadic parameters collect remaining args into a Seq.

[

# tmpl macro transformer: string interpolation i"...$var..." syntax
tmpl: [fn [let template ...parts]
  # template = AST Variant for the template string literal
  # parts = Seq of AST Variants for ${N} expression placeholders (if any)
  # Build a new args dict: {0: template, 1: parts[0], 2: parts[1], ...}
  # for compatibility with existing tmpl-expand implementation
  [args-dict: [reduce
    [fn [let acc i] [set acc [+ i 1] [get i parts]]]
    [0: template]
    [range 0 [length parts]]]]
  [tmpl-expand
    [get "value" template]
    args-dict]]

# do macro transformer: monadic do-notation desugaring.
#
# Syntax: [do monad step1 step2 ... final]
#   monad — a var reference or any expression that evaluates to a monad dict
#   steps — zero or more binding steps [name: expr] or expression steps expr
#   final — the last expression (returned from the do block)
#
# Desugaring (right-fold over steps):
#   [do m [x: e1] [y: e2] e3]
#   → [m.bind e1 [fn [x] [m.bind e2 [fn [y] e3]]]]
#
# The macro operates entirely at the AST level: it never accesses the runtime
# monad dict. The dot-access (m.bind, m.pure) is generated as an AST node and
# resolved at evaluation time. This avoids any arena-crossing ThunkId issues.
do: [fn [let first ...rest]
  # first = first AST arg (Variant node)
  # rest = Seq of remaining AST args (Variant nodes)
  # Convert rest Seq to Dict for easier processing
  [rest-dict: [collect rest]]
  # Check if first is an inferred-form step (dict binding or other non-monad expression)
  # vs an explicit monad argument (var reference).
  # Explicit monad: [tag-of first] == "VarRef" or "DotAccess"
  # Inferred form: [tag-of first] == "Dict" (binding step) or anything else
  [if [do-is-inferred-form first]
    # Inferred [do] form: ALL args are steps (prepend first to rest-dict).
    # Build steps Dict: cons first onto rest-dict, then call do-desugar-inferred
    [
      steps: [cons first rest-dict]
      result: [do-desugar-inferred steps]
    ].result
    # Explicit monad case: first is monad, rest-dict are steps
    [if [= [length rest-dict] 0]
      # [do monad] with no steps → [monad.pure []]
      [do-call-1
        [do-access-node first "pure"]
        [do-empty-dict-node]]
      # [do monad step1 ... final] → nested bind calls
      # Pass rest-dict (Dict) to do-fold
      [do-fold first rest-dict]]]]

# begin macro transformer: sequential expression grouping
begin: [fn [let ...exprs]
  # [begin e1 e2 ...] → Variant("Sequential", {exprs: [e1, e2, ...]})
  # collect converts the variadic Seq to an integer-keyed Dict for AST field access
  [builtin-variant "Sequential" [exprs: [collect exprs]]]]

# ============================================================================
# fn / class / type let-softening macro transformers
# ============================================================================
#
# These macros normalize bare param lists in programmatic (macro-output) contexts.
# The parser already handles both [fn [x y] body] and [fn [let x y] body] for
# source code. These macros intercept Call(VarRef("fn"), ...) nodes produced by
# other macros and normalize the params expression.
#
# Registered globally (like tmpl/do/begin) so they are always available without
# an explicit include.

# fn macro transformer: let-soften function parameter lists.
# Receives p-params (quoted params expr) and macro-body (quoted body expr).
# Returns an Fn Variant with proper param dicts and the given body.
#
# Uses helper functions fn-flatten-params and fn-binding-to-param (defined in
# the private dict above) to avoid arena-crossing thunk cycles.
syntax-fn: [fn [let p-params macro-body]
  [builtin-variant "Fn" [
    params: [map fn-binding-to-param [fn-flatten-params p-params]]
    body: macro-body
    return-ann: []
    desugared: false]]]

# class macro transformer: let-soften type class tvar declarations.
# Receives tvars (quoted tvars expr).
# If already a LetDecl, returns unchanged. Otherwise wraps in LetDecl.
syntax-class: [fn [let tvars]
  [if [= [tag-of tvars] "LetDecl"]
    tvars
    [builtin-variant "LetDecl" [
      bindings: [fn-flatten-params tvars]]]]]

# type macro transformer: let-soften type alias parameter declarations.
# Receives p-params (quoted params expr) and p-body (quoted body expr).
# Extracts param name strings and returns a TypeAlias Variant.
syntax-type: [fn [let p-params p-body]
  [builtin-variant "TypeAlias" [
    params: [map [fn [let p-b] [get "name" p-b]] [fn-flatten-params p-params]]
    expr: p-body]]]

]
