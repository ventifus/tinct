# builtin_async.llt — Async, concurrency, and channel primitive operations.
# Bodies are Placeholder — valid tinct, errors if forced (builtins are Rust-side).
# Task, Channel, Context, ReactiveCell declared in builtin_core.llt.

[
  # ── Task lifecycle ─────────────────────────────────────────────────────────
  builtin-task:            [fn@Task    [let body@Callable] ...]
  builtin-await:           [fn@Any     [let t@Task] ...]
  builtin-par:             [fn@Any     [let a@Callable b@Callable] ...]
  builtin-exit-now:        [fn@Never   [let code@Integer] ...]
  builtin-non-cancellable: [fn@Context  [let body@Callable] ...]

  # ── Channels ───────────────────────────────────────────────────────────────
  # builtin-channel and builtin-send are core primitives — declared in builtin_core.llt.
  builtin-recv:             [fn@Any    [let ch@Channel] ...]
  builtin-try-send:         [fn@Any    [let ch@Channel val@Any] ...]
  builtin-drain:            [fn@Dict   [let ch@Channel] ...]
  builtin-broadcast-channel: [fn@Channel [let n@Integer] ...]
  builtin-oneshot-channel:  [fn@Dict  [] ...]
  builtin-signal-channel:   [fn@Any   [let signals@Dict] ...]
  builtin-timer-channel:    [fn@Any   [let clk@ClockCap interval@Integer] ...]
  builtin-watch-channel:    [fn@Channel [let cap@DirCap path@String] ...]
  builtin-try-recv:         [fn@Dict  [let ch@Channel] ...]
  builtin-try-recv-broadcast: [fn@Dict [let ch@Channel] ...]
  builtin-try-recv-oneshot: [fn@Dict  [let ch@Channel] ...]
  builtin-yield:            [fn@Dict  [let] ...]

  # ── Context and cancellation ───────────────────────────────────────────────
  builtin-context:          [fn@Context [] ...]
  builtin-with-cancel:      [fn@Context [let ctx@Context] ...]
  builtin-with-timeout:     [fn@Any   [let clk@ClockCap ctx@Context dur@Integer] ...]
  builtin-with-deadline:    [fn@Any   [let clk@ClockCap ctx@Context deadline@Integer] ...]
  builtin-with-context:     [fn@Any   [let ctx@Context body@Callable] ...]
  builtin-cancel-task:      [fn@Any   [let ctx@Context] ...]
  builtin-cancel-root:      [fn@Any   [] ...]

  # ── Reactive cells ─────────────────────────────────────────────────────────
  builtin-reactive-cell:    [fn@ReactiveCell [let init@Any] ...]
  builtin-cell-get:         [fn@Any   [let cell@ReactiveCell] ...]
  builtin-cell-set:         [fn@Any   [let val@Any cell@ReactiveCell] ...]

  # ── Cancellation check ─────────────────────────────────────────────────────
  builtin-cancelled-q:      [fn@Integer [let ctx@Context] ...]
]
