# ============================================================================
# Numeric Type Aliases (stdlib/numeric.llt)
# ============================================================================
#
# Named width type aliases with range constraints via `is:` predicates.
# These define fixed-width integer types using the `between` predicate
# from the prelude. Values annotated with these types are range-checked
# at runtime via TypeAssert `is:` predicate evaluation.
#
# Usage:
#   [include libdir "numeric.llt"]
#   port@UInt16: 8080
#   offset@Int8: -42
#
# ============================================================================

[

# Unsigned integer types
UInt8@[doc: "Unsigned 8-bit integer (0-255)"]:  [type Int@[is: [between 0 255]]]
UInt16@[doc: "Unsigned 16-bit integer (0-65535)"]: [type Int@[is: [between 0 65535]]]
UInt32@[doc: "Unsigned 32-bit integer (0-4294967295)"]: [type Int@[is: [between 0 4294967295]]]
UInt64@[doc: "Unsigned 64-bit integer (>= 0)"]: [type Int]

# Signed integer types
Int8@[doc: "Signed 8-bit integer (-128 to 127)"]:  [type Int@[is: [between -128 127]]]
Int16@[doc: "Signed 16-bit integer (-32768 to 32767)"]: [type Int@[is: [between -32768 32767]]]
Int32@[doc: "Signed 32-bit integer (-2147483648 to 2147483647)"]: [type Int@[is: [between -2147483648 2147483647]]]
Int64@[doc: "64-bit signed integer (alias for Int)"]: [type Int]

# Binary serialization dispatch based on repr: annotation.
# to-bytes converts a numeric value to its string representation.
# The repr: annotation is a storage hint that guides serialization format
# in downstream binary encoders. This stub returns the string form.
# Usage: [to-bytes v] where v has a repr: annotation.
to-bytes@[doc: "Convert a numeric value to its string representation"]: [fn@String [let v] [str v]]

]
