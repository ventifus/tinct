# ============================================================================
# LLT gRPC Wire Protocol Helpers (stdlib/protocols/grpc.llt)
# ============================================================================
#
# Pure-tinct gRPC Length-Prefixed Message (LPM) frame encoding and decoding.
# All functions operate on strings treated as byte sequences —
# no Handle I/O primitives required.
#
# gRPC LPM frame layout (gRPC over HTTP/2, §5):
#
#   Byte 0:   Compressed-Flag (0 = uncompressed, 1 = compressed)
#   Bytes 1-4: Message-Length (big-endian 32-bit unsigned integer)
#   Bytes 5+:  Message (the serialized protobuf payload)
#
# The 5-byte header is called the "Length-Prefixed Message" header.
# Callers supply the serialized protobuf bytes as a plain String.
#
# Dependencies (Rust builtins):
#   str, str-slice, length, char-code, chr
#   builtin-add, builtin-sub, builtin-mul
#   builtin-lt, builtin-eq, builtin-if
#   set
#
# Self-contained — does not require prelude or encoding.llt.
#
# Two-dict document: private helpers in dict 1, public API in dict 2.
# All intermediate values are passed as function arguments (no [name: val]
# let-bindings that would create dict pollution in return values).
# ============================================================================

# ============================================================================
# Private helpers (not exported)
# ============================================================================

[

# --------------------------------------------------------------------------
# Integer arithmetic helpers (self-contained copies of quot, mod)
# --------------------------------------------------------------------------

grpc-quot: [fn@Int [let a@Int b@Int]
    [builtin-if [builtin-eq b 0]
        [error "grpc-quot: division by zero"]
        [grpc-quot-impl a b]]]

grpc-quot-impl: [fn@Int [let a@Int b@Int]
    [builtin-if [builtin-lt a 0]
        [error "grpc-quot: negative dividend not supported"]
        [builtin-if [builtin-lt a b]
            0
            [builtin-add 1 [grpc-quot-impl [builtin-sub a b] b]]]]]

grpc-mod: [fn@Int [let a@Int b@Int]
    [builtin-sub a [builtin-mul [grpc-quot a b] b]]]

# --------------------------------------------------------------------------
# 32-bit big-endian encoding / decoding
# --------------------------------------------------------------------------

# Encode a 32-bit unsigned integer as 4 big-endian bytes.
# n must be in range 0..4294967295 (unchecked for performance).
grpc-encode-u32-be: [fn@String [let n@Int]
    [str
        [chr [grpc-quot  n 16777216]]
        [chr [grpc-mod   [grpc-quot n 65536]   256]]
        [chr [grpc-mod   [grpc-quot n 256]     256]]
        [chr [grpc-mod   n                     256]]]]

# Decode a 4-byte big-endian string slice back to an integer.
# Reads exactly 4 bytes starting at `offset` in `bytes`.
grpc-decode-u32-be: [fn@Int [let bytes@String offset@Int]
    [builtin-add
        [builtin-mul
            [builtin-add
                [builtin-mul
                    [builtin-add
                        [builtin-mul
                            [char-code [str-slice bytes
                                offset
                                [builtin-add offset 1]]]
                            256]
                        [char-code [str-slice bytes
                            [builtin-add offset 1]
                            [builtin-add offset 2]]]]
                    256]
                [char-code [str-slice bytes
                    [builtin-add offset 2]
                    [builtin-add offset 3]]]]
            256]
        [char-code [str-slice bytes
            [builtin-add offset 3]
            [builtin-add offset 4]]]]]

]

# ============================================================================
# Public API
# ============================================================================

[

# Frame header length (always 5 bytes).
GRPC-HEADER-LEN: 5

# Build a gRPC Length-Prefixed Message frame.
#
# Parameters:
#   data       — serialized protobuf payload as a String
#   compressed — Bool: true = set Compressed-Flag to 1 (compressed payload)
#
# Returns a String (byte sequence):
#   Compressed-Flag(1) + Message-Length(4, big-endian) + Message(N)
#
# The returned string is ready to write as a gRPC data frame body
# (i.e., as the DATA frame payload over HTTP/2).
#
# Type: (String -> Bool -> String)
build-grpc-frame@[doc: "Build a gRPC Length-Prefixed Message frame"]:
    [fn@String [let data@String compressed@Bool]
        [str
            [chr [builtin-if compressed 1 0]]
            [grpc-encode-u32-be [length data]]
            data]]

# Parse a gRPC Length-Prefixed Message frame header.
#
# Parameters:
#   bytes — raw bytes as a String (must be at least 5 bytes)
#
# Returns a dict on success:
#   [compressed:  Bool   — true if Compressed-Flag is 1
#    length:      Int    — message body length in bytes
#    header-len:  Int    — always 5; body starts at this offset]
#
# Returns an error dict on malformed input:
#   [err: String]
#
# Type: (String -> Dict)
parse-grpc-frame-header@[doc: "Parse gRPC Length-Prefixed Message header"]:
    [fn@Dict [let bytes@String]
        [builtin-if [builtin-lt [length bytes] GRPC-HEADER-LEN]
            [set [] "err" [str
                "parse-grpc-frame-header: need at least 5 bytes, got "
                [length bytes]]]
            [set [set [set []
                "compressed" [builtin-eq
                    [char-code [str-slice bytes 0 1]]
                    1]]
                "length"     [grpc-decode-u32-be bytes 1]]
                "header-len" GRPC-HEADER-LEN]]]

]
