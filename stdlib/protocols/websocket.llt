# ============================================================================
# LLT WebSocket Protocol Helpers (stdlib/protocols/websocket.llt)
# ============================================================================
#
# Pure-tinct WebSocket frame encoding/decoding helpers (RFC 6455).
# These functions operate on strings treated as byte sequences —
# no Handle I/O primitives required.
#
# WebSocket frame layout (RFC 6455 §5.2):
#
#   Byte 0:   FIN(1) + RSV1-3(3) + Opcode(4)
#   Byte 1:   MASK(1) + Payload-Len(7)
#   Bytes 2-3: Extended payload length (if Payload-Len == 126)
#   Bytes 2-9: Extended payload length (if Payload-Len == 127)
#   Bytes N..N+3: Masking key (if MASK=1; client→server always masked)
#   Remaining:  (Masked) payload data
#
# Opcodes (RFC 6455 §11.8):
#   0x0  Continuation
#   0x1  Text
#   0x2  Binary
#   0x8  Close
#   0x9  Ping
#   0xA  Pong
#
# Dependencies (all via prelude wrappers):
#   str, str-slice, length
#   char-code, chr
#   +, -, *
#   <, =, if
#   set
#
# All primitive operations use prelude-exported names per builtin-privacy design.
# Relies on the parent scope (normally the prelude) for: length, set, str, error.
#
# Two-dict document: private helpers in dict 1, public API in dict 2.
# All intermediate values are passed as function arguments (no [name: val]
# let-bindings that would create dict pollution in return values).
# ============================================================================

# ============================================================================
# Private helpers (not exported)
# ============================================================================

[

# --------------------------------------------------------------------------
# Integer arithmetic helpers (self-contained copies of quot, mod, pow2)
# --------------------------------------------------------------------------

ws-quot: [fn@Integer [let a@Integer b@Integer]
    [if [= b 0]
        [error "ws-quot: division by zero"]
        [ws-quot-impl a b]]]

ws-quot-impl: [fn@Integer [let a@Integer b@Integer]
    [if [< a 0]
        [error "ws-quot: negative dividend not supported"]
        [if [< a b]
            0
            [+ 1 [ws-quot-impl [- a b] b]]]]]

ws-mod: [fn@Integer [let a@Integer b@Integer]
    [- a [* [ws-quot a b] b]]]

ws-pow2: [fn@Integer [let n@Integer]
    [ws-pow2-impl n 1]]

ws-pow2-impl: [fn@Integer [let n@Integer acc@Integer]
    [if [< 0 n]
        [ws-pow2-impl [- n 1] [* acc 2]]
        acc]]

# --------------------------------------------------------------------------
# Bitwise XOR (byte-level, pure LLT)
# --------------------------------------------------------------------------

ws-xor-bit: [fn@Integer [let a@Integer b@Integer]
    [if [= a b] 0 1]]

ws-xor: [fn@Integer [let a@Integer b@Integer]
    [ws-xor-impl a b 0 0]]

ws-xor-impl: [fn@Integer [let a@Integer b@Integer acc@Integer bit@Integer]
    [if [< bit 8]
        [ws-xor-impl a b
            [+ acc
                [*
                    [ws-xor-bit
                        [ws-mod [ws-quot a [ws-pow2 bit]] 2]
                        [ws-mod [ws-quot b [ws-pow2 bit]] 2]]
                    [ws-pow2 bit]]]
            [+ bit 1]]
        acc]]

# --------------------------------------------------------------------------
# Frame encoding helpers
# --------------------------------------------------------------------------

# Mask a payload string with a 4-byte repeating XOR mask.
ws-mask-payload-impl: [fn@String [let data@String mask-key@String i@Integer len@Integer acc@String]
    [if [< i len]
        [ws-mask-payload-impl data mask-key [+ i 1] len
            [str acc
                [chr [ws-xor
                    [char-code [str-slice data i [+ i 1]]]
                    [char-code [str-slice mask-key [ws-mod i 4] [+ [ws-mod i 4] 1]]]]]]]]
        acc]]

# Build the 2-byte base frame header.
# byte0 = FIN(0x80) | opcode; byte1 = MASK(0x80) | payload-len (for len < 126)
ws-build-base-header: [fn@String [let opcode@Integer payload-len@Integer masked@Boolean]
    [str
        [chr [+ 128 opcode]]
        [chr [if masked
            [+ 128 payload-len]
            payload-len]]]]

# Build a 2-byte big-endian 16-bit extended length field.
ws-build-ext16: [fn@String [let n@Integer]
    [str [chr [ws-quot n 256]] [chr [ws-mod n 256]]]]

# Build an 8-byte big-endian 64-bit extended length field (RFC 6455 §5.2).
# The most significant bit MUST be 0 (n < 2^63).
ws-build-ext64: [fn@String [let n@Integer]
    [ws-build-ext64-impl n 7 ""]]

# Recursive helper: accumulates bytes left-to-right (MSB to LSB) by threading
# 'remaining' down. At each step the current byte = remaining / 256^level and
# new remaining = old remaining mod 256^level. level counts down from 7 to 0;
# at level=0 'remaining' is already 0-255 so we take it directly (no division).
#
# This avoids the O(n) repeated-subtraction trap: ws-quot remaining shift where
# shift = 2^(8*level) converges in at most (remaining / shift) steps, which for
# large levels is 0 steps (byte is 0) and for level=1 is at most 255 steps.
ws-build-ext64-impl: [fn@String [let remaining@Integer level@Integer acc@String]
    [if [= level 0]
        [str acc [chr remaining]]
        [ws-build-ext64-impl
            [ws-mod remaining [ws-pow2 [* level 8]]]
            [- level 1]
            [str acc [chr [ws-quot remaining [ws-pow2 [* level 8]]]]]]]]

# Dispatch on payload length to choose header format.
ws-build-frame-dispatch: [fn@Dict [let opcode@Integer data@String mask-key@String data-len@Integer]
    [if [< data-len 126]
        [ws-build-frame-short  opcode data mask-key data-len]
        [if [< data-len 65536]
            [ws-build-frame-medium opcode data mask-key data-len]
            [ws-build-frame-long opcode data mask-key data-len]]]]

# Build a short-payload frame (payload-len < 126).
# header = base-header(2 bytes) + mask-key(4 bytes)
ws-build-frame-short: [fn@Dict [let opcode@Integer data@String mask-key@String data-len@Integer]
    [ws-build-frame-result
        [str [ws-build-base-header opcode data-len true] mask-key]
        [ws-mask-payload-impl data mask-key 0 data-len ""]]]

# Build a medium-payload frame (126 <= payload-len < 65536).
# header = base-header(2 bytes) + ext16(2 bytes) + mask-key(4 bytes)
ws-build-frame-medium: [fn@Dict [let opcode@Integer data@String mask-key@String data-len@Integer]
    [ws-build-frame-result
        [str [ws-build-base-header opcode 126 true] [ws-build-ext16 data-len] mask-key]
        [ws-mask-payload-impl data mask-key 0 data-len ""]]]

# Build a long-payload frame (payload-len >= 65536).
# header = base-header(2 bytes) + ext64(8 bytes) + mask-key(4 bytes)
ws-build-frame-long: [fn@Dict [let opcode@Integer data@String mask-key@String data-len@Integer]
    [ws-build-frame-result
        [str [ws-build-base-header opcode 127 true] [ws-build-ext64 data-len] mask-key]
        [ws-mask-payload-impl data mask-key 0 data-len ""]]]

# Assemble the result dict from header and payload strings.
ws-build-frame-result: [fn@Dict [let header@String payload@String]
    [set []
        header:  header
        payload: payload
        frame:   [str header payload]]]

# --------------------------------------------------------------------------
# Frame parsing helpers
# --------------------------------------------------------------------------

ws-payload-len7: [fn@Integer [let byte1@Integer]
    [ws-mod byte1 128]]

ws-parse-ext16: [fn@Integer [let hi@Integer lo@Integer]
    [+ [* hi 256] lo]]

ws-parse-ext64-impl: [fn@Integer [let bytes@String start@Integer i@Integer acc@Integer]
    [if [< i 8]
        [ws-parse-ext64-impl bytes start [+ i 1]
            [+ [* acc 256]
                [char-code [str-slice
                    bytes
                    [+ start i]
                    [+ start [+ i 1]]]]]]
        acc]]

# Build the header result dict from fully-computed fields.
ws-parse-header-result: [fn@Dict [let fin rsv opcode@Integer masked payload-len@Integer header-len@Integer]
    [set []
        fin:         fin
        rsv:         rsv
        opcode:      opcode
        masked:      masked
        payload-len: payload-len
        header-len:  header-len]]

# Dispatch on len7 to handle normal / 16-bit / 64-bit payload lengths.
ws-parse-header-extended: [fn@Dict [let bytes@String fin rsv opcode@Integer masked len7@Integer]
    [if [= len7 126]
        [if [< [length bytes] 4]
            [error "parse-ws-frame-header: too short for 16-bit extended length"]
            [ws-parse-header-result fin rsv opcode masked
                [ws-parse-ext16
                    [char-code [str-slice bytes 2 3]]
                    [char-code [str-slice bytes 3 4]]]
                [if masked 8 4]]]
        [if [= len7 127]
            [if [< [length bytes] 10]
                [error "parse-ws-frame-header: too short for 64-bit extended length"]
                [ws-parse-header-result fin rsv opcode masked
                    [ws-parse-ext64-impl bytes 2 0 0]
                    [if masked 14 10]]]
            [ws-parse-header-result fin rsv opcode masked len7
                [if masked 6 2]]]]]

# Decode byte0/byte1 fields and pass computed values to ws-parse-header-extended.
ws-parse-header-bytes: [fn@Dict [let bytes@String byte0@Integer byte1@Integer]
    [ws-parse-header-bytes-step bytes byte0 byte1
        [= [ws-mod [ws-quot byte0 128] 2] 1]
        [ws-mod [ws-quot byte0 16] 8]
        [ws-mod byte0 16]
        [= [ws-mod [ws-quot byte1 128] 2] 1]
        [ws-payload-len7 byte1]]]

ws-parse-header-bytes-step: [fn@Dict [let bytes@String byte0@Integer byte1@Integer fin rsv opcode@Integer masked len7@Integer]
    [ws-parse-header-extended bytes fin rsv opcode masked len7]]

]

# ============================================================================
# Public API
# ============================================================================

[

# Opcode constants (RFC 6455 §11.8)
Continuation: 0
Text:         1
Binary:       2
Close:        8
Ping:         9
Pong:         10

# Build a WebSocket frame (client-to-server, always masked per RFC 6455 §5.3).
#
# Parameters:
#   opcode   — one of the Opcode constants above
#   data     — payload string
#   mask-key — exactly 4-character string used as the masking key bytes
#
# Returns a dict:
#   [header:  <header bytes as String>
#    payload: <masked payload as String>
#    frame:   <full frame = header + payload as String>]
#
# Supports all payload sizes via 7-bit (<126), 16-bit (126-65535), and 64-bit (>=65536) encodings.
# Type: (Int -> String -> String -> Dict)
build-ws-frame@[doc: "Build a masked WebSocket frame (client→server, RFC 6455)"]:
    [fn@Dict [let opcode@Integer data@String mask-key@String]
        [if [= [length mask-key] 4]
            [ws-build-frame-dispatch opcode data mask-key [length data]]
            [error "build-ws-frame: mask-key must be exactly 4 bytes"]]]

# Parse a WebSocket frame header from a byte string.
#
# Parameters:
#   bytes — raw frame bytes as a String (at least 2 bytes required)
#
# Returns a dict:
#   [fin:          Bool   — FIN bit set (final fragment)
#    rsv:          Int    — RSV1-3 bits (0 for standard frames)
#    opcode:       Int    — frame opcode (see Opcode constants above)
#    masked:       Bool   — MASK bit set
#    payload-len:  Int    — payload byte count
#    header-len:   Int    — total header size; payload starts at this offset]
#
# Type: (String -> Dict)
parse-ws-frame-header@[doc: "Parse WebSocket frame header bytes (RFC 6455)"]:
    [fn@Dict [let bytes@String]
        [if [< [length bytes] 2]
            [error "parse-ws-frame-header: need at least 2 bytes"]
            [ws-parse-header-bytes bytes
                [char-code [str-slice bytes 0 1]]
                [char-code [str-slice bytes 1 2]]]]]

# Build an HTTP/1.1 WebSocket upgrade request string.
#
# Parameters:
#   host — target hostname (e.g., "echo.websocket.org")
#   path — request path (e.g., "/")
#   key  — base64-encoded 16-byte nonce (Sec-WebSocket-Key header value)
#
# Returns the raw HTTP/1.1 request string ready to send over TCP.
# Type: (String -> String -> String -> String)
build-ws-handshake@[doc: "Build HTTP/1.1 WebSocket upgrade request (RFC 6455 §4.1)"]:
    [fn@String [let host@String path@String key@String]
        [str
            "GET " path " HTTP/1.1\r\n"
            "Host: " host "\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            "Sec-WebSocket-Version: 13\r\n"
            "Sec-WebSocket-Key: " key "\r\n"
            "\r\n"]]

]
