# ============================================================================
# LLT String Utilities (stdlib/strings.llt)
# ============================================================================
#
# Pure-tinct string manipulation functions that build on Rust-native builtins.
#
# Available Rust builtins used here:
#   String:      str, split, str-slice, str-contains?, length
#   Arithmetic:  builtin-add, builtin-sub, builtin-mul, builtin-div
#   Comparison:  builtin-lt, builtin-eq
#   Control:     builtin-if
#   Sequences:   range
#   Dict:        keys
#
# Naming conventions:
#   str-*     String operations (e.g., str-repeat, str-reverse)
#   pad-*     Padding operations (left/right)
#
# Structure: two-expression document.  The first dict holds private -impl/-check
# helpers; the second dict holds the public API.  eval_document materialises the
# first dict and injects its string-keyed entries into scope before evaluating
# the second, so helpers are accessible by plain name from the public dict but
# are NOT exported to callers (only the second dict's entries are returned).
# ============================================================================

# Phase 2 (bootstrap env): import the Rust primitives used by this module.
# - core: builtin-if, builtin-lt, builtin-add, builtin-sub used in private helpers
# - string: str-map-chars, str-to-upper-char, str-to-lower-char, str-slice, str-length
[include %rust "core"]
[include %rust "string"]

# ============================================================================
# Private helpers (not exported)
# ============================================================================

[

str-reverse-impl: [fn@String [s@String i@Int len@Int acc@String]
    [builtin-if [builtin-lt i len]
        [str-reverse-impl s [builtin-add i 1] len [str [str-slice s i [builtin-add i 1]] acc]]
        acc]]

]

# ============================================================================
# Public API
# ============================================================================

[

# ============================================================================
# Case Conversion
# ============================================================================

# Convert a string to uppercase by mapping str-to-upper-char over each character.
# Type: (String -> String)
# Example: [upper "hello"] => "HELLO"
# Example: [upper "café"] => "CAFÉ"
upper@[doc: "Convert a string to uppercase"]: [fn@String [s@String]
    [str-map-chars [fn [c] [str-to-upper-char c]] s]]

# Convert a string to lowercase by mapping str-to-lower-char over each character.
# Type: (String -> String)
# Example: [lower "HELLO"] => "hello"
# Example: [lower "CAFÉ"] => "café"
lower@[doc: "Convert a string to lowercase"]: [fn@String [s@String]
    [str-map-chars [fn [c] [str-to-lower-char c]] s]]

# ============================================================================
# String Padding
# ============================================================================

# Left-pad a string to a target width with a padding character.
# If the string is already >= width, returns it unchanged.
# Type: (String -> Int -> String -> String)
# Example: [pad-left "hi" 5 " "] => "   hi"
# Example: [pad-left "hello" 3 " "] => "hello"
# Example: [pad-left "x" 4 "0"] => "000x"
pad-left@[doc: "Left-pad a string to a target width with a padding character"]: [fn@String [s@String width@Int pad-char@String]
    [builtin-if [builtin-lt [length s] width]
        [str [str-repeat pad-char [builtin-sub width [length s]]] s]
        s]]

# Right-pad a string to a target width with a padding character.
# If the string is already >= width, returns it unchanged.
# Type: (String -> Int -> String -> String)
# Example: [pad-right "hi" 5 " "] => "hi   "
# Example: [pad-right "hello" 3 " "] => "hello"
# Example: [pad-right "x" 4 "0"] => "x000"
pad-right@[doc: "Right-pad a string to a target width with a padding character"]: [fn@String [s@String width@Int pad-char@String]
    [builtin-if [builtin-lt [length s] width]
        [str s [str-repeat pad-char [builtin-sub width [length s]]]]
        s]]

# ============================================================================
# String Reversal
# ============================================================================

# Reverse a string by characters.
# Type: (String -> String)
# Example: [str-reverse "hello"] => "olleh"
# Example: [str-reverse ""] => ""
# Example: [str-reverse "a"] => "a"
#
# Implementation strategy:
# - Build a dict of characters by extracting single-char substrings
# - Reverse the dict using the builtin reverse function
# - Concatenate the reversed characters back into a string
str-reverse@[doc: "Reverse a string by characters"]: [fn@String [s@String]
    [str-reverse-impl s 0 [length s] ""]]

]
