# ============================================================================
# LLT String Utilities (stdlib/strings.llt)
# ============================================================================
#
# Pure-tinct string manipulation functions that build on prelude wrappers.
#
# This file is loaded via [include %libdir "strings.llt"]. The stdlib env
# (prelude output) is available as the parent scope, providing access to:
#   String:      str, str-slice (builtin, (start,end,string) semantics), str-length, replace, join
#   Arithmetic:  +, -, *, /
#   Comparison:  <, =, >=
#   Control:     if
#   Sequences:   range, reduce
#   Dict:        length, keys
#
# Do NOT add [include %rust "..."] here — strings.llt uses prelude wrappers
# only. Do NOT call builtin-* aliases directly — all builtins must go through
# prelude-exported wrappers (str, str-slice, str-length, +, <, if, etc.).
#
# Naming conventions:
#   str-*     String operations (e.g., str-at, str-length)
#   pad-*     Padding operations (left/right)
#
# str-slice is NOT exported from strings.llt. The prelude exports str-slice as
# an alias for builtin-str-slice with (start, end, string) semantics. The
# length-based form is str-substr (implemented in the public dict below).
#
# Structure: two-expression document.  The first dict holds private -impl/-check
# helpers; the second dict holds the public API.  eval_document materialises the
# first dict and injects its string-keyed entries into scope before evaluating
# the second, so helpers are accessible by plain name from the public dict but
# are NOT exported to callers (only the second dict's entries are returned).
# ============================================================================

# ============================================================================
# Private helpers (not exported)
# ============================================================================

[

# str-at-impl: extract single character at char-index `n` from string `s`.
# Uses str-slice (raw Rust primitive with (start, end, string) semantics).
# Precondition: n is already a valid non-negative character index.
str-at-impl: [fn@String [let s@String n@Int]
    [str-slice n [+ n 1] s]]

str-reverse-impl: [fn@String [let s@String i@Int len@Int acc@String]
    [if [< i len]
        [str-reverse-impl s [+ i 1] len [str [str-slice i [+ i 1] s] acc]]
        acc]]

]

# ============================================================================
# Public API
# ============================================================================

[

# ============================================================================
# Character-Level Access
# ============================================================================

# str-at: extract the character at position n (0-based).
# Negative indices count from the end: -1 is the last character, -2 second-to-last, etc.
# Returns a single-character String. Raises an error if n is out of bounds.
# Type: (Int -> String -> String)
# Example: [str-at 0 "hello"] => "h"
# Example: [str-at 4 "hello"] => "o"
# Example: [str-at -1 "hello"] => "o"
# Example: [str-at 3 "cafe"] => "e"  (multi-byte UTF-8 counts codepoints, not bytes)
str-at@[doc: "Character at position n (0-based; negative counts from end). Raises error if out of bounds."]: [fn@String [let n@Int s@String]
    [len: [str-length s]]
    [idx: [if [>= n 0] n [+ len n]]]
    [if [or [< idx 0] [>= idx len]]
        [raise [str "str-at: index " n " out of bounds for string of length " len]]
        [str-at-impl s idx]]]

# str-substr: extract a substring of length len starting at position start.
# Type: (Int -> Int -> String -> String)
# Example: [str-substr 6 5 "hello world"] => "world"
# Example: [str-substr 0 3 "hello"] => "hel"
# Example: [str-substr 2 0 "hello"] => ""
# Raises an error if start or len is negative, or if start+len exceeds string length.
str-substr@[doc: "Extract substring starting at start with length len. Raises error if bounds are invalid."]: [fn@String [let start@Int len@Int s@String]
    [str-len: [str-length s]]
    [end: [+ start len]]
    [if [< start 0]
        [raise [str "str-substr: start " start " must be >= 0"]]
        [if [< len 0]
            [raise [str "str-substr: len " len " must be >= 0"]]
            [if [> end str-len]
                [raise [str "str-substr: end position " end " exceeds string length " str-len]]
                [str-slice start end s]]]]]

# str-reverse: reverse a string (codepoint-by-codepoint).
# Type: (String -> String)
# Example: [str-reverse "hello"] => "olleh"
# Example: [str-reverse ""] => ""
# Example: [str-reverse "a"] => "a"
str-reverse@[doc: "Reverse a string codepoint-by-codepoint."]: [fn@String [let s@String]
    [str-reverse-impl s 0 [str-length s] ""]]

# ============================================================================
# Case Conversion
# ============================================================================

# Convert a string to uppercase by mapping str-to-upper-char over each character.
# Type: (String -> String)
# Example: [upper "hello"] => "HELLO"
upper@[doc: "Convert a string to uppercase"]: [fn@String [let s@String]
    [str-map-chars [fn [let c] [str-to-upper-char c]] s]]

# Convert a string to lowercase by mapping str-to-lower-char over each character.
# Type: (String -> String)
# Example: [lower "HELLO"] => "hello"
lower@[doc: "Convert a string to lowercase"]: [fn@String [let s@String]
    [str-map-chars [fn [let c] [str-to-lower-char c]] s]]

# ============================================================================
# String Padding
# ============================================================================

# Left-pad a string to a target width with a padding character.
# If the string is already >= width, returns it unchanged.
# Type: (String -> Int -> String -> String)
# Example: [pad-left "hi" 5 " "] => "   hi"
# Example: [pad-left "hello" 3 " "] => "hello"
# Example: [pad-left "x" 4 "0"] => "000x"
pad-left@[doc: "Left-pad a string to a target width with a padding character"]: [fn@String [let s width pad-char]
    [if [< [str-length s] width]
        [str [str-repeat [- width [str-length s]] pad-char] s]
        s]]

# Right-pad a string to a target width with a padding character.
# If the string is already >= width, returns it unchanged.
# Type: (String -> Int -> String -> String)
# Example: [pad-right "hi" 5 " "] => "hi   "
# Example: [pad-right "hello" 3 " "] => "hello"
# Example: [pad-right "x" 4 "0"] => "x000"
pad-right@[doc: "Right-pad a string to a target width with a padding character"]: [fn@String [let s width pad-char]
    [if [< [str-length s] width]
        [str s [str-repeat [- width [str-length s]] pad-char]]
        s]]

# ============================================================================
# String Reversal
# ============================================================================

# Reverse a string by characters.
# Type: (String -> String)
# Example: [str-reverse "hello"] => "olleh"
# Example: [str-reverse ""] => ""
# Example: [str-reverse "a"] => "a"
str-reverse@[doc: "Reverse a string by characters"]: [fn@String [let s@String]
    [str-reverse-impl s 0 [str-length s] ""]]

# ============================================================================
# Aliases for codecs/json.llt and other consumers
# ============================================================================

# str-replace: alias for prelude's `replace` with (pattern replacement input) semantics.
# Provided here so that files including strings.llt can call str-replace without
# needing to know the prelude exports `replace` under a different name.
# Type: (String -> String -> String -> String)
# Example: [str-replace "l" "r" "hello"] => "herro"
str-replace@[doc: "Replace all occurrences of pattern with replacement in input"]: [fn@String [let pattern@String replacement@String input@String]
    [replace pattern replacement input]]

# str-join: alias for prelude's `join`.
# Provided here for symmetry with str-replace and for codecs/json.llt.
# Type: (String -> [Dict|Seq] -> String)
# Example: [str-join "," ["a" "b" "c"]] => "a,b,c"
str-join@[doc: "Join collection elements as strings with a separator"]: [fn@String [let sep@String xs]
    [join sep xs]]

]
