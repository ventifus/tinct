# stdlib/loader.llt
#
# The tinct "main function" — the first tinct code evaluated at startup.

--- stage: "type"
# Type-stage definitions for primitive types available in this init program.
[
  TypeNode: [type
    Int
    String
    Float
    Bytes
    Never
    Top
    Unknown
    Proxy
    Callable
    Dict: [fields: Any  open: Any  key-type: Any  value-type: Any]
    TypeConstructor: [name: Any]
    TypeApplication: [ctor: Any  args: Any]
    IntLiteral:    [n: Any]
    StringLiteral: [s: Any]]

  Integer: TypeNode.Int
  String:  TypeNode.String
  Float:   TypeNode.Float
  Bytes:   TypeNode.Bytes
  Never:   TypeNode.Never
  Any:     TypeNode.Top
  Unknown: TypeNode.Unknown
  Proxy:   TypeNode.Proxy
  Dict:    [TypeNode.Dict fields: []  open: 1  key-type: TypeNode.Top  value-type: TypeNode.Top]
]

---
# The invoker (CLI, LSP, literate runner, ...) provides an initial dictionary
# environment, as though it evaluated a tinct dict before this file runs:
#
#   [
#     %cwd:      <DirCap — working directory, fixed for the lifetime of execution>
#     %libdir:   <DirCap — stdlib, ReadOnly>
#     %args:     {output: "json", strict: true, ...}
#     %programs: {0: ProgramItem.File{...}, 1: ...}
#     %myfs:     <DirCap — user said --cap myfs=/some/path>
#     ...        # anything the invoker decides; %prefix is convention, not type
#   ]
#
# This dict IS the initial scope. Every entry is accessible as a bare name in
# loader.llt and in all closures captured from loader.llt's scope.
# No named reference to the whole dict is needed — entries are just in scope.
#
# What threads through the pipeline explicitly:
#   include-dir — the DirCap to resolve relative [include ...] calls against.
#                 Starts as %cwd but eval-file overrides it per-file to the
#                 containing directory of each file being processed. %cwd itself
#                 is fixed and accessible directly from the closure.
#   prelude     — runtime value of prelude.llt, merged into every user doc's scope.
#                 Used to seed the type-stage env (via builtin-tc-update-type-stage-env).
#   emit-ch     — the shared channel for emitting values to the output formatter.
#
# Known initial-env entries (%cwd, %libdir, %args) are included in every
# user document's scope by eval-document-runtime referencing them from its closure.
# %stdout and %stderr are nominal type values (Stdout.Stdout, Stderr.Stderr) defined in Dict 2.
# User-specified caps declared via --- caps: headers are handled during that
# processing step — not threaded here.
#
# Naming convention: ALL core module exports use the builtin-* prefix.
# Prelude re-exports them as user-facing names (if, channel, send, bytes, ...).
# Parser keywords (fn, match, let, type, class, instance, macro) are always
# available as syntax — not module exports.
#
# Structure — THREE DICTS IN ONE DOCUMENT (no --- separators):
#   Dict 1: private helpers (core builtins only)
#   Dict 2: core types + full pipeline (sees dict 1 and initial env)
#   Dict 3: load prelude + run (sees dicts 1 and 2)
#
# Irreducible builtins used (the minimal set):
#   Control: match (keyword — always available)
#   I/O:     builtin-file-read, builtin-file-open, builtin-write-stdout, builtin-write-stderr, builtin-channel, builtin-send
#   Bytes:   builtin-bytes, builtin-bytes-concat, builtin-dict-length
#   AST:     builtin-parse, builtin-resolve, builtin-lower, builtin-typecheck-doc
#   Type:    builtin-make-type-ctx, builtin-fork-type-ctx,
#            builtin-tc-update-type-stage-env
#   Meta:    builtin-module, builtin-eval
# Note: builtin-resolve now takes a name-set Dict<String,1> (not scope frames).
#       builtin-eval now takes (lowered CoreDocument, env Dict) and returns
#       the exports Dict directly (raises on error — no {result, scope-id, diags}).
#       builtin-tc-update-type-stage-env wires the type-stage env into the TypeContext.
#   String:  builtin-str, builtin-str-bytes, builtin-str-hash, builtin-str-lt
#   Dict:    builtin-reduce (Dict fold only — NOT Seq; Seq reduce is tinct),
#            merge, builtin-dict-get, builtin-keys, builtin-dict-length, builtin-build-dict
#   Variant: builtin-tag-of (reads Variant tag string — Variant internals, not Dict)
#   Path:    path-dirname (String → String; extracts parent dir from a file path, tinct-defined)

# ============================================================================
# Dict 1 — Private helpers
# ============================================================================

[
  # bytes-empty? is a runtime function (not a macro): macro bodies receive AST
  # nodes, not byte values, so builtin-dict-length on an AST node would fail.
  bytes-empty?: [fn [let b] [builtin-eq-int [builtin-bytes-length b] 0]]

  # merge: right-biased dict union using the builder API — no Rust merge needed.
  # _copy helper is private (inside the function's letrec scope).
  merge: [fn [let a b]
    [_copy: [fn [let builder d n i]
      [match [builtin-int-gte i n]
        0: [_copy
              [builtin-builder-set [builtin-dict-key-nth d i] [builtin-dict-nth d i] builder]
              d n [builtin-int-add i 1]]
        ...: builder]]]
    [builtin-builder-finish
      [_copy [_copy [builtin-make-builder] a [builtin-dict-length a] 0]
             b [builtin-dict-length b] 0]]]

  # path-dirname: extract the directory portion of a path string.
  # Scans right-to-left for the last "/" and returns the prefix, or "." if none.
  path-dirname: [fn [let path]
    [find-slash: [fn [let i]
      [match [builtin-int-gte i 0]
        0: -1
        ...: [match [builtin-eq-string [builtin-str-slice path i [builtin-int-add i 1]] "/"]
               0: [find-slash [builtin-int-sub i 1]]
               ...: i]]]]
    [last-slash: [find-slash [builtin-int-sub [builtin-str-length path] 1]]]
    [match [builtin-eq-int last-slash -1]
      0: [builtin-str-slice path 0 last-slash]
      ...: "."]]

  read-file: [fn [let f acc]
    [chunk: [builtin-file-read f 65536]]
    [match [bytes-empty? chunk]
      0: [read-file f [builtin-bytes-concat acc chunk]]
      ...: acc]]

  # reduce and join defined with core builtins only (prelude not yet loaded).
  _reduce-loop: [fn [let f acc xs i len]
    [match [builtin-int-gte i len]
      0: [_reduce-loop f [f acc [builtin-dict-get i xs]] xs [builtin-int-add i 1] len]
      ...: acc]]
  reduce: [fn [let f init xs] [_reduce-loop f init xs 0 [builtin-dict-length xs]]]

  _join-loop: [fn [let sep acc xs i len]
    [match [builtin-int-gte i len]
      0: [_join-loop sep
           [match [builtin-eq-int i 0]
             0: [builtin-string-concat acc [builtin-string-concat sep [builtin-dict-get i xs]]]
             ...: [builtin-dict-get 0 xs]]
           xs [builtin-int-add i 1] len]
      ...: acc]]
  join: [fn [let sep xs] [_join-loop sep "" xs 0 [builtin-dict-length xs]]]

  # make-entry: construct single-entry dict from key and value.
  # Defined here for Dict 1 because it runs before prelude is loaded.
  make-entry: [fn [let k v] [$k: v]]

  # null?: test if value is [] (empty dict).
  null?: [fn [let x]
    [match [builtin-eq-string [builtin-type-of x] "Dict"]
      0: 0
      ...: [builtin-eq-int [builtin-dict-length x] 0]]]

  # get-or: dict.get with default fallback.
  get-or: [fn [let default key dict]
    [match [builtin-has-key? key dict]
      0: default
      ...: [builtin-dict-get key dict]]]

  # env-to-name-set: build name-set Dict<String,1> from env for builtin-resolve.
  # builtin-resolve now takes a flat Dict<String,1> of all visible names (values ignored).
  # Replaces the old scope-to-frames walk — env is already a flat dict of all bindings.
  _env-to-name-set-loop: [fn [let keys n i builder]
    [match [builtin-eq-int i n]
      0: [_env-to-name-set-loop keys n [builtin-int-add i 1]
           [match [builtin-eq-string [builtin-type-of [builtin-dict-get i keys]] "String"]
             1: [builtin-builder-set [builtin-dict-get i keys] 1 builder]
             0: builder]]
      ...: [builtin-builder-finish builder]]]
  env-to-name-set: [fn [let env]
    [keys: [builtin-keys env]]
    [_env-to-name-set-loop keys [builtin-dict-length keys] 0 [builtin-make-builder]]]
]

# ============================================================================
# Dict 2 — Core types and full pipeline
# ============================================================================
# Sees dict 1 and the initial environment. All closures capture the initial
# environment — %cwd, %libdir, %stdout, %args etc. are bare names here.

[
  # ── stdio nominal types ───────────────────────────────────────────────────
  # Stdout, Stderr, Stdin are tinct nominal types — not opaque Rust types.
  # Writable/Readable instances in prelude.llt dispatch to stateless builtins.
  # %stdout/%stderr are unit variant values, not protocol dicts.
  Stdout: [type Stdout]
  Stderr: [type Stderr]
  Stdin:  [type Stdin]
  %stdout: Stdout.Stdout
  %stderr: Stderr.Stderr

  # ── Foundation ────────────────────────────────────────────────────────────
  # Boolean is declared here (loader.llt dict 2), before prelude loads.
  # This makes Boolean.True / Boolean.False available as constructor names
  # throughout loader.llt and in all closures that capture loader's scope.
  # match on Int: 0 = false, non-zero = true — it does not need the type
  # declaration itself, but declaring Boolean here makes the constructors
  # accessible as values.
  # prelude.llt must NOT redeclare Boolean — it is already in scope.

  Boolean: [type True False]

  DocName: [type Named: [name: String]  Unnamed]

  # ProgramItem: discriminated union for %programs entries.
  # Rust constructs these using qualified tag names — a bootstrapping contract.
  ProgramItem: [type
    File: [path: String  handle: File]
    Expr: [src:  String]
  ]

  # ── Module injection ──────────────────────────────────────────────────────
  # Process a --- uses: declaration list.
  #
  # For each module name, two things happen:
  #   1. Type-checker: parse + desugar + resolve + typecheck builtin_NAME.llt per doc.
  #      builtin-typecheck-doc updates TypeContext in-place (side-effect).
  #      No builtin-eval — placeholder ... bodies must never execute.
  #   2. Evaluator: builtin-module NAME returns the dict of Value::Builtin
  #      implementations, merged into the accumulating scope.
  #
  # Called once per file in eval-file, before type-checking the
  # file itself — TypeSchemes from the declaration file must be in
  # TypeContext before the file's body is type-checked.
  # Returns: merged dict of runtime impls, threaded into the next scope.

  # Declaration files (builtin_NAME.llt) are optional — if absent, builtin-try
  # catches the error. Returns a flat Dict of all module builtins.
  #
  # seed-tc: the TypeContext to use for all module type-checks in this reduce.
  # Caller is responsible for building and passing it — no implicit global fallback.
  # DirCap, Boolean, etc. propagate only through this explicit parameter.
  #
  # seed-env: the accumulated env dict to use for declaration file resolve/doc-meta.
  uses-scope: [fn [let module-names seed-tc seed-env]
    [reduce
      [fn [let acc name]
        [decl-path:  [builtin-string-concat "builtin_" [builtin-string-concat name ".llt"]]]
        [tc-result:  [builtin-try [call [fn []
            [decl-handle:    [builtin-file-open %libdir decl-path ["read"] -1 -1]]
            [decl-bytes:     [read-file decl-handle [builtin-bytes]]]
            [parse-result:   [builtin-parse decl-bytes decl-path]]
            [desugared:      [builtin-desugar parse-result.program]]
            [docs:           [builtin-program-docs desugared]]
            # Typecheck each document in the declaration file using the seed env.
            # No eval — just type-check to populate TypeContext with builtin signatures.
            [name-set: [env-to-name-set seed-env]]
            [reduce
              [fn [let acc doc]
                [res: [builtin-resolve doc name-set]]
                [builtin-int-add acc [builtin-dict-length [@Dict [builtin-typecheck-doc res.doc seed-tc seed-env].diagnostics]]]]
              0
              docs]]]]
        # Force tc-result from the return so the TypeContext side-effect runs.
        # builtin-has-key? forces tc-result; both arms return the same module dict.
        [match [builtin-has-key? "ok" tc-result]
          0: [merge acc [builtin-module name]]
          1: [merge acc [builtin-module name]]]]
      []
      module-names]]

  # ── Fundamental-types TypeContext ─────────────────────────────────────────
  # Start from an empty TypeContext and populate it by type-checking
  # builtin_core.llt. This gives fundamental-tc the type declarations from
  # core (DirCap, Int, Bytes, etc.) with no implicit Rust back-channel.
  # The builtin-dict-length data dependency forces uses-scope before returning
  # _fundamental-base-tc, ensuring core types are in place before any
  # downstream module type-checks run.
  # Uses empty env as seed (no scope arena needed — env-dict protocol).
  _fundamental-base-tc: [builtin-make-type-ctx]
  fundamental-tc: [match [builtin-int-gte [builtin-dict-length [uses-scope ["core"] _fundamental-base-tc []]] 0]
    0: _fundamental-base-tc
    ...: _fundamental-base-tc]

  # ── Named section accumulation ────────────────────────────────────────────

  # meta.name is a string from builtin-doc-meta evaluation or "" if absent.
  update-named: [fn [let state val meta]
    [name: [get-or "" "name" meta]]
    [match [builtin-eq-string name ""]
      0: [merge state.named [make-entry [builtin-string-concat "%" name] val]]
      ...: state.named]]

  # ── Diagnostic formatting ─────────────────────────────────────────────────
  # Each diagnostic is a unified error dict:
  #   {level, kind, message, span: {file, start-line, start-col, end-line, end-col},
  #    notes, call-stack, macro-expand, blame}
  # Formatted as: "file:start-line:start-col: level: kind — message\n"
  # Uses only core builtins — safe to call before prelude is loaded.
  format-diagnostic: [fn [let d]
    [s: d.span]
    [file-part: [match [builtin-eq-int [builtin-dict-length s.file] 0]
      0: [builtin-string-concat s.file ":"]
      ...: "<unknown>:"]]
    [join "" [0: file-part  1: [builtin-int->string s.start-line]  2: ":"  3: [builtin-int->string s.start-col]  4: ": "  5: d.level  6: ": "  7: d.kind  8: " — "  9: d.message  10: "\n"]]]

  emit-diagnostics: [fn [let diagnostics]
    # Use builtin-try per diagnostic so a formatting failure doesn't suppress remaining errors.
    # >> forces the write before returning _ so the side effect is not a dormant thunk.
    [reduce
      [fn [let _ d]
        [>> [builtin-try [builtin-write-stderr [format-diagnostic d] %stderr]]
            _]]
      []
      diagnostics]]

  # ── File loading ──────────────────────────────────────────────────────────
  # Stage 1: builtin-parse     — Bytes + path → raw AST
  # Stage 2: builtin-desugar   — $_ expansion, pipe lowering, etc.
  # Stage 3: builtin-resolve   — name resolution
  # Stage 4: builtin-typecheck-doc — per-document type checking
  # Stage 5: builtin-eval      — execution
  #
  # include does NOT take include-dir or prelude — it IS what loads prelude.
  # Uses fundamental-tc (built from builtin_core.llt); it is building the context.

  include: [fn [let cap path extras@[default: []]]
    [handle:        [builtin-file-open cap path ["read"] -1 -1]]
    [bytes:         [read-file handle [builtin-bytes]]]
    [parse-result:  [builtin-parse bytes path]]
    # Stop on parse errors. Emit first (data dependency via emit-diagnostics), then raise.
    # >> in the desugared binding forces the check before desugar proceeds, preventing dormancy.
    [n-parse:       [builtin-dict-length parse-result.diagnostics]]
    [_pe:           [builtin-dict-length [emit-diagnostics parse-result.diagnostics]]]
    # Desugar the parsed program (expands $_ lambda, pipe, etc.)
    [desugared:     [>> [match [builtin-eq-int [builtin-int-add n-parse _pe] 0]
                          0: [builtin-raise [join "" [[builtin-int->string n-parse] " parse error(s) in " path]]]
                          ...: []]
                        [builtin-desugar parse-result.program]]]
    [docs:          [builtin-program-docs desugared]]
    # Seed env from extras dict (e.g., %prelude for prelude.llt).
    # Dot-access desugars to builtin-dict-get (a core builtin always in scope).
    [seed-env: extras]
    # Per-document reduce fn: unified for type-stage and runtime passes.
    # acc is {env: Dict  tc: TypeContext}.
    [eval-doc: [fn [let acc doc]
      [meta:     [builtin-doc-meta doc acc.env]]
      [uses:     [uses-scope [get-or [] "uses" meta] acc.tc acc.env]]
      [doc-env:  [merge acc.env uses]]
      [name-set: [env-to-name-set doc-env]]
      [res:      [builtin-resolve doc name-set]]
      [n-re:     [builtin-dict-length res.diagnostics]]
      [_re:      [builtin-dict-length [emit-diagnostics res.diagnostics]]]
      # >> forces the resolve-error check before typecheck proceeds, preventing dormancy.
      [typed:   [>> [match [builtin-eq-int [builtin-int-add n-re _re] 0]
                      0: [builtin-raise [join "" [[builtin-int->string n-re] " resolve error(s) in " path]]]
                      ...: []]
                    [builtin-typecheck-doc res.doc acc.tc doc-env]]]
      [lowered: [builtin-lower typed.doc]]
      [exports: [builtin-eval lowered doc-env]]
      [doc-name: [get-or "" "name" meta]]
      [next-env: [merge doc-env
                   [merge [%: exports]
                     [match [builtin-eq-string doc-name ""]
                       0: [make-entry doc-name exports]
                       ...: []]]]]
      [merge acc [env: next-env]]]]
    # Split documents by stage using reduce (filter is not available before prelude loads).
    [split: [reduce
      [fn [let acc doc]
        [meta: [builtin-doc-meta doc seed-env]]
        [stage: [get-or "runtime" "stage" meta]]
        [match [builtin-eq-string stage "type"]
          0: [ts: [merge acc.ts [make-entry [builtin-dict-length acc.ts] doc]]  rt: acc.rt]
          ...: [ts: acc.ts  rt: [merge acc.rt [make-entry [builtin-dict-length acc.rt] doc]]]]]
      [ts: []  rt: []]
      docs]]
    # Pass 1: evaluate type-stage documents to build ts env.
    [ts-acc: [reduce eval-doc [env: seed-env  tc: fundamental-tc] split.ts]]
    # Wire ts env into the TypeContext so type-stage functions are visible
    # during type-checking of runtime documents.
    [tc: [builtin-tc-update-type-stage-env ts-acc.tc ts-acc.env]]
    # Pass 2: evaluate runtime documents, starting from ts-acc so runtime docs see type-stage defs.
    [final-acc: [reduce eval-doc [env: ts-acc.env  tc: tc] split.rt]]
    # Return {env} so callers can thread into subsequent calls.
    [env: final-acc.env]]

  # ── Document-level evaluation ─────────────────────────────────────────────
  # Builds the env dict for one user document via flat dict merges.
  # Known initial-env entries (%cwd, %libdir, %stdout, %args) are referenced
  # directly from the closure — they are in scope because this function is
  # defined in the initial environment.
  # %include-dir is threaded as a parameter because it changes per-file.
  # Resolution is done per-document via builtin-resolve doc name-set → {doc, diagnostics}.
  #
  # Env construction (later merges shadow earlier ones):
  #   mod-scope   — module builtins from --- uses: header  [highest]
  #   state.named — named sections from --- %name headers
  #   emit/include/caps — loader-injected
  #   prelude     — standard library (lowest; shadowed by everything above)
  #
  # mod-scope: Dict of module builtins from uses-scope.
  # prelude-env: the accumulated env dict from prelude evaluation.
  # Computed once per file in eval-file and threaded into each document.
  eval-document-runtime: [fn [let state mod-scope doc include-dir prelude-env tc emit-ch]
    [emit-fn: [fn [let v] [builtin-send emit-ch v]]]
    # Build full env: start from prelude env, add per-doc bindings.
    # Env priority (later merges shadow earlier ones):
    #   mod-scope   — module builtins from --- uses: header  (merged last = highest priority)
    #   state.named — named sections from --- %name headers
    #   emit/channel, include, %include-dir — loader-injected
    #   known caps  — %cwd, %libdir, %stdout, %stderr, %args from closure
    #   prelude     — standard library (merged first = lowest priority)
    #
    # ctx-include: a prelude-carrying version of include injected into document scope.
    # Evaluates included files with prelude env in scope.
    [ctx-include: [fn [let cap path]
      # Call the top-level include with %prelude in the extras dict so included
      # files see the prelude env. Capture prelude-env from outer scope.
      [include cap path [%prelude: prelude-env]].env]]
    # Env construction: merge in priority order (each merge shadows the previous).
    # merge A B = right-biased, B wins. So later merges have higher priority.
    [base-env:  [merge prelude-env state.named]]
    [caps-env:  [merge base-env
                  [%:            state.percent
                   %include-dir:  include-dir
                   emit:          emit-fn
                   %emit-channel: emit-ch
                   %cwd:          %cwd
                   %libdir:       %libdir
                   %stdout:       %stdout
                   %stderr:       %stderr
                   %args:         %args
                   include:       ctx-include]]]
    [full-env:  [merge caps-env mod-scope]]
    # Per-document resolve against the fully-constructed env.
    [name-set: [env-to-name-set full-env]]
    [doc-resolved: [builtin-resolve doc name-set]]
    [n-re: [builtin-dict-length doc-resolved.diagnostics]]
    [_re:  [builtin-dict-length [emit-diagnostics doc-resolved.diagnostics]]]
    # If % was in scope (non-first doc) but never referenced, emit abandoned-input warning.
    [input-warn-diags: [match [builtin-int-gt [get-or 0 "doc-index" state] 0]
      0: []
      ...: [match [builtin-has-key? "%" doc-resolved.unreferenced]
           0: []
           ...: [make-entry 0 [level: "warning"
                kind: "abandoned-input"
                message: "document does not reference pipeline input %"
                span: doc-resolved.doc-span
                notes: []
                help: []
                call-stack: []
                macro-expand: []
                blame: []]]]]]
    [_iw: [builtin-dict-length [emit-diagnostics input-warn-diags]]]
    # Type-check the document. >> forces the resolve-error check first to prevent dormancy:
    # the standalone match would be a dormant thunk since typed never referenced its auto-key.
    [typed: [>> [match [builtin-eq-int [builtin-int-add [builtin-int-add n-re _re] _iw] 0]
                  0: [builtin-raise "resolve error(s)"]
                  ...: []]
                [builtin-typecheck-doc doc-resolved.doc tc full-env]]]
    # Lower to CoreDocument, then evaluate with env-dict protocol.
    [lowered: [builtin-lower typed.doc]]
    # builtin-eval returns exports Dict directly; raises on error — no try/match needed.
    [evaled: [builtin-eval lowered full-env]]
    # Extract document metadata for caps validation and named-section bookkeeping.
    [meta: [builtin-doc-meta doc full-env]]
    # Validate --- caps: declarations. Each declared cap must be present in full-env.
    [caps-list: [get-or [] "caps" meta]]
    [_caps: [reduce [fn [let _ cap-name]
               [match [builtin-cap-env-has? cap-name full-env]
                 0: [builtin-raise [builtin-string-concat "missing required capability: " cap-name]]
                 ...: 0]]
               0 [builtin-keys caps-list]]]
    [_result: [merge state
      [percent: evaled
       named:   [update-named state evaled meta]
       doc-index: [builtin-int-add [get-or 0 "doc-index" state] 1]]]]
    [match [builtin-int-gte _caps 0]
      0: _result
      ...: _result]]

  # ── Pipeline item dispatch ────────────────────────────────────────────────

  eval-pipeline-item: [fn [let item prev include-dir prelude-env tc emit-ch]
    [match item
      [case [let p] [ProgramItem.File p] [eval-file p prev include-dir prelude-env tc emit-ch]]
      [case [let p] [ProgramItem.Expr p] [eval-expr p.src prev include-dir prelude-env tc emit-ch]]]]

  eval-file: [fn [let item prev include-dir prelude-env tc emit-ch]
    # %include-dir for this file's documents = the directory containing item.path,
    # derived by narrowing %cwd (the CLI-provided working directory cap) to the
    # parent directory component of the path. No ambient filesystem access.
    [file-include-dir: [builtin-narrow %cwd [path-dirname item.path]]]
    [bytes:        [read-file item.handle [builtin-bytes]]]
    [parse-result: [builtin-parse bytes item.path]]
    # Emit parse errors as a data dependency (no >> needed).
    [_pe:          [builtin-dict-length [emit-diagnostics parse-result.diagnostics]]]
    [match [builtin-eq-int _pe 0]
      0: [builtin-raise "parse error(s)"]
      ...: []]
    # Desugar + extract docs
    [desugared: [builtin-desugar parse-result.program]]
    [docs:      [builtin-program-docs desugared]]
    # mod-scope: module builtins for --- uses: headers declared in the file's first doc.
    # Extract the file-level uses list from the first doc's metadata and build the module
    # scope from it. When docs is empty, mod-scope is empty (no uses to inject).
    [first-meta: [if [builtin-int-gt [builtin-dict-length docs] 0]
                   [builtin-doc-meta [get 0 docs] prelude-env]
                   []]]
    [mod-scope: [uses-scope [get-or [] "uses" first-meta] tc prelude-env]]
    # Per-document reduce: each doc gets its own eval-document-runtime call.
    [reduce
      [fn [let state doc]
        [eval-document-runtime state mod-scope doc file-include-dir prelude-env tc emit-ch]]
      [percent: prev  named: []  doc-index: 0]
      docs].percent]

  eval-expr: [fn [let src prev include-dir prelude-env tc emit-ch]
    [bytes:        [builtin-str-bytes src]]
    [parse-result: [builtin-parse bytes "<expr>"]]
    # Emit parse errors as a data dependency (no >> needed).
    [_pe:          [builtin-dict-length [emit-diagnostics parse-result.diagnostics]]]
    [match [builtin-eq-int _pe 0]
      0: [builtin-raise "parse error(s)"]
      ...: []]
    # Desugar + extract docs
    [desugared: [builtin-desugar parse-result.program]]
    [docs:      [builtin-program-docs desugared]]
    # No file-level mod-scope for expressions.
    [mod-scope: []]
    # Per-document reduce.
    [reduce
      [fn [let state doc]
        [eval-document-runtime state mod-scope doc include-dir prelude-env tc emit-ch]]
      [percent: prev  named: []  doc-index: 0]
      docs].percent]

  # ── CLI pipeline ──────────────────────────────────────────────────────────
  # Threads include-dir, prelude-env, tc, and emit-ch.
  # %cwd, %libdir, %stdout, %stderr, %args flow via closure, not as parameters.
  # The formatter is passed separately and run last.

  cli-pipeline: [fn [let programs formatter initial include-dir prelude-env tc emit-ch]
    [result: [reduce
      [fn [let prev item]
        [eval-pipeline-item item prev include-dir prelude-env tc emit-ch]]
      initial
      programs]]
    [eval-pipeline-item formatter result include-dir prelude-env tc emit-ch]]
]

# ============================================================================
# Dict 3 — Intermediate bindings (prelude, channels, formatter)
# ============================================================================
# %cwd, %libdir, %stdout, %stderr, %args, %programs and any invoker-defined names are
# all in scope here. %stdout and %stderr are Stdout.Stdout and Stderr.Stderr from Dict 2.
# This dict creates bindings visible to the final expression below.

[
  # Thread Boolean/True/False from loader scope so prelude can use them unqualified.
  # %prelude is a lazy forward reference — safe because prelude only forces it at call time.
  # include now returns {env: Dict}; extract env field.
  prelude-result: [include %libdir "prelude.llt"
                    [%prelude: prelude-env  Boolean: Boolean  True: True  False: False]]
  prelude-env:    prelude-result.env

  # Create a TypeContext for runtime type-checking.
  # fundamental-tc is already enriched by include: the type-stage pass inside include
  # wires prelude's type-stage env, and builtin-typecheck-doc calls populate inference_env
  # with prelude's type schemes. No additional wiring is needed here.
  tc: fundamental-tc

  emit-ch: [builtin-channel]

  out-fmt:    [builtin-dict-get "output" %args]
  out-path:   [builtin-string-concat "cli/out/" [builtin-string-concat out-fmt ".llt"]]
  out-handle: [builtin-file-open %libdir out-path ["read"] -1 -1]
  formatter:  [ProgramItem.File path: out-path  handle: out-handle]
]

# ============================================================================
# Final expression — the document result IS the pipeline execution.
# ============================================================================
# match on programs count: raises on empty, runs pipeline otherwise.
# No >> needed — the error branch raises, the success branch returns the pipeline result.

[match [builtin-eq-int [builtin-dict-length %programs] 0]
  0: [cli-pipeline %programs formatter [] %cwd prelude-env tc emit-ch]
  ...: [builtin-raise "no input files or expressions specified"]]
