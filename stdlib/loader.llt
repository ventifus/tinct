# stdlib/loader.llt — Bootstrap loader (pre-data-streaming)
#
# This file is the first tinct code evaluated at process startup. It defines
# eval-programs, which is the real entry point for running tinct: a pipeline
# of programs where % is threaded through each one in sequence.
#
# `tinct run -i json user1.llt user2.llt -o json` builds the list
# [json-in, user1, user2, json-out] and calls eval-programs on it. -i prepends
# from stdlib/cli/in/, -o appends from stdlib/cli/out/. All programs are equal:
# the return value of each becomes % for the next, regardless of how the
# returning program named its output.
#
# Document header support:
#   --- uses: ["core"]  → module bindings injected into each document's scope
#   --- %name           → result bound as %name for subsequent documents
#                         (doc.name stores name WITHOUT %, e.g. "defaults")
#
# %emit channel support (data-streaming Phase 3):
# eval-programs creates an emit-ch and passes it to each eval-program call.
# eval-program injects it into each document's scope as %emit.
#
# Rust evaluates this file in Phase 2 of the bootstrap with scope: core — the
# only place Rust hardcodes a scope. The resulting eval-programs is used (Phase
# 3) to load prelude, which re-exports both functions for user code.
#
# Uses builtin-* names via `--- uses: ["core"]` header below — prelude is not
# loaded yet when this runs, so these must come from the core module directly.
#   builtin-reduce, builtin-merge, builtin-map   — sequences and dicts
#   builtin-module                               — module dict retrieval
#   builtin-eval (with scope:)                   — document evaluation
--- uses: ["core"]
[
  # Internal helper: build a single-entry dict from a computed key and value.
  # Key must be a plain variable so it can appear in key position syntactically.
  make-entry: [fn@Dict [let k v] [$k: v]]
]

[
  # Evaluate a single program's documents, threading % through them.
  # State carries:
  #   percent — current % pipeline value
  #   named   — accumulated %name bindings from --- %name document headers
  # emit-ch is the emit channel created in eval-programs.
  #
  # FIX B-231: User code sees ONLY the emit function (write-only), not the raw
  # channel. This prevents [recv %emit] from stealing emitted values. Formatters
  # (stdlib/cli/out/*.llt) still need the raw channel to drain; they use %emit-channel
  # which is injected for ALL programs until proper stdlib-only scoping is implemented.
  eval-program: [fn [let prog initial-input emit-ch]
    [emit-fn: [fn@Null [let v@Any] [builtin-send emit-ch v]]]
    [state: [builtin-reduce
      [fn [let state doc]
        [val: [builtin-eval doc.expressions
                 scope:   [builtin-merge
                             [emit: emit-fn  %emit-channel: emit-ch]
                             [builtin-merge
                               state.named
                               [builtin-reduce builtin-merge []
                                 [builtin-map builtin-module doc.uses]]]]
                 program: prog
                 expects: doc.expects
                 %: state.percent]]
        [builtin-merge state
          [percent: val
           named: [match doc.name
                    [case [let n: Named]
                      [builtin-merge state.named [make-entry [builtin-str "%" n] val]]]
                    [case [let _: Unnamed]
                      state.named]]]]]
      [percent: initial-input  named: []]
      prog.documents]]
    state.percent]

  # Evaluate a pipeline of programs (a Seq of Value::Program), threading %
  # from one to the next. This is the real CLI entry point.
  # % flows: initial-input → prog1-result → prog2-result → ...
  # The return value of each program becomes % for the next, regardless of
  # how the program internally named its output dict entries.
  # Creates a single %emit channel shared by all programs in the pipeline.
  eval-programs: [fn [let programs initial-input]
    [emit-ch: [builtin-channel 64]]
    [builtin-reduce
      [fn [let percent prog]
        [eval-program prog percent emit-ch]]
      initial-input
      programs]]
]
