# ============================================================================
# Path Manipulation Library
# ============================================================================
#
# Pure-tinct path manipulation functions. Paths are strings with no OS-specific
# handling. Always uses "/" as the separator.
#
# Depends on prelude functions: split, join, last, length, if, =, -, +, get, keys, append
# ============================================================================

# ============================================================================
# FIRST DICT: Private helpers (not exported)
# ============================================================================

[

# Internal helper for dirname. Takes a Dict of path components.
# Returns "" if zero or one component; otherwise joins all-but-last with "/".
# Type: (Dict String -> String)
dirname-impl: [fn@String [let parts@Dict]
    [if [= [length parts] 0]
        ""
        [if [= [length parts] 1]
            ""
            [join "/" [dirname-drop-last parts [keys parts] 0 []]]]]]

# Drop the last element from a dict by iterating through all but the last key.
# Type: (Dict String -> Dict Int -> Int -> Dict String -> Dict String)
dirname-drop-last: [fn@Dict [let parts@Dict ks i@Int acc@Dict]
    [if [= i [- [length parts] 1]]
        acc
        [dirname-drop-last parts ks [+ i 1] [append [get [get i ks] parts] acc]]]]

# Internal helper for extension. Takes a Dict of parts split by ".".
# Returns "" if zero or one part; otherwise returns the last part.
# Type: (Dict String -> String)
extension-impl: [fn@String [let parts@Dict]
    [if [= [length parts] 0]
        ""
        [if [= [length parts] 1]
            ""
            [get [- [length parts] 1] parts]]]]

]

# ============================================================================
# SECOND DICT: Public API (exported)
# ============================================================================

[

# Split a path into its components.
# Type: (String -> Dict String)
# Example: [path-parts "a/b/c.txt"] => [0: "a" 1: "b" 2: "c.txt"]
# Example: [path-parts "/foo/bar"] => [0: "" 1: "foo" 2: "bar"]
# Note: Leading "/" produces empty first component
path-parts@[doc: "Split a path into its components"]: [fn@Dict [let p@String] [split "/" p]]

# Get the last component of a path (filename).
# Type: (String -> String)
# Example: [basename "/foo/bar.txt"] => "bar.txt"
# Example: [basename "file.txt"] => "file.txt"
# Example: [basename "/"] => ""
basename@[doc: "Get the last component of a path (filename)"]: [fn@String [let p@String]
    [last [split "/" p]]]

# Get the directory portion of a path (all but the last component).
# Type: (String -> String)
# Example: [dirname "/foo/bar.txt"] => "/foo"
# Example: [dirname "a/b/c"] => "a/b"
# Example: [dirname "file.txt"] => ""
# Example: [dirname "/"] => ""
dirname@[doc: "Get the directory portion of a path (all but the last component)"]: [fn@String [let p@String]
    [dirname-impl [split "/" p]]]

# Get the file extension (after the last ".").
# Type: (String -> String)
# Example: [extension "file.tar.gz"] => "gz"
# Example: [extension "noext"] => ""
# Example: [extension ".hidden"] => "hidden"
extension@[doc: "Get the file extension (after the last .)"]: [fn@String [let p@String]
    [extension-impl [split "." [basename p]]]]

# Join path components with "/".
# Type: (Dict String -> String)
# Example: [path-join ["a" "b" "c.txt"]] => "a/b/c.txt"
# Example: [path-join []] => ""
path-join@[doc: "Join path components with /"]: [fn@String [let parts@Dict] [join "/" parts]]

]
