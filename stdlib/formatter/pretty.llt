# Pretty Formatter for Tinct AST
# Converts AST dict (from ast_to_dict with source+comments) to formatted source
#
# Layout decisions:
# - Single-line if dict has <=4 entries AND rendered width <=80 chars
# - Multi-line with 2-space indentation otherwise
# - Comments and blank lines preserved from source
#
# Structure: two-expression document.
# - Expression 1 (intermediate dict): all helpers + format functions.
# - Expression 2 (final): [format-file %] — returns the formatted String.
#
# The % binding refers to the AST file dict from ast_to_dict (with comments mode).

# ============================================================================
# Expression 1: All helpers + format functions (intermediate scope)
# ============================================================================

[

# ---- Configuration ----

max-width:    80
max-entries:  4
indent-size:  2

# ---- String utilities ----

join-strings: [fn@Str [sep@Str items@Dict]
  [join-strings-impl sep items 0 ""]]

join-strings-impl: [fn@Str [sep@Str items@Dict i@Int acc@Str]
  [if [>= i [length items]]
    acc
    [join-strings-impl
      sep
      items
      [+ i 1]
      [str acc [if [> i 0] sep ""] [get i items]]]]]

map-list: [fn@Dict [f@Fn xs@Dict]
  [map-list-impl f xs 0]]

map-list-impl: [fn@Dict [f@Fn xs@Dict i@Int]
  [if [>= i [length xs]]
    []
    [merge
      [make-entry i [f [get i xs]]]
      [map-list-impl f xs [+ i 1]]]]]

make-entry: [fn@Dict [k v] [$k: v]]

# Check if a key exists in a dict (returns false on missing key)
field-has?: [fn@Bool [dict@Dict key@Str]
  [has? dict key]]

# ---- Pattern formatting ----

# Format a literal pattern value: {type: "literal", value: <int|float|bool|str>}
# Pattern literals have no "kind" field unlike expression literals.
format-pattern-literal: [fn@Str [pat@Dict]
  [if [bool? [get "value" pat]]
    [if [get "value" pat] "true" "false"]
    [str [get "value" pat]]]]

format-pattern: [fn@Str [pat@Dict]
  [match [get "type" pat]
    "wildcard":    "_"
    "var":         [get "name" pat]
    "variable":    [get "name" pat]
    "literal":     [format-pattern-literal pat]
    "constructor": [if [has? pat "binding"]
                     [str [get "tag" pat] " " [format-pattern [get "binding" pat]]]
                     [get "tag" pat]]
    "dict":        [format-pattern-dict pat]
    "seq":         [str "[" [format-pattern [get "head" pat]] " | " [format-pattern [get "tail" pat]] "]"]
    "or":          [join-strings " | " [map-list format-pattern [get "patterns" pat]]]
    _:             [error [str "unknown pattern type: " [get "type" pat]]]]]

# Note: fields dict has string keys "0","1"... so use values to get 0-indexed list
format-pattern-dict: [fn@Str [pat@Dict]
  [if [empty? [get "fields" pat]]
    "[]"
    [str "["
      [join-strings " "
        [map-list
          [fn [f] [str [get "key" f] ": " [format-pattern [get "pattern" f]]]]
          [values [get "fields" pat]]]]
      "]"]]]

# ---- Inline (single-line) rendering for width measurement ----

# Render a node assuming single-line (no indentation)
render-inline: [fn@Str [node@Dict]
  [match [get "type" node]
    "literal":        [format-literal node]
    "var":            [get "name" node]
    "dot-access":     [str [render-inline [get "target" node]] "." [if [int? [get "field" node]] [str [get "field" node]] [get "field" node]]]
    "pipe":           [str [render-inline [get "lhs" node]] " | " [render-inline [get "rhs" node]]]
    "sequential":     [join-strings "; " [map-list render-inline [get "exprs" node]]]
    "dict":           [render-dict-inline node]
    "call":           [render-call-inline node]
    "fn":             [render-fn-inline node]
    "type-alias":     [str "`" [render-inline [get "expr" node]]]
    "type-assert":    [str [render-inline [get "expr" node]] "@" [format-annotation [get "annotation" node]]]
    "annotated":      [str "@" [get "name" node] " " [format-annotation [get "annotation" node]]]
    "rest":           [if [empty? [get "name" node]] "..." [str "..." [get "name" node]]]
    "quote":          [str "[quote " [render-inline [get "expr" node]] "]"]
    "unquote":        [str "[unquote " [render-inline [get "expr" node]] "]"]
    "unquote-splice": [str "[unquote-splice " [render-inline [get "expr" node]] "]"]
    "defmacro":       [str "[defmacro " [get "name" node] " " [render-inline [get "body" node]] "]"]
    "match":          [str "[match " [render-inline [get "scrutinee" node]] [render-match-arms [get "arms" node]] "]"]
    "class":          [format-class node]
    "instance":       [format-instance node]
    "type-app":       [str "@[" [render-inline [get "func" node]] " " [render-inline [get "arg" node]] "]"]
    "error":          "<error>"
    _:                [error [str "unknown node type: " [get "type" node]]]]]

render-dict-inline: [fn@Str [node@Dict]
  [if [empty? [get "entries" node]]
    "[]"
    [str "["
      [join-strings " "
        [map-list
          [fn [e] [render-entry-inline e]]
          [get "entries" node]]]
      "]"]]]

render-call-inline: [fn@Str [node@Dict]
  [str
    "["
    [if [not [get "implied" node]] "call " ""]
    [render-inline [get "fn" node]]
    [if [> [length [get "args" node]] 0]
      [str " " [join-strings " " [map-list render-inline [get "args" node]]]]
      ""]
    [if [> [length [get "named-args" node]] 0]
      [str " " [join-strings " " [map-list format-named-arg [get "named-args" node]]]]
      ""]
    "]"]]

render-fn-inline: [fn@Str [node@Dict]
  [str
    "[fn"
    [if [not [empty? [get "return-ann" node]]]
      [str "@" [format-annotation [get "return-ann" node]]]
      ""]
    " ["
    [join-strings " " [map-list format-param [get "params" node]]]
    "] "
    [render-inline [get "body" node]]
    "]"]]

render-entry-inline: [fn@Str [entry@Dict]
  [if [empty? [get "key" entry]]
    [render-inline [get "value" entry]]
    [str [render-inline [get "key" entry]] ": " [render-inline [get "value" entry]]]]]

# Render match arms inline (for width measurement): " pat: body pat: body ..."
render-match-arms: [fn@Str [arms@Dict]
  [render-match-arms-impl arms 0 ""]]

render-match-arms-impl: [fn@Str [arms@Dict i@Int acc@Str]
  [if [>= i [length arms]]
    acc
    [render-match-arms-impl
      arms
      [+ i 1]
      [str acc
        " "
        [format-pattern [get "pattern" [get i arms]]]
        ": "
        [render-inline [get "body" [get i arms]]]]]]]

# ---- Layout decision ----

# Check if a dict node fits inline (within max-width and max-entries)
fits-inline?: [fn@Bool [node@Dict indent@Int]
  [and
    [<= [length [get "entries" node]] max-entries]
    [<= [+ indent [str-length [render-dict-inline node]]] max-width]]]

# ---- Comment formatting ----

emit-leading-comments: [fn@Str [comments@Dict indent@Int]
  [join-strings "\n"
    [map-list
      [fn [c] [str [str-repeat " " indent] "#" c]]
      comments]]]

emit-trailing-comment: [fn@Str [comment@Str]
  [str "  # " comment]]

# ---- Node formatters (with indentation) ----

# Main entry point: dispatch on node.type with indentation
format-node: [fn@Str [node@Dict indent@Int]
  [match [get "type" node]
    "literal":        [format-literal node]
    "var":            [get "name" node]
    "dot-access":     [format-dot-access node]
    "pipe":           [format-pipe node]
    "sequential":     [format-sequential node indent]
    "dict":           [format-dict node indent]
    "call":           [format-call node indent]
    "fn":             [format-fn node indent]
    "type-alias":     [format-type-alias node]
    "type-assert":    [format-type-assert node]
    "annotated":      [format-annotated node]
    "rest":           [format-rest node]
    "quote":          [format-quote node indent]
    "unquote":        [format-unquote node indent]
    "unquote-splice": [format-unquote-splice node indent]
    "defmacro":       [format-defmacro node indent]
    "match":          [format-match node indent]
    "class":          [format-class node]
    "instance":       [format-instance node]
    "type-app":       [format-type-app node]
    "error":          "<error>"
    _:                [error [str "unknown node type: " [get "type" node]]]]]

# Format a literal (int, float, bool, str)
format-literal: [fn@Str [node@Dict]
  [match [get "kind" node]
    "int":   [str [get "value" node]]
    "float": [str [get "value" node]]
    "bool":  [if [get "value" node] "true" "false"]
    "str":   [if [get "bare" node]
               [get "value" node]
               [str "\"" [get "value" node] "\""]]
    _:       [error [str "unknown literal kind: " [get "kind" node]]]]]

# Format dot access: target.field
format-dot-access: [fn@Str [node@Dict]
  [str
    [format-node [get "target" node] 0]
    "."
    [if [int? [get "field" node]]
      [str [get "field" node]]
      [get "field" node]]]]

# Format pipe: lhs | rhs
format-pipe: [fn@Str [node@Dict]
  [str
    [format-node [get "lhs" node] 0]
    " | "
    [format-node [get "rhs" node] 0]]]

# Format sequential: expr1\n\nexpr2\n\n...
format-sequential: [fn@Str [node@Dict indent@Int]
  [join-strings "\n\n"
    [map-list [fn [e] [format-node e indent]] [get "exprs" node]]]]

# Format dict: decide inline vs block based on width and entry count
format-dict: [fn@Str [node@Dict indent@Int]
  [if [empty? [get "entries" node]]
    "[]"
    [if [fits-inline? node indent]
      [render-dict-inline node]
      [str "[\n"
        [format-entries-block [get "entries" node] [+ indent indent-size]]
        "\n"
        [str-repeat " " indent]
        "]"]]]]

# Format entries in block mode (one per line, with comments)
format-entries-block: [fn@Str [entries@Dict indent@Int]
  [format-entries-block-impl entries indent 0 ""]]

format-entries-block-impl: [fn@Str [entries@Dict indent@Int i@Int acc@Str]
  [if [>= i [length entries]]
    acc
    [format-entries-block-impl
      entries
      indent
      [+ i 1]
      [str
        acc
        [if [> i 0] "\n" ""]
        [format-entry-block [get i entries] indent]]]]]

# Format a single entry in block mode with comments
format-entry-block: [fn@Str [entry@Dict indent@Int]
  [str
    # Blank line before if needed
    [if [get "blank-before" entry] "\n" ""]
    # Leading comments
    [if [field-has? entry "leading-comments"]
      [str [emit-leading-comments [get "leading-comments" entry] indent] "\n"]
      ""]
    # Indentation
    [str-repeat " " indent]
    # Key-value pair
    [if [empty? [get "key" entry]]
      # Auto-indexed entry
      [format-node [get "value" entry] indent]
      # Keyed entry
      [str
        [format-node [get "key" entry] indent]
        ": "
        [format-node [get "value" entry] indent]]]
    # Trailing comment
    [if [field-has? entry "trailing-comment"]
      [emit-trailing-comment [get "trailing-comment" entry]]
      ""]]]

# Format call: [fn args...] or [call fn args...]
format-call: [fn@Str [node@Dict indent@Int]
  [str
    "["
    [if [not [get "implied" node]] "call " ""]
    [format-node [get "fn" node] 0]
    [if [> [length [get "args" node]] 0]
      [str " " [join-strings " "
        [map-list [fn [a] [format-node a 0]] [get "args" node]]]]
      ""]
    [if [> [length [get "named-args" node]] 0]
      [str " " [join-strings " "
        [map-list format-named-arg [get "named-args" node]]]]
      ""]
    "]"]]

# Format named argument: name: value
format-named-arg: [fn@Str [na@Dict]
  [str
    [get "name" na]
    ": "
    [format-node [get "value" na] 0]]]

# Format function: [fn[@RetAnn] [params] body]
format-fn: [fn@Str [node@Dict indent@Int]
  [str
    "[fn"
    [if [not [empty? [get "return-ann" node]]]
      [str "@" [format-annotation [get "return-ann" node]]]
      ""]
    " ["
    [join-strings " " [map-list format-param [get "params" node]]]
    "] "
    [format-node [get "body" node] 0]
    "]"]]

# Format parameter
format-param: [fn@Str [param@Dict]
  [str
    [get "name" param]
    [if [not [empty? [get "annotation" param]]]
      [str "@" [format-annotation [get "annotation" param]]]
      ""]
    [if [get "variadic" param] "..." ""]]]

# Format annotation
format-annotation: [fn@Str [ann@Dict]
  [match [get "kind" ann]
    "simple": [get "value" ann]
    "dict":   [str "["
                [join-strings " "
                  [map-list
                    [fn [e] [str [get "key" e] ": " [format-annotation-value [get "value" e]]]]
                    [get "entries" ann]]]
                "]"]
    _:        [error [str "unknown annotation kind: " [get "kind" ann]]]]]

# Format an annotation value (string, int, or nested AST node)
format-annotation-value: [fn@Str [v]
  [if [str? v]
    v
    [if [int? v]
      [str v]
      [format-node v 0]]]]

# Format type alias: `expr
format-type-alias: [fn@Str [node@Dict]
  [str "`" [format-node [get "expr" node] 0]]]

# Format type assert: expr@Ann
format-type-assert: [fn@Str [node@Dict]
  [str
    [format-node [get "expr" node] 0]
    "@"
    [format-annotation [get "annotation" node]]]]

# Format annotated: @Name ann
format-annotated: [fn@Str [node@Dict]
  [str
    "@"
    [get "name" node]
    " "
    [format-annotation [get "annotation" node]]]]

# Format rest: ... or ...name
format-rest: [fn@Str [node@Dict]
  [if [empty? [get "name" node]]
    "..."
    [str "..." [get "name" node]]]]

# Format quote: [quote expr]
format-quote: [fn@Str [node@Dict indent@Int]
  [str "[quote " [format-node [get "expr" node] indent] "]"]]

# Format unquote: [unquote expr]
format-unquote: [fn@Str [node@Dict indent@Int]
  [str "[unquote " [format-node [get "expr" node] indent] "]"]]

# Format unquote-splice: [unquote-splice expr]
format-unquote-splice: [fn@Str [node@Dict indent@Int]
  [str "[unquote-splice " [format-node [get "expr" node] indent] "]"]]

# Format defmacro: [defmacro name transformer]
format-defmacro: [fn@Str [node@Dict indent@Int]
  [str "[defmacro " [get "name" node] " " [format-node [get "body" node] indent] "]"]]

# Format match: [match scrutinee pat1 body1 ...]
format-match: [fn@Str [node@Dict indent@Int]
  [str
    "[match "
    [format-node [get "scrutinee" node] indent]
    [format-match-arms [get "arms" node] indent]
    "]"]]

format-match-arms: [fn@Str [arms@Dict indent@Int]
  [format-match-arms-impl arms indent 0 ""]]

format-match-arms-impl: [fn@Str [arms@Dict indent@Int i@Int acc@Str]
  [if [>= i [length arms]]
    acc
    [format-match-arms-impl
      arms
      indent
      [+ i 1]
      [str acc
        "\n"
        [str-repeat " " [+ indent indent-size]]
        [format-pattern [get "pattern" [get i arms]]]
        ": "
        [format-node [get "body" [get i arms]] [+ indent indent-size]]]]]]

# Format class declaration
format-class: [fn@Str [node@Dict]
  [str
    "[class "
    [get "name" node]
    [if [> [length [get "params" node]] 0]
      [str " " [join-strings " " [map-list [fn [p] p] [get "params" node]]]]
      ""]
    "]"]]

# Format instance declaration
format-instance: [fn@Str [node@Dict]
  [str
    "[instance "
    [get "class" node]
    " "
    [format-node [get "instance_type" node] 0]
    "]"]]

# Format type application: @[func arg]
format-type-app: [fn@Str [node@Dict]
  [str "@[" [format-node [get "func" node] 0] " " [format-node [get "arg" node] 0] "]"]]

# ---- Document & File formatters ----

# Format a document (list of expressions, separated by double newlines)
format-document: [fn@Str [doc@Dict]
  [str
    # Leading comments (file/document header)
    [if [field-has? doc "leading-comments"]
      [str [emit-leading-comments [get "leading-comments" doc] 0] "\n\n"]
      ""]
    # Expressions
    [format-expressions [get "expressions" doc]]]]

format-expressions: [fn@Str [exprs@Dict]
  [format-expressions-impl exprs 0 ""]]

format-expressions-impl: [fn@Str [exprs@Dict i@Int acc@Str]
  [if [>= i [length exprs]]
    acc
    [format-expressions-impl
      exprs
      [+ i 1]
      [str
        acc
        [if [> i 0] "\n\n" ""]
        [format-node [get i exprs] 0]]]]]

# Format a file (list of documents with --- separators)
format-file: [fn@Str [file@Dict]
  [format-file-impl [get "documents" file] 0 ""]]

format-file-impl: [fn@Str [docs@Dict i@Int acc@Str]
  [if [>= i [length docs]]
    [str acc "\n"]
    [format-file-impl
      docs
      [+ i 1]
      [str
        acc
        [if [> i 0]
          [str "\n\n---"
            [format-doc-header [get i docs]]
            "\n\n"]
          ""]
        [format-document [get i docs]]]]]]

# Format document header (section name, output type, expects)
format-doc-header: [fn@Str [doc@Dict]
  [str
    [if [not [empty? [get "name" doc]]]
      [str " %" [get "name" doc]]
      ""]
    [if [not [empty? [get "output-type" doc]]]
      [str "@" [format-annotation [get "output-type" doc]]]
      ""]
    [if [not [empty? [get "expects" doc]]]
      [str " expects: @" [format-annotation [get "expects" doc]]]
      ""]]]

]

# ============================================================================
# Expression 2: return formatted source as a String
# ============================================================================

[format-file %]
