# builtin_math.llt — Arithmetic, comparison, and numeric primitive operations.
# Bodies are Placeholder — valid tinct, errors if forced (builtins are Rust-side).
# Monomorphic typed variants for arithmetic/comparison are declared in builtin_core.llt.

[
  # ── Arithmetic — math module only (mul/div) ───────────────────────────────
  # Monomorphic typed variants (same split as add/sub in builtin_core.llt).
  builtin-int-mul:         [fn@Integer [let a@Integer b@Integer] ...]
  builtin-float-mul:       [fn@Float   [let a@Float   b@Float  ] ...]
  # Division: always returns Float (no integer division in tinct).
  builtin-div-float:       [fn@Float   [let a@Float   b@Float  ] ...]
  builtin-mod:             [fn@Integer [let a@Integer b@Integer] ...]

  # ── Comparison — math module only ────────────────────────────────────────
  # Monomorphic typed variants for lt/gt/gte are in builtin_core.llt.
  builtin-lte:             [fn@Integer [let a@Integer b@Integer] ...]
  builtin-float-lt:        [fn@Integer [let a@Float   b@Float  ] ...]
  builtin-float-lte:       [fn@Integer [let a@Float   b@Float  ] ...]
  builtin-str-lt:          [fn@Integer [let a@String  b@String ] ...]
  builtin-str-lte:         [fn@Integer [let a@String  b@String ] ...]
  builtin-eq-float:        [fn@Integer [let a@Float   b@Float  ] ...]

  # ── Bitwise ────────────────────────────────────────────────────────────────
  builtin-band:            [fn@Integer [let a@Integer b@Integer] ...]
  builtin-bor:             [fn@Integer [let a@Integer b@Integer] ...]
  builtin-bxor:            [fn@Integer [let a@Integer b@Integer] ...]
  builtin-shl:             [fn@Integer [let a@Integer b@Integer] ...]
  builtin-shr:             [fn@Integer [let a@Integer b@Integer] ...]

  # ── Numeric coercions ──────────────────────────────────────────────────────
  # builtin-int-to-float declared in builtin_core.llt
  builtin-float-to-int:    [fn@Integer [let n@Float] ...]
  builtin-floor:           [fn@Integer [let n@Float] ...]
  builtin-round:           [fn@Integer [let n@Float] ...]

  # ── Transcendental functions — all take Float, return Float ────────────────
  builtin-sqrt:            [fn@Float   [let n@Float] ...]
  builtin-log:             [fn@Float   [let n@Float] ...]
  builtin-log2:            [fn@Float   [let n@Float] ...]
  builtin-log10:           [fn@Float   [let n@Float] ...]
  builtin-exp:             [fn@Float   [let n@Float] ...]
  builtin-pow:             [fn@Float   [let base@Float exp@Float] ...]
  builtin-sin:             [fn@Float   [let n@Float] ...]
  builtin-cos:             [fn@Float   [let n@Float] ...]
  builtin-tan:             [fn@Float   [let n@Float] ...]
  builtin-asin:            [fn@Float   [let n@Float] ...]
  builtin-acos:            [fn@Float   [let n@Float] ...]
  builtin-atan:            [fn@Float   [let n@Float] ...]
  builtin-atan2:           [fn@Float   [let y@Float x@Float] ...]

  # ── Float predicates ───────────────────────────────────────────────────────
  builtin-nan?:            [fn@Integer [let n@Float] ...]
  builtin-inf?:            [fn@Integer [let n@Float] ...]
  builtin-finite?:         [fn@Integer [let n@Float] ...]
]
