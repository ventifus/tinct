# stdlib/desugar.llt — $_ implicit lambda desugaring (surface pass)
#
# This is a pure-tinct implementation of the `$_` desugaring transformation.
# It walks the Expression tree via match dispatch and wraps expressions containing
# `$_` in non-parameter positions with implicit lambda functions.
#
# The transformation runs after parsing and macro expansion, before resolution and
# type checking. This file is a standalone metaprogramming tool; the pipeline
# desugar is implemented in src/desugar.rs.
#
# See doc/04-functions.md §`$_` Desugaring for the complete specification.

# ---- Internal helpers ----
[

# is-direct-underscore: Check if an expression is `$_` or an access chain on `$_`.
#
# DIRECT predicate: matches VarRef("_", escaped=true) or DotAccess/Pipe chains
# rooted at `$_`. Used by WRAP rules to detect when wrapping is needed.
is-direct-underscore: [fn [expr@Expression]
  [match expr
    [Var name: "_" escaped: _ span: _]:
      true
    [DotAccess target: t field: _ span: _]:
      [is-direct-underscore t]
    [Pipe lhs: l rhs: _ span: _]:
      [is-direct-underscore l]
    _:
      false]]

# has-direct-in-args: Check if any positional arg is DIRECT.
has-direct-in-args: [fn [args]
  [any? is-direct-underscore [collect args]]]

# has-direct-in-named: Check if any named arg value is DIRECT.
has-direct-in-named: [fn [named]
  [any? [fn [na] [is-direct-underscore na.value]] [collect named]]]

# has-direct-in-entries: Check if any dict entry value is DIRECT.
has-direct-in-entries: [fn [entries]
  [any? [fn [e] [is-direct-underscore e.value]] [collect entries]]]

# wrap-in-lambda: Wrap an expression in `[fn [_] expr]`.
#
# Returns a new Fn expression with a single parameter `_` and the original
# expression as the body. The desugared field is set to true.
wrap-in-lambda: [fn [expr@Expression]
  [Fn
    params: [[Parameter name: "_" annotation: [] variadic: false span: expr.span]]
    body: expr
    return-ann: []
    desugared: true
    span: expr.span]]

# try-wrap: Check if an expression should be wrapped based on WRAP rules.
#
# Returns wrapped expression if wrapping occurred, or [] if no wrapping needed.
try-wrap: [fn [expr@Expression depth@Int]
  [if [> depth 0]
    []  # No wrapping at depth > 0
    [match expr
      # WRAP-CALL: any arg (not func position) is DIRECT
      [Call fn: _ args: a named: na implied: _ span: _]:
        [if [or [has-direct-in-args a] [has-direct-in-named na]]
          [wrap-in-lambda expr]
          []]
      # WRAP-DICT: any value (not key) is DIRECT
      [Dict entries: es span: _]:
        [if [has-direct-in-entries es]
          [wrap-in-lambda expr]
          []]
      # WRAP-DOT: target is DIRECT
      [DotAccess target: t field: _ span: _]:
        [if [is-direct-underscore t]
          [wrap-in-lambda expr]
          []]
      # WRAP-PIPE: LHS is DIRECT
      [Pipe lhs: l rhs: _ span: _]:
        [if [is-direct-underscore l]
          [wrap-in-lambda expr]
          []]
      # All other cases: no wrapping
      _:
        []]]]

# has-underscore-param: Check if a parameter list contains `_`.
has-underscore-param: [fn [params]
  [any? [fn [p] [= p.name "_"]] [collect params]]]

# desugar-expr-impl: Core desugaring logic with depth tracking.
#
# At depth=0, check WRAP conditions on raw children BEFORE recursing.
# If any child is DIRECT, wrap the whole expression in `[fn [_] ...]`.
# Then recurse into children at depth+1 (inside the lambda, `$_` is bound).
#
# At depth>0, only recurse into children (no wrapping).
desugar-expr-impl: [fn [expr@Expression depth@Int]
  # Try wrapping at depth 0
  [wrapped: [try-wrap expr depth]]
  [if [not [= wrapped []]]
    # Wrapping occurred — recurse into the wrapped body at depth+1
    [match wrapped
      [Fn params: ps body: b return-ann: ra desugared: d span: s]:
        [Fn params: ps body: [desugar-expr-impl b [+ depth 1]] return-ann: ra desugared: d span: s]
      _: wrapped]  # Shouldn't happen, but defensive
    # No wrapping — recurse into children
    [desugar-children expr depth]]]

# desugar-children: Recurse into all children of an expression.
#
# For Fn nodes with `_` parameter, increment depth when recursing into the body.
desugar-children: [fn [expr@Expression depth@Int]
  [match expr
    # Literals: no children
    [IntLiteral value: _ span: _]: expr
    [FloatLiteral value: _ span: _]: expr
    [BoolLiteral value: _ span: _]: expr
    [StrLiteral value: _ span: _]: expr
    [Var name: _ escaped: _ span: _]: expr
    [Rest name: _ span: _]: expr
    [Placeholder span: _]: expr
    [Error span: _]: expr

    # Access expressions: recurse into target
    [DotAccess target: t field: f span: s]:
      [DotAccess target: [desugar-expr-impl t depth] field: f span: s]

    # Pipe: recurse into both sides (pipe-to-call transformation is done in lower.rs)
    [Pipe lhs: l rhs: r span: s]:
      [Pipe lhs: [desugar-expr-impl l depth] rhs: [desugar-expr-impl r depth] span: s]

    # Sequential: recurse into all expressions
    [Sequential exprs: es span: s]:
      [Sequential exprs: [map [fn [e] [desugar-expr-impl e depth]] es] span: s]

    # Dict: recurse into entries
    [Dict entries: es span: s]:
      [Dict entries: [map [fn [e] [desugar-entry e depth]] es] span: s]

    # Call: recurse into func, args, named args
    [Call fn: f args: a named: na implied: impl span: s]:
      [Call
        fn: [desugar-expr-impl f depth]
        args: [map [fn [arg] [desugar-expr-impl arg depth]] a]
        named: [map [fn [n] [desugar-named-arg n depth]] na]
        implied: impl
        span: s]

    # Fn: increment depth if `_` is a parameter
    [Fn params: ps body: b return-ann: ra desugared: d span: s]:
      [new-depth: [if [has-underscore-param ps] [+ depth 1] depth]]
      [Fn
        params: ps  # Parameter annotations desugaring skipped for simplicity
        body: [desugar-expr-impl b new-depth]
        return-ann: ra  # Return annotation desugaring skipped
        desugared: d
        span: s]

    # TypeAssert: recurse into expression (annotation desugaring skipped)
    [TypeAssert annotation: ann expr: e span: s]:
      [TypeAssert annotation: ann expr: [desugar-expr-impl e depth] span: s]

    # Annotated: no child expressions
    [Annotated name: _ annotation: _ span: _]: expr

    # Quote: DO NOT recurse (AST frozen)
    [Quote expr: _ span: _]: expr

    # Unquote and UnquoteSplice: DO recurse
    [Unquote expr: e span: s]:
      [Unquote expr: [desugar-expr-impl e depth] span: s]
    [UnquoteSplice expr: e span: s]:
      [UnquoteSplice expr: [desugar-expr-impl e depth] span: s]

    # Match: recurse into scrutinee and arm bodies
    [Match scrutinee: scr arms: as span: s]:
      [Match
        scrutinee: [desugar-expr-impl scr depth]
        arms: [map [fn [a] [desugar-match-arm a depth]] as]
        span: s]

    # TypeApp: recurse into both
    [TypeApp fn: f arg: a span: s]:
      [TypeApp fn: [desugar-expr-impl f depth] arg: [desugar-expr-impl a depth] span: s]

    # Pattern/LetDecl: recurse into bindings
    [PatternDecl bindings: bs span: s]:
      [PatternDecl bindings: [map [fn [b] [desugar-expr-impl b depth]] bs] span: s]
    [LetDecl bindings: bs span: s]:
      [LetDecl bindings: [map [fn [b] [desugar-expr-impl b depth]] bs] span: s]

    # CaseArm: recurse into pattern and body
    [CaseArm pattern: p body: b span: s]:
      [CaseArm pattern: [desugar-expr-impl p depth] body: [desugar-expr-impl b depth] span: s]

    # Catch-all for any variants not explicitly handled
    _: expr]]

# desugar-entry: Desugar a dict entry (key and value).
desugar-entry: [fn [e@Entry depth@Int]
  [Entry
    key: e.key  # Keys can be expressions but desugaring them is low priority
    value: [desugar-expr-impl e.value depth]
    span: e.span]]

# desugar-named-arg: Desugar a named argument value.
desugar-named-arg: [fn [na@NamedArg depth@Int]
  [NamedArg
    name: na.name
    value: [desugar-expr-impl na.value depth]
    span: na.span]]

# desugar-match-arm: Desugar a match arm (pattern guard not implemented yet).
desugar-match-arm: [fn [a@MatchArm depth@Int]
  [MatchArm
    pattern: a.pattern  # Patterns don't contain runtime expressions
    guard: a.guard  # Guard desugaring skipped for simplicity
    body: [desugar-expr-impl a.body depth]
    span: a.span]]

# desugar-document: Desugar all expressions in a document.
desugar-document: [fn [doc@Document]
  [Document
    name: doc.name
    expressions: [map [fn [e] [desugar-expr-impl e 0]] doc.expressions]
    declarations: doc.declarations  # Declarations not desugared (done by expander)
    output-type: doc.output-type
    expects: doc.expects]]

]

# ---- Public API ----
[

desugar-program@[doc: "Desugar a Program by applying $_ implicit lambda transformation.

This function walks the Expression tree via match dispatch and wraps expressions
containing `$_` in non-parameter positions with implicit lambda functions.

The transformation is a surface pass: it runs after parsing and macro expansion,
before resolution and type checking.

Parameters:
  p@Program — The program to desugar

Returns:
  Program — The desugared program with all $_ references wrapped in lambdas"]:
  [fn [p@Program]
    [Program documents: [map desugar-document p.documents]]]

]
