# Stream input formatter — reads stdin as a lazy Seq of evaluated tinct values.
#
# Each SCN record (self-contained normal form) is parsed, resolved, and evaluated.
# Returns a Seq of evaluated tinct values (not AST nodes).
#
# Activated by: tinct run -i stream program.llt

[stream: [include %libdir "codecs/stream.llt"]]
[map stream.parse-expr
  [stream.balanced-exprs [lines %stdin]]]
