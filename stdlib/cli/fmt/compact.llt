# Compact Formatter for Tinct AST
# Converts AST dict (from ast_to_dict) to compact source text.
# Single-line output: semicolons for separators, no comments, no layout decisions.

# Builtins (if, =, +, -, *, <, length, merge, etc.) are provided via the stdlib env.

[

# ---- String utilities ----

join-strings: [fn@[return: String  doc: """Join a 0-indexed dict of strings with sep."""] [let sep@String items@Dict]
  [join-strings-impl sep items 0 ""]]

join-strings-impl: [fn@[return: String] [let sep@String items@Dict i@Integer acc@String]
  [if [>= i [length items]]
    acc
    [join-strings-impl
      sep
      items
      [+ i 1]
      [str acc [if [> i 0] sep ""] [get i items]]]]]

map-list: [fn@[return: Dict  doc: """Map f over a 0-indexed dict, returning a new 0-indexed dict."""] [let f@Fn xs@Dict]
  [map-list-impl f xs 0]]

map-list-impl: [fn@[return: Dict] [let f@Fn xs@Dict i@Integer]
  [if [>= i [length xs]]
    []
    [merge
      [make-entry i [f [get i xs]]]
      [map-list-impl f xs [+ i 1]]]]]

make-entry: [fn@[return: Dict] [let k v]
  [$k: v]]

# ---- Pattern formatting ----

format-pattern-literal: [fn@[return: String  doc: """Format a literal pattern value (no 'kind' field; bool check must come first)."""] [let pat@Dict]
  [if [bool? [get "value" pat]]
    [if [get "value" pat] "true" "false"]
    [str [get "value" pat]]]]

has-binding?: [fn@[return: Bool  doc: """Check if a constructor pattern has a binding."""] [let pat@Dict]
  [has? "binding" pat]]

format-pattern: [fn@[return: String  doc: """Format a match pattern to source text."""] [let pat@Dict]
  [match [get "type" pat]
    "wildcard":    "_"
    "var":         [get "name" pat]
    "variable":    [get "name" pat]
    "literal":     [format-pattern-literal pat]
    "constructor": [if [has-binding? pat]
                     [str [get "tag" pat] " " [format-pattern [get "binding" pat]]]
                     [get "tag" pat]]
    "dict":        [format-pattern-dict pat]
    "seq":         [str "[" [format-pattern [get "head" pat]] " | " [format-pattern [get "tail" pat]] "]"]
    "or":          [join-strings " | " [map-list format-pattern [get "patterns" pat]]]
    ...:           [error [str "unknown pattern type: " [get "type" pat]]]]]

format-pattern-dict: [fn@[return: String  doc: """Format a dict pattern: [key: pat ...]."""] [let pat@Dict]
  [if [empty? [get "fields" pat]]
    "[]"
    [str "["
      [join-strings " "
        [map-list
          [fn [let f] [str [get "key" f] ": " [format-pattern [get "pattern" f]]]]
          [values [get "fields" pat]]]]
      "]"]]]

# ---- Node formatters ----

format-node: [fn@[return: String  doc: """Main dispatch: format any AST node to compact source text."""] [let node]
  [match [get "type" node]
    "Literal":        [format-literal node]
    "VarRef":         [get "name" node]
    "DotAccess":      [format-dot-access node]
    "Pipe":           [format-pipe node]
    "Sequential":     [format-sequential node]
    "Dict":           [format-dict node]
    "Call":           [format-call node]
    "Fn":             [format-fn node]
    "TypeAlias":      [format-type-alias node]
    "TypeAssert":     [format-type-assert node]
    "Annotated":      [format-annotated node]
    "Rest":           [format-rest node]
    "Quote":          [format-quote node]
    "Unquote":        [format-unquote node]
    "UnquoteSplice":  [format-unquote-splice node]
    "MacroDecl":      [format-macrodecl node]
    "Splice":         [format-splice node]
    "SyntaxClass":    [format-syntax-class node]
    "Match":          [format-match node]
    "ClassDecl":      [format-class node]
    "InstanceDecl":   [format-instance node]
    "AstError":       "<error>"
    ...:              [error [str "unknown node type: " [get "type" node]]]]]

format-literal: [fn@[return: String  doc: """Format a literal node (int, float, bool, str)."""] [let node]
  [match [get "kind" node]
    "int":   [str [get "value" node]]
    "float": [str [get "value" node]]
    "bool":  [if [get "value" node] "true" "false"]
    "str":   [if [get "bare" node]
               [get "value" node]
               [str "\"" [get "value" node] "\""]]
    ...:     [error [str "unknown literal kind: " [get "kind" node]]]]]

format-dot-access: [fn@[return: String  doc: """Format dot access: target.field"""] [let node]
  [str
    [format-node [get "target" node]]
    "."
    [if [int? [get "field" node]]
      [str [get "field" node]]
      [get "field" node]]]]

format-pipe: [fn@[return: String  doc: """Format pipe: lhs | rhs"""] [let node]
  [str
    [format-node [get "lhs" node]]
    " | "
    [format-node [get "rhs" node]]]]

format-sequential: [fn@[return: String  doc: """Format sequential expressions with semicolons."""] [let node]
  [join-strings "; "
    [map-list format-node [get "exprs" node]]]]

format-dict: [fn@[return: String  doc: """Format dict: [key: value ...]"""] [let node]
  [if [empty? [get "entries" node]]
    "[]"
    [str "["
      [join-strings " "
        [map-list format-entry [get "entries" node]]]
      "]"]]]

format-entry: [fn@[return: String  doc: """Format a single dict entry."""] [let entry@Dict]
  [if [empty? [get "key" entry]]
    [format-node [get "value" entry]]
    [str
      [format-node [get "key" entry]]
      ": "
      [format-node [get "value" entry]]]]]

format-call: [fn@[return: String  doc: """Format call: [fn args...] or [call fn args...]"""] [let node]
  [str
    "["
    [if [not [get "implied" node]] "call " ""]
    [format-node [get "fn" node]]
    [if [> [length [get "args" node]] 0]
      [str " " [join-strings " "
        [map-list format-node [get "args" node]]]]
      ""]
    [if [> [length [get "named-args" node]] 0]
      [str " " [join-strings " "
        [map-list format-named-arg [get "named-args" node]]]]
      ""]
    "]"]]

format-named-arg: [fn@[return: String  doc: """Format a named argument: name: value"""] [let na@Dict]
  [str
    [get "name" na]
    ": "
    [format-node [get "value" na]]]]

format-fn: [fn@[return: String  doc: """Format function: [fn[@RetAnn] [let params] body]"""] [let node]
  [str
    "[fn"
    [if [not [empty? [get "return-ann" node]]]
      [str "@" [format-annotation [get "return-ann" node]]]
      ""]
    " [let "
    [join-strings " " [map-list format-param [get "params" node]]]
    "] "
    [format-node [get "body" node]]
    "]"]]

format-param: [fn@[return: String  doc: """Format a function parameter with optional annotation."""] [let param@Dict]
  [str
    [get "name" param]
    [if [not [empty? [get "annotation" param]]]
      [str "@" [format-annotation [get "annotation" param]]]
      ""]
    [if [get "variadic" param] "..." ""]]]

format-annotation: [fn@[return: String  doc: """Format a type annotation."""] [let ann@Dict]
  [match [get "kind" ann]
    "simple": [get "value" ann]
    "quote":  "Expr"
    "dict":   [str "["
                [join-strings " "
                  [map-list
                    [fn [let e] [str [get "key" e] ": " [format-annotation-value [get "value" e]]]]
                    [get "entries" ann]]]
                "]"]
    ...:      [error [str "unknown annotation kind: " [get "kind" ann]]]]]

format-annotation-value: [fn@[return: String  doc: """Format an annotation value (string, int, or nested AST node)."""] [let v]
  [if [str? v]
    v
    [if [int? v]
      [str v]
      [format-node v]]]]

format-type-alias: [fn@[return: String  doc: """Format type alias: `expr"""] [let node]
  [str "`" [format-node [get "expr" node]]]]

format-type-assert: [fn@[return: String  doc: """Format type assert: expr@Ann"""] [let node]
  [str
    [format-node [get "expr" node]]
    "@"
    [format-annotation [get "annotation" node]]]]

format-annotated: [fn@[return: String  doc: """Format annotated: @Name ann"""] [let node]
  [str
    "@"
    [get "name" node]
    " "
    [format-annotation [get "annotation" node]]]]

format-rest: [fn@[return: String  doc: """Format rest: ... or ...name"""] [let node]
  [if [empty? [get "name" node]]
    "..."
    [str "..." [get "name" node]]]]

format-quote: [fn@[return: String  doc: """Format quote: [quote expr]"""] [let node]
  [str "[quote " [format-node [get "expr" node]] "]"]]

format-unquote: [fn@[return: String  doc: """Format unquote: [unquote expr]"""] [let node]
  [str "[unquote " [format-node [get "expr" node]] "]"]]

format-unquote-splice: [fn@[return: String  doc: """Format unquote-splice: [unquote-splice expr]"""] [let node]
  [str "[unquote-splice " [format-node [get "expr" node]] "]"]]

format-macrodecl: [fn@[return: String  doc: """Format macro declaration: [macro name params body]"""] [let node]
  [str "[macro " [get "name" node] " " [format-node [get "params" node]] " " [format-node [get "body" node]] "]"]]

format-splice: [fn@[return: String  doc: """Format splice: [splice form ...]"""] [let node]
  [str "[splice " [join-strings " " [map-list format-node [get "forms" node]]] "]"]]

format-syntax-class: [fn@[return: String  doc: """Format syntax-class declaration: [syntax-class name pattern]"""] [let node]
  [str "[syntax-class " [get "name" node] " " [format-node [get "pattern" node]] "]"]]

format-match: [fn@[return: String  doc: """Format match: [match scrutinee pat1: body1 ...]"""] [let node]
  [str
    "[match "
    [format-node [get "scrutinee" node]]
    [format-match-arms [get "arms" node]]
    "]"]]

format-match-arms: [fn@[return: String] [let arms@Dict]
  [format-match-arms-impl arms 0 ""]]

format-match-arms-impl: [fn@[return: String] [let arms@Dict i@Integer acc@String]
  [if [>= i [length arms]]
    acc
    [format-match-arms-impl
      arms
      [+ i 1]
      [str acc
        " "
        [format-pattern [get "pattern" [get i arms]]]
        ": "
        [format-node [get "body" [get i arms]]]]]]]

format-class: [fn@[return: String  doc: """Format class declaration."""] [let node]
  [str
    "[class "
    [get "name" node]
    [if [> [length [get "params" node]] 0]
      [str " " [join-strings " " [map-list [fn [let p] p] [get "params" node]]]]
      ""]
    "]"]]

format-instance-pattern: [fn@[return: String  doc: """Format an instance arm pattern (a LetDecl node) as [let binding ...].
The pattern node is an Expr.LetDecl with a 'bindings' field: list of Expr.* nodes."""] [let pat]
  [str
    "[let"
    [if [> [length [get "bindings" pat]] 0]
      [str " " [join-strings " " [map-list format-node [get "bindings" pat]]]]
      ""]
    "]"]]

format-instance-methods: [fn@[return: String  doc: """Format an instance arm methods dict as [key: val ...].
Methods is a string-keyed dict of method-name -> Expr.* value nodes."""] [let methods]
  [if [= [length methods] 0]
    "[]"
    [str
      "["
      [join-strings " " [map-list [fn [let k] [str k ": " [format-node [get k methods]]]] [keys methods]]]
      "]"]]]

format-instance-arms-impl: [fn@[return: String] [let arms i acc]
  [if [>= i [length arms]]
    acc
    [format-instance-arms-impl
      arms
      [+ i 1]
      [str
        acc
        " "
        [format-instance-pattern [get "pattern" [get i arms]]]
        ": "
        [format-instance-methods [get "methods" [get i arms]]]]]]]

format-instance: [fn@[return: String  doc: """Format instance declaration, rendering each arm as '[let pat]: [methods...]'."""] [let node]
  [str
    "[instance "
    [get "class" node]
    [if [> [length [get "arms" node]] 0]
      [format-instance-arms-impl [get "arms" node] 0 ""]
      ""]
    "]"]]

# ---- Document & File formatters ----

format-document: [fn@[return: String  doc: """Format a document as semicolon-separated expressions."""] [let doc@Dict]
  [join-strings "; "
    [map-list format-node [get "expressions" doc]]]]

format-file: [fn@[return: String  doc: """Format a file: documents joined with '; ---' separators."""] [let file@Dict]
  [format-file-impl [get "documents" file] 0 ""]]

format-file-impl: [fn@[return: String] [let docs@Dict i@Integer acc@String]
  [if [>= i [length docs]]
    [str acc "\n"]
    [format-file-impl
      docs
      [+ i 1]
      [str
        acc
        [if [> i 0]
          [str "; ---"
            [format-doc-header [get i docs]]
            "; "]
          ""]
        [format-document [get i docs]]]]]]

format-doc-header: [fn@[return: String  doc: """Format document section header (name, output type, expects)."""] [let doc@Dict]
  [str
    [if [not [empty? [get "name" doc]]]
      [str " %" [get "name" doc]]
      ""]
    [if [not [empty? [get "output-type" doc]]]
      [str "@" [format-annotation [get "output-type" doc]]]
      ""]
    [if [not [empty? [get "expects" doc]]]
      [str " expects: @" [format-annotation [get "expects" doc]]]
      ""]]]

]

[format-file input-ast]
