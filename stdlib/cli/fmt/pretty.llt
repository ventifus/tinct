# Pretty Formatter for Tinct AST
# Converts AST dict (from ast_to_dict with source+comments) to formatted source.
#
# Layout: single-line if dict has <=4 entries AND rendered width <=80 chars;
# multi-line with 2-space indentation otherwise. Comments and blank lines preserved.

# Builtins (if, =, +, -, *, <, length, merge, etc.) are provided via the stdlib env.

[

# ---- Configuration ----

max-width:    80
max-entries:  4
indent-size:  2

# ---- String utilities ----

join-strings: [fn@[return: String  doc: """Join a 0-indexed dict of strings with sep."""] [let sep@String items@Dict]
  [join-strings-impl sep items 0 ""]]

join-strings-impl: [fn@[return: String] [let sep@String items@Dict i@Integer acc@String]
  [if [>= i [length items]]
    acc
    [join-strings-impl
      sep
      items
      [+ i 1]
      [str acc [if [> i 0] sep ""] [get i items]]]]]

map-list: [fn@[return: Dict  doc: """Map f over a 0-indexed dict, returning a new 0-indexed dict."""] [let f@Fn xs@Dict]
  [map-list-impl f xs 0]]

map-list-impl: [fn@[return: Dict] [let f@Fn xs@Dict i@Integer]
  [if [>= i [length xs]]
    []
    [merge
      [make-entry i [f [get i xs]]]
      [map-list-impl f xs [+ i 1]]]]]

make-entry: [fn@[return: Dict] [let k v]
  [$k: v]]

field-has?: [
  fn@[
    return: Boolean
    doc: """
      Check if a key exists in a dict (returns false on missing key).
      """
  ] [let dict@Dict key@String]
    [has? key dict]
]

# ---- Pattern formatting ----

format-pattern-literal: [fn@[return: String  doc: """Format a literal pattern value (no 'kind' field)."""] [let pat@Dict]
  [if [bool? [get "value" pat]]
    [if [get "value" pat] "true" "false"]
    [str [get "value" pat]]]]

format-pattern: [fn@[return: String  doc: """Format a match pattern to source text."""] [let pat@Dict]
  [match [get "type" pat]
    "wildcard":    "_"
    "var":         [get "name" pat]
    "variable":    [get "name" pat]
    "literal":     [format-pattern-literal pat]
    "constructor": [if [has? "binding" pat]
                     [str [get "tag" pat] " " [format-pattern [get "binding" pat]]]
                     [get "tag" pat]]
    "dict":        [format-pattern-dict pat]
    "seq":         [str "[" [format-pattern [get "head" pat]] " | " [format-pattern [get "tail" pat]] "]"]
    "or":          [join-strings " | " [map-list format-pattern [get "patterns" pat]]]
    ...:           [error [str "unknown pattern type: " [get "type" pat]]]]]

format-pattern-dict: [fn@[return: String  doc: """Format a dict pattern: [key: pat ...]."""] [let pat@Dict]
  [if [empty? [get "fields" pat]]
    "[]"
    [str "["
      [join-strings " "
        [map-list
          [fn [let f] [str [get "key" f] ": " [format-pattern [get "pattern" f]]]]
          [values [get "fields" pat]]]]
      "]"]]]

# ---- Inline (single-line) rendering for width measurement ----

render-inline: [fn@[return: String  doc: """Render a node assuming single-line (no indentation)."""] [let node]
  [match [get "type" node]
    "Literal":        [format-literal node]
    "VarRef":         [get "name" node]
    "DotAccess":      [str [render-inline [get "target" node]] "." [if [int? [get "field" node]] [str [get "field" node]] [get "field" node]]]
    "Pipe":           [str [render-inline [get "lhs" node]] " | " [render-inline [get "rhs" node]]]
    "Sequential":     [join-strings "; " [map-list render-inline [get "exprs" node]]]
    "Dict":           [render-dict-inline node]
    "Call":           [render-call-inline node]
    "Fn":             [render-fn-inline node]
    "TypeAlias":      [str "`" [render-inline [get "expr" node]]]
    "TypeAssert":     [str [render-inline [get "expr" node]] "@" [format-annotation [get "annotation" node]]]
    "Annotated":      [str "@" [get "name" node] " " [format-annotation [get "annotation" node]]]
    "Rest":           [if [empty? [get "name" node]] "..." [str "..." [get "name" node]]]
    "Quote":          [str "[quote " [render-inline [get "expr" node]] "]"]
    "Unquote":        [str "[unquote " [render-inline [get "expr" node]] "]"]
    "UnquoteSplice":  [str "[unquote-splice " [render-inline [get "expr" node]] "]"]
    "MacroDecl":      [str "[macro " [get "name" node] " " [render-inline [get "params" node]] " " [render-inline [get "body" node]] "]"]
    "Splice":         [str "[splice " [join-strings " " [map-list render-inline [get "forms" node]]] "]"]
    "SyntaxClass":    [str "[syntax-class " [get "name" node] " " [render-inline [get "pattern" node]] "]"]
    "Match":          [str "[match " [render-inline [get "scrutinee" node]] [render-match-arms [get "arms" node]] "]"]
    "ClassDecl":      [format-class node]
    "InstanceDecl":   [format-instance node]
    "AstError":       "<error>"
    ...:              [error [str "unknown node type: " [get "type" node]]]]]

render-dict-inline: [fn@[return: String  doc: """Render a dict node single-line."""] [let node]
  [if [empty? [get "entries" node]]
    "[]"
    [str "["
      [join-strings " "
        [map-list
          [fn [let e] [render-entry-inline e]]
          [get "entries" node]]]
      "]"]]]

render-call-inline: [fn@[return: String  doc: """Render a call node single-line."""] [let node]
  [str
    "["
    [if [not [get "implied" node]] "call " ""]
    [render-inline [get "fn" node]]
    [if [> [length [get "args" node]] 0]
      [str " " [join-strings " " [map-list render-inline [get "args" node]]]]
      ""]
    [if [> [length [get "named-args" node]] 0]
      [str " " [join-strings " " [map-list format-named-arg [get "named-args" node]]]]
      ""]
    "]"]]

render-fn-inline: [fn@[return: String  doc: """Render a fn node single-line."""] [let node]
  [str
    "[fn"
    [if [not [empty? [get "return-ann" node]]]
      [str "@" [format-annotation [get "return-ann" node]]]
      ""]
    " [let "
    [join-strings " " [map-list format-param [get "params" node]]]
    "] "
    [render-inline [get "body" node]]
    "]"]]

render-entry-inline: [fn@[return: String  doc: """Render a dict entry single-line."""] [let entry@Dict]
  [if [empty? [get "key" entry]]
    [render-inline [get "value" entry]]
    [str [render-inline [get "key" entry]] ": " [render-inline [get "value" entry]]]]]

render-match-arms: [fn@[return: String  doc: """Render match arms inline for width measurement."""] [let arms@Dict]
  [render-match-arms-impl arms 0 ""]]

render-match-arms-impl: [fn@[return: String] [let arms@Dict i@Integer acc@String]
  [if [>= i [length arms]]
    acc
    [render-match-arms-impl
      arms
      [+ i 1]
      [str acc
        " "
        [format-pattern [get "pattern" [get i arms]]]
        ": "
        [render-inline [get "body" [get i arms]]]]]]]

# ---- Layout decision ----

fits-inline?: [fn@[return: Boolean  doc: """Check if a dict node fits on one line (within max-width and max-entries)."""] [let node indent@Integer]
  [and
    [<= [length [get "entries" node]] max-entries]
    [<= [+ indent [str-length [render-dict-inline node]]] max-width]]]

# ---- Comment formatting ----

emit-leading-comments: [fn@[return: String  doc: """Render leading comment lines with indentation."""] [let comments@Dict indent@Integer]
  [join-strings "\n"
    [map-list
      [fn [let c] [str [str-repeat indent " "] "#" c]]
      comments]]]

emit-trailing-comment: [fn@[return: String  doc: """Render a trailing comment."""] [let comment@String]
  [str "  # " comment]]

# ---- Node formatters (with indentation) ----

format-node: [fn@[return: String  doc: """Main dispatch: format any AST node with indentation."""] [let node indent@Integer]
  [match [get "type" node]
    "Literal":        [format-literal node]
    "VarRef":         [get "name" node]
    "DotAccess":      [format-dot-access node]
    "Pipe":           [format-pipe node]
    "Sequential":     [format-sequential node indent]
    "Dict":           [format-dict node indent]
    "Call":           [format-call node indent]
    "Fn":             [format-fn node indent]
    "TypeAlias":      [format-type-alias node]
    "TypeAssert":     [format-type-assert node]
    "Annotated":      [format-annotated node]
    "Rest":           [format-rest node]
    "Quote":          [format-quote node indent]
    "Unquote":        [format-unquote node indent]
    "UnquoteSplice":  [format-unquote-splice node indent]
    "MacroDecl":      [format-macrodecl node indent]
    "Splice":         [format-splice node indent]
    "SyntaxClass":    [format-syntax-class node]
    "Match":          [format-match node indent]
    "ClassDecl":      [format-class node]
    "InstanceDecl":   [format-instance node]
    "AstError":       "<error>"
    ...:              [error [str "unknown node type: " [get "type" node]]]]]

format-literal: [fn@[return: String  doc: """Format a literal node (int, float, bool, str)."""] [let node]
  [match [get "kind" node]
    "int":   [str [get "value" node]]
    "float": [str [get "value" node]]
    "bool":  [if [get "value" node] "true" "false"]
    "str":   [if [get "bare" node]
               [get "value" node]
               [str "\"" [get "value" node] "\""]]
    ...:     [error [str "unknown literal kind: " [get "kind" node]]]]]

format-dot-access: [fn@[return: String  doc: """Format dot access: target.field"""] [let node]
  [str
    [format-node [get "target" node] 0]
    "."
    [if [int? [get "field" node]]
      [str [get "field" node]]
      [get "field" node]]]]

format-pipe: [fn@[return: String  doc: """Format pipe: lhs | rhs"""] [let node]
  [str
    [format-node [get "lhs" node] 0]
    " | "
    [format-node [get "rhs" node] 0]]]

format-sequential: [fn@[return: String  doc: """Format sequential expressions separated by double newlines."""] [let node indent@Integer]
  [join-strings "\n\n"
    [map-list [fn [let e] [format-node e indent]] [get "exprs" node]]]]

format-dict: [fn@[return: String  doc: """Format dict: inline if small enough, block otherwise."""] [let node indent@Integer]
  [if [empty? [get "entries" node]]
    "[]"
    [if [fits-inline? node indent]
      [render-dict-inline node]
      [str "[\n"
        [format-entries-block [get "entries" node] [+ indent indent-size]]
        "\n"
        [str-repeat indent " "]
        "]"]]]]

format-entries-block: [fn@[return: String  doc: """Format entries in block mode, one per line."""] [let entries@Dict indent@Integer]
  [format-entries-block-impl entries indent 0 ""]]

format-entries-block-impl: [fn@[return: String] [let entries@Dict indent@Integer i@Integer acc@String]
  [if [>= i [length entries]]
    acc
    [format-entries-block-impl
      entries
      indent
      [+ i 1]
      [str
        acc
        [if [> i 0] "\n" ""]
        [format-entry-block [get i entries] indent]]]]]

format-entry-block: [fn@[return: String  doc: """Format a single entry in block mode with comments."""] [let entry@Dict indent@Integer]
  [str
    [if [get "blank-before" entry] "\n" ""]
    [if [field-has? entry "leading-comments"]
      [str [emit-leading-comments [get "leading-comments" entry] indent] "\n"]
      ""]
    [str-repeat indent " "]
    [if [empty? [get "key" entry]]
      [format-node [get "value" entry] indent]
      [str
        [format-node [get "key" entry] indent]
        ": "
        [format-node [get "value" entry] indent]]]
    [if [field-has? entry "trailing-comment"]
      [emit-trailing-comment [get "trailing-comment" entry]]
      ""]]]

format-call: [fn@[return: String  doc: """Format call: [fn args...] or [call fn args...]"""] [let node indent@Integer]
  [str
    "["
    [if [not [get "implied" node]] "call " ""]
    [format-node [get "fn" node] 0]
    [if [> [length [get "args" node]] 0]
      [str " " [join-strings " "
        [map-list [fn [let a] [format-node a 0]] [get "args" node]]]]
      ""]
    [if [> [length [get "named-args" node]] 0]
      [str " " [join-strings " "
        [map-list format-named-arg [get "named-args" node]]]]
      ""]
    "]"]]

format-named-arg: [fn@[return: String  doc: """Format a named argument: name: value"""] [let na@Dict]
  [str
    [get "name" na]
    ": "
    [format-node [get "value" na] 0]]]

format-fn: [fn@[return: String  doc: """Format function: [fn[@RetAnn] [let params] body]"""] [let node indent@Integer]
  [str
    "[fn"
    [if [not [empty? [get "return-ann" node]]]
      [str "@" [format-annotation [get "return-ann" node]]]
      ""]
    " [let "
    [join-strings " " [map-list format-param [get "params" node]]]
    "] "
    [format-node [get "body" node] 0]
    "]"]]

format-param: [fn@[return: String  doc: """Format a function parameter with optional annotation."""] [let param@Dict]
  [str
    [get "name" param]
    [if [not [empty? [get "annotation" param]]]
      [str "@" [format-annotation [get "annotation" param]]]
      ""]
    [if [get "variadic" param] "..." ""]]]

format-annotation: [fn@[return: String  doc: """Format a type annotation."""] [let ann@Dict]
  [match [get "kind" ann]
    "simple": [get "value" ann]
    "quote":  "Expr"
    "dict":   [str "["
                [join-strings " "
                  [map-list
                    [fn [let e] [str [get "key" e] ": " [format-annotation-value [get "value" e]]]]
                    [get "entries" ann]]]
                "]"]
    ...:      [error [str "unknown annotation kind: " [get "kind" ann]]]]]

format-annotation-value: [fn@[return: String  doc: """Format an annotation value (string, int, or nested AST node)."""] [let v]
  [if [str? v]
    v
    [if [int? v]
      [str v]
      [format-node v 0]]]]

format-type-alias: [fn@[return: String  doc: """Format type alias: `expr"""] [let node]
  [str "`" [format-node [get "expr" node] 0]]]

format-type-assert: [fn@[return: String  doc: """Format type assert: expr@Ann"""] [let node]
  [str
    [format-node [get "expr" node] 0]
    "@"
    [format-annotation [get "annotation" node]]]]

format-annotated: [fn@[return: String  doc: """Format annotated: @Name ann"""] [let node]
  [str
    "@"
    [get "name" node]
    " "
    [format-annotation [get "annotation" node]]]]

format-rest: [fn@[return: String  doc: """Format rest: ... or ...name"""] [let node]
  [if [empty? [get "name" node]]
    "..."
    [str "..." [get "name" node]]]]

format-quote: [fn@[return: String  doc: """Format quote: [quote expr]"""] [let node indent@Integer]
  [str "[quote " [format-node [get "expr" node] indent] "]"]]

format-unquote: [fn@[return: String  doc: """Format unquote: [unquote expr]"""] [let node indent@Integer]
  [str "[unquote " [format-node [get "expr" node] indent] "]"]]

format-unquote-splice: [fn@[return: String  doc: """Format unquote-splice: [unquote-splice expr]"""] [let node indent@Integer]
  [str "[unquote-splice " [format-node [get "expr" node] indent] "]"]]

format-macrodecl: [fn@[return: String  doc: """Format macro declaration: [macro name params body]"""] [let node indent@Integer]
  [str "[macro " [get "name" node] " " [format-node [get "params" node] indent] " " [format-node [get "body" node] indent] "]"]]

format-splice: [fn@[return: String  doc: """Format splice: [splice form ...]"""] [let node indent@Integer]
  [str "[splice " [join-strings " " [map-list [fn [let f] [format-node f indent]] [get "forms" node]]] "]"]]

format-syntax-class: [fn@[return: String  doc: """Format syntax-class declaration: [syntax-class name pattern]"""] [let node]
  [str "[syntax-class " [get "name" node] " " [format-node [get "pattern" node] 0] "]"]]

format-match: [fn@[return: String  doc: """Format match with one arm per line."""] [let node indent@Integer]
  [str
    "[match "
    [format-node [get "scrutinee" node] indent]
    [format-match-arms [get "arms" node] indent]
    "]"]]

format-match-arms: [fn@[return: String] [let arms@Dict indent@Integer]
  [format-match-arms-impl arms indent 0 ""]]

format-match-arms-impl: [fn@[return: String] [let arms@Dict indent@Integer i@Integer acc@String]
  [if [>= i [length arms]]
    acc
    [format-match-arms-impl
      arms
      indent
      [+ i 1]
      [str acc
        "\n"
        [str-repeat [+ indent indent-size] " "]
        [format-pattern [get "pattern" [get i arms]]]
        ": "
        [format-node [get "body" [get i arms]] [+ indent indent-size]]]]]]

format-class: [fn@[return: String  doc: """Format class declaration."""] [let node]
  [str
    "[class [let "
    [get "name" node]
    [if [> [length [get "params" node]] 0]
      [str " " [join-strings " " [map-list [fn [let p] p] [get "params" node]]]]
      ""]
    "]"
    # Emit structural metadata bracket if determines/resolver/injective present
    [if [or [field-has? node "determines"]
            [or [field-has? node "resolver"]
                [and [field-has? node "injective"] [get "injective" node]]]]
      [str " ["
        [if [field-has? node "determines"]
          [str "determines: [" [join-strings " " [map-list [fn [let fd] [render-inline fd]] [get "determines" node]]] "]"]
          ""]
        [if [field-has? node "resolver"]
          [str [if [field-has? node "determines"] " " ""] "resolver: " [render-inline [get "resolver" node]]]
          ""]
        [if [and [field-has? node "injective"] [get "injective" node]]
          [str [if [or [field-has? node "determines"] [field-has? node "resolver"]] " " ""] "injective: true"]
          ""]
        "]"]
      ""]
    # Emit methods (methods is a dict with method-name: type-expr entries)
    [if [> [length [get "methods" node]] 0]
      [str " " [join-strings " " [map-list [fn [let method-name] [str method-name ": " [render-inline [get method-name [get "methods" node]]]]] [keys [get "methods" node]]]]]
      ""]
    "]"]]

format-instance: [fn@[return: String  doc: """Format instance declaration. Emits class name and arms count; full arm formatting is a TODO."""] [let node]
  [str
    "[instance "
    [get "class" node]
    [if [> [length [get "arms" node]] 0]
      [str " <" [str [length [get "arms" node]]] " arm(s)>"]
      ""]
    "]"]]

# ---- Document & File formatters ----

format-document: [fn@[return: String  doc: """Format a document: expressions separated by double newlines."""] [let doc@Dict]
  [str
    [if [field-has? doc "leading-comments"]
      [str [emit-leading-comments [get "leading-comments" doc] 0] "\n\n"]
      ""]
    [format-expressions [get "expressions" doc]]]]

format-expressions: [fn@[return: String] [let exprs@Dict]
  [format-expressions-impl exprs 0 ""]]

format-expressions-impl: [fn@[return: String] [let exprs@Dict i@Integer acc@String]
  [if [>= i [length exprs]]
    acc
    [format-expressions-impl
      exprs
      [+ i 1]
      [str
        acc
        [if [> i 0] "\n\n" ""]
        [format-node [get i exprs] 0]]]]]

format-file: [fn@[return: String  doc: """Format a file: documents joined with '---' separators."""] [let file@Dict]
  [format-file-impl [get "documents" file] 0 ""]]

format-file-impl: [fn@[return: String] [let docs@Dict i@Integer acc@String]
  [if [>= i [length docs]]
    [str acc "\n"]
    [format-file-impl
      docs
      [+ i 1]
      [str
        acc
        [if [> i 0]
          [str "\n\n---"
            [format-doc-header [get i docs]]
            "\n\n"]
          ""]
        [format-document [get i docs]]]]]]

format-doc-header: [fn@[return: String  doc: """Format document section header (name, output type, expects)."""] [let doc@Dict]
  [str
    [if [not [empty? [get "name" doc]]]
      [str " %" [get "name" doc]]
      ""]
    [if [not [empty? [get "output-type" doc]]]
      [str "@" [format-annotation [get "output-type" doc]]]
      ""]
    [if [not [empty? [get "expects" doc]]]
      [str " expects: @" [format-annotation [get "expects" doc]]]
      ""]]]

]

[format-file %]
