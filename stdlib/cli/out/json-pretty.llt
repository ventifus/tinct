# JSON Pretty Formatter — concurrent drain/force/await contract.
#
# Produces indented JSON output with 2-space indentation.
# Empty dicts/arrays render compactly as {} or [].
# Each record is separated by a blank line (not NDJSON — multi-line format).
#
# Concurrent contract:
# 1. Drain %emit-channel: write each emitted value as pretty JSON
# 2. Force %: write the return value (or each Seq element) as pretty JSON
# 3. Await drain task completion
#
# Uses to-json-pretty from stdlib/codecs/json.llt.

[json: [include %libdir "codecs/json.llt"]]

# 1. Drain the emit channel concurrently.
[drain: [task
  [loop-select [context]
    [seq [ch: %emit-channel  handler: [fn [let v]
      [write-handle %stdout [str [call $json.to-json-pretty v] "\n\n"]]]] []]
    identity]]]

# 2. Force the return value to drive the lazy evaluation cascade.
[_: [if [seq? %]
  [reduce [fn [let _ x]
    [write-handle %stdout [str [call $json.to-json-pretty x] "\n\n"]]] [] %]
  [write-handle %stdout [str [call $json.to-json-pretty %] "\n\n"]]]]

# 3. Wait for drain to finish consuming any emits triggered during forcing.
[_: [await drain]]

# 4. Flush stdout.
[flush %stdout]
