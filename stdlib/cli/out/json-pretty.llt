# JSON Pretty Formatter — dependency-chain contract.
#
# %stdout threads through every write: return value, then emitted values, then flush.
# Uses to-json-pretty from stdlib/codecs/json.llt.

[json: [include %libdir "codecs/json.llt"]]

--- uses: ["async"]
[
  written: [if [seq? %]
    [reduce [fn [let h x] [write [str [json.to-json-pretty x] "\n\n"] h]] %stdout %]
    [write [str [json.to-json-pretty %] "\n\n"] %stdout]]

  write-emits: [fn [let h] [reduce [fn [let h v] [write [str [json.to-json-pretty v] "\n\n"] h]] h [recv-all %emit-channel]]]
]

[$written | write-emits | flush]
