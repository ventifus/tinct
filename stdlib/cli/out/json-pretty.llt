# JSON Pretty Formatter — uses to-json-pretty from stdlib/codecs/json.llt.
#
# Produces indented JSON output with 2-space indentation.
# Empty dicts/arrays render compactly as {} or [].
#
# Returns a String (the formatted JSON output). No emit calls.

[json: [include %libdir "codecs/json.llt"]]
[str [call $json.to-json-pretty %] "\n"]
