# JSON Pretty Formatter — delegates to stdlib/codecs/json.llt (runtime-v2)
#
# Uses the same codecs/json.llt as the compact formatter.
# Pretty-printing with indentation is a TODO for codecs/json.llt.
# For now, produces compact JSON (same as json.llt).

[include %libdir "codecs/json.llt"]

[emit [to-json %]]
