# TOML Formatter
# Convert a tinct value to TOML format

# Private helpers
[
# Internal: quote and escape a string for TOML
toml-quote: [fn@String [let s@String]
  [str "\"" s "\""]]

# Internal: check if dict is list-shaped (integer keys only)
toml-list?: [fn@Boolean [let d@Dict]
  [if [empty? d]
    false
    [all? [fn [let k] [int? k]] [keys d]]]]

# Internal: format a scalar value
toml-scalar: [fn@String [let val@Any]
  [cond [
    [[null? val] "null"]
    [[bool? val] [if val "true" "false"]]
    [[int? val] [str val]]
    [[float? val] [str val]]
    [[str? val] [toml-quote val]]
    [[seq? val] [raise "cannot serialize Seq to TOML — use | collect"]]
    [true "null"]
  ]]]

# Internal: format inline array
toml-array: [fn@String [let d@Dict]
  [if [empty? d]
    "[]"
    [str "[" [toml-array-items d 0] "]"]]]

toml-array-items: [fn@String [let d@Dict i@Integer]
  [if [>= i [length d]]
    ""
    [str
      [toml-scalar [get i d]]
      [if [< [+ i 1] [length d]] ", " ""]
      [toml-array-items d [+ i 1]]]]]

# Internal: separate flat keys from table keys
toml-partition: [fn@Dict [let d@Dict ks@Dict i@Integer flat-keys@Dict table-keys@Dict]
  [if [>= i [length ks]]
    [flat: flat-keys  tables: table-keys]
    [if [dict? [get [get i ks] d]]
      [toml-partition d ks [+ i 1] flat-keys [append [get i ks] table-keys]]
      [toml-partition d ks [+ i 1] [append [get i ks] flat-keys] table-keys]]]]

# Internal: format flat key-value pairs
toml-flat: [fn@String [let d@Dict ks@Dict i@Integer acc@String]
  [if [>= i [length ks]]
    acc
    [toml-flat d ks [+ i 1]
      [str acc [get i ks] " = " [toml-value [get [get i ks] d]] "\n"]]]]

# Internal: format tables (nested dicts) — calls toml-rec for recursive sub-dicts
toml-tables: [fn@String [let d@Dict ks@Dict i@Integer acc@String]
  [if [>= i [length ks]]
    acc
    [toml-tables d ks [+ i 1]
      [str acc "\n[" [get i ks] "]\n" [toml-rec [get [get i ks] d]]]]]]

# Internal: format a value (scalar or inline array)
toml-value: [fn@String [let val@Any]
  [if [dict? val]
    [if [toml-list? val]
      [toml-array val]
      "{}"]
    [toml-scalar val]]]

# Internal: recursive entry point for sub-dicts (avoids referencing the public toml)
toml-rec: [fn@String [let d@Dict]
  [if [empty? d]
    ""
    [toml-impl d [toml-partition d [keys d] 0 [] []]]]]

# Internal: format dict given pre-partitioned flat/table keys
toml-impl: [fn@String [let d@Dict parts@Dict]
  [str
    [toml-flat d parts.flat 0 ""]
    [toml-tables d parts.tables 0 ""]]]
]

# Public API
[
# Public API: format dict to TOML
toml@[doc: "Convert dict to TOML format (flat keys + tables)"]: [fn@String [let d@Dict]
  [if [empty? d]
    ""
    [toml-impl d [toml-partition d [keys d] 0 [] []]]]]
]

--- uses: ["async"]
# TOML output formatter — dependency-chain contract.
# %stdout threads through every write: return value, then emitted values, then flush.
[
  written: [if [seq? %]
    [reduce [fn [let h x] [write [str [toml x] "\n"] h]] %stdout %]
    [write [str [toml %] "\n"] %stdout]]

  write-emits: [fn [let h] [reduce [fn [let h v] [write [str [toml v] "\n"] h]] h [recv-all %emit-channel]]]
]

[$written | write-emits | flush]
