# TOML Formatter
# Convert a tinct value to TOML format

[
# Internal: quote and escape a string for TOML
toml-quote: [fn@String [let s@String]
  [str "\"" s "\""]]

# Internal: check if dict is list-shaped (integer keys only)
toml-list?: [fn@Bool [let d@Dict]
  [if [empty? d]
    false
    [all? [fn [let k] [int? k]] [keys d]]]]

# Internal: format a scalar value
toml-scalar: [fn@String [let val@Any]
  [cond [
    [[null? val] "null"]
    [[bool? val] [if val "true" "false"]]
    [[int? val] [str val]]
    [[float? val] [str val]]
    [[str? val] [toml-quote val]]
    [[seq? val] [raise "cannot serialize Seq to TOML — use | collect"]]
    [true "null"]
  ]]]

# Internal: format inline array
toml-array: [fn@String [let d@Dict]
  [if [empty? d]
    "[]"
    [str "[" [toml-array-items d 0] "]"]]]

toml-array-items: [fn@String [let d@Dict i@Int]
  [if [>= i [length d]]
    ""
    [str
      [toml-scalar [get i d]]
      [if [< [+ i 1] [length d]] ", " ""]
      [toml-array-items d [+ i 1]]]]]

# Internal: separate flat keys from table keys
toml-partition: [fn@Dict [let d@Dict ks@Dict i@Int flat-keys@Dict table-keys@Dict]
  [if [>= i [length ks]]
    [flat: flat-keys  tables: table-keys]
    [if [dict? [get [get i ks] d]]
      [toml-partition d ks [+ i 1] flat-keys [append table-keys [get i ks]]]
      [toml-partition d ks [+ i 1] [append flat-keys [get i ks]] table-keys]]]]

# Internal: format flat key-value pairs
toml-flat: [fn@String [let d@Dict ks@Dict i@Int acc@String]
  [if [>= i [length ks]]
    acc
    [toml-flat d ks [+ i 1]
      [str acc [get i ks] " = " [toml-value [get [get i ks] d]] "\n"]]]]

# Internal: format tables (nested dicts)
toml-tables: [fn@String [let d@Dict ks@Dict i@Int acc@String]
  [if [>= i [length ks]]
    acc
    [toml-tables d ks [+ i 1]
      [str acc "\n[" [get i ks] "]\n" [toml [get [get i ks] d]]]]]]

# Internal: format a value (scalar or inline array)
toml-value: [fn@String [let val@Any]
  [if [dict? val]
    [if [toml-list? val]
      [toml-array val]
      "{}"]
    [toml-scalar val]]]

# Public API: format dict to TOML
toml@[doc: "Convert dict to TOML format (flat keys + tables)"]: [fn@String [let d@Dict]
  [if [empty? d]
    ""
    [toml-impl d [toml-partition d [keys d] 0 [] []]]]]

toml-impl: [fn@String [let d@Dict parts@Dict]
  [str
    [toml-flat d parts.flat 0 ""]
    [toml-tables d parts.tables 0 ""]]]
]
