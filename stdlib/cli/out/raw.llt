# Raw output formatter — dependency-chain contract.
#
# Emits each value as its string representation (strings written directly,
# other values converted via str).
# %stdout threads through every write: return value, then emitted values, then flush.

[
  raw: [fn@String [let v@Any] [str v]]
]

--- uses: ["async"]
[
  # Only write % if non-null ([] means output was entirely via emit).
  written: [if [seq? %]
    [reduce [fn [let h x] [write [raw x] h]] %stdout %]
    [if [= [] %]
      %stdout
      [write [raw %] %stdout]]]

  write-emits: [fn [let h] [reduce [fn [let h v] [write [raw v] h]] h [recv-all %emit-channel]]]
]

[$written | write-emits | flush]
