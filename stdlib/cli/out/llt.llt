# LLT display format output formatter — dependency-chain contract.
#
# %stdout threads through every write: return value, then emitted values, then flush.

--- uses: ["async"]
[
  written: [if [seq? %]
    [reduce [fn [let h x] [write [str [llt-repr x] "\n"] h]] %stdout %]
    [write [str [llt-repr %] "\n"] %stdout]]

  write-emits: [fn [let h] [reduce [fn [let h v] [write [str [llt-repr v] "\n"] h]] h [recv-all %emit-channel]]]
]

[$written | write-emits | flush]
