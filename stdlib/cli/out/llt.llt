# LLT display format output formatter.
#
# Converts the pipeline input (%) to its LLT representation string and writes to %stdout.
# Uses llt-repr which traverses and formats the value, materializing nested thunks on demand.
#
# %stdout is a protocol dict with write/flush/close methods. The formatter calls
# %stdout.write and %stdout.flush — no standalone typeclass method dispatch needed.
[written: [call [builtin-dict-get "write" %stdout] [builtin-string-concat [builtin-llt-repr %] "\n"] %stdout]]
[call [builtin-dict-get "flush" %stdout] written]
