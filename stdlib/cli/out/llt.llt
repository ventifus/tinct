# LLT display format output formatter.
# Single document, no nested closures, no field access.

--- uses: ["async"]
[result: [if [seq? %]
  [reduce
    [fn [let acc x] [StringWriter.Writer cells: [str acc.cells [llt-repr x] "\n"]]]
    [StringWriter.Writer cells: ""]
    %]
  [StringWriter.Writer cells: [str [llt-repr %] "\n"]]]]

result
