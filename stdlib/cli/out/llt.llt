# LLT display format output formatter — concurrent drain/force/await contract.
#
# Converts each value to its LLT representation string: Int(42), Dict({...}), etc.
# Uses the llt-repr builtin which deep-materializes and formats the value.
#
# Concurrent contract:
# 1. Drain %emit: write each emitted value as llt-repr
# 2. Force %: write the return value (or each Seq element) as llt-repr
# 3. Await drain task completion

# 1. Drain the emit channel concurrently.
[drain: [task
  [loop-select [context]
    [seq [ch: %emit  handler: [fn [let v]
      [write-handle %stdout [str [call $llt-repr v] "\n"]]]] []]
    identity]]]

# 2. Force the return value to drive the lazy evaluation cascade.
[if [seq? %]
  [reduce [fn [let _ x]
    [write-handle %stdout [str [call $llt-repr x] "\n"]]] [] %]
  [write-handle %stdout [str [call $llt-repr %] "\n"]]]

# 3. Wait for drain to finish consuming any emits triggered during forcing.
[await drain]
