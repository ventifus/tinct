# LLT display format output formatter — dependency-chain contract.
#
# All work is expressed as a single data dependency chain rooted at the final
# expression. Forcing the final expression cascades to force every step.
#
# Pipeline: $written forces %, writes output; fn awaits drain (collecting emits);
# flush receives the handle and flushes. Return values thread through | so no
# step is lazy and the final expression genuinely depends on all prior work.

--- uses: ["async"]
[drain: [task [select [context]
  [seq [ch: %emit-channel  handler: [fn [let v] [write [str [llt-repr v] "\n"] %stdout]]] []]
  identity]]]

[written: [if [seq? %]
  [reduce [fn [let h x] [write [str [llt-repr x] "\n"] h]] %stdout %]
  [write [str [llt-repr %] "\n"] %stdout]]]

[$written | [fn [let h] [match [await drain] ...: h]] | flush]
