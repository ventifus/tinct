# ENV Formatter
# Convert a flat dict to KEY=VALUE format for .env files

# Private helpers
[
# Internal: format a single entry
env-entry: [fn@String [let k@String v]
  [str k "=" v "\n"]]

# Internal: format all entries
env-entries: [fn@String [let d@Dict ks@Dict i@Integer acc@String]
  [if [>= i [length ks]]
    acc
    [env-entries d ks [+ i 1]
      [str acc [env-entry [get i ks] [get [get i ks] d]]]]]]
]

# Public API
[
# Public API: format flat dict to ENV format
env@[doc: "Convert flat dict to KEY=VALUE format (.env file)"]: [fn@String [let d@Dict]
  [if [empty? d]
    ""
    [env-entries d [keys d] 0 ""]]]
]

--- uses: ["async"]
# ENV output formatter — concurrent drain/force/await contract.
#
# Produces KEY=VALUE format output (.env file format).
# Each value should be a flat dict.
#
# Concurrent contract:
# 1. Drain %emit-channel: write each emitted value as ENV format
# 2. Force %: write the return value (or each Seq element) as ENV format
# 3. Await drain task completion

# 1. Drain the emit channel concurrently.
[drain: [task
  [select [context]
    [seq [ch: %emit-channel  handler: [fn [let v]
      [write [env v] %stdout]]] []]
    identity]]]

[written: [if [seq? %]
  [reduce [fn [let h x] [write [env x] h]] %stdout %]
  [write [env %] %stdout]]]

[$written | [fn [let h] [match [await drain] ...: h]] | flush]
