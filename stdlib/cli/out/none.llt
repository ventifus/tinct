# Output: none — silent output formatter: materializes % for side effects, discards all output.
# %stdout threads through the pipeline as the handle; all values are discarded.

--- uses: ["async"]
[
  # Materialize % and produce %stdout as the handle consumed by flush.
  handle: [if [seq? %]
    [reduce [fn [let h _] h] %stdout %]
    [match [materialize %] ...: %stdout]]

  discard-emits: [fn [let h] [reduce [fn [let h _] h] h [recv-all %emit-channel]]]
]

[$handle | discard-emits | flush]
