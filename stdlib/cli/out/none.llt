# Output: none — silent output formatter: materializes % for side effects, discards all output.
#
# Concurrent contract:
# 1. Drain %emit-channel: discard all emitted values
# 2. Materialize %: consume for side effects, write nothing
# 3. Consume drain result before flushing

--- uses: ["async"]
[drain: [task
  [select [context]
    [seq [ch: %emit-channel  handler: [fn [let v] []]] []]
    identity]]]

# Materialize % and produce %stdout as the handle consumed by flush.
[handle: [if [seq? %]
  [reduce [fn [let h _] h] %stdout %]
  [match [materialize %] ...: %stdout]]]

[$handle | [fn [let h] [match [await drain] ...: h]] | flush]
