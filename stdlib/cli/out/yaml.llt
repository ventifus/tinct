# YAML Formatter
# Convert a tinct value to YAML 1.2 string

# Private helpers
[
# Internal: check if string needs quoting
yaml-needs-quote?: [fn@Boolean [let s@String]
  [or
    [= s ""]
    [or [= s "true"] [or [= s "false"] [or [= s "null"]
      [or [= s "~"] [= s "yes"]]]]]]]

# Internal: quote a string for YAML
yaml-quote: [fn@String [let s@String]
  [if [yaml-needs-quote? s]
    [str "\"" s "\""]
    s]]

# Internal: check if dict is list-shaped (integer keys only)
yaml-list?: [fn@Boolean [let d@Dict]
  [if [empty? d]
    false
    [all? [fn [let k] [int? k]] [keys d]]]]

# Internal: format a value at given indentation level
yaml-value: [fn@String [let val@Any indent@Integer]
  [cond [
    [[null? val] "null"]
    [[bool? val] [if val "true" "false"]]
    [[int? val] [str val]]
    [[float? val] [str val]]
    [[str? val] [yaml-quote val]]
    [[seq? val] [raise "cannot serialize Seq to YAML — use | collect"]]
    [[dict? val] [yaml-object val indent]]
    [true "null"]
  ]]]

# Internal: format dict as YAML object or list
yaml-object: [fn@String [let d@Dict indent@Integer]
  [if [yaml-list? d]
    [yaml-list d indent]
    [yaml-dict d indent]]]

# Internal: format dict as YAML list
yaml-list: [fn@String [let d@Dict indent@Integer]
  [if [empty? d]
    "[]"
    [str "\n" [yaml-list-items d indent 0]]]]

yaml-list-items: [fn@String [let d@Dict indent@Integer i@Integer]
  [if [>= i [length d]]
    ""
    [yaml-list-item d indent i]]]

yaml-list-item: [fn@String [let d@Dict indent@Integer i@Integer]
  [str
    [join "" [take indent [repeat " "]]]
    "- "
    [yaml-list-value [get i d] [+ indent 2]]
    [if [< [+ i 1] [length d]] "\n" ""]
    [yaml-list-items d indent [+ i 1]]]]

yaml-list-value: [fn@String [let val@Any indent@Integer]
  [if [dict? val]
    [if [yaml-list? val]
      [yaml-list val indent]
      [yaml-dict-inline val indent]]
    [yaml-value val indent]]]

# Internal: format inline dict (after list item)
yaml-dict-inline: [fn@String [let d@Dict indent@Integer]
  [if [empty? d]
    "{}"
    [yaml-dict-entries d indent [keys d] 0]]]

# Internal: format dict as YAML mapping
yaml-dict: [fn@String [let d@Dict indent@Integer]
  [if [empty? d]
    "{}"
    [str "\n" [yaml-dict-entries d indent [keys d] 0]]]]

yaml-dict-entries: [fn@String [let d@Dict indent@Integer ks@Dict i@Integer]
  [if [>= i [length ks]]
    ""
    [yaml-dict-entry d indent ks i]]]

yaml-dict-entry: [fn@String [let d@Dict indent@Integer ks@Dict i@Integer]
  [str
    [join "" [take indent [repeat " "]]]
    [get i ks]
    ": "
    [yaml-dict-value [get [get i ks] d] [+ indent 2]]
    [if [< [+ i 1] [length ks]] "\n" ""]
    [yaml-dict-entries d indent ks [+ i 1]]]]

yaml-dict-value: [fn@String [let val@Any indent@Integer]
  [if [dict? val]
    [if [yaml-list? val]
      [yaml-list val indent]
      [yaml-dict val indent]]
    [yaml-value val indent]]]
]

# Public API
[
# Public API: format value to YAML
yaml@[doc: "Convert value to YAML 1.2 string"]: [fn@String [let val@Any]
  [if [dict? val]
    [if [yaml-list? val]
      [str [yaml-list val 0] "\n"]
      [str [yaml-dict val 0] "\n"]]
    [str [yaml-value val 0] "\n"]]]
]

--- uses: ["async"]
# YAML output formatter — concurrent drain/force/await contract.
#
# Produces YAML 1.2 output for each emitted value and return value.
#
# Concurrent contract:
# 1. Drain %emit-channel: write each emitted value as YAML
# 2. Force %: write the return value (or each Seq element) as YAML
# 3. Await drain task completion

# 1. Drain the emit channel concurrently.
[drain: [task
  [select [context]
    [seq [ch: %emit-channel  handler: [fn [let v]
      [write [str [yaml v] "\n"] %stdout]]] []]
    identity]]]

# 2. Force the return value to drive the lazy evaluation cascade.
[_: [if [seq? %]
  [reduce [fn [let h x] [write [str [yaml x] "\n"] h]] %stdout %]
  [write [str [yaml %] "\n"] %stdout]]]

# 3. Wait for drain to finish consuming any emits triggered during forcing.
[_: [await drain]]

# 4. Flush stdout.
[flush %stdout]
