# Stream output formatter — dependency-chain contract.
#
# Serializes emitted values and return values to their tinct SCN representation
# using to-tinct. Each value becomes a single-line tinct expression followed by
# a newline.

--- uses: ["async"]
[drain: [task
  [select [context]
    [seq [ch: %emit-channel  handler: [fn [let v]
      [write [str [to-tinct v] "\n"] %stdout]]] []]
    identity]]]

[written: [if [seq? %]
  [reduce [fn [let h x] [write [str [to-tinct x] "\n"] h]] %stdout %]
  [write [str [to-tinct %] "\n"] %stdout]]]

[$written | [fn [let h] [match [await drain] ...: h]] | flush]
