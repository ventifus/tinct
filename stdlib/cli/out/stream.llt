# Stream output formatter — dependency-chain contract.
#
# Serializes return value and emitted values to tinct SCN format.
# %stdout threads through every write: return value, then emitted values, then flush.

--- uses: ["async"]
[
  written: [if [seq? %]
    [reduce [fn [let h x] [write [str [to-tinct x] "\n"] h]] %stdout %]
    [write [str [to-tinct %] "\n"] %stdout]]

  write-emits: [fn [let h] [reduce [fn [let h v] [write [str [to-tinct v] "\n"] h]] h [recv-all %emit-channel]]]
]

[$written | write-emits | flush]
