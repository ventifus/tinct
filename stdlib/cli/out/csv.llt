# CSV Output Formatter — dependency-chain contract.
#
# Column order is fixed by the first record encountered (from % or %emit-channel).
# Subsequent records use the same column order; missing keys produce empty cells.
# %stdout threads through every write: return value rows, then emitted rows, then flush.

# Private helpers
[
csv-quote: [fn@String [let s@String]
  [str "\"" [replace "\"" "\"\"" s] "\""]]

csv-header: [fn@String [let ks@Dict i@Integer acc@String]
  [if [>= i [length ks]]
    [str acc "\n"]
    [csv-header ks [+ i 1]
      [str acc [if [> i 0] "," ""] [csv-quote [get i ks]]]]]]

csv-row: [fn@String [let row@Dict ks@Dict i@Integer acc@String]
  [if [>= i [length ks]]
    [str acc "\n"]
    [csv-row row ks [+ i 1]
      [str acc [if [> i 0] "," ""] [csv-quote [str [get-or [get i ks] "" row]]]]]]]]

--- uses: ["async"]
[
  # Shared column state: [] = not yet set; set from the first dict value encountered.
  columns: [reactive-cell []]

  # Write one dict value as a CSV row. Sets header from first call.
  write-row: [fn [let h v]
    [match [cell-get columns]
      []: [do [cell-set columns [keys v]]
              [write [csv-header [keys v] 0 ""] h]
              [write [csv-row v [keys v] 0 ""] h]]
      ...: [write [csv-row v [cell-get columns] 0 ""] h]]]

  # Consume % and write all dict records; non-dict values are skipped.
  written: [if [seq? %]
    [reduce [fn [let h x] [if [dict? x] [write-row h x] h]] %stdout %]
    [if [dict? %] [write-row %stdout %] %stdout]]

  # Write all emitted values (same column order, header already set).
  write-emits: [fn [let h] [reduce [fn [let h v] [if [dict? v] [write-row h v] h]] h [recv-all %emit-channel]]]
]

[$written | write-emits | flush]
