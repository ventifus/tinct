# CSV Streaming Output Formatter — Phase 2 data-streaming contract
#
# Responsibilities:
# 1. Drain %emit — receive emitted values as they arrive; serialize each to stdout
# 2. Force % — materialize the lazy return value to drive evaluation cascade
# 3. Await both before exiting
#
# Column order is fixed by the first record (from %emit or %).
# Subsequent records with different keys produce empty cells for missing columns.

# Private helpers
[
# Internal: quote and escape a CSV field
# Always quote to avoid checking for special characters
csv-quote: [fn@String [let s@String]
  [str "\"" [replace "\"" "\"\"" s] "\""]]

# Internal: format header row
csv-header: [fn@String [let ks@Dict i@Int acc@String]
  [if [>= i [length ks]]
    [str acc "\n"]
    [csv-header ks [+ i 1]
      [str acc [if [> i 0] "," ""] [csv-quote [get i ks]]]]]]

# Internal: format a single data row using pre-determined column order
csv-row: [fn@String [let row@Dict ks@Dict i@Int acc@String]
  [if [>= i [length ks]]
    [str acc "\n"]
    [csv-row row ks [+ i 1]
      [str acc [if [> i 0] "," ""] [csv-quote [str [get-or [get i ks] "" row]]]]]]]
]

# Streaming contract implementation — sequential document expressions
[
# 1. Reactive cell to hold column headers once the first record arrives.
#    Starts empty; set atomically by whichever record arrives first.
headers: [reactive-cell []]

# 2. Start the drain task BEFORE forcing %, so lazy emits are consumed as
#    they are triggered. The drain sets headers from the first record and
#    writes the header line + every data row.
drain: [task
  [loop-select [context]
    [seq [ch: %emit  handler: [fn [let v]
      [if [= [cell-get headers] []]
        # First record: establish column order, write header + first row
        [do [cell-set headers [keys v]]
            [write-handle %stdout [csv-header [keys v] 0 ""]]
            [write-handle %stdout [csv-row v [keys v] 0 ""]]]
        # Subsequent records: use captured column order
        [write-handle %stdout [csv-row v [cell-get headers] 0 ""]]]]] []]
    identity]]

# 3. Force % to drive the lazy evaluation cascade.
#    If % is a Seq, write each element as a data row.
#    If % is a scalar dict, write it as a data row.
#    Column headers are set by whichever record (from %emit or %) arrives first.
[if [seq? %]
  # % is a Seq — write each element as a row
  [reduce [fn [let _ x]
    [if [= [cell-get headers] []]
      # First element sets the columns
      [do [cell-set headers [keys x]]
          [write-handle %stdout [csv-header [keys x] 0 ""]]
          [write-handle %stdout [csv-row x [keys x] 0 ""]]]
      # Subsequent elements use existing columns
      [write-handle %stdout [csv-row x [cell-get headers] 0 ""]]]]
    []
    %]
  # % is a scalar — if it's a dict, write it as a row
  [if [dict? %]
    [if [= [cell-get headers] []]
      [do [cell-set headers [keys %]]
          [write-handle %stdout [csv-header [keys %] 0 ""]]
          [write-handle %stdout [csv-row % [keys %] 0 ""]]]
      [write-handle %stdout [csv-row % [cell-get headers] 0 ""]]]
    []]]

# 4. Wait for drain to finish consuming any emits triggered during forcing.
[await drain]
]
