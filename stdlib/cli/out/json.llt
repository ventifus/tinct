# JSON Compact Formatter — delegates to stdlib/codecs/json.llt (runtime-v2)
#
# This file was previously a standalone JSON serializer. It now delegates
# to codecs/json.llt which uses Value::Expression match dispatch for
# Program/Document/Expression values, and handles all other types via
# to-json-primitive fallback.
#
# The old standalone implementation is deleted; codecs/json.llt is canonical.

[include %libdir "codecs/json.llt"]

[emit [to-json %]]
