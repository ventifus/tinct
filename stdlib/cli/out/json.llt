# JSON Compact Formatter — uses the prelude's to-json function.
#
# Serializes the pipeline input (%) to a compact JSON string using the
# to-json function from stdlib/prelude.llt.
#
# Handles: Int, Float, Bool, String, Dict, Seq, Null ([]).
# Unserializable values (Fn, Handle, Task, etc.) produce null.
#
# Returns a String (the formatted JSON output). No emit calls.

[call $to-json %]
