# JSON Compact Formatter — concurrent drain/force/await contract.
#
# Produces NDJSON-compatible output: one compact JSON object per line.
# Compatible with jq streaming and other NDJSON consumers.
#
# Concurrent contract:
# 1. Drain %emit: write each emitted value as compact JSON (one line per value)
# 2. Force %: serialize the return value as JSON
# 3. Await drain task completion
#
# Uses to-json from stdlib/codecs/json.llt.

[json: [include %libdir "codecs/json.llt"]]

# 1. Drain the emit channel concurrently.
[drain: [task
  [loop-select [context]
    [seq [ch: %emit  handler: [fn [let v]
      [write-handle %stdout [str [call $json.to-json v] "\n"]]]] []]
    identity]]]

# 2. Force the return value to drive the lazy evaluation cascade.
#    Forcing % drives program evaluation, triggering any emit calls.
[if [seq? %]
  [reduce [fn [let _ x]
    [write-handle %stdout [str [call $json.to-json x] "\n"]]] [] %]
  [write-handle %stdout [str [call $json.to-json %] "\n"]]]

# 3. Wait for drain to finish consuming any emits triggered during forcing.
[await drain]
