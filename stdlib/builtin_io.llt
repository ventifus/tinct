# builtin_io.llt — I/O, filesystem, and network primitive types.
# Bodies are Placeholder — valid tinct, errors if forced (builtins are Rust-side).
# Note: builtin-write-stdout, builtin-write-stderr are in builtin_core.llt (Core-46).
# builtin-file-open, builtin-file-read, builtin-list-dir, builtin-path-dir, builtin-narrow
# are also in builtin_core.llt (Core-46 — needed by loader.llt with only --- uses: ["core"]).
# builtin-file-open is declared only in builtin_core.llt; it is NOT redeclared here.

[
  # ── Opaque OS file handle ──────────────────────────────────────────────────
  File: [type File]

  # ── Filesystem: open / read / write / close ────────────────────────────────
  # builtin-file-open: declared in builtin_core.llt (registered in core_builtins()).
  builtin-file-read:     [fn@Bytes   [let f@File n@Integer] ...]
  builtin-file-write:    [fn@Integer [let f@File s@String] ...]
  builtin-file-flush:    [fn@Integer [let f@File] ...]
  builtin-file-close:    [fn@Integer [let f@File] ...]
  builtin-file-seek:     [fn@Integer [let f@File pos@Integer] ...]

  # ── Filesystem: atomic write and bulk I/O ─────────────────────────────────
  # write: write content (String or Bytes) to path; returns bytes written.
  builtin-write:         [fn@Integer [let cap@DirCap path@String content@Any] ...]
  # write-atomic: write content atomically (temp file + rename); returns bytes written.
  builtin-write-atomic:  [fn@Integer [let cap@DirCap path@String content@Any] ...]

  # ── Filesystem: metadata ───────────────────────────────────────────────────
  # stat: return {name: String, kind: String, size: Integer} for path (follows symlinks).
  builtin-stat:          [fn@Dict    [let cap@DirCap path@String] ...]
  # stat-symlink: same as stat but does not follow symlinks.
  builtin-stat-symlink:  [fn@Dict    [let cap@DirCap path@String] ...]
  # exists: return 1 if path exists, 0 otherwise.
  builtin-exists:        [fn@Integer [let cap@DirCap path@String] ...]
  # list-dir: return integer-indexed dict of {name: String, kind: String} entries.
  builtin-list-dir:      [fn@Dict    [let cap@DirCap path@String] ...]

  # ── Filesystem: directory and path operations ──────────────────────────────
  builtin-make-dir:      [fn@Integer [let cap@DirCap path@String] ...]
  builtin-rename:        [fn@Integer [let cap@DirCap from@String to@String] ...]
  builtin-copy-file:     [fn@Integer [let src-cap@DirCap src@String dst-cap@DirCap dst@String] ...]
  builtin-symlink:       [fn@Integer [let cap@DirCap path@String target@String] ...]
  builtin-link:          [fn@Integer [let cap@DirCap target@String link-path@String] ...]
  builtin-read-link:     [fn@String  [let cap@DirCap path@String] ...]
  builtin-set-permissions: [fn@Integer [let cap@DirCap path@String mode@Integer] ...]

  # ── Extended attributes ────────────────────────────────────────────────────
  builtin-get-xattr:     [fn@String  [let cap@DirCap path@String name@String] ...]
  builtin-set-xattr:     [fn@Integer [let cap@DirCap path@String name@String value@String] ...]
  builtin-remove-xattr:  [fn@Integer [let cap@DirCap path@String name@String] ...]
  builtin-list-xattrs:   [fn@Dict    [let cap@DirCap path@String] ...]

  # ── Filesystem: remove ────────────────────────────────────────────────────
  builtin-remove:        [fn@Integer [let cap@DirCap path@String] ...]

  # ── Capability operations ──────────────────────────────────────────────────
  # revocable: create a revocable wrapper around a DirCap.
  builtin-revocable:     [fn@DirCap  [let cap@DirCap] ...]
  # revoke-cap: revoke a previously created revocable capability.
  builtin-revoke-cap:    [fn@Integer [let cap@DirCap] ...]

  # ── Output and environment ─────────────────────────────────────────────────
  # emit: write a value to stdout (side effect, returns []).
  builtin-emit:          [fn@Dict    [let x@Any] ...]
  # env: read an OS environment variable by name.
  builtin-env:           [fn@String  [let name@String] ...]
  # env-has?: check if an OS environment variable is set (returns Integer 1/0).
  builtin-env-has?:      [fn@Integer [let name@String] ...]

  # ── Stateless stdin ────────────────────────────────────────────────────────
  # read-stdin: read up to n bytes from stdin.
  builtin-read-stdin:    [fn@Bytes   [let n@Integer] ...]

  # ── Network ────────────────────────────────────────────────────────────────
  # connect: open a network connection, return an opaque stream handle.
  builtin-connect:       [fn@Handle  [let cap@NetCap addr@String ...opts] ...]
  # tls-layer: wrap a stream with TLS, return a TLS stream handle.
  builtin-tls-layer:     [fn@Handle  [let stream@Handle host@String opts@Dict] ...]
  # tls-peer-cert: extract the peer certificate from a TLS stream (as a Dict).
  builtin-tls-peer-cert: [fn@Dict    [let stream@Handle] ...]
  # send-datagram: send a QUIC unreliable datagram (RFC 9221); returns null [] on success.
  # data: String or Bytes payload; handle: QuicDatagramHandle from quic-open-datagram.
  builtin-send-datagram: [fn@Dict [let data@Any  handle@Any] ...]
  # recv-datagram: receive a QUIC unreliable datagram; returns {data: Bytes}.
  # handle: QuicDatagramHandle from quic-open-datagram.
  builtin-recv-datagram: [fn@Dict [let handle@Any] ...]
]
