{
  "name": "tinct",
  "displayName": "Tinct",
  "description": "Tinct language support — diagnostics and hover types",
  "version": "0.1.0",
  "publisher": "tinct",
  "repository": {
    "type": "git",
    "url": "https://github.com/ventifus/tinct"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:llt"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "llt",
        "aliases": ["Tinct", "llt"],
        "extensions": [".llt", ".tinct"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "llt",
        "scopeName": "source.llt",
        "path": "./syntaxes/tinct.tmLanguage.json"
      },
      {
        "scopeName": "markdown.llt.codeblock",
        "path": "./syntaxes/tinct.markdown-injection.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.llt": "llt"
        }
      }
    ],
    "configuration": {
      "title": "tinct",
      "properties": {
        "tinct.serverPath": {
          "type": "string",
          "default": "tinct",
          "description": "Path to the tinct binary. Defaults to 'tinct' (must be on PATH). Set to an absolute path or 'cargo run --' for development."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package"
  }
}
