{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tinct",
  "scopeName": "source.llt",
  "patterns": [
    { "include": "#comment" },
    { "include": "#document-separator" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#boolean" },
    { "include": "#special-form" },
    { "include": "#type-annotation" },
    { "include": "#variable" },
    { "include": "#bracket" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.llt",
      "match": "#.*$"
    },
    "document-separator": {
      "name": "keyword.other.document-separator.llt",
      "match": "^---$"
    },
    "string": {
      "name": "string.quoted.double.llt",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.llt",
          "match": "\\\\."
        }
      ]
    },
    "number": {
      "name": "constant.numeric.llt",
      "match": "-?\\b(?:\\d+\\.\\d+|\\d+)\\b"
    },
    "boolean": {
      "name": "constant.language.boolean.llt",
      "match": "\\b(?:true|false)\\b"
    },
    "special-form": {
      "name": "keyword.control.llt",
      "match": "\\b(?:fn|call|if|type|error|try|apply)\\b(?=\\s|\\])"
    },
    "type-annotation": {
      "name": "storage.type.annotation.llt",
      "match": "@[A-Za-z][A-Za-z0-9]*"
    },
    "variable": {
      "name": "variable.other.llt",
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_-]*"
    },
    "bracket": {
      "name": "punctuation.section.brackets.llt",
      "match": "[\\[\\]]"
    }
  }
}
