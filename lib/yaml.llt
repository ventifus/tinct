# ============================================================================
# lib/yaml.llt — YAML 1.2 Serializer
# ============================================================================
#
# Usage:
#   yaml: [include "lib/yaml.llt"]
#   result: [yaml.to-yaml data]
#
# Type mapping:
#   Int    → bare integer (42)
#   Float  → bare float (3.14; note: 3.0 may render without decimal — known limitation)
#   Bool   → true / false
#   String → double-quoted with \, ", and newline escaping
#   Dict (int keys)    → YAML block sequence
#   Dict (string keys) → YAML block mapping
#   Dict (empty)       → {}
#   Seq                → collected and rendered as YAML block sequence
#
# Limitations (to revisit when type predicates and regex land):
#   - Float: str on 3.0 may omit the decimal point; YAML parsers would then
#     read it as an integer. Add a to-yaml-float formatter when float? exists.
#   - String quoting: all strings are double-quoted regardless of content.
#     With regex we could use bare strings for simple scalar values.
#   - Mixed-key dicts (some int, some string keys): first-key heuristic may
#     misclassify; in practice tinct dicts are uniformly typed.
#   - No emit: returns a string; caller must output or pipeline it.
# ============================================================================

[

# Escape special characters for YAML double-quoted strings.
# Backslashes must be escaped first to avoid double-escaping.
yaml-escape: [fn [s]
    [replace
        [replace
            [replace s "\\" "\\\\"]
            "\"" "\\\""]
        "\n" "\\n"]]

# Build an indentation string of n spaces.
yaml-spaces: [fn [n]
    [join "" [collect [take n [repeat " "]]]]]

# Extract the first key of a non-empty dict.
# keys returns {k→k, ...}; values on that gives [k, ...]; first picks key 0.
yaml-first-key: [fn [d]
    [first [values [keys d]]]]

# True if the dict has integer keys (YAML sequence), false if string keys (YAML mapping).
# Checks only the first key — assumes uniform key types.
yaml-is-list: [fn [d]
    [builtin-if [empty? d]
        false
        [builtin-eq [type-of [yaml-first-key d]] "Int"]]]

# True if the value is a YAML scalar (not a Dict or Seq container).
yaml-is-scalar: [fn [val]
    [not
        [or
            [builtin-eq [type-of val] "Dict"]
            [seq? val]]]]

# Render a scalar value to its YAML string representation.
yaml-scalar: [fn [val]
    [builtin-if [builtin-eq [type-of val] "Bool"]
        [builtin-if val "true" "false"]
        [builtin-if [builtin-eq [type-of val] "String"]
            [str "\"" [yaml-escape val] "\""]
            [str val]]]]

# Render one mapping entry. Scalar values are inline; containers go on the
# next line with two additional spaces of indentation.
yaml-map-entry: [fn [key val depth]
    [builtin-if [yaml-is-scalar val]
        [str [yaml-spaces depth] [str key] ": " [yaml-scalar val]]
        [str [yaml-spaces depth] [str key] ":\n"
            [yaml-value val [builtin-add depth 2]]]]]

# Render one sequence item. Scalar values are inline after "- "; containers
# go on the next line under "-".
yaml-list-item: [fn [val depth]
    [builtin-if [yaml-is-scalar val]
        [str [yaml-spaces depth] "- " [yaml-scalar val]]
        [str [yaml-spaces depth] "-\n"
            [yaml-value val [builtin-add depth 2]]]]]

# Render a string-keyed dict as a YAML block mapping.
yaml-map: [fn [d depth]
    [join "\n"
        [map
            [fn [entry] [yaml-map-entry entry.key entry.value depth]]
            [entries d]]]]

# Render an integer-keyed dict as a YAML block sequence.
yaml-list: [fn [d depth]
    [builtin-if [empty? d]
        "[]"
        [join "\n"
            [map
                [fn [v] [yaml-list-item v depth]]
                [values d]]]]]

# Render any tinct value to YAML. depth = current indentation (spaces).
yaml-value: [fn [val depth]
    [builtin-if [seq? val]
        [yaml-list [collect val] depth]
        [builtin-if [builtin-eq [type-of val] "Dict"]
            [builtin-if [empty? val]
                "{}"
                [builtin-if [yaml-is-list val]
                    [yaml-list val depth]
                    [yaml-map val depth]]]
            [yaml-scalar val]]]]

]

# Public API — the only dict returned by include.
# Uses %.yaml-value to reference the helper from document 1's scope via %.
[
  to-yaml: [fn [val] [%.yaml-value val 0]]
]
