# versions.llt — check Rust toolchain and dependency versions
# Run from project root:
#   tinct run --strict --cap-net nc=any samples/versions.llt
# or via justfile:
#   just versions

--- caps: [%nc: @NetCap]

[include %libdir "strings.llt"]

[cargo-toml-text: [slurp [open %pwd "Cargo.toml" "r"]]]
[cargo-lock-text: [slurp [open %pwd "Cargo.lock" "r"]]]

# Extract body from a raw HTTP response (part after first blank line).
[http-body: [fn@String [raw@String]
  [parts: [split "\r\n\r\n" raw]]
  [if [< [length parts] 2] "" [get 1 parts]]]]

# Make an HTTPS GET and return the response body as String, or "ERR:..." on failure.
[https-get: [fn@String [host@String port@Int path@String]
  [match [try [fn@String []
    [bytes-str [slurp [write-handle
      [tls-connect %nc Tcp host port []]
      [str-bytes [str "GET " path " HTTP/1.0\r\nHost: " host
        "\r\nUser-Agent: tinct/0.1\r\nConnection: close\r\n\r\n"]]]]]]]
    [ok: raw] [http-body raw]
    [err: msg] [str "ERR:" msg]]]]

# Fetch Rust stable channel TOML and extract the version string.
[rust-toml-raw: [https-get "static.rust-lang.org" 443 "/dist/channel-rust-stable.toml"]]

[latest-rust: [if [or [= [length rust-toml-raw] 0] [starts-with? rust-toml-raw "ERR:"]]
  [if [starts-with? rust-toml-raw "ERR:"] rust-toml-raw "?"]
  [reduce
    [fn [state line]
      [t: [trim line]]
      [if [= state.version ""]
        [if [str-contains? t "[pkg.rust]"]
          [set state "in-pkg-rust" true]
          [if [and state.in-pkg-rust [starts-with? t "version = \""]]
            [set state "version" [str-slice t 11 [trunc [- [length t] 1]]]]
            state]]
        state]]
    [set [set [] "in-pkg-rust" false] "version" ""]
    [split "\n" rust-toml-raw]].version]]

[latest-rust-short: [if [= [length latest-rust] 0] "?" [first [split " " latest-rust]]]]

# Collect direct dep names from all dependency sections in Cargo.toml.
[dep-name-from: [fn@String [t@String]
  [trim [first [split "=" t]]]]]

[dep-name-append: [fn@Dict [state t@String]
  [name: [dep-name-from t]]
  [if [= [length name] 0] state [set state "names" [append state.names name]]]]]

[dep-names: [sorted [reduce
  [fn [state line]
    [t: [trim line]]
    [if [starts-with? t "["]
      [set state "in-deps" [str-contains? t "dependencies"]]
      [if [and state.in-deps [and [< 0 [length t]] [not [starts-with? t "#"]]]]
        [dep-name-append state t]
        state]]]
  [set [set [] "in-deps" false] "names" []]
  [split "\n" cargo-toml-text]].names]]

# Find a package's locked version in Cargo.lock.
[ver-after: [fn@String [after@String]
  [ver-line: [trim [get 1 [split "\n" after]]]]
  [str-slice ver-line 11 [trunc [- [length ver-line] 1]]]]]

[find-locked: [fn@String [name@String]
  [pattern: [str "\nname = \"" name "\""]]
  [if [str-contains? cargo-lock-text pattern]
    [ver-after [get 1 [split pattern cargo-lock-text]]]
    "—"]]]

# Fetch the latest stable version for a crate from crates.io.
[crate-latest: [fn@String [name@String]
  [body: [https-get "crates.io" 443 [str "/api/v1/crates/" name]]]
  [if [or [= [length body] 0] [starts-with? body "ERR:"]]
    [if [starts-with? body "ERR:"] body "?"]
    [get "max_stable_version" [get "crate" [from-json body]]]]]]

[rust-version: [env "RUST_VERSION"]]
[mark: [fn@String [a@String b@String] [if [= a b] "✓" "←"]]]

[dep-row: [fn@String [name@String]
  [locked: [find-locked name]]
  [latest: [crate-latest name]]
  [str
    "  " [pad-right name   22 " "]
    "  " [pad-right locked 12 " "]
    "  " [pad-right latest 12 " "]
    "  " [mark locked latest]
    "\n"]]]

[emit [str
  "\nRust toolchain\n"
  "  " [pad-right "pinned:" 10 " "] " " rust-version "\n"
  "  " [pad-right "latest:" 10 " "] " " latest-rust-short
    "  " [mark rust-version latest-rust-short] "\n"
  "\nDirect dependencies (Cargo.lock → crates.io latest)\n"
  "  " [pad-right "crate"                 22 " "]
    "  " [pad-right "locked" 12 " "]
    "  " [pad-right "latest" 12 " "] "\n"
  "  " [pad-right "─────────────────────" 22 " "]
    "  " [pad-right "──────────" 12 " "]
    "  " [pad-right "──────────" 12 " "] "\n"
  [join "" [map dep-row dep-names]]
  "\n"]]
