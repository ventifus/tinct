# versions.llt — check Rust toolchain and dependency versions
# Run from project root:
#   tinct run --no-pwd --cap-fs pwd=.:r --cap-net nc=static.rust-lang.org:443 --cap-net nc=crates.io:443 samples/versions.llt
# or via justfile:
#   just versions
#
# Note: net.llt cannot be included from user scripts until [include %rust ...] is fixed in the
# stdlib include mechanism. HTTP fetch is implemented inline using raw Rust builtins.

--- caps: [%nc: @NetCap]

[
  strings: [include %libdir "strings.llt"]
]

[

cargo-toml-text: [slurp [open %pwd "Cargo.toml" Readable]]
cargo-lock-text: [slurp [open %pwd "Cargo.lock" Readable]]

# Minimal HTTPS GET using raw builtins — returns response dict or raises on error.
# Uses http2-session (reqwest, HTTP/2 via ALPN) for HTTPS.
https-get: [fn@Dict [let cap@NetCap url-string@String]
  [u: [url url-string]]
  [http-request
    [http2-session cap [str u.scheme "://" u.host] []]
    "GET"
    [str u.path [if [null? u.query] "" [str "?" u.query]]]
    []
    []]]

# Like https-get but returns Ok[resp] | Err[msg] — never throws.
fetch: [fn@Dict [let cap@NetCap url-string@String]
  [try [fn [] [https-get cap url-string]]]]

# Fetch Rust stable channel TOML, extract version — returns "?" on any failure.
latest-rust: [result-or "?"
  [and-then
    [fetch %nc "https://static.rust-lang.org/dist/channel-rust-stable.toml"]
    [fn [let resp@Dict]
      [ver: [reduce
        [fn@Dict [let state@Dict line@String]
          [t: [trim line]]
          [if [= state.version ""]
            [if [str-contains? t "[pkg.rust]"]
              [set state "in-pkg-rust" true]
              [if [and state.in-pkg-rust [starts-with? t "version = \""]]
                [set state "version" [str-slice t 11 [trunc [- [length t] 1]]]]
                state]]
            state]]
        [in-pkg-rust: false  version: ""]
        [split "\n" resp.body]].version]
      [if [= [length ver] 0] [Err "version not found"] [Ok ver]]]]]

latest-rust-short: [if [= [length latest-rust] 0] "?" [first [split " " latest-rust]]]

# Collect direct dep names from all dependency sections in Cargo.toml.
dep-name-from: [fn@String [let t@String]
  [trim [first [split "=" t]]]]

dep-name-append: [fn@Dict [let state@Dict t@String]
  [name: [dep-name-from t]]
  [if [= [length name] 0] state [set state "names" [append state.names name]]]]

dep-names: [sorted [reduce
  [fn@Dict [let state@Dict line@String]
    [t: [trim line]]
    [if [starts-with? t "["]
      [set state "in-deps" [str-contains? t "dependencies"]]
      [if [and state.in-deps [and [< 0 [length t]] [not [starts-with? t "#"]]]]
        [dep-name-append state t]
        state]]]
  [in-deps: false  names: []]
  [split "\n" cargo-toml-text]].names]

# Find a package's locked version in Cargo.lock.
ver-after: [fn@String [let after@String]
  [ver-line: [trim [get 1 [split "\n" after]]]]
  [str-slice ver-line 11 [trunc [- [length ver-line] 1]]]]

find-locked: [fn@String [let name@String]
  [pattern: [str "\nname = \"" name "\""]]
  [if [str-contains? cargo-lock-text pattern]
    [ver-after [get 1 [split pattern cargo-lock-text]]]
    "—"]]

# Fetch the latest stable version for a crate from crates.io — "?" on failure.
crate-latest: [fn@String [let name@String]
  [result-or "?"
    [do result
      [resp: [fetch %nc [str "https://crates.io/api/v1/crates/" name]]]
      [if [= [length resp.body] 0]
        [Err "empty response"]
        [Ok [get "max_stable_version" [get "crate" [from-json resp.body]]]]]]]]

rust-version: [env "RUST_VERSION"]
mark: [fn@String [let a@String b@String] [if [= a b] "✓" "←"]]

dep-row: [fn@String [let name@String]
  [locked: [find-locked name]]
  [latest: [crate-latest name]]
  [str
    "  " [strings.pad-right name   22 " "]
    "  " [strings.pad-right locked 12 " "]
    "  " [strings.pad-right latest 12 " "]
    "  " [mark locked latest]
    "\n"]]

]

[emit [str
  "\nRust toolchain\n"
  "  " [strings.pad-right "pinned:" 10 " "] " " rust-version "\n"
  "  " [strings.pad-right "latest:" 10 " "] " " latest-rust-short
    "  " [mark rust-version latest-rust-short] "\n"
  "\nDirect dependencies (Cargo.lock → crates.io latest)\n"
  "  " [strings.pad-right "crate"                 22 " "]
    "  " [strings.pad-right "locked" 12 " "]
    "  " [strings.pad-right "latest" 12 " "] "\n"
  "  " [strings.pad-right "─────────────────────" 22 " "]
    "  " [strings.pad-right "──────────" 12 " "]
    "  " [strings.pad-right "──────────" 12 " "] "\n"
  [join "" [map dep-row dep-names]]
  "\n"]]
