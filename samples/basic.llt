# Helper functions (scope chain -- not in output)
[
    double: [fn [x] [* x 2]]
]

# Data output
[
    base: [timeout: 30  retries: 3]
    dev:  [merge base [env: "dev"]]
    prod: [merge base [env: "prod"  timeout: 60]]

    users: [
        [name: "Alice"  age: 30  active: true]
        [name: "Bob"    age: 25  active: false]
        [name: "Carol"  age: 35  active: true]
    ]

    active-names: [sorted
        [map [fn [u] u.name]
            [filter [fn [u] u.active] users]]]

    port: [@Number 8080]
    doubled-timeout: [double base.timeout]
    user-count: [length users]
]
