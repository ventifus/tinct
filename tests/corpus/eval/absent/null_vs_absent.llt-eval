# S-850: null? checks for [] (empty collection); absent? checks for Absent.Absent.
# The two predicates are NOT interchangeable after the Absent.Absent migration.
# null? returns true only for [] (empty dict); Absent.Absent is a Variant, not a dict.
# absent? returns true only for Absent.Absent; [] is an empty dict, not Absent.Absent.
[
  null-on-empty-dict: [null? []]
  null-on-absent: [null? [get? "missing" []]]
  absent-on-empty-dict: [absent? []]
  absent-on-absent: [absent? [get? "missing" []]]
]
=== out
Dict({"null-on-empty-dict": Variant(Boolean.True, Null), "null-on-absent": Variant(Boolean.False, Null), "absent-on-empty-dict": Variant(Boolean.False, Null), "absent-on-absent": Variant(Boolean.True, Null)})
