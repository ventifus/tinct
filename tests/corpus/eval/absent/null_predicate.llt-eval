# null? returns true only for [] (the empty dict sentinel), false for everything else.
# This tests that null? correctly distinguishes [] from non-empty dicts, integers, and strings.
# S-911: null? is implemented via builtin-eq (not =) to avoid Equatable typeclass dispatch.
[
  on-empty-dict:  [null? []]
  on-non-empty:   [null? [a: 1]]
  on-int:         [null? 42]
  on-string:      [null? "hello"]
]
=== out
Dict({"on-empty-dict": Variant(Boolean.True, Null), "on-non-empty": Variant(Boolean.False, Null), "on-int": Variant(Boolean.False, Null), "on-string": Variant(Boolean.False, Null)})
