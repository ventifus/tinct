# Comprehensive macro integration test
[
  [defmacro add-one [fn [macro-args]
    [
      type: "call"
      implied: true
      fn: [type: "var" name: "+"]
      args: [
        [get 0 macro-args]
        [type: "literal" kind: "int" value: 1]
      ]
      named-args: []
    ]]]

  test1: [add-one 5]

  [defmacro double [fn [macro-args]
    [
      type: "call"
      implied: true
      fn: [type: "var" name: "*"]
      args: [
        [get 0 macro-args]
        [type: "literal" kind: "int" value: 2]
      ]
      named-args: []
    ]]]

  test2: [double 7]
  test3: [double [add-one 3]]
]
===
Dict({"test1": Int(6), "test2": Int(14), "test3": Int(8)})
