# Comprehensive macro integration test
[macro add-one [let x]
  [
    type: "call"
    implied: true
    fn: [type: "var" name: "+"]
    args: [
      x
      [type: "literal" kind: "int" value: 1]
    ]
    named-args: []
  ]]

[macro double [let x]
  [
    type: "call"
    implied: true
    fn: [type: "var" name: "*"]
    args: [
      x
      [type: "literal" kind: "int" value: 2]
    ]
    named-args: []
  ]]

[
  test1: [add-one 5]
  test2: [double 7]
  test3: [double [add-one 3]]
]
=== out
Dict({"test1": Int(6), "test2": Int(14), "test3": Int(8)})
