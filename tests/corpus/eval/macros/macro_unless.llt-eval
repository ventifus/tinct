# Custom unless macro using manual AST dict construction.
# Transforms [my-unless cond body] into [if cond [] body].
[macro my-unless [let cond body]
  [type: "call"
   fn: [type: "var"  name: "if"]
   args: [
     0: cond
     1: [type: "dict"  entries: []]
     2: body
   ]
   named-args: []
   implied: true]
]

[my-unless false 42]
=== out
Int(42)
