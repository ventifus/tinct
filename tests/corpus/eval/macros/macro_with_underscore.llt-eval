# Test macro that generates a function with explicit params
[macro make-adder [let ...macro-args]
  [
    type: "fn"
    params: [
      [name: "a" annotation: [] variadic: False]
      [name: "b" annotation: [] variadic: False]
    ]
    body: [
      type: "call"
      implied: True
      fn: [type: "var" name: "+"]
      args: [
        [type: "var" name: "a"]
        [type: "var" name: "b"]
      ]
      named-args: []
    ]
    return-ann: []
    desugared: False
  ]]

[
  add: [make-adder]
  result: [add 3 5]
]
=== out
Dict({"add": Function(a, b), "result": Int(8)})
