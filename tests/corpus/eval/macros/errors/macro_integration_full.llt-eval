# Comprehensive macro integration test
[macro add-one [let x]
  [
    type: "call"
    implied: True
    fn: [type: "var" name: "+"]
    args: [
      x
      [type: "literal" kind: "int" value: 1]
    ]
    named-args: []
  ]]

[macro double [let x]
