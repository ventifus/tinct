    type: "call"
    implied: True
    fn: [type: "var" name: "*"]
    args: [
      x
      [type: "literal" kind: "int" value: 2]
    ]
    named-args: []
  ]]

[
  test1: [add-one 5]
  test2: [double 7]
  test3: [double [add-one 3]]
]

