# Nested macro expansion: one macro's output feeds into another.
[macro id [let arg]
  arg
]

[macro add-ten [let arg]
  [type: "call"
   fn: [type: "var"  name: "+"]
   args: [0: arg  1: [type: "literal"  kind: "int"  value: 10]]
   named-args: []
   implied: true]
]

[add-ten [id 5]]
=== out
Int(15)
