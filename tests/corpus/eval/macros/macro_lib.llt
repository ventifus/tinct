# Library file that defines and uses a macro internally

[
  # Define a simple macro that transforms [my-add a b] to [+ a b]
  # Note: param named `macro-args` to avoid shadowing by the `args` key
  # in the generated AST dict (dict keys create letrec bindings).
  [defmacro my-add [fn [macro-args]
    [
      type: "call"
      implied: true
      fn: [type: "var" name: "+"]
      args: [
        [get 0 macro-args]
        [get 1 macro-args]
      ]
      named-args: []
    ]]]

  # Use the macro within this file
  result: [my-add 1 2]
]
