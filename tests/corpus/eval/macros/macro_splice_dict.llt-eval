# Task 2: Splice output in dict context.
# A macro returning {type: "splice" forms: [...]} injects each form as a separate entry.
[macro two-ints [let ...args]
  [type: "splice"
   forms: [
     [type: "literal"  kind: "int"  value: 10]
     [type: "literal"  kind: "int"  value: 20]
   ]]]

