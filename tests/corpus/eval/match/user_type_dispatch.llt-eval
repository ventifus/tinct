# User-defined nominal type dispatch in match patterns.
#
# When a VarRef pin pattern resolves to a type-constructor Dict (from a [type ...]
# declaration) and the scrutinee is a Variant, match_pattern checks if the
# Variant's tycon field matches the pattern name. This enables MethodDispatcher
# arms to match user-defined types alongside builtin types.
[Color: [type Red Green Blue]]
[Point: [type Point: [x: Int y: Int]]]
[
  # Basic type dispatch with unit constructors
  dispatch-color: [fn [let x]
    [match x
      Color:  "is-color"
      Point:  "is-point"
      ...:    "other"]]

  # Test unit constructor
  c1: [dispatch-color Color.Red]
  c2: [dispatch-color Color.Blue]

  # Test payload constructor
  p1: [dispatch-color [Point.Point x: 1 y: 2]]

  # Non-matching value
  n1: [dispatch-color 42]
]
=== out
Dict({"dispatch-color": Fn, "c1": String("is-color"), "c2": String("is-color"), "p1": String("is-point"), "n1": String("other")})
