# User-declared Equatable instance for Point type — cross-dict dispatch not yet wired.
# B-689: MethodDispatcher does not chain across dict boundaries, so the user instance is
# unreachable from dict 3's call site. Both = calls return Boolean.False.
[Point: [type Point: [x: Int y: Int]]]
[instance Equatable
  [let a@Point]: [=: [fn [let p q]
    [and [= p.x q.x] [= p.y q.y]]]]]
[
  p1: [Point.Point x: 1 y: 2]
  p2: [Point.Point x: 1 y: 2]
  p3: [Point.Point x: 1 y: 3]
  # Both return Boolean.False -- cross-dict dispatch not yet implemented (B-689).
  same: [= p1 p2]
  diff: [= p1 p3]
]
=== out
Dict({"p1": Variant(Point.Point, Dict({"x": Int(1), "y": Int(2)})), "p2": Variant(Point.Point, Dict({"x": Int(1), "y": Int(2)})), "p3": Variant(Point.Point, Dict({"x": Int(1), "y": Int(3)})), "same": Variant(Boolean.False, Null), "diff": Variant(Boolean.False, Null)})
