# User-defined Equatable instance for a custom type.
# NOTE: User instances defined outside the prelude do not dispatch via call_dispatch
# because the type checker's InstanceEnv only contains prelude-declared instances.
# The runtime falls back to the generic = wrapper (Boolean.False fallback / primitive_eq),
# which returns Boolean.False for payload Variants. Pattern matching should be used
# instead for comparing user-defined variant types.
[Point: [type [Point x: Int y: Int]]]
[instance Equatable
  [let a@Point]: [=: [fn [let p q]
    [and [= p.x q.x] [= p.y q.y]]]]]
[
  p1: [Point.Point x: 1 y: 2]
  p2: [Point.Point x: 1 y: 2]
  p3: [Point.Point x: 1 y: 3]
  # Both return Boolean.False -- user instance not dispatched (see NOTE above).
  same: [= p1 p2]
  diff: [= p1 p3]
]
=== out
Dict({"p1": Variant(Point.Point, Dict({"x": Int(1), "y": Int(2)})), "p2": Variant(Point.Point, Dict({"x": Int(1), "y": Int(2)})), "p3": Variant(Point.Point, Dict({"x": Int(1), "y": Int(3)})), "same": Variant(Boolean.False, Null), "diff": Variant(Boolean.False, Null)})
