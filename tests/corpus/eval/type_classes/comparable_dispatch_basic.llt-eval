# Basic ordering dispatch via Comparable multi-method instances
[
  a: [< 1 2]
  b: [< 2 1]
  c: [> 2 1]
  d: [<= 1 1]
  e: [>= 2 1]
  f: [< "a" "b"]
  g: [< 1.0 2.0]
]
=== out
Dict({"a": Variant(Boolean.True, Null), "b": Variant(Boolean.False, Null), "c": Variant(Boolean.True, Null), "d": Variant(Boolean.True, Null), "e": Variant(Boolean.True, Null), "f": Variant(Boolean.True, Null), "g": Variant(Boolean.True, Null)})
