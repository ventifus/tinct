# Basic equality dispatch via Equatable multi-method instances
[
  a: [= 1 1]
  b: [= 1 2]
  c: [= "hello" "hello"]
  d: [= "hello" "world"]
  e: [= True True]
  f: [= 1.0 1.0]
  g: [= 1 "hello"]
  h: [= 1 1.0]
]
=== out
Dict({"a": Variant(Boolean.True, Null), "b": Variant(Boolean.False, Null), "c": Variant(Boolean.True, Null), "d": Variant(Boolean.False, Null), "e": Variant(Boolean.True, Null), "f": Variant(Boolean.True, Null), "g": Variant(Boolean.False, Null), "h": Variant(Boolean.False, Null)})
