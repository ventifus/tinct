# Multi-body case arm: intermediate dict + final expression using case binding.
# No dot access — uses only the captured binding p directly.
[
  Option: [type Some: [value: Any]  None]
  result: [match [Option.Some value: 21]
    [case [let p] [Option.Some p]
      [x: p]
      x]
    ...: 0]
]
result
=== out
[value: 21]
