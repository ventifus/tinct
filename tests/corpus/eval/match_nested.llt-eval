# After S-944, Integer is a plain VarRef (Pattern::TypeAssertPending is deleted).
# Integer resolves to TypeNode.Int; primitive_eq(42, TypeNode.Int) = false → wildcard fires → "other".
# Outer match: "other" matches "other": arm → "matched-other".
[match [match 42 Integer: "int" ...: "other"]
    "int":    "matched-int"
    "other":  "matched-other"
    ...:      "unknown"]
=== out
String("matched-other")
