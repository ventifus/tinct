# builtin-eval returns diagnostics with level and kind fields on eval error.
# Verifies that raise produces a diagnostic with level="error" and kind="eval-error".
[call [fn [let]
  [src: [builtin-str-bytes "[raise \"test error\"]"]]
  [parsed: [builtin-parse src "test.llt"]]
  [desugared: [builtin-desugar parsed.program]]
  [docs: [builtin-program-docs desugared]]
  [doc: [builtin-get 0 docs]]
  [frames: [scope-to-frames 0]]
  [resolved: [builtin-resolve doc frames]]
  [result: [builtin-eval resolved.doc 0]]
  [n: [builtin-dict-length result.diagnostics]]
  [has-diag: [builtin-int-gt n 0]]
  [d: [builtin-get 0 result.diagnostics]]
  [has-level: [builtin-has-key? "level" d]]
  [has-kind: [builtin-has-key? "kind" d]]
  [level-ok: [builtin-eq-string [builtin-get "level" d] "error"]]
  [kind-ok: [builtin-eq-string [builtin-get "kind" d] "eval-error"]]
  [all-ok: [builtin-int-add [builtin-int-add [builtin-int-add has-diag has-level] has-kind] [builtin-int-add level-ok kind-ok]]]
  all-ok]]
=== out
Int(5)
