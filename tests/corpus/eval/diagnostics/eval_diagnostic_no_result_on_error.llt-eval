# builtin-eval returns diagnostics on error; result and scope-id are still present.
# Verifies that when eval fails with raise, diagnostics are populated.
[call [fn [let]
  [src: [builtin-str-bytes "[raise \"fail\"]"]]
  [parsed: [builtin-parse src "test.llt"]]
  [desugared: [builtin-desugar parsed.program]]
  [docs: [builtin-program-docs desugared]]
  [doc: [builtin-get 0 docs]]
  [frames: [scope-to-frames 0]]
  [resolved: [builtin-resolve doc frames]]
  [result: [builtin-eval resolved.doc 0]]
  [has-diagnostics: [builtin-int-gt [builtin-dict-length result.diagnostics] 0]]
  [has-scope-id: [builtin-has-key? "scope-id" result]]
  [all-ok: [builtin-int-add has-diagnostics has-scope-id]]
  all-ok]]
=== out
Int(2)
