# Verify resolve error diagnostics have all 8 expected fields.
[call [fn [let]
  [src: [builtin-str-bytes "[x: undefined-var]"]]
  [parsed: [builtin-parse src "test.llt"]]
  [desugared: [builtin-desugar parsed.program]]
  [docs: [builtin-program-docs desugared]]
  [doc: [builtin-dict-get 0 docs]]
  [resolved: [builtin-resolve doc []]]
  [d: [builtin-dict-get 0 resolved.diagnostics]]
  [all-ok: [builtin-int-add
    [builtin-int-add [builtin-int-add [builtin-has-key? "level" d] [builtin-has-key? "kind" d]]
                     [builtin-int-add [builtin-has-key? "message" d] [builtin-has-key? "span" d]]]
    [builtin-int-add [builtin-int-add [builtin-has-key? "notes" d] [builtin-has-key? "call-stack" d]]
                     [builtin-int-add [builtin-has-key? "macro-expand" d] [builtin-has-key? "blame" d]]]]]
  all-ok]]
=== out
Int(8)
