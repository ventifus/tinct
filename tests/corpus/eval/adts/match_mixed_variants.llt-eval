# Match on variants with and without payloads
# Some has a payload field, None is unit-like
# T-1154: Pattern::Variable replaced by Pattern::Pin; use 3-arg [case [let n] [Option.Some n] n] to bind.
# T-1086: [type ...] evaluates to constructor dict; use keyed form and qualified names.
[
  Option: [type [Some value: Int] [None]]

  x: [Option.Some value: 10]
  y: Option.None

  result1: [match x
    [case [let n] [Option.Some n] n.value]
    Option.None:                  0]

  result2: [match y
    [case [let n] [Option.Some n] n.value]
    Option.None:                  0]
]
=== out
Dict({"Option": Dict({"Some": Function(value), "None": Variant(Option.None, Null)}), "x": Variant(Option.Some, Dict({"value": Int(10)})), "y": Variant(Option.None, Null), "result1": Int(10), "result2": Int(0)})
