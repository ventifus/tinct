# [Shape.Circle ...] in non-case-arm position is a Call pattern (wildcard payload).
# [case [let p] [Shape.Circle p] body] binds the payload dict to p.
# Both forms are tested here.
[
  Shape: [type Circle: [r: Int]]
  sh:    [Shape.Circle r: 5]
  area:  [match sh
    [case [let p] [Shape.Circle p] [* p.r p.r]]
    ...:                            0]
  # Non-case-arm wildcard payload form: fires when tag matches, ignores payload
  tagged: [match sh
    [Shape.Circle ...]: 1
    ...:                0]
]
=== out
Dict({"Shape": Dict({"Circle": Function(r)}), "sh": Variant(Shape.Circle, Dict({"r": Int(5)})), "area": Int(25), "tagged": Int(1)})
