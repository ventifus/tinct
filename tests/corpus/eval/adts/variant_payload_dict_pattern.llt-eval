# Dict pattern auto-unpacks a Variant payload.
# [case [let h p] [host: h  port: p] body] matches any Variant whose payload
# contains host and port fields — tag is NOT checked. To check the tag, use
# [case [let p] [Config.ServerCfg p] p.host] first to bind the payload.
[
  Config: [type ServerCfg: [host: Str port: Int] LocalCfg]
  cfg:    [Config.ServerCfg host: "localhost" port: 8080]
  result: [match cfg
    [case [let h p] [host: h  port: p] [str h ":" [str p]]]
    [case [let _]   _                  "no match"]]
]
=== out
Dict({"Config": Dict({"ServerCfg": Function(host, port), "LocalCfg": Variant(Config.LocalCfg, Null)}), "cfg": Variant(Config.ServerCfg, Dict({"host": String("localhost"), "port": Int(8080)})), "result": String("no match")})
