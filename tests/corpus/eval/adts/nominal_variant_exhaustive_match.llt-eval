# T-974 / T-968: Named-field constructor match with payload dict access.
# After T-1193, [type Shape [Circle r: Int] [Square s: Int]] produces a constructor dict:
#   Shape: {Shape: Variant("Shape.Shape", Null), Circle: fn [r] ..., Square: fn [s] ...}
# [Shape.Circle r: 5] → Variant("Shape.Circle", Dict({r: Int(5)})).
# Pattern [case [let p] [Shape.Circle p] body]: binds p = payload dict {r: Int(5)}.
# [* 3 [* p.r p.r]] accesses p.r = 5 → 75.
# T-968 implemented: constructor tag qualification works correctly.
[
  Shape: [type Shape
    [Circle r: Int]
    [Square s: Int]
  ]

  shape: [Shape.Circle r: 5]

  area: [match shape
    [case [let p] [Shape.Circle p] [* 3 [* p.r p.r]]]
    [case [let p] [Shape.Square p] [* p.s p.s]]
  ]
]
=== out
Dict({"Shape": Dict({"Shape": Variant(Shape.Shape, Null), "Circle": Function(r), "Square": Function(s)}), "shape": Variant(Shape.Circle, Dict({"r": Int(5)})), "area": Int(75)})
