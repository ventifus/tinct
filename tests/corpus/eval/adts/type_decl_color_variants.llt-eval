# [type Color Red Green Blue] produces unit variant constructors.
# S-842 adds TyConDef to tycon_env for this declaration (T-941/T-942).
# Verifies the evaluator injects Color, Red, Green, Blue as Variant(_, Null)
# entries and that match dispatch on unit variants works correctly.
[
  Color: [type Color Red Green Blue]
  c:    Color.Red
  name: [match c
    Color.Red:   "red"
    Color.Green: "green"
    Color.Blue:  "blue"]
]
=== out
Dict({"Color": Dict({"Color": Variant(Color.Color, Null), "Red": Variant(Color.Red, Null), "Green": Variant(Color.Green, Null), "Blue": Variant(Color.Blue, Null)}), "c": Variant(Color.Red, Null), "name": String("red")})
