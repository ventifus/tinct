# Number: is a TypeTag pattern but "Number" is not a runtime type name
# (type_name() returns "Int" or "Float", never "Number"). Falls to wildcard.
# Str: is a TypeTag alias for "String" — but 3.14 is Float, not String.
# Both arms fall through; the wildcard _: matches.
[match 3.14
    Number:  "numeric"
    Str:     "text"
    _:       "other"]
=== out
String("other")
