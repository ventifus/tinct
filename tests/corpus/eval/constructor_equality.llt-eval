# Constructor comparison via pattern matching -- no Equatable instance for Color.
# Use pattern matching to compare constructors (not =).
[Color: [type Red Green Blue]]
[is-red: [fn [let c]
  [match c
    Color.Red: Boolean.True
    ...:       Boolean.False]]]
[
  r1: [is-red Color.Red]
  r2: [is-red Color.Green]
]
=== out
Dict({"r1": Variant(Boolean.True, Null), "r2": Variant(Boolean.False, Null)})
