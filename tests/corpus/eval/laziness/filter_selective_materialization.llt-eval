# Lazy evaluation: $filter doesn't force tail elements beyond what's needed
# Take 1 element from filtered Seq - the error in the tail shouldn't fire
[collect [take 1
    [filter
     [fn [let x] [< x 10]]
     [seq 5 [seq [raise "should not evaluate"] []]]]]]
=== error
[E080] should not evaluate (defined at stdlib/prelude.llt:2035:28-2035:47)
  --> stdlib/prelude.llt:2035:28-2035:47
   |
  2035 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2035:28-2035:47
   |
  2035 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [< ...] at 4:18-4:26
  in filter-seq pred at stdlib/prelude.llt:2042:72-2042:96
   |
  2042 | filter@[doc: "Keep elements matching predicate"]: [fn [let pred@Fn xs] [builtin-filter pred xs]]
       |                                                                        ^^^^^^^^^^^^^^^^^^^^^^^^
  in filter-seq pred at stdlib/prelude.llt:2410:29-2410:30
   |
  2410 | """] [let h t] [builtin-seq h t]]
       |                             ^
  in call $filter at stdlib/prelude.llt:2042:72-2042:96
   |
  2042 | filter@[doc: "Keep elements matching predicate"]: [fn [let pred@Fn xs] [builtin-filter pred xs]]
       |                                                                        ^^^^^^^^^^^^^^^^^^^^^^^^
  in call $take at stdlib/prelude.llt:2045:57-2045:76
   |
  2045 | take@[doc: "Take first n elements"]: [fn [let n@Int xs] [builtin-take n xs]]
       |                                                         ^^^^^^^^^^^^^^^^^^^
  in [builtin-collect ...] at stdlib/prelude.llt:2434:15-2434:35
   |
