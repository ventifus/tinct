# Lazy evaluation: $filter doesn't force tail elements beyond what's needed
# Take 1 element from filtered Seq - the error in the tail shouldn't fire
[collect [take 1
    [filter
     [fn [let x] [< x 10]]
     [seq 5 [seq [raise "should not evaluate"] []]]]]]
=== error
[E080] should not evaluate (defined at stdlib/prelude.llt:2034:28-2034:47)
  --> stdlib/prelude.llt:2034:28-2034:47
   |
  2034 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2034:28-2034:47
   |
  2034 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [< ...] at 4:18-4:26
  in filter-seq pred at stdlib/prelude.llt:2041:72-2041:96
   |
