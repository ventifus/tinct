# Lazy evaluation: $filter doesn't force tail elements beyond what's needed
# Take 1 element from filtered Seq - the error in the tail shouldn't fire
[collect [take 1
    [filter
     [fn [let x] [< x 10]]
     [seq 5 [seq [raise "should not evaluate"] []]]]]]
=== error
[E080] should not evaluate (defined at stdlib/prelude.llt:2051:28-2051:47)
  --> stdlib/prelude.llt:2051:28-2051:47
   |
  2051 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2051:28-2051:47
   |
  2051 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [< ...] at 4:18-4:26
  in filter-seq pred at stdlib/prelude.llt:2058:72-2058:96
   |
  2058 | filter@[doc: "Keep elements matching predicate"]: [fn [let pred@Fn xs] [builtin-filter pred xs]]
       |                                                                        ^^^^^^^^^^^^^^^^^^^^^^^^
  in filter-seq pred at stdlib/prelude.llt:2436:29-2436:30
   |
