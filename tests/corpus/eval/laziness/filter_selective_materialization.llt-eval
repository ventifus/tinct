# Lazy evaluation: $filter doesn't force tail elements beyond what's needed
# Take 1 element from filtered Seq - the error in the tail shouldn't fire
[collect [take 1
    [filter
     [fn [let x] [< x 10]]
     [seq 5 [seq [raise "should not evaluate"] []]]]]]
=== error
[E080] should not evaluate (defined at stdlib/prelude.llt:2060:28-2060:47)
  --> stdlib/prelude.llt:2060:28-2060:47
   |
  2060 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2060:28-2060:47
   |
  2060 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [< ...] at 4:18-4:26
  in filter-seq pred at stdlib/prelude.llt:2067:72-2067:96
   |
  2067 | filter@[doc: "Keep elements matching predicate"]: [fn [let pred@Fn xs] [builtin-filter pred xs]]
       |                                                                        ^^^^^^^^^^^^^^^^^^^^^^^^
  in filter-seq pred at stdlib/prelude.llt:2435:29-2435:30
   |
  2435 | """] [let h t] [builtin-seq h t]]
       |                             ^
  in call $filter at stdlib/prelude.llt:2067:72-2067:96
   |
