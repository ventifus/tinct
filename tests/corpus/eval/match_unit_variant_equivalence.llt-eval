# [Tag]: and [Tag _]: are equivalent — both match any variant with that tag.
# D-1 decision: [Tag]: (binding:None) matches all variants regardless of payload,
# same as [Tag _]: — users writing [Tag]: mean "match this tag, I don't care about payload."
[
  [type Color [Red] [Green] [Blue]]
  [type Wrapper [Boxed value: Int] [Empty]]

  # [Red]: matches Red (unit variant, no payload) — same as [Red _]:
  match1: [match Red
    [Red]:   "red"
    [Green]: "green"
    [Blue]:  "blue"]

  # [Boxed]: with a payload variant — [Boxed]: should match even though Boxed carries a payload
  match2: [match [Boxed value: 42]
    [Boxed]: "has-box"
    [Empty]: "empty"]
]
=== error
[E020] arity mismatch: expected 1 argument, got 2 (defined at 1:1-1:1)
