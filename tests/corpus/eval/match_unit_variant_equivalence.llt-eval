# [Tag]: and [Tag _]: are equivalent — both match any variant with that tag.
# D-1 decision: [Tag]: (binding:None) matches all variants regardless of payload,
# same as [Tag _]: — users writing [Tag]: mean "match this tag, I don't care about payload."
[
  Color:   [type Color [Red] [Green] [Blue]]
  Wrapper: [type Wrapper [Boxed value: Int] [Empty]]

  # [Color.Red]: matches Red (unit variant, no payload) — same as [Color.Red _]:
  match1: [match Color.Red
    Color.Red:   "red"
    Color.Green: "green"
    Color.Blue:  "blue"]

  # [Wrapper.Boxed]: with a payload variant — matches even though Boxed carries a payload
  match2: [match [Wrapper.Boxed value: 42]
    Wrapper.Boxed: "has-box"
    Wrapper.Empty: "empty"]
]
=== out
Dict({"Color": Dict({"Color": Variant(Color.Color, Null), "Red": Variant(Color.Red, Null), "Green": Variant(Color.Green, Null), "Blue": Variant(Color.Blue, Null)}), "Wrapper": Dict({"Wrapper": Variant(Wrapper.Wrapper, Null), "Boxed": Function(value), "Empty": Variant(Wrapper.Empty, Null)}), "match1": String("red"), "match2": String("has-box")})
