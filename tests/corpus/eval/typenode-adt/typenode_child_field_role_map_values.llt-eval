# T-1481: field_annotations implementation — @Child field annotation produces role in annotation dict.
# Named-field constructor with @Child@[role: "MapValues"] on [Map K V] type produces role "MapValues".
# The role is declared explicitly in the annotation — not inferred from the type expression head name.
# This is the pattern used by TypeNode.Dict in prelude.llt:
#   Record@[as-type: [fn [let r] r]  guarding: True]:
#     [fields@Child@[role: "MapValues"]: [Map String TypeNode]
#      open:                             Bool]
#
# child_role_from_annotation reads the role: key from the PropertyDict inner annotation.
# The `field-annotations` key maps "fields" to {role: "MapValues"}.
# Non-@Child fields (open: Bool) do NOT appear in field-annotations.
[DictNode: [type Record@[as-type: [fn [let r] r]  guarding: True]: [
  fields@Child@[role: "MapValues"]: [Map String DictNode]
  open:                             Bool]]]
[ann: [annotation-of DictNode.Record]]
[has-field-anns: [has? "field-annotations" ann]]
[field-anns: [get "field-annotations" ann]]
[role: [get "role" [get "fields" field-anns]]]
[no-open: [not [has? "open" field-anns]]]
[result: [and has-field-anns [and [= role "MapValues"] no-open]]]
=== out
Dict({"result": Variant(Boolean.True, Null)})
