# T-1481: field_annotations implementation — @Child field annotation produces role in annotation dict.
# Named-field constructor with @Child annotated field and bare TypeNode reference produces role "One".
# This is the pattern used by TypeNode.Recursive in prelude.llt:
#   Recursive@[as-type: [fn [let r] r]  guarding: True]:
#     [var:        String
#      body@Child: TypeNode]
#
# child_role_from_annotation with no role: key in the annotation returns the default role "One".
# The `field-annotations` key maps "child" to {role: "One"}.
# Non-@Child fields (label: String) do NOT appear in field-annotations.
[TreeNode: [type Branch@[as-type: [fn [let r] r]  guarding: True]: [
  label: String
  child@Child: TreeNode]]]
[ann: [annotation-of TreeNode.Branch]]
[has-field-anns: [has? "field-annotations" ann]]
[field-anns: [get "field-annotations" ann]]
[role: [get "role" [get "child" field-anns]]]
[no-label: [not [has? "label" field-anns]]]
[result: [and has-field-anns [and [= role "One"] no-label]]]
=== out
Dict({"result": Variant(Boolean.True, Null)})
