# Match on variants with and without payloads
# Some has a payload field, None is unit-like

[
  [type Option [Some value: Int] [None]]

  x: [Some 10]
  y: None

  result1: [match x
    [Some n]:  n
    [None]:    0]

  result2: [match y
    [Some n]:  n
    [None]:    0]

  both: [seq result1 result2]
]
=== error
[E020] arity mismatch: expected 1 argument, got 2 (defined at 1:1-1:1)
