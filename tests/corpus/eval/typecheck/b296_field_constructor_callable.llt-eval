# B-296: Field constructors should be callable at their correct types without type errors.
# [Circle r: 5] calls the Circle constructor with r=5.
# [Square s: 10] calls the Square constructor with s=10.
[
  Shape: [type Circle: [r: Integer] Square: [s: Integer]]
  c:  [Circle r: 5]
  sq: [Square s: 10]
]
=== out
Dict({"Shape": Dict({"Circle": Function(r), "Square": Function(s)}), "c": Variant(Shape.Circle, Dict({"r": Int(5)})), "sq": Variant(Shape.Square, Dict({"s": Int(10)}))})
