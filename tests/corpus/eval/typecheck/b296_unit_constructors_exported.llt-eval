# B-296: Constructors from [type ...] must be visible as standalone names in the
# enclosing dict's type environment. Foo and Bar from MyType are unit constructors
# that should be usable as values in the same scope.
[
  MyType: [type Foo Bar]
  x: Foo
  y: Bar
]
=== out
Dict({"MyType": Dict({"Foo": Variant(MyType.Foo, Null), "Bar": Variant(MyType.Bar, Null)}), "x": Variant(MyType.Foo, Null), "y": Variant(MyType.Bar, Null)})
