# Transport variant constructors are properly typed
# Verifies that the prelude's [type [Tcp] [Udp] ...] declaration
# creates typed variant constructors usable with connect builtin

[
  # type-of returns "Variant" for variant values
  tcp-type: [type-of Tcp]
  udp-type: [type-of Udp]

  # tag-of extracts the constructor name
  tcp-tag: [tag-of Tcp]
  icmp-tag: [tag-of Icmp]

  # Variants can be passed to functions
  extract-tag: [fn [let t] [tag-of t]]
  tcp-via-fn: [extract-tag Tcp]

  # Equality works on variants
  tcp-eq-tcp: [= Tcp Tcp]

  # All 6 transport constructors exist
  all-six: [0: Tcp  1: Udp  2: UnixStream  3: UnixDatagram  4: NamedPipe  5: Icmp]
]

