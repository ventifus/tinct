# Unit variant constructors are callable with one argument to wrap the payload.
# Runtime behavior: [Result.Ok 42] calls the Ok unit variant constructor, wrapping 42 as payload.
# Type checker should model this: NominalVariant(tag, {}) + 1 arg → NominalVariant(tag, {0: ArgType})
#
# Uses prelude-defined Ok/Error and locally-qualified constructors for type-check correctness.
[
  Status: [type Status Success [Failure]]

  # Call unit variant constructor with Int (prelude Ok)
  t1: [Ok 42]

  # Call unit variant constructor with String (qualified local constructor)
  t2: [Status.Failure "failed"]

  # Call unit variant constructor with another variant
  t3: [Ok [Status.Failure "nested"]]

  # Bare reference to unit variant (prelude None)
  t4: None

  # Bare reference to qualified constructor
  t5: Status.Success
]
=== out
Dict({"Status": Dict({"Status": Variant(Status.Status, Null), "Success": Variant(Status.Success, Null), "Failure": Variant(Status.Failure, Null)}), "t1": Variant(Result.Ok, Int(42)), "t2": Variant(Status.Failure, String("failed")), "t3": Variant(Result.Ok, Variant(Status.Failure, String("nested"))), "t4": Variant(Maybe.None, Null), "t5": Variant(Status.Success, Null)})
