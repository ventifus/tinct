# MPTC functional dependency improvement: [+ 1 2.0] should infer Float.
# The Add type class has FD (a,b) → c: once a=Int and b=Float are determined,
# the result type c is resolved to Float via instance lookup.
[
  # Add Int Float → Float (mixed promotion)
  r1: [+ 1 2.0]

  # Add Float Int → Float (symmetric)
  r2: [+ 2.0 1]

  # Add Int Int → Int (homogeneous)
  r3: [+ 1 2]

  # Add Float Float → Float (homogeneous float)
  r4: [+ 1.5 2.5]
]

---

%.r1
=== out
Float(3.0)

---

%.r2
=== out
Float(3.0)

---

%.r3
=== out
Int(3)

---

%.r4
=== out
Float(4.0)
