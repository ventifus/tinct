# Nested dict polymorphism: polymorphic functions in nested dicts
# should retain polymorphism when accessed via dot-notation

# Test 1: Basic polymorphic id function in nested dict
[helpers: [id: [fn [x@a] $x]]]

---
# Access helpers.id with Int — should succeed
[helpers.id 42]

---
# Access helpers.id with Str — should succeed (different instantiation)
[helpers.id "hello"]

---
# Test 2: Multiple polymorphic functions in nested dict
[utils: [
  identity: [fn [x@a] $x]
  first: [fn [x@a y@b] $x]
  second: [fn [x@a y@b] $y]
]]

---
# Call utils.identity with different types
[utils.identity 123]

---
[utils.identity "world"]

---
# Call utils.first with different types
[utils.first 1 "two"]

---
[utils.first "a" 2]

---
# Call utils.second with different types
[utils.second 1 "two"]

---
[utils.second "a" 2]

---
# Test 3: Constrained polymorphic function in nested dict
[math: [add-one: [fn [x@a] [+ $x 1]]]]

---
# Should work with Int
[math.add-one 41]

---
# Should work with Float
[math.add-one 3.14]
