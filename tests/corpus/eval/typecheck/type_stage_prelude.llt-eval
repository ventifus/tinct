# Test that type-stage documents are skipped in runtime evaluation
# The type-stage section should not contribute to the output

--- stage: type
[include %rust "type-core"]
[
  # Type-stage content
  TypeHelper: [fn [let x] [merge x [extra: "from-type-stage"]]]
]

---
# Runtime section
[result: "runtime-only"]
# Type-stage section (--- stage: type) is not evaluated at runtime.
# The [include %rust "type-core"] call and TypeHelper fn are skipped entirely.
# Only the second (runtime) document contributes to the output.
=== out
Dict({"result": String("runtime-only")})
