# Comprehensive proxy operations
# Tests: proxy construction, dot access, bracket access, type-of, conditional handlers

[
  # Basic proxy construction
  handler_echo: [fn [let field] field]
  proxy_basic: [proxy handler_echo]
  result_echo: proxy_basic.test

  # Proxy type-of
  proxy_type: [type-of [proxy handler_echo]]

  # Dot access with String keys
  handler_type: [fn [let key] [type-of key]]
  p_dot: [proxy handler_type]
  dot_result: p_dot.myfield

  # Multiple accesses
  handler_return: [fn [let name] name]
  p_multi: [proxy handler_return]
  access_a: p_multi.foo
  access_b: p_multi.bar

  # Conditional handler
  handler_cond: [fn [let name] [if [= name "x"] 10 20]]
  p_cond: [proxy handler_cond]
  cond_x: p_cond.x
  cond_y: p_cond.y

  # Handler with closure
  default: 42
  handler_closure: [fn [let key] default]
  p_closure: [proxy handler_closure]
  closure_result: p_closure.anything
]
=== out
Dict({"handler_echo": Function(field), "proxy_basic": Proxy, "result_echo": String("test"), "proxy_type": String("Proxy"), "handler_type": Function(key), "p_dot": Proxy, "dot_result": String("String"), "handler_return": Function(name), "p_multi": Proxy, "access_a": String("foo"), "access_b": String("bar"), "handler_cond": Function(name), "p_cond": Proxy, "cond_x": Int(10), "cond_y": Int(20), "default": Int(42), "handler_closure": Function(key), "p_closure": Proxy, "closure_result": Int(42)})
