# Comprehensive variant operations
# Tests: variant, tag-of, type-of, equality, str coercion, VarRef access

[
  # Variant construction
  Red: [variant "Red"]
  Blue: [variant "Blue"]
  Green: [variant "Green"]

  # Unit constructor evaluation
  unit_constructor: Red

  # tag-of operation
  tag_of_red: [tag-of Red]
  tag_of_green: [tag-of Green]

  # type-of operation
  type_of_variant: [type-of Red]

  # Equality operations
  eq_same: [= Red Red]
  eq_different: [= Red Blue]
  eq_same_green: [= Green Green]

  # String coercion
  str_variant: [str Red]

  # VarRef access
  selected: Red
  selected_type: [type-of selected]
]
