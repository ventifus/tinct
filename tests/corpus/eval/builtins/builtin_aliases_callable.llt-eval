# builtin-* aliases are directly callable as stable escape hatches
[
  a: [call $builtin-lt 1 2]
  b: [call $builtin-add 3 4]
  c: [call $builtin-eq hello hello]
  d: [call $builtin-if true 10 20]
  e: [call $collect [call $builtin-filter [fn [x] [call $builtin-lt $x 3]] [call $seq 1 [call $seq 2 []]]]]
  f: [call $collect [call $builtin-map [fn [x] [call $builtin-add $x 1]] [call $seq 10 [call $seq 20 []]]]]
  g: [call $builtin-sub 10 3]
  h: [call $builtin-mul 6 7]
  i: [call $builtin-div 15 3]
  j: [call $builtin-reduce [fn [acc x] [call $builtin-add $acc $x]] 0 [call $seq 1 [call $seq 2 [call $seq 3 []]]]]
  k: [call $collect [call $builtin-take 2 [call $seq 1 [call $seq 2 [call $seq 3 []]]]]]
  l: [call $collect [call $builtin-drop 1 [call $seq 1 [call $seq 2 [call $seq 3 []]]]]]
]
===
Dict({"a": Bool(true), "b": Int(7), "c": Bool(true), "d": Int(10), "e": Dict({0: Int(1), 1: Int(2)}), "f": Dict({0: Int(11), 1: Int(21)}), "g": Int(7), "h": Int(42), "i": Float(5), "j": Int(6), "k": Dict({0: Int(1), 1: Int(2)}), "l": Dict({0: Int(2), 1: Int(3)})})
