# Comprehensive control flow operations
# Tests: if, try, deep-materialize, materialize, apply

[
  # if conditionals
  if_true: [if true 1 2]
  if_false: [if false 1 2]

  # try operations
  try_success: [try [fn [] 42]]
  try_error: [try [fn [] [raise "caught"]]]

  # deep-materialize and materialize
  eval_deep: [deep-materialize [x: [+ 1 2]]]
  force_whnf: [materialize [+ 1 2]]

  # apply
  f: [fn [let x y] [+ x y]]
  apply_result: [apply f [0: 3  1: 4]]
]
