# Comprehensive control flow operations
# Tests: if, try, materialize, apply
--- uses: ["core"]
[
  # if conditionals
  if_true: [if true 1 2]
  if_false: [if false 1 2]

  # try operations
  try_success: [try [fn [] 42]]
  try_error: [try [fn [] [raise "caught"]]]

  # materialize forces to WHNF; test with a nested dict
  eval_deep: [materialize [x: [+ 1 2]]]
  force_whnf: [materialize [+ 1 2]]

  # apply
  f: [fn [let x y] [+ x y]]
  apply_result: [apply f [0: 3  1: 4]]
]
=== out
Dict({"if_true": Int(1), "if_false": Int(2), "try_success": Variant(Result.Ok, Int(42)), "try_error": Variant(Result.Error, String("caught")), "eval_deep": Dict({"x": Int(3)}), "force_whnf": Int(3), "f": Function(x, y), "apply_result": Int(7)})
