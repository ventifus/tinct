# Comprehensive sequence operations
# Tests: seq, head, tail, collect, range, iterate, take, drop, map, filter, reduce, cycle, repeat, unfold
# Covers construction, deconstruction, transformations, and edge cases

[
  # seq construction and collection
  seq_construct: [collect [seq 1 [seq 2 [seq 3 []]]]]
  seq_single: [collect [seq 99 []]]
  seq_nested: [collect [seq [x: 1] [seq [y: 2] []]]]
  seq_empty: [collect []]

  # head and tail operations
  seq_head: [head [seq 42 []]]
  seq_tail: [head [tail [seq 1 [seq 2 []]]]]
  seq_tail_empty: [collect [tail [seq 1 []]]]

  # type-of for seq
  seq_type: [type-of [seq 1 []]]

  # range operations
  range_finite: [collect [take 3 [range 0 10]]]
  range_empty: [collect [range 5 5]]
  range_single: [collect [range 0 1]]
  range_infinite: [collect [take 5 [range 0]]]

  # iterate operations
  iterate_take: [collect [take 5 [iterate [fn [let x] [+ x 1]] 0]]]

  # take and drop
  take_seq: [collect [take 2 [seq 1 [seq 2 [seq 3 []]]]]]
  take_zero: [collect [take 0 [seq 1 []]]]
  take_infinite: [collect [take 3 [range 0]]]
  drop_seq: [collect [drop 1 [seq 1 [seq 2 [seq 3 []]]]]]
  drop_zero: [collect [drop 0 [seq 1 []]]]
  drop_exceeds: [collect [drop 5 [seq 1 []]]]

  # map operations
  map_seq: [collect [map [fn [let x] [* x 2]] [seq 1 [seq 2 [seq 3 []]]]]]
  map_empty: [collect [map [fn [let x] x] []]]
  map_pipeline: [collect [map [fn [let x] [* x 2]] [filter [fn [let x] [> x 1]] [seq 1 [seq 2 [seq 3 []]]]]]]

  # filter operations
  filter_seq: [collect [filter [fn [let x] [> x 1]] [seq 1 [seq 2 [seq 3 []]]]]]
  filter_empty: [collect [filter [fn [let x] true] []]]

  # reduce operations
  reduce_seq: [reduce [fn [let acc x] [+ acc x]] 0 [seq 1 [seq 2 [seq 3 []]]]]
  reduce_empty_seq: [reduce [fn [let acc x] [+ acc x]] 0 []]

  # cycle operations
  cycle_take: [collect [take 5 [cycle ["a" "b"]]]]

  # repeat operations
  repeat_take: [collect [take 3 [repeat 42]]]

  # unfold operations
  unfold_finite: [collect [unfold [fn [let s] [if [> s 3] [] [$s [+ s 1]]]] 1]]

  # concat operations
  concat_large: [collect [take 2 [concat [seq 1 []] [seq 2 []]]]]

  # join operations
  join_seq: [join "," [seq "a" [seq "b" [seq "c" []]]]]
  join_seq_custom: [join "-" [seq "x" [seq "y" []]]]
  join_empty_seq: [join "," []]
]
=== out
