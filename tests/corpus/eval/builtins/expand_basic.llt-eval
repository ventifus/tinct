# expand: round-trip a simple source string through expand, verify the result structure
# Access the exprs field to verify expansion produced actual expressions
[
  expanded: [expand [load "42"]]
  type-ok: [= expanded.type "file"]
  has-exprs: [> [length [collect expanded.exprs]] 0]
  [and type-ok has-exprs]
]
=== out
true
