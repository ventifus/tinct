# builtin-eval error path: failing document populates result.diagnostics when program raises.
# Updated for S-939 unified diagnostics: builtin-eval [typed-doc scope-id] → {result, scope-id, diagnostics}
[call [fn [let]
  [src:       [builtin-str-bytes "[raise \"oops\"]"]]
  [parsed:    [builtin-parse src "test.llt"]]
  [desugared: [builtin-desugar parsed.program]]
  [docs:      [builtin-program-docs desugared]]
  [doc:       [builtin-get 0 docs]]
  [frames:    [scope-to-frames 0]]
  [resolved:  [builtin-resolve doc frames]]
  [result:    [builtin-eval resolved.doc 0]]
  [has-error: [if [null? result.diagnostics] 0 1]]
  has-error]]
=== out
Int(1)
