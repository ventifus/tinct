# builder-snapshot: creates frozen copy without freezing the builder
[
 b: [make-builder]
 _: [builder-set "x" 1 b]
 snap: [builder-snapshot b]
 _: [builder-set "y" 2 b]
 final: [builder-finish b]
 result: [snap: $snap  final: $final]
].result
