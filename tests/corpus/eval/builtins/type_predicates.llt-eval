# Comprehensive type predicate tests
# Tests all built-in type predicates (bool?, int?, float?, str?, dict?, fn?, null?, num?, seq?)
# with positive and negative test cases

[
  # bool? predicate
  bool_true: [bool? true]
  bool_false_val: [bool? false]  # false is still a bool
  bool_neg_int: [bool? 42]
  bool_neg_str: [bool? "not a bool"]

  # int? predicate
  int_true: [int? 42]
  int_neg_float: [int? 3.14]
  int_neg_str: [int? "not an int"]

  # float? predicate
  float_true: [float? 3.14]
  float_neg_int: [float? 42]
  float_neg_str: [float? "not a float"]

  # str? predicate
  str_true: [str? "hello"]
  str_neg_int: [str? 42]
  str_neg_bool: [str? true]

  # dict? predicate
  dict_true: [dict? [x: 1]]
  dict_empty: [dict? []]
  dict_list_shaped: [dict? [0: "a" 1: "b"]]
  dict_overlay: [dict? [x: 1 y: [merge [] [z: 3]]]]
  dict_neg_int: [dict? 42]
  dict_neg_str: [dict? "not a dict"]

  # fn? predicate
  fn_user_function: [fn? [fn [let x] x]]
  fn_builtin: [fn? $+]
  fn_neg_int: [fn? 42]
  fn_neg_str: [fn? "not a fn"]
  fn_neg_dict: [fn? [x: 1]]
  fn_neg_proxy: [fn? [proxy [fn [let path] 42]]]

  # null? predicate
  null_empty_dict: [null? []]
  null_merged_empty: [null? [merge [] []]]
  null_neg_non_empty: [null? [x: 1]]
  null_neg_list: [null? [0: "a"]]
  null_neg_int: [null? 42]
  null_neg_str: [null? "not null"]
  null_neg_seq: [null? [seq 1 []]]

  # num? predicate
  num_int: [num? 42]
  num_float: [num? 3.14]
  num_neg_str: [num? "not a number"]

  # seq? predicate
  seq_true: [seq? [seq 1 []]]
  seq_neg_int: [seq? 42]
  seq_neg_dict: [seq? [x: 1]]
]
