# Comprehensive string operations
# Tests: str, split, trim, trim-start, trim-end, replace, str-contains?, starts-with?, ends-with?
# str-slice, str-chars, str-to-upper-char, str-to-lower-char, str-index-of, str-map-chars, contains

[
  # String conversion
  str_convert: [str 42]

  # Split operations
  split_basic: [split "," "a,b,c"]
  split_length: [length [split "," "a,b,c"]]

  # Trim operations
  trim_both: [trim "  hello  "]
  trim_start: [trim-start "  hello"]
  trim_end: [trim-end "hello  "]

  # Replace operations
  replace_basic: [replace "world" "LLT" "hello world"]

  # Substring checking
  contains_basic: [str-contains? "hello world" "world"]
  contains_string: [contains? "hello" "ell"]
  starts_with: [starts-with? "hello" "hel"]
  ends_with: [ends-with? "hello" "llo"]

  # Slicing and indexing
  str_slice: [str-slice "hello" 1 3]
  str_index_of: [str-index-of "hello world" "world"]
  str_index_of_not_found: [str-index-of "hello world" "xyz"]
  str_index_of_empty: [str-index-of "hello" ""]

  # Character operations
  str_chars_head: [head [str-chars "abc"]]
  str_to_upper: [str-to-upper-char "h"]
  str_to_lower: [str-to-lower-char "H"]
  str_map_chars_basic: [str-map-chars [fn [let c] [str-to-upper-char c]] "ab"]
  str_map_chars_empty: [str-map-chars [fn [let c] c] ""]

  # First/last characters
  first_string: [first "hello"]
  last_string: [last "world"]
]
=== out
Dict({"str_convert": String("42"), "split_basic": Dict({0: String("a"), 1: String("b"), 2: String("c")}), "split_length": Int(3), "trim_both": String("hello"), "trim_start": String("hello"), "trim_end": String("hello"), "replace_basic": String("hello LLT"), "contains_basic": Bool(true), "contains_string": Bool(true), "starts_with": Bool(true), "ends_with": Bool(true), "str_slice": String("el"), "str_index_of": Int(6), "str_index_of_not_found": Int(-1), "str_index_of_empty": Int(0), "str_chars_head": String("a"), "str_to_upper": String("H"), "str_to_lower": String("h"), "str_map_chars_basic": String("AB"), "str_map_chars_empty": String(""), "first_string": String("h"), "last_string": String("d")})
