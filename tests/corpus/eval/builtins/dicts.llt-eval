# Comprehensive dict operations
# Tests: keys, merge, map, filter, reduce, length, take, drop, get
# Covers construction, transformation, merging, and edge cases

[
  # Keys extraction
  keys_basic: [keys [a: 1  b: 2]]

  # Length operations
  length_dict: [length [a: 1  b: 2  c: 3]]
  length_string: [length "hello"]
  length_bytes: [length [bytes-of [0 255]]]

  # Merge operations
  merge_basic: [merge [a: 1  b: 2] [b: 3  c: 4]]
  merge_disjoint: [merge [a: 1] [b: 2]]
  merge_right_overrides: [merge [a: 1] [a: 2]]
  merge_lazy_overlay: [
    merged: [merge [x: 10  y: 20] [y: 99  z: 30]]
    x-val: merged.x
    y-val: merged.y
    z-val: merged.z
  ]

  # Map operations on dicts
  map_dict: [map [fn [x] [* x 2]] [a: 1 b: 2 c: 3]]
  map_empty_dict: [map [fn [x] [* x 2]] []]

  # Filter operations on dicts (returns seq)
  filter_dict: [collect [filter [fn [x] [> x 2]] [a: 1 b: 3 c: 5]]]
  filter_dict_multi: [collect [filter [fn [x] [> x 2]] [a: 1 b: 2 c: 3 d: 4 e: 5]]]
  filter_empty_dict: [collect [filter [fn [x] true] []]]

  # Reduce operations on dicts
  reduce_dict: [reduce [fn [acc x] [+ acc x]] 0 [10 20 30]]
  reduce_empty_dict: [reduce [fn [acc x] [+ acc x]] 99 []]

  # Take and drop on dicts
  take_dict: [take 2 [a: 1  b: 2  c: 3]]
  drop_dict: [drop 1 [a: 1  b: 2  c: 3]]
  drop_exceeds_dict: [drop 5 [a: 1]]

  # Get operations
  get_basic: [get "a" [a: 1  b: 2]]

  # Structural equality
  dict_structural_eq: [= [a: 1  b: 2] [a: 1  b: 2]]
]
