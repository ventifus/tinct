# Comprehensive arithmetic and math operations
# Tests: +, -, *, /, floor, round, pow, sqrt, sin, <, >, <=, >=, ==
# Covers integer, float, and type promotion

[
  # Basic arithmetic - integers
  add_int: [+ 3 4]
  sub_int: [- 10 3]
  mul_int: [* 6 7]

  # Division - floats
  div_float: [/ 10.0 2.0]

  # Type promotion
  add_promotion: [+ 1 2.5]

  # Rounding and floor
  floor_test: [floor 3.7]
  round_test: [round 3.5]

  # Advanced math
  pow_test: [builtin-pow 2 8]
  sqrt_test: [builtin-sqrt 16.0]
  sin_test: [builtin-sin 0.0]

  # Comparison - integers
  lt_int: [< 3 5]
  lt_bool: [< true false]

  # Comparison - booleans
  gt_bool: [> false true]
  le_bool: [<= true true]
  ge_bool: [>= false false]

  # Equality
  eq_test: [= 42 42]

  # Bitwise operations
  band_test: [band 12 10]
  bor_test: [bor 4 8]
  bxor_test: [bxor 6 3]
  shl_test: [shl 1 3]
  shr_test: [shr 16 2]
]
