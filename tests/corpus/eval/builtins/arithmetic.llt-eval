# Comprehensive arithmetic and math operations
# Tests: +, -, *, /, floor, round, pow, sqrt, sin, <, >, <=, >=, ==
# Covers integer, float, and type promotion
--- uses: ["math"]

[
  # Basic arithmetic - integers
  add_int: [+ 3 4]
  sub_int: [- 10 3]
  mul_int: [* 6 7]

  # Division - floats
  div_float: [/ 10.0 2.0]

  # Type promotion
  add_promotion: [+ 1 2.5]

  # Rounding and floor
  floor_test: [floor 3.7]
  round_test: [round 3.5]

  # Advanced math
  pow_test: [builtin-pow 2 8]
  sqrt_test: [builtin-sqrt 16.0]
  sin_test: [builtin-sin 0.0]

  # Comparison - integers only (Bool is not Comparable)
  lt_int: [< 3 5]
  gt_int: [> 5 3]
  le_int: [<= 3 3]
  ge_int: [>= 5 3]

  # Equality
  eq_test: [= 42 42]

  # Bitwise operations
  band_test: [band 12 10]
  bor_test: [bor 4 8]
  bxor_test: [bxor 6 3]
  shl_test: [shl 1 3]
  shr_test: [shr 16 2]
]
=== out
Dict({"add_int": Int(7), "sub_int": Int(7), "mul_int": Int(42), "div_float": Float(5), "add_promotion": Float(3.5), "floor_test": Int(3), "round_test": Int(4), "pow_test": Float(256), "sqrt_test": Float(4), "sin_test": Float(0), "lt_int": Bool(true), "gt_int": Bool(true), "le_int": Bool(true), "ge_int": Bool(true), "eq_test": Bool(true), "band_test": Int(8), "bor_test": Int(12), "bxor_test": Int(5), "shl_test": Int(8), "shr_test": Int(4)})
