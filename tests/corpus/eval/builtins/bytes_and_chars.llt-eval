# Comprehensive bytes and character operations
# Tests: bytes-of, bytes-find, bytes-equal?, str-bytes, chr, char-code

[
  # Bytes construction
  bytes_basic: [bytes-of [72 101 108 108 111]]
  bytes_dict: [bytes-of [0: 65  1: 66]]
  bytes_empty: [bytes-of []]

  # Bytes equality
  bytes_eq_true: [bytes-equal? [bytes-of [1 2 3]] [bytes-of [1 2 3]]]
  bytes_eq_false: [bytes-equal? [bytes-of [1 2 3]] [bytes-of [1 2 4]]]
  bytes_eq_length: [bytes-equal? [bytes-of [1 2]] [bytes-of [1 2 3]]]

  # Bytes find operations
  bytes_find_start: [bytes-find [bytes-of [1 2 3 4 5]] [bytes-of [1 2]]]
  bytes_find_middle: [bytes-find [bytes-of [1 2 3 4 5]] [bytes-of [3 4]]]
  bytes_find_not_found: [bytes-find [bytes-of [1 2 3 4 5]] [bytes-of [9 9]]]
  bytes_find_empty: [bytes-find [bytes-of [1 2 3]] [bytes-of []]]

  # String-bytes roundtrip
  str_bytes_roundtrip: [bytes-str [str-bytes "hello"]]
  str_bytes_utf8: [bytes-str [str-bytes "café"]]

  # Character operations
  chr_basic: [chr 65]
  char_code_basic: [char-code "A"]
]
