# builtin-read-line: read successive lines from a string-handle
# Verifies: newline stripping, sequential reads on shared handle, EOF returns []
[h: [string-handle "line1\nline2\nline3"]]
[a: [builtin-read-line h]]
[b: [builtin-read-line h]]
[c: [builtin-read-line h]]
[d: [builtin-read-line h]]
[str a "|" b "|" c "|" [str? d]]
