# Comprehensive numeric type operations
# Tests: decimal, big-int, to-int, to-float, type-of, nan?, inf?, finite?

[
  # Decimal operations
  decimal_parse: [decimal "9.99"]
  decimal_from_int: [decimal 42]
  decimal_type: [type-of [decimal "1.5"]]

  # BigInt operations
  bigint_from_string: [big-int "99999999999999999999"]
  bigint_from_int: [big-int 42]
  bigint_type: [type-of [big-int "123"]]

  # Type conversions
  to_int_from_string: [to-int "42"]
  to_float_from_string: [to-float "3.14"]
  floor_converts_float: [floor 3.7]

  # Float predicates
  nan_pred: [builtin-nan? [builtin-sqrt -1]]
  inf_pred: [builtin-inf? [builtin-log 0]]
  finite_pred: [builtin-finite? 42.0]
]
