       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:1156:5-1158:53
   |
  1156 |     [builtin-if [builtin-gte i [length ks]]
  1157 |         [error [str "key not found: " target]]
  1158 |         [find-deep-check xs target ks i [get i ks]]]]
