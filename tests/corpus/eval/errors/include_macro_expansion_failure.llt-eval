# Test E080: include propagates macro expansion errors from the included file.
# `include` (prelude.llt:2897) loads, expands, and evaluates a tinct file.
# tests/corpus/eval/macros/macro_lib.llt defines `my-add` as a 1-argument macro
# but calls it as `[my-add 1 2]` (2 arguments), causing an arity mismatch during
# macro expansion inside the included file. The error propagates through
# include-evaluate-and-cache → include-cache-failure → builtin-raise.
[
  lib: [include %cwd "tests/corpus/eval/macros/macro_lib.llt"]
]
=== error
[E080] expand: macro expansion error: macro 'my-add' transformer call failed: arity mismatch: expected 1 argument, got 2 (defined at stdlib/prelude.llt:2066:28-2066:47)
  --> stdlib/prelude.llt:2066:28-2066:47
   |
  2066 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2066:28-2066:47
   |
  2066 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2931:24-2935:13
   |
  2931 | include-cache-failure: [fn@[return: Never  doc: """
  2932 | Reset include cache entry on error and re-raise. Internal helper for include.
  2933 | """] [let hash e]
  2934 |   [builtin-include-cache-put hash Missing]
  2935 |   [raise e]]
       | ^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2953:3-2955:56
   |
  2953 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2954 |     [Result.Ok result]: [include-cache-success hash result]
  2955 |     [Result.Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2940:29-2955:57
   |
  2940 | include-evaluate-and-cache: [fn@[return: Any  doc: """
  2941 | Evaluate a file and update the content-addressed include cache.
  2942 | 
  2943 | source:         source text string
  2944 | path:           file path string (for error spans)
  2945 | hash:           content cache key (blake3(cap-identity + "|" + source))
  2946 | cap:            DirCap — passed as %include-dir; included files start with % = []
  2947 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2948 | """] [let source path hash cap integrity-hash@[default: Absent]]
  2949 |   [builtin-include-cache-put hash Pending]
  2950 |   [program: [if [absent? integrity-hash]
  2951 |     [load source name: path]
  2952 |     [load source name: path hash: integrity-hash]]]
  2953 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2954 |     [Result.Ok result]: [include-cache-success hash result]
  2955 |     [Result.Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2980:3-2983:121
   |
  2980 |   [match [builtin-include-cache-get hash]
  2981 |     [IncludeCacheEntry.Cached result]: result
  2982 |     [IncludeCacheEntry.Pending]:       [error [str "circular include: " path]]
  2983 |     [IncludeCacheEntry.Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2967:10-2983:122
   |
  2967 | include: [fn@[return: Any  doc: """
  2968 | Load, expand, and evaluate a tinct file from a DirCap.
  2969 | 
  2970 | cap:            DirCap — confines filesystem access; injected as %include-dir
  2971 | path:           String — file path relative to cap
  2972 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2973 | 
  2974 | Uses content-addressed memoization: blake3(cap-identity + "|" + source).
  2975 | Detects circular includes via Pending cache state.
  2976 | Included files start with % = [] (fresh pipeline input).
  2977 | """] [let cap@DirCap path@String integrity-hash@[default: Absent]]
  2978 |   [source: [builtin-read-all [open cap path Readable]]]
  2979 |   [hash:   [blake3 [str [cap-identity cap] "|" source]]]
  2980 |   [match [builtin-include-cache-get hash]
  2981 |     [IncludeCacheEntry.Cached result]: result
  2982 |     [IncludeCacheEntry.Pending]:       [error [str "circular include: " path]]
  2983 |     [IncludeCacheEntry.Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
