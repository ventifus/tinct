# Test E080: include propagates macro expansion errors from the included file.
# `include` (prelude.llt:2897) loads, expands, and evaluates a tinct file.
# tests/corpus/eval/macros/macro_lib.llt defines `my-add` as a 1-argument macro
# but calls it as `[my-add 1 2]` (2 arguments), causing an arity mismatch during
# macro expansion inside the included file. The error propagates through
# include-evaluate-and-cache → include-cache-failure → builtin-raise.
[
  lib: [include %cwd "tests/corpus/eval/macros/macro_lib.llt"]
]
=== error
[E080] expand: macro expansion error: macro 'my-add' transformer call failed: arity mismatch: expected 1 argument, got 2 (defined at stdlib/prelude.llt:2447:28-2447:47)
  --> stdlib/prelude.llt:2447:28-2447:47
   |
  2447 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2447:28-2447:47
   |
  2447 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3351:24-3355:13
   |
  3351 | include-cache-failure: [fn@[return: Never  doc: """
  3352 | Reset include cache entry on error and re-raise. Internal helper for include.
  3353 | """] [let hash e]
  3354 |   [builtin-include-cache-put hash Missing]
  3355 |   [raise e]]
       | ^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3373:3-3375:56
   |
  3373 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  3374 |     [Result.Ok result]: [include-cache-success hash result]
  3375 |     [Result.Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3360:29-3375:57
   |
  3360 | include-evaluate-and-cache: [fn@[return: Any  doc: """
  3361 | Evaluate a file and update the content-addressed include cache.
  3362 | 
  3363 | source:         source text string
  3364 | path:           file path string (for error spans)
  3365 | hash:           content cache key (blake3(cap-identity + "|" + source))
  3366 | cap:            DirCap — passed as %include-dir; included files start with % = []
  3367 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  3368 | """] [let source path hash cap integrity-hash@[default: Absent]]
  3369 |   [builtin-include-cache-put hash Pending]
  3370 |   [program: [if [absent? integrity-hash]
  3371 |     [load source name: path]
  3372 |     [load source name: path hash: integrity-hash]]]
  3373 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  3374 |     [Result.Ok result]: [include-cache-success hash result]
  3375 |     [Result.Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3400:3-3403:121
   |
  3400 |   [match [builtin-include-cache-get hash]
  3401 |     [IncludeCacheEntry.Cached result]: result
  3402 |     [IncludeCacheEntry.Pending]:       [error [str "circular include: " path]]
  3403 |     [IncludeCacheEntry.Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3387:10-3403:122
   |
  3387 | include: [fn@[return: Any  doc: """
  3388 | Load, expand, and evaluate a tinct file from a DirCap.
  3389 | 
  3390 | cap:            DirCap — confines filesystem access; injected as %include-dir
  3391 | path:           String — file path relative to cap
  3392 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  3393 | 
  3394 | Uses content-addressed memoization: blake3(cap-identity + "|" + source).
  3395 | Detects circular includes via Pending cache state.
  3396 | Included files start with % = [] (fresh pipeline input).
  3397 | """] [let cap@DirCap path@String integrity-hash@[default: Absent]]
  3398 |   [source: [builtin-read-all [open cap path Readable]]]
  3399 |   [hash:   [blake3 [str [cap-identity cap] "|" source]]]
  3400 |   [match [builtin-include-cache-get hash]
  3401 |     [IncludeCacheEntry.Cached result]: result
  3402 |     [IncludeCacheEntry.Pending]:       [error [str "circular include: " path]]
  3403 |     [IncludeCacheEntry.Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
