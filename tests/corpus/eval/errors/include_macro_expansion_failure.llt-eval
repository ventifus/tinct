# Test E080: include propagates macro expansion errors from the included file.
# `include` (prelude.llt:2897) loads, expands, and evaluates a tinct file.
# tests/corpus/eval/macros/macro_lib.llt defines `my-add` as a 1-argument macro
# but calls it as `[my-add 1 2]` (2 arguments), causing an arity mismatch during
# macro expansion inside the included file. The error propagates through
# include-evaluate-and-cache → include-cache-failure → builtin-raise.
[
  lib: [include %cwd "tests/corpus/eval/macros/macro_lib.llt"]
]
=== error
[E080] expand: macro expansion error: macro 'my-add' transformer call failed: arity mismatch: expected 1 argument, got 2 (defined at stdlib/prelude.llt:2052:28-2052:47)
  --> stdlib/prelude.llt:2052:28-2052:47
   |
  2052 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2052:28-2052:47
   |
  2052 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2849:24-2853:13
   |
  2849 | include-cache-failure: [fn@[return: Never  doc: """
  2850 | Reset include cache entry on error and re-raise. Internal helper for include.
  2851 | """] [let hash e]
  2852 |   [builtin-include-cache-put hash Missing]
  2853 |   [raise e]]
       | ^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2871:3-2873:49
   |
  2871 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2872 |     [Ok result]: [include-cache-success hash result]
  2873 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2858:29-2873:50
   |
  2858 | include-evaluate-and-cache: [fn@[return: Any  doc: """
  2859 | Evaluate a file and update the content-addressed include cache.
  2860 | 
  2861 | source:         source text string
  2862 | path:           file path string (for error spans)
  2863 | hash:           content cache key (blake3(cap-identity + "|" + source))
  2864 | cap:            DirCap — passed as %include-dir; included files start with % = []
  2865 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2866 | """] [let source path hash cap integrity-hash@[default: []]]
  2867 |   [builtin-include-cache-put hash Pending]
  2868 |   [program: [if [null? integrity-hash]
  2869 |     [load source name: path]
  2870 |     [load source name: path hash: integrity-hash]]]
  2871 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2872 |     [Ok result]: [include-cache-success hash result]
  2873 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2898:3-2901:103
   |
  2898 |   [match [builtin-include-cache-get hash]
  2899 |     [Cached result]: result
  2900 |     Pending:         [error [str "circular include: " path]]
  2901 |     Missing:         [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2885:10-2901:104
   |
  2885 | include: [fn@[return: Any  doc: """
  2886 | Load, expand, and evaluate a tinct file from a DirCap.
  2887 | 
  2888 | cap:            DirCap — confines filesystem access; injected as %include-dir
  2889 | path:           String — file path relative to cap
  2890 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2891 | 
  2892 | Uses content-addressed memoization: blake3(cap-identity + "|" + source).
  2893 | Detects circular includes via [Pending] cache state.
  2894 | Included files start with % = [] (fresh pipeline input).
  2895 | """] [let cap@DirCap path@String integrity-hash@[default: []]]
  2896 |   [source: [builtin-read-all [open cap path Readable]]]
  2897 |   [hash:   [blake3 [str [cap-identity cap] "|" source]]]
  2898 |   [match [builtin-include-cache-get hash]
  2899 |     [Cached result]: result
  2900 |     Pending:         [error [str "circular include: " path]]
  2901 |     Missing:         [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
