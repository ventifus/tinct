# Test E080: include propagates macro expansion errors from the included file.
# `include` (prelude.llt:2897) loads, expands, and evaluates a tinct file.
# tests/corpus/eval/macros/macro_lib.llt defines `my-add` as a 1-argument macro
# but calls it as `[my-add 1 2]` (2 arguments), causing an arity mismatch during
# macro expansion inside the included file. The error propagates through
# include-evaluate-and-cache → include-cache-failure → builtin-raise.
[
  lib: [include %cwd "tests/corpus/eval/macros/macro_lib.llt"]
]
=== error
[E080] expand: macro expansion error: macro 'my-add' transformer call failed: arity mismatch: expected 1 argument, got 2 (defined at stdlib/prelude.llt:2050:28-2050:47)
  --> stdlib/prelude.llt:2050:28-2050:47
   |
  2050 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2050:28-2050:47
   |
  2050 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2906:24-2910:13
   |
  2906 | include-cache-failure: [fn@[return: Never  doc: """
  2907 | Reset include cache entry on error and re-raise. Internal helper for include.
  2908 | """] [let hash e]
  2909 |   [builtin-include-cache-put hash Missing]
  2910 |   [raise e]]
       | ^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2928:3-2930:49
   |
  2928 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2929 |     [Ok result]: [include-cache-success hash result]
  2930 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2915:29-2930:50
   |
  2915 | include-evaluate-and-cache: [fn@[return: Any  doc: """
  2916 | Evaluate a file and update the content-addressed include cache.
  2917 | 
  2918 | source:         source text string
  2919 | path:           file path string (for error spans)
  2920 | hash:           content cache key (blake3(cap-identity + "|" + source))
  2921 | cap:            DirCap — passed as %include-dir; included files start with % = []
  2922 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2923 | """] [let source path hash cap integrity-hash@[default: []]]
  2924 |   [builtin-include-cache-put hash Pending]
  2925 |   [program: [if [null? integrity-hash]
  2926 |     [load source name: path]
  2927 |     [load source name: path hash: integrity-hash]]]
  2928 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2929 |     [Ok result]: [include-cache-success hash result]
  2930 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2955:3-2958:103
   |
  2955 |   [match [builtin-include-cache-get hash]
  2956 |     [Cached result]: result
  2957 |     [Pending]:       [error [str "circular include: " path]]
  2958 |     [Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2942:10-2958:104
   |
  2942 | include: [fn@[return: Any  doc: """
  2943 | Load, expand, and evaluate a tinct file from a DirCap.
  2944 | 
  2945 | cap:            DirCap — confines filesystem access; injected as %include-dir
  2946 | path:           String — file path relative to cap
  2947 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2948 | 
  2949 | Uses content-addressed memoization: blake3(cap-identity + "|" + source).
  2950 | Detects circular includes via [Pending] cache state.
  2951 | Included files start with % = [] (fresh pipeline input).
  2952 | """] [let cap@DirCap path@String integrity-hash@[default: []]]
  2953 |   [source: [builtin-read-all [open cap path Readable]]]
  2954 |   [hash:   [blake3 [str [cap-identity cap] "|" source]]]
  2955 |   [match [builtin-include-cache-get hash]
  2956 |     [Cached result]: result
  2957 |     [Pending]:       [error [str "circular include: " path]]
  2958 |     [Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
