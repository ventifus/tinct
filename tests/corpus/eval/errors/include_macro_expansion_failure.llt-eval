# Test E080: include propagates macro expansion errors from the included file.
# `include` (prelude.llt:2897) loads, expands, and evaluates a tinct file.
# tests/corpus/eval/macros/macro_lib.llt defines `my-add` as a 1-argument macro
# but calls it as `[my-add 1 2]` (2 arguments), causing an arity mismatch during
# macro expansion inside the included file. The error propagates through
# include-evaluate-and-cache → include-cache-failure → builtin-raise.
[
  lib: [include %cwd "tests/corpus/eval/macros/macro_lib.llt"]
]
=== error
[E080] expand: macro expansion error: macro 'my-add' transformer call failed: arity mismatch: expected 1 argument, got 2 (defined at stdlib/prelude.llt:2490:28-2490:47)
  --> stdlib/prelude.llt:2490:28-2490:47
   |
  2490 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2490:28-2490:47
   |
  2490 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3402:24-3406:13
   |
  3402 | include-cache-failure: [fn@[return: Never  doc: """
  3403 | Reset include cache entry on error and re-raise. Internal helper for include.
  3404 | """] [let hash e]
  3405 |   [builtin-include-cache-put hash IncludeCacheEntry.Missing]
  3406 |   [raise e]]
       | ^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3424:3-3426:78
   |
  3424 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  3425 |     [case [let result] [Result.Ok result]    [include-cache-success hash result]]
  3426 |     [case [let e]      [Result.Error e]      [include-cache-failure hash e]]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3411:29-3426:79
   |
  3411 | include-evaluate-and-cache: [fn@[return: Any  doc: """
  3412 | Evaluate a file and update the content-addressed include cache.
  3413 | 
  3414 | source:         source text string
  3415 | path:           file path string (for error spans)
  3416 | hash:           content cache key (blake3(cap-identity + "|" + source))
  3417 | cap:            DirCap — passed as %include-dir; included files start with % = []
  3418 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  3419 | """] [let source path hash cap integrity-hash@[default: Absent.Absent]]
  3420 |   [builtin-include-cache-put hash IncludeCacheEntry.Pending]
  3421 |   [program: [if [absent? integrity-hash]
  3422 |     [load source name: path]
  3423 |     [load source name: path hash: integrity-hash]]]
  3424 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  3425 |     [case [let result] [Result.Ok result]    [include-cache-success hash result]]
  3426 |     [case [let e]      [Result.Error e]      [include-cache-failure hash e]]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3451:3-3454:121
   |
  3451 |   [match [builtin-include-cache-get hash]
  3452 |     [case [let result] [IncludeCacheEntry.Cached result] result]
  3453 |     [IncludeCacheEntry.Pending]:       [error [str "circular include: " path]]
  3454 |     [IncludeCacheEntry.Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3438:10-3454:122
   |
  3438 | include: [fn@[return: Any  doc: """
  3439 | Load, expand, and evaluate a tinct file from a DirCap.
  3440 | 
  3441 | cap:            DirCap — confines filesystem access; injected as %include-dir
  3442 | path:           String — file path relative to cap
  3443 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  3444 | 
  3445 | Uses content-addressed memoization: blake3(cap-identity + "|" + source).
  3446 | Detects circular includes via Pending cache state.
  3447 | Included files start with % = [] (fresh pipeline input).
  3448 | """] [let cap@DirCap path@String integrity-hash@[default: Absent.Absent]]
  3449 |   [source: [builtin-read-all [open cap path OpenFlag.Readable]]]
  3450 |   [hash:   [blake3 [str [cap-identity cap] "|" source]]]
  3451 |   [match [builtin-include-cache-get hash]
  3452 |     [case [let result] [IncludeCacheEntry.Cached result] result]
  3453 |     [IncludeCacheEntry.Pending]:       [error [str "circular include: " path]]
  3454 |     [IncludeCacheEntry.Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
