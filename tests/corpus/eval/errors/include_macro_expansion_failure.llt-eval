# Test E080: include propagates macro expansion errors from the included file.
# `include` (prelude.llt:2897) loads, expands, and evaluates a tinct file.
# tests/corpus/eval/macros/macro_lib.llt defines `my-add` as a 1-argument macro
# but calls it as `[my-add 1 2]` (2 arguments), causing an arity mismatch during
# macro expansion inside the included file. The error propagates through
# include-evaluate-and-cache → include-cache-failure → builtin-raise.
[
  lib: [include %cwd "tests/corpus/eval/macros/macro_lib.llt"]
]
=== error
[E080] expand: macro expansion error: macro 'my-add' transformer call failed: arity mismatch: expected 1 argument, got 2 (defined at stdlib/prelude.llt:2496:28-2496:47)
  --> stdlib/prelude.llt:2496:28-2496:47
   |
  2496 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2496:28-2496:47
   |
  2496 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3408:24-3412:13
   |
  3408 | include-cache-failure: [fn@[return: Never  doc: """
  3409 | Reset include cache entry on error and re-raise. Internal helper for include.
  3410 | """] [let hash e]
  3411 |   [builtin-include-cache-put hash IncludeCacheEntry.Missing]
  3412 |   [raise e]]
       | ^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3430:3-3432:78
   |
  3430 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  3431 |     [case [let result] [Result.Ok result]    [include-cache-success hash result]]
  3432 |     [case [let e]      [Result.Error e]      [include-cache-failure hash e]]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3417:29-3432:79
   |
  3417 | include-evaluate-and-cache: [fn@[return: Any  doc: """
  3418 | Evaluate a file and update the content-addressed include cache.
  3419 | 
  3420 | source:         source text string
  3421 | path:           file path string (for error spans)
  3422 | hash:           content cache key (blake3(cap-identity + "|" + source))
  3423 | cap:            DirCap — passed as %include-dir; included files start with % = []
  3424 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  3425 | """] [let source path hash cap integrity-hash@[default: Absent.Absent]]
  3426 |   [builtin-include-cache-put hash IncludeCacheEntry.Pending]
  3427 |   [program: [if [absent? integrity-hash]
  3428 |     [load source name: path]
  3429 |     [load source name: path hash: integrity-hash]]]
  3430 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  3431 |     [case [let result] [Result.Ok result]    [include-cache-success hash result]]
  3432 |     [case [let e]      [Result.Error e]      [include-cache-failure hash e]]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3457:3-3460:121
   |
  3457 |   [match [builtin-include-cache-get hash]
  3458 |     [case [let result] [IncludeCacheEntry.Cached result] result]
  3459 |     [IncludeCacheEntry.Pending]:       [error [str "circular include: " path]]
  3460 |     [IncludeCacheEntry.Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3444:10-3460:122
   |
  3444 | include: [fn@[return: Any  doc: """
  3445 | Load, expand, and evaluate a tinct file from a DirCap.
  3446 | 
  3447 | cap:            DirCap — confines filesystem access; injected as %include-dir
  3448 | path:           String — file path relative to cap
  3449 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  3450 | 
  3451 | Uses content-addressed memoization: blake3(cap-identity + "|" + source).
  3452 | Detects circular includes via Pending cache state.
  3453 | Included files start with % = [] (fresh pipeline input).
  3454 | """] [let cap@DirCap path@String integrity-hash@[default: Absent.Absent]]
  3455 |   [source: [builtin-read-all [open cap path OpenFlag.Readable]]]
  3456 |   [hash:   [blake3 [str [cap-identity cap] "|" source]]]
  3457 |   [match [builtin-include-cache-get hash]
  3458 |     [case [let result] [IncludeCacheEntry.Cached result] result]
  3459 |     [IncludeCacheEntry.Pending]:       [error [str "circular include: " path]]
  3460 |     [IncludeCacheEntry.Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
