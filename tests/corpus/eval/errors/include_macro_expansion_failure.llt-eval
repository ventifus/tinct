# Test E080: include propagates macro expansion errors from the included file.
# `include` (prelude.llt:2897) loads, expands, and evaluates a tinct file.
# tests/corpus/eval/macros/macro_lib.llt defines `my-add` as a 1-argument macro
# but calls it as `[my-add 1 2]` (2 arguments), causing an arity mismatch during
# macro expansion inside the included file. The error propagates through
# include-evaluate-and-cache → include-cache-failure → builtin-raise.
[
  lib: [include %cwd "tests/corpus/eval/macros/macro_lib.llt"]
]
=== error
[E080] expand: macro expansion error: macro 'my-add' transformer call failed: arity mismatch: expected 1 argument, got 2 (defined at stdlib/prelude.llt:2050:28-2050:47)
  --> stdlib/prelude.llt:2050:28-2050:47
   |
  2050 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2050:28-2050:47
   |
  2050 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2914:24-2918:13
   |
  2914 | include-cache-failure: [fn@[return: Never  doc: """
  2915 | Reset include cache entry on error and re-raise. Internal helper for include.
  2916 | """] [let hash e]
  2917 |   [builtin-include-cache-put hash Missing]
  2918 |   [raise e]]
       | ^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2936:3-2938:49
   |
  2936 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2937 |     [Ok result]: [include-cache-success hash result]
  2938 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2923:29-2938:50
   |
  2923 | include-evaluate-and-cache: [fn@[return: Any  doc: """
  2924 | Evaluate a file and update the content-addressed include cache.
  2925 | 
  2926 | source:         source text string
  2927 | path:           file path string (for error spans)
  2928 | hash:           content cache key (blake3(cap-identity + "|" + source))
  2929 | cap:            DirCap — passed as %include-dir; included files start with % = []
  2930 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2931 | """] [let source path hash cap integrity-hash@[default: []]]
  2932 |   [builtin-include-cache-put hash Pending]
  2933 |   [program: [if [null? integrity-hash]
  2934 |     [load source name: path]
  2935 |     [load source name: path hash: integrity-hash]]]
  2936 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2937 |     [Ok result]: [include-cache-success hash result]
  2938 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2963:3-2966:103
   |
  2963 |   [match [builtin-include-cache-get hash]
  2964 |     [Cached result]: result
  2965 |     [Pending]:       [error [str "circular include: " path]]
  2966 |     [Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2950:10-2966:104
   |
  2950 | include: [fn@[return: Any  doc: """
  2951 | Load, expand, and evaluate a tinct file from a DirCap.
  2952 | 
  2953 | cap:            DirCap — confines filesystem access; injected as %include-dir
  2954 | path:           String — file path relative to cap
  2955 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2956 | 
  2957 | Uses content-addressed memoization: blake3(cap-identity + "|" + source).
  2958 | Detects circular includes via [Pending] cache state.
  2959 | Included files start with % = [] (fresh pipeline input).
  2960 | """] [let cap@DirCap path@String integrity-hash@[default: []]]
  2961 |   [source: [builtin-read-all [open cap path Readable]]]
  2962 |   [hash:   [blake3 [str [cap-identity cap] "|" source]]]
  2963 |   [match [builtin-include-cache-get hash]
  2964 |     [Cached result]: result
  2965 |     [Pending]:       [error [str "circular include: " path]]
  2966 |     [Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
