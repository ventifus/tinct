# Test E080: include propagates macro expansion errors from the included file.
# `include` (prelude.llt:2897) loads, expands, and evaluates a tinct file.
# tests/corpus/eval/macros/macro_lib.llt defines `my-add` as a 1-argument macro
# but calls it as `[my-add 1 2]` (2 arguments), causing an arity mismatch during
# macro expansion inside the included file. The error propagates through
# include-evaluate-and-cache → include-cache-failure → builtin-raise.
[
  lib: [include %cwd "tests/corpus/eval/macros/macro_lib.llt"]
]
=== error
[E080] expand: macro expansion error: macro 'my-add' transformer call failed: arity mismatch: expected 1 argument, got 2 (defined at stdlib/prelude.llt:2051:28-2051:47)
  --> stdlib/prelude.llt:2051:28-2051:47
   |
  2051 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2051:28-2051:47
   |
  2051 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2891:24-2895:13
   |
  2891 | include-cache-failure: [fn@[return: Never  doc: """
  2892 | Reset include cache entry on error and re-raise. Internal helper for include.
  2893 | """] [let hash e]
  2894 |   [builtin-include-cache-put hash Missing]
  2895 |   [raise e]]
       | ^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2913:3-2915:49
   |
  2913 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2914 |     [Ok result]: [include-cache-success hash result]
  2915 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2900:29-2915:50
   |
  2900 | include-evaluate-and-cache: [fn@[return: Any  doc: """
  2901 | Evaluate a file and update the content-addressed include cache.
  2902 | 
  2903 | source:         source text string
  2904 | path:           file path string (for error spans)
  2905 | hash:           content cache key (blake3(cap-identity + "|" + source))
  2906 | cap:            DirCap — passed as %include-dir; included files start with % = []
  2907 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2908 | """] [let source path hash cap integrity-hash@[default: []]]
  2909 |   [builtin-include-cache-put hash Pending]
  2910 |   [program: [if [null? integrity-hash]
  2911 |     [load source name: path]
  2912 |     [load source name: path hash: integrity-hash]]]
  2913 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2914 |     [Ok result]: [include-cache-success hash result]
  2915 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2940:3-2943:103
   |
  2940 |   [match [builtin-include-cache-get hash]
  2941 |     [Cached result]: result
  2942 |     Pending:         [error [str "circular include: " path]]
  2943 |     Missing:         [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2927:10-2943:104
   |
  2927 | include: [fn@[return: Any  doc: """
  2928 | Load, expand, and evaluate a tinct file from a DirCap.
  2929 | 
  2930 | cap:            DirCap — confines filesystem access; injected as %include-dir
  2931 | path:           String — file path relative to cap
  2932 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2933 | 
  2934 | Uses content-addressed memoization: blake3(cap-identity + "|" + source).
  2935 | Detects circular includes via [Pending] cache state.
  2936 | Included files start with % = [] (fresh pipeline input).
  2937 | """] [let cap@DirCap path@String integrity-hash@[default: []]]
  2938 |   [source: [builtin-read-all [open cap path Readable]]]
  2939 |   [hash:   [blake3 [str [cap-identity cap] "|" source]]]
  2940 |   [match [builtin-include-cache-get hash]
  2941 |     [Cached result]: result
  2942 |     Pending:         [error [str "circular include: " path]]
  2943 |     Missing:         [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
