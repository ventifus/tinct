# Test E080: include propagates macro expansion errors from the included file.
# `include` (prelude.llt:2897) loads, expands, and evaluates a tinct file.
# tests/corpus/eval/macros/macro_lib.llt defines `my-add` as a 1-argument macro
# but calls it as `[my-add 1 2]` (2 arguments), causing an arity mismatch during
# macro expansion inside the included file. The error propagates through
# include-evaluate-and-cache → include-cache-failure → builtin-raise.
[
  lib: [include %cwd "tests/corpus/eval/macros/macro_lib.llt"]
]
=== error
[E080] expand: macro expansion error: macro 'my-add' transformer call failed: arity mismatch: expected 1 argument, got 2 (defined at stdlib/prelude.llt:2471:28-2471:47)
  --> stdlib/prelude.llt:2471:28-2471:47
   |
  2471 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2471:28-2471:47
   |
  2471 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3387:24-3391:13
   |
  3387 | include-cache-failure: [fn@[return: Never  doc: """
  3388 | Reset include cache entry on error and re-raise. Internal helper for include.
  3389 | """] [let hash e]
  3390 |   [builtin-include-cache-put hash IncludeCacheEntry.Missing]
  3391 |   [raise e]]
       | ^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3409:3-3411:78
   |
  3409 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  3410 |     [case [let result] [Result.Ok result]    [include-cache-success hash result]]
  3411 |     [case [let e]      [Result.Error e]      [include-cache-failure hash e]]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3396:29-3411:79
   |
  3396 | include-evaluate-and-cache: [fn@[return: Any  doc: """
  3397 | Evaluate a file and update the content-addressed include cache.
  3398 | 
  3399 | source:         source text string
  3400 | path:           file path string (for error spans)
  3401 | hash:           content cache key (blake3(cap-identity + "|" + source))
  3402 | cap:            DirCap — passed as %include-dir; included files start with % = []
  3403 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  3404 | """] [let source path hash cap integrity-hash@[default: Absent.Absent]]
  3405 |   [builtin-include-cache-put hash IncludeCacheEntry.Pending]
  3406 |   [program: [if [absent? integrity-hash]
  3407 |     [load source name: path]
  3408 |     [load source name: path hash: integrity-hash]]]
  3409 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  3410 |     [case [let result] [Result.Ok result]    [include-cache-success hash result]]
  3411 |     [case [let e]      [Result.Error e]      [include-cache-failure hash e]]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3436:3-3439:121
   |
  3436 |   [match [builtin-include-cache-get hash]
  3437 |     [case [let result] [IncludeCacheEntry.Cached result] result]
  3438 |     [IncludeCacheEntry.Pending]:       [error [str "circular include: " path]]
  3439 |     [IncludeCacheEntry.Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3423:10-3439:122
   |
  3423 | include: [fn@[return: Any  doc: """
  3424 | Load, expand, and evaluate a tinct file from a DirCap.
  3425 | 
  3426 | cap:            DirCap — confines filesystem access; injected as %include-dir
  3427 | path:           String — file path relative to cap
  3428 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  3429 | 
  3430 | Uses content-addressed memoization: blake3(cap-identity + "|" + source).
  3431 | Detects circular includes via Pending cache state.
  3432 | Included files start with % = [] (fresh pipeline input).
  3433 | """] [let cap@DirCap path@String integrity-hash@[default: Absent.Absent]]
  3434 |   [source: [builtin-read-all [open cap path OpenFlag.Readable]]]
  3435 |   [hash:   [blake3 [str [cap-identity cap] "|" source]]]
  3436 |   [match [builtin-include-cache-get hash]
  3437 |     [case [let result] [IncludeCacheEntry.Cached result] result]
  3438 |     [IncludeCacheEntry.Pending]:       [error [str "circular include: " path]]
