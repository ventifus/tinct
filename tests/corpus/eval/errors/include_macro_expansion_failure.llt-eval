# Test E080: include propagates macro expansion errors from the included file.
# `include` (prelude.llt:2897) loads, expands, and evaluates a tinct file.
# tests/corpus/eval/macros/macro_lib.llt defines `my-add` as a 1-argument macro
# but calls it as `[my-add 1 2]` (2 arguments), causing an arity mismatch during
# macro expansion inside the included file. The error propagates through
# include-evaluate-and-cache → include-cache-failure → builtin-raise.
[
  lib: [include %cwd "tests/corpus/eval/macros/macro_lib.llt"]
]
=== error
[E080] expand: macro expansion error: macro 'my-add' transformer call failed: arity mismatch: expected 1 argument, got 2 (defined at stdlib/prelude.llt:2035:28-2035:47)
  --> stdlib/prelude.llt:2035:28-2035:47
   |
  2035 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2035:28-2035:47
   |
  2035 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2832:24-2836:13
   |
  2832 | include-cache-failure: [fn@[return: Never  doc: """
  2833 | Reset include cache entry on error and re-raise. Internal helper for include.
  2834 | """] [let hash e]
  2835 |   [builtin-include-cache-put hash Missing]
  2836 |   [raise e]]
       | ^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2854:3-2856:49
   |
  2854 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2855 |     [Ok result]: [include-cache-success hash result]
  2856 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2841:29-2856:50
   |
  2841 | include-evaluate-and-cache: [fn@[return: Any  doc: """
  2842 | Evaluate a file and update the content-addressed include cache.
  2843 | 
  2844 | source:         source text string
  2845 | path:           file path string (for error spans)
  2846 | hash:           content cache key (blake3(cap-identity + "|" + source))
  2847 | cap:            DirCap — passed as %include-dir; included files start with % = []
  2848 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2849 | """] [let source path hash cap integrity-hash@[default: []]]
  2850 |   [builtin-include-cache-put hash Pending]
  2851 |   [program: [if [null? integrity-hash]
  2852 |     [load source name: path]
  2853 |     [load source name: path hash: integrity-hash]]]
  2854 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2855 |     [Ok result]: [include-cache-success hash result]
  2856 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2881:3-2884:103
   |
  2881 |   [match [builtin-include-cache-get hash]
  2882 |     [Cached result]: result
  2883 |     Pending:         [error [str "circular include: " path]]
  2884 |     Missing:         [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2868:10-2884:104
   |
  2868 | include: [fn@[return: Any  doc: """
  2869 | Load, expand, and evaluate a tinct file from a DirCap.
  2870 | 
  2871 | cap:            DirCap — confines filesystem access; injected as %include-dir
  2872 | path:           String — file path relative to cap
  2873 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2874 | 
  2875 | Uses content-addressed memoization: blake3(cap-identity + "|" + source).
  2876 | Detects circular includes via [Pending] cache state.
  2877 | Included files start with % = [] (fresh pipeline input).
  2878 | """] [let cap@DirCap path@String integrity-hash@[default: []]]
  2879 |   [source: [builtin-read-all [open cap path Readable]]]
  2880 |   [hash:   [blake3 [str [cap-identity cap] "|" source]]]
  2881 |   [match [builtin-include-cache-get hash]
  2882 |     [Cached result]: result
  2883 |     Pending:         [error [str "circular include: " path]]
  2884 |     Missing:         [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
