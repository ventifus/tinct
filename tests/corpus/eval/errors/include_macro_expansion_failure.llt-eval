# Test E080: include propagates macro expansion errors from the included file.
# `include` (prelude.llt:2897) loads, expands, and evaluates a tinct file.
# tests/corpus/eval/macros/macro_lib.llt defines `my-add` as a 1-argument macro
# but calls it as `[my-add 1 2]` (2 arguments), causing an arity mismatch during
# macro expansion inside the included file. The error propagates through
# include-evaluate-and-cache → include-cache-failure → builtin-raise.
[
  lib: [include %cwd "tests/corpus/eval/macros/macro_lib.llt"]
]
=== error
[E080] expand: macro expansion error: macro 'my-add' transformer call failed: arity mismatch: expected 1 argument, got 2 (defined at stdlib/prelude.llt:2050:28-2050:47)
  --> stdlib/prelude.llt:2050:28-2050:47
   |
  2050 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2050:28-2050:47
   |
  2050 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2896:24-2900:13
   |
  2896 | include-cache-failure: [fn@[return: Never  doc: """
  2897 | Reset include cache entry on error and re-raise. Internal helper for include.
  2898 | """] [let hash e]
  2899 |   [builtin-include-cache-put hash Missing]
  2900 |   [raise e]]
       | ^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2918:3-2920:49
   |
  2918 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2919 |     [Ok result]: [include-cache-success hash result]
  2920 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2905:29-2920:50
   |
  2905 | include-evaluate-and-cache: [fn@[return: Any  doc: """
  2906 | Evaluate a file and update the content-addressed include cache.
  2907 | 
  2908 | source:         source text string
  2909 | path:           file path string (for error spans)
  2910 | hash:           content cache key (blake3(cap-identity + "|" + source))
  2911 | cap:            DirCap — passed as %include-dir; included files start with % = []
  2912 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2913 | """] [let source path hash cap integrity-hash@[default: []]]
  2914 |   [builtin-include-cache-put hash Pending]
  2915 |   [program: [if [null? integrity-hash]
  2916 |     [load source name: path]
  2917 |     [load source name: path hash: integrity-hash]]]
  2918 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2919 |     [Ok result]: [include-cache-success hash result]
  2920 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2945:3-2948:103
   |
  2945 |   [match [builtin-include-cache-get hash]
  2946 |     [Cached result]: result
  2947 |     Pending:         [error [str "circular include: " path]]
  2948 |     Missing:         [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2932:10-2948:104
   |
  2932 | include: [fn@[return: Any  doc: """
  2933 | Load, expand, and evaluate a tinct file from a DirCap.
  2934 | 
  2935 | cap:            DirCap — confines filesystem access; injected as %include-dir
  2936 | path:           String — file path relative to cap
  2937 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2938 | 
  2939 | Uses content-addressed memoization: blake3(cap-identity + "|" + source).
  2940 | Detects circular includes via [Pending] cache state.
  2941 | Included files start with % = [] (fresh pipeline input).
  2942 | """] [let cap@DirCap path@String integrity-hash@[default: []]]
  2943 |   [source: [builtin-read-all [open cap path Readable]]]
  2944 |   [hash:   [blake3 [str [cap-identity cap] "|" source]]]
  2945 |   [match [builtin-include-cache-get hash]
  2946 |     [Cached result]: result
  2947 |     Pending:         [error [str "circular include: " path]]
  2948 |     Missing:         [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
