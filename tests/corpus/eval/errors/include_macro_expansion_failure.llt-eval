# Test E080: include propagates macro expansion errors from the included file.
# `include` (prelude.llt:2897) loads, expands, and evaluates a tinct file.
# tests/corpus/eval/macros/macro_lib.llt defines `my-add` as a 1-argument macro
# but calls it as `[my-add 1 2]` (2 arguments), causing an arity mismatch during
# macro expansion inside the included file. The error propagates through
# include-evaluate-and-cache → include-cache-failure → builtin-raise.
[
  lib: [include %cwd "tests/corpus/eval/macros/macro_lib.llt"]
]
=== error
[E080] expand: macro expansion error: macro 'my-add' transformer call failed: arity mismatch: expected 1 argument, got 2 (defined at stdlib/prelude.llt:2480:28-2480:47)
  --> stdlib/prelude.llt:2480:28-2480:47
   |
  2480 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2480:28-2480:47
   |
  2480 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3386:24-3390:13
   |
  3386 | include-cache-failure: [fn@[return: Never  doc: """
  3387 | Reset include cache entry on error and re-raise. Internal helper for include.
  3388 | """] [let hash e]
  3389 |   [builtin-include-cache-put hash Missing]
  3390 |   [raise e]]
       | ^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3408:3-3410:78
   |
  3408 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  3409 |     [case [let result] [Result.Ok result]    [include-cache-success hash result]]
  3410 |     [case [let e]      [Result.Error e]      [include-cache-failure hash e]]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3395:29-3410:79
   |
  3395 | include-evaluate-and-cache: [fn@[return: Any  doc: """
  3396 | Evaluate a file and update the content-addressed include cache.
  3397 | 
  3398 | source:         source text string
  3399 | path:           file path string (for error spans)
  3400 | hash:           content cache key (blake3(cap-identity + "|" + source))
  3401 | cap:            DirCap — passed as %include-dir; included files start with % = []
  3402 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  3403 | """] [let source path hash cap integrity-hash@[default: Absent]]
  3404 |   [builtin-include-cache-put hash Pending]
  3405 |   [program: [if [absent? integrity-hash]
  3406 |     [load source name: path]
  3407 |     [load source name: path hash: integrity-hash]]]
  3408 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  3409 |     [case [let result] [Result.Ok result]    [include-cache-success hash result]]
  3410 |     [case [let e]      [Result.Error e]      [include-cache-failure hash e]]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3435:3-3438:121
   |
  3435 |   [match [builtin-include-cache-get hash]
  3436 |     [case [let result] [IncludeCacheEntry.Cached result] result]
  3437 |     [IncludeCacheEntry.Pending]:       [error [str "circular include: " path]]
  3438 |     [IncludeCacheEntry.Missing]:       [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:3422:10-3438:122
   |
  3422 | include: [fn@[return: Any  doc: """
  3423 | Load, expand, and evaluate a tinct file from a DirCap.
  3424 | 
  3425 | cap:            DirCap — confines filesystem access; injected as %include-dir
  3426 | path:           String — file path relative to cap
  3427 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  3428 | 
  3429 | Uses content-addressed memoization: blake3(cap-identity + "|" + source).
  3430 | Detects circular includes via Pending cache state.
  3431 | Included files start with % = [] (fresh pipeline input).
  3432 | """] [let cap@DirCap path@String integrity-hash@[default: Absent]]
  3433 |   [source: [builtin-read-all [open cap path Readable]]]
  3434 |   [hash:   [blake3 [str [cap-identity cap] "|" source]]]
  3435 |   [match [builtin-include-cache-get hash]
  3436 |     [case [let result] [IncludeCacheEntry.Cached result] result]
