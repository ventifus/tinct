# Test E080: include propagates macro expansion errors from the included file.
# `include` (prelude.llt:2897) loads, expands, and evaluates a tinct file.
# tests/corpus/eval/macros/macro_lib.llt defines `my-add` as a 1-argument macro
# but calls it as `[my-add 1 2]` (2 arguments), causing an arity mismatch during
# macro expansion inside the included file. The error propagates through
# include-evaluate-and-cache → include-cache-failure → builtin-raise.
[
  lib: [include %cwd "tests/corpus/eval/macros/macro_lib.llt"]
]
=== error
[E080] expand: macro expansion error: macro 'my-add' transformer call failed: arity mismatch: expected 1 argument, got 2 (defined at stdlib/prelude.llt:2034:28-2034:47)
  --> stdlib/prelude.llt:2034:28-2034:47
   |
  2034 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2034:28-2034:47
   |
  2034 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2831:24-2835:13
   |
  2831 | include-cache-failure: [fn@[return: Never  doc: """
  2832 | Reset include cache entry on error and re-raise. Internal helper for include.
  2833 | """] [let hash e]
  2834 |   [builtin-include-cache-put hash Missing]
  2835 |   [raise e]]
       | ^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2853:3-2855:49
   |
  2853 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2854 |     [Ok result]: [include-cache-success hash result]
  2855 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2840:29-2855:50
   |
  2840 | include-evaluate-and-cache: [fn@[return: Any  doc: """
  2841 | Evaluate a file and update the content-addressed include cache.
  2842 | 
  2843 | source:         source text string
  2844 | path:           file path string (for error spans)
  2845 | hash:           content cache key (blake3(cap-identity + "|" + source))
  2846 | cap:            DirCap — passed as %include-dir; included files start with % = []
  2847 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2848 | """] [let source path hash cap integrity-hash@[default: []]]
  2849 |   [builtin-include-cache-put hash Pending]
  2850 |   [program: [if [null? integrity-hash]
  2851 |     [load source name: path]
  2852 |     [load source name: path hash: integrity-hash]]]
  2853 |   [match [try [fn [let] [eval-file [expand program] [] cap]]]
  2854 |     [Ok result]: [include-cache-success hash result]
  2855 |     [Error e]:   [include-cache-failure hash e]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2880:3-2883:103
   |
  2880 |   [match [builtin-include-cache-get hash]
  2881 |     [Cached result]: result
  2882 |     Pending:         [error [str "circular include: " path]]
  2883 |     Missing:         [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:2867:10-2883:104
   |
  2867 | include: [fn@[return: Any  doc: """
  2868 | Load, expand, and evaluate a tinct file from a DirCap.
  2869 | 
  2870 | cap:            DirCap — confines filesystem access; injected as %include-dir
  2871 | path:           String — file path relative to cap
  2872 | integrity-hash: optional blake3 hex digest for integrity verification (--require-integrity)
  2873 | 
  2874 | Uses content-addressed memoization: blake3(cap-identity + "|" + source).
  2875 | Detects circular includes via [Pending] cache state.
  2876 | Included files start with % = [] (fresh pipeline input).
  2877 | """] [let cap@DirCap path@String integrity-hash@[default: []]]
  2878 |   [source: [builtin-read-all [open cap path Readable]]]
  2879 |   [hash:   [blake3 [str [cap-identity cap] "|" source]]]
  2880 |   [match [builtin-include-cache-get hash]
  2881 |     [Cached result]: result
  2882 |     Pending:         [error [str "circular include: " path]]
  2883 |     Missing:         [include-evaluate-and-cache source path hash cap integrity-hash: integrity-hash]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
