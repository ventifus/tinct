# Note: $get-in constructs KeyNotFound internally without passing available_keys,
# so this error does not include the "(available keys: ...)" suffix that direct
# dot/bracket access errors show. This is a known inconsistency until stdlib
# paths are updated to pass available_keys to key_not_found().
[get-in ["a" "c"] [a: [b: 42]]]
=== error
[E080] key not found: c (defined at stdlib/prelude.llt:2083:28-2083:47)
  --> stdlib/prelude.llt:2083:28-2083:47
   |
  2083 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2083:28-2083:47
   |
  2083 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:905:5-909:53
   |
  905 |     [builtin-if [builtin-eq [length path] 0]
  906 |         xs
  907 |         [builtin-if [has? path.0 xs]
  908 |             [get-in [builtin-rest path] [get path.0 xs]]
  909 |             [error [str "key not found: " path.0]]]]]
      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [builtin-if ...] at stdlib/prelude.llt:907:9-909:52
   |
  907 |         [builtin-if [has? path.0 xs]
  908 |             [get-in [builtin-rest path] [get path.0 xs]]
  909 |             [error [str "key not found: " path.0]]]]]
      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [builtin-if ...] at stdlib/prelude.llt:905:5-909:53
   |
  905 |     [builtin-if [builtin-eq [length path] 0]
  906 |         xs
  907 |         [builtin-if [has? path.0 xs]
  908 |             [get-in [builtin-rest path] [get path.0 xs]]
  909 |             [error [str "key not found: " path.0]]]]]
      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [get-in ...] at 4:1-4:32
