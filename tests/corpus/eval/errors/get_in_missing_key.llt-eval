# Note: $get-in constructs KeyNotFound internally without passing available_keys,
# so this error does not include the "(available keys: ...)" suffix that direct
# dot/bracket access errors show. This is a known inconsistency until stdlib
# paths are updated to pass available_keys to key_not_found().
[get-in ["a" "c"] [a: [b: 42]]]
=== error
[E080] key not found: c (defined at stdlib/prelude.llt:2051:28-2051:47)
  --> stdlib/prelude.llt:2051:28-2051:47
   |
  2051 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2051:28-2051:47
   |
  2051 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:875:5-879:53
   |
  875 |     [builtin-if [builtin-eq [length path] 0]
  876 |         xs
  877 |         [builtin-if [has? path.0 xs]
  878 |             [get-in [builtin-rest path] [get path.0 xs]]
  879 |             [error [str "key not found: " path.0]]]]]
      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [builtin-if ...] at stdlib/prelude.llt:877:9-879:52
   |
  877 |         [builtin-if [has? path.0 xs]
  878 |             [get-in [builtin-rest path] [get path.0 xs]]
  879 |             [error [str "key not found: " path.0]]]]]
      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [builtin-if ...] at stdlib/prelude.llt:875:5-879:53
   |
  875 |     [builtin-if [builtin-eq [length path] 0]
  876 |         xs
  877 |         [builtin-if [has? path.0 xs]
  878 |             [get-in [builtin-rest path] [get path.0 xs]]
  879 |             [error [str "key not found: " path.0]]]]]
      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [get-in ...] at 4:1-4:32
