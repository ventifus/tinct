# Note: $get-in constructs KeyNotFound internally without passing available_keys,
# so this error does not include the "(available keys: ...)" suffix that direct
# dot/bracket access errors show. This is a known inconsistency until stdlib
# paths are updated to pass available_keys to key_not_found().
[get-in ["a" "c"] [a: [b: 42]]]
=== error
[E080] key not found: c (defined at stdlib/prelude.llt:2483:28-2483:47)
  --> stdlib/prelude.llt:2483:28-2483:47
   |
  2483 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2483:28-2483:47
   |
  2483 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:1233:5-1237:53
   |
  1233 |     [builtin-if [builtin-eq [length path] 0]
  1234 |         xs
  1235 |         [builtin-if [has? path.0 xs]
  1236 |             [get-in [builtin-rest path] [get path.0 xs]]
  1237 |             [error [str "key not found: " path.0]]]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [builtin-if ...] at stdlib/prelude.llt:1235:9-1237:52
   |
  1235 |         [builtin-if [has? path.0 xs]
  1236 |             [get-in [builtin-rest path] [get path.0 xs]]
  1237 |             [error [str "key not found: " path.0]]]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [builtin-if ...] at stdlib/prelude.llt:1233:5-1237:53
   |
  1233 |     [builtin-if [builtin-eq [length path] 0]
  1234 |         xs
  1235 |         [builtin-if [has? path.0 xs]
  1236 |             [get-in [builtin-rest path] [get path.0 xs]]
  1237 |             [error [str "key not found: " path.0]]]]]
       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [get-in ...] at 4:1-4:32
