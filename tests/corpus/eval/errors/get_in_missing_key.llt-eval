# Note: $get-in constructs KeyNotFound internally without passing available_keys,
# so this error does not include the "(available keys: ...)" suffix that direct
# dot/bracket access errors show. This is a known inconsistency until stdlib
# paths are updated to pass available_keys to key_not_found().
[get-in ["a" "c"] [a: [b: 42]]]
=== error
[E080] key not found: c (defined at stdlib/prelude.llt:2052:28-2052:47)
  --> stdlib/prelude.llt:2052:28-2052:47
   |
  2052 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2052:28-2052:47
   |
  2052 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:906:5-910:53
   |
  906 |     [builtin-if [builtin-eq [length path] 0]
  907 |         xs
  908 |         [builtin-if [has? path.0 xs]
  909 |             [get-in [builtin-rest path] [get path.0 xs]]
  910 |             [error [str "key not found: " path.0]]]]]
      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [builtin-if ...] at stdlib/prelude.llt:908:9-910:52
   |
  908 |         [builtin-if [has? path.0 xs]
  909 |             [get-in [builtin-rest path] [get path.0 xs]]
  910 |             [error [str "key not found: " path.0]]]]]
      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [builtin-if ...] at stdlib/prelude.llt:906:5-910:53
   |
  906 |     [builtin-if [builtin-eq [length path] 0]
  907 |         xs
  908 |         [builtin-if [has? path.0 xs]
  909 |             [get-in [builtin-rest path] [get path.0 xs]]
  910 |             [error [str "key not found: " path.0]]]]]
      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [get-in ...] at 4:1-4:32
