# Note: $get-in constructs KeyNotFound internally without passing available_keys,
# so this error does not include the "(available keys: ...)" suffix that direct
# dot/bracket access errors show. This is a known inconsistency until stdlib
# paths are updated to pass available_keys to key_not_found().
[get-in ["a" "c"] [a: [b: 42]]]
=== error
[E080] key not found: c (defined at stdlib/prelude.llt:2086:28-2086:47)
  --> stdlib/prelude.llt:2086:28-2086:47
   |
  2086 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in [builtin-raise ...] at stdlib/prelude.llt:2086:28-2086:47
   |
  2086 | """]: [fn [let msg@String] [builtin-raise msg]]
       |                            ^^^^^^^^^^^^^^^^^^^
  in materialized at stdlib/prelude.llt:912:5-916:53
   |
  912 |     [builtin-if [builtin-eq [length path] 0]
  913 |         xs
  914 |         [builtin-if [has? path.0 xs]
  915 |             [get-in [builtin-rest path] [get path.0 xs]]
  916 |             [error [str "key not found: " path.0]]]]]
      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [builtin-if ...] at stdlib/prelude.llt:914:9-916:52
   |
  914 |         [builtin-if [has? path.0 xs]
  915 |             [get-in [builtin-rest path] [get path.0 xs]]
  916 |             [error [str "key not found: " path.0]]]]]
      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [builtin-if ...] at stdlib/prelude.llt:912:5-916:53
   |
  912 |     [builtin-if [builtin-eq [length path] 0]
  913 |         xs
  914 |         [builtin-if [has? path.0 xs]
  915 |             [get-in [builtin-rest path] [get path.0 xs]]
  916 |             [error [str "key not found: " path.0]]]]]
      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  in [get-in ...] at 4:1-4:32
