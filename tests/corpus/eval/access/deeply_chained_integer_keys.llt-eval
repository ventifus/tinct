# Deeply chained access - integer dot access
[
  data: [
    items: [
      0: [name: "item1"]
      1: [name: "item2"]
    ]
  ]
  result: data.items.1.name
]
=== out
Dict({"data": Dict({"items": Dict({0: Dict({"name": String("item1")}), 1: Dict({"name": String("item2")})})}), "result": String("item2")})
