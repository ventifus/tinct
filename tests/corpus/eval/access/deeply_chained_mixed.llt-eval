# Deeply chained access - 5+ level chains mixing dot access and get
[
  data: [
    level1: [
      level2: [
        level3: [
          level4: [
            level5: "deep value"
          ]
        ]
      ]
    ]
  ]
  result: data.level1.level2.level3.level4.level5
]
=== out
Dict({"data": Dict({"level1": Dict({"level2": Dict({"level3": Dict({"level4": ...})})})}), "result": String("deep value")})
