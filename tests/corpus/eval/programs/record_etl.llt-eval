[
  records: [
    0: [name: "Alice"  score: 80  active: true]
    1: [name: "Bob"    score: 72  active: false]
    2: [name: "Carol"  score: 90  active: true]
    3: [name: "Dave"   score: 100  active: true]
    4: [name: "Eve"    score: 88  active: false]
  ]
]
---
[
  active: [collect [filter [fn [let r] r.active] [each %.records]]]
  names:  [map [fn [let r] r.name] active]
  total:  [reduce [fn [let acc r] [+ acc r.score]] 0 active]
]
---
[
  count:  [length %.names]
  total:  %.total
  roster: [join ", " %.names]
]
=== out
Dict({"count": Int(3), "total": Int(270), "roster": String("Alice, Carol, Dave")})
