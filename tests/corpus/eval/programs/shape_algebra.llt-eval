[
  Shape: [type Circle: [r: Int] Square: [s: Int] Rect: [w: Int h: Int]]
  shapes: [
    0: [Shape.Circle r: 3]
    1: [Shape.Square s: 4]
    2: [Shape.Rect w: 5 h: 6]
    3: [Shape.Circle r: 2]
    4: [Shape.Square s: 7]
  ]
  area: [fn [let s]
    [match s
      [case [let p] [Shape.Circle p] [* p.r p.r]]
      [case [let p] [Shape.Square p] [* p.s p.s]]
      [case [let p] [Shape.Rect p]   [* p.w p.h]]
      _: 0]]
  total:   [reduce + 0 [map area [each shapes]]]
  compare: [fn [let a@Integer b@Integer] [if [> a b] a b]]
  larger:  [compare a: [area [Shape.Circle r: 3]] b: [area [Shape.Square s: 4]]]
]
