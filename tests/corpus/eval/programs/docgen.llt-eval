[prelude: [include %libdir "prelude.llt"]]
[
  # annotation-of on prelude functions must return actual annotation content (B-406).
  # This tests that doc: and return: annotations from @[...] are accessible at runtime.

  map-ann:  [annotation-of [get "map" prelude]]
  str-ann:  [annotation-of [get "str" prelude]]

  # map@[return: [Seq b]  doc: """..."""]: both return and doc must be present.
  # The function value is unevaluated at dict-construction time, so it is NOT wrapped
  # in Value::Annotated. annotation-of reads from FnAnnotation on the Value::Function.
  # return: [Seq b] is exposed as the display string "[Seq b]".
  # doc: is evaluated via [unindent "..."] at function definition time.
  map-has-ret: [has? "return" map-ann]
  map-has-doc: [has? "doc" map-ann]
  map-ret-val: [= map-ann.return "[Seq b]"]
  # doc must be a non-empty string (actual content from triple-quoted string via unindent)
  map-doc-str: [str? map-ann.doc]
  map-doc-ne:  [> [str-length map-ann.doc] 0]

  # str: builtin-str has no annotation — empty dict
  str-empty: [null? str-ann]
]
=== out
Dict({"map-ann": Dict({"doc": String("Apply function to each element of a Seq. Lazy — safe on infinite Seqs.\n\nExample: [collect [map [fn [let x] [* x 2]] [range 0 3]]] => [0 2 4]\n\nNote: O(1) per element consumed. For Dict inputs use builtin-map."), "return": String("[Seq b]")}), "str-ann": Dict({}), "map-has-ret": Bool(true), "map-has-doc": Bool(true), "map-ret-val": Bool(true), "map-doc-str": Bool(true), "map-doc-ne": Bool(true), "str-empty": Bool(true)})
