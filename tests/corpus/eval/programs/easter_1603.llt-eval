[
  months: [
    1: "January"   2: "February"  3: "March"     4: "April"
    5: "May"       6: "June"      7: "July"       8: "August"
    9: "September" 10: "October"  11: "November"  12: "December"
  ]

  idiv: [fn [let a b] [floor [/ a b]]]

  # Gregorian Computus — returns "MonthName Day, Year"
  easter: [fn [let y]
    [
      a:     [mod y 19]
      b:     [idiv y 100]
      c:     [mod y 100]
      d:     [idiv b 4]
      e:     [mod b 4]
      f:     [idiv [+ b 8] 25]
      g:     [idiv [+ [- b f] 1] 3]
      h:     [mod [+ [- [- [+ [* 19 a] b] d] g] 15] 30]
      i:     [idiv c 4]
      k:     [mod c 4]
      l:     [mod [- [- [+ [+ 32 [* 2 e]] [* 2 i]] h] k] 7]
      m:     [idiv [+ [+ a [* 11 h]] [* 22 l]] 451]
      eMonth: [idiv [+ [- [+ h l] [* 7 m]] 114] 31]
      eDay:   [+ 1 [mod [+ [- [+ h l] [* 7 m]] 114] 31]]
    ]
    [str [get eMonth months] " " [str eDay] ", " [str y]]]
]
---
[%.easter 1603]
=== out
String("March 30, 1603")
