# B-295: Only Pipe expressions are unwrapped; other single-entry brackets remain wrapped
# [[call ...]] (without |) creates {0: result}, not result
# This preserves the existing behavior for non-pipeline content

[
  # Single call (no pipe) remains wrapped
  call: [[nth 0 [0: "a"  1: "b"]]]

  # Single literal remains wrapped
  literal: [[42]]

  # Single reference remains wrapped
  ref: [[x: 99]]
]

=== out
Dict({"call": Dict({0: String("a")}), "literal": Dict({0: Dict({0: Int(42)})}), "ref": Dict({0: Dict({"x": Int(99)})})})
