# Nested match with variable binding at both levels.
# T-1154: [@String s] / [@Integer i] no longer bind; use [case [let v] v body] standalone arms.
# Outer CaseArm binds s to the scrutinee; inner CaseArm binds i — s is in scope from outer.
# The _: fallback arms are unreachable (Unknown scrutinee type — no coverage warning).
[
  outer: [1 "hello" 3.14]
  result: [match [get 1 outer]
    [case [let s] s [match [get 0 outer]
      [case [let i] i [str i " and " s]]
      ...: "no-int"]]
    ...: "no-string"]
]
=== out
Dict({"outer": Dict({0: Int(1), 1: String("hello"), 2: Float(3.14)}), "result": String("1 and hello")})
