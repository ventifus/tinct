# T-1154: [@Bool x] no longer binds x (x is Pattern::Pin — wildcard, no binding).
# Use a standalone [case [let x] x body] arm. The _: false arm may or may not
# trigger a coverage warning depending on the Bool scrutinee type inference.
[match true
  [case [let x] x x]
  _: false]
=== out
Bool(true)
