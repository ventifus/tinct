# Multiple TypeAssert patterns in different match arms.
# Demonstrates that TypeAssert patterns correctly discriminate between types.
# Uses bare uppercase (TypeAssertPending) instead of [@Type x] with unbound x.
[
  test-int:    [match 42       Int: "int"     String: "string"  _: "other"]
  test-string: [match "hello"  Int: "int"     String: "string"  _: "other"]
  test-float:  [match 3.14     Int: "int"     String: "string"  _: "other"]
]
=== out
Dict({"test-int": String("int"), "test-string": String("string"), "test-float": String("other")})
