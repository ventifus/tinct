# After S-944, Integer and String are plain VarRefs (Pattern::TypeAssertPending is deleted).
# Integer resolves to TypeNode.Int; String resolves to TypeNode.String.
# Pin comparisons all fail — primitive_eq(value, TypeNode.variant) = false for any runtime value.
# All scrutinees fall to the wildcard arm → "other".
[
  test-int:    [match 42       Integer: "int"     String: "string"  ...: "other"]
  test-string: [match "hello"  Integer: "int"     String: "string"  ...: "other"]
  test-float:  [match 3.14     Integer: "int"     String: "string"  ...: "other"]
]
=== out
["test-int": "other"  "test-string": "other"  "test-float": "other"]
