# Shadowable operator wrappers: these functions delegate to builtin-* aliases
# to ensure they can be shadowed while prelude functions remain functional.
# Test that each wrapper produces the correct result when called directly.
[
  # Comparison operators
  lt-result: [< 1 2]
  lt-false: [< 5 3]
  eq-result: [= "hello" "hello"]
  eq-false: [= "foo" "bar"]

  # Arithmetic operators
  add-result: [+ 2 3]
  sub-result: [- 10 3]
  mul-result: [* 3 4]
  div-result: [/ 15 3]

  # Control flow
  if-true: [if true "yes" "no"]
  if-false: [if false "yes" "no"]

  # Higher-order collection functions
  filter-result: [collect [filter [fn [x] [< x 3]] [seq 1 [seq 2 [seq 3 [seq 4 []]]]]]]
  map-result: [collect [map [fn [x] [* x 2]] [seq 1 [seq 2 [seq 3 []]]]]]
  reduce-result: [reduce [fn [acc x] [+ acc x]] 0 [seq 1 [seq 2 [seq 3 []]]]]
  take-result: [collect [take 2 [seq 10 [seq 20 [seq 30 []]]]]]
  drop-result: [collect [drop 1 [seq 10 [seq 20 [seq 30 []]]]]]
]
