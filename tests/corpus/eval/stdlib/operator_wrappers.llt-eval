# Shadowable operator wrappers: these functions delegate to builtin-* aliases
# to ensure they can be shadowed while prelude functions remain functional.
# Test that each wrapper produces the correct result when called directly.
[
  # Comparison operators
  lt-result: [call $< 1 2]
  lt-false: [call $< 5 3]
  eq-result: [call $= hello hello]
  eq-false: [call $= foo bar]

  # Arithmetic operators
  add-result: [call $+ 2 3]
  sub-result: [call $- 10 3]
  mul-result: [call $* 3 4]
  div-result: [call $/ 15 3]

  # Control flow
  if-true: [call $if true yes no]
  if-false: [call $if false yes no]

  # Higher-order collection functions
  filter-result: [call $collect [call $filter [fn [x] [call $< $x 3]] [call $seq 1 [call $seq 2 [call $seq 3 [call $seq 4 []]]]]]]
  map-result: [call $collect [call $map [fn [x] [call $* $x 2]] [call $seq 1 [call $seq 2 [call $seq 3 []]]]]]
  reduce-result: [call $reduce [fn [acc x] [call $+ $acc $x]] 0 [call $seq 1 [call $seq 2 [call $seq 3 []]]]]
  take-result: [call $collect [call $take 2 [call $seq 10 [call $seq 20 [call $seq 30 []]]]]]
  drop-result: [call $collect [call $drop 1 [call $seq 10 [call $seq 20 [call $seq 30 []]]]]]
]
