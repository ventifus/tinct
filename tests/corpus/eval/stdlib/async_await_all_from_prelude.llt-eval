# Verify async utilities resolve from prelude without [include %libdir "async.llt"].
# async.llt was deleted in builtin-privacy-stdlib (S-786); its functions moved to
# stdlib/prelude.llt. This test confirms key names are accessible and executable.
#
# retry is safe to call without an async runtime — it runs a plain thunk synchronously.
# exit, graceful-exit, await-all, par-map, par-filter resolve as Function values.
[retry-ok:           [retry 3 [fn [let] 42]]
 exit-type:          [type-of exit]
 graceful-exit-type: [type-of graceful-exit]
 await-all-type:     [type-of await-all]
 recv-all-type:      [type-of recv-all]
 par-map-type:       [type-of par-map]
 par-filter-type:    [type-of par-filter]
 retry-type:         [type-of retry]
 finally-type:       [type-of finally]]
=== out
Dict({"retry-ok": Int(42), "exit-type": String("Function"), "graceful-exit-type": String("Function"), "await-all-type": String("Function"), "recv-all-type": String("Function"), "par-map-type": String("Function"), "par-filter-type": String("Function"), "retry-type": String("Function"), "finally-type": String("Function")})

