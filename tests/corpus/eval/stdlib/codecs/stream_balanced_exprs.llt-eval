# stream.balanced-exprs: groups lines into balanced tinct expressions.
# Two single-line expressions each form one group.
[stream: [include %libdir "codecs/stream.llt"]]
[collect [stream.balanced-exprs [split "\n" "[x: 1]\n[y: 2]"]]]
