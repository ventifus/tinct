# MergeableRecord instance: append-one merges two dicts, empty is [].
# Uses a custom class to avoid conflict with the prelude AppendableDict instance.
# Tests that [let a@Dict] is accepted as an instance arm pattern.
# merge is right-biased: keys from second dict override first.
[
  Mergeable: [class [let Mergeable a]]
  inst: [instance Mergeable [let a@Dict]:
    append-one: [fn [let a b] [merge a b]]
    empty: []]
  result: [inst.append-one [x: 1 y: 2] [y: 99 z: 3]]
]
=== out
Dict({"inst": Dict({"append-one": Function(a, b), "empty": Dict({})}), "result": Dict({"x": Int(1), "y": Int(99), "z": Int(3)})})
