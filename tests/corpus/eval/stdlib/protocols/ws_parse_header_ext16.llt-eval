# parse-ws-frame-header: extended 16-bit payload length.
# byte0 = 0x82 (FIN=1, opcode=2/Binary)
# byte1 = 0xFE = 0x80|126 (MASK=1, len7=126 signals 16-bit extension)
# bytes 2-3: payload length = 256 (0x01 0x00)
# bytes 4-7: mask key
# Expected: payload-len=256, header-len=8 (2+2+4), opcode=2

[include %libdir "protocols/websocket.llt"]
---
[call [fn [p]
    [set []
        payload-len: p.payload-len
        header-len:  p.header-len
        opcode:      p.opcode]]
    [call %.parse-ws-frame-header
        [str [chr 130] [chr 254] [chr 1] [chr 0] [chr 1] [chr 2] [chr 3] [chr 4]]]]
