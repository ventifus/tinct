# Verify SOCKS5 constants are exported with correct values (RFC 1928).

[include %libdir "protocols/socks5.llt"]
---
[set []
    SOCKS5-VERSION:         %.SOCKS5-VERSION
    NO-AUTH:                %.NO-AUTH
    AUTH-USERNAME-PASSWORD: %.AUTH-USERNAME-PASSWORD
    CMD-CONNECT:            %.CMD-CONNECT
    ADDR-IPV4:              %.ADDR-IPV4
    ADDR-DOMAIN:            %.ADDR-DOMAIN
    ADDR-IPV6:              %.ADDR-IPV6]
=== error
[E022] unexpected named argument: SOCKS5-VERSION (valid parameter names: xs) (defined at 4:1-11:41)
  in [set ...] at 4:1-11:41
  in [set ...] at 4:1-11:41
