    A:               %.A
    NS:              %.NS
    CNAME:           %.CNAME
    PTR:             %.PTR
    MX:              %.MX
    TXT:             %.TXT
    AAAA:            %.AAAA
    SRV:             %.SRV
    DNS-FLAGS-QUERY: %.DNS-FLAGS-QUERY]
