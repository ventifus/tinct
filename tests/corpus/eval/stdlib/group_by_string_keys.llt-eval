# group-by: group string elements by identity — string keys, multiple buckets
# "a" appears at positions 0 and 2, "b" at position 1.
# Insertion order: "a" bucket first, then "b" bucket.
# Each bucket: elements cons-prepended then reversed, restoring insertion order.
[group-by [fn [x] x] ["a" "b" "a"]]
