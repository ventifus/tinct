[
  words_basic: [words "hello world"]
  words_empty: [words ""]
  words_only_spaces: [words "   "]
  words_leading_trailing: [words "  hello world  "]
  words_multiple_spaces: [words "hello    world"]

  flatten_nested: [flatten [[1 2] [3 4]]]
  flatten_empty: [flatten []]
  flatten_mixed: [flatten [1 [2 3] 4]]
  flatten_deep: [flatten [[[1 2] [3 4]] [5 6]]]
]
