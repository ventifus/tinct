# Signal type constructors: POSIX signal variants defined in prelude.llt.
# Each signal is a zero-payload Variant value (no data attached).
# Signal: [type [SIGTERM] [SIGINT] [SIGHUP] [SIGQUIT] [SIGUSR1] [SIGUSR2]]
[term:   SIGTERM
 int:    SIGINT
 hup:    SIGHUP
 quit:   SIGQUIT
 usr1:   SIGUSR1
 usr2:   SIGUSR2]
