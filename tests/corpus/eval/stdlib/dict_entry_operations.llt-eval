--- uses: ["core"]
[
  from_entries_basic: [from-entries [entries [a: 1 b: 2]]]
  from_entries_empty: [from-entries []]
  from_entries_seq: [from-entries [map [fn [let x] [key: x value: [builtin-mul x x]]] [range 0 3]]]

  with_entries_basic: [with-entries [fn [let e] [key: e.key  value: [* e.value 10]]] [a: 1  b: 2  c: 3]]
  with_entries_empty: [with-entries [fn [let e] [key: e.key  value: e.value]] []]
]
=== out
Dict({"from_entries_basic": Dict({0: Dict({"key": String("a"), "value": Int(1)}), 1: Dict({"key": String("b"), "value": Int(2)})}), "from_entries_empty": Dict({}), "from_entries_seq": Dict({0: Int(0), 1: Int(1), 2: Int(4)}), "with_entries_basic": Dict({0: Dict({"key": String("a"), "value": Int(10)}), 1: Dict({"key": String("b"), "value": Int(20)}), 2: Dict({"key": String("c"), "value": Int(30)})}), "with_entries_empty": Dict({})})
