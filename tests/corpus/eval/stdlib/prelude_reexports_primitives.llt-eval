# Phase 4: Verify prelude provides core primitives to user code.
# After the bootstrap env switch, +, error, and map are available via
# stdlib_env (injected by create_stdlib_env_inner after prelude loads).
[
  sum: [+ 40 2]
  safe: [try [fn [] [error "expected-error"]]]
  doubled: [map [fn [x] [+ x 1]] [10 20 30]]
]
=== out
Dict({"sum": Int(42), "safe": Variant(Err, String("expected-error")), "doubled": Dict({0: Int(11), 1: Int(21), 2: Int(31)})})
