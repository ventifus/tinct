# Tests the integer? predicate for several value types.
# integer? delegates to int? for NativeInt and checks BigInt via type-of.
# int? now uses type-of to extract the runtime Value variant discriminant
# and compare against "Value::Int", which works correctly.
[
  r-nativeint: [integer? 42]
  r-float:     [integer? 3.14]
  r-string:    [integer? "hello"]
]
=== out
["r-nativeint": Boolean.True  "r-float": Boolean.False  "r-string": Boolean.False]
