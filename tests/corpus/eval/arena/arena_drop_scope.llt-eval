# Test that builtin-arena-drop returns [] and builtin-arena-stats reports the correct name.
# All returned values are deterministic (no Arena value or runtime-dependent EnvId in result).

[call [fn [let]
  [arena:       [builtin-arena-new "test-drop"]]
  [stats:       [builtin-arena-stats arena]]
  [drop-result: [builtin-arena-drop arena]]
  [name-ok:    [builtin-eq-string stats.name "test-drop"]
   thunks-ok:  [builtin-eq-int stats.thunks-live 0]
   drop-ok:    [builtin-eq-int [builtin-dict-length drop-result] 0]]]]
=== out
Dict({"name-ok": Int(1), "thunks-ok": Int(1), "drop-ok": Int(1)})
