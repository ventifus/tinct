# Test that builtin-extend-env correctly creates a child FlatEnv with named slots.
# Regression gate for T-1568: FlatEnv slots must be populated so VarRef dispatch works.
#
# builtin-extend-env takes (parent-flat-env-id: Int, bindings: Dict) and returns
# a child flat-env-id as Int. This test verifies the return value is a non-negative Int.

[call [fn [let]
  # Create a child FlatEnv rooted at flat-env-id 0 (root) with two bindings.
  [child-feid:  [builtin-extend-env 0 [x: 42  y: 100]]]
  # Verify the result is a non-negative integer (the child flat-env-id).
  [is-int:      [builtin-eq-string [builtin-type-of child-feid] "Int"]]
  [is-positive: [builtin-int-gte child-feid 1]]
  [ok:          [builtin-int-add is-int is-positive]]]]
=== out
Dict({"ok": Int(2)})
