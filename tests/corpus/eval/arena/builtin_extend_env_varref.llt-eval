# Test that bindings added via builtin-extend-env are VarRef-accessible.
# T-1571 regression gate: if FlatEnv slots aren't populated, this fails.
#
# This test verifies that:
# 1. builtin-extend-env populates FlatEnv slots with thunk values
# 2. VarRef resolution via display vector works for extended bindings
# 3. The display chain is correctly threaded when flat-env: is provided
#
# Wrapped in [call [fn [let] ...]] so only a serializable Int comparison
# result appears in the output — builtin-llt-repr cannot serialize Environment.

[call [fn [let]
  # Create a base environment with a binding x: 42.
  [base-result:     [builtin-extend-env [] [x: 42]]]
  [base-flat-env-id: base-result.flat-env-id]

  # Evaluate a program that references x via VarRef.
  # After resolver assigns coordinates, eval uses display[level].slots[slot].
  [eval-result: [builtin-eval "[result: x]" env: base-result.env flat-env: base-flat-env-id]]

  # Verify the result equals 42.
  [result-ok: [builtin-eq-int eval-result.result.result 42]]]]
=== out
Dict({"result-ok": Int(1)})
