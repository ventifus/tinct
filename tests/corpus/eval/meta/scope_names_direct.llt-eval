# builtin-scope-names returns direct bindings of a scope as {name: slot-int}.
# Creates a scope with two named bindings and verifies both appear in the names dict.
[call [fn [let]
  [new-scope: [builtin-scope-new 0 [x: 42  y: 100]]]
  [names:     [builtin-scope-names new-scope]]
  [has-x:     [builtin-has-key? "x" names]]
  [has-y:     [builtin-has-key? "y" names]]
  [x-is-int:  [builtin-eq-string [builtin-type-of [builtin-get "x" names]] "Int"]]
  [builtin-int-add [builtin-int-add has-x has-y] x-is-int]]]
=== out
Int(3)
