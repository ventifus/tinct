# builtin-doc-meta returns the evaluated header dict of a document.
# For a document without a --- separator header, returns [] (empty dict).
[call [fn [let]
  [src:    [builtin-str-bytes "[x: 42]"]]
  [parsed: [builtin-parse src "test.llt"]]
  [desug:  [builtin-desugar parsed.program]]
  [docs:   [builtin-program-docs desug]]
  [doc0:   [builtin-dict-get 0 docs]]
  [meta:   [builtin-doc-meta doc0 0]]
  [is-empty: [if [null? meta] 1 0]]
  is-empty]]
=== out
Int(1)
