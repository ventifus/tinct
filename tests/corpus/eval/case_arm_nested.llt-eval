# Nested match expressions — 3-arg [case [let] literal body] for literal arms,
# [case [let _] _ body] for wildcard fallback. Outer 1 → inner 2 → "inner-matched".
[outer: 1
 result: [match $outer
   [case [let] 1
     [match 2
       [case [let] 2 "inner-matched"]
       [case [let _] _ "inner-fallback"]]]
   [case [let _] _ "outer-fallback"]]]
=== out
Dict({"outer": Int(1), "result": String("inner-matched")})
