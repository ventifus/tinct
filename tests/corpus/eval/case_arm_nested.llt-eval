# Nested match expressions
# Tests that match can be nested and inner matches have access to outer bindings
[outer: 1
 result: [match $outer
   [case 1
     [match 2
       [case 2 "inner-matched"]
       [case [let _] "inner-fallback"]]]
   [case [let _] "outer-fallback"]]]
=== out
Dict({"outer": Int(1), "result": String("inner-matched")})
