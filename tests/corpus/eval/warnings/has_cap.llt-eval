# Test has-cap? on a protocol dict handle (from open)
# open returns a protocol dict with read-chunk/write/flush/close/seek keys
# has-cap? (now wrapping has?) checks if a method key exists on the dict
[include %libdir "io.llt"]
[has-cap? [open %cwd "Cargo.toml" Readable] "read-chunk"]
=== out
Bool(true)
