# T-974: Named-field constructor injection redesign.
# After T-974, [type Shape [Circle r: Int] [Square s: Int]] injects:
#   - Shape: Variant("Shape", Null) (unit from VarRef)
#   - Circle: fn [r] [variant "Circle" [r: r]] (named-field constructor fn wrapper)
#   - Square: fn [s] [variant "Square" [s: s]] (named-field constructor fn wrapper)
# [Circle r: 5] → Variant("Circle", Dict({r: Int(5)})).
# Pattern [Circle r]: binds r = Dict({r: Int(5)}) (the payload dict, not the raw int).
# [* 3 [* r r]] where r is a Dict → arithmetic type error.
# NOTE: This test will work correctly once T-968 (pattern tag qualification and field
# extraction semantics) is implemented. For now it shows the T-974 intermediate state.
[
  [type Shape
    [Circle r: Int]
    [Square s: Int]
  ]

  shape: [Circle r: 5]

  area: [match shape
    [Circle r]: [* 3 [* r r]]
    [Square s]: [* s s]
  ]
]
