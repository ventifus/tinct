# Test new string builtins
{
  starts_with_true: [starts-with? "hello" "hel"]
  starts_with_false: [starts-with? "hello" "world"]
  ends_with_true: [ends-with? "hello" "llo"]
  ends_with_false: [ends-with? "hello" "world"]
  str_chars: [head [str-chars "abc"]]
  str_slice: [str-slice "hello" 1 3]
  str_contains_true: [str-contains? "hello world" "world"]
  str_contains_false: [str-contains? "hello world" "xyz"]
}
