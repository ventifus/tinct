{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tinct",
  "scopeName": "source.llt",
  "patterns": [
    { "include": "#comment" },
    { "include": "#document-header" },
    { "include": "#istring" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#boolean" },
    { "include": "#fn-expr" },
    { "include": "#special-form" },
    { "include": "#pipeline-ref" },
    { "include": "#call-head" },
    { "include": "#pipe" },
    { "include": "#type-annotation" },
    { "include": "#variable" },
    { "include": "#bracket" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.llt",
      "match": "#.*$"
    },
    "document-header": {
      "begin": "^(---)",
      "end": "$",
      "beginCaptures": {
        "1": { "name": "keyword.other.document-separator.llt" }
      },
      "patterns": [
        {
          "match": "\\b(stage|caps|expects|uses)\\b(?=\\s*:)",
          "captures": {
            "1": { "name": "keyword.other.document-header-key.llt" }
          }
        },
        { "include": "#pipeline-ref" },
        { "include": "#string" },
        { "include": "#type-annotation" },
        { "include": "#bracket" }
      ]
    },
    "istring": {
      "name": "string.quoted.double.llt",
      "begin": "i\"",
      "end": "\"",
      "patterns": [
        { "name": "variable.other.llt", "match": "\\$\\{[^}]*\\}" },
        { "name": "variable.other.llt", "match": "\\$[a-zA-Z_][a-zA-Z0-9_-]*" },
        { "name": "constant.character.escape.llt", "match": "\\$\\$|\\\\." }
      ]
    },
    "string": {
      "name": "string.quoted.double.llt",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.llt",
          "match": "\\\\."
        }
      ]
    },
    "number": {
      "name": "constant.numeric.llt",
      "match": "-?\\b(?:\\d+\\.\\d+|\\d+)\\b"
    },
    "boolean": {
      "name": "constant.language.boolean.llt",
      "match": "\\b(?:true|false)\\b"
    },
    "fn-expr": {
      "begin": "(?<=\\[)(fn)(@\\[[^\\]]*\\]|@[A-Za-z][A-Za-z0-9]*)?\\s+(\\[)",
      "end": "\\]",
      "beginCaptures": {
        "1": { "name": "keyword.control.llt" },
        "2": { "name": "storage.type.annotation.llt" },
        "3": { "name": "punctuation.section.brackets.llt" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.brackets.llt" }
      },
      "patterns": [
        { "name": "storage.type.annotation.llt", "match": "@\\[[^\\]]*\\]|@[A-Za-z][A-Za-z0-9]*" },
        { "name": "variable.parameter.llt", "match": "[^ \\t\\r\\n\\[\\]:#;\"@$%]+" }
      ]
    },
    "special-form": {
      "name": "keyword.control.llt",
      "match": "(?<=\\[)(?:call|type)(?=\\s|\\]|$)"
    },
    "pipeline-ref": {
      "name": "variable.other.pipeline.llt",
      "match": "%[a-zA-Z_][a-zA-Z0-9_-]*|%"
    },
    "call-head": {
      "name": "entity.name.function.llt",
      "match": "(?<=\\[)[^ \\t\\r\\n\\[\\]:#;\"@$%]++(?![\\t ]*:)"
    },
    "pipe": {
      "name": "keyword.operator.pipe.llt",
      "match": "\\|"
    },
    "type-annotation": {
      "name": "storage.type.annotation.llt",
      "match": "@[A-Za-z][A-Za-z0-9]*"
    },
    "variable": {
      "name": "variable.other.llt",
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_-]*"
    },
    "bracket": {
      "name": "punctuation.section.brackets.llt",
      "match": "[\\[\\]]"
    }
  }
}
