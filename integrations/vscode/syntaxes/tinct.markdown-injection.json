{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "markdown.llt.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    { "include": "#tinct-codeblock" }
  ],
  "repository": {
    "tinct-codeblock": {
      "begin": "(?:^|\\G)(\\s*)(```+|~~~+)\\s*(?:tinct|llt)\\s*$",
      "beginCaptures": {
        "2": { "name": "punctuation.definition.fenced_code.begin.markdown" }
      },
      "end": "(?:^|\\G)(\\1)(\\2)\\s*$",
      "endCaptures": {
        "2": { "name": "punctuation.definition.fenced_code.end.markdown" }
      },
      "name": "markup.fenced_code.block.llt.markdown",
      "contentName": "meta.embedded.block.llt",
      "patterns": [
        { "include": "source.llt" }
      ]
    }
  }
}
