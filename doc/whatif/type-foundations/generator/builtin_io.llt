# File I/O, filesystem, and capability operations.
# read-all/read-line return Bytes — callers decode explicitly.

[
  # File handles
  builtin-open:          [fn@Handle  [let cap@DirCap path@String flag@OpenFlag] ...]
  builtin-read-all:      [fn@Bytes   [let h@Handle] ...]
  builtin-read-chunk:    [fn@Bytes   [let h@Handle n@Int] ...]
  builtin-read-line:     [fn@Bytes   [let h@Handle] ...]
  builtin-write:         [fn@Int     [let h@Handle data@Bytes] ...]
  builtin-write-atomic:  [fn@Int     [let h@Handle data@Bytes tmp@String] ...]
  builtin-flush:         [fn@Boolean [let h@Handle] ...]
  builtin-close:         [fn@Boolean [let h@Handle] ...]
  builtin-seek:          [fn@Boolean [let h@Handle pos@Int] ...]
  builtin-seek-end:      [fn@Boolean [let h@Handle] ...]
  builtin-position:      [fn@Int     [let h@Handle] ...]
  builtin-string-handle: [fn@Handle  [let s@String] ...]

  # Filesystem operations
  builtin-list-dir:    [fn@[Seq Dict] [let cap@DirCap path@String] ...]
  builtin-stat:        [fn@Dict       [let cap@DirCap path@String] ...]
  builtin-exists:      [fn@Boolean    [let cap@DirCap path@String] ...]
  builtin-make-dir:    [fn@Boolean    [let cap@DirCap path@String] ...]
  builtin-remove:      [fn@Boolean    [let cap@DirCap path@String] ...]
  builtin-rename:      [fn@Boolean    [let cap@DirCap old@String new@String] ...]
  builtin-copy-file:   [fn@Boolean    [let src-cap@DirCap src@String dst-cap@DirCap dst@String] ...]
  builtin-read-link:   [fn@String     [let cap@DirCap path@String] ...]

  # Capability operations
  builtin-narrow:       [fn@DirCap [let cap@DirCap path@String] ...]
  builtin-cap-identity: [fn@String [let cap@DirCap] ...]

  # Environment
  builtin-env: [fn@String [let name@String] ...]

  # Emit channel
  builtin-emit: [fn@Boolean [let ch@[Channel Any] v@Any] ...]
]
