# generator/generate.llt — Generate Rust TypeScheme/TyConDef registrations.
#
# Usage: tinct run --cap-fs gendir=doc/whatif/type-foundations/generator:rwl generate.llt
#
# Evaluates each builtin_*.llt file (valid tinct declarations), uses describe/ast-of
# to extract type annotations, and emits Rust TypeScheme/TyConDef registrations.

--- caps: [%gendir: @DirCap]

[
  # ── Annotation node → Rust Type::* string ────────────────────────────────────
  # ann is the annotation dict from ast-of: {kind: "simple"|"dict"|"annotated", ...}
  # vars is a list of type variable names (to distinguish TyCon from TypeVar)

  ann-to-rust: [fn [let ann vars]
    [if [null? ann] "Type::Unknown"
    [if [str? ann]
        # Bare string value — check if it's a known type var or TyCon
        [if [contains? ann vars]
            [str ann ".clone()"]
            [known-tycon ann]]
    # Dict annotation
    [match [get-or "kind" "" ann]
        "simple":
            [name: ann.value]
            [if [contains? name vars] [str name ".clone()"] [known-tycon name]]
        "dict":
            [pos: [filter [fn [let e] [null? e.key]] ann.entries]]
            [if [empty? pos]
                # Named-only entries (metadata like doc: return:) — extract return:
                [named-only-to-rust ann vars]
                # First positional entry is the type constructor or keyword
                [head: [annotation-value-str [get "value" [get 0 pos]]]]
                [tail: [collect [drop 1 [each pos]]]]
                [if [= head "union"]
                    [str "Type::normalize_union(vec![" [join ", " [map [fn [let e] [ann-to-rust [get "value" e] vars]] tail]] "])"]
                    [if [= head "Fn"]
                        [fn-ann-to-rust ann vars]
                        [app-chain-to-rust head tail vars]]]]
        "annotated":
            # Seq@Int style: name is the constructor, inner is the arg
            [str "Type::App(Box::new(" [known-tycon ann.name] "), Box::new(" [ann-to-rust ann.inner vars] "))"]
        _: [str "Type::Unknown /* " [get-or "kind" "?" ann] " */"]]]]

  # Resolve a plain name to Rust Type
  known-tycon: [fn [let name]
    [match name
        "Int":     "Type::Int"
        "Float":   "Type::Float"
        "Boolean": "Type::Bool"
        "String":  "Type::Str"
        "Bytes":   "Type::Bytes"
        "Never":   "Type::Never"
        "Any":     "Type::Top"
        "Unknown": "Type::Unknown"
        _:         [str "Type::TyCon(\"" name "\".into())"]]]

  # Extract return type from named-only annotation dict (doc: + return:)
  named-only-to-rust: [fn [let ann vars]
    [ret-entry: [find-first-or [fn [let e] [= e.key "return"]] [] ann.entries]]
    [if [null? ret-entry] "Type::Unknown"
        [ann-to-rust [get "value" ret-entry] vars]]]

  # Build left-associative App chain: head [arg1 arg2 ...] → App(App(head,arg1),arg2)
  app-chain-to-rust: [fn [let head tail vars]
    [reduce
      [fn [let acc entry]
        [str "Type::App(Box::new(" acc "), Box::new(" [ann-to-rust [get "value" entry] vars] "))"]]
      [known-tycon head]
      tail]]

  # Convert a [Fn@RetType [...]] annotation to a Rust function type
  fn-ann-to-rust: [fn [let ann vars]
    # Look for return type in "annotated" entries or positional
    "Type::Top  /* Fn type — needs refinement */"]

  # ── Extract type variables from an annotation ─────────────────────────────────
  # Type vars are lowercase names that are NOT dict field names.
  # Heuristic: collect all lowercase bare names appearing in positional annotation positions.

  collect-vars-from-ann: [fn [let ann]
    [if [null? ann] []
    [if [str? ann]
        [if [and [> [str-length ann] 0]
                 [= ann [lower ann]]
                 [not [contains? ann ["int" "float" "string" "boolean" "bytes" "never" "any" "unknown"]]]]
            [cons ann []]
            []]
    [match [get-or "kind" "" ann]
        "simple":
            [name: ann.value]
            [if [and [> [str-length name] 0] [= name [lower name]]
                     [not [contains? name ["int" "float" "string" "boolean" "bytes" "never" "any" "unknown"]]]]
                [cons name []] []]
        "dict":
            [pos: [filter [fn [let e] [null? e.key]] ann.entries]]
            [flat-map collect-vars-from-ann [map [fn [let e] [get "value" e]] pos]]
        "annotated":
            [collect-vars-from-ann ann.inner]
        _: []]]]]

  collect-vars: [fn [let ret-ann params]
    [from-ret: [collect-vars-from-ann ret-ann]]
    [from-params: [flat-map [fn [let p]
        [if [has? "annotation" p] [collect-vars-from-ann p.annotation] []]]
        params]]
    [uniq [collect [concat [each from-ret] [each from-params]]]]]

  # ── Process one function declaration ─────────────────────────────────────────

  process-fn: [fn [let name fn-val]
    [d: [describe fn-val]]
    [ret-ann: [get-or "return-ann" [] d]]
    [params: [get-or "params" [] d]]
    [vars: [collect-vars ret-ann params]]
    [vars-vec: [str "vec![" [join ", " [map [fn [let v] [str "\"" v "\".to_string()"]] vars]] "]"]]
    [ret-rust: [ann-to-rust ret-ann vars]]
    [params-rust: [join ", " [map [fn [let p]
        [type-rust: [if [has? "annotation" p]
            [ann-to-rust p.annotation vars]
            "Type::Top"]]
        [str "(None, " type-rust ")"]]
        params]]]
    [n: [length params]]
    [str
     "env.insert_scheme(\n"
     "    \"" name "\",\n"
     "    TypeScheme {\n"
     "        type_vars: " vars-vec ",\n"
     "        constraints: vec![],\n"
     "        body: Type::Function {\n"
     "            params: vec![" params-rust "],\n"
     "            ret: Box::new(" ret-rust "),\n"
     "            variadic: false,\n"
     "            required_count: " [str n] ",\n"
     "        },\n"
     "        label_vars: vec![], kind_vars: vec![], doc: None, inner_schemes: None,\n"
     "    }\n"
     ");"]]

  # ── Process one type declaration ─────────────────────────────────────────────
  # [type Name] → arity 0; [type [let a] Name] → arity 1; etc.
  # The type value itself doesn't tell us arity at runtime; we read the sig.

  type-arity-from-sig: [fn [let sig]
    # sig is a string like "fn [...]" or for types, the TypeNode dict repr
    # For [type Name]: sig would not be a fn sig — use annotation-of instead
    0]  # default; parameterized types detected via annotation

  process-type: [fn [let name ty-val]
    # Detect arity by checking if the TypeConstructor dict has params
    # annotation-of gives us the annotation metadata
    [ann: [annotation-of ty-val]]
    [arity: [if [and [not [null? ann]] [has? "params" ann]]
        [length ann.params]
        0]]
    [str "env.insert_tycon_def(\""
         name
         "\", TyConDef::opaque(\""
         name
         "\", "
         [str arity]
         "));"]]

  process-entry: [fn [let name val]
    [t: [type-of val]]
    [if [fn? val]
        [process-fn name val]
        # Type declarations evaluate to TypeConstructor dicts or similar
        # Skip pure Dict/Null values (those are likely not declarations)
        [if [or [= t "Null"] [starts-with? "Builtin" t]]
            [str "// " name ": skipped (" t ")"]
            [process-type name val]]]]

  process-dict: [fn [let decls]
    [join "\n\n" [map
        [fn [let e] [process-entry e.key e.value]]
        [entries decls]]]]
]

# Main: walk builtin_*.llt files, evaluate each, generate .rs output
[reduce
  [fn [let count f]
    [path: f.name]
    [in-handle: [open %gendir path Readable]]
    [source: [str [builtin-read-all in-handle]]]
    [base: [get 0 [split "." path]]]
    [out-path: [str base ".rs"]]
    [decls: [eval source]]
    [content: [str
      "// AUTO-GENERATED by generate.llt — DO NOT EDIT\n"
      "// Source: " path "\n\n"
      [process-dict decls]
      "\n"]]
    [written: [builtin-write %gendir out-path content]]
    [if [>= written 0] [+ count 1] count]]
  0
  [filter
    [fn [let f] [and [= f.type "file"]
                     [and [starts-with? "builtin_" f.name]
                          [ends-with? ".llt" f.name]]]]
    [values [collect [list-dir %gendir "."]]]]]
