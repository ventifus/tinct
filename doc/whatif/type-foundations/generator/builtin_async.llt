# builtin_async.llt — Async concurrency: tasks, channels, contexts, reactive cells.
# Opaque types Task, Channel, Context, ReactiveCell declared in builtin_core.llt.

[
  # Tasks
  builtin-task:  [fn@[Task a]  [let f@[Fn@a []]] ...]
  builtin-await: [fn@a         [let t@[Task a]] ...]
  builtin-par:   [fn@a         [let f@[Fn@a []]] ...]

  # Channels
  builtin-channel:           [fn@[Channel a]         [let capacity@Int] ...]
  builtin-send:              [fn@Boolean              [let ch@[Channel a] v@a] ...]
  builtin-recv:              [fn@a                    [let ch@[Channel a]] ...]
  builtin-try-send:          [fn@[union Boolean Full Closed] [let ch@[Channel a] v@a] ...]
  builtin-broadcast-channel: [fn@[Channel a]         [let capacity@Int] ...]
  builtin-oneshot-channel:   [fn@[Channel a]         [] ...]
  builtin-signal-channel:    [fn@[Channel Boolean]   [] ...]
  builtin-timer-channel:     [fn@[Channel Boolean]   [let ms@Int] ...]
  builtin-watch-channel:     [fn@[Channel a]         [] ...]

  # Select
  builtin-select-once: [fn@Any [let ctx@Context sources@[Seq [Channel Any]]] ...]

  # Contexts
  builtin-context:         [fn@Context [let] ...]
  builtin-with-cancel:     [fn@[pass: Context  cancel: [Fn@Boolean []]] [let ctx@Context] ...]
  builtin-with-timeout:    [fn@Context [let ctx@Context ms@Int] ...]
  builtin-with-deadline:   [fn@Context [let ctx@Context deadline@Int] ...]
  builtin-cancelled?:      [fn@Boolean [let ctx@Context] ...]
  builtin-cancel-task:     [fn@Boolean [let ctx@Context] ...]
  builtin-non-cancellable: [fn@a       [let f@[Fn@a []]] ...]
  builtin-with-context:    [fn@a       [let ctx@Context f@[Fn@a []]] ...]
  builtin-cancel-root:     [fn@Boolean [] ...]
  builtin-drain:           [fn@Boolean [] ...]

  # Process control
  builtin-exit-now: [fn@Never [let code@Int] ...]

  # Reactive cells
  builtin-reactive-cell: [fn@[ReactiveCell a] [let v@a] ...]
  builtin-cell-get:      [fn@a               [let cell@[ReactiveCell a]] ...]
  builtin-cell-set:      [fn@Boolean         [let v@a cell@[ReactiveCell a]] ...]
]
