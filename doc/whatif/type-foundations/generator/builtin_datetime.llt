# Datetime builtins — timestamps, durations, timezones.
# String-redesign: format strings and timezone names are Graphemes.

[
  # Clock
  builtin-now:         [fn@Int [let cap@ClockCap] ...]
  builtin-fixed-clock: [fn@ClockCap [let ts@Int] ...]

  # Timestamp parsing/formatting (paths/strings → Graphemes)
  builtin-parse-timestamp:  [fn@Int      [let s@Graphemes] ...]
  builtin-format-timestamp: [fn@Graphemes [let ts@Int fmt@Graphemes] ...]

  # Timestamp conversion
  builtin-timestamp-unix: [fn@Int [let ts@Int] ...]
  builtin-unix-timestamp: [fn@Int [let unix@Int] ...]

  # Timestamp arithmetic
  builtin-timestamp-add:  [fn@Int [let ts@Int dur@Int] ...]
  builtin-timestamp-diff: [fn@Int [let a@Int b@Int] ...]

  # Timestamp components
  builtin-timestamp-year:   [fn@Int [let ts@Int] ...]
  builtin-timestamp-month:  [fn@Int [let ts@Int] ...]
  builtin-timestamp-day:    [fn@Int [let ts@Int] ...]
  builtin-timestamp-hour:   [fn@Int [let ts@Int] ...]
  builtin-timestamp-minute: [fn@Int [let ts@Int] ...]
  builtin-timestamp-second: [fn@Int [let ts@Int] ...]
  builtin-timestamp-parts:  [fn@Dict [let ts@Int] ...]

  # Duration constructors (return nanosecond Int)
  builtin-duration-nanos:   [fn@Int [let n@Int] ...]
  builtin-duration-seconds: [fn@Int [let n@Int] ...]
  builtin-duration-minutes: [fn@Int [let n@Int] ...]
  builtin-duration-hours:   [fn@Int [let n@Int] ...]
  builtin-duration-days:    [fn@Int [let n@Int] ...]

  # Duration conversion
  builtin-duration-seconds-from: [fn@Int [let dur@Int] ...]
  builtin-duration-nanos-from:   [fn@Int [let dur@Int] ...]

  # Timezone operations (timezone name is Graphemes)
  builtin-load-tz:          [fn@Any      [let cap@DirCap name@Graphemes] ...]
  builtin-timestamp-in-tz:  [fn@Dict     [let ts@Int tz@Any] ...]
  builtin-local-to-timestamp:[fn@Int     [let y@Int mo@Int d@Int h@Int mi@Int s@Int tz@Any] ...]
  builtin-local-tz-name:    [fn@Graphemes [let cap@DirCap] ...]
]
