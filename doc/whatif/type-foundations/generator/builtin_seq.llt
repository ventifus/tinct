# Sequence operations — map, filter, reduce, etc.
# These are polymorphic and survive the string-redesign unchanged.

[
  # Sequence construction
  builtin-seq:     [fn@[Seq Any] [let ...items] ...]
  builtin-cons:    [fn@[Seq a]   [let x@a rest@[Seq a]] ...]
  builtin-range:   [fn@[Seq Int] [let ...args@Int] ...]
  builtin-repeat:  [fn@[Seq a]   [let x@a] ...]
  builtin-cycle:   [fn@[Seq a]   [let xs@[Seq a]] ...]
  builtin-iterate: [fn@[Seq a]   [let f@[Fn@a [a]] init@a] ...]

  # Sequence access
  builtin-head:    [fn@a         [let xs@[Seq a]] ...]
  builtin-tail:    [fn@[Seq a]   [let xs@[Seq a]] ...]
  builtin-first:   [fn@a         [let xs@[Seq a]] ...]
  builtin-last:    [fn@a         [let xs@[Seq a]] ...]
  builtin-rest:    [fn@[Seq a]   [let xs@[Seq a]] ...]

  # Sequence transforms
  builtin-map:     [fn@[Seq b]   [let f@[Fn@b [a]] xs@[Seq a]] ...]
  builtin-filter:  [fn@[Seq a]   [let f@[Fn@Boolean [a]] xs@[Seq a]] ...]
  builtin-take:    [fn@[Seq a]   [let n@Int xs@[Seq a]] ...]
  builtin-drop:    [fn@[Seq a]   [let n@Int xs@[Seq a]] ...]
  builtin-reverse: [fn@[Seq a]   [let xs@[Seq a]] ...]
  builtin-concat:  [fn@[Seq a]   [let a@[Seq a] b@[Seq a]] ...]

  # Sequence reduction
  builtin-reduce:  [fn@a [let f@[Fn@a [a b]] init@a xs@[Seq b]] ...]
  builtin-collect: [fn@[List a]  [let xs@[Seq a]] ...]

  # Sequence sorting
  builtin-sort:    [fn@[Seq a]   [let xs@[Seq a] cmp@[Fn@Boolean [a a]]] ...]
]
