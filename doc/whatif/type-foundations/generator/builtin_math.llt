# builtin_math.llt — Arithmetic and math primitives.
# Note: +, -, *, /, =, < are typeclass methods in prelude (not Rust builtins).
# These are the Rust primitives backing the Addable/Sortable/etc. instances.

[
  # Integer arithmetic
  builtin-int-add: [fn@Int [let a@Int b@Int] ...]
  builtin-int-sub: [fn@Int [let a@Int b@Int] ...]
  builtin-int-mul: [fn@Int [let a@Int b@Int] ...]
  builtin-int-div: [fn@Int [let a@Int b@Int] ...]

  # Float arithmetic
  builtin-float-add: [fn@Float [let a@Float b@Float] ...]
  builtin-float-sub: [fn@Float [let a@Float b@Float] ...]
  builtin-float-mul: [fn@Float [let a@Float b@Float] ...]
  builtin-float-div: [fn@Float [let a@Float b@Float] ...]

  # Bitwise (Int only)
  builtin-band: [fn@Int [let a@Int b@Int] ...]
  builtin-bor:  [fn@Int [let a@Int b@Int] ...]
  builtin-bxor: [fn@Int [let a@Int b@Int] ...]
  builtin-shl:  [fn@Int [let a@Int b@Int] ...]
  builtin-shr:  [fn@Int [let a@Int b@Int] ...]

  # Float math
  builtin-floor:   [fn@Int   [let x@Float] ...]
  builtin-round:   [fn@Int   [let x@Float] ...]
  builtin-ceil:    [fn@Int   [let x@Float] ...]
  builtin-pow:     [fn@Float [let base@Float exp@Float] ...]
  builtin-sqrt:    [fn@Float [let x@Float] ...]
  builtin-log:     [fn@Float [let x@Float] ...]
  builtin-log2:    [fn@Float [let x@Float] ...]
  builtin-log10:   [fn@Float [let x@Float] ...]
  builtin-exp:     [fn@Float [let x@Float] ...]
  builtin-sin:     [fn@Float [let x@Float] ...]
  builtin-cos:     [fn@Float [let x@Float] ...]
  builtin-tan:     [fn@Float [let x@Float] ...]
  builtin-asin:    [fn@Float [let x@Float] ...]
  builtin-acos:    [fn@Float [let x@Float] ...]
  builtin-atan:    [fn@Float [let x@Float] ...]
  builtin-atan2:   [fn@Float [let y@Float x@Float] ...]

  # Float predicates
  builtin-nan?:    [fn@Boolean [let x@Float] ...]
  builtin-inf?:    [fn@Boolean [let x@Float] ...]
  builtin-finite?: [fn@Boolean [let x@Float] ...]

  # Type conversions
  builtin-int-to-float: [fn@Float [let x@Int] ...]
  builtin-float-to-int: [fn@Int   [let x@Float] ...]
  builtin-parse-int:    [fn@Int   [let s@String] ...]
  builtin-parse-float:  [fn@Float [let s@String] ...]
]
