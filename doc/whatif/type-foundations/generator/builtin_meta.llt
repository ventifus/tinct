# Meta/reflection builtins — introspection, annotations, evaluation, AST.
# (builtin-raise, builtin-try, builtin-if live in builtin_core.llt)

[
  # Materialization
  materialize: [fn@a [let v@a] ...]

  # Type introspection
  builtin-type-of:        [fn@String  [let v@Any] ...]
  builtin-is-contractive: [fn@Boolean [let node@TypeNode] ...]
  builtin-tag-of:         [fn@String  [let v@Any] ...]

  # Function application
  builtin-apply: [fn@Any [let f@Fn args@Dict] ...]

  # Annotations
  builtin-annotation-of:  [fn@Dict [let v@Any] ...]
  builtin-make-annotated: [fn@Any  [let v@Any ann@Dict] ...]

  # Symbol generation (macro hygiene)
  builtin-gensym: [fn@String [let prefix@String] ...]

  # Representation / debugging
  builtin-llt-repr: [fn@String [let v@Any] ...]
  builtin-blake3:   [fn@String [let data@Bytes] ...]

  # Include cache (module system)
  builtin-include-cache-get: [fn@Any     [let key@String] ...]
  builtin-include-cache-put: [fn@Boolean [let key@String v@Any] ...]

  # Module system
  builtin-module: [fn@Dict [let name@String] ...]

  # Source loading and evaluation
  builtin-load:       [fn@Program [let source@String name@[default: Absent.Absent]] ...]
  builtin-expand:     [fn@Program [let prog@Program] ...]
  builtin-eval-types: [fn@Dict    [let prog@Program] ...]

  # AST reflection
  builtin-ast-of: [fn@Dict [let v@Any] ...]

  # Extended numeric types (opaque Rust types)
  builtin-decimal: [fn@Decimal [let v@[union Int Float String]] ...]
  builtin-big-int: [fn@BigInt  [let v@[union Int String]] ...]
]
