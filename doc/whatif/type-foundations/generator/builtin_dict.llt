# builtin_dict.llt — Irreducible Dict primitives.

[
  builtin-keys:      [fn@[Seq k]              [let d@[Map k v]] ...]
  builtin-length:    [fn@Int                  [let d@[Map k v]] ...]
  builtin-merge:     [fn@[Map k v]            [let a@[Map k v] b@[Map k v]] ...]
  builtin-get:       [fn@v                    [let k@k d@[Map k v]] ...]
  builtin-build-dict:[fn@[Map k v]            [let xs@[Seq [key: k  value: v]]] ...]

  # Mutable builder API
  builtin-make-builder:     [fn@BuilderHandle [let] ...]
  builtin-builder-set:      [fn@BuilderHandle [let k@k v@v b@BuilderHandle] ...]
  builtin-builder-delete:   [fn@BuilderHandle [let k@k b@BuilderHandle] ...]
  builtin-builder-has?:     [fn@Boolean       [let k@k b@BuilderHandle] ...]
  builtin-builder-get:      [fn@v             [let k@k b@BuilderHandle] ...]
  builtin-builder-get-or:   [fn@v             [let k@k default@v b@BuilderHandle] ...]
  builtin-builder-finish:   [fn@[Map k v]     [let b@BuilderHandle] ...]
  builtin-builder-snapshot: [fn@[Map k v]     [let b@BuilderHandle] ...]
]
