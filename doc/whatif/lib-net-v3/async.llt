# stdlib/async.llt — async channel operators.
# Part of: lib-net-v3
#
# MIGRATION NOTE: task, await, send, recv, channel, loop-select, context,
# cancel-task, cancel-root, drain, exit, graceful-exit, etc. are all defined in
# stdlib/prelude.llt. This file provides channel-map, channel-flat-map, and
# collect-channel — higher-level channel combinators built on those prelude primitives.
# Do NOT [include %libdir "async.llt"] from protocol files; all concurrency
# primitives are available without any import.

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  # (no private helpers)
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # 1:1 — apply f concurrently to each incoming element.
  # Inner tasks run to completion even after the outer loop exits (clean shutdown via drain/exit).
  # The ByteStream constraint on f's argument propagates to in-ch@[Channel element] at the call site.
  # recv returns [Result.Ok x] | Closed.Closed; the step loop exits naturally when the input channel closes.
  channel-map: [fn@[bind: [element result]] [let f]
    [fn@[return: [Channel result]] [let in-ch@[Channel element]  buffer-size@[type: Int  default: 64]]
      [out: [channel buffer-size]]
      [task
        [let step [fn []
          [match [recv in-ch]
            [Closed.Closed]: []
            [Result.Ok x]:   [[task [send out [f x]]] [step]]]]]
        [step]]
      out]]

  # 1:N — apply f to each element; f emits multiple items to the shared output channel.
  # recv returns [Result.Ok x] | Closed.Closed; the step loop exits naturally when the input channel closes.
  channel-flat-map: [fn@[bind: [element item]] [let f]
    [fn@[return: [Channel item]] [let in-ch@[Channel element]  buffer-size@[type: Int  default: 256]]
      [out: [channel buffer-size]]
      [task
        [let step [fn []
          [match [recv in-ch]
            [Closed.Closed]: []
            [Result.Ok x]:   [[task [f x out]] [step]]]]]
        [step]]
      out]]

  # Snapshot items currently buffered in a channel without racing a concurrent producer.
  # channel-count gives the item count; try-recv drains exactly that many.
  collect-channel: [fn [let ch@[Channel t]]
    [n: [channel-count ch]]
    [collect [map [fn [let _] [try-recv ch]] [range 0 n]]]]
]
