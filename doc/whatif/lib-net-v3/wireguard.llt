# stdlib/protocols/wireguard.llt — WireGuard user-mode (Noise_IKpsk2) in tinct.
# Part of: lib-net-v3
# WireGuard IS Noise_IKpsk2 + Blake2s + ChaChaPoly + X25519. The handshake key schedule
# is delegated to noise.llt's IK pattern implementation; this file adds WireGuard-specific
# message framing (type bytes, sender/receiver indices, mac1/mac2 fields).
# Rust primitives: chacha20-poly1305-seal/open (data plane),
#   blake2s, blake2s-mac (mac1/mac2 framing), crypto-random
--- uses: ["crypto"]

[include %libdir "crypto.llt"]      # for HkdfHash ([Blake2s] etc.)
[include %include-dir "noise.llt"]  # for NoiseConfig, NoiseConnection, noise-accept, noise-layer

[instance@[bind: [h]] ByteStream
  [let s@[WireguardConnection h]]: [read:  wg-read-bytes
                                    write: wg-write-bytes]]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  wg-label-mac1: "mac1----"

  wg-mac: [fn [let key@[Bytes 32] data@Bytes] [blake2s-mac key data]]

  # TAI64N timestamp: WireGuard uses this in the handshake initiation to prevent replay.
  wg-timestamp: [fn []
    [now-ns: [timestamp-nanos [now %clock]]]
    [concat
      [bytes ByteOrder.BigEndian [@UInt64 [+ [/ now-ns 1000000000] 4611686018427387914]]]
      [bytes ByteOrder.BigEndian [@UInt32 [mod now-ns 1000000000]]]]]

  # Build a NoiseConfig for WireGuard's Noise_IKpsk2 handshake from a WireguardConfig.
  # pattern IKpsk2: initiator knows responder's static key; PSK injected at mix step 2.
  wg-noise-config: [fn [let cfg@WireguardConfig]
    [NoiseConfig
      [pattern:     [IKpsk2]
       dh:          [X25519]
       cipher:      [ChaChaPoly]
       hash:        [Blake2s]
       private-key: cfg.private-key
       public-key:  cfg.public-key
       remote-key:  cfg.peer-key
       psk:         cfg.preshared-key
       prologue:    []]]]

  # mac1/mac2 framing: prepend WireGuard handshake message type byte, sender index,
  # mac1 (BLAKE2s over message body keyed with Hash("mac1----" || responder-static)),
  # and mac2 (zeros when no cookie; non-zero only when responder has sent a CookieReply).
  wg-frame-initiation: [fn [let cfg@WireguardConfig sender-index@WgSessionIndex noise-msg@Bytes]
    [mac1-key: [blake2s [concat [str-bytes wg-label-mac1] cfg.peer-key]]]
    [msg-body: [concat
      [bytes ByteOrder.LittleEndian [@WgMessageType 1]]
      [bytes ByteOrder.LittleEndian sender-index]
      noise-msg]]
    [concat msg-body [wg-mac mac1-key msg-body] [bytes-zero 16]]]

  wg-strip-initiation-framing: [fn [let msg@Bytes]
    # Strip 4-byte type + 4-byte sender-index prefix; drop 32-byte mac1/mac2 suffix.
    [slice 8 [- [length msg] 32] msg]]

  wg-frame-response: [fn [let cfg@WireguardConfig sender-index@WgSessionIndex receiver-index@WgSessionIndex noise-msg@Bytes]
    [mac1-key: [blake2s [concat [str-bytes wg-label-mac1] cfg.peer-key]]]
    [msg-body: [concat
      [bytes ByteOrder.LittleEndian [@WgMessageType 2]]
      [bytes ByteOrder.LittleEndian sender-index]
      [bytes ByteOrder.LittleEndian receiver-index]
      noise-msg]]
    [concat msg-body [wg-mac mac1-key msg-body] [bytes-zero 16]]]

  wg-strip-response-framing: [fn [let msg@Bytes]
    # Strip 4-byte type + 4-byte sender + 4-byte receiver prefix; drop 32-byte mac1/mac2.
    [slice 12 [- [length msg] 32] msg]]

  init-nonce-ch: [fn []
    [ch: [channel 1]]
    [send ch 0]
    ch]

  bytes-zero: [fn [let n@Int]
    [reduce [fn [let acc _] [concat acc [bytes 0]]] [] [range 0 n]]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # Named domain types with fixed byte-order encodings per the WireGuard spec.
  # WireGuard uses little-endian for all integer fields (§5.4).
  WgMessageType:  [type UInt32@[encoding: ByteOrder.LittleEndian]]   # 4-byte LE message type (§5.4.2, §5.4.3, §5.4.6)
  WgSessionIndex: [type UInt32@[encoding: ByteOrder.LittleEndian]]   # 4-byte LE sender/receiver index (§5.4.2, §5.4.3)
  WgNonce:        [type UInt64@[encoding: ByteOrder.LittleEndian]]   # 8-byte LE nonce counter (§5.4.6)

  WireguardConfig: [type
    [private-key:   [Bytes 32]
     public-key:    [Bytes 32]
     peer-key:      [Bytes 32]
     preshared-key: [Bytes 32]]]

  # WireguardConnection is parametric over its underlying ByteStream h so WireGuard
  # can be stacked over any stream (Handle, TlsConnection, etc.).
  # Single-writer invariant on tx-nonce: two concurrent writers cause nonce reuse
  # → ChaCha20-Poly1305 keystream reuse → full confidentiality loss.
  WireguardConnection: [type [h]   # h must satisfy ByteStream; enforced at instance sites
    [underlying: h
     tx-key:     [Bytes 32]
     rx-key:     [Bytes 32]
     tx-nonce:   [Channel WgNonce]]]  # 64-bit little-endian counter (WireGuard §5.4.6)

  # WgDataCodec: Bytes ↔ WireGuard data message Bytes (WireGuard §5.4.6).
  # Carries the WireguardConnection for tx/rx keys and the tx-nonce counter.
  # encode: plaintext Bytes → WireGuard type-4 data message Bytes
  # decode: WireGuard type-4 data message Bytes → plaintext Bytes
  WgDataCodec: [type [h] [conn: [WireguardConnection h]]]

  # wireguard-accept — responder side (server).
  # Cannot delegate to noise-accept because WireGuard message framing is different from raw
  # Noise framing: each handshake message adds a 4-byte type, 4-byte sender index, and
  # 32-byte mac1+mac2 trailer. noise-accept reads raw Noise messages; feeding it WireGuard-
  # framed bytes would fail.
  #
  # Full implementation steps:
  #   1. Read 148-byte Initiation message from h.
  #   2. Validate mac1 = BLAKE2s(HASH("mac1----" || peer-public-key), first 116 bytes).
  #   3. Strip framing with wg-strip-initiation-framing → 96-byte Noise payload.
  #   4. Run Noise_IKpsk2 state machine on the payload (IK responder step, keyed with cfg).
  #   5. Construct 92-byte Noise Response payload.
  #   6. Frame Response with wg-frame-response (sender-index, receiver-index, mac1, mac2).
  #   7. Write the framed Response back to h.
  #   8. Derive data-plane tx-key/rx-key from the Noise session.
  # WireGuard handshake responder per WireGuard §5.
  # Message 1 (Initiation, 148 bytes):
  #   type(4)=1  sender-index(4)  unencrypted-ephemeral(32)
  #   encrypted-static(32+16)  encrypted-timestamp(12+16)  mac1(16)  mac2(16)
  # Message 2 (Response, 92 bytes):
  #   type(4)=2  sender-index(4)  receiver-index(4)  unencrypted-ephemeral(32)
  #   encrypted-nothing(0+16)  mac1(16)  mac2(16)
  # After handshake: data messages use ChaCha20-Poly1305 with tx-nonce counter.
  # Algorithm uses the Noise_IKpsk2_25519_ChaChaPoly_BLAKE2s pattern:
  #   Init state: h = hash("WireGuard v1 zx2c4 Jason@zx2c4.com") + 32-byte construction hash
  #   Parse msg1: validate mac1, run IKpsk2 initiator receive, validate timestamp
  #   Send msg2: run IKpsk2 responder send
  #   Derive tx-key/rx-key from noise-split
  wireguard-accept: [fn@[bind: [h]  return: [WireguardConnection h]  constraint: [h: ByteStream]]
                      [let cfg@WireguardConfig h@h]
    # WireGuard §5.4.2: Noise_IKpsk2 responder with WireGuard-specific framing.
    # Protocol name hash: blake2s("Noise_IKpsk2_25519_ChaChaPoly_BLAKE2s") truncated/padded to 32 bytes.
    # Construction identifier: blake2s("Noise Protocol Name") — WireGuard uses blake2s throughout.
    [wg-construction: [blake2s [str-bytes "Noise_IKpsk2_25519_ChaChaPoly_BLAKE2s"]]]
    # h = blake2s(construction || identifier) per WireGuard §5 (initial chaining key)
    [wg-identifier: [blake2s [str-bytes "WireGuard v1 zx2c4 Jason@zx2c4.com"]]]
    [ck: [blake2s [concat wg-construction wg-identifier]]]
    [h:  [blake2s [concat ck [str-bytes "WireGuard v1 zx2c4 Jason@zx2c4.com"]]]]
    # Mix responder public key into h
    [h: [blake2s [concat h cfg.public-key]]]
    # Read Initiation message (148 bytes): type(4) sender-index(4) e(32) encrypted-s(48) encrypted-timestamp(28) mac1(16) mac2(16)
    [msg1: [read h 148]]
    [msg1-type:     [@WgMessageType [uint32 ByteOrder.LittleEndian [slice msg1 0 4]]]]
    [if [not [= msg1-type 1]] [error "WireGuard: expected Initiation message (type 1)"] null]
    [sender-idx:    [@WgSessionIndex [uint32 ByteOrder.LittleEndian [slice msg1 4 8]]]]
    [re-pub:        [slice msg1 8 40]]           # unencrypted-ephemeral (32 bytes)
    [enc-static:    [slice msg1 40 88]]          # encrypted-static (32 + 16 AEAD tag)
    [enc-timestamp: [slice msg1 88 116]]         # encrypted-timestamp (12 + 16 AEAD tag)
    # mac1/mac2: last 32 bytes (16 each) — validate mac1
    [mac1-key: [blake2s [concat [str-bytes wg-label-mac1] cfg.public-key]]]
    [expected-mac1: [wg-mac mac1-key [slice msg1 0 116]]]
    [if [not [= expected-mac1 [slice msg1 116 132]]] [error "WireGuard: invalid mac1"] null]
    # IKpsk2 responder state machine
    # Step 1: mix initiator ephemeral into ck, h
    [ck-h1:  [hkdf-extract [Blake2s] ck re-pub]]
    [both1:  [hkdf-expand  [Blake2s] ck-h1 [] 64]]
    [ck:     [slice both1 0  32]]
    [k-temp: [slice both1 32 64]]
    [h: [blake2s [concat h re-pub]]]
    # Step 2: DH(responder-static, initiator-ephemeral) → mix into ck
    [dh-s-re: [x25519-dh cfg.private-key re-pub]]
    [ck-h2:  [hkdf-extract [Blake2s] ck dh-s-re]]
    [both2:  [hkdf-expand  [Blake2s] ck-h2 [] 64]]
    [ck:     [slice both2 0  32]]
    [k-es:   [slice both2 32 64]]
    # Step 3: decrypt initiator static key
    [nonce0: [concat [0 0 0 0] [bytes ByteOrder.LittleEndian [@UInt64 0]]]]
    [rs-plain: [match [chacha20-poly1305-open k-es nonce0 enc-static h]
      [Result.Ok p]:    p
      [Result.Error _]: [error "WireGuard: failed to decrypt initiator static key"]]]
    [h: [blake2s [concat h enc-static]]]
    [rs: rs-plain]   # initiator's static public key (32 bytes)
    # Step 4: DH(responder-static, initiator-static) → mix into ck
    [dh-s-rs: [x25519-dh cfg.private-key rs]]
    [ck-h3:  [hkdf-extract [Blake2s] ck dh-s-rs]]
    [both3:  [hkdf-expand  [Blake2s] ck-h3 [] 64]]
    [ck:     [slice both3 0  32]]
    [k-ss:   [slice both3 32 64]]
    # Step 5: PSK injection (IKpsk2) — mix preshared-key into ck and k
    [ck-h4:  [hkdf-extract [Blake2s] ck cfg.preshared-key]]
    [all4:   [hkdf-expand  [Blake2s] ck-h4 [] 96]]
    [ck:     [slice all4 0  32]]
    [psk-h:  [slice all4 32 64]]
    [k-psk:  [slice all4 64 96]]
    [h: [blake2s [concat h psk-h]]]
    # Step 6: decrypt timestamp (validates message freshness)
    [nonce1: [concat [0 0 0 0] [bytes ByteOrder.LittleEndian [@UInt64 1]]]]
    [_: [match [chacha20-poly1305-open k-psk nonce1 enc-timestamp h]
      [Result.Ok _]:    null
      [Result.Error _]: [error "WireGuard: failed to decrypt timestamp"]]]
    [h: [blake2s [concat h enc-timestamp]]]
    # Build Response message (92 bytes): type(4)=2 sender-index(4) receiver-index(4) e(32) encrypted-nothing(16) mac1(16) mac2(16)
    [my-sender-idx: [@WgSessionIndex [uint32 ByteOrder.LittleEndian [crypto-random 4]]]]
    [eph-resp: [x25519-keypair]]
    # Mix responder ephemeral into ck, h
    [h: [blake2s [concat h eph-resp.public]]]
    [ck-h5: [hkdf-extract [Blake2s] ck eph-resp.public]]
    [both5: [hkdf-expand  [Blake2s] ck-h5 [] 64]]
    [ck:    [slice both5 0  32]]
    # DH(responder-ephemeral, initiator-ephemeral) = ee
    [dh-re-ie: [x25519-dh eph-resp.private re-pub]]
    [ck-h6: [hkdf-extract [Blake2s] ck dh-re-ie]]
    [both6: [hkdf-expand  [Blake2s] ck-h6 [] 64]]
    [ck:    [slice both6 0  32]]
    # DH(responder-ephemeral, initiator-static) = se
    [dh-re-is: [x25519-dh eph-resp.private rs]]
    [ck-h7: [hkdf-extract [Blake2s] ck dh-re-is]]
    [both7: [hkdf-expand  [Blake2s] ck-h7 [] 64]]
    [ck:    [slice both7 0  32]]
    [k-resp: [slice both7 32 64]]
    # Encrypt empty payload for Response "encrypted-nothing" field (16-byte AEAD tag)
    [nonce2: [concat [0 0 0 0] [bytes ByteOrder.LittleEndian [@UInt64 0]]]]
    [enc-nothing: [chacha20-poly1305-seal k-resp nonce2 [] h]]
    [h: [blake2s [concat h enc-nothing]]]
    # Build message 2 body (before mac1/mac2)
    [msg2-body: [concat
      [bytes ByteOrder.LittleEndian [@WgMessageType 2]]
      [bytes ByteOrder.LittleEndian my-sender-idx]
      [bytes ByteOrder.LittleEndian sender-idx]
      eph-resp.public
      enc-nothing]]
    # mac1 over msg2-body, keyed with hash("mac1----" || initiator-static)
    [mac1-key2: [blake2s [concat [str-bytes wg-label-mac1] rs]]]
    [mac1-resp: [wg-mac mac1-key2 msg2-body]]
    [msg2: [concat msg2-body mac1-resp [bytes-zero 16]]]
    [write h msg2]
    # Derive data-plane session keys from final ck via HKDF
    [all-final: [hkdf-expand [Blake2s] ck [] 64]]
    [rx-key: [slice all-final 0  32]]   # initiator-to-responder (we receive)
    [tx-key: [slice all-final 32 64]]   # responder-to-initiator (we send)
    [tx-nonce-ch: [init-nonce-ch]]
    [WireguardConnection underlying: h  tx-key: tx-key  rx-key: rx-key  tx-nonce: tx-nonce-ch]]

  # wireguard — initiator side (client).
  # Same constraint as wireguard-accept: cannot delegate to noise-layer directly.
  # Full implementation: read server's WireGuard-framed Response, strip framing,
  # run Noise_IKpsk2 initiator state machine, derive data-plane keys.
  # WireGuard handshake initiator (mirror of wireguard-accept).
  # Sends Initiation message (148 bytes), receives Response message (92 bytes).
  # Same IKpsk2 Noise pattern but in initiator role; uses wg-frame-initiation helper.
  wireguard: [fn@[bind: [h]  return: [WireguardConnection h]  constraint: [h: ByteStream]]
                     [let cfg@WireguardConfig h@h]
    # WireGuard §5.4.2: Noise_IKpsk2 initiator with WireGuard-specific framing.
    # Initialize state identically to wireguard-accept but in initiator role.
    [wg-construction: [blake2s [str-bytes "Noise_IKpsk2_25519_ChaChaPoly_BLAKE2s"]]]
    [wg-identifier: [blake2s [str-bytes "WireGuard v1 zx2c4 Jason@zx2c4.com"]]]
    [ck: [blake2s [concat wg-construction wg-identifier]]]
    [h:  [blake2s [concat ck [str-bytes "WireGuard v1 zx2c4 Jason@zx2c4.com"]]]]
    # Mix responder (peer) public key into h
    [h: [blake2s [concat h cfg.peer-key]]]
    # Generate ephemeral key pair and sender index
    [eph: [x25519-keypair]]
    [sender-index: [@WgSessionIndex [uint32 ByteOrder.LittleEndian [crypto-random 4]]]]
    # Mix initiator ephemeral into ck, h
    [h: [blake2s [concat h eph.public]]]
    [ck-h1: [hkdf-extract [Blake2s] ck eph.public]]
    [both1: [hkdf-expand  [Blake2s] ck-h1 [] 64]]
    [ck:    [slice both1 0  32]]
    # DH(initiator-ephemeral, responder-static) = es
    [dh-ie-rs: [x25519-dh eph.private cfg.peer-key]]
    [ck-h2: [hkdf-extract [Blake2s] ck dh-ie-rs]]
    [both2: [hkdf-expand  [Blake2s] ck-h2 [] 64]]
    [ck:    [slice both2 0  32]]
    [k-es:  [slice both2 32 64]]
    # Encrypt initiator static key
    [nonce0: [concat [0 0 0 0] [bytes ByteOrder.LittleEndian [@UInt64 0]]]]
    [enc-static: [chacha20-poly1305-seal k-es nonce0 cfg.public-key h]]
    [h: [blake2s [concat h enc-static]]]
    # DH(initiator-static, responder-static) = ss
    [dh-is-rs: [x25519-dh cfg.private-key cfg.peer-key]]
    [ck-h3: [hkdf-extract [Blake2s] ck dh-is-rs]]
    [both3: [hkdf-expand  [Blake2s] ck-h3 [] 64]]
    [ck:    [slice both3 0  32]]
    [k-ss:  [slice both3 32 64]]
    # PSK injection (IKpsk2)
    [ck-h4: [hkdf-extract [Blake2s] ck cfg.preshared-key]]
    [all4:  [hkdf-expand  [Blake2s] ck-h4 [] 96]]
    [ck:    [slice all4 0  32]]
    [psk-h: [slice all4 32 64]]
    [k-psk: [slice all4 64 96]]
    [h: [blake2s [concat h psk-h]]]
    # Encrypt timestamp (TAI64N, 12 bytes)
    [ts: [wg-timestamp]]
    [nonce1: [concat [0 0 0 0] [bytes ByteOrder.LittleEndian [@UInt64 1]]]]
    [enc-timestamp: [chacha20-poly1305-seal k-psk nonce1 ts h]]
    [h: [blake2s [concat h enc-timestamp]]]
    # Build Initiation message body (116 bytes before mac1/mac2)
    [msg1-body: [concat
      [bytes ByteOrder.LittleEndian [@WgMessageType 1]]
      [bytes ByteOrder.LittleEndian sender-index]
      eph.public
      enc-static
      enc-timestamp]]
    # mac1 over msg1-body (116 bytes), keyed with hash("mac1----" || responder-static)
    [mac1-key: [blake2s [concat [str-bytes wg-label-mac1] cfg.peer-key]]]
    [mac1: [wg-mac mac1-key msg1-body]]
    [msg1: [concat msg1-body mac1 [bytes-zero 16]]]
    [write h msg1]
    # Read Response message (92 bytes): type(4)=2 sender-index(4) receiver-index(4) e(32) enc-nothing(16) mac1(16) mac2(16)
    [resp: [read h 92]]
    [resp-type: [@WgMessageType [uint32 ByteOrder.LittleEndian [slice resp 0 4]]]]
    [if [not [= resp-type 2]] [error "WireGuard: expected Response message (type 2)"] null]
    [re-pub: [slice resp 12 44]]   # unencrypted-ephemeral (bytes 12-44)
    [enc-nothing: [slice resp 44 60]]   # encrypted-nothing (0 + 16 AEAD tag)
    # Process responder ephemeral into ck, h
    [h: [blake2s [concat h re-pub]]]
    [ck-h5: [hkdf-extract [Blake2s] ck re-pub]]
    [both5: [hkdf-expand  [Blake2s] ck-h5 [] 64]]
    [ck:    [slice both5 0  32]]
    # DH(initiator-ephemeral, responder-ephemeral) = ee
    [dh-ie-re: [x25519-dh eph.private re-pub]]
    [ck-h6: [hkdf-extract [Blake2s] ck dh-ie-re]]
    [both6: [hkdf-expand  [Blake2s] ck-h6 [] 64]]
    [ck:    [slice both6 0  32]]
    # DH(initiator-static, responder-ephemeral) = se
    [dh-is-re: [x25519-dh cfg.private-key re-pub]]
    [ck-h7: [hkdf-extract [Blake2s] ck dh-is-re]]
    [both7: [hkdf-expand  [Blake2s] ck-h7 [] 64]]
    [ck:    [slice both7 0  32]]
    [k-resp: [slice both7 32 64]]
    # Decrypt enc-nothing to authenticate Response
    [nonce2: [concat [0 0 0 0] [bytes ByteOrder.LittleEndian [@UInt64 0]]]]
    [_: [match [chacha20-poly1305-open k-resp nonce2 enc-nothing h]
      [Result.Ok _]:    null
      [Result.Error _]: [error "WireGuard: failed to authenticate Response message"]]]
    [h: [blake2s [concat h enc-nothing]]]
    # Derive data-plane session keys from final ck
    [all-final: [hkdf-expand [Blake2s] ck [] 64]]
    [tx-key: [slice all-final 0  32]]   # initiator-to-responder (we send)
    [rx-key: [slice all-final 32 64]]   # responder-to-initiator (we receive)
    [tx-nonce-ch: [init-nonce-ch]]
    [WireguardConnection underlying: h  tx-key: tx-key  rx-key: rx-key  tx-nonce: tx-nonce-ch]]

  wg-write-bytes: [fn [let conn@WireguardConnection data@Bytes]
    # tx-nonce channel holds exactly one value (atomic counter via channel).
    # recv returns [Result.Ok n]; Closed.Closed is impossible for an internal nonce channel.
    [match [recv conn.tx-nonce]
      [Closed.Closed]:  [error "WireGuard: nonce channel closed unexpectedly"]
      [Result.Ok nonce]:
        [if [>= nonce 9223372036854775807] [error "WireGuard: nonce exhausted — rekey required"] null]
        [send conn.tx-nonce [+ nonce 1]]
        [nonce-bytes: [bytes ByteOrder.LittleEndian [@WgNonce nonce]]]   # WireGuard §5.4.6: nonce: WgNonce
        [ciphertext: [chacha20-poly1305-seal conn.tx-key [concat [0 0 0 0] nonce-bytes] data []]]
        [write conn.underlying [concat [bytes 4] [0 0 0 0] nonce-bytes ciphertext]]]]

  wg-read-bytes: [fn [let conn@WireguardConnection n@Int]
    [header:   [read conn.underlying 16]]
    [pkt-type: [get header 0]]
    [if [not [= pkt-type 4]] [error [str "WireGuard: unexpected packet type: " pkt-type]] null]
    [nonce12:  [concat [0 0 0 0] [slice 8 16 header]]]
    [ct:       [read conn.underlying [+ n 16]]]
    [match [chacha20-poly1305-open conn.rx-key nonce12 ct []]
      [Result.Ok plain]:    [slice 0 n plain]
      [Result.Error _]:     [error "WireGuard: decryption failed"]]]
]

# WgDataCodec: plaintext Bytes ↔ WireGuard data message Bytes (WireGuard §5.4.6).
# encode: encrypts plaintext with tx-key/tx-nonce counter; frames as type-4 data message.
#   Wire format: type(1)=4 reserved(3) receiver-index(4) nonce(8) ciphertext
# decode: validates type byte; extracts nonce from header; decrypts ciphertext with rx-key.
# Single-writer invariant on tx-nonce: do not encode concurrently (see WireguardConnection docstring).
[instance@[bind: [h]] Codec
  [let c@[WgDataCodec h] i@Bytes o@Bytes]:
  [encode: [fn [let codec@[WgDataCodec h] plaintext@Bytes]
    [conn: codec.conn]
    [match [recv conn.tx-nonce]
      [Closed.Closed]: [error "WgDataCodec.encode: tx-nonce channel closed"]
      [Result.Ok nonce]:
        [if [= nonce 18446744073709551615] [error "WgDataCodec.encode: nonce exhausted — rekey required"] null]
        [send conn.tx-nonce [+ nonce 1]]
        [nonce-bytes: [bytes ByteOrder.LittleEndian [@WgNonce nonce]]]
        [ciphertext:  [chacha20-poly1305-seal conn.tx-key [concat [0 0 0 0] nonce-bytes] plaintext []]]
        # type(1)=4, reserved(3)=0, receiver-index(4)=0 (simplified; index negotiated in handshake),
        # nonce(8) little-endian, ciphertext
        [concat [bytes 4] [0 0 0] [0 0 0 0] nonce-bytes ciphertext]]]
  decode: [fn [let codec@[WgDataCodec h] data@Bytes]
    [conn:    codec.conn]
    [pkt-type: [get data 0]]
    [if [not [= pkt-type 4]] [error [str "WgDataCodec.decode: expected type 4, got " pkt-type]] null]
    # nonce is bytes 8..16 (after type(1) reserved(3) receiver-index(4))
    [nonce12: [concat [0 0 0 0] [slice data 8 16]]]
    [ct:      [slice data 16 [length data]]]
    [match [chacha20-poly1305-open conn.rx-key nonce12 ct []]
      [Result.Ok plain]:    plain
      [Result.Error _]:     [error "WgDataCodec.decode: decryption failed"]]]]]

# ── WireguardLayer typeclass — bidirectional wireguard ────────────────────────
#
# wireguard takes config first (subject-last), then connection or channel:
#   Client: [connect %net Udp ep] | [wireguard cfg]    → WireguardConnection
#   Server: [udp-listen cap 51820] | quic | [wireguard cfg] | ...

[class [let WireguardLayer input output]
  wireguard: [Fn@output [WireguardConfig input]]]

# Client/Server single connection
[instance@[bind: [h]  constraint: [h: ByteStream]] WireguardLayer
  [let a@h b@[WireguardConnection h]]:
  [wireguard: [fn [let cfg@WireguardConfig h@h]
    [wireguard h cfg]]]]   # delegates to wireguard function (initiator, defined above)

# Channel of connections (server pipeline)
[instance@[bind: [h]  constraint: [h: ByteStream]] WireguardLayer
  [let a@[Channel h] b@[Channel [WireguardConnection h]]]:
  [wireguard: [fn [let cfg@WireguardConfig ch@[Channel h]]
    [channel-map [fn [let s@h] [wireguard-accept cfg s]] ch]]]]
