# stdlib/compress.llt — CompressionCodec typeclass + Rust-backed instances.
# Part of: lib-net-v3
# Rust backends: flate2 (gzip/deflate), brotli, zstd
# Bulk only — no streaming. Streaming through the thunk system is impractically slow for HTTP bodies.
#
# Extensibility: define [type [MyCodec]] + [instance [CompressionCodec MyCodec] ...],
# then pass [assoc [] "mycodec" [to-compressed-codec MyCodec]] as the registry argument
# to codec-for-encoding and negotiate-encoding.

[include %libdir "net.llt"]

[class [CompressionCodec c]
  encode:     [Fn [c@c b@Bytes] Bytes]            # compress; always succeeds
  decode:     [Fn [c@c b@Bytes] [Result Bytes]]   # decompress; Err if corrupt
  codec-name: [Fn [c@c] String]]                  # IANA/HTTP content-encoding name

[type [Gzip]]    [type [Deflate]]  [type [Brotli]]
[type [Zstd]]    [type [Identity]]

[instance [CompressionCodec Gzip]
  encode:     [fn [let _ b@Bytes] [builtin-gzip-encode b]]
  decode:     [fn [let _ b@Bytes] [builtin-gzip-decode b]]
  codec-name: [fn [let _] "gzip"]]

[instance [CompressionCodec Deflate]
  encode:     [fn [let _ b@Bytes] [builtin-deflate-encode b]]
  decode:     [fn [let _ b@Bytes] [builtin-deflate-decode b]]
  codec-name: [fn [let _] "deflate"]]

[instance [CompressionCodec Brotli]
  encode:     [fn [let _ b@Bytes] [builtin-brotli-encode b]]
  decode:     [fn [let _ b@Bytes] [builtin-brotli-decode b]]
  codec-name: [fn [let _] "br"]]

[instance [CompressionCodec Zstd]
  encode:     [fn [let _ b@Bytes] [builtin-zstd-encode b]]
  decode:     [fn [let _ b@Bytes] [builtin-zstd-decode b]]
  codec-name: [fn [let _] "zstd"]]

[instance [CompressionCodec Identity]
  encode:     [fn [let _ b@Bytes] b]
  decode:     [fn [let _ b@Bytes] [Ok b]]
  codec-name: [fn [let _] "identity"]]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  # Built-in codec lookup — checked after user registry in codec-for-encoding.
  builtin-codec-for-name: [fn [let lower@String]
    [match lower
      "gzip":     [Some [to-compressed-codec Gzip]]
      "deflate":  [Some [to-compressed-codec Deflate]]
      "br":       [Some [to-compressed-codec Brotli]]
      "brotli":   [Some [to-compressed-codec Brotli]]
      "zstd":     [Some [to-compressed-codec Zstd]]
      "identity": [Some [to-compressed-codec Identity]]
      "*":        [Some [to-compressed-codec Gzip]]    # wildcard prefers gzip
      _:          [None]]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # CompressedBytes: labeled bytes with their codec stored at runtime.
  CompressedBytes: [type [data: Bytes  codec: CompressedCodec]]

  # CompressedCodec: runtime record for dynamic dispatch (analogous to Codec in text.llt).
  # Needed when the codec is determined at runtime (e.g. from HTTP Content-Encoding header).
  CompressedCodec: [type
    [name:   String
     encode: [Fn [Bytes] Bytes]
     decode: [Fn [Bytes] [Result Bytes]]]]

  # Convert any CompressionCodec typeclass instance to a runtime CompressedCodec record.
  # Use this to register custom codecs:
  #   my-lz4: [to-compressed-codec Lz4]
  #   registry: [assoc [] "lz4" my-lz4]
  to-compressed-codec: [fn@[bind: [c]  return: CompressedCodec  constraint: [c: CompressionCodec]]
                          [let c@c]
    [CompressedCodec
      [name:   [codec-name c]
       encode: [fn [let b] [encode c b]]
       decode: [fn [let b] [decode c b]]]]]

  # Compile-time dispatch: encode/decode via typeclass.
  encode: [fn@[bind: [c]  return: Bytes         constraint: [c: CompressionCodec]] [let c@c b@Bytes] [encode c b]]
  decode: [fn@[bind: [c]  return: [Result Bytes] constraint: [c: CompressionCodec]] [let c@c b@Bytes] [decode c b]]

  # Runtime dispatch via CompressedCodec record.
  encode-compressed: [fn [let c@CompressedCodec b@Bytes] [c.encode b]]
  decode-compressed: [fn [let c@CompressedCodec b@Bytes] [c.decode b]]

  # Look up a codec by its HTTP Content-Encoding name.
  # registry: user-supplied [Map String CompressedCodec]; checked before built-ins.
  # Returns [Some CompressedCodec] or [None].
  codec-for-encoding: [fn [let name@String  registry@[type: [Map String CompressedCodec]  default: []]]
    [lower: [str-lower name]]
    [or
      [get? registry lower]
      [builtin-codec-for-name lower]]]

  # Pick the best codec from an Accept-Encoding header value.
  # registry: same as codec-for-encoding — pass your custom codecs here.
  # Returns a CompressedCodec (defaults to Identity if nothing in header matches).
  negotiate-encoding: [fn [let accept-encoding@String  registry@[type: [Map String CompressedCodec]  default: []]]
    [candidates: [filter-map [fn [let part]
                   [codec-for-encoding [str-trim [get [str-split ";" part] 0]] registry]]
                 [str-split "," accept-encoding]]]
    [if [empty? candidates]
      [to-compressed-codec Identity]
      [get candidates 0]]]
]
