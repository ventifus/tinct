# stdlib/compress.llt — CompressionCodec typeclass + Rust-backed instances.
# Part of: lib-net-v3
# Rust backends: flate2 (gzip/deflate), brotli, zstd
#
# CompressionCodec refines the general Codec typeclass (Codec Bytes Bytes)
# with an additional codec-name method for HTTP content-encoding negotiation.
#
# Extensibility: define [type [MyCodec]] + [instance [Codec MyCodec Bytes Bytes] ...] +
# [instance [CompressionCodec MyCodec] codec-name: [fn [let _] "my-codec"]],
# then pass [merge [] ["my-codec": [to-compressed-codec MyCodec]]] as the registry
# argument to codec-for-encoding and negotiate-encoding.
--- uses: ["compress"]

[include %libdir "net.llt"]

# CompressionCodec refines Codec Bytes Bytes with an HTTP content-encoding name.
# Superclass constraint [Codec c Bytes Bytes] is positional per class declaration syntax.
[class [let CompressionCodec c] [Codec c Bytes Bytes]
  codec-name: [Fn [c@c] String]]

[type [GzipCodec]] [type [DeflateCodec]] [type [BrotliCodec]]
[type [ZstdCodec]] [type [IdentityCodec]]

[instance Codec
  [let a@GzipCodec b@Bytes c@Bytes]: [encode: [fn [let _ b] [builtin-gzip-encode b]]
                                       decode: [fn [let _ b@Bytes offset@Integer]
                                         [buf: [slice b offset [length b]]]
                                         [value: [builtin-gzip-decode buf]  next: [length b]]]]]
[instance CompressionCodec
  [let h@GzipCodec]: [codec-name: [fn [let _] "gzip"]]]

[instance Codec
  [let a@DeflateCodec b@Bytes c@Bytes]: [encode: [fn [let _ b] [builtin-deflate-encode b]]
                                          decode: [fn [let _ b@Bytes offset@Integer]
                                            [buf: [slice b offset [length b]]]
                                            [value: [builtin-deflate-decode buf]  next: [length b]]]]]
[instance CompressionCodec
  [let h@DeflateCodec]: [codec-name: [fn [let _] "deflate"]]]

[instance Codec
  [let a@BrotliCodec b@Bytes c@Bytes]: [encode: [fn [let _ b] [builtin-brotli-encode b]]
                                         decode: [fn [let _ b@Bytes offset@Integer]
                                           [buf: [slice b offset [length b]]]
                                           [value: [builtin-brotli-decode buf]  next: [length b]]]]]
[instance CompressionCodec
  [let h@BrotliCodec]: [codec-name: [fn [let _] "br"]]]

[instance Codec
  [let a@ZstdCodec b@Bytes c@Bytes]: [encode: [fn [let _ b] [builtin-zstd-encode b]]
                                       decode: [fn [let _ b@Bytes offset@Integer]
                                         [buf: [slice b offset [length b]]]
                                         [value: [builtin-zstd-decode buf]  next: [length b]]]]]
[instance CompressionCodec
  [let h@ZstdCodec]: [codec-name: [fn [let _] "zstd"]]]

[instance Codec
  [let a@IdentityCodec b@Bytes c@Bytes]: [encode: [fn [let _ b] b]
                                           decode: [fn [let _ b@Bytes offset@Integer]
                                             [value: [slice b offset [length b]]  next: [length b]]]]]
[instance CompressionCodec
  [let h@IdentityCodec]: [codec-name: [fn [let _] "identity"]]]

# ── Internal. ────────────────────────────────────────────────────────────────

[
  to-compressed-codec: [fn@[bind: [c]  return: CompressedCodec
                            constraint: [[c: Codec Bytes Bytes] [c: CompressionCodec]]]
                         [let c@c]
    [CompressedCodec
      [name:   [codec-name c]
       encode: [fn [let b] [encode c b]]
       decode: [fn [let b] [decode c b 0].value]]]]   # CompressedCodec.decode → whole-buffer; pass offset=0, extract value

  # Hardcoded codec registry — temporary pending R-12 (open nominal ADTs / typeclass instance
  # enumeration). Once [instance [CompressionCodec X] ...] declarations can be enumerated
  # at runtime, this becomes:
  #   [first [filter [fn [let c] [= [codec-name c] lower]] CompressionCodec.instances]]
  # Users adding custom codecs currently pass them via the `registry` argument to
  # codec-for-encoding; with R-12 they would just declare an instance and it would be found.
  builtin-codec-for-name: [fn [let lower@String]
    [match lower
      "gzip":     [to-compressed-codec GzipCodec]
      "deflate":  [to-compressed-codec DeflateCodec]
      "br":       [to-compressed-codec BrotliCodec]
      "brotli":   [to-compressed-codec BrotliCodec]
      "zstd":     [to-compressed-codec ZstdCodec]
      "identity": [to-compressed-codec IdentityCodec]
      "*":        [to-compressed-codec GzipCodec]
      ...:          []]]
]

# ── Public API. ───────────────────────────────────────────────────────────────

[
  # CompressedCodec: a runtime record for dynamic dispatch (e.g. from HTTP headers).
  # For static dispatch, use the Codec typeclass instances directly.
  CompressedCodec: [type
    [name:   String
     encode: [Fn [Bytes] Bytes]
     decode: [Fn [Bytes] Bytes]]]

  to-compressed-codec: to-compressed-codec

  # Compose a CompressionCodec into a codec-stream pipeline.
  # Applies compression to each chunk as it flows through the stream.
  # Subject-last: byte-sink is last so this works as a pipeline stage.
  compression-codec-stream: [fn@[bind: [c]] [let c@[CompressionCodec c] source byte-sink]
    [source | [codec c] | [sink byte-sink]]]

  # HTTP content negotiation.
  codec-for-encoding: [fn [let name@String  registry@[type: [Map String CompressedCodec]  default: []]]
    [lower: [lower name]]
    [or [get? registry lower] [builtin-codec-for-name lower]]]

  negotiate-encoding: [fn [let accept-encoding@String  registry@[type: [Map String CompressedCodec]  default: []]]
    [candidates: [filter [fn [let c] [not [null? c]]]
                   [map [fn [let part]
                     [codec-for-encoding [str-trim [get [str-split ";" part] 0]] registry]]
                   [str-split "," accept-encoding]]]]
    [if [empty? candidates]
      [to-compressed-codec IdentityCodec]
      [get candidates 0]]]
]
