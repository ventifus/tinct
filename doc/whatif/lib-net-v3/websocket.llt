# stdlib/protocols/websocket.llt — WebSocket (RFC 6455) in tinct.
# Part of: lib-net-v3
# Rust primitives: sha1, crypto-random, bytes-xor
--- uses: ["crypto"]

[include %libdir "net.llt"]
[include %include-dir "http1.llt"]

[instance MessageStream
  [let a@WebSocketConnection b@WsFrame]: [send: ws-send-frame    # encodes as WS frame, applies mask (client), writes to underlying
                                          recv: ws-recv-frame]]   # reads from underlying, strips WS framing + mask, returns [Result.Ok WsFrame] | Closed.Closed

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  # Verified: get?=✓ (core builtin)
  bytes-xor-mask: [fn [let data@Bytes key@Bytes]
    [collect [map [fn [let e] [bxor e.1 [get key [mod e.0 4]]]] [entries data]]]]

  # Construct a WsFrame from a wire opcode and payload bytes.
  # WsFrame variants carry opcode as a compile-time constant; construction still needs payload dispatch.
  int->ws-frame: [fn [let opcode@Int payload@Bytes]
    [match opcode
      WsFrame.Continuation.opcode: [WsFrame.Continuation payload]
      WsFrame.Text.opcode:         [WsFrame.Text   [bytes-str payload]]
      WsFrame.Binary.opcode:       [WsFrame.Binary payload]
      WsFrame.Close.opcode:        [WsFrame.Close
                                      [@WsCloseCode [if [>= [length payload] 2] [uint16 NetworkEndian [slice payload 0 2]] 1000]]
                                      [if [> [length payload] 2] [bytes-str [slice payload 2 [length payload]]] ""]]
      WsFrame.Ping.opcode:         [WsFrame.Ping   payload]
      WsFrame.Pong.opcode:         [WsFrame.Pong   payload]
      _:                           [error [str "WebSocket: unknown opcode: " opcode]]]]

  # Extract opcode and payload bytes from a WsFrame for wire encoding.
  # frame.opcode accesses the compile-time constant on whichever variant frame is — no match needed.
  ws-frame->opcode-payload: [fn [let frame@WsFrame]
    [opcode: frame.opcode]
    [payload: [match frame
      [WsFrame.Continuation p]:     p.data
      [WsFrame.Text   p]:            [str-bytes p.data]
      [WsFrame.Binary p]:            p.data
      [WsFrame.Close  p]:            [concat [bytes NetworkEndian p.code] [str-bytes p.reason]]
      [WsFrame.Ping   p]:            p.data
      [WsFrame.Pong   p]:            p.data]]
    [opcode: opcode  payload: payload]]

  # RFC 4648 §4 Base64 encoding. Used for Sec-WebSocket-Accept: sha1(key + guid) | base64.
  base64-encode: [fn [let data@Bytes]
    [alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"]
    [len: [length data]]
    [pad: [mod [- [* 3 [/ [+ len 2] 3]] len] 3]]   # bytes of zero-padding needed
    [padded: [concat data [slice [0 0 0] 0 pad]]]    # zero-pad to multiple of 3
    [n-groups: [/ [length padded] 3]]
    [chars: [apply str [flat-map [fn [let i]
      [b0: [get padded [* i 3]]  b1: [get padded [+ [* i 3] 1]]  b2: [get padded [+ [* i 3] 2]]]
      [n: [+ [shl b0 16] [shl b1 8] b2]]
      [list
        [str-char [get alphabet [shr [band n 0xFC0000] 18]]]
        [str-char [get alphabet [shr [band n 0x03F000] 12]]]
        [str-char [get alphabet [shr [band n 0x000FC0]  6]]]
        [str-char [get alphabet      [band n 0x00003F]    ]]]]
     [range 0 n-groups]]]]
    # Replace trailing chars with = padding per RFC 4648 §4
    [replace-end: [fn [let s n] [str [slice-str s 0 [- [length s] n]] [str-repeat "=" n]]]]
    [match pad 0: chars  1: [replace-end chars 1]  _: [replace-end chars 2]]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # RFC 6455 §7.4.2: valid close status codes are 1000–2999 (IANA), 3000–3999 (libraries),
  # 4000–4999 (private use). Codes 0–999 and 5000+ are prohibited in Close frames.
  WsCloseCode: [type Int@[is: [between 1000 4999]  repr: u16  encoding: NetworkEndian]]

  WsFrame: [type
    [Text         opcode: 0x01  data@String]
    [Binary       opcode: 0x02  data@Bytes]
    [Close        opcode: 0x08  code@WsCloseCode  reason@String]
    [Ping         opcode: 0x09  data@Bytes]
    [Pong         opcode: 0x0A  data@Bytes]
    [Continuation opcode: 0x00  data@Bytes]]   # RFC 6455 §5.4: continuation frame for fragmented messages

  WebSocketConnection: [type
    [underlying:  Handle
     server-side: Bool]]

  # WsFrameCodec: codec for WebSocket frame wire format (RFC 6455 §5).
  # client-side: Bool — true applies masking on encode (client→server); false skips mask (server→client).
  # encode: WsFrame → framed Bytes (FIN=1 | opcode, len, [mask-key], [masked] payload)
  # decode: framed Bytes → WsFrame (strips framing, unmasks payload, dispatches by opcode)
  # Errors surface as tinct runtime errors (not [or WsFrame WsError]).
  WsFrameCodec: [type [client-side: Bool]]

  # WebSocket error type — distinct from normal Close frame (WsFrame.Close = graceful peer closure).
  WsError: [type
    [ConnectionClosed]                           # underlying TCP connection closed without WS Close frame
    [ProtocolViolation  reason@String]            # RFC 6455 protocol error (bad opcode, reserved bits, etc.)
    [MessageTooLarge    size@Int  limit@Int]      # payload exceeds implementation limit
    [MaskingViolation]]                           # client sent unmasked / server sent masked frame

  ws-accept: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [ws-accept-request h [parse-request h [fn [let _] null]]]]

  ws-accept-request: [fn@[bind: [h]  constraint: [h: ByteStream]]
                       [let h@h req@RawRequest]
    [if [not [= [lower [or [get? req.headers "upgrade"] ""]] "websocket"]]
      [error "WebSocket: missing Upgrade: websocket"]]
    [key: [let raw: [get? req.headers "sec-websocket-key"]]
          [if [null? raw] [error "WebSocket: missing Sec-WebSocket-Key"] raw]]
    [accept-key: [base64-encode [sha1 [str-bytes [str key "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"]]]]]
    [write-response h
      [RawResponse
        [status: 101
         headers: ["upgrade":               "websocket"
                   "connection":            "Upgrade"
                   "sec-websocket-accept":  accept-key]
         body: []]]]
    [WebSocketConnection [underlying: h  server-side: true]]]

  ws: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h host@String path@String]
    [key: [base64-encode [crypto-random 16]]]
    [http1-request h "GET" path
      ["upgrade":               "websocket"
       "connection":            "Upgrade"
       "sec-websocket-key":     key
       "sec-websocket-version": "13"]
      [] host]
    [WebSocketConnection [underlying: h  server-side: false]]]

  ws-recv-frame: [fn@[return: [or WsFrame WsError]] [let conn@WebSocketConnection]
    # Returns WsFrame on success, WsError on failure. WsFrame.Close = graceful peer close.
    [match [try [read conn.underlying 1]]
      [Result.Error _]: WsError.ConnectionClosed
      [Result.Ok b0-bytes]:
        [h:    conn.underlying]
        [b0:   [get b0-bytes 0]]
        [b1:   [get [read h 1] 0]]
        [opcode: [band b0 0x0F]]
        [masked: [= [band b1 0x80] 0x80]]
        [len1:   [band b1 0x7F]]
        # RFC 6455 §5.1: server MUST reject unmasked client frames; client MUST reject masked server frames.
        [if [and conn.server-side [not masked]] [error "WebSocket: client frame must be masked (RFC 6455 §5.1)"] null]
        [if [and [not conn.server-side] masked] [error "WebSocket: server frame must not be masked (RFC 6455 §5.1)"] null]
        [payload-len: [match len1
          126: [let lb: [read h 2]  [+ [* [get lb 0] 256] [get lb 1]]]   # one 2-byte read
          127: [error "WebSocket: 64-bit frame lengths not supported (max 65535 bytes)"]
          _:   len1]]
        [mask-key: [if masked [read h 4] []]]
        [raw:      [read h payload-len]]
        [payload:  [if masked [bytes-xor-mask raw mask-key] raw]]
        # FIN bit (0x80 in b0) indicates final frame; continuation frames have FIN=0 until the last one
        [int->ws-frame opcode payload]]]]

  ws-send-frame: [fn [let conn@WebSocketConnection frame@WsFrame]
    [h:       conn.underlying]
    [client:  [not conn.server-side]]
    [result:  [ws-frame->opcode-payload frame]]
    [opcode:  result.opcode]
    [payload: result.payload]
    [len:     [length payload]]
    [mask-bit: [if client 0x80 0x00]]
    [len-bytes: [if [<= len 125]
      [bytes [bor len mask-bit]]
      [concat [bytes [bor 126 mask-bit]] [bytes [/ len 256]] [bytes [mod len 256]]]]]
    [mask-key:       [if client [crypto-random 4] []]]
    [masked-payload: [if client [bytes-xor-mask payload mask-key] payload]]
    [write h [concat [bytes [bor 0x80 opcode]] len-bytes mask-key masked-payload]]]

  # ws-recv-message: read a complete WebSocket message, reassembling continuation frames.
  # RFC 6455 §5.4: fragmented messages consist of a starting frame (Text/Binary with FIN=0)
  # followed by 0+ Continuation frames (opcode 0x00), ending with a frame with FIN=1.
  # Returns the complete reassembled message as a single WsFrame (Text or Binary).
  # Control frames (Close/Ping/Pong) cannot be fragmented and are returned immediately.
  ws-recv-message: [fn@[return: [or WsFrame WsError]] [let conn@WebSocketConnection]
    [ws-recv-message-impl conn [] null]]

  # ws-recv-message-impl: accumulator-based reassembly loop.
  # fragments: [Seq Bytes] — accumulated payloads from continuation frames
  # msg-type: [or Int Null] — opcode of the starting frame (Text=0x01 or Binary=0x02)
  ws-recv-message-impl: [fn [let conn@WebSocketConnection fragments@[Seq Bytes] msg-type@[or Int Null]]
    [h: conn.underlying]
    [match [try [read h 1]]
      [Result.Error _]: WsError.ConnectionClosed
      [Result.Ok b0-bytes]:
        [b0:   [get b0-bytes 0]]
        [b1:   [get [read h 1] 0]]
        [fin:  [= [band b0 0x80] 0x80]]
        [opcode: [band b0 0x0F]]
        [masked: [= [band b1 0x80] 0x80]]
        [len1:   [band b1 0x7F]]
        [if [and conn.server-side [not masked]] [error "WebSocket: client frame must be masked"] null]
        [if [and [not conn.server-side] masked] [error "WebSocket: server frame must not be masked"] null]
        [payload-len: [match len1
          126: [let lb: [read h 2]  [+ [* [get lb 0] 256] [get lb 1]]]
          127: [error "WebSocket: 64-bit frame lengths not supported"]
          _:   len1]]
        [mask-key: [if masked [read h 4] []]]
        [raw:      [read h payload-len]]
        [payload:  [if masked [bytes-xor-mask raw mask-key] raw]]
        # Dispatch by opcode
        [match opcode
          0x00:   # Continuation frame
            [if [null? msg-type]
              WsError.ProtocolViolation reason: "Continuation frame without starting frame"
              [if fin
                # Final continuation — reassemble and return
                [full-payload: [reduce concat [] [append fragments [list payload]]]]
                [match msg-type
                  0x01: [WsFrame.Text [bytes-str full-payload]]
                  0x02: [WsFrame.Binary full-payload]
                  _:    [error "WebSocket: invalid msg-type in reassembly"]]
                # Non-final continuation — accumulate and recurse
                [ws-recv-message-impl conn [append fragments [list payload]] msg-type]]]
          0x01:   # Text frame
            [if [null? msg-type]
              [if fin
                [WsFrame.Text [bytes-str payload]]   # Non-fragmented Text
                [ws-recv-message-impl conn [list payload] 0x01]]   # Start fragmented Text
              WsError.ProtocolViolation reason: "Text frame in middle of fragmented message"]
          0x02:   # Binary frame
            [if [null? msg-type]
              [if fin
                [WsFrame.Binary payload]   # Non-fragmented Binary
                [ws-recv-message-impl conn [list payload] 0x02]]   # Start fragmented Binary
              WsError.ProtocolViolation reason: "Binary frame in middle of fragmented message"]
          0x08:   # Close (control frames cannot be fragmented)
            [WsFrame.Close
              [@WsCloseCode [if [>= [length payload] 2] [uint16 NetworkEndian [slice payload 0 2]] 1000]]
              [if [> [length payload] 2] [bytes-str [slice payload 2 [length payload]]] ""]]
          0x09:   # Ping
            [WsFrame.Ping payload]
          0x0A:   # Pong
            [WsFrame.Pong payload]
          _: [error [str "WebSocket: unknown opcode: " opcode]]]]]

  # Serve layer: promote each incoming Handle to a WebSocketConnection.
  ws-serve: [_ | [channel-map ws-accept]]
]

# WsFrameCodec: WsFrame ↔ Bytes (RFC 6455 §5 frame wire format).
# encode: serializes WsFrame to framed bytes; applies masking when codec.client-side is true.
# decode: parses framed bytes to WsFrame; unmasks payload when mask bit is set.
# Errors (protocol violations, unknown opcodes) surface as tinct runtime errors.
[instance Codec
  [let a@WsFrameCodec b@WsFrame c@Bytes]: [encode: [fn [let codec@WsFrameCodec frame@WsFrame]
    [result:  [ws-frame->opcode-payload frame]]
    [opcode:  result.opcode]
    [payload: result.payload]
    [len:     [length payload]]
    [client:  codec.client-side]
    [mask-bit: [if client 0x80 0x00]]
    [len-bytes: [if [<= len 125]
      [bytes [bor len mask-bit]]
      [concat [bytes [bor 126 mask-bit]] [bytes [/ len 256]] [bytes [mod len 256]]]]]
    [mask-key:       [if client [crypto-random 4] []]]
    [masked-payload: [if client [bytes-xor-mask payload mask-key] payload]]
    [concat [bytes [bor 0x80 opcode]] len-bytes mask-key masked-payload]]
  decode: [fn [let _ data@Bytes offset@Int]
    [b0:     [get data [+ offset 0]]]
    [b1:     [get data [+ offset 1]]]
    [opcode: [band b0 0x0F]]
    [masked: [= [band b1 0x80] 0x80]]
    [len1:   [band b1 0x7F]]
    [hdr-end: [+ offset [if [= len1 126] 4 [if [= len1 127] [error "WsFrameCodec: 64-bit lengths not supported"] 2]]]]
    [payload-len: [match len1
      126: [+ [* [get data [+ offset 2]] 256] [get data [+ offset 3]]]
      127: [error "WsFrameCodec: 64-bit frame lengths not supported"]
      _:   len1]]
    [mask-key: [if masked [slice data hdr-end [+ hdr-end 4]] []]]
    [data-off: [if masked [+ hdr-end 4] hdr-end]]
    [raw:      [slice data data-off [+ data-off payload-len]]]
    [payload:  [if masked [bytes-xor-mask raw mask-key] raw]]
    [value: [int->ws-frame opcode payload]
     next:  [+ data-off payload-len]]]]]
