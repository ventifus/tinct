# stdlib/protocols/websocket.llt — WebSocket (RFC 6455) in tinct.
# Part of: lib-net-v3
# Rust primitives: sha1, crypto-random, bytes-xor

[include %libdir "net.llt"]
[include %include-dir "http1.llt"]

[instance [MessageStream WebSocketConnection WsFrame]
  send-message: ws-send-frame
  recv-message: ws-recv-frame]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  bytes-xor-mask: [fn [let data@Bytes key@Bytes]
    [collect [map-indexed [fn [let i b] [bit-xor b [get key [mod i 4]]]] data]]]

  int->ws-frame: [fn [let opcode@Int payload@Bytes]
    [match opcode
      1:  [Text   [bytes-str payload]]
      2:  [Binary payload]
      8:  [Close  [if [>= [length payload] 2]
                    [+ [* [get payload 0] 256] [get payload 1]] 1000]
                  [if [> [length payload] 2] [bytes-str [slice payload 2 [- [length payload] 2]]] ""]]
      9:  [Ping   payload]
      10: [Pong   payload]
      _:  [error [str "WebSocket: unknown opcode: " opcode]]]]

  ws-frame->opcode-payload: [fn [let frame@WsFrame]
    [match frame
      [let [Text   s]]:            [1  [str-bytes s]]
      [let [Binary b]]:            [2  b]
      [let [Close  code reason]]:  [8  [concat [encode BigEndian [@UInt16 code]] [str-bytes reason]]]
      [let [Ping   b]]:            [9  b]
      [let [Pong   b]]:            [10 b]]]

  base64-encode: [fn [let data@Bytes] [error "TODO: base64-encode — RFC 4648 §4"]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  WsFrame: [union
    [Text   data@String]
    [Binary data@Bytes]
    [Ping   data@Bytes]
    [Pong   data@Bytes]
    [Close  code@Int  reason@String]]

  WebSocketConnection: [type
    [underlying:  Handle
     server-side: Bool]]

  ws-accept: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [ws-accept-request h [parse-request h [fn [let _] null]]]]

  ws-accept-request: [fn@[bind: [h]  constraint: [h: ByteStream]]
                       [let h@h req@RawRequest]
    [if [not [= [str-lower [or [get? req.headers "upgrade"] ""]] "websocket"]]
      [error "WebSocket: missing Upgrade: websocket"]]
    [key: [match [get? req.headers "sec-websocket-key"]
      [Some k]: k
      [None]:   [error "WebSocket: missing Sec-WebSocket-Key"]]]
    [accept-key: [base64-encode [sha1 [str-bytes [str key "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"]]]]]
    [write-response h
      [RawResponse
        [status: 101
         headers: [map-from-pairs
           [["upgrade"              "websocket"]
            ["connection"          "Upgrade"]
            ["sec-websocket-accept" accept-key]]]
         body: []]]]
    [WebSocketConnection [underlying: h  server-side: true]]]

  ws-connect: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h host@String path@String]
    [key: [base64-encode [crypto-random 16]]]
    [http1-request h "GET" path
      [map-from-pairs
        [["upgrade"               "websocket"]
         ["connection"            "Upgrade"]
         ["sec-websocket-key"     key]
         ["sec-websocket-version" "13"]]]
      [] host]
    [WebSocketConnection [underlying: h  server-side: false]]]

  ws-recv-frame: [fn [let conn@WebSocketConnection]
    [h:    conn.underlying]
    [b0:   [get [read-bytes h 1] 0]]
    [b1:   [get [read-bytes h 1] 0]]
    [opcode: [bit-and b0 0x0F]]
    [masked: [= [bit-and b1 0x80] 0x80]]
    [len1:   [bit-and b1 0x7F]]
    # RFC 6455 §5.1: server MUST reject unmasked client frames; client MUST reject masked server frames.
    [if [and conn.server-side [not masked]] [error "WebSocket: client frame must be masked (RFC 6455 §5.1)"] null]
    [if [and [not conn.server-side] masked] [error "WebSocket: server frame must not be masked (RFC 6455 §5.1)"] null]
    [payload-len: [match len1
      126: [let lb: [read-bytes h 2]  [+ [* [get lb 0] 256] [get lb 1]]]   # one 2-byte read
      127: [error "WebSocket: 64-bit frame lengths not supported (max 65535 bytes)"]
      _:   len1]]
    [mask-key: [if masked [read-bytes h 4] []]]
    [raw:      [read-bytes h payload-len]]
    [payload:  [if masked [bytes-xor-mask raw mask-key] raw]]
    [if [not [= [bit-and b0 0x80] 0x80]] [error "WebSocket: fragmented frames not supported"] null]
    [int->ws-frame opcode payload]]

  ws-send-frame: [fn [let conn@WebSocketConnection frame@WsFrame]
    [h:      conn.underlying]
    [client: [not conn.server-side]]
    [opcode payload: [ws-frame->opcode-payload frame]]
    [len:    [length payload]]
    [mask-bit: [if client 0x80 0x00]]
    [len-bytes: [if [<= len 125]
      [bytes [bit-or len mask-bit]]
      [concat [bytes [bit-or 126 mask-bit]] [bytes [/ len 256]] [bytes [mod len 256]]]]]
    [mask-key:       [if client [crypto-random 4] []]]
    [masked-payload: [if client [bytes-xor-mask payload mask-key] payload]]
    [write-bytes h [concat [bytes [bit-or 0x80 opcode]] len-bytes mask-key masked-payload]]]
]
