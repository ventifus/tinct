# stdlib/protocols/http2.llt — HTTP/2 (RFC 7540) + HPACK (RFC 7541) in tinct.
# Part of: lib-net-v3

[include %libdir "net.llt"]
[include %include-dir "tls13.llt"]   # for PendingTlsHandle, tls-commit, with-tls-alpn
[include %include-dir "http1.llt"]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  int->h2-frame-type: [fn [let n@Int]
    [match n
      0: [H2Data]  1: [H2Headers]    2: [H2Priority]  3: [H2RstStream]
      4: [H2Settings]  5: [H2PushPromise]  6: [H2Ping]  7: [H2Goaway]
      8: [H2WindowUpdate]  9: [H2Continuation]
      _: [error [str "HTTP/2: unknown frame type: " n]]]]

  h2-frame-type->int: [fn [let t@H2FrameType]
    [match t
      [H2Data]: 0  [H2Headers]: 1  [H2Priority]: 2  [H2RstStream]: 3
      [H2Settings]: 4  [H2PushPromise]: 5  [H2Ping]: 6  [H2Goaway]: 7
      [H2WindowUpdate]: 8  [H2Continuation]: 9]]

  read-h2-frame: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [header:  [read-bytes h 9]]
    [len:     [+ [+ [* [get header 0] 65536] [* [get header 1] 256]] [get header 2]]]
    [sid:     [bit-and [+ [+ [+ [* [get header 5] 16777216]
                               [* [get header 6] 65536]]
                            [* [get header 7] 256]]
                         [get header 8]]
                0x7FFFFFFF]]
    [H2Frame [type: [int->h2-frame-type [get header 3]]
              flags: [get header 4]  stream-id: sid
              payload: [read-bytes h len]]]]

  write-h2-frame: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h frame@H2Frame]
    [len: [length frame.payload]]
    [write-bytes h
      [concat
        [bytes [/ [/ len 256] 256]]
        [bytes [mod [/ len 256] 256]]
        [bytes [mod len 256]]
        [bytes [h2-frame-type->int frame.type]]
        [bytes frame.flags]
        [bytes [/ frame.stream-id 16777216]]           # byte 0: sid >> 24
        [bytes [mod [/ frame.stream-id 65536] 256]]    # byte 1: (sid >> 16) & 0xFF
        [bytes [mod [/ frame.stream-id 256]   256]]    # byte 2: (sid >> 8)  & 0xFF
        [bytes [mod frame.stream-id 256]]              # byte 3:  sid        & 0xFF
        frame.payload]]]

  # HPACK static table (RFC 7541 Appendix A) — 61 entries, indexed 1–61.
  hpack-static-table: [
    [":authority" null]              [":method" "GET"]               [":method" "POST"]
    [":path" "/"]                   [":path" "/index.html"]          [":scheme" "http"]
    [":scheme" "https"]             [":status" "200"]                [":status" "204"]
    [":status" "206"]               [":status" "304"]                [":status" "400"]
    [":status" "404"]               [":status" "500"]                ["accept-charset" null]
    ["accept-encoding" "gzip, deflate"]  ["accept-language" null]    ["accept-ranges" null]
    ["accept" null]                 ["access-control-allow-origin" null]  ["age" null]
    ["allow" null]                  ["authorization" null]           ["cache-control" null]
    ["content-disposition" null]    ["content-encoding" null]        ["content-language" null]
    ["content-length" null]         ["content-location" null]        ["content-range" null]
    ["content-type" null]           ["cookie" null]                  ["date" null]
    ["etag" null]                   ["expect" null]                  ["expires" null]
    ["from" null]                   ["host" null]                    ["if-match" null]
    ["if-modified-since" null]      ["if-none-match" null]           ["if-range" null]
    ["if-unmodified-since" null]    ["last-modified" null]           ["link" null]
    ["location" null]               ["max-forwards" null]            ["proxy-authenticate" null]
    ["proxy-authorization" null]    ["range" null]                   ["referer" null]
    ["refresh" null]                ["retry-after" null]             ["server" null]
    ["set-cookie" null]             ["strict-transport-security" null]  ["transfer-encoding" null]
    ["user-agent" null]             ["vary" null]                    ["via" null]
    ["www-authenticate" null]]

  hpack-add-to-table: [fn [let table@HpackTable name@String value@String]
    [entry-size: [+ [+ [length [str-bytes name]] [length [str-bytes value]]] 32]]
    [error "TODO: hpack-add-to-table — evict oldest entries until size fits, prepend new entry"]]
]

# HttpConnect instance for Http2Connection.
[instance [HttpConnect Http2Connection]
  request: request]

# HPACK codec: Headers ↔ Bytes (encode headers as HPACK; decode HPACK bytes to headers).
# Note: hpack-encode/hpack-decode take HpackTable as the codec instance (dynamic table state).
[instance [Codec HpackCodec Headers Bytes]
  encode: hpack-encode
  decode: hpack-decode]

# HTTP/2 frame codec: H2Frame ↔ Bytes (serialize/parse the 9-byte frame header + payload).
[instance [Codec H2FrameCodec H2Frame Bytes]
  encode: h2-frame-serialize
  decode: h2-frame-parse]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  H2FrameType: [union
    [H2Data] [H2Headers] [H2Priority] [H2RstStream] [H2Settings]
    [H2PushPromise] [H2Ping] [H2Goaway] [H2WindowUpdate] [H2Continuation]]

  H2Frame: [type
    [type:      H2FrameType
     flags:     Int
     stream-id: Int
     payload:   Bytes]]

  HpackTable: [type
    [entries:  [Seq [Seq [or String Null]]]   # [name value] pairs; value null for name-only static entries
     size:     Int
     max-size: Int]]

  H2Stream: [type
    [id:         Int
     send-window:[Channel Int]
     recv-ch:    [Channel Bytes]
     headers-ch: [Channel [Map String String]]]]

  Http2Connection: [type
    [handle:      Handle
     streams:     [Map Int H2Stream]
     hpack-send:  HpackTable
     hpack-recv:  HpackTable
     next-stream: [Channel Int]
     send-window: [Channel Int]
     recv-window: [Channel Int]
     settings:    [Map String Int]]]

  hpack-decode: [fn [let table@HpackTable data@Bytes]
    [error "TODO: hpack-decode — integer decoding (RFC 7541 §5.1), Huffman decoding (§5.2), indexed/literal field representations (§6)"]]

  hpack-encode: [fn [let table@HpackTable headers@[Map String String]]
    [error "TODO: hpack-encode — literal without indexing for safety; indexed references for static table hits"]]

  hpack-huffman-decode: [fn [let data@Bytes]
    [error "TODO: hpack-huffman-decode — 30-bit code table (RFC 7541 Appendix B), bit accumulation, EOS detection"]]

  # Codec instance methods for H2FrameCodec (serialize/parse H2Frame ↔ Bytes).
  # These wrap the internal read-h2-frame/write-h2-frame helpers for use as Codec instances.
  h2-frame-serialize: [fn [let _ frame@H2Frame]
    [error "TODO: h2-frame-serialize — delegate to write-h2-frame, return Bytes"]]

  h2-frame-parse: [fn [let _ data@Bytes]
    [error "TODO: h2-frame-parse — delegate to read-h2-frame, return H2Frame"]]

  h2-accept: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [error "TODO: h2-accept — read client preface, exchange SETTINGS, return Http2Connection"]]

  # h2: fires TLS with alpn: ["h2"] via tls-commit, then H2 preface.
  h2: [fn [let pth@PendingTlsHandle]
    [conn: [tls-commit [with-tls-alpn pth ["h2"]]]]
    [error "TODO: h2 — send client preface, exchange SETTINGS → Http2Connection"]]

  request: [fn [let req@RawRequest conn@Http2Connection]
    [error "TODO: request — allocate stream ID, send HEADERS+DATA, return Task@RawResponse"]]

  h2-open-stream: [fn [let conn@Http2Connection]
    [error "TODO: h2-open-stream — allocate next odd stream ID, return Handle"]]

  h2-incoming: [fn [let conn@Http2Connection]
    [error "TODO: h2-incoming — recv next server-initiated (even) stream"]]

  http2-req-conn: [fn [let conn@Http2Connection out@[Channel RawRequest]]
    [error "TODO: http2-req-conn — read HEADERS frames, hpack-decode, emit RawRequest with respond fn"]]

  http2-client: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [h2 h]]

  h2-stream-ch: [fn [let ch@[Channel Http2Connection]]
    [channel-map [fn [let conn] [h2-open-stream conn]] ch]]

  h2-push: [fn [let conn@Http2Connection stream-id@Int req@RawRequest resp@RawResponse]
    [error "TODO: h2-push — send PUSH_PROMISE + HEADERS+DATA on new server-initiated stream"]]

  # Serve layer: promote each incoming Handle to an Http2Connection. Subject-last for |.
  h2-serve: [_ | [channel-map h2-accept]]

  # Request-extraction: each Http2Connection yields its request streams.
  http2-requests: [_ | [channel-flat-map http2-req-conn]]
]
