# stdlib/protocols/http2.llt — HTTP/2 (RFC 7540) + HPACK (RFC 7541) in tinct.
# Part of: lib-net-v3

[include %libdir "net.llt"]
[include %include-dir "tls13.llt"]   # for TlsHandle, tls-commit, with-alpn
[include %include-dir "http1.llt"]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  read-h2-frame: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [header:  [read h 9]]
    [len:     [@H2FrameLength [uint24 NetworkEndian [slice header 0 3]]]]  # RFC 7540 §4.1: 24-bit frame length
    [sid:     [@H2StreamId [band [uint32 NetworkEndian [slice header 5 9]] 0x7FFFFFFF]]]  # 31-bit stream id
    [H2Frame [type:      [or [get code: [get header 3] H2FrameType] [error [str "HTTP/2: unknown frame type: " [get header 3]]]]
              flags:     [@UInt8 [get header 4]]
              stream-id: sid
              payload:   [read h len]]]]

  write-h2-frame: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h frame@H2Frame]
    [len: [@H2FrameLength [length frame.payload]]]
    [write h
      [concat
        [bytes NetworkEndian len]                                            # 24-bit frame length (H2FrameLength)
        [bytes NetworkEndian [@UInt8 frame.type.code]]
        [bytes NetworkEndian frame.flags]                                    # UInt8 (single byte)
        [bytes NetworkEndian [@H2StreamId [band frame.stream-id 0x7FFFFFFF]]]  # 31-bit stream id
        frame.payload]]]

  # HPACK static table (RFC 7541 Appendix A) — 61 entries, indexed 1–61.
  hpack-static-table: [
    [":authority" null]              [":method" "GET"]               [":method" "POST"]
    [":path" "/"]                   [":path" "/index.html"]          [":scheme" "http"]
    [":scheme" "https"]             [":status" "200"]                [":status" "204"]
    [":status" "206"]               [":status" "304"]                [":status" "400"]
    [":status" "404"]               [":status" "500"]                ["accept-charset" null]
    ["accept-encoding" "gzip, deflate"]  ["accept-language" null]    ["accept-ranges" null]
    ["accept" null]                 ["access-control-allow-origin" null]  ["age" null]
    ["allow" null]                  ["authorization" null]           ["cache-control" null]
    ["content-disposition" null]    ["content-encoding" null]        ["content-language" null]
    ["content-length" null]         ["content-location" null]        ["content-range" null]
    ["content-type" null]           ["cookie" null]                  ["date" null]
    ["etag" null]                   ["expect" null]                  ["expires" null]
    ["from" null]                   ["host" null]                    ["if-match" null]
    ["if-modified-since" null]      ["if-none-match" null]           ["if-range" null]
    ["if-unmodified-since" null]    ["last-modified" null]           ["link" null]
    ["location" null]               ["max-forwards" null]            ["proxy-authenticate" null]
    ["proxy-authorization" null]    ["range" null]                   ["referer" null]
    ["refresh" null]                ["retry-after" null]             ["server" null]
    ["set-cookie" null]             ["strict-transport-security" null]  ["transfer-encoding" null]
    ["user-agent" null]             ["vary" null]                    ["via" null]
    ["www-authenticate" null]]

  # RFC 7541 §4.1-4.4: evict oldest entries until new entry fits, then prepend.
  hpack-add-to-table: [fn [let table@HpackTable name@String value@String]
    [entry-size: [+ [+ [length [str-bytes name]] [length [str-bytes value]]] 32]]
    [evict: [fn [let entries size]
      [if [or [<= size [- table.max-size entry-size]] [empty? entries]]
        entries
        [block
          [entry: [last entries]]
          [e-size: [+ [+ [length [str-bytes entry.name]] [length [or entry.value ""]]] 32]]
          [evict [slice entries 0 [- [length entries] 1]] [- size e-size]]]]]]
    [new-size: [+ table.size entry-size]]
    [evicted: [evict table.entries new-size]]
    [evicted-size: [reduce [fn [let acc e] [+ acc [+ [+ [length [str-bytes e.name]] [if [absent? e.value] 0 [length [str-bytes e.value]]]] 32]]] 0 evicted]]
    [HpackTable
      entries:  [cons [HpackEntry name: name  value: value] evicted]
      size:     [+ evicted-size entry-size]
      max-size: table.max-size]]
]

# HttpConnect instance for Http2Connection.
[instance HttpConnect
  [let h@Http2Connection]: [request: request]]

# HPACK codec: Headers ↔ Bytes (encode headers as HPACK; decode HPACK bytes to headers).
# Note: hpack-encode/hpack-decode take HpackTable as the codec instance (dynamic table state).
[instance Codec
  [let a@HpackCodec b@Headers c@Bytes]: [encode: hpack-encode
                                          decode: hpack-decode]]

# HTTP/2 frame codec: H2Frame ↔ Bytes (serialize/parse the 9-byte frame header + payload).
[instance Codec
  [let a@H2FrameCodec b@H2Frame c@Bytes]: [encode: h2-frame-serialize
                                            decode: h2-frame-parse]]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # Named domain types with fixed byte-order encodings per RFC 7540.
  # All HTTP/2 multi-byte integers are big-endian (network byte order) per RFC 7540 §4.
  H2StreamId:    [type UInt32@[is: [between 0 2147483647]  encoding: NetworkEndian]]  # RFC 7540 §5.1.1: 31-bit (MSB reserved)
  H2FrameLength: [type UInt24@[encoding: NetworkEndian]]                               # RFC 7540 §4.1: 24-bit frame length
  H2ErrorCode:   [type UInt32@[encoding: NetworkEndian]]                               # RFC 7540 §7: 32-bit error codes
  H2SettingId:   [type UInt16@[encoding: NetworkEndian]]                               # RFC 7540 §6.5: 16-bit setting identifier
  H2SettingValue:[type UInt32@[encoding: NetworkEndian]]                               # RFC 7540 §6.5: 32-bit setting value

  H2FrameType: [type
    [H2Data         code: 0]
    [H2Headers      code: 1]
    [H2Priority     code: 2]
    [H2RstStream    code: 3]
    [H2Settings     code: 4]
    [H2PushPromise  code: 5]
    [H2Ping         code: 6]
    [H2Goaway       code: 7]
    [H2WindowUpdate code: 8]
    [H2Continuation code: 9]]

  H2Frame: [type
    [type:      H2FrameType
     flags:     UInt8             # RFC 7540 §3.3: 8-bit flags field (no endianness — single byte)
     stream-id: H2StreamId        # RFC 7540 §5.1.1: 31-bit unsigned (high bit reserved); 0 = connection-level
     payload:   Bytes]]

  # RFC 7541: each HPACK table entry is a (name, value) header field.
  HpackEntry: [type [name: String  value: [or String Absent]]]  # Absent for name-only static entries

  HpackTable: [type
    [entries:  [Seq HpackEntry]
     size:     Int                # current dynamic table size in octets (RFC 7541 §4.1)
     max-size: Int]]              # SETTINGS_HEADER_TABLE_SIZE (default 4096)

  H2Stream: [type
    [id:         Int
     send-window:[Channel Int]
     recv-ch:    [Channel Bytes]
     headers-ch: [Channel [Map String String]]]]

  # RFC 7540 §6.5 SETTINGS parameters — a record of typed optional fields, not a map.
  Http2Settings: [type
    [header-table-size:      [or UInt32 Absent]   # SETTINGS_HEADER_TABLE_SIZE (default 4096)
     enable-push:            [or Bool Absent]       # SETTINGS_ENABLE_PUSH (default true)
     max-concurrent-streams: [or UInt32 Absent]    # SETTINGS_MAX_CONCURRENT_STREAMS (default unlimited)
     initial-window-size:    [or UInt32 Absent]    # SETTINGS_INITIAL_WINDOW_SIZE (default 65535; max 2^31-1)
     max-frame-size:         [or UInt32 Absent]    # SETTINGS_MAX_FRAME_SIZE (default 16384; range 2^14–2^24-1)
     max-header-list-size:   [or UInt32 Absent]]]  # SETTINGS_MAX_HEADER_LIST_SIZE (default unlimited)

  Http2Connection: [type
    [handle:      Handle
     substreams:  [Map Int H2Stream]
     hpack-send:  HpackTable
     hpack-recv:  HpackTable
     next-stream: [Channel Int]
     send-window: [Channel Int]
     recv-window: [Channel Int]
     settings:    Http2Settings]]

  # RFC 7541 §5.1: decode HPACK integer with given prefix-bit count.
  # prefix-bits: 1-8, the number of low bits in the first byte used for the integer.
  hpack-decode-int: [fn [let data@Bytes offset@Int prefix-bits@Int]
    [mask:    [- [shl 1 prefix-bits] 1]]
    [first:   [band [get data offset] mask]]
    [if [< first mask]
      [value: first  next: [+ offset 1]]
      # Multi-byte integer: read M bytes with bit 7 as continuation flag (RFC 7541 §5.1)
      [block
        [read-multi: [fn [let i acc]
          [b:       [get data [+ offset 1 i]]]
          [new-acc: [+ acc [shl [band b 0x7F] [* i 7]]]]
          [if [= [band b 0x80] 0]
            [value: [+ mask new-acc]  next: [+ offset 2 i]]
            [read-multi [+ i 1] new-acc]]]]
        [read-multi 0 0]]]]

  # RFC 7541 §5.2: decode HPACK string (literal or Huffman-encoded).
  hpack-decode-str: [fn [let data@Bytes offset@Int]
    [b0:       [get data offset]]
    [huffman:  [= [band b0 0x80] 0x80]]
    [len-res:  [hpack-decode-int data offset 7]]
    [raw:      [slice data len-res.next [+ len-res.next len-res.value]]]
    [next:     [+ len-res.next len-res.value]]
    [str:      [if huffman [hpack-huffman-decode raw] [bytes-str raw]]]
    [value: str  next: next]]

  # RFC 7541 §6.1: indexed header field — 0x80 bit set, 7-bit index.
  # RFC 7541 §6.2.1: literal with incremental indexing — 0x40 bit set, 6-bit name index (0=literal name).
  # RFC 7541 §6.2.2: literal without indexing — 0x00 prefix, 4-bit name index (0=literal name).
  # RFC 7541 §6.2.3: literal never indexed — 0x10 prefix, 4-bit name index.
  # RFC 7541 §6.3: dynamic table size update — 0x20 prefix, 5-bit new max-size.
  # Static table has 61 entries (RFC 7541 Appendix A). Dynamic table appended after.
  # Returns [Map String String] of decoded headers.
  hpack-decode: [fn [let table@HpackTable data@Bytes offset@Int]
    # Slice from offset — internal loop operates on buf with buf-relative offsets.
    [buf: [slice data offset [length data]]]
    [decode-loop: [fn [let off headers dyn-table]
      [if [>= off [length buf]]
        [value: headers  next: [length data]]
        [block
          [b0: [get buf off]]
          [if [= [band b0 0x80] 0x80]
            # §6.1: indexed header field — 1-bit prefix 1, 7-bit index
            [block
              [idx-res: [hpack-decode-int buf off 7]]
              [all-entries: [concat hpack-static-table dyn-table.entries]]
              [entry: [get all-entries [- idx-res.value 1]]]   # 1-indexed
              [name:  [get entry 0]   value: [or [get entry 1] ""]]
              [decode-loop idx-res.next [merge headers {$name: value}] dyn-table]]
            [if [= [band b0 0xC0] 0x40]
              # §6.2.1: literal with incremental indexing — 2-bit prefix 01, 6-bit name index
              [block
                [idx-res:   [hpack-decode-int buf off 6]]
                [name-value: [if [= idx-res.value 0]
                  # literal name
                  [block
                    [n-res: [hpack-decode-str buf idx-res.next]]
                    [v-res: [hpack-decode-str buf n-res.next]]
                    [name: n-res.value  value: v-res.value  next: v-res.next]]
                  # indexed name
                  [block
                    [all-entries: [concat hpack-static-table dyn-table.entries]]
                    [entry: [get all-entries [- idx-res.value 1]]]
                    [name: [get entry 0]]
                    [v-res: [hpack-decode-str buf idx-res.next]]
                    [name: name  value: v-res.value  next: v-res.next]]]]
                [new-table: [hpack-add-to-table dyn-table name-value.name name-value.value]]
                [decode-loop name-value.next [merge headers {$name-value.name: name-value.value}] new-table]]
              [if [= [band b0 0xE0] 0x20]
                # §6.3: dynamic table size update — 3-bit prefix 001, 5-bit new max-size
                [block
                  [sz-res: [hpack-decode-int buf off 5]]
                  [new-table: [HpackTable entries: dyn-table.entries  size: dyn-table.size  max-size: sz-res.value]]
                  [decode-loop sz-res.next headers new-table]]
                # §6.2.2 or §6.2.3: literal without indexing (4-bit prefix 0000/0001)
                [block
                  [idx-res:    [hpack-decode-int buf off 4]]
                  [name-value: [if [= idx-res.value 0]
                    [block
                      [n-res: [hpack-decode-str buf idx-res.next]]
                      [v-res: [hpack-decode-str buf n-res.next]]
                      [name: n-res.value  value: v-res.value  next: v-res.next]]
                    [block
                      [all-entries: [concat hpack-static-table dyn-table.entries]]
                      [entry: [get all-entries [- idx-res.value 1]]]
                      [name: [get entry 0]]
                      [v-res: [hpack-decode-str buf idx-res.next]]
                      [name: name  value: v-res.value  next: v-res.next]]]]
                  # §6.2.2: never add to dynamic table
                  [decode-loop name-value.next [merge headers {$name-value.name: name-value.value}] dyn-table]]]]]]]]
    [decode-loop 0 {} table]]

  # Encode headers as HPACK bytes using literal-without-indexing for safety.
  # Safe default: never update dynamic table; always emit literal representation.
  # For each header: [0x00][name-len][name-bytes][value-len][value-bytes] (RFC 7541 §6.2.3).
  hpack-encode: [fn [let table@HpackTable headers@[Map String String]]
    [apply concat [map-kv [fn [let k v]
      [k-bytes: [str-bytes k]  v-bytes: [str-bytes v]]
      [concat [0x00]
              [bytes NetworkEndian [@UInt8 [length k-bytes]]] k-bytes
              [bytes NetworkEndian [@UInt8 [length v-bytes]]] v-bytes]]
     headers]]]

  # RFC 7541 Appendix B: HPACK Huffman code table — [code, length] pairs for symbols 0..255 + EOS.
  # Each entry is [code-bits, bit-length]. Codes are MSB-first per RFC 7541 §5.2.
  # Full 257-entry table (256 symbols + EOS at index 256) per RFC 7541 Appendix B.
  hpack-huffman-table: [
    # sym 0–7  (control chars)
    [0x1ff8 13] [0x7fffd8 23] [0xfffffe2 28] [0xfffffe3 28] [0xfffffe4 28] [0xfffffe5 28] [0xfffffe6 28] [0xfffffe7 28]
    # sym 8–15
    [0xfffffe8 28] [0xffffea 24] [0x3ffffffc 26] [0xfffffe9 28] [0xfffffea 28] [0x3ffffffd 26] [0xfffffeb 28] [0xfffffec 28]
    # sym 16–23
    [0xfffffed 28] [0xfffffee 28] [0xfffffef 28] [0xffffff0 28] [0xffffff1 28] [0xffffff2 28] [0x3ffffffe 30] [0xffffff3 28]
    # sym 24–31
    [0xffffff4 28] [0xffffff5 28] [0xffffff6 28] [0xffffff7 28] [0xffffff8 28] [0xffffff9 28] [0xffffffa 28] [0xffffffb 28]
    # sym 32–39  (ASCII printable: space ! " # $ % & ')
    [0x14 6] [0x3f8 10] [0x3f9 10] [0xffa 12] [0x1ff9 13] [0x15 6] [0xf8 8] [0x7fa 11]
    # sym 40–47  ( ) * + , - . /
    [0x3fa 10] [0x3fb 10] [0xf9 8] [0x7fb 11] [0xfa 8] [0x16 6] [0x17 6] [0x18 6]
    # sym 48–55  0 1 2 3 4 5 6 7
    [0x0 5] [0x1 5] [0x2 5] [0x19 6] [0x1a 6] [0x1b 6] [0x1c 6] [0x1d 6]
    # sym 56–63  8 9 : ; < = > ?
    [0x1e 6] [0x1f 6] [0x5c 7] [0xfb 8] [0x7ffc 15] [0x20 6] [0xffb 12] [0x3fc 10]
    # sym 64–71  @ A B C D E F G
    [0x1ffa 13] [0x21 6] [0x5d 7] [0x5e 7] [0x5f 7] [0x60 7] [0x61 7] [0x62 7]
    # sym 72–79  H I J K L M N O
    [0x63 7] [0x64 7] [0x65 7] [0x66 7] [0x67 7] [0x68 7] [0x69 7] [0x6a 7]
    # sym 80–87  P Q R S T U V W
    [0x6b 7] [0x6c 7] [0x6d 7] [0x6e 7] [0x6f 7] [0x70 7] [0x71 7] [0x72 7]
    # sym 88–95  X Y Z [ \ ] ^ _
    [0xfc 8] [0x73 7] [0xfd 8] [0x1ffb 13] [0x7fff0 19] [0x1ffc 13] [0x3ffc 14] [0x22 6]
    # sym 96–103  ` a b c d e f g
    [0x7ffd 15] [0x3 5] [0x23 6] [0x4 5] [0x24 6] [0x5 5] [0x25 6] [0x26 6]
    # sym 104–111  h i j k l m n o
    [0x27 6] [0x6 5] [0x74 7] [0x75 7] [0x28 6] [0x29 6] [0x2a 6] [0x7 5]
    # sym 112–119  p q r s t u v w
    [0x2b 6] [0x76 7] [0x2c 6] [0x8 5] [0x9 5] [0x2d 6] [0x77 7] [0x78 7]
    # sym 120–127  x y z { | } ~ DEL
    [0x79 7] [0x7a 7] [0x7b 7] [0x7ffe 15] [0x7fc 11] [0x3ffd 14] [0x1ffd 13] [0xffffffc 28]
    # sym 128–135  (extended Latin-1)
    [0xfffe6 20] [0x3fffd2 22] [0xfffe7 20] [0xfffe8 20] [0x3fffd3 22] [0x3fffd4 22] [0x3fffd5 22] [0x7fffd9 23]
    # sym 136–143
    [0x3fffd6 22] [0x7fffda 23] [0x7fffdb 23] [0x7fffdc 23] [0x7fffdd 23] [0x7fffde 23] [0xffffeb 24] [0x7fffdf 23]
    # sym 144–151
    [0xffffec 24] [0xffffed 24] [0x3fffd7 22] [0x7fffe0 23] [0xffffee 24] [0x7fffe1 23] [0x7fffe2 23] [0x7fffe3 23]
    # sym 152–159
    [0x7fffe4 23] [0x3fffd8 22] [0x7fffe5 23] [0x3fffd9 22] [0x7fffe6 23] [0x7fffe7 23] [0x7fffe8 23] [0x7fffe9 23]
    # sym 160–167
    [0xffffef 24] [0x7fffea 23] [0x7fffeb 23] [0xfffff0 24] [0xfffff1 24] [0xfffff2 24] [0xfffff3 24] [0xfffff4 24]
    # sym 168–175
    [0xfffff5 24] [0x3fffda 22] [0xfffff6 24] [0x3fffdb 22] [0x3fffdc 22] [0x7fffec 23] [0x7fffed 23] [0x3fffdd 22]
    # sym 176–183
    [0x7fffee 23] [0xfffff7 24] [0xfffff8 24] [0xfffff9 24] [0x3fffde 22] [0xfffffa 24] [0x3fffdf 22] [0x7fffef 23]
    # sym 184–191  (RFC 7541 Appendix B)
    [0xffffd0 24] [0x3fffe0 22] [0xffffd1 24] [0xffffd2 24] [0xffffd3 24] [0xffffd4 24] [0xffffd5 24] [0xffffd6 24]
    # sym 192–199
    [0xffffd7 24] [0xffffd8 24] [0xffffd9 24] [0xffffda 24] [0xffffdb 24] [0xffffdc 24] [0xffffdd 24] [0xffffde 24]
    # sym 200–207
    [0xffffdf 24] [0xffffe0 24] [0xffffe1 24] [0xffffe2 24] [0xffffe3 24] [0xffffe4 24] [0xffffe5 24] [0xffffe6 24]
    # sym 208–215
    [0xffffe7 24] [0xffffe8 24] [0xffffe9 24] [0xffffea 24] [0xffffeb 24] [0xffffec 24] [0xffffed 24] [0xffffee 24]
    # sym 216–223
    [0xffffef 24] [0xfffff0 24] [0xfffff1 24] [0xfffff2 24] [0xfffff3 24] [0xfffff4 24] [0xfffff5 24] [0x3fffe1 22]
    # sym 224–231
    [0xfffff6 24] [0x3fffe2 22] [0x3fffe3 22] [0x3fffe4 22] [0x7ffff0 23] [0x3fffe5 22] [0x3fffe6 22] [0x7ffff1 23]
    # sym 232–239
    [0x3ffffe0 26] [0x3ffffe1 26] [0xfffff7 24] [0x3ffffe2 26] [0x3ffffe3 26] [0x3ffffe4 26] [0x7ffffde 27] [0x7ffffdf 27]
    # sym 240–247
    [0x3ffffe5 26] [0xfffff8 24] [0xfffff9 24] [0x3ffffe6 26] [0x7ffffe0 27] [0xfffffa 24] [0x7ffffe1 27] [0x3ffffe7 26]
    # sym 248–255
    [0x7ffffe2 27] [0xfffffb 28] [0x3ffffe8 26] [0x3ffffe9 26] [0xfffffba 28] [0x3ffffea 26] [0x7ffffe3 27] [0x3ffffeb 26]
    # EOS (symbol 256) — 0x3fffffff 30 bits
    [0x3fffffff 30]]

  # RFC 7541 §5.2: Huffman decode via bit-by-bit traversal against the code table.
  # Build a reverse lookup: for each entry [code len] in the table, extract 'len' bits from
  # the input stream and compare. Practical decode: scan input bits, match against table.
  # Algorithm: accumulate bits, check each possible code length (5..30) for a match.
  hpack-huffman-decode: [fn [let data@Bytes]
    # Extract all bits from data into a large integer for easy bit extraction.
    [n-bits: [* [length data] 8]]
    [bits: [reduce [fn [let acc b] [bor [shl acc 8] b]] 0 [collect data]]]
    [decode-loop: [fn [let bit-pos acc]
      [if [>= bit-pos n-bits]
        [bytes-str [reduce concat [] acc]]   # join accumulated char-bytes
        # Try each possible code length from 5 to 30 (min HPACK Huffman code length is 5)
        [block
          [remaining: [- n-bits bit-pos]]
          [try-len: [fn [let len]
            [if [> len remaining]
              [bytes-str [reduce concat [] acc]]   # EOS padding — done
              [block
                [shift:    [- n-bits [+ bit-pos len]]
                 candidate: [band [shr bits [max shift 0]] [- [shl 1 len] 1]]]
                # Search for matching code in table
                [try-sym: [fn [let sym]
                  [if [>= sym [length hpack-huffman-table]]
                    [if [< len 30] [try-len [+ len 1]] [error "HPACK Huffman: invalid code"]]
                    [block
                      [entry: [get hpack-huffman-table sym]]
                      [code:  [get entry 0]  code-len: [get entry 1]]
                      [if [and [= code-len len] [= code candidate]]
                        [if [= sym 256] [bytes-str [reduce concat [] acc]]   # EOS
                          [decode-loop [+ bit-pos len] [append acc [list [bytes sym]]]]]
                        [try-sym [+ sym 1]]]]]]]
                [try-sym 0]]]]]
          [try-len 5]]]]]
    [decode-loop 0 []]]

  # Codec instance methods for H2FrameCodec (serialize/parse H2Frame ↔ Bytes).
  # These wrap the internal read-h2-frame/write-h2-frame helpers for use as Codec instances.
  h2-frame-serialize: [fn [let _ frame@H2Frame]
    [len: [@H2FrameLength [length frame.payload]]]
    [concat
      [bytes NetworkEndian len]
      [bytes NetworkEndian [@UInt8 frame.type.code]]
      [bytes NetworkEndian frame.flags]
      [bytes NetworkEndian [@H2StreamId [band frame.stream-id 0x7FFFFFFF]]]
      frame.payload]]

  h2-frame-parse: [fn [let _ data@Bytes offset@Int]
    [frame-data: [slice data offset [length data]]]
    [payload-len: [@H2FrameLength [uint24 NetworkEndian [slice frame-data 0 3]]]]
    [value: [H2Frame
      type:      [or [get code: [get frame-data 3] H2FrameType] [error [str "HTTP/2: unknown frame type: " [get frame-data 3]]]]
      flags:     [@UInt8 [get frame-data 4]]
      stream-id: [@H2StreamId [band [uint32 NetworkEndian [slice frame-data 5 9]] 0x7FFFFFFF]]
      payload:   [slice frame-data 9 [+ 9 payload-len]]]
     next: [+ offset 9 payload-len]]]

  # RFC 7540 §3.5: server reads "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n" (24 bytes) preface,
  # then sends SETTINGS frame, then waits for client SETTINGS + ACK.
  h2-accept: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    # Read 24-byte client connection preface
    [preface: [read h 24]]
    [if [not [= [bytes-str preface] "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"]]
      [error "HTTP/2: invalid connection preface"]
      [block
        # Send server SETTINGS frame (empty payload = all defaults)
        [write h [h2-frame-serialize null [H2Frame
          type: H2FrameType.H2Settings  flags: [@UInt8 0]  stream-id: 0  payload: [bytes 0]]]]
        # Read client SETTINGS frame (must be the next frame, RFC 7540 §3.5)
        [client-settings-frame: [read-h2-frame h]]
        [if [not [= [tag-of client-settings-frame.type] "H2FrameType.H2Settings"]]
          [error "HTTP/2: expected SETTINGS frame from client"]
          [block
            # Send SETTINGS ACK (flags = 0x01 = ACK, RFC 7540 §6.5)
            [write h [h2-frame-serialize null [H2Frame
              type: H2FrameType.H2Settings  flags: [@UInt8 0x01]  stream-id: 0  payload: [bytes 0]]]]
            # Read client's SETTINGS ACK for our SETTINGS
            [client-ack: [read-h2-frame h]]
            # (Ignore client ACK — our SETTINGS was empty so no parameter changes needed)
            [default-table: [HpackTable entries: []  size: 0  max-size: 4096]]
            [next-stream-ch: [channel 1]]
            [send next-stream-ch 2]   # server-initiated streams are even; start at 2
            [send-win-ch: [channel 1]   recv-win-ch: [channel 1]]
            [send send-win-ch 65535]  [send recv-win-ch 65535]
            [Http2Connection
              handle: h
              substreams: [channel 256]
              hpack-send: default-table
              hpack-recv: default-table
              next-stream: next-stream-ch
              send-window: send-win-ch
              recv-window: recv-win-ch
              settings: [Http2Settings
                header-table-size: Absent.Absent  enable-push: Absent.Absent
                max-concurrent-streams: Absent.Absent  initial-window-size: Absent.Absent
                max-frame-size: Absent.Absent  max-header-list-size: Absent.Absent]]]]]]]

  # RFC 7540 §3: client sends connection preface, then SETTINGS, then requests.
  # PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n (24 bytes) + SETTINGS frame.
  h2: [fn [let pth@TlsHandle]
    [match [tls-commit [with-alpn pth ["h2"]]]
      [TlsError e]:  e   # propagate TLS error
      [Result.Ok conn]:
        # Send connection preface (RFC 7540 §3.5)
        [write conn [str-bytes "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"]]
        # Send initial SETTINGS (empty → all defaults: flow-control window 65535, no push)
        [write conn [h2-frame-serialize null [H2Frame
          type: H2FrameType.H2Settings  flags: [@UInt8 0]  stream-id: 0  payload: [bytes 0]]]]
        # Read server SETTINGS frame
        [server-settings-frame: [read-h2-frame conn]]
        [if [not [= [tag-of server-settings-frame.type] "H2FrameType.H2Settings"]]
          [error "HTTP/2: expected SETTINGS frame from server"]
          [block
            # Send SETTINGS ACK to server (flags = 0x01)
            [write conn [h2-frame-serialize null [H2Frame
              type: H2FrameType.H2Settings  flags: [@UInt8 0x01]  stream-id: 0  payload: [bytes 0]]]]
            # Wait for server ACK of our SETTINGS
            [server-ack: [read-h2-frame conn]]
            # (Ignore server ACK — our SETTINGS was empty)
            [default-table: [HpackTable entries: []  size: 0  max-size: 4096]]
            [next-stream-ch: [channel 1]]
            [send next-stream-ch 1]   # client-initiated streams are odd; first is stream 1
            [send-win-ch: [channel 1]   recv-win-ch: [channel 1]]
            [send send-win-ch 65535]  [send recv-win-ch 65535]
            [Http2Connection
              handle: conn
              substreams: [channel 256]
              hpack-send: default-table
              hpack-recv: default-table
              next-stream: next-stream-ch
              send-window: send-win-ch
              recv-window: recv-win-ch
              settings: [Http2Settings
                header-table-size: Absent.Absent  enable-push: Absent.Absent
                max-concurrent-streams: Absent.Absent  initial-window-size: Absent.Absent
                max-frame-size: Absent.Absent  max-header-list-size: Absent.Absent]]]]]]

  # Send an HTTP/2 request on a new stream. Returns Task@RawResponse.
  request: [fn [let req@RawRequest conn@Http2Connection]
    [task
      [stream-id: [match [recv conn.next-stream] [Result.Ok n]: n  [Closed.Closed]: [error "H2: connection closed"]]]
      [send conn.next-stream [+ stream-id 2]]   # next client stream is +2
      # Encode headers as HPACK and send HEADERS frame (END_HEADERS flag = 0x04)
      [headers-bytes: [hpack-encode conn.hpack-send req.headers]]
      [write conn.handle [h2-frame-serialize null
        [H2Frame type: H2FrameType.H2Headers  flags: [@UInt8 0x05]  stream-id: stream-id  payload: headers-bytes]]]
      # Send DATA frame if body present (END_STREAM flag = 0x01)
      [if [> [length req.body] 0]
        [write conn.handle [h2-frame-serialize null
          [H2Frame type: H2FrameType.H2Data  flags: [@UInt8 0x01]  stream-id: stream-id  payload: req.body]]]
        null]
      # Await response HEADERS + DATA frames for stream-id (RFC 7540 §8.1).
      # Loop: read frames until END_STREAM on this stream. Collect HEADERS + DATA.
      [collect-response: [fn [let resp-headers resp-body]
        [frame: [read-h2-frame conn.handle]]
        [if [= frame.stream-id stream-id]
          [match frame.type
            [H2FrameType.H2Headers]:
              [new-hdrs: [hpack-decode conn.hpack-recv frame.payload]]
              [end-stream: [= [band frame.flags 0x01] 0x01]]
              [if end-stream
                [RawResponse
                  status:  [int-of-str [or [get? new-hdrs ":status"] "200"]]
                  headers: new-hdrs
                  body:    resp-body]
                [collect-response new-hdrs resp-body]]
            [H2FrameType.H2Data]:
              [new-body: [concat resp-body frame.payload]]
              [end-stream: [= [band frame.flags 0x01] 0x01]]
              [if end-stream
                [RawResponse
                  status:  [int-of-str [or [get? resp-headers ":status"] "200"]]
                  headers: resp-headers
                  body:    new-body]
                [collect-response resp-headers new-body]]
            _: [collect-response resp-headers resp-body]]
          # Frame for a different stream — skip and continue
          [collect-response resp-headers resp-body]]]]
      [collect-response {} [bytes 0]]]]

  # RFC 7540 §5.1: client-initiated bidi streams are odd (1, 3, 5, ...).
  # Allocate next odd stream ID from next-stream channel.
  h2-open-stream: [fn [let conn@Http2Connection]
    [match [recv conn.next-stream]
      [Closed.Closed]:   [error "HTTP/2: connection closed"]
      [Result.Ok stream-id]:
        [send conn.next-stream [+ stream-id 2]]
        stream-id]]

  # RFC 7540 §5.1: server-initiated streams are even (2, 4, 6, ...).
  h2-incoming: [fn [let conn@Http2Connection]
    [recv conn.substreams]]

  # Drain HEADERS frames from conn, hpack-decode headers, emit RawRequest per stream.
  http2-req-conn: [fn [let conn@Http2Connection out@[Channel RawRequest]]
    [task
      [step: [fn []
        [match [try [read-h2-frame conn.handle]]
          [Result.Error _]: []
          [Result.Ok frame]:
            [match frame.type
              [H2FrameType.H2Headers]:
                [headers: [hpack-decode conn.hpack-recv frame.payload]]
                [method:  [or [get? headers ":method"]    "GET"]]
                [path:    [or [get? headers ":path"]      "/"]]
                [send out [RawRequest
                  method: method  path: path  headers: headers  body: [bytes 0]
                  respond: [fn [let resp]
                    # RFC 7540 §8.1: send HEADERS frame with END_HEADERS (0x04), then DATA with END_STREAM (0x01)
                    [status-hdrs: [merge {":status": [str resp.status]} resp.headers]]
                    [resp-hpack: [hpack-encode conn.hpack-send status-hdrs]]
                    [write conn.handle [h2-frame-serialize null
                      [H2Frame type: H2FrameType.H2Headers
                               flags: [@UInt8 [if [= [length resp.body] 0] 0x05 0x04]]
                               stream-id: frame.stream-id  payload: resp-hpack]]]
                    [if [> [length resp.body] 0]
                      [write conn.handle [h2-frame-serialize null
                        [H2Frame type: H2FrameType.H2Data
                                 flags: [@UInt8 0x01]
                                 stream-id: frame.stream-id  payload: resp.body]]]
                      null]]]]
              _: null]
            [step]]]]
      [step]]]

  http2-client: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [h2 h]]

  h2-stream-ch: [fn [let ch@[Channel Http2Connection]]
    [channel-map [fn [let conn] [h2-open-stream conn]] ch]]

  # RFC 7540 §8.2: server push — send PUSH_PROMISE on existing stream, then HEADERS+DATA on new even stream.
  h2-push: [fn [let conn@Http2Connection stream-id@Int req@RawRequest resp@RawResponse]
    [push-id: [match [recv conn.next-stream] [Result.Ok n]: n  [Closed.Closed]: [error "H2: closed"]]]
    [send conn.next-stream [+ push-id 2]]
    # PUSH_PROMISE: reference stream-id + promised-stream-id + HPACK headers
    [promise-payload: [concat [bytes NetworkEndian [@H2StreamId push-id]] [hpack-encode conn.hpack-send req.headers]]]
    [write conn.handle [h2-frame-serialize null [H2Frame type: H2FrameType.H2PushPromise  flags: [@UInt8 0x04]  stream-id: stream-id  payload: promise-payload]]]
    # Send response on push-id stream
    [resp-headers: [hpack-encode conn.hpack-send resp.headers]]
    [write conn.handle [h2-frame-serialize null [H2Frame type: H2FrameType.H2Headers  flags: [@UInt8 0x04]  stream-id: push-id  payload: resp-headers]]]
    [write conn.handle [h2-frame-serialize null [H2Frame type: H2FrameType.H2Data  flags: [@UInt8 0x01]  stream-id: push-id  payload: resp.body]]]]

  # Serve layer kept for explicit use; H2Layer server instance uses it internally.
  h2-serve: [_ | [channel-map h2-accept]]

  # Request-extraction: each Http2Connection yields its request substreams.
  http2-requests: [_ | [channel-flat-map http2-req-conn]]

  # Combined: Channel@TlsConnection → Channel@RawRequest.
  # Equivalent to: | h2-serve | http2-requests
  # Mirrors http1-serve ergonomics — use this for the common server case.
  # Use h2-serve + http2-requests separately only when you need the Http2Connection
  # handle (e.g. for server push via h2-push).
  http2-serve: [_ | h2-serve | http2-requests]
]

# ── H2Layer typeclass — bidirectional h2 ─────────────────────────────────────

[class [let H2Layer input output]
  h2: [Fn@output [input]]]

# Client: TlsHandle → Http2Connection (fires TLS with alpn:["h2"] + H2 preface)
[instance H2Layer
  [let a@TlsHandle b@Http2Connection]: [h2: [fn [let th@TlsHandle] [h2 th]]]]   # delegates to h2 function above

# Server: Channel@TlsConnection → Channel@Http2Connection
[instance@[bind: [h]] [H2Layer [Channel [TlsConnection h]] [Channel Http2Connection]]
  h2: [fn [let ch@[Channel [TlsConnection h]]]
    [channel-map h2-accept ch]]]

# ── HttpStream Http2Connection ────────────────────────────────────────────────

[instance HttpStream
  [let h@Http2Connection]: [send: [fn [let conn@Http2Connection req@RawRequest]
                              [request req conn]]  # delegates to request function above
                            recv: [fn [let conn@Http2Connection]
                              [conn.substreams]]]]  # Channel of substream channels (multiplexed)

# Channel variant: Channel@Http2Connection → Channel@RawRequest (all connections flattened)
[instance HttpStream
  [let h@[Channel Http2Connection]]: [send: [error "not applicable: Channel@Http2Connection is receive-only (server accept loop)"]
                                      recv: [fn [let ch@[Channel Http2Connection]]
                                        [channel-flat-map http2-req-conn ch]]]]

# ── Multiplexed Http2Connection ───────────────────────────────────────────────

[instance Multiplexed
  [let a@Http2Connection b@H2Stream]: [substreams: [fn [let ch@[Channel Http2Connection]]
    [channel-map h2-open-stream ch]]]]
