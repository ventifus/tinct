# stdlib/serve.llt — generic codec pipeline and MessageStream replugging primitives.
# Part of: lib-net-v3
#
# This file contains only protocol-agnostic machinery. Protocol-specific serve
# layers (h2-serve, h3-serve, ws-serve, http1-serve, http2-requests, etc.) live
# in their respective protocol files alongside the accept functions they wrap.
#
# task, send, recv, channel, drain, select, context are all in prelude.

[include %libdir "net.llt"]

# ── MessageStream instance for MessageStreamHandle ────────────────────────────

# MessageStreamHandle wraps any MessageStream implementation in a reactive cell,
# enabling atomic rebinding without affecting in-flight senders.
# send/recv on a handle transparently delegate to the current impl.
[instance@[bind: [t]] MessageStream
  [let a@[MessageStreamHandle t] b@t]:
  [send: [fn [let ms@[MessageStreamHandle t] v@t]
    [send [builtin-cell-get ms.impl] v]]
   recv: [fn [let ms@[MessageStreamHandle t]]
    [recv [builtin-cell-get ms.impl]]]]]

# ── Public API. ───────────────────────────────────────────────────────────────

[
  # MessageStreamHandle: wraps any MessageStream in a reactive cell.
  # The impl cell always holds the current routing implementation (a MessageStream).
  # Backed by builtin-reactive-cell (tokio::sync::watch semantics: last-write-wins,
  # all concurrent reads see the latest value atomically).
  # Tracker: implement builtin-reactive-cell, builtin-cell-get, builtin-cell-set
  # as Rust primitives backed by tokio::sync::watch.
  MessageStreamHandle: [type [t]
    [impl: [ReactiveCell [MessageStream t]]]]

  # ── MessageStream replugging ─────────────────────────────────────────────────

  # Create a repluggable MessageStream handle from an initial implementation.
  message-stream: [fn [let initial-impl]
    [MessageStreamHandle [impl: [builtin-reactive-cell initial-impl]]]]

  # Swap the routing implementation atomically.
  # Senders see the new implementation on their very next send.
  rebind: [fn [let ms new-impl]
    [builtin-cell-set ms.impl new-impl]]

  # ── Codec pipeline ───────────────────────────────────────────────────────────
  #
  # Codec stages compose with | to form readable pipelines:
  #
  #   source | [codec JsonCodec] | [codec NdjsonFramer] | [sink %stdout]
  #
  # Each | [codec C] stage applies C.encode to each value from the previous stage.
  # The terminal | [sink S] writes encoded bytes to the ByteStream S.

  # codec C source — wrap source through a Codec stage.
  # Argument order (C, source) makes | pipelines read left to right.
  # Returns a Channel that emits encoded values.
  codec: [fn@[bind: [c input output]]
           [let c@[Codec c input output]  source@[Channel input]]
    [out: [channel 64]]
    [task
      [step: [fn []
        [match [recv source]
          [Closed.Closed]: []
          [Result.Ok v]:   [block [send out [encode c v]] [step]]]]]
      [step]]
    out]

  # sink S source — terminal stage: drain source and write each encoded value to S.
  # Returns a Task. Await it when the drain must complete before exit.
  sink: [fn [let s  source@[Channel Bytes]]
    [drain [fn [let v] [write s v]] source]]

  # ── MessageStream constructors ────────────────────────────────────────────────

  # to-messages v — adapter from any tinct value to a Channel.
  # Seq → yields each element; scalar → yields one element.
  # Enables [[to-messages %] | out] patterns.
  to-messages: [fn [let v]
    [ch: [channel 64]]
    [task
      [if [seq? v]
        [reduce [fn [let _ x] [send ch x]] [] v]
        [send ch v]]]
    ch]

  # drain-emit codec sink — sugar: drain %emit through a single Codec into a ByteStream.
  # For multi-stage pipelines use | instead:
  #   %emit | [codec JsonCodec] | [codec NdjsonFramer] | [sink %stdout]
  drain-emit: [fn@[bind: [c output]] [let c@[Codec c Any output]  s]
    [sink s [%emit | [codec c]]]]

  # serve: the generic protocol server terminator. Drains a channel of server events,
  # each carrying a typed connection and a request. Spawns a task per event that calls
  # handler with both, then sends the response via request.respond.
  #
  # Every protocol serve layer emits events with [connection: t  request: m] fields:
  #   http2/http3/http1: connection = Http2Connection/Http3Connection/Handle
  #   dns-udp-server:    connection = SocketAddress (source IP+port)
  #   dns-tls-server:    connection = TlsConnection
  #
  # Handler always receives both — use _ for connection when not needed:
  #   handler: [fn [let connection@Http2Connection request@HttpRequest] ...]
  #   simple:  [fn [let _ request@HttpRequest] ...]
  #
  # Subject-last — composes at the end of a protocol stack pipeline:
  #   [tcp-listen %net 443] | [tls cert] | http2 | [serve handler]
  #   [dns-udp-server %net 53] | [serve dns-handler]
  serve: [fn@Task [fn@[bind: [t m r]] [let handler@[Fn [t m] r]
                                           ch@[Channel [ServerEvent t m]]]
    [drain [fn [let event] [task [event.request.respond [handler event.connection event.request]]]] ch]]

  # stream-drain read-fn handler source — drains a ByteStream-backed source via read-fn.
  # read-fn source → reads the next item (returns [Result.Ok item] | Closed.Closed).
  # handler item → called for each item; return value is discarded.
  # Runs synchronously until the source closes; wrap in [task ...] for concurrency.
  #
  # Use for per-stream loops where each stream is a ByteStream (e.g., QuicStream):
  #   [task [stream-drain read-icmp handle-icmp stream]]
  stream-drain: [fn@Null [let read-fn handler source]
    [step: [fn []
      [match [read-fn source]
        [Closed.Closed]: []
        [Result.Ok item]: [block [handler item] [step]]]]]
    [step]]

  # serve-streams read-fn handler stream-ch — for each stream arriving on stream-ch,
  # starts a concurrent task running stream-drain read-fn handler on that stream.
  # Returns a Task that exits when stream-ch closes.
  #
  # Usage: [channel-of-streams | [serve-streams read-fn handler]]
  # Equivalent to: [drain [fn [let s] [task [stream-drain read-fn handler s]]] stream-ch]
  serve-streams: [fn@Task [let read-fn handler stream-ch]
    [drain [fn [let s] [task [stream-drain read-fn handler s]]] stream-ch]]
]
