# stdlib/serve.llt — protocol serve layers.
# Part of: lib-net-v3
# channel-map and channel-flat-map live in async.llt (not networking-specific).
# Config-bearing layers (tls-serve, wireguard-serve, noise-serve) live in their protocol files.
# h2-stream-ch and h3-stream-ch are defined in h2.llt and h3.llt respectively.

[include %libdir "async.llt"]
[include %libdir "net.llt"]
[include %libdir "protocols/quic.llt"]
[include %libdir "protocols/h2.llt"]
[include %libdir "protocols/h3.llt"]
[include %libdir "protocols/websocket.llt"]
[include %libdir "protocols/http1.llt"]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  # (no private helpers)
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # Config-free connection-promotion layers (1:1 via channel-map).
  # Config-bearing layers (tls-serve, wireguard-serve, noise-serve) live in their
  # respective protocol files where they close over protocol-specific config types.
  h2-serve:        [fn [let in-ch] [channel-map h2-accept    in-ch]]
  h3-serve:        [fn [let in-ch] [channel-map h3-accept    in-ch]]
  ws-serve:        [fn [let in-ch] [channel-map ws-accept    in-ch]]

  # Request-extraction layers (1:N via channel-flat-map).
  http1-serve:     [fn [let in-ch] [channel-flat-map http1-conn      in-ch]]
  http2-requests:  [fn [let in-ch] [channel-flat-map http2-req-conn  in-ch]]
  http3-requests:  [fn [let in-ch] [channel-flat-map http3-req-conn  in-ch]]

  # Stream adapters: open one stream per incoming connection.
  # h2-stream-ch and h3-stream-ch are in h2.llt and h3.llt respectively.
  quic-stream-ch:  [fn [let ch@[Channel QuicConnection]]    [channel-map [fn [let c] [quic-open-stream c]] ch]]
]
