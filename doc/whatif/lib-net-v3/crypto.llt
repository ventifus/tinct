# stdlib/crypto.llt — X.509 certificate parsing and chain verification.
# Part of: lib-net-v3
# Rust primitives: rsa-pss-verify, rsa-pkcs1-verify, p256-verify, p384-verify, ed25519-verify,
#   sha256, sha384, sha512 (for signature algorithm dispatch)

[include %libdir "net.llt"]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  decode-be-int: [fn [let b@Bytes offset@Int len@Int]
    [reduce [fn [let acc i] [+ [* acc 256] [get b [+ offset i]]]] 0 [range 0 len]]]

  der-parse-one: [fn [let b@Bytes offset@Int]
    [tag-byte:    [get b offset]]
    [constructed: [= [bit-and tag-byte 0x20] 0x20]]
    [tag-num:     [bit-and tag-byte 0x1F]]
    [if [= tag-num 31] [error "DER: long-form tag not supported"] null]
    [len-byte:    [get b [+ offset 1]]]
    [len-result:
      [if [= [bit-and len-byte 0x80] 0]
        [len: len-byte  value-offset: [+ offset 2]]
        [n-len-bytes: [bit-and len-byte 0x7F]
         big-len:     [decode-be-int b [+ offset 2] n-len-bytes]
         len:         big-len
         value-offset: [+ offset 2 n-len-bytes]]]]
    [raw: [slice b len-result.value-offset len-result.len]]
    [value:
      [if constructed
        # Then: sequence/set — bind children via immediately-invoked lambda (single if-arg).
        [[fn [let children]
           [match tag-num
             16: [AsnSeq children]
             17: [AsnSet children]
             _:  [AsnSeq children]]]   # context-constructed treated as sequence
         [der-parse-seq raw 0 []]]
        # Else: primitive tag dispatch.
        [match tag-num
          1:  [AsnBool [not [= [get raw 0] 0]]]
          2:  [AsnInt raw]
          3:  [AsnBitStr raw]
          4:  [AsnOctetStr raw]
          5:  [AsnNull]
          6:  [AsnOid [decode-oid raw]]
          12: [AsnStr [bytes-str raw]]
          19: [AsnStr [bytes-str raw]]
          22: [AsnStr [bytes-str raw]]
          23: [AsnTime [bytes-str raw]]
          24: [AsnTime [bytes-str raw]]
          _:  [AsnRaw tag-num raw]]]]
    [value: value  next: [+ len-result.value-offset len-result.len]]]

  der-parse-seq: [fn [let b@Bytes offset@Int acc@[Seq AsnValue]]
    [if [>= offset [length b]]
      acc
      # Else: parse one node, recurse — immediately-invoked lambda binds result.
      [[fn [let result]
         [der-parse-seq b result.next [append acc [list result.value]]]]
       [der-parse-one b offset]]]]

  decode-oid: [fn [let b@Bytes]
    [if [= [length b] 0] [error "DER: empty OID"] null]
    [first-byte: [get b 0]]
    # X.680 §B.8: first-byte = 40*arc1 + arc2 for arc1 < 2;
    # for arc1 = 2: first-byte = 80 + arc2 (arc2 may exceed 39).
    [arc1: [if [< first-byte 80] [/ first-byte 40] 2]]
    [arc2: [if [< first-byte 80] [mod first-byte 40] [- first-byte 80]]]
    [cons arc1 [cons arc2 [decode-oid-arcs b 1 []]]]]

  decode-oid-arcs: [fn [let b@Bytes offset@Int acc@[Seq Int]]
    [if [>= offset [length b]] acc
      [arc-result: [decode-oid-arc b offset 0]]
      [decode-oid-arcs b arc-result.next [append acc [list arc-result.arc]]]]]

  decode-oid-arc: [fn [let b@Bytes offset@Int acc@Int]
    [byte:    [get b offset]]
    [new-acc: [+ [* acc 128] [bit-and byte 0x7F]]]
    [if [= [bit-and byte 0x80] 0]
      [arc: new-acc  next: [+ offset 1]]
      [decode-oid-arc b [+ offset 1] new-acc]]]

  extract-tbs: [fn [let cert@AsnValue]
    [error "TODO: extract-tbs — parse version/serial/issuer/validity/subject/subjectPublicKeyInfo from TBSCertificate SEQUENCE"]]

  cert-valid-for-host?: [fn [let cert-der@Bytes hostname@String]
    [error "TODO: cert-valid-for-host? — check validity period vs now, check SAN dNSName matches hostname (with wildcard support)"]]

  chain-sigs-valid?: [fn [let chain@[Seq Bytes]]
    [if [<= [length chain] 1]
      true
      [if [not [cert-signed-by? [get chain 0] [get chain 1]]]
        false
        [chain-sigs-valid? [rest chain]]]]]

  cert-signed-by?: [fn [let cert-der@Bytes issuer-der@Bytes]
    [error "TODO: cert-signed-by? — extract TBS bytes, signature, issuer public key; dispatch to rsa-pkcs1-verify/rsa-pss-verify/p256-verify/p384-verify/ed25519-verify"]]

  root-trusted?: [fn [let cert-der@Bytes trust-roots@[or [Seq Bytes] Symbol]]
    [match trust-roots
      [let [SystemRoots]]:      [builtin-verify-cert-trusted cert-der]
      [let roots@[Seq Bytes]]:  [any? [fn [let root] [cert-signed-by? cert-der root]] roots]]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  AsnValue: [union
    [AsnBool    Bool]
    [AsnInt     Bytes]
    [AsnBitStr  Bytes]
    [AsnOctetStr Bytes]
    [AsnNull]
    [AsnOid     [Seq Int]]
    [AsnStr     String]
    [AsnSeq     [Seq AsnValue]]
    [AsnSet     [Seq AsnValue]]
    [AsnTime    String]
    [AsnRaw     tag@Int  data@Bytes]]

  parse-cert: [fn [let der@Bytes]
    [result: [der-parse-one der 0]]
    [extract-tbs result.value]]

  cert-san: [fn [let cert-der@Bytes]
    [error "TODO: cert-san — parse extensions (OID 2.5.29.17), decode GeneralNames, extract dNSName"]]

  cert-public-key: [fn [let cert-der@Bytes]
    [error "TODO: cert-public-key — parse subjectPublicKeyInfo BIT STRING"]]

  verify-cert-chain: [fn [let chain@[Seq Bytes] trust-roots@[or [Seq Bytes] Symbol] sni@String]
    [if [empty? chain]
      [error "verify-cert-chain: empty chain"]
      [and
        [cert-valid-for-host? [get chain 0] sni]
        [chain-sigs-valid? chain]
        [root-trusted? [get chain [- [length chain] 1]] trust-roots]]]]
]
