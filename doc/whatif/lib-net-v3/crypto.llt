# stdlib/crypto.llt — Cryptographic utilities: HKDF hash algorithm selectors, and
#   X.509 certificate parsing and chain verification.
# Part of: lib-net-v3
# Rust primitives: rsa-pss-verify, rsa-pkcs1-verify, p256-verify, p384-verify, ed25519-verify,
#   sha256, sha384, sha512 (for signature algorithm dispatch)
--- uses: ["crypto"]

[include %libdir "net.llt"]
[include %libdir "asn1.llt"]   # AsnValue, parse-der, parse-der-seq, oid->string, asn-time-to-unix
[include %libdir "text.llt"]   # to-a-label-hostname (pure-tinct IDNA2008), str-to-code-points, unicode-nfc/nfd/nfkc/nfkd

# Hash algorithm selectors for HKDF (used by TLS, WireGuard, Noise, etc.)
# Defined here — not in tls.llt — because they are crypto primitives, not TLS-specific.
[type [Sha256]] [type [Sha384]] [type [Sha512]] [type [Blake2s]]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[

  # X.509 TBSCertificate per RFC 5280 §4.1.
  # cert is the outer Certificate SEQUENCE: [tbsCertificate signatureAlgorithm signatureValue]
  # TBSCertificate fields (positional in the SEQUENCE):
  #   [0] version (optional, default v1) — [0] EXPLICIT INTEGER
  #   [1] serialNumber — INTEGER
  #   [2] signature — AlgorithmIdentifier SEQUENCE
  #   [3] issuer — Name (RDNSequence)
  #   [4] validity — SEQUENCE { notBefore, notAfter }
  #   [5] subject — Name
  #   [6] subjectPublicKeyInfo — SEQUENCE { algorithm, publicKey BIT STRING }
  #   [7] extensions (optional) — [3] EXPLICIT SEQUENCE
  extract-tbs: [fn [let cert@AsnValue]
    [match cert
      [asnValue.AsnSeq items]:
        [tbs: [get items 0]]   # first element is TBSCertificate
        [match tbs
          [asnValue.AsnSeq tbs-items]:
            # Parse version (optional [0] tag), serial, etc.
            [tbs: tbs
             # Return structured dict from TBSCertificate items
             serial:    [get tbs-items [if [= [tag-of [get tbs-items 0]] "asnValue.AsnSeq"] 1 0]]
             validity:  [get tbs-items [if [= [tag-of [get tbs-items 0]] "asnValue.AsnSeq"] 4 3]]
             subject:   [get tbs-items [if [= [tag-of [get tbs-items 0]] "asnValue.AsnSeq"] 5 4]]
             spki:      [get tbs-items [if [= [tag-of [get tbs-items 0]] "asnValue.AsnSeq"] 6 5]]
             extensions: Absent.Absent]   # parse extensions if present
          ...: [error "extract-tbs: TBSCertificate not an AsnSeq"]]
      ...: [error "extract-tbs: Certificate not an AsnSeq"]]]

  # asn-time-to-unix is defined in asn1.llt (public) — available here via include.

  # match-hostname?: RFC 9525 §6.3 DNS-ID wildcard hostname matching.
  # Wildcard rules per RFC 9525 §6.3.2:
  #   - `*` must be the COMPLETE left-most label (not foo*, *bar, f*o)
  #   - Only one `*` per pattern
  #   - Matched portion must contain no dots (single label only)
  #   - Invalid wildcard patterns are IGNORED (treated as no match), not errored
  # Comparison is case-insensitive per RFC 4343.
  # IDN: both hostname and SAN names are converted to A-labels (Punycode) via
  # to-a-label-hostname (from text.llt). NFC normalization is not applied since
  # real TLS certs use ASCII labels.
  match-hostname?: [fn [let hostname@String names@[Seq String]]
    [lower-host: [lower [to-a-label-hostname hostname]]]
    [any? [fn [let name]
      [lower-name: [lower name]]
      [if [str-contains? lower-name "*"]
        # Contains wildcard — validate per RFC 9525 §6.3.2
        [parts: [str-split "." lower-name]]
        [left-label: [get parts 0]]
        [valid-wildcard?: [and
          [= left-label "*"]           # must be exactly `*`, not `foo*` or `*bar`
          [= [length [filter [fn [let c] [= c "*"]] [str-chars lower-name]]] 1]]]  # only one *
        [if [not valid-wildcard?]
          false  # invalid pattern — ignore per RFC 9525
          [suffix: [str-slice lower-name 1 [length lower-name]]]  # ".example.com"
          [if [ends-with? lower-host suffix]
            [matched: [str-slice lower-host 0 [- [length lower-host] [length suffix]]]]
            [and [not [str-contains? matched "."]]  # single label only
                 [> [length matched] 0]]             # must match at least one char
            false]]
        # Exact match (case-insensitive per RFC 4343)
        [= lower-host lower-name]]]
     names]]

  # cert-valid-for-host?: validate cert validity period and hostname.
  # now-secs: current unix timestamp in seconds (pass [duration-seconds [now %clock]]).
  # Checks (in order):
  #   1. notBefore <= now <= notAfter (RFC 5280 §4.1.2.5)
  #   2. Hostname matches a SAN dNSName entry (RFC 9525 §4.2 — CN fallback prohibited)
  # A cert with no SAN extension is rejected outright — all public CAs have required SANs
  # since 2012 (CA/Browser Forum Baseline Requirements). RFC 9525 (2023) explicitly
  # prohibits CN fallback even when no SAN is present.
  cert-valid-for-host?: [fn [let cert-der@Bytes hostname@String now-secs@Integer]
    [cert: [parse-cert cert-der]]
    [tbs: [extract-tbs cert]]
    # 1. Validity period (RFC 5280 §4.1.2.5)
    [validity-ok?: [match tbs.validity
      [asnValue.AsnSeq items]:
        [nb: [match [get items 0]
          [asnValue.AsnTime s]: [asn-time-to-unix s]
          ...: 0]]
        [na: [match [get items 1]
          [asnValue.AsnTime s]: [asn-time-to-unix s]
          ...: 0]]
        [and [>= now-secs nb] [<= now-secs na]]
      ...: false]]
    [if [not validity-ok?]
      false
      # 2. Identity matching per RFC 9525 — SAN only, no CN fallback
      [san: [cert-san cert-der]]
      # Route by whether hostname is an IP address or a DNS name (RFC 9525 §6.4 vs §6.3)
      [match [try [parse-ip hostname]]
        # IP-ID: exact octet comparison against iPAddress SANs (RFC 9525 §6.4)
        [Result.Ok ip]: [any? [fn [let san-ip] [= ip san-ip]] san.ips]
        # DNS-ID: wildcard-aware case-insensitive match against dNSName SANs (RFC 9525 §6.3)
        [Result.Error _]: [match-hostname? hostname san.dns]]]]

  chain-sigs-valid?: [fn [let chain@[Seq Bytes]]
    [if [<= [length chain] 1]
      true
      [if [not [cert-signed-by? [get chain 0] [get chain 1]]]
        false
        [chain-sigs-valid? [rest chain]]]]]

  # Verify cert is signed by issuer.
  # 1. Parse cert: outer Certificate SEQUENCE has [tbsCertificate, sigAlgorithm, signature]
  # 2. TBS bytes = raw DER of tbsCertificate (re-encode or slice from original DER)
  # 3. Parse issuer cert to get public key from subjectPublicKeyInfo
  # 4. Dispatch on signatureAlgorithm OID to verification primitive
  cert-signed-by?: [fn [let cert-der@Bytes issuer-der@Bytes]
    [cert-asn: [parse-cert cert-der]]   # already parsed as AsnValue
    [issuer-asn: [parse-cert issuer-der]]
    [tbs: [extract-tbs cert-asn]]
    [issuer-tbs: [extract-tbs issuer-asn]]
    # Public key bytes from issuer's subjectPublicKeyInfo.publicKey BIT STRING
    [pub-key: [match issuer-tbs.spki [asnValue.AsnSeq items]: [match [get items 1] [asnValue.AsnBitStr b]: b  ...: [bytes 0]]  ...: [bytes 0]]]
    # Signature is BIT STRING (skip leading 0x00 padding byte)
    [sig-asn: [match cert-asn [asnValue.AsnSeq items]: [get items 2]  ...: [asnValue.AsnBitStr [bytes 0]]]]
    [sig: [match sig-asn [asnValue.AsnBitStr b]: [slice b 1 [length b]]  ...: [bytes 0]]]
    # TBS bytes: in DER the tbsCertificate starts after the outer SEQUENCE header
    # For now dispatch verify-sig with the cert tbs and sig
    # Extract raw TBS DER bytes from cert-der for signature verification.
    # RFC 5280 §4.1: Certificate is SEQUENCE { tbsCertificate, signatureAlgorithm, signatureValue }.
    # TBS bytes = the raw DER encoding of tbsCertificate (first element of the outer SEQUENCE).
    # To extract: skip the outer SEQUENCE tag+length, then take the inner TBS SEQUENCE as raw bytes.
    # Outer SEQUENCE: 0x30 <length> <TBS> <sigAlg> <sigValue>
    # TBS starts at offset 2 (tag 0x30, then length byte(s)); its raw DER is tag+length+content.
    [tbs-tag-off: 2]   # skip outer SEQUENCE tag (0x30) and its length byte(s)
    [outer-len-byte: [get cert-der 1]]
    [tbs-start: [if [= [band outer-len-byte 0x80] 0]
      2                                                # short-form outer length: offset = 2
      [+ 2 [band outer-len-byte 0x7F]]]]              # long-form outer length: skip n-len-bytes
    # TBS element: tag 0x30 at tbs-start, followed by its own length
    [tbs-len-byte: [get cert-der [+ tbs-start 1]]]
    [tbs-content-len: [if [= [band tbs-len-byte 0x80] 0]
      tbs-len-byte
      [decode-be-int cert-der [+ tbs-start 2] [band tbs-len-byte 0x7F]]]]
    [tbs-header-len: [if [= [band tbs-len-byte 0x80] 0]
      2
      [+ 2 [band tbs-len-byte 0x7F]]]]
    [tbs-end: [+ tbs-start tbs-header-len tbs-content-len]]
    [tbs-bytes: [slice cert-der tbs-start tbs-end]]
    [verify-sig pub-key tbs-bytes sig tbs.serial]]

  root-trusted?: [fn [let cert-der@Bytes trust-roots@[or [Seq Bytes] Symbol]]
    [match trust-roots
      [Symbol.SystemRoots]: [builtin-verify-cert-trusted cert-der]
      [let roots@[Seq Bytes]]: [any? [fn [let root] [cert-signed-by? cert-der root]] roots]]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # Hash algorithm selector union for all HKDF calls.
  # The four [type [X]] top-level declarations above define Sha256/Sha384/Sha512/Blake2s.
  HkdfHash: [type [Sha256] [Sha384] [Sha512] [Blake2s]]

  # AsnValue is exported by asn1.llt (included above) — no re-export needed here.

  parse-cert: [fn [let der@Bytes]
    [result: [der-parse-one der 0]]
    [extract-tbs result.value]]

  # cert-san: extract SAN entries from the Subject Alternative Name extension (OID 2.5.29.17).
  # Returns {dns: [Seq String]  ips: [Seq IpAddress]} per RFC 9525 §4.1.
  # DNS names: dNSName context tag [2] (0x82). IP addresses: iPAddress context tag [7] (0x87).
  # No CN fallback — RFC 9525 §6.2.1 prohibits CN-ID entirely.
  cert-san: [fn [let cert-der@Bytes]
    [cert: [parse-cert cert-der]]
    [tbs: [extract-tbs cert]]
    # Extensions are an AsnSeq of AsnSeq(OID, critical?, value) triples.
    # SAN OID = 2.5.29.17 → [2 5 29 17]
    [match tbs.extensions
      [Absent.Absent]: [dns: []  ips: []]   # no SAN extension
      [let ext-seq]:
        # Find the SAN extension bytes using flat-map (the tinct idiom for filter-map).
        # flat-map returns [list x] to keep, [] to skip.
        [san-bytes-list: [flat-map [fn [let ext]
          [match ext
            [asnValue.AsnSeq items]:
              [match [get items 0]
                [asnValue.AsnOid oid]: [if [= oid [2 5 29 17]]
                  [match [last items]
                    [asnValue.AsnOctetStr b]: [list b]   # found SAN bytes
                    ...: []]
                  []]
                ...: []]
            ...: []]]
          [match ext-seq [asnValue.AsnSeq items]: items  ...: []]]]
        [match [head san-bytes-list]
          [Absent.Absent]: [dns: []  ips: []]   # head of [] is Absent
          [let b]:
            # GeneralNames: each entry is a context-tagged value.
            # Tag 0x82 = [2] dNSName (IA5String, RFC 9525 §4.1)
            # Tag 0x87 = [7] iPAddress (raw bytes: 4=IPv4, 16=IPv6, RFC 9525 §4.1)
            # Other tags (SRV-ID 0x88, URI-ID 0x86, etc.) ignored.
            [general-names: [der-parse-seq b 0 []]]
            [dns: [flat-map [fn [let asn]
              [match asn
                [asnValue.AsnStr s]: [list s]   # dNSName (tag 0x82)
                ...: []]]
             general-names]]
            [ips: [flat-map [fn [let asn]
              [match asn
                [asnValue.AsnRaw tag: 0x87  data: b]:
                  [if [= [length b] 4]   [list [IpAddress.Ipv4 b]]
                    [if [= [length b] 16] [list [IpAddress.Ipv6 b]]
                      []]]               # invalid length — skip
                ...: []]]
             general-names]]
            [dns: dns  ips: ips]]]

  # Extract raw public key bytes from subjectPublicKeyInfo.
  cert-public-key: [fn [let cert-der@Bytes]
    [cert: [parse-cert cert-der]]
    [tbs: [extract-tbs cert]]
    [match tbs.spki
      [asnValue.AsnSeq items]:
        [match [get items 1]
          [asnValue.AsnBitStr b]: [slice b 1 [length b]]  # strip leading 0x00 padding byte
          ...: [bytes 0]]
      ...: [bytes 0]]]

  verify-cert-chain: [fn [let chain@[Seq Bytes] trust-roots@[or [Seq Bytes] Symbol] sni@String]
    [if [empty? chain]
      [error "verify-cert-chain: empty chain"]
      # duration-seconds: prelude function that converts Duration to integer seconds.
      # [now %clock] returns the current time as a Duration (milliseconds since epoch).
      [now-secs: [duration-seconds [now %clock]]]
      [and
        [cert-valid-for-host? [get chain 0] sni now-secs]
        [chain-sigs-valid? chain]
        [root-trusted? [get chain [- [length chain] 1]] trust-roots]]]]
]
