# stdlib/protocols/http1.llt — HTTP/1.1 framing (RFC 7230) in tinct.
# Part of: lib-net-v3

[include %libdir "net.llt"]

[type [Http1RequestCodec]]    # zero-payload codec tag — stateless HttpRequest ↔ Bytes codec
[type [Http1ResponseCodec]]   # zero-payload codec tag — stateless HttpResponse ↔ Bytes codec

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  # Verified: get?=✓ (core builtin, returns Absent on missing key), str-slice=✓ (builtin-str-slice)

  # Reject strings containing CR or LF — prevents CRLF injection in HTTP headers.
  validate-no-crlf: [fn [let s@String ctx@String]
    [if [or [str-contains? "\r" s] [str-contains? "\n" s]]
      [error [str "HTTP: CRLF injection attempt in " ctx ": " s]]
      s]]

  # Read until \r\n\r\n. Returns header bytes (separator excluded).
  read-until-crlfcrlf: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [read-until-sep h [] 0]]

  # state: 0=init 1=\r 2=\r\n 3=\r\n\r 4=done
  read-until-sep: [fn@[bind: [h]  constraint: [h: ByteStream]]
                    [let h@h acc@[Seq Bytes] state@Integer]
    [b:    [read h 1]]
    [byte: [get b 0]]
    [next: [match [state byte]
      [0 13]: 1  [1 10]: 2  [2 13]: 3  [3 10]: 4
      [_ 13]: 1  [_ _]:  0]]
    [new-acc: [append [list b] acc]]
    [if [= next 4]
      [reduce concat [] [slice 0 [- [length new-acc] 4] new-acc]]
      [read-until-sep h new-acc next]]]

  parse-header-lines: [fn [let lines@[Seq String]]
    [reduce [fn [let acc line]
      [colon: [str-index-of ":" line]]
      [if [< colon 0]
        acc
        [merge acc
          [[lower [str-trim [str-slice 0 colon line]]]:
           [str-trim [str-slice [+ colon 1] [length line] line]]]]]]]
     []
     lines]]

  parse-http1-response: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [header-str: [bytes-str [read-until-crlfcrlf h]]]
    [lines:      [str-split "\r\n" header-str]]
    [match lines
      []: [error "HTTP/1.1: empty response"]
      [let [status-line ...header-lines]]:
        [status:  [to-int [get [str-split " " status-line] 1]]]
        [headers: [parse-header-lines header-lines]]
        [cl: [get? headers "content-length"]]
        [body-len: [if [null? cl] 0 [to-int cl]]]
        [HttpResponse
          [status:  status
           headers: headers
           body:    [if [> body-len 0] [read h body-len] []]]]]]

  status->text: [fn [let n@Integer]
    [match n
      200: "OK"           201: "Created"        204: "No Content"
      206: "Partial Content"
      301: "Moved Permanently"  302: "Found"   304: "Not Modified"
      400: "Bad Request"  401: "Unauthorized"   403: "Forbidden"
      404: "Not Found"    405: "Method Not Allowed"
      408: "Request Timeout"    409: "Conflict" 410: "Gone"
      413: "Payload Too Large"  422: "Unprocessable Entity"
      429: "Too Many Requests"
      500: "Internal Server Error"  502: "Bad Gateway"  503: "Service Unavailable"
      _:   "Unknown"]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  HttpRequest: [type
    [method:  String
     path:    String
     query:   String
     version: String
     headers: [Map String String]
     body:    Bytes
     respond: [Fn [HttpResponse] Null]]]
  # Server push is a connection-level capability, not a request field.
  # Use push-promise on the Http2Connection from the server event:
  #   [fn [let connection@Http2Connection request@HttpRequest]
  #     [push-promise connection request promise-req push-resp]
  #     [request.respond [ok body]]]

  HttpResponse: [type
    [status:  Int
     headers: [Map String String]
     body:    Bytes]]

  # HttpStream: per-request stream capabilities. Implemented by H2Stream and H3Stream.
  # Absent for HTTP/1.1 — H1 has no stream multiplexing.
  # push:   send PUSH_PROMISE + pushed response (RFC 7540 §8.2, RFC 9114 §4.6)
  # cancel: abort this stream — RST_STREAM (H2) or STOP_SENDING (H3)
  [class [let HttpStream s]
    push:   [Fn@Null [s HttpRequest HttpResponse]]
    cancel: [Fn@Null [s]]]

  # HttpConnection: typeclass for HTTP connections — send requests, receive responses.
  # Implemented by Http2Connection, Http3Connection, Handle (H1).
  [class [let HttpConnection c]
    request: [Fn@[Task HttpResponse] [c HttpRequest]]]

  # Http1RequestCodec: codec for HTTP/1.1 request wire format (RFC 7230).
  # encode: HttpRequest → Bytes (request line + headers + CRLF + body)
  # decode: Bytes → HttpRequest (respond field is a no-op; use parse-request for live connections)
  # Http1RequestCodec declared at top level (zero-payload type)

  # Http1ResponseCodec: codec for HTTP/1.1 response wire format (RFC 7230).
  # encode: HttpResponse → Bytes (status line + headers + CRLF + body)
  # decode: Bytes → HttpResponse
  # Http1ResponseCodec declared at top level (zero-payload type)

  ok:           [fn [let body@String]
    [HttpResponse [status: 200  headers: ["content-type": "text/plain; charset=utf-8"]  body: [str-bytes body]]]]
  json-ok:      [fn [let body@Bytes]
    [HttpResponse [status: 200  headers: ["content-type": "application/json"]  body: body]]]
  redirect:     [fn [let location@String]
    [HttpResponse [status: 302  headers: ["location": location]  body: []]]]
  not-found:    [HttpResponse [status: 404  headers: []  body: [str-bytes "Not Found"]]]
  server-error: [fn [let msg@String]
    [HttpResponse [status: 500  headers: []  body: [str-bytes msg]]]]

  # push-request: construct a synthetic GET HttpRequest for use with stream.push.
  # Server push resources must be GET and cacheable (RFC 7540 §8.2, RFC 9114 §4.6).
  # For custom headers (cache-control, content-type hints, etc.) construct HttpRequest directly.
  # Usage: [stream.push [push-request "/style.css"] [ok-bytes css-content]]
  push-request: [fn [let path@String]
    [HttpRequest [method: "GET"  path: path  query: ""  version: "HTTP/2.0"
                  headers: []  body: [bytes 0]  respond: identity]]]

  parse-request: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h respond@[Fn [HttpResponse] Null]]
    [header-str: [bytes-str [read-until-crlfcrlf h]]]
    [lines:      [str-split "\r\n" header-str]]
    [match lines
      []: [error "HTTP/1.1: empty request"]
      [let [request-line ...header-lines]]:
        [parts: [str-split " " request-line]]
        [if [< [length parts] 3] [error [str "HTTP/1.1: bad request line: " request-line]] null]
        [target:  [get parts 1]
         headers: [parse-header-lines header-lines]
         parts2:  [str-split "?" target]
         path:    [get parts2 0]
         query:   [if [> [length parts2] 1] [get parts2 1] ""]
         cl:      [get? headers "content-length"]
         body-len:[if [null? cl] 0 [to-int cl]]
         [HttpRequest
           [method:  [get parts 0]   path:    path
            query:   query           version: [get parts 2]
            headers: headers         body:    [if [> body-len 0] [read h body-len] []]
            respond: respond
            push:    Absent.Absent]]]]]  # HTTP/1.1 has no server push

  write-response: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h resp@HttpResponse]
    [write h
      [concat
        [str-bytes [str "HTTP/1.1 " resp.status " " [status->text resp.status] "\r\n"]]
        [str-bytes [str "content-length: " [length resp.body] "\r\n"]]
        [reduce concat []
          [map [fn [let e] [str-bytes [str e.key ": " e.value "\r\n"]]]
           [entries resp.headers]]]
        [str-bytes "\r\n"]
        resp.body]]]

  # Serve one HTTP/1.1 connection: parse requests, emit [connection: Handle  request: HttpRequest]
  # pairs to the out channel. connection = the raw Handle (carries client IP via TCP metadata).
  http1-conn: [fn [let h@Handle out@[Channel [connection: Handle  request: HttpRequest]]]
    [step: [fn []
      [match [try [parse-request h [fn [let resp] [write-response h resp]]]]
        [Result.Ok request]:
          [send out [connection: h  request: request]]
          [if [= [get? request.headers "connection"] "close"] [] [step]]
        [Result.Error _]: []]]]
    [step]]

  http1-request: [fn@[bind: [h]  constraint: [h: ByteStream]]
                   [let h@h method@String path@String
                        headers@[Map String String] body@Bytes host@String]
    # Validate inputs — prevent CRLF injection (request smuggling).
    [validate-no-crlf method "method"]
    [validate-no-crlf path "path"]
    [validate-no-crlf host "host"]
    [write h
      [concat
        [str-bytes [str method " " path " HTTP/1.1\r\n"]]
        [str-bytes [str "host: " host "\r\n"]]
        [str-bytes [str "content-length: " [length body] "\r\n"]]
        [str-bytes "connection: close\r\n"]
        [reduce concat []
          [map [fn [let e] [str-bytes [str e.key ": " e.value "\r\n"]]]
           [entries headers]]]
        [str-bytes "\r\n"]
        body]]
    [parse-http1-response h]]

  # http1: 1:N serve layer — each Handle yields a stream of [connection: Handle  request: HttpRequest] pairs.
  # Use with serve: [tcp-listen %net 80] | http1 | [serve handler]
  http1: [_ | [channel-flat-map http1-conn]]
]

# Http1RequestCodec: HttpRequest ↔ Bytes (RFC 7230 request wire format).
# encode: produces "METHOD path?query HTTP/version\r\nheaders\r\n\r\nbody"
# decode: parses request line + headers + body; respond field set to no-op fn.
[instance Codec
  [let a@Http1RequestCodec b@HttpRequest c@Bytes]: [encode: [fn [let _ req@HttpRequest]
    [target: [if [= req.query ""] req.path [str req.path "?" req.query]]]
    [concat
      [str-bytes [str req.method " " target " " req.version "\r\n"]]
      [str-bytes [str "content-length: " [length req.body] "\r\n"]]
      [reduce concat []
        [map [fn [let e] [str-bytes [str e.key ": " e.value "\r\n"]]]
         [entries req.headers]]]
      [str-bytes "\r\n"]
      req.body]]
  decode: [fn [let _ data@Bytes]
    [text:    [bytes-str data]]
    [sep-pos: [str-index-of "\r\n\r\n" text]]
    [if [< sep-pos 0] [error "HTTP/1.1: malformed request (no header terminator)"] null]
    [header-str: [str-slice 0 sep-pos text]]
    [lines:      [str-split "\r\n" header-str]]
    [match lines
      []: [error "HTTP/1.1: empty request"]
      [let [request-line ...header-lines]]:
        [parts:   [str-split " " request-line]]
        [if [< [length parts] 3] [error [str "HTTP/1.1: bad request line: " request-line]] null]
        [target:  [get parts 1]
         headers: [parse-header-lines header-lines]
         parts2:  [str-split "?" target]
         path:    [get parts2 0]
         query:   [if [> [length parts2] 1] [get parts2 1] ""]
         cl:      [get? headers "content-length"]
         body-start: [+ sep-pos 4]
         body:    [if [null? cl] [slice data body-start [length data]]
                    [slice data body-start [+ body-start [to-int cl]]]]
         [HttpRequest
           [method:  [get parts 0]   path:    path
            query:   query           version: [get parts 2]
            headers: headers         body:    body
            respond: [fn [let _] null]]]]]]]]

# Http1ResponseCodec: HttpResponse ↔ Bytes (RFC 7230 response wire format).
# encode: produces "HTTP/1.1 status text\r\nheaders\r\n\r\nbody"
# decode: parses status line + headers + body.
[instance Codec
  [let a@Http1ResponseCodec b@HttpResponse c@Bytes]: [encode: [fn [let _ resp@HttpResponse]
    [concat
      [str-bytes [str "HTTP/1.1 " resp.status " " [status->text resp.status] "\r\n"]]
      [str-bytes [str "content-length: " [length resp.body] "\r\n"]]
      [reduce concat []
        [map [fn [let e] [str-bytes [str e.key ": " e.value "\r\n"]]]
         [entries resp.headers]]]
      [str-bytes "\r\n"]
      resp.body]]
  decode: [fn [let _ data@Bytes]
    [text:    [bytes-str data]]
    [sep-pos: [str-index-of "\r\n\r\n" text]]
    [if [< sep-pos 0] [error "HTTP/1.1: malformed response (no header terminator)"] null]
    [header-str: [str-slice 0 sep-pos text]]
    [lines:      [str-split "\r\n" header-str]]
    [match lines
      []: [error "HTTP/1.1: empty response"]
      [let [status-line ...header-lines]]:
        [status:     [to-int [get [str-split " " status-line] 1]]]
        [headers:    [parse-header-lines header-lines]]
        [cl:         [get? headers "content-length"]]
        [body-start: [+ sep-pos 4]]
        [body:       [if [null? cl] [slice data body-start [length data]]
                       [slice data body-start [+ body-start [to-int cl]]]]]
        [HttpResponse [status: status  headers: headers  body: body]]]]]]
