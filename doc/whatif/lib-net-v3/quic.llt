# stdlib/protocols/quic.llt — QUIC (RFC 9000) + QUIC-TLS (RFC 9001) in tinct.
# Part of: lib-net-v3
# Connection migration (RFC 9000 §9) is NOT supported in the initial implementation.

[include %libdir "net.llt"]
[include %include-dir "tls13.llt"]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  # TODO: verify get? exists in prelude; verify bshl/bnot/pow exist in prelude
  quic-accept-loop: [fn [let sock@UdpSocket out@[Channel QuicConnection]]
    [conns-ch: [channel 1]]
    [send conns-ch []]
    [let step [fn []
      [dg:    [recv-datagram sock]]
      [dcid:  [quic-extract-dcid dg.data]]
      [match [recv conns-ch]
        [Closed]: []
        [Ok table]:
          [if [get? table dcid]
            # Existing connection — deliver datagram to its handler task.
            [[send [get table dcid] dg]
             [send conns-ch table]   # put table back
             [step]]
            # New connection — register it and spawn handler task.
            [conn-ch: [channel 64]]
            [send conns-ch [merge table [dcid: conn-ch]]]   # TODO: dynamic key — needs set or merge with computed key
            [task
              [conn: [quic-new-conn sock dg.src dcid conn-ch]]
              [send out conn]]
            [step]]]]]
    [step]]

  quic-extract-dcid: [fn [let pkt@Bytes]
    [byte0: [get pkt 0]]
    [if [= [bit-and byte0 0x80] 0x80]
      [slice pkt 6 [get pkt 5]]      # long header: dcid-len at byte 5
      [slice pkt 1 20]]]             # short header: 20-byte DCID assumed

  quic-new-conn: [fn [let sock@UdpSocket peer@SocketAddress dcid@Bytes in-ch@[Channel UdpDatagram]]
    [error "TODO: quic-new-conn — process Initial, complete TLS via CRYPTO frames, derive QUIC keys (RFC 9001 §5)"]]

  decode-pn: [fn [let truncated@Int pn-bits@Int largest-acked@Int]
    [expected:  [+ largest-acked 1]]
    [pn-win:    [bshl 1 pn-bits]]
    [pn-hwin:   [/ pn-win 2]]
    [pn-mask:   [- pn-win 1]]
    [candidate: [bit-or [bit-and expected [bnot pn-mask]] truncated]]
    [if [and [<= candidate [- expected pn-hwin]] [< candidate [- [pow 2 62] pn-win]]]
      [+ candidate pn-win]
      [if [and [> candidate [+ expected pn-hwin]] [>= candidate pn-win]]
        [- candidate pn-win]
        candidate]]]

  on-packet-acked:          [fn [let state@QuicLossState pn@Int] [error "TODO: on-packet-acked"]]
  on-loss-detection-timeout:[fn [let state@QuicLossState]       [error "TODO: on-loss-detection-timeout"]]
  detect-lost-packets:      [fn [let state@QuicLossState now@Duration] [error "TODO: detect-lost-packets"]]
  apply-hp:                 [fn [let hp-key@[Bytes 32] header@Bytes sample@[Bytes 16]] [error "TODO: apply-hp — AES-ECB(hp-key, sample) → mask"]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # PendingQuicHandle: QUIC+TLS config accumulated before handshake fires.
  # quic creates it (sni inferred, ALPN open); h3/doq/etc add ALPN via with-alpn then quic-commit.
  PendingQuicHandle: [type
    [pending:     [or ConnectedUdp UdpSocket]
     sni:         [or String Null]    # null = infer from [Hostname h] in peer address
     alpn:        [Seq String]        # set by downstream layer
     ech:         Bytes
     trust-roots: [or [Seq Bytes] Symbol]]]

  QuicPacketType: [union [Initial] [ZeroRTT] [Handshake] [Retry] [OneRTT]]

  QuicFrame: [union
    [Padding       length@Int]
    [Ping]
    [Ack           largest@Int  delay@Int  ranges@[Seq Int]]
    [ResetStream   id@Int  error@Int  final-size@Int]
    [StopSending   id@Int  error@Int]
    [Crypto        offset@Int  data@Bytes]
    [NewToken      token@Bytes]
    [Stream        id@Int  offset@Int  fin@Bool  data@Bytes]
    [MaxData       max@Int]
    [MaxStreamData id@Int  max@Int]
    [MaxStreams    bidi@Bool  max@Int]
    [DataBlocked   limit@Int]
    [ConnectionClose  error@Int  frame-type@Int  reason@String]
    [HandshakeDone]]

  QuicKeys: [type
    [send-key: [Bytes 32]  send-iv: [Bytes 12]
     recv-key: [Bytes 32]  recv-iv: [Bytes 12]
     hp-key:   [Bytes 32]]]

  QuicLossState: [type
    [largest-acked: Int
     sent-packets:  [Map Int QuicSentPacket]
     loss-time:     [or Duration Null]
     pto-count:     Int]]

  QuicSentPacket: [type
    [packet-number: Int
     sent-time:     Duration
     ack-eliciting: Bool
     frames:        [Seq QuicFrame]]]

  QuicFlowState: [type
    [send-window:     Int
     recv-window:     Int
     send-blocked-at: [or Int Null]]]

  QuicStream: [type
    [id:       Int
     readable: [Channel Bytes]
     writable: [Channel Bytes]]]

  QuicConnection: [type
    [socket:        UdpSocket
     peer-addr:     SocketAddress
     scid:          Bytes
     dcid:          Bytes
     streams:       [Channel QuicStream]
     tls-in:        [Channel Bytes]
     tls-out:       [Channel Bytes]
     pn-initial:    [Channel Int]
     pn-handshake:  [Channel Int]
     pn-app:        [Channel Int]
     initial-keys:  [or QuicKeys Null]
     handshake-keys:[or QuicKeys Null]
     app-keys:      [or QuicKeys Null]
     loss-state:    QuicLossState
     flow:          QuicFlowState]]

  # quic — QUIC pending layer. Subject-last: sock last.
  # Creates PendingQuicHandle — sni inferred from [Hostname h], ALPN open.
  # The downstream layer (h3, dns-quic-resolver, etc.) adds alpn before commit fires.
  # Usage: [connect %net [Hostname h] Udp 443] | quic | h3 | [request req]
  quic: [fn@[bind: [d]  constraint: [d: Datagram]  return: PendingQuicHandle]
          [let sock@d]
    [PendingQuicHandle
      [pending: sock
       sni:     null          # infer from [Hostname h] in sock peer
       alpn:    []            # set by downstream layer (h3, doq, etc.)
       ech:     []
       trust-roots: SystemRoots]]]

  # quic-commit: fire the QUIC+TLS handshake with accumulated config.
  quic-commit: [fn [let pqh@PendingQuicHandle]
    [error "TODO: quic-commit — resolve sni, generate SCID, send Initial + ClientHello, complete TLS 1.3, install 1-RTT keys → QuicConnection"]]

  # with-alpn: accumulate ALPN into a PendingQuicHandle before commit.
  with-alpn: [fn [let pqh@PendingQuicHandle alpn@[Seq String]]
    [PendingQuicHandle [pending: pqh.pending  sni: pqh.sni  alpn: alpn
                        ech: pqh.ech  trust-roots: pqh.trust-roots]]]

  # quic-connect: sugar for a resolved SocketAddress (skips DNS + HostPort).
  # For hostname-based connections prefer: [connect %net Udp [HostPort [Hostname h] port]] | quic | h3
  quic-connect: [fn [let cap@NetCap addr@SocketAddress cfg@TlsClientConfig]
    [quic-commit
      [PendingQuicHandle
        [pending: [ConnectedUdp
                    [sock: [udp-socket cap [IpBind [addr: [Ipv4 [0 0 0 0]] port: 0]]]
                     peer: addr]]
         sni: cfg.sni  alpn: cfg.alpn  ech: cfg.ech  trust-roots: cfg.trust-roots]]]]

  quic-listen: [fn [let cap@NetCap port@Port]
    [sock: [udp-socket cap [IpBind [addr: [Ipv4 [0 0 0 0]] port: port]]]]
    [out:  [channel 64]]
    [task [quic-accept-loop sock out]]
    out]

  quic-open-stream: [fn [let conn@QuicConnection]
    [error "TODO: quic-open-stream — allocate next client bidi stream ID, send STREAM frame, return Handle"]]

  quic-incoming: [fn [let conn@QuicConnection]
    # Returns [Ok QuicStream] | [Closed] — caller must match both cases.
    [recv conn.streams]]

  # Stream adapter: open one QUIC stream per incoming connection.
  quic-stream-ch: [_ | [channel-map [fn [let c] [quic-open-stream c]]]]
]
