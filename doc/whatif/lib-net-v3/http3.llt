# stdlib/protocols/http3.llt — HTTP/3 (RFC 9114) + QPACK (RFC 9204) in tinct.
# Part of: lib-net-v3

[include %include-dir "quic.llt"]
[include %include-dir "http1.llt"]

[type [H3FrameCodec]]   # zero-payload codec tag — stateless H3Frame ↔ Bytes codec

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  # RFC 9000 §16: QUIC variable-length integer encoding.
  # 2-bit prefix: 0=1byte(6-bit), 1=2byte(14-bit), 2=4byte(30-bit), 3=8byte(62-bit).
  read-varint: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [b0: [get [read-bytes h 1] 0]]
    [prefix: [shr [band b0 0xC0] 6]]
    [match prefix
      0: [band b0 0x3F]
      1: [bor [shl [band b0 0x3F] 8] [get [read-bytes h 1] 0]]
      2: [band [uint32 BigEndian [concat [bytes BigEndian [@UInt8 b0]] [read-bytes h 3]]] 0x3FFFFFFF]
      3: [band [uint64 BigEndian [concat [bytes BigEndian [@UInt8 b0]] [read-bytes h 7]]] 0x3FFFFFFFFFFFFFFF]
      _: [error "unreachable"]]]

  # Encode n as QUIC variable-length integer. Chooses minimum-width encoding.
  encode-varint: [fn [let n@Int]
    [if [<= n 63]
      [bytes BigEndian [@UInt8 n]]
      [if [<= n 16383]
        [bytes BigEndian [@UInt16 [bor 0x4000 n]]]
        [if [<= n 1073741823]
          [bytes BigEndian [@UInt32 [bor 0x80000000 n]]]
          [bytes BigEndian [@UInt64 [bor 0xC000000000000000 n]]]]]]]

  # RFC 9204 §4: QPACK integer decode (same algorithm as HPACK RFC 7541 §5.1).
  qpack-decode-int: [fn [let data@Bytes offset@Int prefix-bits@Int]
    [mask:  [- [shl 1 prefix-bits] 1]]
    [first: [band [get data offset] mask]]
    [if [< first mask]
      [value: first  next: [+ offset 1]]
      [let read-multi [fn [i acc]
        [b:       [get data [+ offset 1 i]]]
        [new-acc: [+ acc [shl [band b 0x7F] [* i 7]]]]
        [if [= [band b 0x80] 0]
          [value: [+ mask new-acc]  next: [+ offset 2 i]]
          [read-multi [+ i 1] new-acc]]]]
      [read-multi 0 0]]]

  # RFC 9204 §4: QPACK string decode (literal UTF-8; Huffman not required for static-only).
  qpack-decode-str: [fn [let data@Bytes offset@Int]
    [b0:      [get data offset]]
    [huffman: [= [band b0 0x80] 0x80]]
    [len-res: [qpack-decode-int data offset 7]]
    [raw:     [slice data len-res.next [+ len-res.next len-res.value]]]
    [next:    [+ len-res.next len-res.value]]
    # For static-only QPACK, Huffman is not expected; if encountered, error gracefully.
    [str:     [if huffman [error "QPACK: Huffman-encoded strings not supported"] [bytes-str raw]]]
    [value: str  next: next]]

  int->h3-frame-type: [fn [let n@Int]
    [match n
      0: H3FrameType.H3Data   1: H3FrameType.H3Headers   3: H3FrameType.H3CancelPush
      4: H3FrameType.H3Settings  5: H3FrameType.H3PushPromise
      7: H3FrameType.H3Goaway    13: H3FrameType.H3MaxPushId
      _: [error [str "HTTP/3: unknown frame type: " n]]]]

  h3-frame-type->int: [fn [let t@H3FrameType]
    [match t
      [H3FrameType.H3Data]: 0    [H3FrameType.H3Headers]: 1    [H3FrameType.H3CancelPush]: 3
      [H3FrameType.H3Settings]: 4  [H3FrameType.H3PushPromise]: 5
      [H3FrameType.H3Goaway]: 7  [H3FrameType.H3MaxPushId]: 13]]

  read-h3-frame: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [H3Frame
      [type:    [int->h3-frame-type [read-varint h]]
       payload: [read-bytes h [read-varint h]]]]]

  write-h3-frame: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h frame@H3Frame]
    [write-bytes h
      [concat
        [encode-varint [h3-frame-type->int frame.type]]
        [encode-varint [length frame.payload]]
        frame.payload]]]
]

# HttpConnect instance for Http3Connection.
[instance [HttpConnect Http3Connection]
  request: request]

# QPACK codec: HTTP/3 header compression (RFC 9204).
# encode: headers → QPACK-encoded Bytes; decode: QPACK Bytes → headers.
[instance [Codec QpackCodec Headers Bytes]
  encode: qpack-encode
  decode: qpack-decode]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  H3FrameType: [union
    [H3Data] [H3Headers] [H3CancelPush] [H3Settings] [H3PushPromise] [H3Goaway] [H3MaxPushId]]

  H3Frame: [type [type: H3FrameType  payload: Bytes]]

  # H3FrameCodec: codec for HTTP/3 frame wire format (RFC 9114 §7).
  # encode: H3Frame → varint(type) ++ varint(length) ++ payload bytes
  # decode: Bytes → H3Frame by parsing type varint, length varint, then payload
  # H3FrameCodec declared at top level (zero-payload type)

  # RFC 9114 §4 HTTP/3 SETTINGS parameters — a record of typed optional fields, not a map.
  Http3Settings: [type
    [qpack-max-table-size:    [or UInt32 Absent]   # SETTINGS_QPACK_MAX_TABLE_CAPACITY (default 0)
     max-field-section-size:  [or UInt32 Absent]]] # SETTINGS_MAX_FIELD_SECTION_SIZE (default unlimited)

  Http3Connection: [type
    [quic:         QuicConnection
     control-send: QuicStream
     control-recv: QuicStream
     qpack-enc:    QuicStream
     qpack-dec:    QuicStream
     settings:     Http3Settings]]

  # RFC 9114 §6: HTTP/3 connection setup.
  # Both endpoints: open control stream (stream type 0x00) and two QPACK streams (0x02, 0x03).
  # Send SETTINGS frame on control stream; receive peer SETTINGS.
  h3-accept: [fn [let conn@QuicConnection]
    # Open server-side streams: control (type 0x00), QPACK encoder (0x02), decoder (0x03)
    [ctrl-send:  [quic-open-stream conn]]   # server control stream
    [qpack-enc:  [quic-open-stream conn]]   # QPACK encoder stream
    [qpack-dec:  [quic-open-stream conn]]   # QPACK decoder stream
    # Announce stream types
    [write-bytes ctrl-send  [bytes BigEndian [@UInt8 0x00]]]
    [write-bytes qpack-enc  [bytes BigEndian [@UInt8 0x02]]]
    [write-bytes qpack-dec  [bytes BigEndian [@UInt8 0x03]]]
    # Send SETTINGS frame (empty → all defaults; RFC 9114 §7.2.4)
    [settings-payload: [bytes BigEndian [@UInt8 0]]]
    [write-bytes ctrl-send [concat [encode-varint 4] [encode-varint [length settings-payload]] settings-payload]]
    # Read peer control stream, receive peer SETTINGS
    # Peer sends control stream first with stream type byte (0x00), then SETTINGS frame
    [ctrl-recv: [match [recv conn.substreams]
      [Closed.Closed]: [error "HTTP/3: QUIC connection closed before peer control stream"]
      [Result.Ok s]:   s]]
    # Read peer stream type byte (must be 0x00 = control stream)
    [peer-stream-type: [read-varint ctrl-recv]]
    [if [not [= peer-stream-type 0]] [error "HTTP/3: expected control stream (type 0x00)"] null]
    # Read peer SETTINGS frame: type varint (4) + length varint + payload
    [settings-type:   [read-varint ctrl-recv]]
    [if [not [= settings-type 4]] [error "HTTP/3: expected SETTINGS frame on control stream"] null]
    [settings-len:    [read-varint ctrl-recv]]
    [settings-bytes:  [read-bytes ctrl-recv settings-len]]
    # Parse SETTINGS key-value pairs: each is varint id + varint value
    [let parse-settings [fn [offset qpack-max-table-size max-field-section-size]
      [if [>= offset settings-len]
        [Http3Settings
          qpack-max-table-size: qpack-max-table-size
          max-field-section-size: max-field-section-size]
        [id-res: [qpack-decode-int settings-bytes offset 8]]  # varint — use qpack int decode
        [val-res: [qpack-decode-int settings-bytes id-res.next 8]]
        [match id-res.value
          1:  [parse-settings val-res.next qpack-max-table-size val-res.value]   # MAX_FIELD_SECTION_SIZE
          6:  [parse-settings val-res.next val-res.value max-field-section-size]  # QPACK_MAX_TABLE_CAPACITY
          7:  [parse-settings val-res.next qpack-max-table-size max-field-section-size]  # QPACK_BLOCKED_STREAMS (ignored)
          _:  [parse-settings val-res.next qpack-max-table-size max-field-section-size]]]]]   # unknown: skip
    [peer-settings: [parse-settings 0 Absent.Absent Absent.Absent]]
    # Receive peer QPACK encoder and decoder streams (next two incoming streams)
    [peer-qpack-enc: [match [recv conn.substreams]
      [Closed.Closed]: [error "HTTP/3: QUIC closed before QPACK encoder stream"]
      [Result.Ok s]:   s]]
    [peer-qpack-dec: [match [recv conn.substreams]
      [Closed.Closed]: [error "HTTP/3: QUIC closed before QPACK decoder stream"]
      [Result.Ok s]:   s]]
    [Http3Connection
      quic:         conn
      control-send: ctrl-send
      control-recv: ctrl-recv
      qpack-enc:    qpack-enc
      qpack-dec:    qpack-dec
      settings:     peer-settings]]

  # h3: fires the QUIC+TLS handshake (adding alpn: ["h3"]) then sets up HTTP/3 substreams.
  # Receives QuicHandle from | quic, not a committed QuicConnection.
  h3: [fn [let pqh@QuicHandle]
    [match [quic-commit [with-alpn pqh ["h3"]]]
      [QuicError e]:  e
      [Result.Ok conn]: [h3-accept conn]]]   # quic-commit then h3-accept

  http3-client: [fn [let conn@QuicConnection] [h3 conn]]

  # RFC 9114 §4.1: open new QUIC stream, send HEADERS frame with qpack-encode headers,
  # send DATA frame if body, await response HEADERS+DATA frames.
  request: [fn [let conn@Http3Connection req@RawRequest]
    [task
      [stream: [quic-open-stream conn.quic]]
      # Send HEADERS frame: frame-type=1 (varint) + length (varint) + qpack-encoded headers
      [headers-bytes: [qpack-encode req.headers]]
      [write-bytes stream [concat [encode-varint 1] [encode-varint [length headers-bytes]] headers-bytes]]
      # Send DATA frame if body non-empty: frame-type=0 + length + body
      [if [> [length req.body] 0]
        [write-bytes stream [concat [encode-varint 0] [encode-varint [length req.body]] req.body]]
        null]
      # Read response: HEADERS frame then DATA frames
      [resp-type: [read-varint stream]]
      [resp-len:  [read-varint stream]]
      [resp-headers-bytes: [read-bytes stream resp-len]]
      [resp-headers: [qpack-decode resp-headers-bytes]]
      [status: [int-of-str [or [get? resp-headers ":status"] "200"]]]
      # Accumulate DATA frames (type 0) until stream end (Closed.Closed from read-varint)
      # Stream ends when peer closes the writable side — read-bytes will signal via error/eof.
      [let accumulate-data [fn [acc]
        [match [try [read-varint stream]]
          [Result.Error _]:  acc   # stream closed — done
          [Result.Ok ft]:
            [flen: [read-varint stream]]
            [if [= ft 0]   # DATA frame
              [chunk: [read-bytes stream flen]]
              [accumulate-data [concat acc chunk]]
              # Non-DATA frame on response stream (e.g. trailing HEADERS, PUSH_PROMISE) — skip
              [_ : [read-bytes stream flen]]
              [accumulate-data acc]]]]]
      [resp-body: [accumulate-data [bytes 0]]]
      [RawResponse
        status:  status
        headers: resp-headers
        body:    resp-body]]]

  # Drain incoming QUIC streams, parse HEADERS, emit RawRequest with respond fn.
  http3-req-conn: [fn [let conn@Http3Connection out@[Channel RawRequest]]
    [task [let step [fn []
      [match [recv conn.quic.substreams]
        [Closed.Closed]: []
        [Result.Ok stream]:
          [task
            [frame-type: [read-varint stream]]
            [frame-len:  [read-varint stream]]
            [if [= frame-type 1]   # HEADERS frame
              [headers-bytes: [read-bytes stream frame-len]]
              [headers: [qpack-decode headers-bytes]]
              [send out [RawRequest
                method:  [or [get? headers ":method"] "GET"]
                path:    [or [get? headers ":path"]   "/"]
                headers: headers
                body:    [bytes 0]
                respond: [fn [let resp]
                  [resp-bytes: [qpack-encode resp.headers]]
                  [write-bytes stream [concat [encode-varint 1] [encode-varint [length resp-bytes]] resp-bytes]]
                  [if [> [length resp.body] 0]
                    [write-bytes stream [concat [encode-varint 0] [encode-varint [length resp.body]] resp.body]]
                    null]]]]
              null]]
          [step]]]]]

  h3-open-stream: [fn [let conn@Http3Connection]
    [quic-open-stream conn.quic]]

  h3-stream-ch: [fn [let ch@[Channel Http3Connection]]
    [channel-map [fn [let conn] [h3-open-stream conn]] ch]]

  # RFC 9204 §3.2.1: QPACK header block begins with Required Insert Count (varint) + S bit + Delta Base (varint).
  # For literal-only encoding (no dynamic table): both are 0, remainder is field lines per §4.5.
  # Field line encoding same as HPACK §6 but with QPACK-specific prefix bits.
  #
  # QPACK static table (RFC 9204 Appendix A) — 99 entries indexed 0-98.
  # Format: [name, value] — same as HPACK static table but different entries.
  qpack-static-table: [
    [":authority" ""]                      [":path" "/"]                     ["age" "0"]
    ["content-disposition" ""]             ["content-length" "0"]            ["cookie" ""]
    ["date" ""]                            ["etag" ""]                       ["if-modified-since" ""]
    ["if-none-match" ""]                   ["last-modified" ""]              ["link" ""]
    ["location" ""]                        ["referer" ""]                    ["set-cookie" ""]
    [":method" "CONNECT"]                  [":method" "DELETE"]              [":method" "GET"]
    [":method" "HEAD"]                     [":method" "OPTIONS"]             [":method" "POST"]
    [":method" "PUT"]                      [":scheme" "http"]                [":scheme" "https"]
    [":status" "103"]                      [":status" "200"]                 [":status" "304"]
    [":status" "404"]                      [":status" "503"]                 ["accept" "*/*"]
    ["accept" "application/dns-message"]  ["accept-encoding" "gzip, deflate, br"]  ["accept-ranges" "bytes"]
    ["access-control-allow-headers" "cache-control"]  ["access-control-allow-headers" "content-type"]
    ["access-control-allow-origin" "*"]   ["cache-control" "max-age=0"]    ["cache-control" "max-age=2592000"]
    ["cache-control" "max-age=604800"]    ["cache-control" "no-cache"]     ["cache-control" "no-store"]
    ["cache-control" "public, max-age=31536000"]  ["content-encoding" "br"]  ["content-encoding" "gzip"]
    ["content-type" "application/dns-message"]    ["content-type" "application/javascript"]
    ["content-type" "application/json"]           ["content-type" "application/x-www-form-urlencoded"]
    ["content-type" "image/gif"]                  ["content-type" "image/jpeg"]
    ["content-type" "image/png"]                  ["content-type" "text/css"]
    ["content-type" "text/html; charset=utf-8"]   ["content-type" "text/plain"]
    ["content-type" "text/plain;charset=utf-8"]   ["range" "bytes=0-"]
    ["strict-transport-security" "max-age=31536000"]
    ["strict-transport-security" "max-age=31536000; includesubdomains"]
    ["strict-transport-security" "max-age=31536000; includesubdomains; preload"]
    ["vary" "accept-encoding"]            ["vary" "origin"]                 ["x-content-type-options" "nosniff"]
    ["x-xss-protection" "1; mode=block"] [":status" "100"]                 [":status" "204"]
    [":status" "206"]                     [":status" "302"]                 [":status" "400"]
    [":status" "403"]                     [":status" "421"]                 [":status" "425"]
    [":status" "500"]                     ["accept-language" ""]            ["access-control-allow-credentials" "FALSE"]
    ["access-control-allow-credentials" "TRUE"]  ["access-control-allow-headers" "*"]
    ["access-control-allow-methods" "get"]  ["access-control-allow-methods" "get, post, options"]
    ["access-control-allow-methods" "options"]  ["access-control-expose-headers" "content-length"]
    ["access-control-request-headers" "content-type"]  ["access-control-request-method" "get"]
    ["access-control-request-method" "post"]  ["alt-svc" "clear"]           ["authorization" ""]
    ["content-security-policy" "script-src 'none'; object-src 'none'; base-uri 'none'"]
    ["early-data" "1"]                    ["expect-ct" ""]                  ["forwarded" ""]
    ["if-range" ""]                       ["origin" ""]
    ["purpose" "prefetch"]                ["server" ""]
    ["timing-allow-origin" "*"]           ["upgrade-insecure-requests" "1"]
    ["user-agent" ""]                     ["x-forwarded-for" ""]            ["x-frame-options" "deny"]
    ["x-frame-options" "sameorigin"]]

  qpack-decode: [fn [let data@Bytes]
    # RFC 9204 §3.2.1: skip Required Insert Count (varint) and S+DeltaBase (varint)
    # Both are 0 for static-only / literal-only encoded blocks.
    [ric-res:  [qpack-decode-int data 0 8]]    # Required Insert Count (8-bit prefix varint)
    [sdb-res:  [qpack-decode-int data ric-res.next 7]]  # S bit (1) + Delta Base (7-bit prefix)
    # Parse field lines starting at sdb-res.next
    [let decode-loop [fn [offset headers]
      [if [>= offset [length data]]
        headers
        [b0: [get data offset]]
        [if [= [band b0 0x80] 0x80]
          # §4.5.2: Indexed Field Line — bit 7=1, bit 6=T (static), 6-bit index
          [t-static: [= [band b0 0x40] 0x40]]
          [idx-res: [qpack-decode-int data offset 6]]
          [entry: [if t-static [get qpack-static-table idx-res.value] [error "QPACK: dynamic table not supported"]]]
          [name: [get entry 0]  value: [get entry 1]]
          [decode-loop idx-res.next [merge headers {$name: value}]]
          [if [= [band b0 0x40] 0x40]
            # §4.5.4: Literal Field Line With Name Reference — bit 7=0, bit 6=1, bit 4=T (static), 4-bit index
            [t-static: [= [band b0 0x10] 0x10]]
            [idx-res:  [qpack-decode-int data offset 4]]
            [name:     [if t-static
              [get [get qpack-static-table idx-res.value] 0]
              [error "QPACK: dynamic name reference not supported"]]]
            [v-res:    [qpack-decode-str data idx-res.next]]
            [decode-loop v-res.next [merge headers {$name: v-res.value}]]
            # §4.5.6: Literal Field Line Without Name Reference — bit 7=0, bit 6=0, bit 5=1 (0x20 prefix)
            [n-res: [qpack-decode-str data [+ offset 1]]]   # skip the 0x20 prefix byte
            [v-res: [qpack-decode-str data n-res.next]]
            [decode-loop v-res.next [merge headers {$n-res.value: v-res.value}]]]]]]
    [decode-loop sdb-res.next {}]]

  # Safe literal-only encoding: Required Insert Count=0, S=0, Delta Base=0 (3 zero bytes),
  # then each header as literal field line without name reference (RFC 9204 §4.5.3).
  # Bit pattern: 0b0010_0000 (0x20) | name-ref=0x00 | name-len | name | value-len | value.
  qpack-encode: [fn [let headers@[Map String String]]
    [prefix: [concat [bytes BigEndian [@UInt8 0]] [bytes BigEndian [@UInt8 0]]]]  # RIC=0, S+DeltaBase=0
    [fields: [apply concat [map-kv [fn [let k v]
      [k-bytes: [str-bytes k]  v-bytes: [str-bytes v]]
      [concat [bytes BigEndian [@UInt8 0x20]]   # literal without name reference
              [encode-varint [length k-bytes]] k-bytes
              [encode-varint [length v-bytes]] v-bytes]]
     headers]]]
    [concat prefix fields]]

  # Serve layer: promote each incoming QUIC connection to an Http3Connection.
  h3-serve: [_ | [channel-map h3-accept]]

  # Request-extraction: each Http3Connection yields its request substreams.
  http3-requests: [_ | [channel-flat-map http3-req-conn]]
]

# H3FrameCodec: H3Frame ↔ Bytes (RFC 9114 §7 frame wire format).
# encode: serializes H3Frame as varint(type) ++ varint(length) ++ payload
# decode: parses bytes as QUIC varint(type) + QUIC varint(length) + payload → H3Frame
# parse-varint-at: RFC 9000 §16 QUIC variable-length integer decode from Bytes at offset.
# Returns {value next} where next is the offset of the first byte after the varint.
[instance [Codec H3FrameCodec H3Frame Bytes]
  encode: [fn [let _ frame@H3Frame]
    [concat
      [encode-varint [h3-frame-type->int frame.type]]
      [encode-varint [length frame.payload]]
      frame.payload]]
  decode: [fn [let _ data@Bytes]
    [let parse-varint-at [fn [b offset]
      [b0:     [get b offset]]
      [prefix: [shr [band b0 0xC0] 6]]
      [match prefix
        0: [value: [band b0 0x3F]  next: [+ offset 1]]
        1: [value: [bor [shl [band b0 0x3F] 8] [get b [+ offset 1]]]  next: [+ offset 2]]
        2: [value: [bor [shl [band b0 0x3F] 24]
                        [bor [shl [get b [+ offset 1]] 16]
                             [bor [shl [get b [+ offset 2]] 8] [get b [+ offset 3]]]]]
                   next: [+ offset 4]]
        3: [value: [bor [shl [band b0 0x3F] 56]
                        [bor [shl [get b [+ offset 1]] 48]
                             [bor [shl [get b [+ offset 2]] 40]
                                  [bor [shl [get b [+ offset 3]] 32]
                                       [bor [shl [get b [+ offset 4]] 24]
                                            [bor [shl [get b [+ offset 5]] 16]
                                                 [bor [shl [get b [+ offset 6]] 8] [get b [+ offset 7]]]]]]]]]
                   next: [+ offset 8]]
        _: [error "H3FrameCodec: unreachable varint prefix"]]]]
    [type-res: [parse-varint-at data 0]]
    [len-res:  [parse-varint-at data type-res.next]]
    [H3Frame
      [type:    [int->h3-frame-type type-res.value]
       payload: [slice data len-res.next [+ len-res.next len-res.value]]]]]]]]

# ── H3Layer typeclass — bidirectional h3 ─────────────────────────────────────

[class [H3Layer input output]
  h3: [Fn@output [input]]]

# Client: QuicHandle → Http3Connection (fires QUIC+TLS with alpn:["h3"] + H3 setup)
[instance [H3Layer QuicHandle Http3Connection]
  h3: [fn [let qh@QuicHandle] [h3 qh]]]   # delegates to h3 function above

# Server: Channel@QuicConnection → Channel@Http3Connection
[instance [H3Layer [Channel QuicConnection] [Channel Http3Connection]]
  h3: [fn [let ch@[Channel QuicConnection]]
    [channel-map h3-accept ch]]]

# ── HttpStream Http3Connection ────────────────────────────────────────────────

[instance [HttpStream Http3Connection]
  send: [fn [let conn@Http3Connection req@RawRequest]
    [request req conn]]   # delegates to request above
  recv: [fn [let conn@Http3Connection]
    [conn.quic.substreams]]]  # incoming QUIC streams

[instance [HttpStream [Channel Http3Connection]]
  send: [error "not applicable: Channel@Http3Connection is receive-only"]
  recv: [fn [let ch@[Channel Http3Connection]]
    [channel-flat-map http3-req-conn ch]]]

# ── Multiplexed Http3Connection ───────────────────────────────────────────────

[instance [Multiplexed Http3Connection QuicStream]
  substreams: [fn [let ch@[Channel Http3Connection]]
    [channel-map h3-open-stream ch]]]
