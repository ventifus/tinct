# stdlib/protocols/tls13.llt — TLS 1.3 (RFC 8446) in tinct.
# Part of: lib-net-v3
# Rust primitives: chacha20-poly1305-seal/open, aes-128/256-gcm-seal/open,
#   x25519-keypair, x25519-dh, p256-keypair, hkdf-extract, hkdf-expand,
#   hmac-sha256, sha256, crypto-random, bytes-xor, rsa-pss-sign, p256-sign, ed25519-sign
--- uses: ["crypto"]

[include %libdir "net.llt"]
[include %libdir "crypto.llt"]   # provides HkdfHash, Sha256, Sha384, Sha512, Blake2s

[instance@[bind: [h]] [ByteStream [TlsConnection h]]
  read-bytes:  tls-read-bytes
  write-bytes: tls-write-bytes]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  int->ct: [fn [let n@Int]
    [match n 20: [ChangeCipherSpec] 21: [Alert] 22: [Handshake] 23: [ApplicationData]
                 _: [error [str "TLS: unknown content type: " n]]]]

  ct->int: [fn [let ct@ContentType]
    [match ct [ChangeCipherSpec]: 20  [Alert]: 21  [Handshake]: 22  [ApplicationData]: 23]]

  read-tls-record: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [header: [read-bytes h 5]]
    [len: [+ [* [get header 3] 256] [get header 4]]]
    [if [> len 16640] [error [str "TLS: record too large: " len]] null]  # RFC 8446 §5.2: max 2^14+256
    [TlsRecord [content-type: [int->ct [get header 0]]  payload: [read-bytes h len]]]]

  write-tls-record: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h r@TlsRecord]
    [len: [length r.payload]]
    [write-bytes h
      [concat
        [bytes [ct->int r.content-type]]
        [0x03 0x03]
        [bytes [/ len 256]]
        [bytes [mod len 256]]
        r.payload]]]

  tls-nonce: [fn [let iv@[Bytes 12] seq@Int]
    [bytes-xor iv [concat [0x00 0x00 0x00 0x00] [encode BigEndian [@UInt64 seq]]]]]

  # aad: RFC 8446 §5.2 additional data = 5-byte TLSCiphertext header.
  # Must be 0x17 0x03 0x03 || ciphertext-length(2). Passed explicitly so both
  # seal and open share the same construction and authenticate the record framing.
  tls-seal: [fn [let conn@TlsConnection plain@Bytes nonce@[Bytes 12] aad@Bytes]
    [match conn.cipher
      [Chacha20Poly1305Sha256]: [chacha20-poly1305-seal conn.write-key nonce plain aad]
      [Aes128GcmSha256]:        [aes-128-gcm-seal       conn.write-key nonce plain aad]
      [Aes256GcmSha384]:        [aes-256-gcm-seal       conn.write-key nonce plain aad]]]

  tls-open: [fn [let conn@TlsConnection ct@Bytes nonce@[Bytes 12] aad@Bytes]
    [match [match conn.cipher
      [Chacha20Poly1305Sha256]: [chacha20-poly1305-open conn.read-key nonce ct aad]
      [Aes128GcmSha256]:        [aes-128-gcm-open       conn.read-key nonce ct aad]
      [Aes256GcmSha384]:        [aes-256-gcm-open       conn.read-key nonce ct aad]]
      [Ok p]:  p
      [Err _]: [error "TLS: AEAD decryption failed"]]]

  # aad = 0x17 0x03 0x03 || ciphertext-length(2).
  # Ciphertext length = inner-plaintext length + 16 (AEAD tag). Known before encrypt.
  tls-record-aad: [fn [let ct-len@Int]
    [concat [bytes 0x17] [0x03 0x03] [encode BigEndian [@UInt16 ct-len]]]]

  tls-write-record: [fn [let conn@TlsConnection ct@ContentType plain@Bytes]
    # write-seq channel holds exactly one value (atomic counter). [Closed] is impossible.
    [match [recv conn.write-seq]
      [Closed]: [error "TLS: write-seq channel closed unexpectedly"]
      [Ok seq]:
        [send conn.write-seq [+ seq 1]]
        [inner:  [concat plain [bytes [ct->int ct]]]]    # inner = data || content-type byte
        [ct-len: [+ [length inner] 16]]                  # ciphertext = inner + 16-byte tag
        [aad:    [tls-record-aad ct-len]]
        [ciphertext: [tls-seal conn inner [tls-nonce conn.write-iv seq] aad]]
        [write-tls-record conn.underlying
          [TlsRecord [content-type: [ApplicationData]  payload: ciphertext]]]]]

  # tls-decrypt-conn-record: decrypt a TlsRecord using connection keys + sequence counter.
  # Named tls-decrypt-conn-record (not tls-decrypt-record) to avoid collision with any
  # stateless Bytes→Bytes stub. Used internally by tls-read-acc and tls-recv-record.
  tls-decrypt-conn-record: [fn [let conn@TlsConnection record@TlsRecord]
    # read-seq channel holds exactly one value (atomic counter). [Closed] is impossible.
    [match [recv conn.read-seq]
      [Closed]: [error "TLS: read-seq channel closed unexpectedly"]
      [Ok seq]:
        [send conn.read-seq [+ seq 1]]
        [aad: [tls-record-aad [length record.payload]]]  # ciphertext length is payload length
        [plain: [tls-open conn record.payload [tls-nonce conn.read-iv seq] aad]]
        [strip-inner-ct plain]]]

  strip-inner-ct: [fn [let plain@Bytes]
    [find-last-nonzero plain [- [length plain] 1]]]

  find-last-nonzero: [fn [let b@Bytes i@Int]
    [if [< i 0]
      [error "TLS: all-zero decrypted record"]
      [if [= [get b i] 0]
        [find-last-nonzero b [- i 1]]
        [slice 0 i b]]]]

  tls-read-acc: [fn [let conn@TlsConnection remaining@Int acc@[Seq Bytes]]
    [if [= remaining 0]
      [reduce concat [] acc]
      [plain: [tls-decrypt-conn-record conn [read-tls-record conn.underlying]]]
      [got:   [min remaining [length plain]]]
      [tls-read-acc conn [- remaining got] [append [list [slice 0 got plain]] acc]]]]

  init-seq-ch: [fn []
    [ch: [channel 1]]
    [send ch 0]
    ch]

  new-conn: [fn [let h@Handle wk@[Bytes 32] rk@[Bytes 32] wi@[Bytes 12] ri@[Bytes 12] c@CipherSuite sni]
    [TlsConnection
      [underlying: h
       write-key: wk  write-iv: wi
       read-key:  rk  read-iv:  ri
       cipher:    c
       write-seq: [init-seq-ch]
       read-seq:  [init-seq-ch]
       sni:       sni]]]

  encode-hs: [fn [let type@Int body@Bytes]
    [len: [length body]]
    [concat [bytes type]
            [bytes [/ [/ len 256] 256]]
            [bytes [mod [/ len 256] 256]]
            [bytes [mod len 256]]
            body]]

  parse-finished:    [fn [let payload@Bytes] [slice 4 32 payload]]
  encode-finished:   [fn [let mac@[Bytes 32]] [encode-hs 20 mac]]
  sign-with-key:     [fn [let private-key@Bytes input@Bytes] [error "TODO: sign-with-key — detect PKCS#8 OID, dispatch to rsa-pss-sign/p256-sign/ed25519-sign"]]
  verify-sig:        [fn [let public-key@Bytes input@Bytes sig@Bytes] [error "TODO: verify-sig"]]
  parse-client-hello:[fn [let payload@Bytes] [error "TODO: parse-client-hello"]]
  parse-server-hello:[fn [let payload@Bytes] [error "TODO: parse-server-hello"]]
  parse-certificate: [fn [let payload@Bytes] [error "TODO: parse-certificate — [Seq Bytes] DER list"]]
  parse-certificate-verify-sig: [fn [let payload@Bytes] [error "TODO: parse-certificate-verify-sig"]]
  encode-encrypted-extensions: [fn [let alpn@[or String Null]] [encode-hs 8 []]]
  encode-certificate:          [fn [let cert@Bytes] [encode-hs 11 [concat [bytes 0] [encode BigEndian [@UInt16 [+ [length cert] 5]]] [encode BigEndian [@UInt32 [length cert]]] cert [encode BigEndian [@UInt16 0]]]]]
  encode-certificate-verify:   [fn [let sig@Bytes]  [encode-hs 15 [concat [0x08 0x04] [encode BigEndian [@UInt16 [length sig]]] sig]]]
  negotiate-alpn: [fn [let client-alpn@[Seq String] server-alpn@[Seq String]]
    [match [filter [fn [let p] [any? [fn [let s] [= p s]] server-alpn]] client-alpn]
      []: null
      [let [first ...rest]]: first]]
  choose-cipher: [fn [let suites@[Seq Int] cfg@TlsServerConfig]
    # Prefer ChaCha20 → AES-256 → AES-128.
    [if [any? [fn [let s] [= s 0x1303]] suites] [Chacha20Poly1305Sha256]
      [if [any? [fn [let s] [= s 0x1302]] suites] [Aes256GcmSha384] [Aes128GcmSha256]]]]

  # RFC 8446 §7.1: key schedule hash and key/IV lengths per cipher suite.
  cipher-params: [fn [let c@CipherSuite]
    [match c
      [Aes128GcmSha256]:        [hash: [Sha256]  key-len: 16  iv-len: 12]
      [Aes256GcmSha384]:        [hash: [Sha384]  key-len: 32  iv-len: 12]
      [Chacha20Poly1305Sha256]: [hash: [Sha256]  key-len: 32  iv-len: 12]]]

  bytes-repeat: [fn [let val@Int n@Int]
    [reduce [fn [let acc _] [concat acc [bytes val]]] [] [range 0 n]]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # HkdfHash, Sha256, Sha384, Sha512, Blake2s — re-exported from crypto.llt (included above).

  TlsServerConfig: [type
    [certificate: Bytes
     private-key: Bytes
     alpn:        [Seq String]
     min-version: Symbol]]

  TlsClientConfig: [type
    [sni:         [or String Null]    # null = infer from [Hostname h] in pending connection
     alpn:        [Seq String]
     ech:         Bytes
     trust-roots: [or [Seq Bytes] Symbol]]]

  CipherSuite: [union
    [Aes128GcmSha256]
    [Aes256GcmSha384]
    [Chacha20Poly1305Sha256]]

  # TlsConnection is parametric over its underlying ByteStream h so TLS can be stacked
  # on top of any stream (TCP Handle, WireguardConnection, NoiseConnection, etc.).
  TlsConnection: [type [h]   # h must satisfy ByteStream; enforced at instance sites
    [underlying:  h
     write-key:   [Bytes 32]
     read-key:    [Bytes 32]
     write-iv:    [Bytes 12]
     read-iv:     [Bytes 12]
     cipher:      CipherSuite
     write-seq:   [Channel Int]
     read-seq:    [Channel Int]
     sni:         [or String Null]]]

  ContentType: [union [ChangeCipherSpec] [Alert] [Handshake] [ApplicationData]]

  TlsRecord: [type [content-type: ContentType  payload: Bytes]]

  # MessageStream instance helpers for TlsConnection.
  # tls-send-record sends a TlsRecord to the peer.
  # tls-recv-record reads a TlsRecord from the peer, returns [Ok TlsRecord] | [Closed].
  tls-send-record: [fn [let conn@TlsConnection record@TlsRecord]
    [tls-write-record conn record.content-type record.payload]]

  tls-recv-record: [fn [let conn@TlsConnection]
    [match [try [read-tls-record conn.underlying]]
      [Ok record]: [Ok [TlsRecord [content-type: record.content-type
                                   payload: [tls-decrypt-conn-record conn record]]]]
      [Err _]:     [Closed]]]

  tls-read-bytes: [fn [let conn@TlsConnection n@Int]
    [tls-read-acc conn n []]]

  tls-write-bytes: [fn [let conn@TlsConnection data@Bytes]
    [if [<= [length data] 16384]
      [tls-write-record conn [ApplicationData] data]
      [tls-write-record conn [ApplicationData] [slice 0 16384 data]]
      [tls-write-bytes conn [slice 16384 [length data] data]]]]

  # hash: the PRF hash for this cipher suite — passed from cipher-params.
  hkdf-expand-label: [fn [let secret@Bytes label@String context@Bytes len@Int hash@HkdfHash]
    [label-str: [str "tls13 " label]]
    [info: [concat [encode BigEndian [@UInt16 len]]
                   [bytes [length [str-bytes label-str]]] [str-bytes label-str]
                   [bytes [length context]] context]]
    [hkdf-expand hash secret info len]]

  derive-secret: [fn [let secret@Bytes label@String transcript@Bytes hash@HkdfHash]
    # hash-fn selects the right SHA variant for the transcript hash itself.
    [transcript-hash: [match hash
      [Sha256]: [sha256 transcript]
      [Sha384]: [sha384 transcript]
      [Sha512]: [sha512 transcript]
      _:        [sha256 transcript]]]
    [hkdf-expand-label secret label transcript-hash [length transcript-hash] hash]]

  # Takes cipher: CipherSuite so hash and key lengths are derived correctly per RFC 8446 §7.1.
  tls13-key-schedule: [fn [let dh-shared@[Bytes 32] ch-bytes@Bytes sh-bytes@Bytes cipher@CipherSuite]
    [p:          [cipher-params cipher]]
    [zero:       [bytes-repeat 0 p.key-len]]

    [early-secret:  [hkdf-extract p.hash zero zero]]
    [hs-secret:     [hkdf-extract p.hash [derive-secret early-secret "derived" [] p.hash] dh-shared]]
    [transcript-sh: [concat ch-bytes sh-bytes]]
    [c-hs:          [derive-secret hs-secret "c hs traffic" transcript-sh p.hash]]
    [s-hs:          [derive-secret hs-secret "s hs traffic" transcript-sh p.hash]]
    [master-secret: [hkdf-extract p.hash [derive-secret hs-secret "derived" [] p.hash] zero]]
    [c-ap:          [derive-secret master-secret "c ap traffic" [] p.hash]]
    [s-ap:          [derive-secret master-secret "s ap traffic" [] p.hash]]

    [hs-client-key:  [hkdf-expand-label c-hs "key"      [] p.key-len p.hash]
     hs-client-iv:   [hkdf-expand-label c-hs "iv"       [] p.iv-len  p.hash]
     hs-server-key:  [hkdf-expand-label s-hs "key"      [] p.key-len p.hash]
     hs-server-iv:   [hkdf-expand-label s-hs "iv"       [] p.iv-len  p.hash]
     fin-client-key: [hkdf-expand-label c-hs "finished" [] p.key-len p.hash]
     fin-server-key: [hkdf-expand-label s-hs "finished" [] p.key-len p.hash]
     app-client-key: [hkdf-expand-label c-ap "key"      [] p.key-len p.hash]
     app-client-iv:  [hkdf-expand-label c-ap "iv"       [] p.iv-len  p.hash]
     app-server-key: [hkdf-expand-label s-ap "key"      [] p.key-len p.hash]
     app-server-iv:  [hkdf-expand-label s-ap "iv"       [] p.iv-len  p.hash]]]

  # ── TlsLayer typeclass ────────────────────────────────────────────────────────
  #
  # tls is bidirectional — same name for client and server, dispatched by input type:
  #
  #   Client: [connect ... Tcp ep] | tls | h2 | [send req]
  #   Server: [tcp-listen cap 443] | [tls cert] | h2 | recv
  #
  # Client takes TcpHandle (no config — sni inferred from addr, ALPN left open for h2/h3).
  # Server takes TlsServerConfig (cert + key) and returns a fn Channel@h → Channel@TlsConnection h,
  # which the pipeline applies to the incoming channel (subject-last currying).

  # ── Client TLS ────────────────────────────────────────────────────────────────

  # TlsHandle: TLS config open, not yet committed. tls creates it from a TcpHandle;
  # downstream layers (h2, grpc, doq) set ALPN via with-alpn then fire tls-commit.
  TlsHandle: [type
    [handle:      TcpHandle
     sni:         [or String Null]    # null = infer from handle.addr on commit
     alpn:        [Seq String]        # set by downstream layer
     ech:         Bytes
     trust-roots: [or [Seq Bytes] Symbol]]]

  # tls — client pending layer. Takes TcpHandle (from | connect ... Tcp ...), returns
  # TlsHandle with sni open (inferred on commit) and ALPN open (set by h2/grpc/etc.).
  tls: [fn [let h@TcpHandle]
    [TlsHandle
      [handle: h  sni: null  alpn: []  ech: []  trust-roots: SystemRoots]]]

  # with-alpn: accumulate ALPN into a TlsHandle before commit.
  with-alpn: [fn [let th@TlsHandle alpn@[Seq String]]
    [TlsHandle [handle: th.handle  sni: th.sni  alpn: alpn
                       ech: th.ech  trust-roots: th.trust-roots]]]

  # tls-commit: fire the TLS handshake. Forces handle.stream (TCP connection), then
  # performs TLS 1.3 handshake with inferred/explicit SNI and accumulated ALPN.
  tls-commit: [fn [let th@TlsHandle]
    [sni: [or th.sni
      [match th.handle.addr
        [Hostname h]: h
        _: [error "tls-commit: no hostname for SNI — use [Hostname h] in connect or set sni explicitly"]]]]
    [tls-handshake th.handle.stream
      [TlsClientConfig [sni: sni  alpn: th.alpn  ech: th.ech  trust-roots: th.trust-roots]]]]

  # tls-handshake: low-level TLS handshake on an existing Handle (already-connected stream).
  # Called by tls-commit (client) and by tls-accept (server).
  tls-handshake: [fn [let stream@Handle cfg@TlsClientConfig]
    [error "TODO: tls-handshake — send ClientHello, read ServerHello, derive keys via tls13-key-schedule, verify cert chain (verify-cert-chain), send client Finished, install app keys → TlsConnection TcpHandle"]]

  # ── Server TLS ────────────────────────────────────────────────────────────────

  tls-accept: [fn@[bind: [h]  return: [TlsConnection h]  constraint: [h: ByteStream]]
                [let cfg@TlsServerConfig h@h]
    [error "TODO: tls-accept — read ClientHello; choose-cipher; tls13-key-schedule; send ServerHello + EncryptedExtensions + Certificate + CertificateVerify + Finished; verify client Finished"]]

  # Serve layer kept for explicit use; TlsLayer server instance uses it internally.
  tls-serve: [fn@[bind: [h]  constraint: [h: ByteStream]]
               [let cfg@TlsServerConfig in-ch@[Channel h]]
    [channel-map [fn [let s@h] [tls-accept cfg s]] in-ch]]
]

# ── TlsLayer typeclass — bidirectional tls ────────────────────────────────────

[class [TlsLayer input output]
  tls: [Fn@output [input]]]

# Client: TcpHandle → TlsHandle (sni inferred from addr, ALPN open for downstream layer)
[instance [TlsLayer TcpHandle TlsHandle]
  tls: [fn [let h@TcpHandle]
    [TlsHandle [handle: h  sni: null  alpn: []  ech: []  trust-roots: SystemRoots]]]]

# Server: TlsServerConfig → (Channel@h → Channel@TlsConnection h)
# Usage: [tcp-listen cap 443] | [tls cert] | h2 | recv
[instance@[bind: [h]  constraint: [h: ByteStream]] [TlsLayer TlsServerConfig
    [Fn@[Channel [TlsConnection h]] [[Channel h]]]]
  tls: [fn [let cfg@TlsServerConfig]
    [fn [let ch@[Channel h]]
      [channel-map [fn [let s@h] [tls-accept cfg s]] ch]]]]
