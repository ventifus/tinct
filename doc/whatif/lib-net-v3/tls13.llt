# stdlib/protocols/tls13.llt — TLS 1.3 (RFC 8446) in tinct.
# Part of: lib-net-v3
# Rust primitives: chacha20-poly1305-seal/open, aes-128/256-gcm-seal/open,
#   x25519-keypair, x25519-dh, p256-keypair, hkdf-extract, hkdf-expand,
#   hmac-sha256, hmac-sha384, sha256, crypto-random, bytes-xor, rsa-pss-sign, p256-sign, ed25519-sign
--- uses: ["crypto"]

[include %libdir "net.llt"]
[include %libdir "crypto.llt"]   # provides HkdfHash, Sha256, Sha384, Sha512, Blake2s

[instance@[bind: [h]] ByteStream
  [let s@[TlsConnection h]]: [read:  tls-read-bytes
                               write: tls-write-bytes]]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  read-tls-record: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [header: [read h 5]]
    [len: [@TlsLength [uint16 ByteOrder.Network [slice header 3 5]]]]  # RFC 8446 §5.2: 16-bit length
    [if [> len 16640] [error [str "TLS: record too large: " len]] null]
    [TlsRecord [content-type: [or [get code: [get header 0] ContentType] [error [str "TLS: unknown content type: " [get header 0]]]]  payload: [read h len]]]]

  write-tls-record: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h r@TlsRecord]
    [len: [@TlsLength [length r.payload]]]
    [write h
      [concat
        [bytes ByteOrder.Network [@UInt8 r.content-type.code]]
        [0x03 0x03]
        [bytes ByteOrder.Network len]   # TlsLength (ByteOrder.Network)
        r.payload]]]

  tls-nonce: [fn [let iv@[Bytes 12] seq@Int]
    [bytes-xor iv [concat [0x00 0x00 0x00 0x00] [bytes ByteOrder.Network [@UInt64 seq]]]]]

  # aad: RFC 8446 §5.2 additional data = 5-byte TLSCiphertext header.
  # Must be 0x17 0x03 0x03 || ciphertext-length(2). Passed explicitly so both
  # seal and open share the same construction and authenticate the record framing.
  tls-seal: [fn [let conn@TlsConnection plain@Bytes nonce@[Bytes 12] aad@Bytes]
    [match conn.cipher
      [CipherSuite.Chacha20Poly1305Sha256]: [chacha20-poly1305-seal conn.write-key nonce plain aad]
      [CipherSuite.Aes128GcmSha256]:        [aes-128-gcm-seal       conn.write-key nonce plain aad]
      [CipherSuite.Aes256GcmSha384]:        [aes-256-gcm-seal       conn.write-key nonce plain aad]]]

  tls-open: [fn [let conn@TlsConnection ct@Bytes nonce@[Bytes 12] aad@Bytes]
    [match [match conn.cipher
      [CipherSuite.Chacha20Poly1305Sha256]: [chacha20-poly1305-open conn.read-key nonce ct aad]
      [CipherSuite.Aes128GcmSha256]:        [aes-128-gcm-open       conn.read-key nonce ct aad]
      [CipherSuite.Aes256GcmSha384]:        [aes-256-gcm-open       conn.read-key nonce ct aad]]
      [Result.Ok p]:    p
      [Result.Error _]: [error "TLS: AEAD decryption failed"]]]

  # aad = 0x17 0x03 0x03 || ciphertext-length(2).
  # Ciphertext length = inner-plaintext length + 16 (AEAD tag). Known before encrypt.
  tls-record-aad: [fn [let ct-len@TlsLength]
    [concat [0x17] [0x03 0x03] [bytes ByteOrder.Network ct-len]]]  # TlsLength (ByteOrder.Network)

  tls-write-record: [fn [let conn@TlsConnection ct@ContentType plain@Bytes]
    # write-seq channel holds exactly one value (atomic counter). Closed.Closed is impossible.
    [match [recv conn.write-seq]
      [Closed.Closed]: [error "TLS: write-seq channel closed unexpectedly"]
      [Result.Ok seq]:
        [send conn.write-seq [+ seq 1]]
        [inner:  [concat plain [bytes ct.code]]]              # inner = data || content-type byte
        [ct-len: [@TlsLength [+ [length inner] 16]]]          # ciphertext = inner + 16-byte tag
        [aad:    [tls-record-aad ct-len]]
        [ciphertext: [tls-seal conn inner [tls-nonce conn.write-iv seq] aad]]
        [write-tls-record conn.underlying
          [TlsRecord [content-type: [ApplicationData]  payload: ciphertext]]]]]

  # tls-decrypt-conn-record: decrypt a TlsRecord using connection keys + sequence counter.
  # Named tls-decrypt-conn-record (not tls-decrypt-record) to avoid collision with any
  # stateless Bytes→Bytes stub. Used internally by tls-read-acc and tls-recv-record.
  tls-decrypt-conn-record: [fn [let conn@TlsConnection record@TlsRecord]
    # read-seq channel holds exactly one value (atomic counter). Closed.Closed is impossible.
    [match [recv conn.read-seq]
      [Closed.Closed]: [error "TLS: read-seq channel closed unexpectedly"]
      [Result.Ok seq]:
        [send conn.read-seq [+ seq 1]]
        [aad: [tls-record-aad [@TlsLength [length record.payload]]]]  # ciphertext length is payload length
        [plain: [tls-open conn record.payload [tls-nonce conn.read-iv seq] aad]]
        [strip-inner-ct plain]]]

  strip-inner-ct: [fn [let plain@Bytes]
    [find-last-nonzero plain [- [length plain] 1]]]

  find-last-nonzero: [fn [let b@Bytes i@Int]
    [if [< i 0]
      [error "TLS: all-zero decrypted record"]
      [if [= [get b i] 0]
        [find-last-nonzero b [- i 1]]
        [slice 0 i b]]]]

  tls-read-acc: [fn [let conn@TlsConnection remaining@Int acc@[Seq Bytes]]
    [if [= remaining 0]
      [reduce concat [] acc]
      [block
        [plain: [tls-decrypt-conn-record conn [read-tls-record conn.underlying]]]
        [got:   [min remaining [length plain]]]
        [tls-read-acc conn [- remaining got] [append [list [slice 0 got plain]] acc]]]]]

  init-seq-ch: [fn []
    [ch: [channel 1]]
    [send ch 0]
    ch]

  new-conn: [fn [let h@Handle wk@[Bytes 32] rk@[Bytes 32] wi@[Bytes 12] ri@[Bytes 12] c@CipherSuite sni alpn@[or String Absent]]
    [TlsConnection
      [underlying: h
       write-key: wk  write-iv: wi
       read-key:  rk  read-iv:  ri
       cipher:    c
       write-seq: [init-seq-ch]
       read-seq:  [init-seq-ch]
       sni:       sni
       negotiated-alpn: alpn]]]

  encode-hs: [fn [let type@Int body@Bytes]
    [len: [length body]]
    [concat [bytes ByteOrder.Network [@UInt8 type]]
            [bytes ByteOrder.Network [@UInt24 len]]
            body]]

  parse-finished:    [fn [let payload@Bytes] [slice 4 32 payload]]
  encode-finished:   [fn [let mac@[Bytes 32]] [encode-hs 20 mac]]
  # Detect PKCS#8 algorithm OID and dispatch to the right primitive.
  # OID 1.2.840.10045.2.1 = EC; OID 1.2.840.113549.1.1.1 = RSA.
  # Key type is identified by the AlgorithmIdentifier in the SubjectPublicKeyInfo.
  sign-with-key: [fn [let private-key@Bytes input@Bytes]
    # First byte heuristic: 0x30 = DER SEQUENCE (PKCS#8); check OID bytes at offset 11
    [oid-byte: [get private-key 11]]
    [match oid-byte
      # EC key OID discriminant byte (simplified: check for EC curve params)
      0x2a: [p256-sign private-key input]   # 1.2.840.10045.3.1.7 = P-256
      0x0a: [ed25519-sign private-key input]
      _:    [rsa-pss-sign private-key input]]]

  verify-sig: [fn [let public-key@Bytes input@Bytes sig@Bytes scheme@[Seq Int]]
    # scheme: OID as [Seq Int] identifying the signature algorithm
    [match [get scheme 6]   # OID discriminant byte
      7: [p256-verify    public-key input sig]  # EC P-256
      8: [p384-verify    public-key input sig]  # EC P-384
      1: [ed25519-verify public-key input sig]  # Ed25519
      _: [rsa-pss-verify public-key input sig]]]
  # RFC 8446 §4.1.2: ClientHello = legacy_version(2) + random(32) + session_id(1+N) +
  #   cipher_suites(2+2*N) + legacy_compression(1+1) + extensions(2+N).
  # Returns record with fields: random cipher-suites session-id extensions
  parse-client-hello: [fn [let payload@Bytes]
    [random:     [slice payload 2 34]]
    [sid-len:    [get payload 34]]
    [after-sid:  [+ 35 sid-len]]
    [cs-len:     [uint16 ByteOrder.Network [slice payload after-sid [+ after-sid 2]]]]
    [cs-start:   [+ after-sid 2]]
    [after-cs:   [+ cs-start cs-len]]
    # compression(1+1), then extensions(2+N)
    [ext-start:  [+ after-cs 2]]
    [ext-len:    [uint16 ByteOrder.Network [slice payload ext-start [+ ext-start 2]]]]
    [random: random
     session-id: [slice payload 35 [+ 35 sid-len]]
     cipher-suites: [collect [map [fn [let i]
       [uint16 ByteOrder.Network [slice payload [+ cs-start [* i 2]] [+ cs-start [* i 2] 2]]]]
       [range 0 [/ cs-len 2]]]]
     extensions: [slice payload [+ ext-start 2] [+ ext-start 2 ext-len]]]]

  # RFC 8446 §4.1.3: ServerHello = legacy_version(2) + random(32) + session_id(1+N) +
  #   cipher_suite(2) + legacy_compression(1) + extensions(2+N).
  # Returns record with fields: random cipher-suite extensions
  parse-server-hello: [fn [let payload@Bytes]
    [random:    [slice payload 2 34]]
    [sid-len:   [get payload 34]]
    [after-sid: [+ 35 sid-len]]
    [cs:        [uint16 ByteOrder.Network [slice payload after-sid [+ after-sid 2]]]]
    [ext-off:   [+ after-sid 3]]  # skip cipher_suite(2) + compression(1)
    [ext-len:   [uint16 ByteOrder.Network [slice payload ext-off [+ ext-off 2]]]]
    [random: random
     cipher-suite: cs
     extensions: [slice payload [+ ext-off 2] [+ ext-off 2 ext-len]]]]

  # RFC 8446 §4.4.2: Certificate = request_context(1+N) + cert_list(3+N).
  # Each entry: cert_data(3+N) + extensions(2+N). Returns [Seq Bytes] of DER certs.
  parse-certificate: [fn [let payload@Bytes]
    [ctx-len: [get payload 0]]
    [after-ctx: [+ 1 ctx-len]]
    [list-len: [uint24 ByteOrder.Network [slice payload after-ctx [+ after-ctx 3]]]]
    [parse-certs: [fn [let offset acc]
      [if [>= offset [+ after-ctx 3 list-len]]
        acc
        [block
          [cert-len: [uint24 ByteOrder.Network [slice payload offset [+ offset 3]]]]
          [cert: [slice payload [+ offset 3] [+ offset 3 cert-len]]]
          [ext-off: [+ offset 3 cert-len]]
          [ext-len: [uint16 ByteOrder.Network [slice payload ext-off [+ ext-off 2]]]]
          [parse-certs [+ ext-off 2 ext-len] [append acc [list cert]]]]]]]
    [parse-certs [+ after-ctx 3] []]]

  # RFC 8446 §4.4.3: CertificateVerify = algorithm(2) + signature(2+N).
  # Returns record with fields: algorithm signature
  parse-certificate-verify-sig: [fn [let payload@Bytes]
    [alg: [uint16 ByteOrder.Network [slice payload 0 2]]]
    [sig-len: [uint16 ByteOrder.Network [slice payload 2 4]]]
    [algorithm: alg  signature: [slice payload 4 [+ 4 sig-len]]]]

  # Parse ALPN extension from EncryptedExtensions payload.
  # RFC 8446 §4.3.1: EncryptedExtensions = extensions(2+N).
  # ALPN extension (0x0010): list-len(2) + protocol-len(1) + protocol-bytes.
  # Returns the selected protocol string or Absent if ALPN was not negotiated.
  parse-ee-alpn: [fn [let ee-payload@Bytes]
    # ee-payload starts at offset 4 (after handshake type + length header)
    [ext-len: [uint16 ByteOrder.Network [slice ee-payload 4 6]]]
    [if [= ext-len 0]
      Absent.Absent
      [find-alpn-ext: [fn [let exts pos limit]
        [if [>= pos limit]
          Absent.Absent
          [block
            [ext-type: [uint16 ByteOrder.Network [slice exts pos [+ pos 2]]]]
            [ext-val-len: [uint16 ByteOrder.Network [slice exts [+ pos 2] [+ pos 4]]]]
            [if [= ext-type 0x0010]
              # ALPN extension found: list-len(2) + protocol-len(1) + protocol-bytes
              [block
                [list-len: [uint16 ByteOrder.Network [slice exts [+ pos 4] [+ pos 6]]]]
                [proto-len: [get exts [+ pos 6]]]
                [bytes-str [slice exts [+ pos 7] [+ pos 7 proto-len]]]]
              [find-alpn-ext exts [+ pos 4 ext-val-len] limit]]]]]
       [find-alpn-ext ee-payload 6 [+ 6 ext-len]]]]]

  encode-encrypted-extensions: [fn [let alpn@[or String Absent]] [encode-hs 8 []]]
  encode-certificate:          [fn [let cert@Bytes] [encode-hs 11 [concat [0x00] [bytes ByteOrder.Network [@UInt16 [+ [length cert] 5]]] [bytes ByteOrder.Network [@UInt32 [length cert]]] cert [bytes ByteOrder.Network [@UInt16 0]]]]]
  encode-certificate-verify:   [fn [let sig@Bytes]  [encode-hs 15 [concat [0x08 0x04] [bytes ByteOrder.Network [@UInt16 [length sig]]] sig]]]
  negotiate-alpn: [fn [let client-alpn@[Seq String] server-alpn@[Seq String]]
    [match [filter [fn [let p] [any? [fn [let s] [= p s]] server-alpn]] client-alpn]
      []: null
      [let [first ...rest]]: first]]
  choose-cipher: [fn [let suites@[Seq Int] cfg@TlsServerConfig]
    # Prefer ChaCha20 → AES-256 → AES-128.
    [if [any? [fn [let s] [= s CipherSuite.Chacha20Poly1305Sha256.code]] suites] CipherSuite.Chacha20Poly1305Sha256
      [if [any? [fn [let s] [= s CipherSuite.Aes256GcmSha384.code]] suites] CipherSuite.Aes256GcmSha384 CipherSuite.Aes128GcmSha256]]]

  # RFC 8446 §7.1: key schedule hash and key/IV lengths per cipher suite.
  cipher-params: [fn [let c@CipherSuite]
    [match c
      [CipherSuite.Aes128GcmSha256]:        [hash: Sha256.Sha256  key-len: 16  iv-len: 12]
      [CipherSuite.Aes256GcmSha384]:        [hash: Sha384.Sha384  key-len: 32  iv-len: 12]
      [CipherSuite.Chacha20Poly1305Sha256]: [hash: Sha256.Sha256  key-len: 32  iv-len: 12]]]

  bytes-repeat: [fn [let val@Int n@Int]
    [reduce [fn [let acc _] [concat acc [bytes val]]] [] [range 0 n]]]

  # HMAC dispatch per cipher suite hash (RFC 2104).
  # Rust primitives: hmac-sha256 key data → [Bytes 32], hmac-sha384 key data → [Bytes 48]
  # For TLS 1.3 Finished: HMAC(finished_key, transcript_hash) per RFC 8446 §4.4.4.
  hmac: [fn [let hash@HkdfHash key@Bytes data@Bytes]
    [match hash
      [Sha256.Sha256]: [hmac-sha256 key data]
      [Sha384.Sha384]: [hmac-sha384 key data]
      _:               [hmac-sha256 key data]]]

  # ── TLS record helpers (internal — called via ByteStream dispatch, never directly) ──

  tls-send-record: [fn [let conn@TlsConnection record@TlsRecord]
    [tls-write-record conn record.content-type record.payload]]

  tls-recv-record: [fn [let conn@TlsConnection]
    [match [try [read-tls-record conn.underlying]]
      [Result.Ok record]: [Result.Ok TlsRecord content-type: record.content-type
                                              payload: [tls-decrypt-conn-record conn record]]
      [Result.Error _]:   Closed.Closed]]

  tls-read-bytes: [fn [let conn@TlsConnection n@Int]
    [tls-read-acc conn n []]]

  tls-write-bytes: [fn [let conn@TlsConnection data@Bytes]
    [if [<= [length data] 16384]
      [tls-write-record conn [ApplicationData] data]
      [block
        [tls-write-record conn [ApplicationData] [slice 0 16384 data]]
        [tls-write-bytes conn [slice 16384 [length data] data]]]]]

  # ── TLS 1.3 key schedule (internal — RFC 8446 §7.1) ──

  hkdf-expand-label: [fn [let secret@Bytes label@String context@Bytes len@Int hash@HkdfHash]
    [label-str: [str "tls13 " label]]
    [info: [concat [bytes ByteOrder.Network [@UInt16 len]]
                   [bytes ByteOrder.Network [@UInt8 [length [str-bytes label-str]]]] [str-bytes label-str]
                   [bytes ByteOrder.Network [@UInt8 [length context]]] context]]
    [hkdf-expand hash secret info len]]

  derive-secret: [fn [let secret@Bytes label@String transcript@Bytes hash@HkdfHash]
    [transcript-hash: [match hash
      [Sha256.Sha256]: [sha256 transcript]
      [Sha384.Sha384]: [sha384 transcript]
      [Sha512.Sha512]: [sha512 transcript]
      _:               [sha256 transcript]]]
    [hkdf-expand-label secret label transcript-hash [length transcript-hash] hash]]

  tls13-key-schedule: [fn [let dh-shared@[Bytes 32] ch-bytes@Bytes sh-bytes@Bytes cipher@CipherSuite]
    [p:          [cipher-params cipher]]
    [zero:       [bytes-repeat 0 p.key-len]]
    [early-secret:  [hkdf-extract p.hash zero zero]]
    [hs-secret:     [hkdf-extract p.hash [derive-secret early-secret "derived" [] p.hash] dh-shared]]
    [transcript-sh: [concat ch-bytes sh-bytes]]
    [c-hs:          [derive-secret hs-secret "c hs traffic" transcript-sh p.hash]]
    [s-hs:          [derive-secret hs-secret "s hs traffic" transcript-sh p.hash]]
    [master-secret: [hkdf-extract p.hash [derive-secret hs-secret "derived" [] p.hash] zero]]
    [c-ap:          [derive-secret master-secret "c ap traffic" [] p.hash]]
    [s-ap:          [derive-secret master-secret "s ap traffic" [] p.hash]]
    [hs-client-key:  [hkdf-expand-label c-hs "key"      [] p.key-len p.hash]
     hs-client-iv:   [hkdf-expand-label c-hs "iv"       [] p.iv-len  p.hash]
     hs-server-key:  [hkdf-expand-label s-hs "key"      [] p.key-len p.hash]
     hs-server-iv:   [hkdf-expand-label s-hs "iv"       [] p.iv-len  p.hash]
     fin-client-key: [hkdf-expand-label c-hs "finished" [] p.key-len p.hash]
     fin-server-key: [hkdf-expand-label s-hs "finished" [] p.key-len p.hash]
     app-client-key: [hkdf-expand-label c-ap "key"      [] p.key-len p.hash]
     app-client-iv:  [hkdf-expand-label c-ap "iv"       [] p.iv-len  p.hash]
     app-server-key: [hkdf-expand-label s-ap "key"      [] p.key-len p.hash]
     app-server-iv:  [hkdf-expand-label s-ap "iv"       [] p.iv-len  p.hash]]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # HkdfHash, Sha256, Sha384, Sha512, Blake2s — re-exported from crypto.llt (included above).

  # Named domain types with fixed byte-order encodings per RFC 8446.
  # All TLS 1.3 multi-byte integers are big-endian (network byte order) per RFC 8446 §1.
  TlsLength:     [type UInt16@[encoding: ByteOrder.Network]]   # RFC 8446 §5.1: 16-bit record/fragment length
  TlsCipherCode: [type UInt16@[encoding: ByteOrder.Network]]   # RFC 8446 §B.4: 16-bit cipher suite code
  TlsExtType:    [type UInt16@[encoding: ByteOrder.Network]]   # RFC 8446 §4.2: 16-bit extension type

  TlsServerConfig: [type
    [certificate: Bytes
     private-key: Bytes
     alpn:        [Seq String]
     min-version: Symbol]]

  TlsClientConfig: [type
    [sni:         [or String Absent]    # null = infer from [Hostname h] in pending connection
     alpn:        [Seq String]
     ech:         Bytes
     trust-roots: [or [Seq Bytes] Symbol]]]

  CipherSuite: [type
    [Aes128GcmSha256        code: 0x1301]
    [Aes256GcmSha384        code: 0x1302]
    [Chacha20Poly1305Sha256 code: 0x1303]]

  # TlsConnection is parametric over its underlying ByteStream h so TLS can be stacked
  # on top of any stream (TCP Handle, WireguardConnection, NoiseConnection, etc.).
  TlsConnection: [type [h]   # h must satisfy ByteStream; enforced at instance sites
    [underlying:       h
     write-key:        [Bytes 32]
     read-key:         [Bytes 32]
     write-iv:         [Bytes 12]
     read-iv:          [Bytes 12]
     cipher:           CipherSuite
     write-seq:        [Channel Int]
     read-seq:         [Channel Int]
     sni:              [or String Absent]
     negotiated-alpn:  [or String Absent]]]  # RFC 8446 §4.4: ALPN protocol selected during handshake

  ContentType: [type
    [ChangeCipherSpec  code: 20]
    [Alert             code: 21]
    [Handshake         code: 22]
    [ApplicationData   code: 23]]

  TlsRecord: [type [content-type: ContentType  payload: Bytes]]

  # TlsRecordCodec: stateful codec for TLS 1.3 record layer (RFC 8446 §5).
  # Carries the TlsConnection for encryption keys, IVs, sequence counters, and cipher suite.
  # encode: TlsRecord (plaintext) → encrypted TLSCiphertext Bytes (ApplicationData record wire bytes)
  # decode: TLSCiphertext Bytes → TlsRecord (decrypted content-type + plaintext payload)
  # Both directions advance the respective sequence counter in conn.
  TlsRecordCodec: [type [h] [conn: [TlsConnection h]]]

  # TLS alert descriptions per RFC 8446 §6.2.
  TlsAlertDescription: [type
    [CloseNotify] [UnexpectedMessage] [BadRecordMac] [RecordOverflow]
    [HandshakeFailure] [BadCertificate] [UnsupportedCertificate]
    [CertificateRevoked] [CertificateExpired] [CertificateUnknown]
    [IllegalParameter] [UnknownCa] [AccessDenied] [InternalError]
    [InappropriateFallback] [UserCanceled]
    [UnrecognizedName] [BadCertificateStatusResponse]
    [UnknownPskIdentity] [CertificateRequired] [NoApplicationProtocol]
    [UnknownAlert code@UInt8]]   # forward-compat: alerts not listed above

  # TLS error type — distinct failure modes callers can pattern-match on.
  TlsError: [type
    [HandshakeFailed         reason@String]      # generic handshake failure
    [CertificateExpired]                          # server cert is past its notAfter
    [CertificateUntrusted    subject@String]      # cert chain does not lead to a trusted root
    [HostnameMismatch        expected@String  got@String]  # SNI/SAN mismatch
    [AlertReceived           description@TlsAlertDescription]  # peer sent a fatal alert
    [NoMutualCipherSuite]                         # no overlap between client and server suites
    [DecryptFailed]                               # AEAD authentication tag mismatch
    [UnexpectedMessage       content-type@ContentType]  # wrong record type for current state
    [VersionNegotiationFailed]]                   # no supported TLS version in common

  # ── TlsLayer typeclass ────────────────────────────────────────────────────────
  #
  # tls is bidirectional — same name for client and server, dispatched by input type:
  #
  #   Client: [connect ... Tcp ep] | tls | h2-connection | [send req]
  #   Server: [tcp-listen cap 443] | [tls cert] | h2-connection | recv
  #
  # Client takes TcpHandle (no config — sni inferred from addr, ALPN left open for h2/h3).
  # Server takes TlsServerConfig (cert + key) and returns a fn Channel@h → Channel@TlsConnection h,
  # which the pipeline applies to the incoming channel (subject-last currying).

  # ── Client TLS ────────────────────────────────────────────────────────────────

  # TlsHandle: TLS config open, not yet committed. tls creates it from a TcpHandle;
  # downstream layers (h2, grpc, doq) set ALPN via with-alpn then fire tls-commit.
  TlsHandle: [type
    [handle:      TcpHandle
     sni:         [or String Absent]    # null = infer from handle.addr on commit
     alpn:        [Seq String]        # set by downstream layer
     ech:         Bytes
     trust-roots: [or [Seq Bytes] Symbol]]]

  # with-alpn: accumulate ALPN into a TlsHandle before commit.
  with-alpn: [fn [let th@TlsHandle alpn@[Seq String]]
    [TlsHandle [handle: th.handle  sni: th.sni  alpn: alpn
                       ech: th.ech  trust-roots: th.trust-roots]]]

  # tls-commit: fire the TLS handshake. Returns [or [TlsConnection TcpHandle] TlsError].
  # Callers pattern-match: [TlsError.CertificateExpired] differs from [TlsError.HandshakeFailed].
  tls-commit: [fn@[return: [or [TlsConnection TcpHandle] TlsError]] [let th@TlsHandle]
    [sni: [or th.sni
      [match th.handle.addr
        [Hostname.Hostname h]: h
        _: Absent.Absent]]]
    [if [absent? sni]
      [TlsError.HandshakeFailed reason: "no hostname for SNI — use [Hostname.Hostname h] or set sni explicitly"]
      [tls-handshake th.handle.stream
        [TlsClientConfig [sni: sni  alpn: th.alpn  ech: th.ech  trust-roots: th.trust-roots]]]]]

  # TLS 1.3 client handshake per RFC 8446 §4.
  # Message sequence (all wrapped in TLSPlaintext records until keys installed):
  #   → ClientHello: client_random(32) + session_id(1+32) + cipher_suites(2+2*n)
  #                  + compression(1+1) + extensions including:
  #                    supported_versions (0x002b) = [0x03 0x04]
  #                    supported_groups (0x000a) = [x25519 p256]
  #                    key_share (0x0033) = x25519 ephemeral public key (32 bytes)
  #                    server_name (0x0000) = cfg.sni
  #                    signature_algorithms (0x000d) = [ecdsa_secp256r1_sha256 rsa_pss_rsae_sha256 ed25519]
  #                    application_layer_protocol_negotiation (0x0010) = cfg.alpn
  #   ← ServerHello: server_random(32) + cipher_suite(2) + key_share response
  #       After ServerHello: derive handshake keys via tls13-key-schedule
  #       Install handshake traffic keys → all subsequent records encrypted
  #   ← EncryptedExtensions: ALPN selection, server_name ack
  #   ← Certificate: DER cert chain as [Seq Bytes]
  #   ← CertificateVerify: signature over transcript hash
  #   ← Finished: HMAC over transcript with server_finished_key
  #       After server Finished: verify cert chain (verify-cert-chain), verify signature,
  #         verify Finished MAC. Derive application keys via tls13-key-schedule.
  #   → Finished: HMAC over transcript with client_finished_key
  #       Install application traffic keys. Handshake complete → return TlsConnection.
  tls-handshake: [fn@[return: [or [TlsConnection Handle] TlsError]] [let stream@Handle cfg@TlsClientConfig]
    # RFC 8446 §4.1.2 TLS 1.3 client handshake.

    # Step 1: generate ephemeral X25519 key pair + client random
    [eph:           [x25519-keypair]]
    [client-random: [crypto-random 32]]
    [session-id:    [crypto-random 32]]   # legacy session ID: 32 bytes (RFC 8446 §4.1.2)

    # Step 2: build ClientHello extensions
    # supported_versions (0x002b): TLS 1.3 = 0x0304
    [ext-supported-versions:
      [concat [0x00 0x2b] [bytes ByteOrder.Network [@UInt16 3]] [0x02] [0x03 0x04]]]
    # supported_groups (0x000a): x25519 (0x001d)
    [ext-supported-groups:
      [concat [0x00 0x0a] [bytes ByteOrder.Network [@UInt16 6]] [bytes ByteOrder.Network [@UInt16 4]] [bytes ByteOrder.Network [@UInt16 0x001d]] [bytes ByteOrder.Network [@UInt16 0x0017]]]]
    # key_share (0x0033): x25519 public key (32 bytes)
    [key-share-entry: [concat [bytes ByteOrder.Network [@UInt16 0x001d]] [bytes ByteOrder.Network [@UInt16 32]] eph.public]]
    [ext-key-share:
      [concat [0x00 0x33] [bytes ByteOrder.Network [@UInt16 [+ 2 [length key-share-entry]]]] [bytes ByteOrder.Network [@UInt16 [length key-share-entry]]] key-share-entry]]
    # server_name (0x0000): sni
    [sni-bytes: [str-bytes cfg.sni]]
    [sni-entry:  [concat [0x00] [bytes ByteOrder.Network [@UInt16 [length sni-bytes]]] sni-bytes]]
    [ext-sni:
      [concat [0x00 0x00] [bytes ByteOrder.Network [@UInt16 [+ 2 [length sni-entry]]]] [bytes ByteOrder.Network [@UInt16 [length sni-entry]]] sni-entry]]
    # signature_algorithms (0x000d): ecdsa_secp256r1_sha256 (0x0403), rsa_pss_rsae_sha256 (0x0804), ed25519 (0x0807)
    [ext-sig-algs:
      [concat [0x00 0x0d] [bytes ByteOrder.Network [@UInt16 8]] [bytes ByteOrder.Network [@UInt16 6]] [0x04 0x03] [0x08 0x04] [0x08 0x07]]]
    # application_layer_protocol_negotiation (0x0010): from cfg.alpn
    [ext-alpn: [if [empty? cfg.alpn]
      [bytes 0]
      [block
        [alpn-list: [apply concat [map [fn [let p]
          [pb: [str-bytes p]]
          [concat [bytes ByteOrder.Network [@UInt8 [length pb]]] pb]]
          cfg.alpn]]]
        [concat [0x00 0x10] [bytes ByteOrder.Network [@UInt16 [+ 2 [length alpn-list]]]] [bytes ByteOrder.Network [@UInt16 [length alpn-list]]] alpn-list]]]]

    # Step 3: build and send ClientHello
    [extensions: [apply concat [filter [fn [let e] [> [length e] 0]]
      [list ext-supported-versions ext-supported-groups ext-key-share ext-sni ext-sig-algs ext-alpn]]]]
    [ch-body:
      [concat
        [0x03 0x03]                                            # legacy_version = 0x0303
        client-random                                          # 32-byte random
        [bytes ByteOrder.Network [@UInt8 32]] session-id               # session_id (1+32)
        [bytes ByteOrder.Network [@UInt16 6]]                          # cipher_suites length (3 suites × 2 bytes)
        [bytes ByteOrder.Network [@UInt16 CipherSuite.Chacha20Poly1305Sha256.code]]  # TLS_CHACHA20_POLY1305_SHA256
        [bytes ByteOrder.Network [@UInt16 CipherSuite.Aes256GcmSha384.code]]         # TLS_AES_256_GCM_SHA384
        [bytes ByteOrder.Network [@UInt16 CipherSuite.Aes128GcmSha256.code]]         # TLS_AES_128_GCM_SHA256
        [bytes ByteOrder.Network [@UInt8 1]] [0x00]                   # compression (null only)
        [bytes ByteOrder.Network [@UInt16 [length extensions]]]        # extensions length
        extensions]]
    [ch-msg: [encode-hs 1 ch-body]]   # type 1 = ClientHello
    [write-tls-record stream [TlsRecord [content-type: ContentType.Handshake  payload: ch-msg]]]
    [ch-bytes: ch-msg]   # transcript starts with ClientHello

    # Step 4: read ServerHello
    [sh-record: [read-tls-record stream]]
    [if [not [= [tag-of sh-record.content-type] "ContentType.Handshake"]]
      [TlsError.HandshakeFailed "expected Handshake record for ServerHello"]
      [block
      [sh: [parse-server-hello [slice sh-record.payload 4 [length sh-record.payload]]]]
      [sh-bytes: sh-record.payload]  # transcript accumulates
      [transcript: [concat ch-bytes sh-bytes]]

      # Step 5: derive handshake keys from server key_share
      # Extract server key_share from ServerHello extensions (0x0033)
      [find-ks: [fn [let exts pos]
        [if [>= pos [length exts]]
          [error "TLS: no key_share in ServerHello"]
          [block
            [ext-type: [uint16 ByteOrder.Network [slice exts pos [+ pos 2]]]]
            [ext-len:  [uint16 ByteOrder.Network [slice exts [+ pos 2] [+ pos 4]]]]
            [if [= ext-type 0x0033]
              # key_share: group(2) + key-len(2) + key-bytes
              [slice exts [+ pos 8] [+ pos 8 32]]   # x25519 key is 32 bytes
              [find-ks exts [+ pos 4 ext-len]]]]]]]
      [server-pub: [find-ks sh.extensions 0]]
      [dh-shared: [x25519-dh eph.private server-pub]]
      [cipher: [or [get code: sh.cipher-suite CipherSuite] [raise "TLS: no mutual cipher suite"]]]
      [ks: [tls13-key-schedule dh-shared ch-bytes sh-bytes cipher]]

      # Step 6: read EncryptedExtensions, Certificate, CertificateVerify, Finished
      # After ServerHello: install handshake traffic keys to decrypt subsequent records
      [hs-conn: [TlsConnection
        [underlying: stream
         write-key:  ks.hs-client-key  write-iv: ks.hs-client-iv
         read-key:   ks.hs-server-key  read-iv:  ks.hs-server-iv
         cipher:     cipher
         write-seq:  [init-seq-ch]  read-seq: [init-seq-ch]
         sni:        cfg.sni  negotiated-alpn: Absent.Absent]]]

      # EncryptedExtensions (type 8)
      [ee-record: [tls-decrypt-conn-record hs-conn [read-tls-record stream]]]
      [transcript: [concat transcript ee-record]]
      [negotiated-alpn: [parse-ee-alpn ee-record]]

      # Read Certificate (type 11) or CertificateRequest (type 13)
      [cert-record: [tls-decrypt-conn-record hs-conn [read-tls-record stream]]]
      [transcript: [concat transcript cert-record]]
      [certs: [if [= [get cert-record 0] 11]   # Certificate message type
        [parse-certificate [slice cert-record 4 [length cert-record]]]
        []]]

      # CertificateVerify (type 15)
      [cv-record: [tls-decrypt-conn-record hs-conn [read-tls-record stream]]]
      [transcript: [concat transcript cv-record]]
      [cv: [if [= [get cv-record 0] 15]
        [parse-certificate-verify-sig [slice cv-record 4 [length cv-record]]]
        [algorithm: 0  signature: [bytes 0]]]]

      # Finished (type 20)
      [fin-record: [tls-decrypt-conn-record hs-conn [read-tls-record stream]]]
      [transcript: [concat transcript fin-record]]
      [server-fin-mac: [parse-finished [slice fin-record 0 [length fin-record]]]]

      # Step 7: verify cert chain (RFC 5280) + CertificateVerify + Finished
      [if [not [empty? certs]]
        [if [not [verify-cert-chain certs cfg.trust-roots cfg.sni]]
          [raise [str "TLS: certificate untrusted for " cfg.sni]]
          null]
        null]
      # Verify server Finished MAC: HMAC(server_finished_key, transcript_hash)
      [p: [cipher-params cipher]]
      [expected-fin: [hmac p.hash ks.fin-server-key [match p.hash
        [Sha256.Sha256]: [sha256 [concat ch-bytes sh-bytes ee-record cert-record cv-record]]
        [Sha384.Sha384]: [sha384 [concat ch-bytes sh-bytes ee-record cert-record cv-record]]
        _:               [sha256 [concat ch-bytes sh-bytes ee-record cert-record cv-record]]]]]
      [if [not [= expected-fin server-fin-mac]]
        [raise "TLS: server Finished MAC mismatch"]
        null]

      # Step 8: send client Finished
      [client-fin-data: [hmac p.hash ks.fin-client-key [match p.hash
        [Sha256.Sha256]: [sha256 [concat ch-bytes sh-bytes ee-record cert-record cv-record fin-record]]
        [Sha384.Sha384]: [sha384 [concat ch-bytes sh-bytes ee-record cert-record cv-record fin-record]]
        _:               [sha256 [concat ch-bytes sh-bytes ee-record cert-record cv-record fin-record]]]]]
      [tls-write-record hs-conn ContentType.Handshake [encode-finished client-fin-data]]

      # Step 9: install application traffic keys → return TlsConnection
      [new-conn stream ks.app-client-key ks.app-server-key ks.app-client-iv ks.app-server-iv cipher cfg.sni negotiated-alpn]]]]

  # ── Server TLS ────────────────────────────────────────────────────────────────

  # TLS 1.3 server handshake per RFC 8446 §4 (mirror of client flow).
  # Message sequence:
  #   ← ClientHello: parse cipher suites, key_share, SNI, ALPN
  #   → ServerHello: choose cipher (choose-cipher), generate server key_share (x25519-keypair),
  #                  derive handshake keys (tls13-key-schedule with DH output)
  #       Install handshake traffic keys
  #   → EncryptedExtensions: selected ALPN, server_name ack
  #   → Certificate: cfg.certificate (DER)
  #   → CertificateVerify: sign transcript hash with cfg.private-key (sign-with-key)
  #   → Finished: HMAC over transcript with server_finished_key
  #       Derive application keys
  #   ← Finished: verify client Finished MAC
  #       Install application traffic keys → return TlsConnection.
  #   If client_auth required: ← Certificate + CertificateVerify after EncryptedExtensions.
  tls-accept: [fn@[bind: [h]  return: [or [TlsConnection h] TlsError]  constraint: [h: ByteStream]]
                [let cfg@TlsServerConfig h@h]
    # RFC 8446 §4 TLS 1.3 server handshake.

    # Step 1: read ClientHello
    [ch-record: [read-tls-record h]]
    [if [not [= [tag-of ch-record.content-type] "ContentType.Handshake"]]
      [TlsError.HandshakeFailed "expected Handshake record for ClientHello"]
      [if [not [= [get ch-record.payload 0] 1]]   # type byte must be 1 (ClientHello)
        [TlsError.HandshakeFailed "expected ClientHello message"]
        [block
        [ch: [parse-client-hello [slice ch-record.payload 4 [length ch-record.payload]]]]
        [ch-bytes: ch-record.payload]

        # Step 2: choose cipher suite and parse client key_share
        [cipher: [choose-cipher ch.cipher-suites cfg]]
        # Extract client x25519 key_share from extensions (0x0033)
        [find-ks: [fn [let exts pos]
          [if [>= pos [length exts]]
            [error "TLS: no key_share in ClientHello"]
            [block
              [ext-type: [uint16 ByteOrder.Network [slice exts pos [+ pos 2]]]]
              [ext-len:  [uint16 ByteOrder.Network [slice exts [+ pos 2] [+ pos 4]]]]
              [if [= ext-type 0x0033]
                # key_share_list: list-len(2) then entry: group(2)+key-len(2)+key-bytes
                [block
                  [list-len: [uint16 ByteOrder.Network [slice exts [+ pos 4] [+ pos 6]]]]
                  [slice exts [+ pos 10] [+ pos 10 32]]]   # x25519 = 32-byte key
                [find-ks exts [+ pos 4 ext-len]]]]]]]
        [client-pub: [find-ks ch.extensions 0]]
        # Extract ALPN from ClientHello extensions if present
        [parse-alpn: [fn [let p acc limit exts]
          [if [>= p limit]
            acc
            [block
              [plen: [get exts p]]
              [proto: [bytes-str [slice exts [+ p 1] [+ p 1 plen]]]]
              [parse-alpn [+ p 1 plen] [append acc [list proto]] limit exts]]]]]
        [find-alpn: [fn [let exts pos]
          [if [>= pos [length exts]]
            []
            [block
              [ext-type: [uint16 ByteOrder.Network [slice exts pos [+ pos 2]]]]
              [ext-len:  [uint16 ByteOrder.Network [slice exts [+ pos 2] [+ pos 4]]]]
              [if [= ext-type 0x0010]
                # ALPN list: list-len(2) + entries of len(1)+bytes
                [block
                  [alpn-list-len: [uint16 ByteOrder.Network [slice exts [+ pos 4] [+ pos 6]]]]
                  [parse-alpn [+ pos 6] [] [+ pos 6 alpn-list-len] exts]]
                [find-alpn exts [+ pos 4 ext-len]]]]]]]
        [client-alpn: [find-alpn ch.extensions 0]]
        [negotiated-alpn: [negotiate-alpn client-alpn cfg.alpn]]

        # Step 3: generate server ephemeral + derive handshake keys
        [eph:          [x25519-keypair]]
        [server-random: [crypto-random 32]]
        [dh-shared:    [x25519-dh eph.private client-pub]]

        # Step 4: build ServerHello
        [cs-bytes: [bytes ByteOrder.Network [@UInt16 cipher.code]]]
        [key-share-ext:
          [concat [0x00 0x33] [bytes ByteOrder.Network [@UInt16 36]] [bytes ByteOrder.Network [@UInt16 34]]
                  [bytes ByteOrder.Network [@UInt16 0x001d]] [bytes ByteOrder.Network [@UInt16 32]] eph.public]]
        [sv-ext:
          [concat [0x00 0x2b] [bytes ByteOrder.Network [@UInt16 2]] [0x03 0x04]]]
        [sh-extensions: [concat key-share-ext sv-ext]]
        [sh-body:
          [concat
            [0x03 0x03]                                           # legacy_version
            server-random                                         # 32-byte random
            [bytes ByteOrder.Network [@UInt8 32]] ch.session-id           # echo back session_id
            cs-bytes                                              # chosen cipher
            [0x00]                                                # null compression
            [bytes ByteOrder.Network [@UInt16 [length sh-extensions]]]
            sh-extensions]]
        [sh-msg: [encode-hs 2 sh-body]]   # type 2 = ServerHello
        [write-tls-record h [TlsRecord [content-type: ContentType.Handshake  payload: sh-msg]]]
        [sh-bytes: sh-msg]

        # Step 5: derive handshake traffic keys
        [ks: [tls13-key-schedule dh-shared ch-bytes sh-bytes cipher]]
        [hs-conn: [TlsConnection
          [underlying: h
           write-key:  ks.hs-server-key  write-iv: ks.hs-server-iv
           read-key:   ks.hs-client-key  read-iv:  ks.hs-client-iv
           cipher:     cipher
           write-seq:  [init-seq-ch]  read-seq: [init-seq-ch]
           sni:        Absent.Absent  negotiated-alpn: negotiated-alpn]]]

        # Step 6: send EncryptedExtensions (type 8)
        [alpn-ext: [if [absent? negotiated-alpn]
          [bytes 0]
          [block
            [apb: [str-bytes negotiated-alpn]]
            [concat [0x00 0x10] [bytes ByteOrder.Network [@UInt16 [+ 5 [length apb]]]]
                    [bytes ByteOrder.Network [@UInt16 [+ 3 [length apb]]]]
                    [bytes ByteOrder.Network [@UInt8 [length apb]]] apb]]]]
        [ee-exts: [if [> [length alpn-ext] 0]
          [concat [bytes ByteOrder.Network [@UInt16 [length alpn-ext]]] alpn-ext]
          [0x00 0x00]]]
        [ee-msg: [encode-hs 8 ee-exts]]
        [tls-write-record hs-conn ContentType.Handshake ee-msg]
        [ee-bytes: ee-msg]

        # Step 7: send Certificate (type 11)
        [cert-msg: [encode-certificate cfg.certificate]]
        [tls-write-record hs-conn ContentType.Handshake cert-msg]

        # Step 8: send CertificateVerify (type 15)
        # Sign: "TLS 1.3, server CertificateVerify\x00" (64 spaces) || transcript hash
        [p: [cipher-params cipher]]
        [transcript-so-far: [concat ch-bytes sh-bytes ee-bytes cert-msg]]
        [transcript-hash: [match p.hash
          [Sha256.Sha256]: [sha256 transcript-so-far]
          [Sha384.Sha384]: [sha384 transcript-so-far]
          _:               [sha256 transcript-so-far]]]
        [tls-cv-context-prefix: [str-bytes [concat
          "                                                                "   # 64 spaces
          "TLS 1.3, server CertificateVerify"]]]
        [cv-input: [concat tls-cv-context-prefix [bytes 0] transcript-hash]]
        [cv-sig: [sign-with-key cfg.private-key cv-input]]
        [cv-msg: [encode-certificate-verify cv-sig]]
        [tls-write-record hs-conn ContentType.Handshake cv-msg]

        # Step 9: send server Finished (type 20)
        [full-transcript-hash: [match p.hash
          [Sha256.Sha256]: [sha256 [concat ch-bytes sh-bytes ee-bytes cert-msg cv-msg]]
          [Sha384.Sha384]: [sha384 [concat ch-bytes sh-bytes ee-bytes cert-msg cv-msg]]
          _:               [sha256 [concat ch-bytes sh-bytes ee-bytes cert-msg cv-msg]]]]
        [fin-mac: [hmac p.hash ks.fin-server-key full-transcript-hash]]
        [fin-msg: [encode-finished fin-mac]]
        [tls-write-record hs-conn ContentType.Handshake fin-msg]

        # Step 10: read client Finished, verify MAC
        [client-fin-record: [tls-decrypt-conn-record hs-conn [read-tls-record h]]]
        [client-fin-mac: [parse-finished client-fin-record]]
        [client-transcript-hash: [match p.hash
          [Sha256.Sha256]: [sha256 [concat ch-bytes sh-bytes ee-bytes cert-msg cv-msg fin-msg]]
          [Sha384.Sha384]: [sha384 [concat ch-bytes sh-bytes ee-bytes cert-msg cv-msg fin-msg]]
          _:               [sha256 [concat ch-bytes sh-bytes ee-bytes cert-msg cv-msg fin-msg]]]]
        [expected-client-fin: [hmac p.hash ks.fin-client-key client-transcript-hash]]
        [if [not [= expected-client-fin client-fin-mac]]
          [TlsError.HandshakeFailed "client Finished MAC mismatch"]
          # Step 11: install application traffic keys → return TlsConnection
          [TlsConnection
            [underlying:      h
             write-key:       ks.app-server-key  write-iv: ks.app-server-iv
             read-key:        ks.app-client-key  read-iv:  ks.app-client-iv
             cipher:          cipher
             write-seq:       [init-seq-ch]  read-seq: [init-seq-ch]
             sni:             Absent.Absent
             negotiated-alpn: negotiated-alpn]]]]]]]]]

]

# TlsRecordCodec: TlsRecord ↔ encrypted Bytes (RFC 8446 §5.2 TLSCiphertext wire format).
# encode: seals plaintext record using conn write-key/write-iv/write-seq; emits TLSCiphertext bytes.
# decode: opens TLSCiphertext bytes using conn read-key/read-iv/read-seq; returns decrypted TlsRecord.
# Sequence counters in conn advance atomically on each call (via write-seq / read-seq channels).
[instance@[bind: [h]] Codec
  [let c@[TlsRecordCodec h] i@TlsRecord o@Bytes]:
  [encode: [fn [let codec@[TlsRecordCodec h] record@TlsRecord]
    # Seal: inner = payload || content-type byte; ciphertext = AEAD(write-key, nonce, inner, aad)
    # aad = 0x17 0x03 0x03 || ciphertext-length(2) per RFC 8446 §5.2
    [conn: codec.conn]
    [match [recv conn.write-seq]
      [Closed.Closed]: [error "TlsRecordCodec.encode: write-seq channel closed"]
      [Result.Ok seq]:
        [send conn.write-seq [+ seq 1]]
        [inner:      [concat record.payload [bytes record.content-type.code]]]
        [ct-len:     [@TlsLength [+ [length inner] 16]]]
        [aad:        [tls-record-aad ct-len]]
        [ciphertext: [tls-seal conn inner [tls-nonce conn.write-iv seq] aad]]
        # Wire format: 0x17 0x03 0x03 || length(2) || ciphertext
        [concat [0x17] [0x03 0x03] [bytes ByteOrder.Network ct-len] ciphertext]]  # TlsLength (ByteOrder.Network)]
  decode: [fn [let codec@[TlsRecordCodec h] data@Bytes]
    # Wire format: content-type(1) 0x03 0x03 length(2) ciphertext
    [conn:       codec.conn]
    [ct-len:     [@TlsLength [uint16 ByteOrder.Network [slice data 3 5]]]]
    [ciphertext: [slice data 5 [+ 5 ct-len]]]
    [match [recv conn.read-seq]
      [Closed.Closed]: [error "TlsRecordCodec.decode: read-seq channel closed"]
      [Result.Ok seq]:
        [send conn.read-seq [+ seq 1]]
        [aad:    [tls-record-aad ct-len]]
        [plain:  [tls-open conn ciphertext [tls-nonce conn.read-iv seq] aad]]
        # RFC 8446 §5.2: TLSInnerPlaintext = content || content_type || zeros*.
        # Scan from end to find last non-zero byte (the content-type byte).
        [find-ct-idx: [fn [let i]
          [if [< i 0] [error "TlsRecordCodec.decode: all-zero decrypted record"]
            [if [= [get plain i] 0] [find-ct-idx [- i 1]] i]]]]
        [ct-idx:  [find-ct-idx [- [length plain] 1]]]
        [TlsRecord content-type: [or [get code: [get plain ct-idx] ContentType] [error "TlsRecordCodec.decode: unknown content type"]]
                   payload:      [slice plain 0 ct-idx]]]]]]

# ── TlsLayer typeclass — bidirectional tls ────────────────────────────────────

[class [let TlsLayer input output]
  tls: [Fn@output [input]]]

# Client: TcpHandle → TlsHandle (sni inferred from addr, ALPN open for downstream layer)
[instance TlsLayer
  [let a@TcpHandle b@TlsHandle]: [tls: [fn [let h@TcpHandle]
    [TlsHandle [handle: h  sni: Absent.Absent  alpn: []  ech: []  trust-roots: SystemRoots]]]]]

# Server: TlsServerConfig → (Channel@h → Channel@TlsConnection h)
# Usage: [tcp-listen cap 443] | [tls cert] | h2-connection | recv
[instance@[bind: [h]  constraint: [h: ByteStream]] TlsLayer
  [let a@TlsServerConfig b@[Fn@[Channel [TlsConnection h]] [[Channel h]]]]:
  [tls: [fn [let cfg@TlsServerConfig]
    [fn [let ch@[Channel h]]
      [channel-map [fn [let s@h] [tls-accept cfg s]] ch]]]]]
