# stdlib/codecs/text.llt — UTF-8 Codec instances + encoding_rs backend (~38 WHATWG encodings).
# Part of: lib-net-v3
--- uses: ["text"]

[include %libdir "net.llt"]

# ── UTF-8 byte-class predicates ──────────────────────────────────────────────
# Defined before the instances so they're visible to both encode and decode paths.
[
  ascii?:   [fn [let n@Int] [< n 0x80]]               # 0xxxxxxx: ASCII codepoint or 1-byte lead byte
  bmp1-cp?: [fn [let cp@Int] [< cp 0x800]]            # U+0080-U+07FF: 2-byte encode range
  bmp2-cp?: [fn [let cp@Int] [< cp 0x10000]]          # U+0800-U+FFFF: 3-byte encode range
  utf8-2?:  [fn [let b@Int] [= [band b 0xE0] 0xC0]]  # 110xxxxx: 2-byte lead byte
  utf8-3?:  [fn [let b@Int] [= [band b 0xF0] 0xE0]]  # 1110xxxx: 3-byte lead byte

  # Encode one Unicode code point (Int) to UTF-8 Bytes.
  # Used by Utf8Graphemes.encode to re-encode each code point in a Grapheme = [Seq Int].
  encode-cp: [fn [let cp@Int]
    [match cp
      [ascii?]:   [bytes ByteOrder.Network [@UInt8 cp]]
      [bmp1-cp?]: [concat [bytes ByteOrder.Network [@UInt8 [bor 0xC0 [shr cp 6]]]]
                           [bytes ByteOrder.Network [@UInt8 [bor 0x80 [band cp 0x3F]]]]]
      [bmp2-cp?]: [concat [bytes ByteOrder.Network [@UInt8 [bor 0xE0 [shr cp 12]]]]
                           [bytes ByteOrder.Network [@UInt8 [bor 0x80 [band [shr cp 6] 0x3F]]]]
                           [bytes ByteOrder.Network [@UInt8 [bor 0x80 [band cp 0x3F]]]]]
      _:           [concat [bytes ByteOrder.Network [@UInt8 [bor 0xF0 [shr cp 18]]]]
                            [bytes ByteOrder.Network [@UInt8 [bor 0x80 [band [shr cp 12] 0x3F]]]]
                            [bytes ByteOrder.Network [@UInt8 [bor 0x80 [band [shr cp 6]  0x3F]]]]
                            [bytes ByteOrder.Network [@UInt8 [bor 0x80 [band cp          0x3F]]]]]]]
]

# ── Utf8 Codec instances ──────────────────────────────────────────────────────
# These implement the Codec typeclass from prelude.llt for UTF-8 at three levels.
# decode: takes (codec, bytes, offset) → {value next}; encode: (codec, value) → bytes.

# Byte view: Codec Utf8Bytes UInt8 Bytes — raw byte access, every byte is valid
[instance@[bind: []] Codec
  [let c@Utf8Bytes input@UInt8 output@Bytes]:
  [encode:     [fn [let _ b@UInt8] [bytes ByteOrder.Network [@UInt8 b]]]
   decode:     [fn [let _ buf@Bytes offset@Int
                    handler@[type: [or [CodecInvalidHandler UInt8 Bytes] Absent]  default: Absent.Absent]]
     [value: [get buf offset]  next: [+ offset 1]]]   # handler never called; all bytes valid UInt8
   codec-name: [fn [let _] "utf-8-bytes"]]]

# Grapheme view: Codec Utf8Graphemes Grapheme Bytes
# Grapheme = [Seq Int] — a sequence of Unicode code points (encoding-agnostic).
[instance@[bind: []] Codec
  [let c@Utf8Graphemes input@Grapheme output@Bytes]:
  [encode:     [fn [let _ g@Grapheme]
     [reduce [fn [let acc cp] [concat acc [encode-cp cp]]] [str-bytes ""] g]]
   decode:     [fn [let _ buf@Bytes offset@Int
                    handler@[type: [or [CodecInvalidHandler Grapheme Bytes] Absent]  default: Absent.Absent]]
     [h: [if [absent? handler] utf8-graphemes-strict handler]]
     [b0: [get buf offset]]
     [r0: [match b0
       [ascii?]:  [value: b0                     next: [+ offset 1]]
       [utf8-2?]: [value: [utf8-2 buf offset b0] next: [+ offset 2]]
       [utf8-3?]: [value: [utf8-3 buf offset b0] next: [+ offset 3]]
       _:          [h buf offset]]]
     [end: [gcb-cluster-end buf offset [gcb-property r0.value] gcb-initial-state]]
     [collect-cps: [fn [let off acc]
       [if [>= off end]
         [reverse acc]
         [cp-r: [utf8-decode-one buf off]]
         [collect-cps cp-r.next [cons cp-r.value acc]]]]]
     [value: [@Grapheme [collect-cps offset []]]  next: end]]
   codec-name: [fn [let _] "utf-8-graphemes"]]]

[type [UTF8]]       [type [UTF16LE]]   [type [UTF16BE]]
[type [Windows1252]] [type [Latin1]]  [type [ShiftJIS]]
[type [GBK]]        [type [Big5]]     [type [KOI8R]]
[type [ISO2022JP]]
# ... all ~38 WHATWG encodings backed by encoding_rs

# ── Per-codec on-invalid handlers ────────────────────────────────────────────
# Each codec defines its own handlers, named by codec. Not part of the Codec
# protocol — just values callers pass as the on-invalid argument.
# Instances reference their own defaults here; callers can pass any of these.
[
  # Utf8Graphemes handlers
  utf8-graphemes-strict: [fn@[CodecInvalidHandler Grapheme Bytes] [let _ offset@Int]
    [raise [str "invalid UTF-8 byte at offset " [str offset]]]]
  utf8-graphemes-lossy:  [fn@[CodecInvalidHandler Grapheme Bytes] [let _ offset@Int]
    [value: [@Grapheme [0xFFFD]]  next: [+ offset 1]]]    # U+FFFD as [Seq Int] with one code point

  # String encoding handlers (UTF8, UTF16LE, Windows1252, etc.)
  utf8-strict:        [fn@[CodecInvalidHandler String Bytes] [let _ offset@Int]
    [raise [str "invalid encoding at byte offset " [str offset]]]]
  utf8-lossy:         [fn@[CodecInvalidHandler String Bytes] [let _ offset@Int]
    [value: "\u{FFFD}"  next: [+ offset 1]]]       # U+FFFD as a string
]

# Whole-string text encoding Codec instances.
# These encode/decode complete strings — decode returns next = [length buf] (whole-buffer).
# on-invalid default: utf8-lossy — web content commonly has encoding errors.
# Callers doing strict protocol work pass utf8-strict explicitly.

[instance@[bind: []] Codec
  [let c@UTF8 input@String output@Bytes]:
  [encode:     [fn [let _ s@String] [builtin-utf8-encode s]]
   decode:     [fn [let _ b@Bytes offset@Int
                    handler@[type: [or [CodecInvalidHandler String Bytes] Absent]  default: Absent.Absent]]
     [h: [if [absent? handler] utf8-lossy handler]]
     [buf: [slice b offset [length b]]]
     [value: [builtin-utf8-decode buf h]  next: [length b]]]
   codec-name: [fn [let _] "utf-8"]]]

[instance@[bind: []] Codec
  [let c@UTF16LE input@String output@Bytes]:
  [encode:     [fn [let _ s@String] [builtin-encoding-encode "utf-16le" s]]
   decode:     [fn [let _ b@Bytes offset@Int
                    handler@[type: [or [CodecInvalidHandler String Bytes] Absent]  default: Absent.Absent]]
     [h: [if [absent? handler] utf8-lossy handler]]
     [buf: [slice b offset [length b]]]
     [value: [builtin-encoding-decode "utf-16le" buf h]  next: [length b]]]
   codec-name: [fn [let _] "utf-16le"]]]

[instance@[bind: []] Codec
  [let c@Windows1252 input@String output@Bytes]:
  [encode:     [fn [let _ s@String] [builtin-encoding-encode "windows-1252" s]]
   decode:     [fn [let _ b@Bytes offset@Int
                    handler@[type: [or [CodecInvalidHandler String Bytes] Absent]  default: Absent.Absent]]
     [h: [if [absent? handler] utf8-lossy handler]]
     [buf: [slice b offset [length b]]]
     [value: [builtin-encoding-decode "windows-1252" buf h]  next: [length b]]]
   codec-name: [fn [let _] "windows-1252"]]]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  # ── Grapheme Break Property tables (UAX#29, Unicode 17.0) ────────────────────
  # Source: GraphemeBreakProperty.txt + emoji-data.txt (Extended_Pictographic)
  # All ranges [lo: hi:] inclusive. Hangul LV/LVT are computed algorithmically.

  gcb-cr:  [[lo: 0x000D hi: 0x000D]]
  gcb-lf:  [[lo: 0x000A hi: 0x000A]]
  gcb-zwj: [[lo: 0x200D hi: 0x200D]]
  gcb-ri:  [[lo: 0x1F1E6 hi: 0x1F1FF]]  # Regional Indicator (A–Z flag letters)

  gcb-prepend: [
    [lo: 0x0600  hi: 0x0605] [lo: 0x06DD  hi: 0x06DD] [lo: 0x070F  hi: 0x070F]
    [lo: 0x0890  hi: 0x0891] [lo: 0x08E2  hi: 0x08E2] [lo: 0x0D4E  hi: 0x0D4E]
    [lo: 0x110BD hi: 0x110BD] [lo: 0x110CD hi: 0x110CD] [lo: 0x111C2 hi: 0x111C3]
    [lo: 0x113D1 hi: 0x113D1] [lo: 0x1193F hi: 0x1193F] [lo: 0x11941 hi: 0x11941]
    [lo: 0x11A84 hi: 0x11A89] [lo: 0x11D46 hi: 0x11D46] [lo: 0x11F02 hi: 0x11F02]]

  gcb-control: [
    [lo: 0x0000  hi: 0x0009] [lo: 0x000B  hi: 0x000C] [lo: 0x000E  hi: 0x001F]
    [lo: 0x007F  hi: 0x009F] [lo: 0x00AD  hi: 0x00AD] [lo: 0x061C  hi: 0x061C]
    [lo: 0x180E  hi: 0x180E] [lo: 0x200B  hi: 0x200B] [lo: 0x200E  hi: 0x200F]
    [lo: 0x2028  hi: 0x2028] [lo: 0x2029  hi: 0x2029] [lo: 0x202A  hi: 0x202E]
    [lo: 0x2060  hi: 0x2065] [lo: 0x2066  hi: 0x206F] [lo: 0xFEFF  hi: 0xFEFF]
    [lo: 0xFFF0  hi: 0xFFFB] [lo: 0x13430 hi: 0x1343F] [lo: 0x1BCA0 hi: 0x1BCA3]
    [lo: 0x1D173 hi: 0x1D17A] [lo: 0xE0000 hi: 0xE0001] [lo: 0xE0002 hi: 0xE001F]
    [lo: 0xE0080 hi: 0xE00FF] [lo: 0xE01F0 hi: 0xE0FFF]]

  # Hangul leading jamo (L), vowel jamo (V), trailing jamo (T)
  gcb-l: [[lo: 0x1100  hi: 0x115F] [lo: 0xA960 hi: 0xA97C]]
  gcb-v: [[lo: 0x1160  hi: 0x11A7] [lo: 0xD7B0 hi: 0xD7C6]
           [lo: 0x16D63 hi: 0x16D63] [lo: 0x16D67 hi: 0x16D6A]]
  gcb-t: [[lo: 0x11A8  hi: 0x11FF] [lo: 0xD7CB hi: 0xD7FB]]
  # Hangul LV/LVT: algorithmic — no table needed
  # is-hangul-lv?  cp = [and [in-range? cp 0xAC00 0xD7A3] [= 0 [mod [- cp 0xAC00] 28]]]
  # is-hangul-lvt? cp = [and [in-range? cp 0xAC00 0xD7A3] [not [= 0 [mod [- cp 0xAC00] 28]]]]

  # Extend (220 ranges): combining marks, emoji modifiers, variation selectors
  gcb-extend: [
    [lo: 0x0300 hi: 0x036F] [lo: 0x0483 hi: 0x0489] [lo: 0x0591 hi: 0x05BD]
    [lo: 0x05BF hi: 0x05BF] [lo: 0x05C1 hi: 0x05C2] [lo: 0x05C4 hi: 0x05C5]
    [lo: 0x05C7 hi: 0x05C7] [lo: 0x0610 hi: 0x061A] [lo: 0x064B hi: 0x065F]
    [lo: 0x0670 hi: 0x0670] [lo: 0x06D6 hi: 0x06DC] [lo: 0x06DF hi: 0x06E4]
    [lo: 0x06E7 hi: 0x06E8] [lo: 0x06EA hi: 0x06ED] [lo: 0x0711 hi: 0x0711]
    [lo: 0x0730 hi: 0x074A] [lo: 0x07A6 hi: 0x07B0] [lo: 0x07EB hi: 0x07F3]
    [lo: 0x07FD hi: 0x07FD] [lo: 0x0816 hi: 0x0823] [lo: 0x0825 hi: 0x0827]
    [lo: 0x0829 hi: 0x082D] [lo: 0x0859 hi: 0x085B] [lo: 0x0897 hi: 0x089F]
    [lo: 0x08CA hi: 0x0902] [lo: 0x093A hi: 0x093A] [lo: 0x093C hi: 0x093C]
    [lo: 0x0941 hi: 0x0948] [lo: 0x094D hi: 0x094D] [lo: 0x0951 hi: 0x0957]
    [lo: 0x0962 hi: 0x0963] [lo: 0x0981 hi: 0x0981] [lo: 0x09BC hi: 0x09BC]
