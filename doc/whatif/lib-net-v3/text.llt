  gcb-spacing-mark: [
    [lo: 0x0903 hi: 0x0903] [lo: 0x093B hi: 0x093B] [lo: 0x093E hi: 0x0940]
    [lo: 0x0949 hi: 0x094C] [lo: 0x094E hi: 0x094F] [lo: 0x0982 hi: 0x0983]
