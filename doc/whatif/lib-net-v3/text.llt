    [lo: 0x1F96C hi: 0x1F970] [lo: 0x1F971 hi: 0x1F971] [lo: 0x1F972 hi: 0x1F972]
    [lo: 0x1F973 hi: 0x1F976] [lo: 0x1F977 hi: 0x1F978] [lo: 0x1F979 hi: 0x1F979]
    [lo: 0x1F97A hi: 0x1F97A] [lo: 0x1F97B hi: 0x1F97B] [lo: 0x1F97C hi: 0x1F97F]
    [lo: 0x1F980 hi: 0x1F984] [lo: 0x1F985 hi: 0x1F991] [lo: 0x1F992 hi: 0x1F997]
    [lo: 0x1F998 hi: 0x1F9A2] [lo: 0x1F9A3 hi: 0x1F9A4] [lo: 0x1F9A5 hi: 0x1F9AA]
    [lo: 0x1F9AB hi: 0x1F9AD] [lo: 0x1F9AE hi: 0x1F9AF] [lo: 0x1F9B0 hi: 0x1F9B9]
    [lo: 0x1F9BA hi: 0x1F9BF] [lo: 0x1F9C0 hi: 0x1F9C0] [lo: 0x1F9C1 hi: 0x1F9C2]
    [lo: 0x1F9C3 hi: 0x1F9CA] [lo: 0x1F9CB hi: 0x1F9CB] [lo: 0x1F9CC hi: 0x1F9CC]
    [lo: 0x1F9CD hi: 0x1F9CF] [lo: 0x1F9D0 hi: 0x1F9E6] [lo: 0x1F9E7 hi: 0x1F9FF]
    [lo: 0x1FA58 hi: 0x1FA5F] [lo: 0x1FA6E hi: 0x1FA6F] [lo: 0x1FA70 hi: 0x1FA73]
    [lo: 0x1FA74 hi: 0x1FA74] [lo: 0x1FA75 hi: 0x1FA77] [lo: 0x1FA78 hi: 0x1FA7A]
    [lo: 0x1FA7B hi: 0x1FA7C] [lo: 0x1FA7D hi: 0x1FA7F] [lo: 0x1FA80 hi: 0x1FA82]
    [lo: 0x1FA83 hi: 0x1FA86] [lo: 0x1FA87 hi: 0x1FA88] [lo: 0x1FA89 hi: 0x1FA89]
    [lo: 0x1FA8A hi: 0x1FA8A] [lo: 0x1FA8B hi: 0x1FA8D] [lo: 0x1FA8E hi: 0x1FA8E]
    [lo: 0x1FA8F hi: 0x1FA8F] [lo: 0x1FA90 hi: 0x1FA95] [lo: 0x1FA96 hi: 0x1FAA8]
    [lo: 0x1FAA9 hi: 0x1FAAC] [lo: 0x1FAAD hi: 0x1FAAF] [lo: 0x1FAB0 hi: 0x1FAB6]
    [lo: 0x1FAB7 hi: 0x1FABA] [lo: 0x1FABB hi: 0x1FABD] [lo: 0x1FABE hi: 0x1FABE]
    [lo: 0x1FABF hi: 0x1FABF] [lo: 0x1FAC0 hi: 0x1FAC2] [lo: 0x1FAC3 hi: 0x1FAC5]
    [lo: 0x1FAC6 hi: 0x1FAC6] [lo: 0x1FAC8 hi: 0x1FAC8] [lo: 0x1FACD hi: 0x1FACD]
    [lo: 0x1FACE hi: 0x1FACF] [lo: 0x1FAD0 hi: 0x1FAD6] [lo: 0x1FAD7 hi: 0x1FAD9]
    [lo: 0x1FADA hi: 0x1FADB] [lo: 0x1FADC hi: 0x1FADC] [lo: 0x1FADD hi: 0x1FADF]
    [lo: 0x1FAE0 hi: 0x1FAE7] [lo: 0x1FAE8 hi: 0x1FAE8] [lo: 0x1FAE9 hi: 0x1FAE9]
    [lo: 0x1FAEA hi: 0x1FAEA] [lo: 0x1FAEB hi: 0x1FAEF] [lo: 0x1FAF0 hi: 0x1FAF6]
    [lo: 0x1FAF7 hi: 0x1FAF8]]

  # ── Grapheme break property classification ────────────────────────────────────

  in-range?: [fn [let cp@Int lo@Int hi@Int] [and [>= cp lo] [<= cp hi]]]

  # Predicate patterns (T-1140): lowercase-head in pattern position evaluates with
  # subject appended last. [match cp [in-ranges? gcb-cr]: ...] → [in-ranges? gcb-cr cp]
  gcb-property: [fn [let cp@Int]
    [match cp
      [in-ranges? gcb-cr]:                                       "CR"
      [in-ranges? gcb-lf]:                                       "LF"
      [in-ranges? gcb-control]:                                  "Control"
      [in-ranges? gcb-extend]:                                   "Extend"
      [in-ranges? gcb-zwj]:                                      "ZWJ"
      [in-ranges? gcb-ri]:                                       "RI"
      [in-ranges? gcb-prepend]:                                  "Prepend"
      [in-ranges? gcb-spacing-mark]:                             "SpacingMark"
      [in-ranges? gcb-l]:                                        "L"
      [in-ranges? gcb-v]:                                        "V"
      [in-ranges? gcb-t]:                                        "T"
      [[and [in-range? _ 0xAC00 0xD7A3] [= 0 [mod [- _ 0xAC00] 28]]]]: "LV"
      [in-range? _ 0xAC00 0xD7A3]:                               "LVT"
      [in-ranges? gcb-extended-pictographic]:                    "ExtPic"
      _:                                                         "Other"]]

  # ── UAX#29 grapheme cluster boundary algorithm ────────────────────────────────
  # Returns true if there is a grapheme cluster boundary BEFORE cp2.
  # Structural dict patterns — priority order matches UAX#29 §3.1.1 rule numbering.
  # Dict patterns are always open (extra keys silently ignored), so [p1: "CR"] matches
  # the full scrutinee dict regardless of p2/st. Nested [st: [...]] matches state fields.
  gcb-boundary?: [fn [let prop1@String prop2@String state]
    [match [p1: prop1  p2: prop2  st: state]
      # GB3: CR × LF — never break
      [p1: "CR"   p2: "LF"]:                                                        false
      # GB4: break after Control|CR|LF
      [p1: "Control"]:                                                               true
      [p1: "CR"]:                                                                    true
      [p1: "LF"]:                                                                    true
      # GB5: break before Control|CR|LF
      [p2: "Control"]:                                                               true
      [p2: "CR"]:                                                                    true
      [p2: "LF"]:                                                                    true
      # GB6: L × (L|V|LV|LVT)
      [p1: "L"    p2: "L"]:                                                         false
      [p1: "L"    p2: "V"]:                                                         false
      [p1: "L"    p2: "LV"]:                                                        false
      [p1: "L"    p2: "LVT"]:                                                       false
      # GB7: (LV|V) × (V|T)
      [p1: "LV"   p2: "V"]:                                                         false
      [p1: "LV"   p2: "T"]:                                                         false
      [p1: "V"    p2: "V"]:                                                         false
      [p1: "V"    p2: "T"]:                                                         false
      # GB8: (LVT|T) × T
      [p1: "LVT"  p2: "T"]:                                                         false
      [p1: "T"    p2: "T"]:                                                         false
      # GB9: × (Extend|ZWJ)
      [p2: "Extend"]:                                                                false
      [p2: "ZWJ"]:                                                                   false
      # GB9a: × SpacingMark
      [p2: "SpacingMark"]:                                                           false
      # GB9b: Prepend ×
      [p1: "Prepend"]:                                                               false
      # GB11: ExtPic Extend* ZWJ × ExtPic — state tracks the ZWJ-after-pictographic sequence
      [p1: "ZWJ"  p2: "ExtPic"  st: [ep-seen?: true  extend-after-ep?: true]]:     false
      # GB12/13: RI × RI — break between each pair (state counts RIs seen)
      [p1: "RI"   p2: "RI"]:                                                        [= [mod state.ri-count 2] 1]
      # GB999: break everywhere else
      _: true]]

  # Advance grapheme state after processing a code point with given property.
  gcb-next-state: [fn [let prop@String prev-state]
    [match prop
      "ExtPic":    [ep-seen?: true   extend-after-ep?: true  ri-count: 0]
      "Extend":    [ep-seen?: prev-state.ep-seen?
                    extend-after-ep?: prev-state.extend-after-ep?
                    ri-count: 0]
      "ZWJ":       [ep-seen?: prev-state.ep-seen?
                    extend-after-ep?: prev-state.extend-after-ep?
                    ri-count: 0]
      "RI":        [ep-seen?: false  extend-after-ep?: false
                    ri-count: [+ prev-state.ri-count 1]]
      _:           [ep-seen?: false  extend-after-ep?: false  ri-count: 0]]]

  gcb-initial-state: [ep-seen?: false  extend-after-ep?: false  ri-count: 0]

  # ── Core grapheme segmentation: bytes → lazy [Seq String] of clusters ─────────

  # Decode one UTF-8 code point from bytes at offset.
  # Returns {value: Int  next: Int}.
  utf8-decode-one: [fn [let b@Bytes offset@Int]
    [b0: [get b offset]]
    [match b0
      [ascii?]:  [value: b0                next: [+ offset 1]]
      [utf8-2?]: [value: [utf8-2 b offset b0]  next: [+ offset 2]]
      [utf8-3?]: [value: [utf8-3 b offset b0]  next: [+ offset 3]]
      _:          [value: [utf8-4 b offset b0]  next: [+ offset 4]]]]

  # Scan forward from `cluster-start`, collecting code points belonging to one grapheme cluster.
  # Returns {end: Int} — the byte offset just after the cluster.
  # `prev-prop` and `state` are the property/state of the last seen code point.
  gcb-cluster-end: [fn [let b@Bytes cluster-start@Int prev-prop@String state]
    [n: [length b]]
    [scan: [fn [let offset prev-prop state]
      [if [>= offset n]
        offset
        [block
          [r:    [utf8-decode-one b offset]]
          [prop: [gcb-property r.value]]
          [if [gcb-boundary? prev-prop prop state]
            offset    # boundary found — cluster ends here
            [scan r.next prop [gcb-next-state prop state]]]]]]]
    [r0: [utf8-decode-one b cluster-start]]
    [scan r0.next [gcb-property r0.value] [gcb-next-state [gcb-property r0.value] gcb-initial-state]]]

  # ── UTF-8 decoder (refactored using cont-bits / utf8-2/3/4) ─────────────────

  # Decode UTF-8 bytes to a list of Unicode code points (Characters).
  # Now readable because the bit-twiddling is named in utf8-2/3/4.
  utf8-decode: [fn [let b@Bytes]
    [step: [fn [let i acc]
      [if [>= i [length b]]
        [reverse acc]
        [block
          [b0: [get b i]]
          [match b0
            [ascii?]:  [step [+ i 1] [cons b0 acc]]
            [utf8-2?]: [step [+ i 2] [cons [utf8-2 b i b0] acc]]
            [utf8-3?]: [step [+ i 3] [cons [utf8-3 b i b0] acc]]
            _:          [step [+ i 4] [cons [utf8-4 b i b0] acc]]]]]
    [step 0 []]]

  # ── IDNA2008 Unicode property tables ─────────────────────────────────────────
  # Source: Unicode 17.0 DerivedBidiClass.txt and DerivedJoiningType.txt
  # Range format: [lo: 0x... hi: 0x...] — inclusive on both ends.

  # Bidi class R (Right-to-Left): Hebrew, Samaritan, and other RTL scripts.
  bidi-r-ranges: [
    [lo: 0x05BE  hi: 0x05BE] [lo: 0x05C0  hi: 0x05C0] [lo: 0x05C3  hi: 0x05C3]
    [lo: 0x05C6  hi: 0x05C6] [lo: 0x05D0  hi: 0x05EA] [lo: 0x05EF  hi: 0x05F4]
    [lo: 0x07C0  hi: 0x07EA] [lo: 0x07F4  hi: 0x07F5] [lo: 0x07FA  hi: 0x07FA]
    [lo: 0x07FE  hi: 0x0815] [lo: 0x081A  hi: 0x081A] [lo: 0x0824  hi: 0x0824]
    [lo: 0x0828  hi: 0x0828] [lo: 0x0830  hi: 0x083E] [lo: 0x0840  hi: 0x0858]
    [lo: 0x085E  hi: 0x085E] [lo: 0x200F  hi: 0x200F] [lo: 0xFB1D  hi: 0xFB1D]
    [lo: 0xFB1F  hi: 0xFB36] [lo: 0xFB38  hi: 0xFB3C] [lo: 0xFB3E  hi: 0xFB3E]
    [lo: 0xFB40  hi: 0xFB41] [lo: 0xFB43  hi: 0xFB44] [lo: 0xFB46  hi: 0xFB4F]
    [lo: 0x10800 hi: 0x10805] [lo: 0x10808 hi: 0x10808] [lo: 0x1080A hi: 0x10835]
    [lo: 0x10837 hi: 0x10838] [lo: 0x1083C hi: 0x1083C] [lo: 0x1083F hi: 0x10855]
    [lo: 0x10857 hi: 0x1085F] [lo: 0x10860 hi: 0x10878] [lo: 0x10879 hi: 0x1087F]
    [lo: 0x10880 hi: 0x1089E] [lo: 0x108A7 hi: 0x108AF] [lo: 0x108E0 hi: 0x108F5]
    [lo: 0x108FB hi: 0x10915] [lo: 0x10916 hi: 0x1091B] [lo: 0x10920 hi: 0x1093F]
    [lo: 0x10940 hi: 0x10959] [lo: 0x10980 hi: 0x109BD] [lo: 0x109BE hi: 0x109FF]
    [lo: 0x10A00 hi: 0x10A00] [lo: 0x10A10 hi: 0x10A48] [lo: 0x10A50 hi: 0x10A9F]
    [lo: 0x10AC0 hi: 0x10AEF] [lo: 0x10AF0 hi: 0x10AF6] [lo: 0x10B00 hi: 0x10B91]
    [lo: 0x10B99 hi: 0x10BAF] [lo: 0x10C00 hi: 0x10CF2] [lo: 0x10CFA hi: 0x10D65]
    [lo: 0x10D6F hi: 0x10D8F] [lo: 0x10E80 hi: 0x10EAD] [lo: 0x10EB0 hi: 0x10EB1]
    [lo: 0x10F00 hi: 0x10F89] [lo: 0x10FB0 hi: 0x10FCB] [lo: 0x10FE0 hi: 0x10FF6]
    [lo: 0x1E800 hi: 0x1E95F]]

  # Bidi class AL (Arabic Letter): Arabic and other Arabic-script languages.
  # Source: @missing directives in DerivedBidiClass.txt — these ranges default to AL.
  bidi-al-ranges: [
    [lo: 0x0600  hi: 0x07BF]
    [lo: 0x0860  hi: 0x08FF]
    [lo: 0x10D00 hi: 0x10D3F]
    [lo: 0x10EC0 hi: 0x10EFF]
    [lo: 0x10F30 hi: 0x10F6F]
    [lo: 0x1EC70 hi: 0x1ECBF]
    [lo: 0x1ED00 hi: 0x1ED4F]
    [lo: 0x1EE00 hi: 0x1EEFF]]

  # Bidi class AN (Arabic Number): Arabic-Indic and extended Arabic-Indic digits.
  bidi-an-ranges: [
    [lo: 0x0600  hi: 0x0605] [lo: 0x0660  hi: 0x0669] [lo: 0x066B  hi: 0x066C]
    [lo: 0x06DD  hi: 0x06DD] [lo: 0x0890  hi: 0x0891] [lo: 0x08E2  hi: 0x08E2]
    [lo: 0x10D30 hi: 0x10D39] [lo: 0x10D40 hi: 0x10D49] [lo: 0x10E60 hi: 0x10E7E]]

  # Joining types D (Dual), L (Left), R (Right) — for ZWNJ/ZWJ ContextJ rules (RFC 5892 §A.1–A.2).
  # A ZWNJ is valid after a Virama, or between joining characters (D/L/R with T characters in between).
  # T (Transparent) ranges — needed to skip over when checking ZWNJ context.
  # 225 T ranges omitted for brevity; use unicode-normalization crate's joining-type lookup
  # for the T check. The D/L/R check (has-joining-char? below) does not need T ranges.
  joining-dlr-ranges: [
    # Dual_Joining (D): Arabic, Syriac, N'Ko, Mongolian, Old Sogdian, etc.
    [lo: 0x0620  hi: 0x0620  type: "D"] [lo: 0x0626  hi: 0x0626  type: "D"]
    [lo: 0x0628  hi: 0x0628  type: "D"] [lo: 0x062A  hi: 0x062E  type: "D"]
    [lo: 0x0633  hi: 0x063F  type: "D"] [lo: 0x0641  hi: 0x0647  type: "D"]
    [lo: 0x0649  hi: 0x064A  type: "D"] [lo: 0x066E  hi: 0x066F  type: "D"]
    [lo: 0x0678  hi: 0x0687  type: "D"] [lo: 0x069A  hi: 0x06BF  type: "D"]
    [lo: 0x06C1  hi: 0x06C2  type: "D"] [lo: 0x06CC  hi: 0x06CC  type: "D"]
    [lo: 0x06CE  hi: 0x06CE  type: "D"] [lo: 0x06D0  hi: 0x06D1  type: "D"]
    [lo: 0x06FA  hi: 0x06FC  type: "D"] [lo: 0x06FF  hi: 0x06FF  type: "D"]
    [lo: 0x0712  hi: 0x0714  type: "D"] [lo: 0x071A  hi: 0x071D  type: "D"]
    [lo: 0x071F  hi: 0x0727  type: "D"] [lo: 0x0729  hi: 0x0729  type: "D"]
    [lo: 0x072B  hi: 0x072B  type: "D"] [lo: 0x072D  hi: 0x072E  type: "D"]
    [lo: 0x074E  hi: 0x0758  type: "D"] [lo: 0x075C  hi: 0x076A  type: "D"]
    [lo: 0x076D  hi: 0x0770  type: "D"] [lo: 0x0772  hi: 0x0772  type: "D"]
    [lo: 0x0775  hi: 0x0777  type: "D"] [lo: 0x077A  hi: 0x077F  type: "D"]
    [lo: 0x07CA  hi: 0x07EA  type: "D"] [lo: 0x0841  hi: 0x0845  type: "D"]
    [lo: 0x0848  hi: 0x0848  type: "D"] [lo: 0x084A  hi: 0x0853  type: "D"]
    [lo: 0x0855  hi: 0x0855  type: "D"] [lo: 0x0860  hi: 0x0860  type: "D"]
    [lo: 0x0862  hi: 0x0865  type: "D"] [lo: 0x0868  hi: 0x0868  type: "D"]
    [lo: 0x0886  hi: 0x0886  type: "D"] [lo: 0x0889  hi: 0x088D  type: "D"]
    [lo: 0x088F  hi: 0x088F  type: "D"] [lo: 0x08A0  hi: 0x08C8  type: "D"]
    [lo: 0x1807  hi: 0x1807  type: "D"] [lo: 0x1820  hi: 0x1878  type: "D"]
    [lo: 0x1887  hi: 0x18AA  type: "D"] [lo: 0xA840  hi: 0xA871  type: "D"]
    [lo: 0x10AC0 hi: 0x10AE0 type: "D"] [lo: 0x10AEB hi: 0x10AEE type: "D"]
    [lo: 0x10B80 hi: 0x10B91 type: "D"] [lo: 0x10BAD hi: 0x10BAE type: "D"]
    [lo: 0x10D01 hi: 0x10D23 type: "D"] [lo: 0x10EC3 hi: 0x10EC7 type: "D"]
    [lo: 0x10F30 hi: 0x10F81 type: "D"] [lo: 0x10FB0 hi: 0x10FCB type: "D"]
    [lo: 0x1E900 hi: 0x1E943 type: "D"]
    # Right_Joining (R): Arabic letters that only join on the right
    [lo: 0x0622  hi: 0x0625  type: "R"] [lo: 0x0627  hi: 0x0627  type: "R"]
    [lo: 0x0629  hi: 0x0629  type: "R"] [lo: 0x062F  hi: 0x0632  type: "R"]
    [lo: 0x0648  hi: 0x0648  type: "R"] [lo: 0x0671  hi: 0x0677  type: "R"]
    [lo: 0x0688  hi: 0x0699  type: "R"] [lo: 0x06C0  hi: 0x06D5  type: "R"]
    [lo: 0x06EE  hi: 0x06EF  type: "R"] [lo: 0x0710  hi: 0x0710  type: "R"]
    [lo: 0x0715  hi: 0x071E  type: "R"] [lo: 0x0728  hi: 0x072C  type: "R"]
    [lo: 0x072F  hi: 0x072F  type: "R"] [lo: 0x074D  hi: 0x074D  type: "R"]
    [lo: 0x0759  hi: 0x075B  type: "R"] [lo: 0x076B  hi: 0x076C  type: "R"]
    [lo: 0x0771  hi: 0x0774  type: "R"] [lo: 0x0778  hi: 0x0779  type: "R"]
    [lo: 0x0840  hi: 0x0858  type: "R"] [lo: 0x0867  hi: 0x086A  type: "R"]
    [lo: 0x0870  hi: 0x088E  type: "R"] [lo: 0x08AA  hi: 0x08B2  type: "R"]
    [lo: 0x08B9  hi: 0x08C8  type: "R"] [lo: 0x10AC5 hi: 0x10ACE type: "R"]
    [lo: 0x10ADD hi: 0x10AE4 type: "R"] [lo: 0x10AEF hi: 0x10AEF type: "R"]
    [lo: 0x10B81 hi: 0x10B91 type: "R"] [lo: 0x10BA9 hi: 0x10BAC type: "R"]
    [lo: 0x10D22 hi: 0x10D22 type: "R"] [lo: 0x10EC2 hi: 0x10EC2 type: "R"]
    [lo: 0x10F33 hi: 0x10F54 type: "R"] [lo: 0x10FB4 hi: 0x10FCB type: "R"]
    # Left_Joining (L): a handful of characters
    [lo: 0xA872   hi: 0xA872   type: "L"] [lo: 0x10ACD hi: 0x10ACD type: "L"]
    [lo: 0x10AD7  hi: 0x10AD7  type: "L"] [lo: 0x10D00 hi: 0x10D00 type: "L"]
    [lo: 0x10FCB  hi: 0x10FCB  type: "L"]]

  # Virama characters (Canonical_Combining_Class = 9): used in ContextJ ZWNJ rule (RFC 5892 §A.1).
  # A ZWNJ is always valid immediately after a Virama regardless of surrounding joining context.
  virama-codepoints: [
    # Devanagari, Bengali, Gurmukhi, Gujarati, Oriya, Tamil, Telugu, Kannada, Malayalam:
    0x094D  0x09CD  0x0A4D  0x0ACD  0x0B4D  0x0BCD  0x0C4D  0x0CCD  0x0D4D
    # Sinhala, Thai, Lao, Tibetan, Myanmar, Khmer, Limbu, Buginese, New Tai Lue:
    0x0DCA  0x0E3A  0x0EBA  0x0F84  0x1039  0x103A  0x1714  0x1734  0x17D2  0x1A60  0x1B44
    # Sundanese, Batak, Lepcha, Rejang, Javanese, Cham, Mongolian, Meetei Mayek:
    0x1BAA  0x1BAB  0x1BF2  0x1BF3  0x1C37  0x A8C4  0x1A7F  0xA953  0xABED
    # Syloti Nagri, Phags-pa, Saurashtra, Kayah Li, Rejang, Cham:
    0xA8C4  0xA9C0  0xAA70  0xAAF6  0xABED
    # Kaithi, Chakma, Sharada, Khojki, Khudawadi, Tirhuta, Siddham, Modi, Takri:
    0x11046 0x11070 0x110B9 0x11133 0x11134 0x111C0 0x11235 0x112EA 0x1134D
    # Grantha, Newa, Tirhuta, Ahom, Zanabazar, Soyombo, Masaram Gondi, Nandinagari:
    0x1163F 0x114C2 0x115BF 0x116B6 0x1172B 0x11839 0x119E0 0x11A3A 0x11A99
    # Dogra, Gunjala Gondi, Makasar, Lisu, Hanifi Rohingya, Old Sogdian:
    0x11C3F 0x11D3A 0x11D44 0x11D45 0x11D97 0x11EF7]

  # ContextO rules (RFC 5892 §A.3–A.8): specific characters allowed only in certain contexts.
  # Each entry: code point + the rule name (for error reporting).
  contexto-rules: [
    [cp: 0x00B7  rule: "middle-dot"]         # MIDDLE DOT: only between two 'l' (Catalan)
    [cp: 0x0375  rule: "greek-lower-numeral"] # GREEK LOWER NUMERAL SIGN: before Greek only
    [cp: 0x05F3  rule: "hebrew-geresh"]       # HEBREW PUNCTUATION GERESH: after Hebrew only
    [cp: 0x05F4  rule: "hebrew-gershayim"]    # HEBREW PUNCTUATION GERSHAYIM: after Hebrew only
    [cp: 0x30FB  rule: "katakana-middle-dot"] # KATAKANA MIDDLE DOT: with CJK scripts only
    [cp: 0xFF65  rule: "halfwidth-katakana-middle-dot"]]

  # ── Unicode property lookup helpers ──────────────────────────────────────────

  # Test if a code point falls in any of a list of [lo: hi:] ranges.
  in-ranges?: [fn [let cp@Int ranges@[Seq [lo: Int  hi: Int]]]
    [any? [fn [let r] [and [>= cp r.lo] [<= cp r.hi]]] ranges]]

  # Test if cp has Bidi class R, AL, or AN (i.e. is right-to-left in IDNA sense).
  bidi-rtl?: [fn [let cp@Int]
    [or [in-ranges? cp bidi-r-ranges]
        [in-ranges? cp bidi-al-ranges]
        [in-ranges? cp bidi-an-ranges]]]

  # Test if cp has joining type D, L, or R (not Transparent, not Non-joining).
  has-joining-type-dlr?: [fn [let cp@Int]
    [any? [fn [let r] [and [>= cp r.lo] [<= cp r.hi]]] joining-dlr-ranges]]

  # Test if cp is a Virama.
  virama?: [fn [let cp@Int]
    [any? [fn [let v] [= cp v]] virama-codepoints]]

  # ── IDNA2008 label validation ─────────────────────────────────────────────────

  # Validate ZWNJ (U+200C) context per RFC 5892 §A.1.
  # Valid after a Virama, or between joining characters (D/L/R) with at most
  # transparent characters in between.
  valid-zwnj?: [fn [let cps@[Seq Int] pos@Int]
    # Rule 1: preceded by a Virama
    [prev: [if [> pos 0] [get cps [- pos 1]] 0]]
    [if [virama? prev]
      true
      # Rule 2: preceded by a joining char (D/L), followed by joining char (D/R)
      # (skipping over Transparent characters in each direction — simplified here)
      [before?: [any? [fn [let cp] [has-joining-type-dlr? cp]]
                  [collect [take pos cps]]]]
      [after?: [any? [fn [let cp] [has-joining-type-dlr? cp]]
                 [collect [drop [+ pos 1] cps]]]]
      [and before? after?]]]

  # Validate IDNA2008 Bidi rule (RFC 5893 §2) for a single label's code points.
  valid-bidi?: [fn [let cps@[Seq Int]]
    [is-rtl?: [any? bidi-rtl? cps]]
    [if [not is-rtl?]
      true  # LTR label: first and last must be LTR — simplified (non-RTL passes)
      # RTL label: first char must be R or AL; last must be R, AL, EN, or AN.
      [first-cp: [head cps]]
      [last-cp:  [get cps [- [length cps] 1]]]
      [first-ok?: [or [in-ranges? first-cp bidi-r-ranges] [in-ranges? first-cp bidi-al-ranges]]]
      [last-ok?:  [or [bidi-rtl? last-cp] [in-ranges? last-cp bidi-an-ranges]]]
      [and first-ok? last-ok?]]]

  # Validate a single IDNA2008 label's code points.
  # Returns true if valid, false if the label should be rejected.
  valid-idna-label-cps?: [fn [let cps@[Seq Int] label@String]
    [n: [length cps]]
    [and
      [> n 0]                              # non-empty
      [<= n 63]                            # label length limit (RFC 5891 §5.2)
      [not [= [head cps] 0x2D]]           # no leading hyphen
      [not [= [get cps [- n 1]] 0x2D]]    # no trailing hyphen
      # No hyphens in positions 3 and 4 together (would look like xn--)
      [not [and [>= n 4] [= [get cps 2] 0x2D] [= [get cps 3] 0x2D]]]
      [valid-bidi? cps]
      # Validate ZWNJ/ZWJ context
      [all? [fn [let e]
        [i: e.0  cp: e.1]
        [match cp
          0x200C: [valid-zwnj? cps i]                                # ZWNJ
          0x200D: [virama? [if [> i 0] [get cps [- i 1]] 0]]        # ZWJ — only valid after Virama
          _:      true]]                                              # other code points: always OK
       [entries cps]]]]

  # ── Punycode / IDNA2008 ───────────────────────────────────────────────────────
  # RFC 3492 Bootstring constants
  punycode-base:         36
  punycode-tmin:         1
  punycode-tmax:         26
  punycode-skew:         38
  punycode-damp:         700
  punycode-initial-bias: 72
  punycode-initial-n:    128

  # Digit table: 0-25 → 'a'-'z', 26-35 → '0'-'9'
  punycode-digits: "abcdefghijklmnopqrstuvwxyz0123456789"

  punycode-digit->char: [fn [let d@Int]
    [str-slice punycode-digits d [+ d 1]]]

  # Bias adaptation function (RFC 3492 §6.1)
  punycode-adapt: [fn [let delta@Int numpoints@Int firsttime@Bool]
    [d: [if firsttime [/ delta punycode-damp] [/ delta 2]]]
    [d: [+ d [/ d numpoints]]]
    # Find k: reduce d until small enough
    [find-k: [fn [let d k]
      [if [<= d [/ [* [- punycode-base punycode-tmin] punycode-tmax] 2]]
        k
        [find-k [/ d [- punycode-base punycode-tmin]] [+ k punycode-base]]]]]
    [k: [find-k d 0]]
    [+ k [/ [* [+ [- punycode-base punycode-tmin] 1] d] [+ d punycode-skew]]]]

  # Encode one delta value as a variable-length generalized integer (RFC 3492 §6.3)
  punycode-encode-int: [fn [let q@Int bias@Int]
    [step: [fn [let q k out]
      [t: [max punycode-tmin [min punycode-tmax [- k bias]]]]
      [if [< q t]
        [str out [punycode-digit->char q]]
        [step [/ [- q t] [- punycode-base t]]
              [+ k punycode-base]
              [str out [punycode-digit->char [+ t [mod [- q t] [- punycode-base t]]]]]]]]
    [step q punycode-base ""]]

  # Core Punycode encoding algorithm (RFC 3492 §6.3).
  # Takes [Seq Int] of Unicode code points, returns encoded ASCII String (no "xn--" prefix).
  punycode-encode: [fn [let cps@[Seq Int]]
    [total: [length cps]]
    [basic: [filter [fn [let cp] [< cp 128]] cps]]
    [b: [length basic]]
    # Output basic code points as ASCII characters
    [basic-str: [reduce [fn [let acc cp] [str acc [str-char cp]]] "" basic]]
    # Append delimiter '-' only if there are both basic AND non-basic code points
    [out0: [if [and [> b 0] [> [- total b] 0]] [str basic-str "-"] basic-str]]

    # Outer loop: one iteration per non-basic code point to encode.
    # State: h=handled count, delta=insertion delta, bias, n=current code point threshold, out
    [outer: [fn [let h delta bias n out]
      [if [>= h total]
        out
        [block
          # m = smallest code point >= n that appears in input
          [ge-n: [filter [fn [let cp] [>= cp n]] cps]]
          [m: [reduce [fn [let a b] [min a b]] [head ge-n] ge-n]]
          # Accumulate delta for the jump from n to m
          [delta: [+ delta [* [- m n] [+ h 1]]]]
          [n: m]
          # Inner loop: scan all code points, emit when we find n
          [inner: [fn [let cps-left h delta bias out]
            [match cps-left
              []: [outer h [+ delta 1] bias [+ n 1] out]
              [let [cp ...rest]]:
                [block
                  [delta: [if [< cp n] [+ delta 1] delta]]
                  [if [= cp n]
                    [block
                      [encoded: [punycode-encode-int delta bias]]
                      [new-bias: [punycode-adapt delta [+ h 1] [= h b]]]
                      [inner rest [+ h 1] 0 new-bias [str out encoded]]]
                    [inner rest h delta bias out]]]]]]
          [inner [collect cps] h delta bias out]]]]]
    [outer b 0 punycode-initial-bias punycode-initial-n out0]]

  # Returns the charset name as a bare String, or null if not found.
  extract-charset: [fn [let content-type@String]
    [charset-parts: [filter [fn [let p] [str-contains? "charset=" [lower p]]]
                     [str-split ";" content-type]]]
    [match charset-parts
      []: null
      [let [first ...rest]]:
        [kv: [str-split "=" first]]
        [if [>= [length kv] 2] [str-trim [get kv 1]] null]]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # ── Core string types ─────────────────────────────────────────────────────────
  # grapheme?: predicate — true iff a [Seq Int] forms exactly one UAX#29 grapheme cluster
  grapheme?:     grapheme?

  # Grapheme: one UAX#29 grapheme cluster; a constrained [Seq Int] of Unicode code points.
  # Encoding-agnostic — UTF-8 is just one representation.
  Grapheme:      Grapheme

  # String = [Seq Grapheme]: the fundamental change this whatif proposes.
  # The current runtime stores String as opaque UTF-8 bytes; this declaration specifies
  # what it SHOULD be. The implementation sprint makes String a lazy [Seq Grapheme].
  String: [type [Seq Grapheme]]

  # Codec type tags for UTF-8
  Utf8Bytes:     Utf8Bytes
  Utf8Graphemes: Utf8Graphemes

  # str-graphemes: decode a String into a lazy [Seq Grapheme] (each Grapheme = [Seq Int])
  str-graphemes:  str-graphemes
  grapheme-count: grapheme-count   # O(n) count of grapheme clusters in a String

  # ── Per-codec on-invalid handlers ─────────────────────────────────────────────
  # Use these as the on-invalid argument to decode. Not part of the Codec protocol.
  utf8-graphemes-strict: utf8-graphemes-strict  # Utf8Graphemes default: raise on bad UTF-8
  utf8-graphemes-lossy:  utf8-graphemes-lossy   # Utf8Graphemes alternative: U+FFFD grapheme
  utf8-strict:           utf8-strict            # String codecs (UTF8/UTF16LE/etc.): raise
  utf8-lossy:            utf8-lossy             # String codecs alternative: U+FFFD string

  # TextEncoding: a runtime record for dynamic dispatch (e.g. from HTTP Content-Type header).
  # Used when the codec is determined at runtime from a Content-Type charset= value.
  # For static dispatch, use the Codec typeclass instances directly: [decode UTF8 buf 0].
  TextEncoding: [type
    [name:   String
     encode: [Fn@Bytes [String]]
     decode: [Fn@String [Bytes [or [CodecInvalidHandler String Bytes] Absent]]]]]
     # Pass Absent (or omit) to use the codec's own default; pass a handler to override.

  TextBytes: [type [data: Bytes  encoding: TextEncoding]]

  to-encoding: [fn@[bind: [c]  return: TextEncoding  constraint: [c: [Codec c String Bytes]]] [let c@c]
    [TextEncoding
      [name:   [codec-name c]
       encode: [fn [let s] [encode c s]]
       decode: [fn [let b handler@[type: [or [CodecInvalidHandler String Bytes] Absent]  default: Absent.Absent]]
                 [decode c b 0 handler].value]]]]

  # builtin-encoding-for-name returns the canonical WHATWG encoding name (bare String) or null.
  encoding-for-name: [fn [let name@String]
    [internal: [builtin-encoding-for-name [lower name]]]
    [if [null? internal]
      [Result.Error [str "Unknown charset: " name]]
      [Result.Ok [TextEncoding
        [name:   internal
         encode: [fn [let s] [builtin-encoding-encode internal s]]
         decode: [fn [let b handler@[type: [or [CodecInvalidHandler String Bytes] Absent]  default: Absent.Absent]]
                   [builtin-encoding-decode internal b handler]]]]]]]

  text-encode: [fn@[bind: [c]  return: TextBytes  constraint: [c: [Codec c String Bytes]]] [let c@c s@String]
    [TextBytes [data: [encode c s]  encoding: [to-encoding c]]]]

  text-decode: [fn [let tb@TextBytes
                    handler@[type: [or [CodecInvalidHandler String Bytes] Absent]  default: Absent.Absent]]
    [tb.encoding.decode tb.data handler]]

  encode: [fn@[bind: [c]  return: Bytes  constraint: [c: [Codec c String Bytes]]] [let c@c s@String]
    [encode c s]]

  # decode: whole-buffer convenience. Omit handler to use the codec's own default.
  decode: [fn@[bind: [c]  return: String  constraint: [c: [Codec c String Bytes]]]
           [let c@c b@Bytes
                handler@[type: [or [CodecInvalidHandler String Bytes] Absent]  default: Absent.Absent]]
    [decode c b 0 handler].value]

  # decode-lossy: explicit lossy regardless of the codec's own default.
  decode-lossy: [fn@[bind: [c]  return: String  constraint: [c: [Codec c String Bytes]]] [let c@c b@Bytes]
    [decode c b 0 utf8-lossy].value]

  # ── Punycode / IDNA ───────────────────────────────────────────────────────────

  # str-to-code-points: decode a UTF-8 String to a list of Unicode code points.
  str-to-code-points: [fn [let s@String] [utf8-decode [str-bytes s]]]

  # ── String = [Seq Grapheme]: the fundamental string model ───────────────────
  #
  # Grapheme: one Unicode grapheme cluster — what a user perceives as a "character".
  # May consist of one or more code points (e.g. "👋🏽" = base + skin tone modifier).
  # String IS a [Seq Grapheme]: head, tail, length, map, filter, take, drop all work.
  # Indexing is O(n) — Unicode requires scanning from the start. This is honest.
  # For O(1) byte access: use str-bytes → Bytes.
  # Code points (Unicode scalar values) are plain Int in internal algorithms (IDNA, Punycode).
  #
  # grapheme?: true if cps is a non-empty [Seq Int] forming exactly one UAX#29 grapheme cluster.
  # Operates on code points (Ints) directly — encoding-agnostic, as UAX#29 requires.
  grapheme?: [fn@Bool [let cps@[Seq Int]]
    [if [empty? cps] false
      [block
        [check: [fn [let remaining prev-prop state]
          [if [empty? remaining]
            true    # exhausted with no internal boundary — exactly one cluster
            [block
              [cp:   [head remaining]]
              [prop: [gcb-property cp]]
              [if [gcb-boundary? prev-prop prop state]
                false  # internal boundary found — more than one cluster
                [check [tail remaining] prop [gcb-next-state prop state]]]]]]]
        [first: [head cps]]
        [check [tail cps] [gcb-property first] [gcb-next-state [gcb-property first] gcb-initial-state]]]]]

  # Grapheme: one UAX#29 grapheme cluster — a non-empty [Seq Int] of Unicode code points
  # satisfying the grapheme break rules. Encoding-agnostic: UTF-8 is just one representation.
  #
  # EQUALITY IS STRUCTURAL (code-point-by-code-point). This is a deliberate design decision:
  # silent normalization would discard information the user may have intentionally encoded.
  # The same visual character in different normalization forms — e.g. U+00E9 (precomposed)
  # vs [U+0065, U+0301] (e + combining accent) — compares unequal. This is correct.
  # Use [unicode-nfc s] before comparing if canonical (visual) equality is needed.
  #
  # DICT KEYS follow the same rule: a String key is looked up structurally. If external
  # data arrives in mixed normalization forms, normalize at the ingestion boundary:
  #   [set dict [unicode-nfc raw-key] value]    # insert
  #   [get [unicode-nfc lookup-key] dict]        # lookup
  # Custom comparators or a "canonical dict" variant would violate Leibniz's law
  # ([= k1 k2] false but dict treats them as equal) and are not provided.
  Grapheme: [type [Seq Int]@[is: grapheme?]]

  # grapheme-count: count the grapheme clusters in a string. O(n).
  # This is what str-length SHOULD be — user-perceived character count.
  grapheme-count: [fn [let s@String]
    [b: [str-bytes s]]
    [n: [length b]]
    [count: [fn [let offset c]
      [if [>= offset n]
        c
        [block
          [r0: [utf8-decode-one b offset]]
          [end: [gcb-cluster-end b offset [gcb-property r0.value] gcb-initial-state]]
          [count end [+ c 1]]]]]]
    [count 0 0]]

  # str-graphemes: lazy [Seq Grapheme] from a String.
  # Each Grapheme = [Seq Int] — the code points forming that cluster (encoding-agnostic).
  # Equivalent to [decode Utf8Graphemes [str-bytes s]].
  str-graphemes: [fn [let s@String]
    [b: [str-bytes s]]
    [n: [length b]]
    [step: [fn [let offset]
      [if [>= offset n]
        []
        [block
          [r0:  [utf8-decode-one b offset]]
          [end: [gcb-cluster-end b offset [gcb-property r0.value] gcb-initial-state]]
          # Collect all code points in this cluster as [Seq Int]
          [cps: [fn [let off acc]
            [if [>= off end]
              [reverse acc]
              [r: [utf8-decode-one b off]]
              [cps r.next [cons r.value acc]]]]]
          [seq [@Grapheme [cps offset []]] [step end]]]]]]  # lazy — [step end] is a thunk
    [step 0]]

  # ── Codec type tags for UTF-8 ────────────────────────────────────────────────
  #   Utf8Bytes:     Codec UInt8    Bytes  — byte view
  #   Utf8Graphemes: Codec Grapheme Bytes  — grapheme cluster view (String's native element)

  Utf8Bytes:     [type Utf8Bytes]
  Utf8Graphemes: [type Utf8Graphemes]

  # ── Unicode normalization ─────────────────────────────────────────────────────
  # Per UAX#15 (https://www.unicode.org/reports/tr15/).
  # Backed by the `unicode-normalization` Rust crate.
  #
  # NFC — canonical form for storage and comparison. Most applications should
  #   normalize to NFC before storing or comparing multilingual text. Without it,
  #   "café" from two keyboards (precomposed vs decomposed é) compares unequal.
  unicode-nfc:  [fn [let s@String] [builtin-unicode-nfc  s]]

  # NFD — canonical decomposition only. Useful for accent stripping:
  #   [filter [fn [let cp] [< cp 0x0300]] [str-to-code-points [unicode-nfd s]]]
  #   removes all combining diacritical marks (U+0300–U+036F and others).
  unicode-nfd:  [fn [let s@String] [builtin-unicode-nfd  s]]

  # NFKC — compatibility folding + recomposition. Folds typographic variants:
  #   "ﬁ"→"fi", "①"→"1", "Ａ"(fullwidth)→"A", "²"→"2".
  #   Use for search normalization, fuzzy matching, Unicode case-folding.
  unicode-nfkc: [fn [let s@String] [builtin-unicode-nfkc s]]

  # NFKD — compatibility decomposition without recomposition.
  #   Same decompositions as NFKC but leaves combining marks unsorted.
  unicode-nfkd: [fn [let s@String] [builtin-unicode-nfkd s]]

  # to-a-label: convert and validate a single DNS label per IDNA2008 (RFC 5891).
  # 1. NFC normalize  2. validate  3. Punycode-encode if non-ASCII  4. lowercase
  # Returns [Result.Ok encoded] or [Result.Error reason].
  to-a-label: [fn [let label@String]
    [normalized: [unicode-nfc label]]
    [cps: [str-to-code-points normalized]]
    [if [not [valid-idna-label-cps? cps normalized]]
      [Result.Error [str "invalid IDNA label: " label]]
      [match cps
        [[all? ascii?]]: [Result.Ok [lower normalized]]              # ASCII-only: just lowercase
        _:               [Result.Ok [str "xn--" [punycode-encode cps]]]]]]  # non-ASCII: Punycode

  # to-a-label-hostname: apply to-a-label to each dot-separated label.
  # "münchen.example.com" → "xn--mnchen-3ya.example.com"
  # "EXAMPLE.COM" → "example.com"
  # On validation failure returns original (cert matching will simply not match).
  to-a-label-hostname: [fn [let hostname@String]
    [labels: [str-split "." hostname]]
    [results: [map to-a-label labels]]
    [if [any? [fn [let r] [match r [Result.Error _]: true _: false]] results]
      hostname   # any label invalid — return original (matching will fail)
      [join "." [map [fn [let r] [match r [Result.Ok s]: s]] results]]]]

  # punycode-encode: exported for non-IDNA uses (testing, custom protocols, etc.).
  punycode-encode: punycode-encode

  decode-http-body: [fn [let body@Bytes content-type@String]
    [cs: [extract-charset content-type]]   # bare String or null
    [enc: [if [null? cs]
      [to-encoding UTF8]
      [match [encoding-for-name cs] [Result.Ok e]: e [Result.Error _]: [to-encoding UTF8]]]]
    [enc.decode-with body utf8-lossy]]
]
