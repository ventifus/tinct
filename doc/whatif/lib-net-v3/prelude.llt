# stdlib/prelude.llt additions — proposed by lib-net-v3.
# Part of: lib-net-v3
#
# These declarations merge into stdlib/prelude.llt on acceptance.
# They belong in prelude because they are general-purpose IO abstractions
# used by any program doing I/O, not just network programs.
#
# The draft .llt files include this via [include %include-dir "prelude.llt"].
# In the real stdlib, prelude is always loaded — no explicit include needed.

# ── block and task multi-body (T-1157, T-1158) ───────────────────────────────
# block: lazy multi-body in expression position. Desugars to an immediately-invoked
# zero-arg lambda so intermediate dict bindings are sequentially scoped.
# [block e1 e2 e3] → [[fn [] e1 e2 e3]]
#
# task multi-body: [task e1 e2 e3] → [task [block e1 e2 e3]]
# Both are macros implemented via the macros-v2 `macro` form.
# Consult doc/whatif/completed/macros-v2.md for exact implementation syntax.
# The closest existing reference is [macro do [let first ...rest] ...] in prelude.llt.
#
# These declarations are placeholders until T-1157 and T-1158 land.
[macro block [let ...body]
  [quote [[fn [let] [unquote-splice body]]]]]

[macro task [let first ...rest]
  [if [empty? rest]
    [quote [builtin-task [unquote first]]]
    [quote [builtin-task [block [unquote first] [unquote-splice rest]]]]]]

# ── ByteStream ────────────────────────────────────────────────────────────────
# Ordered, reliable, connection-oriented byte pipe.
# read n bytes from the stream; write bytes to it.
# Base instance: Handle (any TCP socket, file, pipe, stdin/stdout).

[class [let ByteStream h]
  read:  [Fn@Bytes [h Int]]
  write: [Fn@Null [h Bytes]]]

[instance ByteStream
  [let h@Handle]: [read:  builtin-read-bytes
                   write: builtin-write-bytes]]

# ── Seekable ──────────────────────────────────────────────────────────────────
# Random-access extension of ByteStream. Only files implement this — network
# streams and pipes do not. seek returns the new absolute position.
# tell  = [seek h [SeekFrom.Current 0]]
# size  = [seek h [SeekFrom.End 0]]   (seek back after if needed)

[class [let Seekable h] [ByteStream h]
  seek: [Fn@Int [h SeekFrom]]]

# ── Printable ─────────────────────────────────────────────────────────────────
# User-readable string representation. Follows the -able typeclass naming convention
# (Seekable, Addable, etc.). Method: print returns a human-readable String.
# No existing `print` function in tinct — unambiguous. `emit` is the output primitive.

[class [let Printable t]
  print: [Fn@String [t]]]

# ── MessageStream ─────────────────────────────────────────────────────────────
# Bidirectional typed-message interface. You send/recv one complete typed value;
# the implementation handles all serialization and framing internally.
# Channel T is the base instance — already delivers typed values with no framing.
# Used by %emit (CLI output pipeline), WebSocket, gRPC, and custom protocols.

[class [let MessageStream s t]
  # FD: s determines t (each MessageStream type has exactly one message type)
  send: [Fn@Null [s t]]
  recv: [Fn@[or [Result.Ok t] Closed.Closed] [s]]]

[instance@[bind: [t]] MessageStream
  [let a@[Channel t] b@t]: [send: builtin-send
                             recv: builtin-recv]]   # returns [Result.Ok v] | Closed.Closed (B-192)

# ── Codec ─────────────────────────────────────────────────────────────────────
# Bridge between IO shapes. encode: input → output; decode: output+offset → input+next.
# decode takes (codec, buffer, offset, on-invalid) → {value: decoded, next: offset-after-frame}.
# on-invalid: called with (buf, offset) when a byte sequence cannot be decoded.
#   Per-instance default declared via default: in each instance's decode parameter annotation.
#   Caller may override by passing a 4th argument.
# For whole-buffer codecs (text encodings): call with offset=0; next = [length buf].
# For framing codecs (QUIC, H2, H3): offset advances through a packet payload.
#
# on-invalid handlers are codec-specific values, named by their codec (see text.llt).
# The Codec class itself defines no handlers — they are plain named values in each codec's file.

# Handler type — parameterized by the same input/output types as the Codec.
# on-invalid: [CodecInvalidHandler input output]
#   buf: output — the same buffer being decoded
#   offset: Int — byte position of the invalid sequence
#   returns: {value: input  next: Int} — replacement value and next offset to resume from
CodecInvalidHandler: [type [let input output] [Fn@{value: input  next: Int} [output Int]]]

[class [let Codec c input output]
  encode:     [Fn@output [c input]]
  decode:     [Fn@{value: input  next: Int}
               [c output Int [or [CodecInvalidHandler input output] Absent]]]
              # Absent = "use the codec's own default". Pass a handler to override.
              # Each instance checks [absent? handler] and substitutes its own named default.
  codec-name: [Fn@String [c]]]

# ── Indexed ───────────────────────────────────────────────────────────────────
# Lookup by key. Generalised to any key type k — not just integers.
# get: look up by key, returning [or v Absent]; slice: subsequence; length: element count.
#
# Key types by instance:
#   Seq    → Int    (positional index)
#   Dict   → String (named key)
#   Bytes  → Int    (byte at position)
#   TypeLookupTable → [Map String Any]  (named-field selector: [get rcode: 2 DnsRcode])
#
# For type lookup tables, named arguments form the selector dict:
#   [get rcode: 2 DnsRcode]     → DnsRcode.ServFail   (Absent if not found)
#   [get abbrev: "OK" DnsRcode] → DnsRcode.NoError

[class [let Indexed s k v]
  get:    [Fn@[or v Absent] [s k]]
  slice:  [Fn@s [s Int Int]]
  length: [Fn@Int [s]]]

[instance Indexed
  [let a@Bytes b@Int c@UInt8]: [get:    builtin-bytes-get
                                 slice:  builtin-bytes-slice
                                 length: builtin-bytes-length]]

[instance@[bind: [T]] Indexed
  [let a@[Seq T] b@Int c@T]: [get:    builtin-seq-get
                               slice:  builtin-seq-slice
                               length: builtin-seq-length]]

# Dict lookup — String key. Already available via get/has?/get? builtins.
# Shown here to illustrate the unified Indexed model.
[instance Indexed
  [let a@Dict b@String c@Any]: [get: builtin-dict-get
                                 slice:  [fn [let _ _ _] [error "slice not defined for Dict"]]
                                 length: builtin-dict-length]]

# Type lookup tables — named-field selector as key.
# [get rcode: 2 DnsRcode] → named args {rcode: 2} become the selector dict.
# get iterates the variant table and returns the first matching variant.
# The variant table is a Seq of all variants (type name evaluates to this at runtime).
[instance@[bind: [T]] Indexed
  [let a@[Seq T] b@[Map String Any] c@T]:
    [get: [fn [let variants@[Seq T] selector@[Map String Any]]
      [find [fn [let v]
        [all? [fn [let e] [= [get e.key v] e.value]] [entries selector]]]
       variants]]
     slice:  [fn [let _ _ _] [error "slice not defined for type lookup table"]]
     length: builtin-seq-length]]

# ── Public API (final dict — exported to callers) ─────────────────────────────

[
  # ── Unicode string model ──────────────────────────────────────────────────────
  #
  #   Grapheme = [Seq Int]@[is: grapheme?]   — one UAX#29 grapheme cluster (code points)
  #   String   = [Seq Grapheme]              — what string literals produce
  #   Bytes    = [Seq UInt8]                 — raw bytes, O(1) access; the I/O boundary
  #
  # Grapheme is defined in terms of Unicode scalar values (plain Int), not bytes —
  # matching UAX#29, which is encoding-agnostic. A Grapheme is a non-empty sequence
  # of code points satisfying the grapheme break rules. No named "Character" type:
  # a sequence of code-point Ints is no more a "string" than a sequence of UInt8s.
  #
  # String IS [Seq Grapheme]: string literals produce a lazy sequence of grapheme
  # clusters. All standard Seq operations apply directly:
  #
  #   [head s]             → first Grapheme (= [Seq Int] of its code points)
  #   [tail s]             → remaining String (= [Seq Grapheme])
  #   [length s]           → grapheme count, O(n) — honest
  #   [map f s]            → lazy [Seq Grapheme]
  #   [filter pred s]      → lazy [Seq Grapheme]
  #   [get s 4]            → 5th Grapheme, O(i) — scans i clusters from head (Indexed)
  #   [collect s]          → Dict (integer-keyed Graphemes), O(n) to build
  #   [get [collect s] 4]  → O(1) per access after O(n) collect
  #                           Use collect when making many random accesses; O(n + m) vs O(i·m).
  #
  # String is NOT O(1) random-indexable (UTF-8 requires scanning from the start).
  # Collect first, then index — the explicit [Seq Grapheme] model makes this clear.
  #
  # I/O always crosses through Bytes: read returns Bytes; decode Bytes → Graphemes.
  # String literals are the only source of String without an explicit decode step.
  #
  # Two Codec instances on UTF-8 (defined in text.llt):
  #   [Codec Utf8Bytes     UInt8    Bytes]   — byte view
  #   [Codec Utf8Graphemes Grapheme Bytes]   — grapheme cluster view
  #
  # grapheme?, Grapheme, str-graphemes, grapheme break tables, and String: [type [Seq Grapheme]]
  # are all defined in text.llt. The String declaration is the core proposal of this whatif.

  # ── Bit manipulation utilities ────────────────────────────────────────────────
  # These belong in the prelude because protocol parsing is pervasive:
  # TLS flags, DNS headers, QUIC varints, HTTP/2 frame types, UTF-8 decoding.

  # Extract 6 payload bits from a UTF-8 continuation byte (strips the 10xxxxxx header).
  # Every UTF-8 continuation byte has the form 10xxxxxx — the payload is the lower 6 bits.
  cont-bits: [fn [let b@Int] [band b 0x3F]]

  # Test whether bit `pos` (0=LSB) is set in `n`.
  # [bit-test 0b1010 1] → true  (bit 1 is set)
  # [bit-test 0b1010 0] → false (bit 0 is clear)
  bit-test: [fn [let n@Int pos@Int] [= 1 [band [shr n pos] 1]]]

  # Extract `len` contiguous bits starting at bit position `lo` (0=LSB).
  # [bit-slice 0b10110 1 3] → 0b011 = 3
  # [bit-slice flags 0 4] → lower nibble (e.g. DNS RCODE)
  bit-slice: [fn [let n@Int lo@Int len@Int]
    [band [shr n lo] [- [shl 1 len] 1]]]

  # Named UTF-8 multi-byte sequence decoders.
  # Take the byte buffer `b`, the start offset `i`, and the leading byte `b0`.
  # Continuation bytes are read from b at i+1, i+2, i+3 — no repeated arithmetic at call sites.
  # Call: [utf8-2 b i b0], [utf8-3 b i b0], [utf8-4 b i b0]
  utf8-2: [fn [let b@Bytes i@Int b0@Int]
    [bor [shl [band b0 0x1F] 6]
         [cont-bits [get b [+ i 1]]]]]
  utf8-3: [fn [let b@Bytes i@Int b0@Int]
    [bor [bor [shl [band b0 0x0F] 12]
              [shl [cont-bits [get b [+ i 1]]] 6]]
              [cont-bits [get b [+ i 2]]]]]
  utf8-4: [fn [let b@Bytes i@Int b0@Int]
    [bor [bor [bor [shl [band b0 0x07] 18]
                   [shl [cont-bits [get b [+ i 1]]] 12]]
                  [shl [cont-bits [get b [+ i 2]]] 6]]
              [cont-bits [get b [+ i 3]]]]]

  # ── str-chars: String → lazy [Seq Character] (Unicode scalar values) ────────
  # For code-point-level operations: IDNA, Punycode, Bidi validation, collation.
  # Not the same as [str-graphemes s] — a grapheme cluster may contain multiple Characters.
  # Use str-chars when you need to inspect or transform individual code points.
  str-chars: [fn [let s@String]
    [decode Utf8Characters [str-bytes s]]]

  # ── Fixed-width unsigned integer types. Already in stdlib/numeric.llt (numeric-types sprint);
  # listed here because prelude additions must export them for Indexed, bytes/uint*, etc.
  UInt8:  [type Int@[is: [between 0 255]          repr: u8]]
  UInt16: [type Int@[is: [between 0 65535]         repr: u16]]
  UInt32: [type Int@[is: [between 0 4294967295]    repr: u32]]
  # [>= _ 0] uses _ shorthand: desugars to [fn [_] [>= _ 0]] → [>= subject 0] = subject >= 0.
  # Upper bound [between 0u 18446744073709551615u] requires T-1136 u suffix; added then.
  UInt64: [type Int@[is: [>= _ 0]  repr: u64]]

  # Byte order for integer ↔ bytes conversions.
  ByteOrder: [type BigEndian LittleEndian NativeEndian]

  # Seekable position argument. tell = [seek h [SeekFrom.Current 0]],
  # size = [seek h [SeekFrom.End 0]].
  SeekFrom: [type [Start pos@Int] [End pos@Int] [Current pos@Int]]

  # Integer ↔ fixed-width bytes. ByteOrder is always required — no endianness-ambiguous
  # multi-byte encoding is possible. Width is determined by the integer type argument.
  # For a single byte, use [get buf i] via the Indexed typeclass — no ByteOrder needed.
  bytes@[doc:   "Encode integer as fixed-width bytes in the given byte order. Width: UInt8→1, UInt16→2, UInt24→3, UInt32→4, UInt64→8."]: builtin-bytes
  uint16@[doc:  "Decode 2 bytes as UInt16 in the given byte order."]:  builtin-uint16
  uint32@[doc:  "Decode 4 bytes as UInt32 in the given byte order."]:  builtin-uint32
  uint64@[doc:  "Decode 8 bytes as UInt64 in the given byte order."]:  builtin-uint64

  # No pre-built on-invalid handlers here — handlers are codec-specific values
  # defined alongside each codec in its own file. See text.llt for utf8-strict,
  # utf8-characters-lossy, utf8-string-lossy, etc.

  # Decode all frames from a buffer as a lazy Seq.
  # Omit handler to use each codec's own default; pass to override.
  # The tail is a thunk — each frame is decoded only when the tail is forced.
  decode-all: [fn@[bind: [c i o]  constraint: [c: [Codec c i o]]]
               [let codec@c buf@o
                    handler@[type: [or [CodecInvalidHandler i o] Absent]  default: Absent.Absent]]
    [step: [fn [let offset]
      [if [>= offset [length buf]]
        []
        [block
          [r: [decode codec buf offset handler]]
          [seq r.value [step r.next]]]]]]
    [step 0]]

  # select: repeatedly dispatch from a set of channels until context is cancelled.
  # select-once is the one-shot primitive; select is the recurring wrapper.
  # sources: Seq of {ch: Channel  handler: Fn} — whichever channel fires, its handler is called
  #          with the received value; its return value is passed to finalizer.
  # finalizer: called after each handler invocation; use identity to discard.
  #
  # Example:
  #   [select [context]
  #     [seq [ch: req-ch  handler: [fn [let req] [task [req.respond [handle req]]]]]
  #      [seq [ch: sig-ch handler: [fn [let _]   [exit 0]]] []]]
  #     identity]
  select@[doc: "Repeatedly select from channels until context cancelled. sources: Seq of {ch: handler:} dicts."]:
    [fn@[bind: [r]] [let ctx@Context
             sources@[Seq [bind: [t]] [ch: [Channel t]  handler: [Fn@r t]]]
             finalizer@[Fn@Any r]]
      [step: [fn []
        [if [cancelled? ctx]
          null
          [match [select-once ctx sources]
            [Closed.Closed]: null
            [Result.Ok result]:
              [block [finalizer result] [step]]]]]]
      [step]]

  # drain: drain a single channel, calling f on each item for its side effect.
  # Returns a Task. Stops when the channel closes.
  # Use channel-map when you need an output channel; use drain for pure side effects.
  # Subject-last: f first, channel last. [drain [fn [let req] ...] requests]
  drain: [fn@[return: Task  bind: [t r]] [let f@[Fn@r t]  ch@[Channel t]]
    [task
      [step: [fn []
        [match [recv ch]
          [Closed.Closed]: null
          [Result.Ok x]:   [block [f x] [step]]]]]
      [step]]]

  # stream-drain: drain a ByteStream-backed packet source via a read function.
  # read-one: called on source, returns [Result.Ok item] | Closed.Closed.
  # handler: called for each item for its side effect.
  # Returns a Task. Analogous to drain but for read-function sources (not channels).
  # [stream-drain read-icmp handle-pkt stream]
  stream-drain: [fn@[return: Task  bind: [t r s]]
                 [let read-one@[Fn@[or [Result.Ok t] Closed.Closed] s]
                      handler@[Fn@r t]
                      source@s]
    [task
      [step: [fn []
        [match [read-one source]
          [Closed.Closed]: null
          [Result.Ok item]:   [block [handler item] [step]]]]]
      [step]]]

  # serve-streams: for each stream in stream-ch, start a concurrent task that
  # drains it via stream-drain with the given read function and handler.
  # Combines drain + stream-drain for the common "channel of streams" pattern.
  # [channel-of-streams | [serve-streams read-fn handler]]
  serve-streams: [fn@[return: Task  bind: [t r s]]
                  [let read-one@[Fn@[or [Result.Ok t] Closed.Closed] s]
                       handler@[Fn@r t]
                       stream-ch@[Channel s]]
    [drain [fn [let stream@s] [task [stream-drain read-one handler stream]]] stream-ch]]

  # ── Printable instances for primitive types ──────────────────────────────────
  # These back the str reimplementation below. Rust builtins handle the actual
  # primitive-to-string conversion; everything else is tinct.

  # str: variadic string concatenation via Printable.
  # Replaces the str Rust builtin — any type implementing Printable works automatically.
  # [str "x=" x " y=" y] → concatenates all args via [print arg] for each.
  # Removing the Rust str builtin and replacing with this tinct function is tracked in T-1176.
  str: [fn [let ...args]
    [reduce [fn [let acc x] [concat acc [print x]]] "" args]]
]

# Primitive Printable instances — must be top-level (not in a dict) like all instances.
# Int and Float use Rust builtins for the actual number formatting.
[instance Printable [let a@Int]:    [print: builtin-int->string]]
[instance Printable [let a@Float]:  [print: builtin-float->string]]
[instance Printable [let a@Bool]:   [print: [fn [let b] [if b "true" "false"]]]]
[instance Printable [let a@String]: [print: identity]]
