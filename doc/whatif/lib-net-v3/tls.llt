# stdlib/protocols/tls.llt — TLS 1.3 (RFC 8446) in tinct.
# Part of: lib-net-v3
# Rust primitives: chacha20-poly1305-seal/open, aes-128/256-gcm-seal/open,
#   x25519-keypair, x25519-dh, p256-keypair, hkdf-extract, hkdf-expand,
#   hmac-sha256, sha256, crypto-random, bytes-xor, rsa-pss-sign, p256-sign, ed25519-sign

[include %libdir "async.llt"]
[include %libdir "net.llt"]
[include %libdir "crypto.llt"]

# Hash algorithm selector for all HKDF calls.
HkdfHash: [union [Sha256] [Sha384] [Sha512] [Blake2s]]
[type [Sha256]] [type [Sha384]] [type [Sha512]] [type [Blake2s]]

[instance [ByteStream TlsConnection]
  read-bytes:  tls-read-bytes
  write-bytes: tls-write-bytes]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  int->ct: [fn [let n@Int]
    [match n 20: [ChangeCipherSpec] 21: [Alert] 22: [Handshake] 23: [ApplicationData]
                 _: [error [str "TLS: unknown content type: " n]]]]

  ct->int: [fn [let ct@ContentType]
    [match ct [ChangeCipherSpec]: 20  [Alert]: 21  [Handshake]: 22  [ApplicationData]: 23]]

  read-tls-record: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h]
    [header: [read-bytes h 5]]
    [len: [+ [* [get header 3] 256] [get header 4]]]
    [if [> len 16384] [error [str "TLS: record too large: " len]] null]
    [TlsRecord [content-type: [int->ct [get header 0]]  payload: [read-bytes h len]]]]

  write-tls-record: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h r@TlsRecord]
    [len: [length r.payload]]
    [write-bytes h
      [concat
        [bytes [ct->int r.content-type]]
        [0x03 0x03]
        [bytes [/ len 256]]
        [bytes [mod len 256]]
        r.payload]]]

  tls-nonce: [fn [let iv@[Bytes 12] seq@Int]
    [bytes-xor iv [concat [0x00 0x00 0x00 0x00] [encode BigEndian [@UInt64 seq]]]]]

  tls-seal: [fn [let conn@TlsConnection plain@Bytes nonce@[Bytes 12]]
    [match conn.cipher
      [Chacha20Poly1305Sha256]: [chacha20-poly1305-seal conn.write-key nonce plain []]
      [Aes128GcmSha256]:        [aes-128-gcm-seal       conn.write-key nonce plain []]
      [Aes256GcmSha384]:        [aes-256-gcm-seal       conn.write-key nonce plain []]]]

  tls-open: [fn [let conn@TlsConnection ct@Bytes nonce@[Bytes 12]]
    [match [match conn.cipher
      [Chacha20Poly1305Sha256]: [chacha20-poly1305-open conn.read-key nonce ct []]
      [Aes128GcmSha256]:        [aes-128-gcm-open       conn.read-key nonce ct []]
      [Aes256GcmSha384]:        [aes-256-gcm-open       conn.read-key nonce ct []]]
      [Ok p]:  p
      [Err _]: [error "TLS: AEAD decryption failed"]]]

  tls-write-record: [fn [let conn@TlsConnection ct@ContentType plain@Bytes]
    [seq: [recv conn.write-seq]]
    [send conn.write-seq [+ seq 1]]
    [ciphertext: [tls-seal conn [concat plain [bytes [ct->int ct]]] [tls-nonce conn.write-iv seq]]]
    [write-tls-record conn.underlying
      [TlsRecord [content-type: [ApplicationData]  payload: ciphertext]]]]

  tls-decrypt-record: [fn [let conn@TlsConnection record@TlsRecord]
    [seq: [recv conn.read-seq]]
    [send conn.read-seq [+ seq 1]]
    [plain: [tls-open conn record.payload [tls-nonce conn.read-iv seq]]]
    [strip-inner-ct plain]]

  strip-inner-ct: [fn [let plain@Bytes]
    [find-last-nonzero plain [- [length plain] 1]]]

  find-last-nonzero: [fn [let b@Bytes i@Int]
    [if [< i 0]
      [error "TLS: all-zero decrypted record"]
      [if [= [get b i] 0]
        [find-last-nonzero b [- i 1]]
        [slice b 0 i]]]]

  tls-read-acc: [fn [let conn@TlsConnection remaining@Int acc@[Seq Bytes]]
    [if [= remaining 0]
      [reduce concat [] acc]
      [plain: [tls-decrypt-record conn [read-tls-record conn.underlying]]]
      [got:   [min remaining [length plain]]]
      [tls-read-acc conn [- remaining got] [append acc [list [slice plain 0 got]]]]]]

  init-seq-ch: [fn []
    [ch: [channel 1]]
    [send ch 0]
    ch]

  new-conn: [fn [let h@Handle wk@[Bytes 32] rk@[Bytes 32] wi@[Bytes 12] ri@[Bytes 12] c@CipherSuite sni]
    [TlsConnection
      [underlying: h
       write-key: wk  write-iv: wi
       read-key:  rk  read-iv:  ri
       cipher:    c
       write-seq: [init-seq-ch]
       read-seq:  [init-seq-ch]
       sni:       sni]]]

  encode-hs: [fn [let type@Int body@Bytes]
    [len: [length body]]
    [concat [bytes type]
            [bytes [/ [/ len 256] 256]]
            [bytes [mod [/ len 256] 256]]
            [bytes [mod len 256]]
            body]]

  parse-finished:    [fn [let payload@Bytes] [slice payload 4 32]]
  encode-finished:   [fn [let mac@[Bytes 32]] [encode-hs 20 mac]]
  sign-with-key:     [fn [let private-key@Bytes input@Bytes] [error "TODO: sign-with-key — detect PKCS#8 OID, dispatch to rsa-pss-sign/p256-sign/ed25519-sign"]]
  verify-sig:        [fn [let public-key@Bytes input@Bytes sig@Bytes] [error "TODO: verify-sig"]]
  parse-client-hello:[fn [let payload@Bytes] [error "TODO: parse-client-hello"]]
  parse-server-hello:[fn [let payload@Bytes] [error "TODO: parse-server-hello"]]
  parse-certificate: [fn [let payload@Bytes] [error "TODO: parse-certificate — [Seq Bytes] DER list"]]
  parse-certificate-verify-sig: [fn [let payload@Bytes] [error "TODO: parse-certificate-verify-sig"]]
  encode-encrypted-extensions: [fn [let alpn@[or String Null]] [encode-hs 8 []]]
  encode-certificate:          [fn [let cert@Bytes] [encode-hs 11 [concat [bytes 0] [encode BigEndian [@UInt16 [+ [length cert] 5]]] [encode BigEndian [@UInt32 [length cert]]] cert [encode BigEndian [@UInt16 0]]]]]
  encode-certificate-verify:   [fn [let sig@Bytes]  [encode-hs 15 [concat [0x08 0x04] [encode BigEndian [@UInt16 [length sig]]] sig]]]
  negotiate-alpn: [fn [let client-alpn@[Seq String] server-alpn@[Seq String]]
    [match [filter [fn [let p] [any? [fn [let s] [= p s]] server-alpn]] client-alpn]
      []: null
      [let [first ...]]: first]]
  choose-cipher: [fn [let suites@[Seq Int] cfg@TlsServerConfig]
    # Prefer ChaCha20 → AES-256 → AES-128.
    [if [any? [fn [let s] [= s 0x1303]] suites] [Chacha20Poly1305Sha256]
      [if [any? [fn [let s] [= s 0x1302]] suites] [Aes256GcmSha384] [Aes128GcmSha256]]]]
  bytes-repeat: [fn [let val@Int n@Int]
    [reduce [fn [let acc _] [concat acc [bytes val]]] [] [range 0 n]]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  TlsServerConfig: [type
    [certificate: Bytes
     private-key: Bytes
     alpn:        [Seq String]
     min-version: Symbol]]

  TlsClientConfig: [type
    [sni:         String
     alpn:        [Seq String]
     ech:         Bytes
     trust-roots: [or [Seq Bytes] Symbol]]]

  CipherSuite: [union
    [Aes128GcmSha256]
    [Aes256GcmSha384]
    [Chacha20Poly1305Sha256]]

  TlsConnection: [type
    [underlying:  Handle
     write-key:   [Bytes 32]
     read-key:    [Bytes 32]
     write-iv:    [Bytes 12]
     read-iv:     [Bytes 12]
     cipher:      CipherSuite
     write-seq:   [Channel Int]
     read-seq:    [Channel Int]
     sni:         [or String Null]]]

  ContentType: [union [ChangeCipherSpec] [Alert] [Handshake] [ApplicationData]]

  TlsRecord: [type [content-type: ContentType  payload: Bytes]]

  tls-read-bytes: [fn [let conn@TlsConnection n@Int]
    [tls-read-acc conn n []]]

  tls-write-bytes: [fn [let conn@TlsConnection data@Bytes]
    [if [<= [length data] 16384]
      [tls-write-record conn [ApplicationData] data]
      [tls-write-record conn [ApplicationData] [slice data 0 16384]]
      [tls-write-bytes conn [slice data 16384 [- [length data] 16384]]]]]

  hkdf-expand-label: [fn [let secret@Bytes label@String context@Bytes len@Int]
    [label-str: [str "tls13 " label]]
    [info: [concat [encode BigEndian [@UInt16 len]]
                   [bytes [length [str-bytes label-str]]] [str-bytes label-str]
                   [bytes [length context]] context]]
    [hkdf-expand [Sha256] secret info len]]

  derive-secret: [fn [let secret@Bytes label@String transcript@Bytes]
    [hkdf-expand-label secret label [sha256 transcript] 32]]

  tls13-key-schedule: [fn [let dh-shared@[Bytes 32] ch-bytes@Bytes sh-bytes@Bytes]
    [zero32:        [bytes-repeat 0 32]]
    [early-secret:  [hkdf-extract [Sha256] zero32 zero32]]
    [hs-secret:     [hkdf-extract [Sha256] [derive-secret early-secret "derived" []] dh-shared]]
    [transcript-sh: [concat ch-bytes sh-bytes]]
    [c-hs:          [derive-secret hs-secret "c hs traffic" transcript-sh]]
    [s-hs:          [derive-secret hs-secret "s hs traffic" transcript-sh]]
    [master-secret: [hkdf-extract [Sha256] [derive-secret hs-secret "derived" []] zero32]]
    [c-ap:          [derive-secret master-secret "c ap traffic" []]]
    [s-ap:          [derive-secret master-secret "s ap traffic" []]]
    [hs-client-key:  [hkdf-expand-label c-hs "key" [] 32]
     hs-client-iv:   [hkdf-expand-label c-hs "iv"  [] 12]
     hs-server-key:  [hkdf-expand-label s-hs "key" [] 32]
     hs-server-iv:   [hkdf-expand-label s-hs "iv"  [] 12]
     fin-client-key: [hkdf-expand-label c-hs "finished" [] 32]
     fin-server-key: [hkdf-expand-label s-hs "finished" [] 32]
     app-client-key: [hkdf-expand-label c-ap "key" [] 32]
     app-client-iv:  [hkdf-expand-label c-ap "iv"  [] 12]
     app-server-key: [hkdf-expand-label s-ap "key" [] 32]
     app-server-iv:  [hkdf-expand-label s-ap "iv"  [] 12]]]

  tls-accept: [fn@[bind: [h]  return: TlsConnection  constraint: [h: ByteStream]]
                [let h@h cfg@TlsServerConfig]
    [error "TODO: tls-accept — read ClientHello, negotiate cipher/group, send ServerHello, derive keys via tls13-key-schedule, send EncryptedExtensions+Certificate+CertificateVerify+Finished, verify client Finished, install app keys"]]

  tls-layer: [fn@[bind: [h]  return: TlsConnection  constraint: [h: ByteStream]]
               [let h@h cfg@TlsClientConfig]
    [error "TODO: tls-layer — send ClientHello, read ServerHello, derive keys, read and verify server Finished + cert chain (verify-cert-chain), send client Finished, install app keys"]]

  # Serve layer: promotes a Channel@ByteStream to Channel@TlsConnection.
  # Lives here (not serve.llt) because it closes over TlsServerConfig.
  tls-serve: [fn [let in-ch cfg@TlsServerConfig]
    [channel-map [fn [let h] [tls-accept h cfg]] in-ch]]
]
