# stdlib/protocols/dns.llt — DNS wire format, resolver factories, name resolution.
# Part of: lib-net-v3
# Exports resolve (raw records) and lookup-ips (addresses). Include this directly when DNS resolution is needed.

[include %libdir "net.llt"]
[include %libdir "protocols/quic.llt"]   # quic-connect, quic-open-stream (DoQ resolver)
[include %libdir "protocols/http3.llt"]  # http3-client, h3-http-request (DoH resolver)

# ── Types (camelCase — accessible to internal helpers; re-exported as PascalCase in Public API) ──

[
  dnsQtype: [type
    [A          code: 1    description: "IPv4 address record"              doc: "RFC 1035"]
    [NS         code: 2    description: "Authoritative name server"        doc: "RFC 1035"]
    [Md         code: 3    description: "Mail destination (obsolete)"      doc: "RFC 1035"]
    [Mf         code: 4    description: "Mail forwarder (obsolete)"        doc: "RFC 1035"]
    [CNAME      code: 5    description: "Canonical name for an alias"      doc: "RFC 1035"]
    [SOA        code: 6    description: "Start of a zone of authority"     doc: "RFC 1035"]
    [Mb         code: 7    description: "Mailbox domain name (experimental)"  doc: "RFC 1035"]
    [Mg         code: 8    description: "Mail group member (experimental)"    doc: "RFC 1035"]
    [Mr         code: 9    description: "Mail rename name (experimental)"     doc: "RFC 1035"]
    [Null       code: 10   description: "Null RR (experimental)"              doc: "RFC 1035"]
    [WKS        code: 11   description: "Well known service description"   doc: "RFC 1035"]
    [PTR        code: 12   description: "Domain name pointer"              doc: "RFC 1035"]
    [HINFO      code: 13   description: "Host information"                 doc: "RFC 1035"]
    [Minfo      code: 14   description: "Mailbox or mail list info"        doc: "RFC 1035"]
    [MX         code: 15   description: "Mail exchange"                    doc: "RFC 1035"]
    [TXT        code: 16   description: "Text strings"                     doc: "RFC 1035"]
    [RP         code: 17   description: "Responsible person"               doc: "RFC 1183"]
    [AFSDB      code: 18   description: "AFS data base location"           doc: "RFC 1183"]
    [X25        code: 19   description: "X.25 PSDN address"               doc: "RFC 1183"]
    [Isdn       code: 20   description: "ISDN address"                    doc: "RFC 1183"]
    [RT         code: 21   description: "Route through"                    doc: "RFC 1183"]
    [Nsap       code: 22   description: "NSAP address (deprecated)"       doc: "RFC 1706"]
    [NsapPtr    code: 23   description: "NSAP pointer (deprecated)"       doc: "RFC 1706"]
    [SIG        code: 24   description: "Security signature"               doc: "RFC 2535"]
    [KEY        code: 25   description: "Security key"                     doc: "RFC 2535"]
    [Px         code: 26   description: "X.400 mail mapping info"         doc: "RFC 2163"]
    [Gpos       code: 27   description: "Geographical position"           doc: "RFC 1712"]
    [AAAA       code: 28   description: "IPv6 address record"              doc: "RFC 3596"]
    [LOC        code: 29   description: "Location information"             doc: "RFC 1876"]
    [Nxt        code: 30   description: "Next domain (obsolete)"          doc: "RFC 2535"]
    [Eid        code: 31   description: "Endpoint identifier"             doc: "Michael Patton"]
    [Nimloc     code: 32   description: "Nimrod locator"                  doc: "Michael Patton"]
    [SRV        code: 33   description: "Server selection"                 doc: "RFC 2782"]
    [Atma       code: 34   description: "ATM address"                     doc: "ATM Forum"]
    [NAPTR      code: 35   description: "Naming authority pointer"         doc: "RFC 3403"]
    [KX         code: 36   description: "Key exchanger"                    doc: "RFC 2230"]
    [CERT       code: 37   description: "Certificate record"               doc: "RFC 4398"]
    [A6         code: 38   description: "IPv6 address (obsolete)"         doc: "RFC 2874"]
    [DNAME      code: 39   description: "Delegation name"                  doc: "RFC 6672"]
    [Sink       code: 40   description: "Kitchen sink"                    doc: "draft-eastlake-kitchen-sink"]
    [OPT        code: 41   description: "Option (EDNS)"                    doc: "RFC 6891"]
    [APL        code: 42   description: "Address prefix list"              doc: "RFC 3123"]
    [DS         code: 43   description: "Delegation signer"                doc: "RFC 4034"]
    [SSHFP      code: 44   description: "SSH public key fingerprint"       doc: "RFC 4255"]
    [IPSECKEY   code: 45   description: "IPsec key"                        doc: "RFC 4025"]
    [RRSIG      code: 46   description: "DNSSEC signature"                 doc: "RFC 4034"]
    [NSEC       code: 47   description: "Next secure record"               doc: "RFC 4034"]
    [DNSKEY     code: 48   description: "DNS key record"                   doc: "RFC 4034"]
    [DHCID      code: 49   description: "DHCP identifier"                  doc: "RFC 4701"]
    [NSEC3      code: 50   description: "Next secure record version 3"     doc: "RFC 5155"]
    [NSEC3PARAM code: 51   description: "NSEC3 parameters"                 doc: "RFC 5155"]
    [TLSA       code: 52   description: "TLS authentication"               doc: "RFC 6698"]
    [SMIMEA     code: 53   description: "S/MIME cert association"          doc: "RFC 8162"]
    [HIP        code: 55   description: "Host identity protocol"           doc: "RFC 8005"]
    [Ninfo      code: 56   description: "Zone status information"         doc: "Jim Reid"]
    [Rkey       code: 57   description: "Resolver key"                    doc: "Jim Reid"]
    [Talink     code: 58   description: "Trust anchor link"               doc: "Wouter Wijngaards"]
    [CDS        code: 59   description: "Child delegation signer"          doc: "RFC 7344"]
    [CDNSKEY    code: 60   description: "Child DNS key"                    doc: "RFC 7344"]
    [OPENPGPKEY code: 61   description: "OpenPGP public key"               doc: "RFC 7929"]
    [CSYNC      code: 62   description: "Child-to-parent synchronization"  doc: "RFC 7477"]
    [ZONEMD     code: 63   description: "Message digest for DNS zone"      doc: "RFC 8976"]
    [SVCB       code: 64   description: "Service binding"                  doc: "RFC 9460"]
    [HTTPS      code: 65   description: "HTTPS service binding"            doc: "RFC 9460"]
    [Nid        code: 104  description: "Node identifier (ILNP)"           doc: "RFC 6742"]
    [L32        code: 105  description: "32-bit locator (ILNP)"            doc: "RFC 6742"]
    [L64        code: 106  description: "64-bit locator (ILNP)"            doc: "RFC 6742"]
    [Lp         code: 107  description: "Locator pointer (ILNP)"           doc: "RFC 6742"]
    [EUI48      code: 108  description: "MAC address (EUI-48)"             doc: "RFC 7043"]
    [EUI64      code: 109  description: "MAC address (EUI-64)"             doc: "RFC 7043"]
    [Nxname     code: 128  description: "NXDOMAIN indicator"               doc: "RFC 9824"]
    [TKEY       code: 249  description: "Transaction key"                  doc: "RFC 2930"]
    [TSIG       code: 250  description: "Transaction signature"            doc: "RFC 8945"]
    [IXFR       code: 251  description: "Incremental zone transfer"        doc: "RFC 1995"]
    [AXFR       code: 252  description: "Authoritative zone transfer"      doc: "RFC 5936"]
    [Mailb      code: 253  description: "Mailbox-related records"          doc: "RFC 1035"]
    [Maila      code: 254  description: "Mail agent (obsolete)"            doc: "RFC 1035"]
    [ANY        code: 255  description: "Any record type (*)"              doc: "RFC 1035"]
    [URI        code: 256  description: "Uniform resource identifier"      doc: "RFC 7553"]
    [CAA        code: 257  description: "Certification authority authorization"  doc: "RFC 8659"]
    [Avc        code: 258  description: "Application visibility and control"     doc: "Wolfgang Riedel"]
    [Doa        code: 259  description: "Digital object architecture"            doc: "draft-durand-doa-over-dns"]
    [Amtrelay   code: 260  description: "Automatic multicast tunneling relay"    doc: "RFC 8777"]
    [Resinfo    code: 261  description: "Resolver information"                   doc: "RFC 9606"]
    [Wallet     code: 262  description: "Wallet address"                         doc: "Paul Hoffman"]
    [Cla        code: 263  description: "CLA over DNS"                           doc: "draft-johnson-dns-ipn-cla"]
    [Ipn        code: 264  description: "IPN over DNS"                           doc: "draft-johnson-dns-ipn-cla"]
    [Ta         code: 32768  description: "DNSSEC trust authorities"             doc: "Sam Weiler"]
    [Dlv        code: 32769  description: "DNSSEC lookaside validation (obsolete)"  doc: "RFC 8749"]]

  # DNS label: RFC 1035 §2.3.1 — 1–63 chars.
  # Underscores are permitted (SRV, DKIM, etc.) despite RFC 952 restrictions.
  dnsLabel: [type String@[is: [and [>= [length _] 1] [<= [length _] 63]]]]

  # DNS name as a sequence of labels. Null at the final position marks an absolute
  # (fully-qualified) name; all preceding elements must be dnsLabel.
  # Structural contract: null-only-at-end? enforces this positional constraint at runtime.
  # See tracker: compile-time [Seq ...@T S] type form would make this static.
  #
  # ["example" "com"]        = example.com  (relative)
  # ["example" "com" Null]   = example.com. (absolute/canonical)
  # [Null]                   = .            (root zone)
  dnsName: [type [Seq [or dnsLabel Null]]@[is: dns-name-valid?]]

  # Structural contracts for dnsName:
  # 1. Null appears only at the final position (never mid-sequence)
  # 2. Total label content ≤ 253 chars (RFC 1035 §2.3.4)
  dns-name-valid?: [fn [let xs@[Seq [or dnsLabel Null]]]
    [labels: [filter [fn [let x] [not [null? x]]] xs]]
    [total:  [reduce [fn [let acc l] [+ acc [+ [length l] 1]]] -1 labels]]
    [and
      # Null can only be the last element — all elements except the last must be dnsLabel
      [all? [fn [let e] [not [null? e]]] [if [<= [length xs] 1] [] [take [- [length xs] 1] xs]]]
      # RFC 1035 §2.3.4: total ≤ 253 chars (joined with dots)
      [<= total 253]]]

  # RFC 9460 §2.3 SvcParams: a record of optional typed fields, one per SvcParamKey.
  # Each field uses [or T Absent] so absence of a param is distinct from an empty value.
  svcParams: [type
    [alpn:            [or [Seq String] Absent]      # key 1: Absent = no ALPN restriction
     no-default-alpn: Bool                           # key 2: false = param absent
     port:            [or Port Absent]               # key 3: Absent = use target's port
     ipv4-hint:       [or [Seq [Bytes 4]] Absent]    # key 4: Absent = no IPv4 hints
     ipv6-hint:       [or [Seq [Bytes 16]] Absent]   # key 6: Absent = no IPv6 hints
     ech:             [or Bytes Absent]              # key 5: Absent = no ECH config
     mandatory:       [or [Seq Int] Absent]          # key 0: Absent = no mandatory keys
     other:           [Map Int Bytes]]]              # unknown SvcParamKeys (extensibility)

  dnsRecord: [type
    [ARecord      addr@IpAddress.Ipv4  ttl@Duration]   # wire bytes ARE the Ipv4 address; no conversion
    [AAAARecord   addr@IpAddress.Ipv6  ttl@Duration]   # wire bytes ARE the Ipv6 address; no conversion
    [CNameRecord  name@dnsName     ttl@Duration]        # canonical name (FQDN, often trailing ".")
    [MxRecord     pref@Integer  name@dnsName  ttl@Duration] # mail exchange hostname
    [NsRecord     name@dnsName  ttl@Duration]           # authoritative nameserver hostname
    [TxtRecord    strings@[Seq Bytes]  ttl@Duration]    # arbitrary bytes — NOT DnsName
    [PtrRecord    name@dnsName  ttl@Duration]           # reverse-DNS target hostname
    [SrvRecord    prio@Integer  weight@Integer  port@Integer  target@dnsName  ttl@Duration]  # service target
    [HttpsRecord  prio@Integer  target@dnsName  params@svcParams  ttl@Duration]      # HTTPS TargetName
    [SoaRecord    mname@dnsName  rname@dnsName  serial@UInt32   # rname = email as DNS name
                  refresh@Duration  retry@Duration  expire@Duration  minimum@Duration  ttl@Duration]
    [OptRecord    payload-size@Integer          # EDNS UDP payload size (from OPT CLASS field)
                  edns-rcode@Integer            # extended RCODE upper 8 bits (from OPT TTL bits 31-24)
                  version@Integer               # EDNS version (from OPT TTL bits 23-16; must be 0)
                  do@Boolean                   # DNSSEC OK bit (from OPT TTL bit 15)
                  options@[Map Int Bytes]]  # EDNS option code → data; use EdnsOption.Cookie.code etc.
    [UnknownRecord  qtype@Integer  data@Bytes  ttl@Duration]]

  # DSO (DNS Stateless Operations) TLV Type Codes — RFC 8490 + RFC 8765.
  # Used in DSO messages; EdnsOption.Llq (code 1) negotiates the DSO session.
  # https://www.iana.org/assignments/dns-parameters/dns-dso-type-codes.csv
  dnsDsoType: [type
    [KeepAlive          code: 0x0001  description: "Session keepalive"                    doc: "RFC 8490"]
    [RetryDelay         code: 0x0002  description: "Delay before reconnect after close"    doc: "RFC 8490"]
    [EncryptionPadding  code: 0x0003  description: "Padding for encrypted sessions"        doc: "RFC 8490"]
    [Subscribe          code: 0x0040  description: "Subscribe to a DNS name"               doc: "RFC 8765"]
    [Push               code: 0x0041  description: "Push subscription update to client"    doc: "RFC 8765"]
    [Unsubscribe        code: 0x0042  description: "Cancel a subscription"                 doc: "RFC 8765"]
    [Reconfirm          code: 0x0043  description: "Request re-validation of pushed RRset" doc: "RFC 8765"]]

  # ZONEMD Hash Algorithms — RFC 8976.
  # Used in ZONEMD resource records to identify the hash function for zone digests.
  # https://www.iana.org/assignments/dns-parameters/zonemd-hash-algorithms.csv
  zonemdHash: [type
    [Sha384  code: 1  description: "SHA-384"  doc: "RFC 8976"]
    [Sha512  code: 2  description: "SHA-512"  doc: "RFC 8976"]]

  # ZONEMD Schemes — RFC 8976.
  # Describes how zone records are collated before hashing.
  # https://www.iana.org/assignments/dns-parameters/zonemd-schemes.csv
  zonemdScheme: [type
    [Simple  code: 1  description: "Simple ZONEMD collation — all RRs in canonical order"  doc: "RFC 8976"]]

  # CSYNC Record Flags — RFC 7477.
  # Flags in the CSYNC resource record controlling parent-zone synchronization behaviour.
  # https://www.iana.org/assignments/dns-parameters/csync-flags.csv
  csyncFlags: [type
    [Immediate   bit: 0  description: "Parent should immediately process this CSYNC record"       doc: "RFC 7477"]
    [SoaMinimum  bit: 1  description: "Require SOA serial > value specified in CSYNC record"      doc: "RFC 7477"]]

  # EDNS Option Codes — IANA registry (https://www.iana.org/assignments/dns-parameters/dns-parameters-11.csv)
  # Type-level lookup table: use EdnsOption.Cookie.code for integer value, or
  # [get code: 10 EdnsOption] for reverse lookup. Unassigned/reserved ranges omitted.
  ednsOption: [type
    [Llq                   code: 1      status: "Optional"  description: "Long-Lived Queries"               doc: "RFC 8764"]
    [UpdateLease           code: 2      status: "Standard"  description: "DNS Update Lease"                  doc: "RFC 9664"]
    [Nsid                  code: 3      status: "Standard"  description: "Name Server Identifier"            doc: "RFC 5001"]
    [Dau                   code: 5      status: "Standard"  description: "DNSSEC Algorithm Understood"       doc: "RFC 6975"]
    [Dhu                   code: 6      status: "Standard"  description: "DS Hash Understood"                doc: "RFC 6975"]
    [N3u                   code: 7      status: "Standard"  description: "NSEC3 Hash Understood"             doc: "RFC 6975"]
    [Ecs                   code: 8      status: "Optional"  description: "EDNS Client Subnet"                doc: "RFC 7871"]
    [Expire                code: 9      status: "Optional"  description: "EDNS Expire"                       doc: "RFC 7314"]
    [Cookie                code: 10     status: "Standard"  description: "DNS Cookie"                        doc: "RFC 7873"]
    [TcpKeepalive          code: 11     status: "Standard"  description: "EDNS TCP Keepalive"                doc: "RFC 7828"]
    [Padding               code: 12     status: "Standard"  description: "Padding"                           doc: "RFC 7830"]
    [Chain                 code: 13     status: "Standard"  description: "CHAIN Query Requests"              doc: "RFC 7901"]
    [KeyTag                code: 14     status: "Optional"  description: "EDNS Key Tag"                      doc: "RFC 8145"]
    [ExtendedError         code: 15     status: "Standard"  description: "Extended DNS Error"                doc: "RFC 8914"]
    [ClientTag             code: 16     status: "Optional"  description: "EDNS Client Tag"                   doc: "draft-bellis-dnsop-edns-tags"]
    [ServerTag             code: 17     status: "Optional"  description: "EDNS Server Tag"                   doc: "draft-bellis-dnsop-edns-tags"]
    [ReportChannel         code: 18     status: "Standard"  description: "Report Channel"                    doc: "RFC 9567"]
    [ZoneVersion           code: 19     status: "Standard"  description: "Zone Version"                      doc: "RFC 9660"]
    [MqtypeQuery           code: 20     status: "Optional"  description: "Multi-QTYPE Query"                 doc: "RFC-ietf-dnssd-multi-qtypes"]
    [MqtypeResponse        code: 21     status: "Optional"  description: "Multi-QTYPE Response"              doc: "RFC-ietf-dnssd-multi-qtypes"]
    [EdeExtraTextLanguage  code: 22     status: "Optional"  description: "EDE Extra Text Language"           doc: "draft-muks-dns-filtering"]
    [FilteringContact      code: 23     status: "Optional"  description: "Filtering Contact"                 doc: "draft-muks-dns-filtering"]
    [FilteringOrganization code: 24     status: "Optional"  description: "Filtering Organization"            doc: "draft-muks-dns-filtering"]
    [FilteringDb           code: 25     status: "Optional"  description: "Filtering Database"                doc: "draft-muks-dns-filtering"]
    [UmbrellaIdent         code: 20292  status: "Optional"  description: "Umbrella Identifier"               doc: "Cisco"]
    [DeviceId              code: 26946  status: "Optional"  description: "Device Identifier"                 doc: "Cisco"]]

  # EDNS Client Subnet (RFC 7871, option code 8).
  # prefix-len: 0 is the standardized privacy signal (RFC 7871 §11.1) — tells the resolver
  # not to use the client's IP for geo-routing; address is ignored when prefix-len is 0.
  # Valid range: 0–32 for IPv4, 0–128 for IPv6.
  clientSubnet: [type
    [addr:       IpAddress
     prefix-len: Int@[is: [between 0 128]]]]

  dnsRcode: [type
    [NoError    rcode: 0   description: "No Error"                                doc: "RFC 1035"]
    [FormErr    rcode: 1   description: "Format Error"                            doc: "RFC 1035"]
    [ServFail   rcode: 2   description: "Server Failure"                          doc: "RFC 1035"]
    [NXDomain   rcode: 3   description: "Non-Existent Domain"                     doc: "RFC 1035"]
    [NotImpl    rcode: 4   description: "Not Implemented"                         doc: "RFC 1035"]
    [Refused    rcode: 5   description: "Query Refused"                           doc: "RFC 1035"]
    [YXDomain   rcode: 6   description: "Name exists when it should not"          doc: "RFC 2136"]
    [YXRRSet    rcode: 7   description: "RR set exists when it should not"        doc: "RFC 2136"]
    [NXRRSet    rcode: 8   description: "RR set that should exist does not"       doc: "RFC 2136"]
    [NotAuth    rcode: 9   description: "Server not authoritative / not authorized"  doc: "RFC 2136"]
    [NotZone    rcode: 10  description: "Name not contained in zone"              doc: "RFC 2136"]
    [DsoTypeNI  rcode: 11  description: "DSO-TYPE not implemented"                doc: "RFC 8490"]
    [BadVers    rcode: 16  description: "Bad OPT version / TSIG signature failure"  doc: "RFC 6891"]
    [BadKey     rcode: 17  description: "Key not recognized"                      doc: "RFC 8945"]
    [BadTime    rcode: 18  description: "Signature out of time window"            doc: "RFC 8945"]
    [BadMode    rcode: 19  description: "Bad TKEY mode"                           doc: "RFC 2930"]
    [BadName    rcode: 20  description: "Duplicate key name"                      doc: "RFC 2930"]
    [BadAlg     rcode: 21  description: "Algorithm not supported"                 doc: "RFC 2930"]
    [BadTrunc   rcode: 22  description: "Bad truncation"                          doc: "RFC 8945"]
    [BadCookie  rcode: 23  description: "Bad/missing server cookie"               doc: "RFC 7873"]]

  dnsOpcode: [type
    [Query   code: 0  description: "Standard query"              doc: "RFC 1035"]
    [IQuery  code: 1  description: "Inverse query (obsolete)"    doc: "RFC 1035"]
    [Status  code: 2  description: "Server status request"       doc: "RFC 1035"]
    [Notify  code: 4  description: "Zone change notification"    doc: "RFC 1996"]
    [Update  code: 5  description: "Dynamic update"              doc: "RFC 2136"]
    [Dso     code: 6  description: "DNS Stateful Operations"     doc: "RFC 8490"]]

  dnsClass: [type
    [IN   code: 1    description: "Internet"         doc: "RFC 1035"]
    [CH   code: 3    description: "Chaos"            doc: "D. Moon, Chaosnet"]
    [HS   code: 4    description: "Hesiod"           doc: "Dyer and Hsu, Hesiod"]
    [None code: 254  description: "QCLASS NONE"      doc: "RFC 2136"]
    [Any  code: 255  description: "QCLASS * (any)"   doc: "RFC 1035"]]

  dnsExtendedError: [type
    [Other                    code: 0   description: "Other Error"                      doc: "RFC 8914"]
    [UnsupportedDnskeyAlg     code: 1   description: "Unsupported DNSKEY Algorithm"     doc: "RFC 8914"]
    [UnsupportedDsDigest      code: 2   description: "Unsupported DS Digest Type"       doc: "RFC 8914"]
    [StaleAnswer              code: 3   description: "Stale Answer"                     doc: "RFC 8914"]
    [ForgedAnswer             code: 4   description: "Forged Answer"                    doc: "RFC 8914"]
    [DnssecIndeterminate      code: 5   description: "DNSSEC Indeterminate"             doc: "RFC 8914"]
    [DnssecBogus              code: 6   description: "DNSSEC Bogus"                     doc: "RFC 8914"]
    [SignatureExpired          code: 7   description: "Signature Expired"                doc: "RFC 8914"]
    [SignatureNotYetValid      code: 8   description: "Signature Not Yet Valid"          doc: "RFC 8914"]
    [DnskeyMissing            code: 9   description: "DNSKEY Missing"                   doc: "RFC 8914"]
    [RrsigsMissing            code: 10  description: "RRSIGs Missing"                   doc: "RFC 8914"]
    [NoZoneKeyBit             code: 11  description: "No Zone Key Bit Set"              doc: "RFC 8914"]
    [NsecMissing              code: 12  description: "NSEC Missing"                     doc: "RFC 8914"]
    [CachedError              code: 13  description: "Cached Error"                     doc: "RFC 8914"]
    [NotReady                 code: 14  description: "Not Ready"                        doc: "RFC 8914"]
    [Blocked                  code: 15  description: "Blocked"                          doc: "RFC 8914"]
    [Censored                 code: 16  description: "Censored"                         doc: "RFC 8914"]
    [Filtered                 code: 17  description: "Filtered"                         doc: "RFC 8914"]
    [Prohibited               code: 18  description: "Prohibited"                       doc: "RFC 8914"]
    [StaleNxdomainAnswer      code: 19  description: "Stale NXDomain Answer"            doc: "RFC 8914"]
    [NotAuthoritative         code: 20  description: "Not Authoritative"                doc: "RFC 8914"]
    [NotSupported             code: 21  description: "Not Supported"                    doc: "RFC 8914"]
    [NoReachableAuthority     code: 22  description: "No Reachable Authority"           doc: "RFC 8914"]
    [NetworkError             code: 23  description: "Network Error"                    doc: "RFC 8914"]
    [InvalidData              code: 24  description: "Invalid Data"                     doc: "RFC 8914"]
    [SignatureExpiredBeforeValid code: 25  description: "Signature Expired before Valid"  doc: "RFC 8914"]
    [TooEarly                 code: 26  description: "Too Early"                        doc: "RFC 9250"]
    [UnsupportedNsec3Iter     code: 27  description: "Unsupported NSEC3 Iterations"    doc: "RFC 9276"]
    [UnableToConformToPolicy  code: 28  description: "Unable to conform to policy"      doc: "RFC 8914"]
    [Synthesized              code: 29  description: "Synthesized"                      doc: "RFC 8914"]
    [InvalidQueryType         code: 30  description: "Invalid Query Type"               doc: "RFC 9824"]
    [RateLimited              code: 31  description: "Rate Limited"                     doc: "RFC 8914"]
    [OverQuota                code: 32  description: "Over Quota"                       doc: "RFC 8914"]]

  dnsResponse: [type
    [id:         Int               # 16-bit message ID — matches the query id
     rcode:      dnsRcode          # response code (4 bits + EDNS extended rcode)
     answers:    [Seq dnsRecord]   # answer section (direct answers to the query)
     authority:  [Seq dnsRecord]   # authority section (NS records, SOA for NXDOMAIN)
     additional: [Seq dnsRecord]   # additional section (glue A/AAAA, EDNS OPT record)
     # Response header flags:
     aa:         Bool              # Authoritative Answer — true if from the authoritative server
     tc:         Bool              # Truncated — response was cut short (retry over TCP)
     rd:         Bool              # Recursion Desired — echoed from the query
     ra:         Bool              # Recursion Available — resolver supports recursion
     ad:         Bool                    # Authentic Data — DNSSEC validation was performed
     cd:         Bool                    # Checking Disabled — echoed from the query
     # EDNS fields (from OPT pseudorecord in additional section; defaults if no OPT present):
     edns-rcode:          Int                  # upper 8 bits of extended RCODE (0 = no extension)
     server-cookie:       [or Bytes Absent]    # EDNS option 10: server cookie (Absent if not returned)
     nsid:                [or Bytes Absent]    # EDNS option 3: Name Server Identifier (Absent if not returned)
     client-subnet-scope: [or Int Absent]]]    # EDNS option 8: scope prefix-len from server (how many bits it used)

  dnsQuery: [type
    [id:        Int               # 16-bit message ID (matches in the response)
     name:      DnsName           # query name (e.g. "example.com." or "example.com")
     qtype:     dnsQtype          # query type
     qclass:    dnsClass          # query class (almost always IN; CH for chaos queries)
     # DNS header flags:
     rd:        Bool              # Recursion Desired (true = ask resolver to recurse)
     do:        Bool              # EDNS0 DNSSEC OK — request DNSSEC records in response
     cd:        Bool              # Checking Disabled — bypass DNSSEC validation at resolver
     ad:        Bool              # Authentic Data — request DNSSEC-validated result
     # Transport hints (consumed by dns-try-servers, not encoded in the DNS wire message):
     tcp:       Bool              # force TCP transport (port 53, no TLS); required for AXFR
     edns:      Bool              # include EDNS0 OPT record (set false for old resolvers)
     bufsize:   Int@[is: [between 512 65535]]  # EDNS UDP payload size; RFC 6891 §6.2.3: min 512, max 65535
     ignore-tc: Bool              # accept truncated UDP response; skip TCP retry (dig +ignore)
     co:        Bool              # EDNS CO bit (RFC 9824): Compact Answers OK (compact denial-of-existence)
     # EDNS options — injected/resolved by dns-try-servers:
     client-cookie:  [or [Bytes 8] Absent]    # RFC 7873 option 10: injected from nameserver's cookie state
     server-cookie:  [or Bytes Absent]         # RFC 7873 option 10: cached server cookie
     nsid:           Bool                      # RFC 5001 option 3: request Name Server Identifier
     client-subnet:  [or clientSubnet Absent]  # RFC 7871 option 8: effective ECS (query override or ns default)
     respond:   [or [Fn [dnsResponse] Null] Null]]]  # server-side response callback

  # dnsQueryOpts: the full set of options that control how a DNS query is constructed
  # and sent. Passed from resolve → try-records → make-query.
  # All fields are required — the record is always fully populated.
  dnsQueryOpts: [type
    [qclass:    dnsClass   # QCLASS (usually IN; CH for chaos queries like version.bind)
     rd:        Bool       # Recursion Desired
     do:        Bool       # EDNS0 DNSSEC OK bit
     cd:        Bool       # Checking Disabled (bypass DNSSEC validation at resolver)
     ad:        Bool       # Authentic Data (request DNSSEC-validated result)
     tcp:       Bool       # force TCP transport (port 53, no TLS); required for AXFR
     edns:      Bool       # include EDNS0 OPT record (false = RFC 1035 plain query)
     bufsize:       Int@[is: [between 512 65535]]  # EDNS UDP payload size; RFC 6891 §6.2.3: min 512, max 65535
     ignore-tc:     Bool                           # accept truncated UDP; skip TCP retry (maps to dig +ignore)
     co:            Bool                           # EDNS CO bit: Compact Answers OK (RFC 9824)
     nsid:          Bool                           # request NSID from server (RFC 5001, option 3)
     client-subnet: [or clientSubnet Absent]]]     # ECS override; Absent = use nameserver default

  # Cookie state uses two separate fields rather than a DnsCookies record-in-a-channel:
  # - client-cookie: immutable [Bytes 8], generated once at nameserver construction (RFC 7873 §5.2)
  # - server-cookie: ReactiveCell — multiple concurrent reads OK (stale is fine),
  #   last-write-wins updates (both cookies from concurrent exchanges are valid server-side)
  nameserver: [type
    [UdpNameserver  addr@SocketAddress
                    client-cookie@[Bytes 8]
                    server-cookie@[ReactiveCell [or Bytes Absent]]
                    default-client-subnet@[or clientSubnet Absent]]  # Absent = no ECS by default
    [TcpNameserver  addr@SocketAddress
                    client-cookie@[Bytes 8]
                    server-cookie@[ReactiveCell [or Bytes Absent]]
                    default-client-subnet@[or clientSubnet Absent]]
    [DotNameserver  addr@SocketAddress  sni@String
                    client-cookie@[Bytes 8]
                    server-cookie@[ReactiveCell [or Bytes Absent]]
                    default-client-subnet@[or clientSubnet Absent]]
    [DohNameserver  addr@SocketAddress  sni@String  path@String
                    client-cookie@[Bytes 8]
                    server-cookie@[ReactiveCell [or Bytes Absent]]
                    default-client-subnet@[or clientSubnet Absent]]
    [DoqNameserver  addr@SocketAddress  sni@String
                    client-cookie@[Bytes 8]
                    server-cookie@[ReactiveCell [or Bytes Absent]]
                    default-client-subnet@[or clientSubnet Absent]]]

  dnsConfig: [type
    [nameservers:    [Seq nameserver]
     search:         [Seq String]
     ndots:          Int
     timeout:        Duration
     attempts:       Int
     rotate:         Bool
     no-aaaa:        Bool
     edns0:          Bool
     use-vc:         Bool
     no-check-names: Bool
     trust-ad:       Bool
     single-request: Bool
     sortlist:       [Seq String]]]

  # DNS error type — distinct failure modes callers can pattern-match on.
  dnsError: [type
    [NXDomain    name@String]    # NXDOMAIN: name definitively does not exist
    [ServerFailure]              # SERVFAIL: retry with a different nameserver
    [Refused]                    # REFUSED: server policy rejected the query
    [Timeout]                    # no response within configured time limit
    [Truncated]                  # response truncated (UDP); retry over TCP/TLS
    [NotImplemented]             # NOTIMP: server does not support this query type
    [DecodeFailed  reason@String]]  # wire format decode error (malformed response)
]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  # Verified: str-chars=✓ (builtin-str-chars), get?=✓ (core builtin)
  # random-id: not in prelude; use [uint16 ByteOrder.Network [crypto-random 2]] — [Bytes 2] → UInt16

  # Parse a string into the dnsName seq structure.
  # "example.com"  → ["example" "com"]           (relative)
  # "example.com." → ["example" "com" Null]       (absolute)
  # "."            → [Null]                        (root zone)
  parse-dns-name-str: [fn [let s@String]
    [absolute: [ends-with? "." s]]
    [bare:     [if absolute [str-slice 0 [- [length s] 1] s] s]]
    [labels:   [if [= bare ""] [] [str-split "." bare]]]
    [if absolute [append labels [list Null]] labels]]

  # Convert a dnsName seq back to its string representation.
  # Used for display and interop (TLS SNI, HTTP Host headers, etc.).
  # Substitute for Showable until R-14 (Printable typeclass) lands.
  dns-name->string: [fn [let name@dnsName]
    [parts: [filter [fn [let x] [not [null? x]]] name]]
    [base:  [join "." parts]]
    [if [and [not [empty? name]] [null? [last name]]] [str base "."] base]]

  encode-dns-name: [fn [let name@dnsName]
    [labels: [filter [fn [let x] [not [null? x]]] name]]
    [concat
      [flat-map [fn [let label]
        [concat [bytes [length label]] [str-bytes label]]]
       labels]
      [bytes 0]]]

  rotate-list: [fn [let xs]
    [match xs [] [] [let [h ...t]]: [append [list h] t]]]

  # Construct a fresh server-cookie reactive cell (Absent = no exchange yet).
  fresh-server-cookie: [fn []
    [builtin-reactive-cell Absent.Absent]]

  # Nameserver constructors — always initialize cookie state. Called when building %dns from
  # /etc/resolv.conf or --nameservers flags. client-cookie is random 8 bytes per RFC 7873 §5.2.
  # Nameserver constructors with optional default-client-subnet.
  # default-client-subnet: Absent = no ECS sent by default.
  # Set to [clientSubnet [addr: IpAddress.Ipv4 [0 0 0 0]  prefix-len: 0]] for privacy mode.
  udp-nameserver: [fn [let addr@SocketAddress  default-client-subnet@[type: [or clientSubnet Absent]  default: Absent.Absent]]
    [nameserver.UdpNameserver [addr: addr  client-cookie: [crypto-random 8]  server-cookie: [fresh-server-cookie]  default-client-subnet: default-client-subnet]]]

  tcp-nameserver: [fn [let addr@SocketAddress  default-client-subnet@[type: [or clientSubnet Absent]  default: Absent.Absent]]
    [nameserver.TcpNameserver [addr: addr  client-cookie: [crypto-random 8]  server-cookie: [fresh-server-cookie]  default-client-subnet: default-client-subnet]]]

  dot-nameserver: [fn [let addr@SocketAddress  sni@String  default-client-subnet@[type: [or clientSubnet Absent]  default: Absent.Absent]]
    [nameserver.DotNameserver [addr: addr  sni: sni  client-cookie: [crypto-random 8]  server-cookie: [fresh-server-cookie]  default-client-subnet: default-client-subnet]]]

  doh-nameserver: [fn [let addr@SocketAddress  sni@String  path@String  default-client-subnet@[type: [or clientSubnet Absent]  default: Absent.Absent]]
    [nameserver.DohNameserver [addr: addr  sni: sni  path: path  client-cookie: [crypto-random 8]  server-cookie: [fresh-server-cookie]  default-client-subnet: default-client-subnet]]]

  doq-nameserver: [fn [let addr@SocketAddress  sni@String  default-client-subnet@[type: [or clientSubnet Absent]  default: Absent.Absent]]
    [nameserver.DoqNameserver [addr: addr  sni: sni  client-cookie: [crypto-random 8]  server-cookie: [fresh-server-cookie]  default-client-subnet: default-client-subnet]]]

  # edns-opt-bytes: generic EDNS option encoder. Produces the 4-byte header + data.
  # Used by all EDNS option encoders (cookie, NSID, ECS, etc.).
  edns-opt-bytes: [fn [let code@Integer data@Bytes]
    [concat
      [bytes ByteOrder.Network [@UInt16 code]]
      [bytes ByteOrder.Network [@UInt16 [length data]]]
      data]]

  # ecs-opt-bytes: encode EDNS Client Subnet option (EdnsOption.Ecs, code 8, RFC 7871).
  # family: 1=IPv4, 2=IPv6. Address truncated to ceil(prefix-len/8) bytes.
  # prefix-len=0 is the privacy signal — address bytes are empty.
  ecs-opt-bytes: [fn [let cs@clientSubnet]
    [family:     [match cs.addr [IpAddress.Ipv4 _]: 1 _: 2]]
    [addr-bytes: [match cs.addr [IpAddress.Ipv4 b]: b [IpAddress.Ipv6 b]: b [IpAddress.Ipv6Zone b _]: b]]
    [n-bytes:    [/ [+ cs.prefix-len 7] 8]]    # ceil(prefix-len / 8)
    [truncated:  [slice addr-bytes 0 n-bytes]]
    [edns-opt-bytes ednsOption.Ecs.code [concat
      [bytes ByteOrder.Network [@UInt16 family]]    # FAMILY
      [bytes ByteOrder.Network [@UInt8 cs.prefix-len]]  # SOURCE PREFIX-LEN
      [bytes ByteOrder.Network [@UInt8 0]]          # SCOPE PREFIX-LEN (0 in queries)
      truncated]]]

  # cookie-opt-bytes: encode EDNS Cookie option (EdnsOption.Cookie, code 10, RFC 7873).
  # Sends client-cookie always; appends server-cookie only when cached.
  cookie-opt-bytes: [fn [let client@[Bytes 8] server@[or Bytes Absent]]
    [data: [match server
      [Absent.Absent]: client
      [let sc]:        [concat client sc]]]
    [edns-opt-bytes ednsOption.Cookie.code data]]

  # dns-try-servers: try each nameserver in turn, retrying on SERVFAIL or error.
  # q: base dnsQuery (client-cookie/server-cookie are Absent — injected here per nameserver).
  # Cookie flow: read ns cookie state → inject into q → send → update state from response.
  # BADCOOKIE (rcode 23): clear server cookie, retry once with fresh client+no-server cookie.
  dns-try-servers: [fn [let cap@NetCap servers@[Seq nameserver]
                         q@dnsQuery remaining@Integer timeout@Duration]
    [if [= remaining 0]
      dnsError.ServerFailure
      [match servers
        []: dnsError.ServerFailure
        [let [ns ...rest]]:
          # Resolve effective ECS: query override takes priority over nameserver default.
          [effective-subnet: [match q.client-subnet
            [Absent.Absent]: ns.default-client-subnet   # use nameserver default (may also be Absent)
            [let cs]:        cs]]                        # query-level override
          # Inject cookie state and effective ECS into the query.
          [sc:     [builtin-cell-get ns.server-cookie]]
          [q-full: [merge q [client-cookie:  ns.client-cookie
                             server-cookie:  sc
                             client-subnet:  effective-subnet]]]
          # If q.tcp forced, use TCP resolver for UDP nameservers; others keep native transport.
          [resolver: [match [if q.tcp ns ns]
            [nameserver.UdpNameserver addr: addr _]: [dns-tcp-resolver cap addr]
            _:                                       [ns-to-resolver cap ns]]]
          [send-and-recv: [fn [let qr]
            [match [try [await [timeout timeout [resolver qr]]]]
              [Result.Ok resp]:
                # Update cached server cookie from response (non-blocking, last-write-wins).
                [if [not [absent? resp.server-cookie]]
                  [builtin-cell-set ns.server-cookie resp.server-cookie]
                  null]
                [Result.Ok resp]
              [Result.Error e]: [Result.Error e]]]]
          [match [send-and-recv q-full]
            [Result.Ok resp]:
              [match resp.rcode
                [dnsRcode.ServFail]:   [dns-try-servers cap rest q [- remaining 1] timeout]
                [dnsRcode.NotImpl]:    dnsError.NotImplemented
                [dnsRcode.BadCookie]:
                  # BADCOOKIE: discard stale server cookie, retry once with client-only cookie.
                  [builtin-cell-set ns.server-cookie Absent.Absent]
                  [q-retry: [merge q [client-cookie: ns.client-cookie  server-cookie: Absent.Absent]]]
                  [match [send-and-recv q-retry]
                    [Result.Ok r2]: r2
                    [Result.Error _]: [dns-try-servers cap rest q [- remaining 1] timeout]]
                _:
                  # TC=1: truncated UDP response — retry over TCP unless q.ignore-tc.
                  [if [and resp.tc [not q.ignore-tc]
                           [match ns [nameserver.UdpNameserver _]: true _: false]]
                    [match [try [await [timeout timeout [[dns-tcp-resolver cap ns.addr] q-full]]]]
                      [Result.Ok tcp-resp]: tcp-resp
                      [Result.Error _]:     resp]
                    resp]]
            [Result.Error _]: [dns-try-servers cap rest q [- remaining 1] timeout]]]]]

  candidate-names: [fn [let host@String search@[Seq String] ndots@Integer]
    [if [ends-with? "." host]
      [list host]
      [block
        [dot-count: [length [filter [fn [let c] [= c "."]] [str-chars host]]]
         absolute:  [str host "."]
         searched:  [map [fn [let d] [str host "." d "."]] search]]
        [if [>= dot-count ndots]
          [cons absolute searched]
          [append [list absolute] searched]]]]]

  dns-query-with-retry: [fn [let cap@NetCap nameservers@[Seq Nameserver]
                              q@DnsQuery attempts@Integer rotate@Boolean timeout@Duration]
    [dns-try-servers cap [if rotate [rotate-list nameservers] nameservers]
                     q attempts timeout]]

  # make-query: construct a dnsQuery from a candidate name string and an opts dict.
  # opts is always a fully-populated dict (resolve fills all fields from its params,
  # try-ips passes std-opts with every field set). Read fields directly — no guards needed.
  #
  # If make-query is ever called with a partial opts dict, use get?+absent? for
  # boolean fields that default to true (rd, edns), since [or false true] = true
  # and would override an explicit false:
  #   rd: [let v [get? "rd" opts]] [if [absent? v] true v]
  make-query: [fn [let name@String qtype@dnsQtype opts@dnsQueryOpts]
    [dnsQuery.dnsQuery
      id:        [uint16 ByteOrder.Network [crypto-random 2]]
      name:      [parse-dns-name-str name]
      qtype:     qtype
      qclass:    opts.qclass
      rd:        opts.rd
      do:        opts.do
      cd:        opts.cd
      ad:        opts.ad
      tcp:           opts.tcp
      edns:          opts.edns
      bufsize:       opts.bufsize
      ignore-tc:     opts.ignore-tc
      co:            opts.co
      nsid:          opts.nsid
      # client-subnet carries the query-level override (Absent = use nameserver default).
      # Cookies injected later by dns-try-servers from the specific nameserver's state.
      client-subnet:  opts.client-subnet
      client-cookie:  Absent.Absent
      server-cookie:  Absent.Absent
      respond:        null]]

  # try-records: run the ndots+search candidate loop; return the full DnsResponse
  # from the first name that resolves. No CNAME following, no IP extraction.
  # Used by the public `resolve` function.
  try-records: [fn [let cap@NetCap config@dnsConfig names@[Seq String] qtype@dnsQtype opts@dnsQueryOpts]
    [match names
      []: dnsError.ServerFailure
      [let [name ...rest]]:
        [q: [make-query name qtype opts]]
        [match [try [dns-query-with-retry cap config.nameservers q
                                         config.attempts config.rotate config.timeout]]
          [Result.Ok resp]:
            [match resp.rcode
              [dnsRcode.NXDomain]: [try-records cap config rest qtype opts]
              [dnsRcode.Refused]:  dnsError.Refused
              [dnsRcode.NotImpl]:  dnsError.NotImplemented
              _:                   resp]    # full DnsResponse
          [Result.Error _]: [try-records cap config rest qtype opts]]]]

  # try-ips: run the ndots+search candidate loop; extract IPs from the first name
  # that resolves, following CNAMEs only when the recursive resolver didn't flatten them.
  # Used by the public `lookup-ips` function. Always uses standard opts (IN, rd=true, no DNSSEC).
  try-ips: [fn [let cap@NetCap config@dnsConfig names@[Seq String] qtype@dnsQtype]
    [std-opts: [@dnsQueryOpts
               [qclass: dnsClass.IN  rd: true  do: false  cd: false  ad: false
                tcp: false  edns: true  bufsize: 1232  ignore-tc: false
                co: false  nsid: false  client-subnet: Absent.Absent]]]
    [match names
      []: dnsError.ServerFailure
      [let [name ...rest]]:
        [q: [make-query name qtype std-opts]]
        [match [try [dns-query-with-retry cap config.nameservers q
                                         config.attempts config.rotate config.timeout]]
          [Result.Ok resp]:
            [match resp.rcode
              [dnsRcode.NXDomain]: [try-ips cap config rest qtype]
              [dnsRcode.Refused]:  dnsError.Refused
              [dnsRcode.NotImpl]:  dnsError.NotImplemented
              _:
                [ips: [extract-ips resp.answers qtype cap 0]]
                [if [empty? ips]
                  [try-ips cap config rest qtype]   # no IPs in answer — try next candidate
                  ips]]
          [Result.Error _]: [try-ips cap config rest qtype]]]]

  # extract-ips: pull IP addresses from an answer section.
  # Only follows CNAME records when the answer contains NO IPs — recursive resolvers
  # include final A/AAAA records alongside any CNAMEs, so this path fires only when
  # talking to an authoritative server that returned a bare CNAME.
  extract-ips: [fn [let records@[Seq dnsRecord] qtype@dnsQtype cap@NetCap depth@Integer]
    [if [>= depth 8]
      [error "DNS: CNAME chain too long (max 8)"]
      [has-ips?: [any? [fn [let r]
        [match r
          [dnsRecord.ARecord _]:    [= qtype dnsQtype.A]
          [dnsRecord.AAAARecord _]: [= qtype dnsQtype.AAAA]
          _: false]] records]]
      [flat-map [fn [let r]
        [match r
          [dnsRecord.ARecord     addr: addr]: [if [= qtype dnsQtype.A]    [list addr] []]
          [dnsRecord.AAAARecord  addr: addr]: [if [= qtype dnsQtype.AAAA] [list addr] []]
          [dnsRecord.CNameRecord name: name]:
            # Only recurse if the answer has no IPs — recursive resolvers already flattened it.
            [if has-ips?
              []
              [match [try [lookup-ips cap qtype [str name "."]]]
                [Result.Ok addrs]: addrs
                [Result.Error _]:  []]]
          _: []]]
       records]]]

  dns-https-send: [fn [let client path@String q@DnsQuery]
    [wire: [encode-dns-wire q]]
    [resp: [await [h3-http-request client
      [method:  "POST"
       path:    path
       headers: ["content-type":   "application/dns-message"
                 "accept":         "application/dns-message"
                 "content-length": [str [length wire]]]
       body: wire]]]]
    [if [not [= resp.status 200]]
      [error [str "DoH: HTTP " resp.status]]
      [match [decode-dns-wire resp.body]
        [Result.Ok r]:    r
        [Result.Error e]: [error [str "DoH decode: " e]]]]]

  # Helper: Duration → UInt32 seconds (clamped to 2^31-1 per RFC 2181 §8).
  duration->ttl: [fn [let d@Duration]
    [@UInt32 [min [seconds-of d] 2147483647]]]

  # RFC 1035 §4.1.4: encode a DNS name with pointer compression.
  # table: DnsName → Int (byte offset in message where that name begins).
  # offset: current write position in the message (for registering new names).
  # Returns {bytes: Bytes  table: [Map DnsName Int]} with the updated table.
  encode-dns-name-compressed: [fn [let name@dnsName offset@Integer table@[Map dnsName Int]]
    [labels: [filter [fn [let x] [not [null? x]]] name]]
    # Try each suffix (longest first) to find a compression pointer.
    [try-suffix: [fn [let i prefix-bytes prefix-offset]
      [if [> i [length labels]]
        # No suffix matched — emit root byte, register full name.
        [block
          [full: [concat prefix-bytes [0x00]]]
          [bytes: full  table: [set name prefix-offset table]]]
        # Try suffix starting at label i.
        [block
          [suffix: [apply str [intersperse "." [append [slice labels i [length labels]] [list ""]]]]]
          [match [get? table suffix]
            [let ptr-off]:
              # Found! Emit prefix labels + 2-byte pointer.
              [ptr: [bytes ByteOrder.Network [@UInt16 [bor 0xC000 ptr-off]]]]
              [full: [concat prefix-bytes ptr]]
              [bytes: full  table: [set name prefix-offset table]]
            [Absent.Absent]:
              # Register this suffix for future compression, then try shorter.
              [label:      [get labels i]]
              [label-wire: [concat [bytes ByteOrder.Network [@UInt8 [length [str-bytes label]]]] [str-bytes label]]]
              [new-prefix: [concat prefix-bytes label-wire]]
              [new-off:    [+ prefix-offset [length label-wire]]]
              [new-table:  [set suffix prefix-offset table]]
              [try-suffix [+ i 1] new-prefix new-off new-table]]]]]]]
    [try-suffix 0 [bytes 0] offset table]]

  # Encode a name and return {bytes: Bytes  table: [Map DnsName Int]}.
  # Wrapper that handles the empty/root name case.
  enc-name: [fn [let name@DnsName offset@Integer table@[Map DnsName Int]]
    [if [or [= name ""] [= name "."]]
      [bytes: [0x00]  table: table]
      [encode-dns-name-compressed name offset table]]]

  # Helper: build wire RR header + rdata, threading compression table.
  # Returns {bytes: Bytes  table: [Map DnsName Int]}.
  rr-wire-compressed: [fn [let rtype@Integer ttl@Duration rdata@Bytes offset@Integer table@[Map DnsName Int]]
    # Owner name is "." (root) — single zero byte, no compression.
    [owner:   [0x00]]
    [header:  [concat owner
                      [bytes ByteOrder.Network [@UInt16 rtype]]
                      [bytes ByteOrder.Network [@UInt16 1]]          # class = IN
                      [bytes ByteOrder.Network [duration->ttl ttl]]
                      [bytes ByteOrder.Network [@UInt16 [length rdata]]]]]
    [full: [concat header rdata]]
    [bytes: full  table: table]]

  # dnsRecord → {bytes: Bytes  table: [Map DnsName Int]} with name compression.
  # offset: where this RR starts in the message (for registering name offsets).
  # table:  compression table built up from previous RRs in the same message.
  encode-rr-compressed: [fn [let r@dnsRecord offset@Integer table@[Map DnsName Int]]
    # rdata-base: byte offset where rdata starts (after 1-byte owner + 10-byte fixed header).
    [rdata-base: [+ offset 11]]
    [match r
      [dnsRecord.ARecord addr: addr ttl: ttl]:
        [rr-wire-compressed 1 ttl [match addr [IpAddress.Ipv4 b]: b] offset table]

      [dnsRecord.AAAARecord addr: addr ttl: ttl]:
        [rr-wire-compressed 28 ttl [match addr [IpAddress.Ipv6 b]: b] offset table]

      [dnsRecord.CNameRecord name: name ttl: ttl]:
        [nr: [enc-name name rdata-base table]]
        [rr-wire-compressed 5 ttl nr.bytes offset nr.table]

      [dnsRecord.MxRecord pref: pref name: name ttl: ttl]:
        [nr: [enc-name name [+ rdata-base 2] table]]
        [rr-wire-compressed 15 ttl [concat [bytes ByteOrder.Network [@UInt16 pref]] nr.bytes] offset nr.table]

      [dnsRecord.NsRecord name: name ttl: ttl]:
        [nr: [enc-name name rdata-base table]]
        [rr-wire-compressed 2 ttl nr.bytes offset nr.table]

      [dnsRecord.TxtRecord strings: strings ttl: ttl]:
        [rdata: [apply concat [map [fn [let s]
          [concat [bytes ByteOrder.Network [@UInt8 [length s]]] s]] strings]]]
        [rr-wire-compressed 16 ttl rdata offset table]

      [dnsRecord.PtrRecord name: name ttl: ttl]:
        [nr: [enc-name name rdata-base table]]
        [rr-wire-compressed 12 ttl nr.bytes offset nr.table]

      [dnsRecord.SrvRecord prio: prio weight: weight port: port target: target ttl: ttl]:
        [nr: [enc-name target [+ rdata-base 6] table]]
        [rdata: [concat [bytes ByteOrder.Network [@UInt16 prio]]
                        [bytes ByteOrder.Network [@UInt16 weight]]
                        [bytes ByteOrder.Network [@UInt16 port]]
                        nr.bytes]]
        [rr-wire-compressed 33 ttl rdata offset nr.table]

      [dnsRecord.SoaRecord mname: mname rname: rname serial: serial
                           refresh: refresh retry: retry expire: expire minimum: minimum ttl: ttl]:
        [mn: [enc-name mname rdata-base table]]
        [rn: [enc-name rname [+ rdata-base [length mn.bytes]] mn.table]]
        [times: [concat [bytes ByteOrder.Network serial]
                        [bytes ByteOrder.Network [duration->ttl refresh]]
                        [bytes ByteOrder.Network [duration->ttl retry]]
                        [bytes ByteOrder.Network [duration->ttl expire]]
                        [bytes ByteOrder.Network [duration->ttl minimum]]]]
        [rr-wire-compressed 6 ttl [concat mn.bytes rn.bytes times] offset rn.table]

      [dnsRecord.HttpsRecord prio: prio target: target params: _ ttl: ttl]:
        [nr: [enc-name target [+ rdata-base 2] table]]
        [rr-wire-compressed 65 ttl [concat [bytes ByteOrder.Network [@UInt16 prio]] nr.bytes] offset nr.table]

      [dnsRecord.UnknownRecord qtype: qtype data: data ttl: ttl]:
        [rr-wire-compressed qtype ttl data offset table]]]

  # Encode a single record with compression (offset=0, fresh table).
  encode-rr: [fn [let r@dnsRecord]
    [result: [encode-rr-compressed r 0 []]]
    result.bytes]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # Named domain types with fixed byte-order encodings per RFC 1035.
  # All DNS multi-byte integers are big-endian (network byte order) per RFC 1035 §2.3.2.
  DnsId:       [type UInt16@[encoding: ByteOrder.Network]]   # RFC 1035 §4.1.1: 16-bit query ID
  DnsQClass:   [type UInt16@[encoding: ByteOrder.Network]]   # RFC 1035 §3.2.4: 16-bit query class (e.g. IN=1)
  DnsTtl:      [type UInt32@[encoding: ByteOrder.Network]]   # RFC 1035 §3.2.1: 32-bit TTL in seconds
  DnsRdLength: [type UInt16@[encoding: ByteOrder.Network]]   # RFC 1035 §3.2.1: 16-bit RDATA length

  # Re-export types under canonical PascalCase names.
  # (Defined with camelCase in the types dict above so internal helpers can access them.)
  # Note: runtime constructor tags carry the camelCase prefix (e.g. "dnsQtype.A") — see R-13.
  SvcParams:   svcParams     # RFC 9460 SvcParams record type
  DnsLabel:    dnsLabel      # RFC 1035 §2.3.1: one label (1–63 chars)
  DnsName:     dnsName       # RFC 1035 §2.3.1: seq of labels, Null = trailing dot
  DnsQtype:    dnsQtype

  # Parse a string into the DnsName seq structure.
  # "example.com"  → ["example" "com"]           (relative)
  # "example.com." → ["example" "com" Null]       (absolute/canonical)
  # "."            → [Null]                        (root zone)
  # Validates via dnsName structural contract (label length, total length, Null at end only).
  dns-name:        parse-dns-name-str

  dns-name->string: dns-name->string
  DnsRecord:   dnsRecord
  DnsRcode:          dnsRcode
  DnsOpcode:         dnsOpcode
  DnsClass:          dnsClass
  DnsExtendedError:  dnsExtendedError
  DnsError:          dnsError

  # Codec for a single DNS resource record.
  # msg: the full DNS message bytes, needed for name decompression during decode.
  # For bytes produced by encode (uncompressed names), pass the rr-bytes itself as msg.
  DnsRecordCodec: [type [msg: Bytes]]
  DnsQuery:     dnsQuery
  DnsResponse:  dnsResponse
  DnsQueryOpts: dnsQueryOpts   # options for resolve: class, rd, do, cd, ad, tcp, edns, bufsize, ignore-tc, nsid, client-subnet
  ClientSubnet: clientSubnet   # ECS subnet: addr@IpAddress + prefix-len@Integer (0=privacy)
  EdnsOption:   ednsOption    # EDNS option codes (IANA registry); use .code, .description, .doc
  DnsDsoType:   dnsDsoType   # DSO TLV type codes (RFC 8490 + RFC 8765)
  ZonemdHash:   zonemdHash   # ZONEMD hash algorithm codes (RFC 8976): Sha384=1, Sha512=2
  ZonemdScheme: zonemdScheme # ZONEMD collation schemes (RFC 8976): Simple=1
  CsyncFlags:   csyncFlags   # CSYNC record flags (RFC 7477): Immediate, SoaMinimum
  # DnsDoqError is exported from quic.llt (DoQ application error codes, RFC 9250)
  Nameserver:   nameserver
  DnsConfig:    dnsConfig
  # Nameserver constructors — always initialize cookie state correctly.
  # Use these instead of constructing Nameserver variants directly.
  udp-nameserver: udp-nameserver
  tcp-nameserver: tcp-nameserver
  dot-nameserver: dot-nameserver
  doh-nameserver: doh-nameserver
  doq-nameserver: doq-nameserver

  # Encode a DnsQuery to DNS wire format (RFC 1035 §4, RFC 6891 EDNS0).
  # Always includes an EDNS0 OPT record (arcount=1) — signals EDNS0 support,
  # enables larger UDP responses (1232-byte payload per DNS Flag Day 2020), and
  # carries the DO bit for DNSSEC. The OPT record is in the additional section.
  #
  # Flags word (16-bit, RFC 1035 §4.1.1):
  #   QR=0 (query) | OPCODE=0000 (Query) | AA=0 | TC=0 | RD | RA=0 | Z=0 | AD | CD | RCODE=0000
  # Encode a DnsQuery to DNS wire format (RFC 1035 §4, RFC 6891 EDNS0).
  # When q.edns: includes an EDNS0 OPT record (arcount=1) with q.bufsize UDP payload
  # and the DO bit from q.do. When q.edns=false: no OPT record (arcount=0).
  #
  # Flags word (16-bit, RFC 1035 §4.1.1):
  #   QR=0 | OPCODE=0000 | AA=0 | TC=0 | RD | RA=0 | Z=0 | AD | CD | RCODE=0000
  encode-dns-wire: [fn [let q@DnsQuery]
    [flags: [bor [if q.rd 0x0100 0x0000]    # bit 8: Recursion Desired
                 [if q.ad 0x0020 0x0000]    # bit 5: Authentic Data
                 [if q.cd 0x0010 0x0000]]]  # bit 4: Checking Disabled
    [question: [concat
      [encode-dns-name q.name]
      [bytes ByteOrder.Network [@UInt16 q.qtype.code]]
      [bytes ByteOrder.Network [@UInt16 q.qclass.code]]]]
    [if q.edns
      # With EDNS0 OPT record (RFC 6891 §6):
      [block
        [edns-flags: [bor [if q.do 0x8000 0x0000]    # bit 15: DO (DNSSEC OK, RFC 4035)
                          [if q.co 0x4000 0x0000]]]  # bit 14: CO (Compact Answers OK, RFC 9824)
        # Collect all EDNS options into OPT RDATA. Options are independently optional;
        # absent ones contribute zero bytes. Order: cookie (10), NSID (3), ECS (8).
        [opt-options: [concat
          [match q.client-cookie                             # EdnsOption.Cookie (code 10, RFC 7873)
            [Absent.Absent]: [bytes 0]
            [let cc]:        [cookie-opt-bytes cc q.server-cookie]]
          [if q.nsid                                         # EdnsOption.Nsid (code 3, RFC 5001)
            [edns-opt-bytes ednsOption.Nsid.code [bytes 0]]
            [bytes 0]]
          [match q.client-subnet                             # EdnsOption.Ecs (code 8, RFC 7871)
            [Absent.Absent]: [bytes 0]
            [let cs]:        [ecs-opt-bytes cs]]]]
        [opt-rdata-len: [length opt-options]]
        [opt-rr: [concat
          [bytes ByteOrder.Network [@UInt8  0x00]]                   # root label (.)
          [bytes ByteOrder.Network [@UInt16 41]]                     # type OPT
          [bytes ByteOrder.Network [@UInt16 q.bufsize]]              # class = UDP payload size
          [bytes ByteOrder.Network [@UInt8  0]]                      # extended RCODE = 0
          [bytes ByteOrder.Network [@UInt8  0]]                      # EDNS version = 0
          [bytes ByteOrder.Network [@UInt16 edns-flags]]             # extended flags (DO bit)
          [bytes ByteOrder.Network [@UInt16 opt-rdata-len]]          # RDLENGTH
          opt-options]]                                          # all EDNS options (cookie, NSID, ECS)
        [concat
          [bytes ByteOrder.Network [@UInt16 q.id]]
          [bytes ByteOrder.Network [@UInt16 flags]]
          [bytes ByteOrder.Network [@UInt16 1]]  [bytes ByteOrder.Network [@UInt16 0]]  # QDCOUNT=1 ANCOUNT=0
          [bytes ByteOrder.Network [@UInt16 0]]  [bytes ByteOrder.Network [@UInt16 1]]  # NSCOUNT=0 ARCOUNT=1
          question opt-rr]]
      # Without EDNS0: plain RFC 1035 query
      [concat
        [bytes ByteOrder.Network [@UInt16 q.id]]
        [bytes ByteOrder.Network [@UInt16 flags]]
        [bytes ByteOrder.Network [@UInt16 1]]  [bytes ByteOrder.Network [@UInt16 0]]    # QDCOUNT=1 ANCOUNT=0
        [bytes ByteOrder.Network [@UInt16 0]]  [bytes ByteOrder.Network [@UInt16 0]]    # NSCOUNT=0 ARCOUNT=0
        question]]]

  # RFC 1035 §4 DNS wire format decoder.
  # Algorithm:
  #   1. Parse header (12 bytes): id(2) flags(2) qdcount(2) ancount(2) nscount(2) arcount(2)
  #      - rcode = flags & 0x000F → dnsRcode
  #      - qr = flags >> 15 & 1 (1 = response)
  #      - truncated = flags >> 9 & 1
  #   2. Skip question section (qdcount entries): parse each as name+qtype(2)+qclass(2)
  #      Name parsing: series of length-prefixed labels ending in 0x00; pointer = 0xC0 byte
  #   3. Parse answers (ancount), authority (nscount), additional (arcount) sections:
  #      Each RR: name + type(2) + class(2) + ttl(4) + rdlength(2) + rdata(rdlength)
  #      Dispatch on type to build dnsRecord variants
  #   4. Name pointer compression (RFC 1035 §4.1.4): 0xC0XX = pointer to offset XX in message
  #      Name parsing must thread the full message buffer for pointer resolution
  #   Returns dnsResponse or dnsError.DecodeFailed if malformed.
  # RFC 1035 §4.1.4: parse a domain name at offset in b, returning name string and next offset.
  # Pointer compression: byte 0xC0 = pointer; next byte gives offset in message.
  # Label: length byte + that many ASCII chars; 0x00 = root (end).
  # ptr-depth: follow at most 5 pointers to prevent infinite loops.
  parse-dns-name: [fn [let b@Bytes offset@Integer ptr-depth@Integer]
    [if [= ptr-depth 0]
      [name: ""  next: offset]   # pointer loop guard — return empty
      [if [>= offset [length b]]
        [name: ""  next: offset]
        [block
          [len-byte: [get b offset]]
          [if [= len-byte 0]
            # End of name (root label)
            [name: ""  next: [+ offset 1]]
            [if [= [band len-byte 0xC0] 0xC0]
              # Pointer: next byte gives offset (RFC 1035 §4.1.4)
              [block
                [ptr-offset: [band [uint16 ByteOrder.Network [slice b offset [+ offset 2]]] 0x3FFF]]
                [target: [parse-dns-name b ptr-offset [- ptr-depth 1]]]
                # next advances past the 2-byte pointer; pointer target's next is discarded
                [name: target.name  next: [+ offset 2]]]
              # Regular label
              [block
                [label-end: [+ offset 1 len-byte]]
                [label:     [bytes-str [slice b [+ offset 1] label-end]]]
                [rest:      [parse-dns-name b label-end ptr-depth]]
                [name: [if [= rest.name ""] label [str label "." rest.name]]
                 next: rest.next]]]]]]]]

  # RFC 1035 §4.1.3: parse RDATA for a given type, returning a dnsRecord.
  # b: full message (for name decompression); offset: start of RDATA; rdlength: length.
  parse-dns-rdata: [fn [let b@Bytes offset@Integer rdlength@Integer qtype@Integer ttl@Duration]
    [data-end: [+ offset rdlength]]
    [match qtype
      1:  # A record — 4-byte IPv4 address (wire bytes are exactly IpAddress.Ipv4)
        [dnsRecord.ARecord  addr: [IpAddress.Ipv4 [slice b offset data-end]]  ttl: ttl]
      28: # AAAA record — 16-byte IPv6 address (wire bytes are exactly IpAddress.Ipv6)
        [dnsRecord.AAAARecord  addr: [IpAddress.Ipv6 [slice b offset data-end]]  ttl: ttl]
      5:  # CNAME — compressed name
        [name-res: [parse-dns-name b offset 5]]
        [dnsRecord.CNameRecord  name: name-res.name  ttl: ttl]
      15: # MX — preference(2) + name
        [pref: [uint16 ByteOrder.Network [slice b offset [+ offset 2]]]]
        [name-res: [parse-dns-name b [+ offset 2] 5]]
        [dnsRecord.MxRecord  pref: pref  name: name-res.name  ttl: ttl]
      2:  # NS — compressed name
        [name-res: [parse-dns-name b offset 5]]
        [dnsRecord.NsRecord  name: name-res.name  ttl: ttl]
      16: # TXT — series of length-prefixed strings
        [parse-txt: [fn [let pos acc]
          [if [>= pos data-end]
            acc
            [block
              [slen: [get b pos]]
              [s:    [slice b [+ pos 1] [+ pos 1 slen]]]
              [parse-txt [+ pos 1 slen] [append acc [list s]]]]]]]
        [dnsRecord.TxtRecord  strings: [parse-txt offset []]  ttl: ttl]
      12: # PTR — compressed name
        [name-res: [parse-dns-name b offset 5]]
        [dnsRecord.PtrRecord  name: name-res.name  ttl: ttl]
      33: # SRV — priority(2) weight(2) port(2) target
        [prio: [uint16 ByteOrder.Network [slice b offset [+ offset 2]]]]
        [wt:   [uint16 ByteOrder.Network [slice b [+ offset 2] [+ offset 4]]]]
        [port: [uint16 ByteOrder.Network [slice b [+ offset 4] [+ offset 6]]]]
        [name-res: [parse-dns-name b [+ offset 6] 5]]
        [dnsRecord.SrvRecord  prio: prio  weight: wt  port: port  target: name-res.name  ttl: ttl]
      6:  # SOA — mname rname serial refresh retry expire minimum
        [mname-res: [parse-dns-name b offset 5]]
        [rname-res: [parse-dns-name b mname-res.next 5]]
        [p: rname-res.next]
        [serial:  [@UInt32 [uint32 ByteOrder.Network [slice b p          [+ p 4]]]]]
        [refresh: [seconds [uint32 ByteOrder.Network [slice b [+ p 4]    [+ p 8]]]]]
        [retry:   [seconds [uint32 ByteOrder.Network [slice b [+ p 8]    [+ p 12]]]]]
        [expire:  [seconds [uint32 ByteOrder.Network [slice b [+ p 12]   [+ p 16]]]]]
        [minimum: [seconds [uint32 ByteOrder.Network [slice b [+ p 16]   [+ p 20]]]]]
        [dnsRecord.SoaRecord  mname: mname-res.name  rname: rname-res.name
                              serial: serial  refresh: refresh  retry: retry
                              expire: expire  minimum: minimum  ttl: ttl]
      65: # HTTPS (RFC 9460) — priority(2) target-name + SvcParams
        [prio: [uint16 ByteOrder.Network [slice b offset [+ offset 2]]]]
        [target-res: [parse-dns-name b [+ offset 2] 5]]
        # Parse SvcParams: each is key(2)+value-len(2)+value-bytes
        [parse-svcparams: [fn [let pos params]
          [if [>= pos data-end]
            params
            [block
              [key:     [uint16 ByteOrder.Network [slice b pos [+ pos 2]]]]
              [vlen:    [uint16 ByteOrder.Network [slice b [+ pos 2] [+ pos 4]]]]
              [vdata:   [slice b [+ pos 4] [+ pos 4 vlen]]]
              [new-params: [match key
                0:  [merge params [mandatory: [collect [map [fn [let i] [uint16 ByteOrder.Network [slice vdata [* i 2] [+ [* i 2] 2]]]] [range 0 [/ vlen 2]]]]]]
                1:  # alpn: comma-separated protocol strings
                    [block
                      [parse-alpn: [fn [let p acc]
                        [if [>= p vlen]
                          acc
                          [block
                            [alen: [get vdata p]]
                            [proto: [bytes-str [slice vdata [+ p 1] [+ p 1 alen]]]]
                            [parse-alpn [+ p 1 alen] [append acc [list proto]]]]]]]
                      [merge params [alpn: [parse-alpn 0 []]]]]
                3:  [merge params [port: [uint16 ByteOrder.Network vdata]]]
                5:  [merge params [ech: vdata]]
                _:  params]]
              [parse-svcparams [+ pos 4 vlen] new-params]]]]]
        [raw-params: [parse-svcparams target-res.next []]]
        [params: [svcParams
          alpn:            [or [get? raw-params alpn] Absent.Absent]
          no-default-alpn: false
          port:            [or [get? raw-params port] Absent.Absent]
          ipv4-hint:       Absent.Absent
          ipv6-hint:       Absent.Absent
          ech:             [or [get? raw-params ech] Absent.Absent]
          mandatory:       [or [get? raw-params mandatory] Absent.Absent]
          other:           []]]
        [dnsRecord.HttpsRecord  prio: prio  target: target-res.name  params: params  ttl: ttl]
      _:  # Unknown record type
        [dnsRecord.UnknownRecord  qtype: qtype  data: [slice b offset data-end]  ttl: ttl]]]

  # Parse N resource records starting at offset in b. Returns [records: [Seq dnsRecord] next: Int].
  # OPT pseudorecords (type 41, RFC 6891) are parsed here rather than in parse-dns-rdata
  # because they need rclass (UDP payload size) and the raw TTL (extended RCODE + flags).
  parse-rrs: [fn [let b@Bytes offset@Integer n@Integer acc@[Seq dnsRecord]]
    [if [= n 0]
      [records: acc  next: offset]
      [block
        [name-res:  [parse-dns-name b offset 5]]
        [p:         name-res.next]
        [rtype:     [uint16 ByteOrder.Network [slice b p          [+ p 2]]]]
        [rclass:    [uint16 ByteOrder.Network [slice b [+ p 2]    [+ p 4]]]]
        [ttl-raw:   [uint32 ByteOrder.Network [slice b [+ p 4]    [+ p 8]]]]
        [ttl:       [seconds ttl-raw]]
        [rdlen:     [uint16 ByteOrder.Network [slice b [+ p 8]    [+ p 10]]]]
        [rdata-off: [+ p 10]]
        [rdata-end: [+ rdata-off rdlen]]
        [rr: [if [= rtype 41]
          # OPT pseudorecord (RFC 6891): class = UDP payload size, TTL = extended RCODE/flags.
          # Parse options bytes into a Map of option-code → option-data.
          [opt-bytes: [slice b rdata-off rdata-end]]
          [opts: [fn [let offset acc]
            [if [>= offset [length opt-bytes]]
              acc
              [block
                [code: [uint16 ByteOrder.Network [slice opt-bytes offset        [+ offset 2]]]]
                [olen: [uint16 ByteOrder.Network [slice opt-bytes [+ offset 2]  [+ offset 4]]]]
                [data: [slice opt-bytes [+ offset 4] [+ offset 4 olen]]]
                [opts [+ offset 4 olen] [set acc code data]]]]]]]
          [dnsRecord.OptRecord
            payload-size: rclass
            edns-rcode:   [shr ttl-raw 24]                      # bits 31-24
            version:      [band [shr ttl-raw 16] 0xFF]           # bits 23-16
            do:           [= [band [shr ttl-raw 15] 1] 1]        # bit 15
            options:      [opts 0 []]]
          [parse-dns-rdata b rdata-off rdlen rtype ttl]]]
        [parse-rrs b rdata-end [- n 1] [append acc [list rr]]]]]]

  decode-dns-wire: [fn@[return: [or dnsResponse dnsError]] [let b@Bytes]
    [if [< [length b] 12]
      [dnsError.DecodeFailed "response too short"]
      [block
        [id:        [uint16 ByteOrder.Network [slice b 0 2]]
         flags:     [uint16 ByteOrder.Network [slice b 2 4]]
         qdcount:   [uint16 ByteOrder.Network [slice b 4 6]]
         ancount:   [uint16 ByteOrder.Network [slice b 6 8]]
         nscount:   [uint16 ByteOrder.Network [slice b 8 10]]
         arcount:   [uint16 ByteOrder.Network [slice b 10 12]]
         rcode-int: [band flags 0x000F]
         aa:        [= [band [shr flags 10] 1] 1]   # bit 10: Authoritative Answer
         tc:        [= [band [shr flags  9] 1] 1]   # bit 9:  Truncated
         rd:        [= [band [shr flags  8] 1] 1]   # bit 8:  Recursion Desired (echoed)
         ra:        [= [band [shr flags  7] 1] 1]   # bit 7:  Recursion Available
         ad:        [= [band [shr flags  5] 1] 1]   # bit 5:  Authentic Data (DNSSEC)
         cd:        [= [band [shr flags  4] 1] 1]]  # bit 4:  Checking Disabled (echoed)
        # §4.1.2: Skip question section — each question is: name + qtype(2) + qclass(2)
        [skip-questions: [fn [let offset n]
          [if [= n 0]
            offset
            [block
              [name-res: [parse-dns-name b offset 5]]
              [skip-questions [+ name-res.next 4] [- n 1]]]]]]
        [after-q: [skip-questions 12 qdcount]]
        # §4.1.3: Parse answer, authority, additional sections
        [an-result: [parse-rrs b after-q ancount []]]
        [ns-result: [parse-rrs b an-result.next nscount []]]
        [ar-result: [parse-rrs b ns-result.next arcount []]]
        # Extract OPT record from additional section (if present).
        # The OPT pseudorecord carries EDNS extended RCODE and the server cookie option.
        [opt: [find [fn [let r] [match r [dnsRecord.OptRecord _]: true _: false]] ar-result.records]]
        [edns-rcode: [match opt
          null:                  0
          [dnsRecord.OptRecord o]: o.edns-rcode]]
        # Full 12-bit RCODE = (extended upper 8 bits << 4) | base lower 4 bits (RFC 6891 §4.6)
        [full-rcode-int: [bor [shl edns-rcode 4] rcode-int]]
        [rcode: [or [get rcode: full-rcode-int dnsRcode] dnsRcode.ServFail]]
        # Extract EDNS options from OPT record (all use [get? "code" o.options] pattern).
        [opt-options: [match opt null: []  [dnsRecord.OptRecord o]: o.options]]
        [server-cookie: [match [get? ednsOption.Cookie.code opt-options]
          [Absent.Absent]: Absent.Absent
          [let raw]:       [if [> [length raw] 8]
            [slice raw 8 [length raw]]    # server cookie follows 8-byte client echo
            Absent.Absent]]]
        [nsid: [match [get? ednsOption.Nsid.code opt-options]
          [Absent.Absent]: Absent.Absent
          [let raw]:       raw]]          # raw bytes — typically ASCII hostname or datacenter name
        [client-subnet-scope: [match [get? ednsOption.Ecs.code opt-options]
          [Absent.Absent]: Absent.Absent
          [let raw]:       [if [>= [length raw] 4]
            [get raw 3]                   # scope-prefix-len is byte index 3 of ECS option data
            Absent.Absent]]]
        [dnsResponse.dnsResponse
          id:                  id
          rcode:               rcode
          answers:             an-result.records
          authority:           ns-result.records
          additional:          ar-result.records
          aa:                  aa
          tc:                  tc
          rd:                  rd
          ra:                  ra
          ad:                  ad
          cd:                  cd
          edns-rcode:          edns-rcode
          server-cookie:       server-cookie
          nsid:                nsid
          client-subnet-scope: client-subnet-scope]]]]]

  # Encode all records in one section, threading the compression table and offset.
  # Returns {bytes: Bytes  offset: Int  table: [Map DnsName Int]}.
  encode-section: [fn [let records offset@Integer table@[Map DnsName Int]]
    [reduce [fn [let acc r]
      [result: [encode-rr-compressed r acc.offset acc.table]]
      [offset: [+ acc.offset [length result.bytes]]
       table:  result.table
       bytes:  [concat acc.bytes result.bytes]]]
     [offset: offset  table: table  bytes: [bytes 0]]
     records]]

  encode-dns-response: [fn [let resp@DnsResponse]
    [rcode-int: resp.rcode.rcode]
    [header: [concat
      [bytes ByteOrder.Network [@UInt16 resp.id]]
      [bytes ByteOrder.Network [@UInt16 [bor 0x8080 rcode-int]]]
      [bytes ByteOrder.Network [@UInt16 0]]
      [bytes ByteOrder.Network [@UInt16 [length resp.answers]]]
      [bytes ByteOrder.Network [@UInt16 [length resp.authority]]]
      [bytes ByteOrder.Network [@UInt16 [length resp.additional]]]]]
    # Thread compression table across all three sections — cross-section compression works.
    [an: [encode-section resp.answers    [length header] []]]
    [ns: [encode-section resp.authority  an.offset       an.table]]
    [ar: [encode-section resp.additional ns.offset       ns.table]]
    [concat header an.bytes ns.bytes ar.bytes]]

  dns-udp-resolver: [fn [let cap@NetCap addr@SocketAddress]
    [fn [let q@DnsQuery]
      [task
        [sock: [udp-ephemeral cap]]
        [send sock addr [encode-dns-wire q]]
        [resp: [recv sock]]
        [match [decode-dns-wire resp.data]
          [Result.Ok r]:  r
          [Result.Error e]: [error [str "dns-udp: " e]]]]]]

  dns-tls-resolver: [fn [let cap@NetCap addr@SocketAddress sni@String]
    [fn [let q@DnsQuery]
      [task
        [tls: [[tcp-connect cap addr] | [tls-layer sni [alpn: []  ech: []  trust-roots: SystemRoots]]]]
        [dns-framed-send tls q]]]]

  dns-https-resolver: [fn [let cap@NetCap addr@SocketAddress sni@String path@String]
    [client: [http3-client [quic-connect cap addr
                             [sni: sni  alpn: ["h3"]  ech: []  trust-roots: SystemRoots]]]]
    [fn [let q@DnsQuery]
      [task [dns-https-send client q path]]]]

  dns-quic-resolver: [fn [let cap@NetCap addr@SocketAddress sni@String]
    [fn [let q@DnsQuery]
      [task
        [conn:   [quic-connect cap addr [sni: sni  alpn: ["doq"]  ech: []  trust-roots: SystemRoots]]]
        [stream: [quic-open-stream conn]]
        [dns-framed-send stream q]]]]

  dns-framed-send: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h q@DnsQuery]
    [wire: [encode-dns-wire q]]
    [write h [concat [bytes ByteOrder.Network [@UInt16 [length wire]]] wire]]
    [resp-len: [uint16 ByteOrder.Network [read h 2]]]
    [match [decode-dns-wire [read h resp-len]]
      [Result.Ok r]:    r
      [Result.Error e]: [error [str "dns-framed: " e]]]]

  # dns-tcp-resolver: raw TCP/53 resolver (no TLS). Uses dns-framed-send for the 2-byte
  # length-prefix framing required by DNS-over-TCP (RFC 1035 §4.2.2).
  # Used when q.tcp: true, or when TC=1 (truncated) retry is needed.
  dns-tcp-resolver: [fn [let cap addr@SocketAddress]
    [fn [let q] [task
      [th: [TcpHandle [addr: addr.addr  port: addr.port  stream: [tcp-connect cap addr]]]]
      [dns-framed-send th q]]]]

  # ns-to-resolver: get the resolver function for a nameserver.
  # Cookie injection is handled by dns-try-servers before calling the resolver;
  # the resolver factories here only need addr/sni/path for transport setup.
  ns-to-resolver: [fn [let cap@NetCap ns@Nameserver]
    [match ns
      [nameserver.UdpNameserver addr: addr _]:               [dns-udp-resolver   cap addr]
      [nameserver.TcpNameserver addr: addr _]:               [dns-tcp-resolver   cap addr]
      [nameserver.DotNameserver addr: addr  sni: sni _]:     [dns-tls-resolver   cap addr sni]
      [nameserver.DohNameserver addr: addr  sni: sni  path: path _]: [dns-https-resolver cap addr sni path]
      [nameserver.DoqNameserver addr: addr  sni: sni _]:     [dns-quic-resolver  cap addr sni]]]

  # Re-exported from internal dict so callers have one import point.
  dns-query-with-retry: dns-query-with-retry

  # resolve-address: resolve an Address to an interleaved [Seq IpAddress] via Happy Eyeballs.
  # [Hostname h]: parallel A+AAAA with 50ms IPv6 head start, interleaved v6-first.
  # IpAddress variants: returned as a single-element list (no DNS needed).
  resolve-address: [fn [let cap@NetCap addr@Host]   # takes Host, not HostPort — used internally
    [match addr
      [Hostname.Hostname h]:
        [config: %dns]
        [if config.single-request
          [block
            [v6: [match [try [lookup-ips cap DnsQtype.AAAA h]] [Result.Ok a]: a [Result.Error _]: []]
             v4: [match [try [lookup-ips cap DnsQtype.A    h]] [Result.Ok a]: a [Result.Error _]: []]]
            [interleave v6 v4]]
          [block
            [v6-task: [task [lookup-ips cap DnsQtype.AAAA h]]
             v4-task: [task [lookup-ips cap DnsQtype.A    h]]]
            [v6-first: [match [timeout [millis 50] v6-task] [Result.Ok a]: a [Result.Error _]: []]]
            [v4: [await v4-task]]
            [v6: [if [= [] v6-first]
              [match [try [await v6-task]] [Result.Ok a]: a [Result.Error _]: []]
              v6-first]]
            [interleave v6 v4]]]
      [let ip@IpAddress]: [list ip]]]

  # resolve: query DNS and return the raw answer section.
  # Returns [or [Seq DnsRecord] DnsError].
  # Applies ndots + search domain expansion (per /etc/resolv.conf semantics).
  # Does NOT follow CNAME records — recursive resolvers include final records alongside
  # CNAMEs in the answer, so this is sufficient in practice. Authoritative-server callers
  # that receive bare CNAMEs must follow them manually or use lookup-ips.
  #
  # Required params first (cap, qtype, name), optional named params after.
  # Required params must precede optional params — tinct call convention.
  #
  # Usage:
  #   [resolve %net DnsQtype.A "api.example.com"]                         # standard query
  #   [resolve %net DnsQtype.TXT "version.bind" class: DnsClass.CH]       # chaos class
  #   [resolve %net DnsQtype.A "example.com" do: true]                    # DNSSEC OK
  #   [resolve %net DnsQtype.DNSKEY "example.com" do: true cd: true]      # DNSSEC, no validation
  #   "api.example.com" | [resolve %net DnsQtype.HTTPS]                   # pipeline form
  resolve: [fn@[return: [or DnsResponse DnsError]]
             [let cap@NetCap
                  qtype@DnsQtype
                  name@String                                          # required — position 2, pipeline subject
                  class@[type: DnsClass  default: DnsClass.IN]          # QCLASS (almost always IN)
                  rd@[type: Bool         default: true]                  # Recursion Desired
                  do@[type: Bool         default: false]                 # EDNS0 DNSSEC OK bit
                  cd@[type: Bool         default: false]                 # Checking Disabled
                  ad@[type: Bool         default: false]                 # Authentic Data request
                  tcp@[type: Bool        default: false]                 # force TCP transport
                  edns@[type: Bool       default: true]                  # include EDNS0 OPT record
                  bufsize@[type: Int@[is: [between 512 65535]]  default: 1232]  # EDNS UDP payload size (RFC 6891 §6.2.3)
                  ignore-tc@[type: Bool  default: false]                  # skip TCP retry on TC=1
                  co@[type: Bool  default: false]                          # EDNS CO: Compact Answers OK (RFC 9824)
                  nsid@[type: Bool  default: false]                        # request NSID (RFC 5001)
                  client-subnet@[type: [or ClientSubnet Absent]  default: Absent.Absent]]  # ECS override
    [config: %dns]
    [if [empty? config.nameservers]
      dnsError.ServerFailure
      [opts: [@dnsQueryOpts
             [qclass: class  rd: rd  do: do  cd: cd  ad: ad
              tcp: tcp  edns: edns  bufsize: bufsize  ignore-tc: ignore-tc
              co: co  nsid: nsid  client-subnet: client-subnet]]]
      [try-records cap config [candidate-names name config.search config.ndots] qtype opts]]]

  # lookup-ips: resolve a hostname to IP addresses. No flags exposed — always class=IN,
  # rd=true, DNSSEC off. The IP convenience wrapper; use resolve for full control.
  # Returns [or [Seq IpAddress] DnsError].
  # Applies ndots + search domain expansion. Follows CNAME chains with depth limit 8
  # (RFC 1034 §3.6.2) as a safety net for authoritative servers; recursive resolvers
  # (1.1.1.1, 8.8.8.8, systemd-resolved) include final A/AAAA records in the answer
  # alongside any CNAMEs, so CNAME recursion fires only in edge cases.
  #
  # Usage: [lookup-ips cap qtype name] — name is subject (last).
  # Use DnsQtype.A for IPv4, DnsQtype.AAAA for IPv6 (call both in parallel for Happy Eyeballs).
  lookup-ips: [fn@[return: [or [Seq IpAddress] DnsError]] [let cap@NetCap qtype@DnsQtype name@String]
    [config: %dns]
    [if [empty? config.nameservers]
      dnsError.ServerFailure
      [try-ips cap config [candidate-names name config.search config.ndots] qtype]]]

  # dns-server-loop: drain a Channel@ServerEvent, calling handler with (connection, query).
  # Works for any DNS transport — connection type t varies (SocketAddress for UDP, TlsConnection for DoT, etc.).
  dns-server-loop: [fn@Task [fn@[bind: [t]] [let handler@[Fn [t DnsQuery] DnsResponse]
                                                  query-ch@[Channel [ServerEvent t DnsQuery]]]
    [drain [fn [let event] [task [event.request.respond [handler event.connection event.request]]]] query-ch]]

  # dns-udp-server: emit ServerEvent SocketAddress DnsQuery pairs.
  # connection = dg.src (source SocketAddress) — the "connection" for stateless UDP.
  # Handlers receive the source address directly: [fn [let connection@SocketAddress query@DnsQuery] ...]
  dns-udp-server: [fn [let cap@NetCap port@Port]
    [sock: [udp-socket cap BindTarget.IpBind [addr: IpAddress.Ipv4 [0 0 0 0]  port: port]]]
    [out:  [channel 256]]
    [task
      [step: [fn []
        [dg: [recv sock]]
        [match [decode-dns-wire dg.data]
          [Result.Ok q]:
            [send out [ServerEvent
              connection: dg.src
              request:    [dnsQuery
                id:        q.id     name:      q.name
                qtype:     q.qtype  qclass:    q.qclass
                rd:        q.rd     do:        false
                cd:        false    ad:        false
                tcp:       false    edns:      true
                bufsize:   1232     ignore-tc: false
                respond:   [fn [let resp@DnsResponse]
                  [send sock dg.src [encode-dns-response resp]]]]]]
          [Result.Error _]: null]
        [step]]]
      [step]]
    out]

  # resolve-address: resolve a Host (IpAddress | Hostname) to IPs with Happy Eyeballs.
  # Exported so callers can resolve a Host without connecting.
  resolve-address: resolve-address
]

[instance Printable
  [let a@dnsName]:  [print: dns-name->string]]

[instance Printable
  [let a@dnsRcode]: [print: [fn [let rc] rc.description]]]

[instance Printable
  [let a@dnsOpcode]: [print: [fn [let op] op.description]]]

[instance Printable
  [let a@dnsClass]: [print: [fn [let cl] cl.description]]]

[instance Printable
  [let a@dnsExtendedError]: [print: [fn [let e] e.description]]]

# DnsRecordCodec: Codec dnsRecord ↔ full RR bytes (RFC 1035 §3.2.1) with name compression.
# encode: dnsRecord → compressed RR bytes (within-record compression, offset=0, fresh table)
# decode: compressed RR bytes → dnsRecord, using codec.msg for pointer decompression.
#         Pass msg=[bytes 0] or rr-bytes to decode single self-contained records.
# Round-trip: decode(DnsRecordCodec msg, encode(_, r)) = r for any dnsRecord r,
#             because single-record encoding uses within-record compression with no cross-record
#             pointers; the encoded bytes are self-contained and decode correctly with msg=rr-bytes.
[instance Codec
  [let a@DnsRecordCodec b@dnsRecord c@Bytes]: [encode: [fn [let _ r] [encode-rr r]]   # encode-rr uses encode-rr-compressed offset=0 table=[]
                                               decode: [fn [let codec rr-bytes@Bytes offset@Integer]
                                                 [frame: [slice rr-bytes offset [length rr-bytes]]]
                                                 [msg:     [if [empty? codec.msg] frame codec.msg]]
                                                 [name-res: [parse-dns-name msg 0 5]]
                                                 [p:       name-res.next]
                                                 [rtype:   [uint16 ByteOrder.Network [slice frame p [+ p 2]]]]
                                                 [ttl-raw: [uint32 ByteOrder.Network [slice frame [+ p 4] [+ p 8]]]]
                                                 [rdlen:   [uint16 ByteOrder.Network [slice frame [+ p 8] [+ p 10]]]]
                                                 [value: [parse-dns-rdata msg [+ p 10] rdlen rtype [seconds ttl-raw]]
                                                  next:  [+ offset p 10 rdlen]]]]]

# Transport typeclass instances — live here because they need lookup-ips.
#
# connect is always used as the bottom of a protocol stack:
#   [connect %net [Hostname "db.internal"] Tcp 5432]
#     | [tls-layer cfg]
#     | [codec PostgresCodec]
#
# Happy Eyeballs applies universally to [Hostname h]:
#   Tcp — parallel A+AAAA, 50ms v6 head start, race connections with 250ms stagger.
#   Udp — same address resolution; pick first from interleaved list (no connection to race).

[instance Transport
  [let h@Tcp]: [connect: [fn [let cap@NetCap _@Tcp ep@HostPort]
    [addr: ep.host  port: ep.port]
    # TcpHandle wraps the original addr (for SNI inference etc.) + a lazy stream thunk.
    # The stream thunk evaluates on first read/write; tinct memoizes the result.
    [TcpHandle
      [addr: addr  port: port
       stream:
         # Resolve address then race TCP connections (Happy Eyeballs: 250ms stagger).
         [addrs: [resolve-address cap addr]]
         [if [empty? addrs] [error "connect: no addresses resolved"] null]
         [result-ch:  [channel 1]
          attempt-ms: 250]
         [tasks: [collect [map [fn [let e]
           [i: e.0  ip: e.1]
           [task
             [recv [timer-channel %clock [millis [* i attempt-ms]]]]
             [match [try [tcp-connect cap [addr: ip  port: [@Port port]]]]
               [Result.Ok h]:    [try [send result-ch h]]
               [Result.Error _]: null]]]
           [entries addrs]]]]
         [match [recv result-ch]
           [Closed.Closed]: [error [str "connect: all TCP attempts failed for " [str addr]]]
           [Result.Ok h]:
             [par-map [fn [let t] [cancel-task t]] tasks]
             h]]]]]]

[instance Transport
  [let h@Udp]: [connect: [fn [let cap@NetCap _@Udp ep@HostPort]
    [addr: ep.host  port: ep.port]
    [addrs: [resolve-address cap addr]]
    [if [empty? addrs] [error "connect: no addresses resolved"] null]
    [peer: [addr: [get addrs 0]  port: [@Port port]]]
    ConnectedUdp
      sock: [udp-socket cap BindTarget.IpBind [addr: IpAddress.Ipv4 [0 0 0 0]  port: 0]]
      peer: peer]]]
