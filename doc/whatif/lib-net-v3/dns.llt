# stdlib/protocols/dns.llt — DNS wire format, resolver factories, name resolution.
# Part of: lib-net-v3
# Exports dns-resolve-host and dns-resolve. Include this directly when DNS resolution is needed.

[include %libdir "net.llt"]
[include %libdir "protocols/quic.llt"]   # quic-connect, quic-open-stream (DoQ resolver)
[include %libdir "protocols/http3.llt"]  # http3-client, h3-http-request (DoH resolver)

# ── Types (camelCase — accessible to internal helpers; re-exported as PascalCase in Public API) ──

[
  dnsQtype: [type
    [A          code: 1    description: "IPv4 address record"              doc: "RFC 1035"]
    [NS         code: 2    description: "Authoritative name server"        doc: "RFC 1035"]
    [Md         code: 3    description: "Mail destination (obsolete)"      doc: "RFC 1035"]
    [Mf         code: 4    description: "Mail forwarder (obsolete)"        doc: "RFC 1035"]
    [CNAME      code: 5    description: "Canonical name for an alias"      doc: "RFC 1035"]
    [SOA        code: 6    description: "Start of a zone of authority"     doc: "RFC 1035"]
    [Mb         code: 7    description: "Mailbox domain name (experimental)"  doc: "RFC 1035"]
    [Mg         code: 8    description: "Mail group member (experimental)"    doc: "RFC 1035"]
    [Mr         code: 9    description: "Mail rename name (experimental)"     doc: "RFC 1035"]
    [Null       code: 10   description: "Null RR (experimental)"              doc: "RFC 1035"]
    [WKS        code: 11   description: "Well known service description"   doc: "RFC 1035"]
    [PTR        code: 12   description: "Domain name pointer"              doc: "RFC 1035"]
    [HINFO      code: 13   description: "Host information"                 doc: "RFC 1035"]
    [Minfo      code: 14   description: "Mailbox or mail list info"        doc: "RFC 1035"]
    [MX         code: 15   description: "Mail exchange"                    doc: "RFC 1035"]
    [TXT        code: 16   description: "Text strings"                     doc: "RFC 1035"]
    [RP         code: 17   description: "Responsible person"               doc: "RFC 1183"]
    [AFSDB      code: 18   description: "AFS data base location"           doc: "RFC 1183"]
    [X25        code: 19   description: "X.25 PSDN address"               doc: "RFC 1183"]
    [Isdn       code: 20   description: "ISDN address"                    doc: "RFC 1183"]
    [RT         code: 21   description: "Route through"                    doc: "RFC 1183"]
    [Nsap       code: 22   description: "NSAP address (deprecated)"       doc: "RFC 1706"]
    [NsapPtr    code: 23   description: "NSAP pointer (deprecated)"       doc: "RFC 1706"]
    [SIG        code: 24   description: "Security signature"               doc: "RFC 2535"]
    [KEY        code: 25   description: "Security key"                     doc: "RFC 2535"]
    [Px         code: 26   description: "X.400 mail mapping info"         doc: "RFC 2163"]
    [Gpos       code: 27   description: "Geographical position"           doc: "RFC 1712"]
    [AAAA       code: 28   description: "IPv6 address record"              doc: "RFC 3596"]
    [LOC        code: 29   description: "Location information"             doc: "RFC 1876"]
    [Nxt        code: 30   description: "Next domain (obsolete)"          doc: "RFC 2535"]
    [Eid        code: 31   description: "Endpoint identifier"             doc: "Michael Patton"]
    [Nimloc     code: 32   description: "Nimrod locator"                  doc: "Michael Patton"]
    [SRV        code: 33   description: "Server selection"                 doc: "RFC 2782"]
    [Atma       code: 34   description: "ATM address"                     doc: "ATM Forum"]
    [NAPTR      code: 35   description: "Naming authority pointer"         doc: "RFC 3403"]
    [KX         code: 36   description: "Key exchanger"                    doc: "RFC 2230"]
    [CERT       code: 37   description: "Certificate record"               doc: "RFC 4398"]
    [A6         code: 38   description: "IPv6 address (obsolete)"         doc: "RFC 2874"]
    [DNAME      code: 39   description: "Delegation name"                  doc: "RFC 6672"]
    [Sink       code: 40   description: "Kitchen sink"                    doc: "draft-eastlake-kitchen-sink"]
    [OPT        code: 41   description: "Option (EDNS)"                    doc: "RFC 6891"]
    [APL        code: 42   description: "Address prefix list"              doc: "RFC 3123"]
    [DS         code: 43   description: "Delegation signer"                doc: "RFC 4034"]
    [SSHFP      code: 44   description: "SSH public key fingerprint"       doc: "RFC 4255"]
    [IPSECKEY   code: 45   description: "IPsec key"                        doc: "RFC 4025"]
    [RRSIG      code: 46   description: "DNSSEC signature"                 doc: "RFC 4034"]
    [NSEC       code: 47   description: "Next secure record"               doc: "RFC 4034"]
    [DNSKEY     code: 48   description: "DNS key record"                   doc: "RFC 4034"]
    [DHCID      code: 49   description: "DHCP identifier"                  doc: "RFC 4701"]
    [NSEC3      code: 50   description: "Next secure record version 3"     doc: "RFC 5155"]
    [NSEC3PARAM code: 51   description: "NSEC3 parameters"                 doc: "RFC 5155"]
    [TLSA       code: 52   description: "TLS authentication"               doc: "RFC 6698"]
    [SMIMEA     code: 53   description: "S/MIME cert association"          doc: "RFC 8162"]
    [HIP        code: 55   description: "Host identity protocol"           doc: "RFC 8005"]
    [Ninfo      code: 56   description: "Zone status information"         doc: "Jim Reid"]
    [Rkey       code: 57   description: "Resolver key"                    doc: "Jim Reid"]
    [Talink     code: 58   description: "Trust anchor link"               doc: "Wouter Wijngaards"]
    [CDS        code: 59   description: "Child delegation signer"          doc: "RFC 7344"]
    [CDNSKEY    code: 60   description: "Child DNS key"                    doc: "RFC 7344"]
    [OPENPGPKEY code: 61   description: "OpenPGP public key"               doc: "RFC 7929"]
    [CSYNC      code: 62   description: "Child-to-parent synchronization"  doc: "RFC 7477"]
    [ZONEMD     code: 63   description: "Message digest for DNS zone"      doc: "RFC 8976"]
    [SVCB       code: 64   description: "Service binding"                  doc: "RFC 9460"]
    [HTTPS      code: 65   description: "HTTPS service binding"            doc: "RFC 9460"]
    [Nid        code: 104  description: "Node identifier (ILNP)"           doc: "RFC 6742"]
    [L32        code: 105  description: "32-bit locator (ILNP)"            doc: "RFC 6742"]
    [L64        code: 106  description: "64-bit locator (ILNP)"            doc: "RFC 6742"]
    [Lp         code: 107  description: "Locator pointer (ILNP)"           doc: "RFC 6742"]
    [EUI48      code: 108  description: "MAC address (EUI-48)"             doc: "RFC 7043"]
    [EUI64      code: 109  description: "MAC address (EUI-64)"             doc: "RFC 7043"]
    [Nxname     code: 128  description: "NXDOMAIN indicator"               doc: "RFC 9824"]
    [TKEY       code: 249  description: "Transaction key"                  doc: "RFC 2930"]
    [TSIG       code: 250  description: "Transaction signature"            doc: "RFC 8945"]
    [IXFR       code: 251  description: "Incremental zone transfer"        doc: "RFC 1995"]
    [AXFR       code: 252  description: "Authoritative zone transfer"      doc: "RFC 5936"]
    [Mailb      code: 253  description: "Mailbox-related records"          doc: "RFC 1035"]
    [Maila      code: 254  description: "Mail agent (obsolete)"            doc: "RFC 1035"]
    [ANY        code: 255  description: "Any record type (*)"              doc: "RFC 1035"]
    [URI        code: 256  description: "Uniform resource identifier"      doc: "RFC 7553"]
    [CAA        code: 257  description: "Certification authority authorization"  doc: "RFC 8659"]
    [Avc        code: 258  description: "Application visibility and control"     doc: "Wolfgang Riedel"]
    [Doa        code: 259  description: "Digital object architecture"            doc: "draft-durand-doa-over-dns"]
    [Amtrelay   code: 260  description: "Automatic multicast tunneling relay"    doc: "RFC 8777"]
    [Resinfo    code: 261  description: "Resolver information"                   doc: "RFC 9606"]
    [Wallet     code: 262  description: "Wallet address"                         doc: "Paul Hoffman"]
    [Cla        code: 263  description: "CLA over DNS"                           doc: "draft-johnson-dns-ipn-cla"]
    [Ipn        code: 264  description: "IPN over DNS"                           doc: "draft-johnson-dns-ipn-cla"]
    [Ta         code: 32768  description: "DNSSEC trust authorities"             doc: "Sam Weiler"]
    [Dlv        code: 32769  description: "DNSSEC lookaside validation (obsolete)"  doc: "RFC 8749"]]

  # DNS label: RFC 1035 §2.3.1 — 1–63 chars.
  # Underscores are permitted (SRV, DKIM, etc.) despite RFC 952 restrictions.
  dnsLabel: [type String@[is: [and [>= [length _] 1] [<= [length _] 63]]]]

  # DNS name as a sequence of labels. Null at the final position marks an absolute
  # (fully-qualified) name; all preceding elements must be dnsLabel.
  # Structural contract: null-only-at-end? enforces this positional constraint at runtime.
  # See tracker: compile-time [Seq ...@T S] type form would make this static.
  #
  # ["example" "com"]        = example.com  (relative)
  # ["example" "com" Null]   = example.com. (absolute/canonical)
  # [Null]                   = .            (root zone)
  dnsName: [type [Seq [or dnsLabel Null]]@[is: dns-name-valid?]]

  # Structural contracts for dnsName:
  # 1. Null appears only at the final position (never mid-sequence)
  # 2. Total label content ≤ 253 chars (RFC 1035 §2.3.4)
  dns-name-valid?: [fn [let xs@[Seq [or dnsLabel Null]]]
    [labels: [filter [fn [let x] [not [null? x]]] xs]]
    [total:  [reduce [fn [let acc l] [+ acc [+ [length l] 1]]] -1 labels]]
    [and
      # Null can only be the last element — all elements except the last must be dnsLabel
      [all? [fn [let e] [not [null? e]]] [if [<= [length xs] 1] [] [take [- [length xs] 1] xs]]]
      # RFC 1035 §2.3.4: total ≤ 253 chars (joined with dots)
      [<= total 253]]]

  # RFC 9460 §2.3 SvcParams: a record of optional typed fields, one per SvcParamKey.
  # Each field uses [or T Absent] so absence of a param is distinct from an empty value.
  svcParams: [type
    [alpn:            [or [Seq String] Absent]      # key 1: Absent = no ALPN restriction
     no-default-alpn: Bool                           # key 2: false = param absent
     port:            [or Port Absent]               # key 3: Absent = use target's port
     ipv4-hint:       [or [Seq [Bytes 4]] Absent]    # key 4: Absent = no IPv4 hints
     ipv6-hint:       [or [Seq [Bytes 16]] Absent]   # key 6: Absent = no IPv6 hints
     ech:             [or Bytes Absent]              # key 5: Absent = no ECH config
     mandatory:       [or [Seq Int] Absent]          # key 0: Absent = no mandatory keys
     other:           [Map Int Bytes]]]              # unknown SvcParamKeys (extensibility)

  dnsRecord: [type
    [ARecord      addr@IpAddress.Ipv4  ttl@Duration]   # wire bytes ARE the Ipv4 address; no conversion
    [AAAARecord   addr@IpAddress.Ipv6  ttl@Duration]   # wire bytes ARE the Ipv6 address; no conversion
    [CNameRecord  name@dnsName     ttl@Duration]        # canonical name (FQDN, often trailing ".")
    [MxRecord     pref@Int  name@dnsName  ttl@Duration] # mail exchange hostname
    [NsRecord     name@dnsName  ttl@Duration]           # authoritative nameserver hostname
    [TxtRecord    strings@[Seq Bytes]  ttl@Duration]    # arbitrary bytes — NOT DnsName
    [PtrRecord    name@dnsName  ttl@Duration]           # reverse-DNS target hostname
    [SrvRecord    prio@Int  weight@Int  port@Int  target@dnsName  ttl@Duration]  # service target
    [HttpsRecord  prio@Int  target@dnsName  params@svcParams  ttl@Duration]      # HTTPS TargetName
    [SoaRecord    mname@dnsName  rname@dnsName  serial@UInt32   # rname = email as DNS name
                  refresh@Duration  retry@Duration  expire@Duration  minimum@Duration  ttl@Duration]
    [UnknownRecord  qtype@Int  data@Bytes  ttl@Duration]]

  dnsRcode: [type
    [NoError    rcode: 0   description: "No Error"                                doc: "RFC 1035"]
    [FormErr    rcode: 1   description: "Format Error"                            doc: "RFC 1035"]
    [ServFail   rcode: 2   description: "Server Failure"                          doc: "RFC 1035"]
    [NXDomain   rcode: 3   description: "Non-Existent Domain"                     doc: "RFC 1035"]
    [NotImpl    rcode: 4   description: "Not Implemented"                         doc: "RFC 1035"]
    [Refused    rcode: 5   description: "Query Refused"                           doc: "RFC 1035"]
    [YXDomain   rcode: 6   description: "Name exists when it should not"          doc: "RFC 2136"]
    [YXRRSet    rcode: 7   description: "RR set exists when it should not"        doc: "RFC 2136"]
    [NXRRSet    rcode: 8   description: "RR set that should exist does not"       doc: "RFC 2136"]
    [NotAuth    rcode: 9   description: "Server not authoritative / not authorized"  doc: "RFC 2136"]
    [NotZone    rcode: 10  description: "Name not contained in zone"              doc: "RFC 2136"]
    [DsoTypeNI  rcode: 11  description: "DSO-TYPE not implemented"                doc: "RFC 8490"]
    [BadVers    rcode: 16  description: "Bad OPT version / TSIG signature failure"  doc: "RFC 6891"]
    [BadKey     rcode: 17  description: "Key not recognized"                      doc: "RFC 8945"]
    [BadTime    rcode: 18  description: "Signature out of time window"            doc: "RFC 8945"]
    [BadMode    rcode: 19  description: "Bad TKEY mode"                           doc: "RFC 2930"]
    [BadName    rcode: 20  description: "Duplicate key name"                      doc: "RFC 2930"]
    [BadAlg     rcode: 21  description: "Algorithm not supported"                 doc: "RFC 2930"]
    [BadTrunc   rcode: 22  description: "Bad truncation"                          doc: "RFC 8945"]
    [BadCookie  rcode: 23  description: "Bad/missing server cookie"               doc: "RFC 7873"]]

  dnsOpcode: [type
    [Query   code: 0  description: "Standard query"              doc: "RFC 1035"]
    [IQuery  code: 1  description: "Inverse query (obsolete)"    doc: "RFC 1035"]
    [Status  code: 2  description: "Server status request"       doc: "RFC 1035"]
    [Notify  code: 4  description: "Zone change notification"    doc: "RFC 1996"]
    [Update  code: 5  description: "Dynamic update"              doc: "RFC 2136"]
    [Dso     code: 6  description: "DNS Stateful Operations"     doc: "RFC 8490"]]

  dnsClass: [type
    [IN   code: 1    description: "Internet"         doc: "RFC 1035"]
    [CH   code: 3    description: "Chaos"            doc: "D. Moon, Chaosnet"]
    [HS   code: 4    description: "Hesiod"           doc: "Dyer and Hsu, Hesiod"]
    [None code: 254  description: "QCLASS NONE"      doc: "RFC 2136"]
    [Any  code: 255  description: "QCLASS * (any)"   doc: "RFC 1035"]]

  dnsExtendedError: [type
    [Other                    code: 0   description: "Other Error"                      doc: "RFC 8914"]
    [UnsupportedDnskeyAlg     code: 1   description: "Unsupported DNSKEY Algorithm"     doc: "RFC 8914"]
    [UnsupportedDsDigest      code: 2   description: "Unsupported DS Digest Type"       doc: "RFC 8914"]
    [StaleAnswer              code: 3   description: "Stale Answer"                     doc: "RFC 8914"]
    [ForgedAnswer             code: 4   description: "Forged Answer"                    doc: "RFC 8914"]
    [DnssecIndeterminate      code: 5   description: "DNSSEC Indeterminate"             doc: "RFC 8914"]
    [DnssecBogus              code: 6   description: "DNSSEC Bogus"                     doc: "RFC 8914"]
    [SignatureExpired          code: 7   description: "Signature Expired"                doc: "RFC 8914"]
    [SignatureNotYetValid      code: 8   description: "Signature Not Yet Valid"          doc: "RFC 8914"]
    [DnskeyMissing            code: 9   description: "DNSKEY Missing"                   doc: "RFC 8914"]
    [RrsigsMissing            code: 10  description: "RRSIGs Missing"                   doc: "RFC 8914"]
    [NoZoneKeyBit             code: 11  description: "No Zone Key Bit Set"              doc: "RFC 8914"]
    [NsecMissing              code: 12  description: "NSEC Missing"                     doc: "RFC 8914"]
    [CachedError              code: 13  description: "Cached Error"                     doc: "RFC 8914"]
    [NotReady                 code: 14  description: "Not Ready"                        doc: "RFC 8914"]
    [Blocked                  code: 15  description: "Blocked"                          doc: "RFC 8914"]
    [Censored                 code: 16  description: "Censored"                         doc: "RFC 8914"]
    [Filtered                 code: 17  description: "Filtered"                         doc: "RFC 8914"]
    [Prohibited               code: 18  description: "Prohibited"                       doc: "RFC 8914"]
    [StaleNxdomainAnswer      code: 19  description: "Stale NXDomain Answer"            doc: "RFC 8914"]
    [NotAuthoritative         code: 20  description: "Not Authoritative"                doc: "RFC 8914"]
    [NotSupported             code: 21  description: "Not Supported"                    doc: "RFC 8914"]
    [NoReachableAuthority     code: 22  description: "No Reachable Authority"           doc: "RFC 8914"]
    [NetworkError             code: 23  description: "Network Error"                    doc: "RFC 8914"]
    [InvalidData              code: 24  description: "Invalid Data"                     doc: "RFC 8914"]
    [SignatureExpiredBeforeValid code: 25  description: "Signature Expired before Valid"  doc: "RFC 8914"]
    [TooEarly                 code: 26  description: "Too Early"                        doc: "RFC 9250"]
    [UnsupportedNsec3Iter     code: 27  description: "Unsupported NSEC3 Iterations"    doc: "RFC 9276"]
    [UnableToConformToPolicy  code: 28  description: "Unable to conform to policy"      doc: "RFC 8914"]
    [Synthesized              code: 29  description: "Synthesized"                      doc: "RFC 8914"]
    [InvalidQueryType         code: 30  description: "Invalid Query Type"               doc: "RFC 9824"]
    [RateLimited              code: 31  description: "Rate Limited"                     doc: "RFC 8914"]
    [OverQuota                code: 32  description: "Over Quota"                       doc: "RFC 8914"]]

  dnsResponse: [type
    [id:         Int
     rcode:      dnsRcode
     answers:    [Seq dnsRecord]
     authority:  [Seq dnsRecord]
     additional: [Seq dnsRecord]
     truncated:  Bool]]

  dnsQuery: [type
    [id:        Int
     name:      DnsName    # the query name (e.g. "example.com." or "example.com")
     qtype:     dnsQtype
     recursive: Bool
     respond:   [or [Fn [dnsResponse] Null] Null]]]

  nameserver: [type
    [UdpNameserver  addr@SocketAddress]
    [DotNameserver  addr@SocketAddress  sni@String]
    [DohNameserver  addr@SocketAddress  sni@String  path@String]
    [DoqNameserver  addr@SocketAddress  sni@String]]

  dnsConfig: [type
    [nameservers:    [Seq nameserver]
     search:         [Seq String]
     ndots:          Int
     timeout:        Duration
     attempts:       Int
     rotate:         Bool
     no-aaaa:        Bool
     edns0:          Bool
     use-vc:         Bool
     no-check-names: Bool
     trust-ad:       Bool
     single-request: Bool
     sortlist:       [Seq String]]]

  # DNS error type — distinct failure modes callers can pattern-match on.
  dnsError: [type
    [NXDomain    name@String]    # NXDOMAIN: name definitively does not exist
    [ServerFailure]              # SERVFAIL: retry with a different nameserver
    [Refused]                    # REFUSED: server policy rejected the query
    [Timeout]                    # no response within configured time limit
    [Truncated]                  # response truncated (UDP); retry over TCP/TLS
    [NotImplemented]             # NOTIMP: server does not support this query type
    [DecodeFailed  reason@String]]  # wire format decode error (malformed response)
]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  # Verified: str-chars=✓ (builtin-str-chars), get?=✓ (core builtin)
  # random-id: not in prelude; use [uint16 NetworkEndian [crypto-random 2]] — [Bytes 2] → UInt16

  # Parse a string into the dnsName seq structure.
  # "example.com"  → ["example" "com"]           (relative)
  # "example.com." → ["example" "com" Null]       (absolute)
  # "."            → [Null]                        (root zone)
  parse-dns-name-str: [fn [let s@String]
    [absolute: [ends-with? "." s]]
    [bare:     [if absolute [str-slice 0 [- [length s] 1] s] s]]
    [labels:   [if [= bare ""] [] [str-split "." bare]]]
    [if absolute [append labels [list Null]] labels]]

  # Convert a dnsName seq back to its string representation.
  # Used for display and interop (TLS SNI, HTTP Host headers, etc.).
  # Substitute for Showable until R-14 (Printable typeclass) lands.
  dns-name->string: [fn [let name@dnsName]
    [parts: [filter [fn [let x] [not [null? x]]] name]]
    [base:  [join "." parts]]
    [if [and [not [empty? name]] [null? [last name]]] [str base "."] base]]

  encode-dns-name: [fn [let name@dnsName]
    [labels: [filter [fn [let x] [not [null? x]]] name]]
    [concat
      [flat-map [fn [let label]
        [concat [bytes [length label]] [str-bytes label]]]
       labels]
      [bytes 0]]]

  rotate-list: [fn [let xs]
    [match xs [] [] [let [h ...t]]: [append [list h] t]]]

  dns-try-servers: [fn [let cap@NetCap servers@[Seq nameserver]
                         name@String qtype@dnsQtype remaining@Int timeout@Duration]
    [if [= remaining 0]
      dnsError.ServerFailure
      [match servers
        []: dnsError.ServerFailure
        [let [ns ...rest]]:
          [resolver: [ns-to-resolver cap ns]]
          [match [try [await [timeout timeout [resolver
                  dnsQuery.dnsQuery id: [uint16 NetworkEndian [crypto-random 2]]  name: name
                                    qtype: qtype  recursive: true  respond: null]]]]
            [Result.Ok resp]:
              [match resp.rcode
                [dnsRcode.ServFail]: [dns-try-servers cap rest name qtype [- remaining 1] timeout]
                [dnsRcode.NotImpl]:  dnsError.NotImplemented
                _:                   resp]
            [Result.Error _]: [dns-try-servers cap rest name qtype [- remaining 1] timeout]]]]]

  candidate-names: [fn [let host@String search@[Seq String] ndots@Int]
    [if [ends-with? "." host]
      [list host]
      [block
        [dot-count: [length [filter [fn [let c] [= c "."]] [str-chars host]]]
         absolute:  [str host "."]
         searched:  [map [fn [let d] [str host "." d "."]] search]]
        [if [>= dot-count ndots]
          [cons absolute searched]
          [append [list absolute] searched]]]]]

  dns-query-with-retry: [fn [let cap@NetCap nameservers@[Seq Nameserver]
                              name@String qtype@DnsQtype
                              attempts@Int rotate@Bool timeout@Duration]
    [dns-try-servers cap [if rotate [rotate-list nameservers] nameservers]
                     name qtype attempts timeout]]

  dns-try-names: [fn [let cap@NetCap config@dnsConfig names@[Seq String] qtype@dnsQtype
                       cname-depth@[type: Int  default: 0]]
    [match names
      []: dnsError.ServerFailure
      [let [name ...rest]]:
        [match [try [dns-query-with-retry cap config.nameservers name qtype
                                         config.attempts config.rotate config.timeout]]
          [Result.Ok resp]:
            [match resp.rcode
              [dnsRcode.NXDomain]: [dns-try-names cap config rest qtype cname-depth]
              [dnsRcode.Refused]:  dnsError.Refused
              [dnsRcode.NotImpl]:  dnsError.NotImplemented
              _:                   [records->addrs resp.answers qtype cap cname-depth]]
          [Result.Error _]: [dns-try-names cap config rest qtype cname-depth]]]]

  # cname-depth: current CNAME chain depth; error at 8 per RFC 1034 §3.6.2 guidance.
  records->addrs: [fn [let records@[Seq dnsRecord] qtype@dnsQtype cap@NetCap cname-depth@[type: Int  default: 0]]
    [if [>= cname-depth 8]
      [error "DNS: CNAME chain too long (max 8)"]
      [flat-map [fn [let r]
        [match r
          [dnsRecord.ARecord     addr: addr]: [if [= qtype dnsQtype.A]    [list addr] []]
          [dnsRecord.AAAARecord  addr: addr]: [if [= qtype dnsQtype.AAAA] [list addr] []]
          [dnsRecord.CNameRecord name: name]:
            [match [try [dns-try-names cap %dns [list [str name "."]] qtype [+ cname-depth 1]]]
              [Result.Ok addrs]: addrs
              [Result.Error _]:  []]
          _: []]]
       records]]]

  dns-https-send: [fn [let client path@String q@DnsQuery]
    [wire: [encode-dns-wire q]]
    [resp: [await [h3-http-request client
      [method:  "POST"
       path:    path
       headers: ["content-type":   "application/dns-message"
                 "accept":         "application/dns-message"
                 "content-length": [str [length wire]]]
       body: wire]]]]
    [if [not [= resp.status 200]]
      [error [str "DoH: HTTP " resp.status]]
      [match [decode-dns-wire resp.body]
        [Result.Ok r]:    r
        [Result.Error e]: [error [str "DoH decode: " e]]]]]

  # Helper: Duration → UInt32 seconds (clamped to 2^31-1 per RFC 2181 §8).
  duration->ttl: [fn [let d@Duration]
    [@UInt32 [min [seconds-of d] 2147483647]]]

  # RFC 1035 §4.1.4: encode a DNS name with pointer compression.
  # table: DnsName → Int (byte offset in message where that name begins).
  # offset: current write position in the message (for registering new names).
  # Returns {bytes: Bytes  table: [Map DnsName Int]} with the updated table.
  encode-dns-name-compressed: [fn [let name@dnsName offset@Int table@[Map dnsName Int]]
    [labels: [filter [fn [let x] [not [null? x]]] name]]
    # Try each suffix (longest first) to find a compression pointer.
    [try-suffix: [fn [let i prefix-bytes prefix-offset]
      [if [> i [length labels]]
        # No suffix matched — emit root byte, register full name.
        [block
          [full: [concat prefix-bytes [0x00]]]
          [bytes: full  table: [set name prefix-offset table]]]
        # Try suffix starting at label i.
        [block
          [suffix: [apply str [intersperse "." [append [slice labels i [length labels]] [list ""]]]]]
          [match [get? table suffix]
            [let ptr-off]:
              # Found! Emit prefix labels + 2-byte pointer.
              [ptr: [bytes NetworkEndian [@UInt16 [bor 0xC000 ptr-off]]]]
              [full: [concat prefix-bytes ptr]]
              [bytes: full  table: [set name prefix-offset table]]
            [Absent.Absent]:
              # Register this suffix for future compression, then try shorter.
              [label:      [get labels i]]
              [label-wire: [concat [bytes NetworkEndian [@UInt8 [length [str-bytes label]]]] [str-bytes label]]]
              [new-prefix: [concat prefix-bytes label-wire]]
              [new-off:    [+ prefix-offset [length label-wire]]]
              [new-table:  [set suffix prefix-offset table]]
              [try-suffix [+ i 1] new-prefix new-off new-table]]]]]]]
    [try-suffix 0 [bytes 0] offset table]]

  # Encode a name and return {bytes: Bytes  table: [Map DnsName Int]}.
  # Wrapper that handles the empty/root name case.
  enc-name: [fn [let name@DnsName offset@Int table@[Map DnsName Int]]
    [if [or [= name ""] [= name "."]]
      [bytes: [0x00]  table: table]
      [encode-dns-name-compressed name offset table]]]

  # Helper: build wire RR header + rdata, threading compression table.
  # Returns {bytes: Bytes  table: [Map DnsName Int]}.
  rr-wire-compressed: [fn [let rtype@Int ttl@Duration rdata@Bytes offset@Int table@[Map DnsName Int]]
    # Owner name is "." (root) — single zero byte, no compression.
    [owner:   [0x00]]
    [header:  [concat owner
                      [bytes NetworkEndian [@UInt16 rtype]]
                      [bytes NetworkEndian [@UInt16 1]]          # class = IN
                      [bytes NetworkEndian [duration->ttl ttl]]
                      [bytes NetworkEndian [@UInt16 [length rdata]]]]]
    [full: [concat header rdata]]
    [bytes: full  table: table]]

  # dnsRecord → {bytes: Bytes  table: [Map DnsName Int]} with name compression.
  # offset: where this RR starts in the message (for registering name offsets).
  # table:  compression table built up from previous RRs in the same message.
  encode-rr-compressed: [fn [let r@dnsRecord offset@Int table@[Map DnsName Int]]
    # rdata-base: byte offset where rdata starts (after 1-byte owner + 10-byte fixed header).
    [rdata-base: [+ offset 11]]
    [match r
      [dnsRecord.ARecord addr: addr ttl: ttl]:
        [rr-wire-compressed 1 ttl [match addr [IpAddress.Ipv4 b]: b] offset table]

      [dnsRecord.AAAARecord addr: addr ttl: ttl]:
        [rr-wire-compressed 28 ttl [match addr [IpAddress.Ipv6 b]: b] offset table]

      [dnsRecord.CNameRecord name: name ttl: ttl]:
        [nr: [enc-name name rdata-base table]]
        [rr-wire-compressed 5 ttl nr.bytes offset nr.table]

      [dnsRecord.MxRecord pref: pref name: name ttl: ttl]:
        [nr: [enc-name name [+ rdata-base 2] table]]
        [rr-wire-compressed 15 ttl [concat [bytes NetworkEndian [@UInt16 pref]] nr.bytes] offset nr.table]

      [dnsRecord.NsRecord name: name ttl: ttl]:
        [nr: [enc-name name rdata-base table]]
        [rr-wire-compressed 2 ttl nr.bytes offset nr.table]

      [dnsRecord.TxtRecord strings: strings ttl: ttl]:
        [rdata: [apply concat [map [fn [let s]
          [concat [bytes NetworkEndian [@UInt8 [length s]]] s]] strings]]]
        [rr-wire-compressed 16 ttl rdata offset table]

      [dnsRecord.PtrRecord name: name ttl: ttl]:
        [nr: [enc-name name rdata-base table]]
        [rr-wire-compressed 12 ttl nr.bytes offset nr.table]

      [dnsRecord.SrvRecord prio: prio weight: weight port: port target: target ttl: ttl]:
        [nr: [enc-name target [+ rdata-base 6] table]]
        [rdata: [concat [bytes NetworkEndian [@UInt16 prio]]
                        [bytes NetworkEndian [@UInt16 weight]]
                        [bytes NetworkEndian [@UInt16 port]]
                        nr.bytes]]
        [rr-wire-compressed 33 ttl rdata offset nr.table]

      [dnsRecord.SoaRecord mname: mname rname: rname serial: serial
                           refresh: refresh retry: retry expire: expire minimum: minimum ttl: ttl]:
        [mn: [enc-name mname rdata-base table]]
        [rn: [enc-name rname [+ rdata-base [length mn.bytes]] mn.table]]
        [times: [concat [bytes NetworkEndian serial]
                        [bytes NetworkEndian [duration->ttl refresh]]
                        [bytes NetworkEndian [duration->ttl retry]]
                        [bytes NetworkEndian [duration->ttl expire]]
                        [bytes NetworkEndian [duration->ttl minimum]]]]
        [rr-wire-compressed 6 ttl [concat mn.bytes rn.bytes times] offset rn.table]

      [dnsRecord.HttpsRecord prio: prio target: target params: _ ttl: ttl]:
        [nr: [enc-name target [+ rdata-base 2] table]]
        [rr-wire-compressed 65 ttl [concat [bytes NetworkEndian [@UInt16 prio]] nr.bytes] offset nr.table]

      [dnsRecord.UnknownRecord qtype: qtype data: data ttl: ttl]:
        [rr-wire-compressed qtype ttl data offset table]]]

  # Encode a single record with compression (offset=0, fresh table).
  encode-rr: [fn [let r@dnsRecord]
    [result: [encode-rr-compressed r 0 []]]
    result.bytes]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # Named domain types with fixed byte-order encodings per RFC 1035.
  # All DNS multi-byte integers are big-endian (network byte order) per RFC 1035 §2.3.2.
  DnsId:       [type UInt16@[encoding: NetworkEndian]]   # RFC 1035 §4.1.1: 16-bit query ID
  DnsQClass:   [type UInt16@[encoding: NetworkEndian]]   # RFC 1035 §3.2.4: 16-bit query class (e.g. IN=1)
  DnsTtl:      [type UInt32@[encoding: NetworkEndian]]   # RFC 1035 §3.2.1: 32-bit TTL in seconds
  DnsRdLength: [type UInt16@[encoding: NetworkEndian]]   # RFC 1035 §3.2.1: 16-bit RDATA length

  # Re-export types under canonical PascalCase names.
  # (Defined with camelCase in the types dict above so internal helpers can access them.)
  # Note: runtime constructor tags carry the camelCase prefix (e.g. "dnsQtype.A") — see R-13.
  SvcParams:   svcParams     # RFC 9460 SvcParams record type
  DnsLabel:    dnsLabel      # RFC 1035 §2.3.1: one label (1–63 chars)
  DnsName:     dnsName       # RFC 1035 §2.3.1: seq of labels, Null = trailing dot
  DnsQtype:    dnsQtype

  # Parse a string into the DnsName seq structure.
  # "example.com"  → ["example" "com"]           (relative)
  # "example.com." → ["example" "com" Null]       (absolute/canonical)
  # "."            → [Null]                        (root zone)
  # Validates via dnsName structural contract (label length, total length, Null at end only).
  dns-name:        parse-dns-name-str

  dns-name->string: dns-name->string
  DnsRecord:   dnsRecord
  DnsRcode:          dnsRcode
  DnsOpcode:         dnsOpcode
  DnsClass:          dnsClass
  DnsExtendedError:  dnsExtendedError
  DnsError:          dnsError

  # Codec for a single DNS resource record.
  # msg: the full DNS message bytes, needed for name decompression during decode.
  # For bytes produced by encode (uncompressed names), pass the rr-bytes itself as msg.
  DnsRecordCodec: [type [msg: Bytes]]
  DnsQuery:    dnsQuery
  DnsResponse: dnsResponse
  Nameserver:  nameserver
  DnsConfig:   dnsConfig

  encode-dns-wire: [fn [let q@DnsQuery]
    [concat
      [bytes NetworkEndian [@UInt16 q.id]]
      [bytes NetworkEndian [@UInt16 [if q.recursive 0x0100 0x0000]]]
      [bytes NetworkEndian [@UInt16 1]]  [bytes NetworkEndian [@UInt16 0]]
      [bytes NetworkEndian [@UInt16 0]]  [bytes NetworkEndian [@UInt16 0]]
      [encode-dns-name q.name]
      [bytes NetworkEndian [@UInt16 q.qtype.code]]
      [bytes NetworkEndian [@UInt16 1]]]]

  # RFC 1035 §4 DNS wire format decoder.
  # Algorithm:
  #   1. Parse header (12 bytes): id(2) flags(2) qdcount(2) ancount(2) nscount(2) arcount(2)
  #      - rcode = flags & 0x000F → dnsRcode
  #      - qr = flags >> 15 & 1 (1 = response)
  #      - truncated = flags >> 9 & 1
  #   2. Skip question section (qdcount entries): parse each as name+qtype(2)+qclass(2)
  #      Name parsing: series of length-prefixed labels ending in 0x00; pointer = 0xC0 byte
  #   3. Parse answers (ancount), authority (nscount), additional (arcount) sections:
  #      Each RR: name + type(2) + class(2) + ttl(4) + rdlength(2) + rdata(rdlength)
  #      Dispatch on type to build dnsRecord variants
  #   4. Name pointer compression (RFC 1035 §4.1.4): 0xC0XX = pointer to offset XX in message
  #      Name parsing must thread the full message buffer for pointer resolution
  #   Returns dnsResponse or dnsError.DecodeFailed if malformed.
  # RFC 1035 §4.1.4: parse a domain name at offset in b, returning name string and next offset.
  # Pointer compression: byte 0xC0 = pointer; next byte gives offset in message.
  # Label: length byte + that many ASCII chars; 0x00 = root (end).
  # ptr-depth: follow at most 5 pointers to prevent infinite loops.
  parse-dns-name: [fn [let b@Bytes offset@Int ptr-depth@Int]
    [if [= ptr-depth 0]
      [name: ""  next: offset]   # pointer loop guard — return empty
      [if [>= offset [length b]]
        [name: ""  next: offset]
        [block
          [len-byte: [get b offset]]
          [if [= len-byte 0]
            # End of name (root label)
            [name: ""  next: [+ offset 1]]
            [if [= [band len-byte 0xC0] 0xC0]
              # Pointer: next byte gives offset (RFC 1035 §4.1.4)
              [block
                [ptr-offset: [band [uint16 NetworkEndian [slice b offset [+ offset 2]]] 0x3FFF]]
                [target: [parse-dns-name b ptr-offset [- ptr-depth 1]]]
                # next advances past the 2-byte pointer; pointer target's next is discarded
                [name: target.name  next: [+ offset 2]]]
              # Regular label
              [block
                [label-end: [+ offset 1 len-byte]]
                [label:     [bytes-str [slice b [+ offset 1] label-end]]]
                [rest:      [parse-dns-name b label-end ptr-depth]]
                [name: [if [= rest.name ""] label [str label "." rest.name]]
                 next: rest.next]]]]]]]]

  # RFC 1035 §4.1.3: parse RDATA for a given type, returning a dnsRecord.
  # b: full message (for name decompression); offset: start of RDATA; rdlength: length.
  parse-dns-rdata: [fn [let b@Bytes offset@Int rdlength@Int qtype@Int ttl@Duration]
    [data-end: [+ offset rdlength]]
    [match qtype
      1:  # A record — 4-byte IPv4 address (wire bytes are exactly IpAddress.Ipv4)
        [dnsRecord.ARecord  addr: [IpAddress.Ipv4 [slice b offset data-end]]  ttl: ttl]
      28: # AAAA record — 16-byte IPv6 address (wire bytes are exactly IpAddress.Ipv6)
        [dnsRecord.AAAARecord  addr: [IpAddress.Ipv6 [slice b offset data-end]]  ttl: ttl]
      5:  # CNAME — compressed name
        [name-res: [parse-dns-name b offset 5]]
        [dnsRecord.CNameRecord  name: name-res.name  ttl: ttl]
      15: # MX — preference(2) + name
        [pref: [uint16 NetworkEndian [slice b offset [+ offset 2]]]]
        [name-res: [parse-dns-name b [+ offset 2] 5]]
        [dnsRecord.MxRecord  pref: pref  name: name-res.name  ttl: ttl]
      2:  # NS — compressed name
        [name-res: [parse-dns-name b offset 5]]
        [dnsRecord.NsRecord  name: name-res.name  ttl: ttl]
      16: # TXT — series of length-prefixed strings
        [parse-txt: [fn [let pos acc]
          [if [>= pos data-end]
            acc
            [block
              [slen: [get b pos]]
              [s:    [slice b [+ pos 1] [+ pos 1 slen]]]
              [parse-txt [+ pos 1 slen] [append acc [list s]]]]]]]
        [dnsRecord.TxtRecord  strings: [parse-txt offset []]  ttl: ttl]
      12: # PTR — compressed name
        [name-res: [parse-dns-name b offset 5]]
        [dnsRecord.PtrRecord  name: name-res.name  ttl: ttl]
      33: # SRV — priority(2) weight(2) port(2) target
        [prio: [uint16 NetworkEndian [slice b offset [+ offset 2]]]]
        [wt:   [uint16 NetworkEndian [slice b [+ offset 2] [+ offset 4]]]]
        [port: [uint16 NetworkEndian [slice b [+ offset 4] [+ offset 6]]]]
        [name-res: [parse-dns-name b [+ offset 6] 5]]
        [dnsRecord.SrvRecord  prio: prio  weight: wt  port: port  target: name-res.name  ttl: ttl]
      6:  # SOA — mname rname serial refresh retry expire minimum
        [mname-res: [parse-dns-name b offset 5]]
        [rname-res: [parse-dns-name b mname-res.next 5]]
        [p: rname-res.next]
        [serial:  [@UInt32 [uint32 NetworkEndian [slice b p          [+ p 4]]]]]
        [refresh: [seconds [uint32 NetworkEndian [slice b [+ p 4]    [+ p 8]]]]]
        [retry:   [seconds [uint32 NetworkEndian [slice b [+ p 8]    [+ p 12]]]]]
        [expire:  [seconds [uint32 NetworkEndian [slice b [+ p 12]   [+ p 16]]]]]
        [minimum: [seconds [uint32 NetworkEndian [slice b [+ p 16]   [+ p 20]]]]]
        [dnsRecord.SoaRecord  mname: mname-res.name  rname: rname-res.name
                              serial: serial  refresh: refresh  retry: retry
                              expire: expire  minimum: minimum  ttl: ttl]
      65: # HTTPS (RFC 9460) — priority(2) target-name + SvcParams
        [prio: [uint16 NetworkEndian [slice b offset [+ offset 2]]]]
        [target-res: [parse-dns-name b [+ offset 2] 5]]
        # Parse SvcParams: each is key(2)+value-len(2)+value-bytes
        [parse-svcparams: [fn [let pos params]
          [if [>= pos data-end]
            params
            [block
              [key:     [uint16 NetworkEndian [slice b pos [+ pos 2]]]]
              [vlen:    [uint16 NetworkEndian [slice b [+ pos 2] [+ pos 4]]]]
              [vdata:   [slice b [+ pos 4] [+ pos 4 vlen]]]
              [new-params: [match key
                0:  [merge params {mandatory: [collect [map [fn [let i] [uint16 NetworkEndian [slice vdata [* i 2] [+ [* i 2] 2]]]] [range 0 [/ vlen 2]]]]}]
                1:  # alpn: comma-separated protocol strings
                    [block
                      [parse-alpn: [fn [let p acc]
                        [if [>= p vlen]
                          acc
                          [block
                            [alen: [get vdata p]]
                            [proto: [bytes-str [slice vdata [+ p 1] [+ p 1 alen]]]]
                            [parse-alpn [+ p 1 alen] [append acc [list proto]]]]]]]
                      [merge params {alpn: [parse-alpn 0 []]}]]
                3:  [merge params {port: [uint16 NetworkEndian vdata]}]
                5:  [merge params {ech: vdata}]
                _:  params]]
              [parse-svcparams [+ pos 4 vlen] new-params]]]]]
        [raw-params: [parse-svcparams target-res.next {}]]
        [params: [svcParams
          alpn:            [or [get? raw-params alpn] Absent.Absent]
          no-default-alpn: false
          port:            [or [get? raw-params port] Absent.Absent]
          ipv4-hint:       Absent.Absent
          ipv6-hint:       Absent.Absent
          ech:             [or [get? raw-params ech] Absent.Absent]
          mandatory:       [or [get? raw-params mandatory] Absent.Absent]
          other:           {}]]
        [dnsRecord.HttpsRecord  prio: prio  target: target-res.name  params: params  ttl: ttl]
      _:  # Unknown record type
        [dnsRecord.UnknownRecord  qtype: qtype  data: [slice b offset data-end]  ttl: ttl]]]

  # Parse N resource records starting at offset in b. Returns [records: [Seq dnsRecord] next: Int].
  parse-rrs: [fn [let b@Bytes offset@Int n@Int acc@[Seq dnsRecord]]
    [if [= n 0]
      [records: acc  next: offset]
      [block
        [name-res: [parse-dns-name b offset 5]]
        [p:        name-res.next]
        [rtype:    [uint16 NetworkEndian [slice b p          [+ p 2]]]]
        [rclass:   [uint16 NetworkEndian [slice b [+ p 2]    [+ p 4]]]]
        [ttl:      [seconds [uint32 NetworkEndian [slice b [+ p 4] [+ p 8]]]]]  # RFC 1035: TTL in seconds
        [rdlen:    [uint16 NetworkEndian [slice b [+ p 8]    [+ p 10]]]]
        [rdata-off: [+ p 10]]
        [rr:       [parse-dns-rdata b rdata-off rdlen rtype ttl]]
        [parse-rrs b [+ rdata-off rdlen] [- n 1] [append acc [list rr]]]]]]

  decode-dns-wire: [fn@[return: [or dnsResponse dnsError]] [let b@Bytes]
    [if [< [length b] 12]
      [dnsError.DecodeFailed "response too short"]
      [block
        [id:        [uint16 NetworkEndian [slice b 0 2]]
         flags:     [uint16 NetworkEndian [slice b 2 4]]
         qdcount:   [uint16 NetworkEndian [slice b 4 6]]
         ancount:   [uint16 NetworkEndian [slice b 6 8]]
         nscount:   [uint16 NetworkEndian [slice b 8 10]]
         arcount:   [uint16 NetworkEndian [slice b 10 12]]
         rcode-int: [band flags 0x000F]
         truncated: [= [band [shr flags 9] 1] 1]]
        [rcode: [or [get rcode: rcode-int dnsRcode] dnsRcode.ServFail]]
        # §4.1.2: Skip question section — each question is: name + qtype(2) + qclass(2)
        [skip-questions: [fn [let offset n]
          [if [= n 0]
            offset
            [block
              [name-res: [parse-dns-name b offset 5]]
              [skip-questions [+ name-res.next 4] [- n 1]]]]]]
        [after-q: [skip-questions 12 qdcount]]
        # §4.1.3: Parse answer, authority, additional sections
        [an-result: [parse-rrs b after-q ancount []]]
        [ns-result: [parse-rrs b an-result.next nscount []]]
        [ar-result: [parse-rrs b ns-result.next arcount []]]
        [dnsResponse.dnsResponse
          id:         id
          rcode:      rcode
          answers:    an-result.records
          authority:  ns-result.records
          additional: ar-result.records
          truncated:  truncated]]]]]

  # Encode all records in one section, threading the compression table and offset.
  # Returns {bytes: Bytes  offset: Int  table: [Map DnsName Int]}.
  encode-section: [fn [let records offset@Int table@[Map DnsName Int]]
    [reduce [fn [let acc r]
      [result: [encode-rr-compressed r acc.offset acc.table]]
      [offset: [+ acc.offset [length result.bytes]]
       table:  result.table
       bytes:  [concat acc.bytes result.bytes]]]
     [offset: offset  table: table  bytes: [bytes 0]]
     records]]

  encode-dns-response: [fn [let resp@DnsResponse]
    [rcode-int: resp.rcode.rcode]
    [header: [concat
      [bytes NetworkEndian [@UInt16 resp.id]]
      [bytes NetworkEndian [@UInt16 [bor 0x8080 rcode-int]]]
      [bytes NetworkEndian [@UInt16 0]]
      [bytes NetworkEndian [@UInt16 [length resp.answers]]]
      [bytes NetworkEndian [@UInt16 [length resp.authority]]]
      [bytes NetworkEndian [@UInt16 [length resp.additional]]]]]
    # Thread compression table across all three sections — cross-section compression works.
    [an: [encode-section resp.answers    [length header] []]]
    [ns: [encode-section resp.authority  an.offset       an.table]]
    [ar: [encode-section resp.additional ns.offset       ns.table]]
    [concat header an.bytes ns.bytes ar.bytes]]

  dns-udp-resolver: [fn [let cap@NetCap addr@SocketAddress]
    [fn [let q@DnsQuery]
      [task
        [sock: [udp-ephemeral cap]]
        [send sock addr [encode-dns-wire q]]
        [resp: [recv sock]]
        [match [decode-dns-wire resp.data]
          [Result.Ok r]:  r
          [Result.Error e]: [error [str "dns-udp: " e]]]]]]

  dns-tls-resolver: [fn [let cap@NetCap addr@SocketAddress sni@String]
    [fn [let q@DnsQuery]
      [task
        [tls: [[tcp-connect cap addr] | [tls-layer sni [alpn: []  ech: []  trust-roots: SystemRoots]]]]
        [dns-framed-send tls q]]]]

  dns-https-resolver: [fn [let cap@NetCap addr@SocketAddress sni@String path@String]
    [client: [http3-client [quic-connect cap addr
                             [sni: sni  alpn: ["h3"]  ech: []  trust-roots: SystemRoots]]]]
    [fn [let q@DnsQuery]
      [task [dns-https-send client q path]]]]

  dns-quic-resolver: [fn [let cap@NetCap addr@SocketAddress sni@String]
    [fn [let q@DnsQuery]
      [task
        [conn:   [quic-connect cap addr [sni: sni  alpn: ["doq"]  ech: []  trust-roots: SystemRoots]]]
        [stream: [quic-open-stream conn]]
        [dns-framed-send stream q]]]]

  dns-framed-send: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h q@DnsQuery]
    [wire: [encode-dns-wire q]]
    [write h [concat [bytes NetworkEndian [@UInt16 [length wire]]] wire]]
    [resp-len: [uint16 NetworkEndian [read h 2]]]
    [match [decode-dns-wire [read h resp-len]]
      [Result.Ok r]:    r
      [Result.Error e]: [error [str "dns-framed: " e]]]]

  ns-to-resolver: [fn [let cap@NetCap ns@Nameserver]
    [match ns
      [nameserver.UdpNameserver addr: addr]:                [dns-udp-resolver   cap addr]
      [nameserver.DotNameserver addr: addr  sni: sni]:      [dns-tls-resolver   cap addr sni]
      [nameserver.DohNameserver addr: addr  sni: sni  path: path]: [dns-https-resolver cap addr sni path]
      [nameserver.DoqNameserver addr: addr  sni: sni]:      [dns-quic-resolver  cap addr sni]]]

  # Re-exported from internal dict so callers have one import point.
  dns-query-with-retry: dns-query-with-retry

  # resolve-address: resolve an Address to an interleaved [Seq IpAddress] via Happy Eyeballs.
  # [Hostname h]: parallel A+AAAA with 50ms IPv6 head start, interleaved v6-first.
  # IpAddress variants: returned as a single-element list (no DNS needed).
  resolve-address: [fn [let cap@NetCap addr@Host]   # takes Host, not HostPort — used internally
    [match addr
      [Hostname.Hostname h]:
        [config: %dns]
        [if config.single-request
          [block
            [v6: [match [try [dns-resolve cap h DnsQtype.AAAA]] [Result.Ok a]: a [Result.Error _]: []]
             v4: [match [try [dns-resolve cap h DnsQtype.A]]    [Result.Ok a]: a [Result.Error _]: []]]
            [interleave v6 v4]]
          [block
            [v6-task: [task [dns-resolve cap h DnsQtype.AAAA]]
             v4-task: [task [dns-resolve cap h DnsQtype.A]]]
            [v6-first: [match [timeout [millis 50] v6-task] [Result.Ok a]: a [Result.Error _]: []]]
            [v4: [await v4-task]]
            [v6: [if [= [] v6-first]
              [match [try [await v6-task]] [Result.Ok a]: a [Result.Error _]: []]
              v6-first]]
            [interleave v6 v4]]]
      [let ip@IpAddress]: [list ip]]]

  # dns-resolve: resolve a hostname to IPs for a specific query type.
  # Returns [or [Seq IpAddress] DnsError] — callers pattern-match on the result.
  dns-resolve: [fn@[return: [or [Seq IpAddress] DnsError]] [let cap@NetCap host@String qtype@DnsQtype]
    [config: %dns]
    [if [empty? config.nameservers]
      dnsError.ServerFailure
      [dns-try-names cap config [candidate-names host config.search config.ndots] qtype]]]

  dns-server-loop: [fn@Task [let query-ch@[Channel DnsQuery]
                              handler@[Fn [DnsQuery] DnsResponse]]
    [drain [fn [let q] [task [q.respond [handler q]]]] query-ch]]

  dns-udp-server: [fn [let cap@NetCap port@Port]
    [sock: [udp-socket cap BindTarget.IpBind {addr: IpAddress.Ipv4 [0 0 0 0]  port: port}]]
    [out:  [channel 256]]
    [task
      [step: [fn []
        [dg: [recv sock]]
        [match [decode-dns-wire dg.data]
          [Result.Ok q]:
            [send out dnsQuery.dnsQuery
              id:        q.id         name:      q.name
              qtype:     q.qtype      recursive: q.recursive
              respond:   [fn [let resp@DnsResponse]
                [send sock dg.src [encode-dns-response resp]]]]
          [Result.Error _]: null]
        [step]]]
      [step]]
    out]

  # resolve-address: exported so callers can resolve without connecting.
  resolve-address: resolve-address

  # dns-resolve-host: resolve to IPv4 addresses (A records).
  # Returns [or [Seq IpAddress] DnsError].
  dns-resolve-host: [fn@[return: [or [Seq IpAddress] DnsError]] [let cap@NetCap host@String]
    [config: %dns]
    [if [empty? config.nameservers]
      dnsError.ServerFailure
      [dns-try-names cap config [candidate-names host config.search config.ndots] dnsQtype.A]]]
]

[instance Printable
  [let a@dnsName]:  [print: dns-name->string]]

[instance Printable
  [let a@dnsRcode]: [print: [fn [let rc] rc.description]]]

[instance Printable
  [let a@dnsOpcode]: [print: [fn [let op] op.description]]]

[instance Printable
  [let a@dnsClass]: [print: [fn [let cl] cl.description]]]

[instance Printable
  [let a@dnsExtendedError]: [print: [fn [let e] e.description]]]

# DnsRecordCodec: Codec dnsRecord ↔ full RR bytes (RFC 1035 §3.2.1) with name compression.
# encode: dnsRecord → compressed RR bytes (within-record compression, offset=0, fresh table)
# decode: compressed RR bytes → dnsRecord, using codec.msg for pointer decompression.
#         Pass msg=[bytes 0] or rr-bytes to decode single self-contained records.
# Round-trip: decode(DnsRecordCodec msg, encode(_, r)) = r for any dnsRecord r,
#             because single-record encoding uses within-record compression with no cross-record
#             pointers; the encoded bytes are self-contained and decode correctly with msg=rr-bytes.
[instance Codec
  [let a@DnsRecordCodec b@dnsRecord c@Bytes]: [encode: [fn [let _ r] [encode-rr r]]   # encode-rr uses encode-rr-compressed offset=0 table=[]
                                               decode: [fn [let codec rr-bytes@Bytes offset@Int]
                                                 [frame: [slice rr-bytes offset [length rr-bytes]]]
                                                 [msg:     [if [empty? codec.msg] frame codec.msg]]
                                                 [name-res: [parse-dns-name msg 0 5]]
                                                 [p:       name-res.next]
                                                 [rtype:   [uint16 NetworkEndian [slice frame p [+ p 2]]]]
                                                 [ttl-raw: [uint32 NetworkEndian [slice frame [+ p 4] [+ p 8]]]]
                                                 [rdlen:   [uint16 NetworkEndian [slice frame [+ p 8] [+ p 10]]]]
                                                 [value: [parse-dns-rdata msg [+ p 10] rdlen rtype [seconds ttl-raw]]
                                                  next:  [+ offset p 10 rdlen]]]]]

# Transport typeclass instances — live here because they need dns-resolve.
#
# connect is always used as the bottom of a protocol stack:
#   [connect %net [Hostname "db.internal"] Tcp 5432]
#     | [tls-layer cfg]
#     | [codec PostgresCodec]
#
# Happy Eyeballs applies universally to [Hostname h]:
#   Tcp — parallel A+AAAA, 50ms v6 head start, race connections with 250ms stagger.
#   Udp — same address resolution; pick first from interleaved list (no connection to race).

[instance Transport
  [let h@Tcp]: [connect: [fn [let cap@NetCap _@Tcp ep@HostPort]
    [addr: ep.host  port: ep.port]
    # TcpHandle wraps the original addr (for SNI inference etc.) + a lazy stream thunk.
    # The stream thunk evaluates on first read/write; tinct memoizes the result.
    [TcpHandle
      [addr: addr  port: port
       stream:
         # Resolve address then race TCP connections (Happy Eyeballs: 250ms stagger).
         [addrs: [resolve-address cap addr]]
         [if [empty? addrs] [error "connect: no addresses resolved"] null]
         [result-ch:  [channel 1]
          attempt-ms: 250]
         [tasks: [collect [map [fn [let e]
           [i: e.0  ip: e.1]
           [task
             [recv [timer-channel %clock [millis [* i attempt-ms]]]]
             [match [try [tcp-connect cap {addr: ip  port: [@Port port]}]]
               [Result.Ok h]:    [try [send result-ch h]]
               [Result.Error _]: null]]]
           [entries addrs]]]]
         [match [recv result-ch]
           [Closed.Closed]: [error [str "connect: all TCP attempts failed for " [str addr]]]
           [Result.Ok h]:
             [par-map [fn [let t] [cancel-task t]] tasks]
             h]]]]]]

[instance Transport
  [let h@Udp]: [connect: [fn [let cap@NetCap _@Udp ep@HostPort]
    [addr: ep.host  port: ep.port]
    [addrs: [resolve-address cap addr]]
    [if [empty? addrs] [error "connect: no addresses resolved"] null]
    [peer: {addr: [get addrs 0]  port: [@Port port]}]
    ConnectedUdp
      sock: [udp-socket cap BindTarget.IpBind {addr: IpAddress.Ipv4 [0 0 0 0]  port: 0}]
      peer: peer]]]
