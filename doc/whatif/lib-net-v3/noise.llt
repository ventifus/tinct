# stdlib/protocols/noise.llt — Generic Noise Protocol Framework (noiseprotocol.org).
# Part of: lib-net-v3
# Rust primitives: x25519-keypair, x25519-dh, chacha20-poly1305-seal/open, sha256
--- uses: ["crypto"]

[include %libdir "net.llt"]
[include %libdir "crypto.llt"]   # for HkdfHash (used in NoiseConfig.hash field)

[instance@[bind: [h]] ByteStream
  [let s@[NoiseConnection h]]: [read:  noise-read
                                 write: noise-write]]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  noise-hash: [fn [let data@Bytes] [sha256 data]]

  noise-init-h: [fn [let protocol-name@String]
    [name-bytes: [str-bytes protocol-name]]
    [if [<= [length name-bytes] 32]
      [concat name-bytes [bytes-zero [- 32 [length name-bytes]]]]
      [noise-hash name-bytes]]]

  mix-hash: [fn [let h@[Bytes 32] data@Bytes]
    [noise-hash [concat h data]]]

  # Returns updated NoiseState with new ck and k per Noise spec §5.2.
  # Single 64-byte HKDF-Expand call per RFC 5869: T(1)||T(2) → slice into two 32-byte keys.
  # Two separate calls would produce T(1) and HMAC(PRK, 0x01||0x01), not T(1) and T(2).
  mix-key: [fn [let state@NoiseState input@[Bytes 32]]
    [prk:    [hkdf-extract [Sha256] state.ck input]]
    [both:   [hkdf-expand  [Sha256] prk [] 64]]
    [new-ck: [slice 0  32 both]]
    [new-k:  [slice 32 64 both]]
    [NoiseState [s: state.s  e: state.e  rs: state.rs  re: state.re
                 ck: new-ck  h: state.h  k: new-k  n: 0]]]

  encrypt-and-hash: [fn [let state@NoiseState plaintext@Bytes]
    [if [absent? state.k]
      [ciphertext: plaintext   new-h: [mix-hash state.h plaintext]]
      [block
        [nonce12:    [noise-nonce state.n]]
        [ciphertext: [chacha20-poly1305-seal state.k nonce12 plaintext state.h]]
        [new-h:      [mix-hash state.h ciphertext]]]]
    [ciphertext: ciphertext  new-h: new-h  new-n: [+ state.n 1]]]

  decrypt-and-hash: [fn [let state@NoiseState ciphertext@Bytes]
    [if [absent? state.k]
      [plaintext: ciphertext  new-h: [mix-hash state.h ciphertext]  new-n: state.n]
      [block
        [nonce12:  [noise-nonce state.n]]
        [match [chacha20-poly1305-open state.k nonce12 ciphertext state.h]
          [Result.Ok p]:
            [new-h: [mix-hash state.h ciphertext]]
            [plaintext: p  new-h: new-h  new-n: [+ state.n 1]]
          [Result.Error _]: [error "Noise: decryption failed"]]]]

  # Noise spec §12: ChaCha20-Poly1305 nonce = 32 zero bits || little-endian 64-bit n.
  noise-nonce: [fn [let n@NoiseNonce]
    [concat [0 0 0 0] [bytes ByteOrder.LittleEndian n]]]  # n: NoiseNonce (ByteOrder.LittleEndian per Noise spec §12)

  # noise-split: derive send/recv keys per Noise spec §5.2 HKDF(state.ck, empty, 2).
  # Single 64-byte expand per RFC 5869: T(1)||T(2); T(2) = HMAC(PRK, T(1)||0x02).
  noise-split: [fn [let state@NoiseState initiator@Bool]
    [both: [hkdf-expand [Sha256] state.ck [] 64]]
    [k1:   [slice 0  32 both]]
    [k2:   [slice 32 64 both]]
    [if initiator [send-key: k1  recv-key: k2]
                  [send-key: k2  recv-key: k1]]]

  # Noise_XX: mutual authentication, both parties learn each other's static keys.
  # Initiator (connect): → e  ← e,ee,s,es  → s,se
  # Each message: encrypt-and-hash payload bytes + update handshake state.
  # State init: h = hash(protocol-name), ck = h, prologue mixed in.
  noise-xx-connect: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h cfg@NoiseConfig]
    [protocol-name: [str "Noise_" NoisePattern.XX.name "_25519_ChaChaPoly_SHA256"]]
    [state: [NoiseState
      s: cfg.private-key  e: Absent.Absent  rs: Absent.Absent  re: Absent.Absent
      ck: [noise-init-h protocol-name]
      h:  [noise-init-h protocol-name]
      k:  Absent.Absent  n: 0]]
    [state: [mix-hash state cfg.prologue]]
    # → e: send ephemeral public key
    [eph: [x25519-keypair]]
    [state: [mix-hash state eph.public]]
    [write h eph.public]
    # ← e,ee,s,es: receive peer ephemeral, DH, receive peer static encrypted, DH
    [re-bytes: [read h 32]]  # peer ephemeral public
    [state: [mix-hash state re-bytes]]
    [state: [mix-key state [x25519-dh eph.private re-bytes]]]  # ee
    [s-enc: [read h [+ 32 16]]]   # encrypted peer static (32) + AEAD tag (16)
    [rs-result: [decrypt-and-hash state s-enc]]
    [rs-bytes: rs-result.ciphertext  state: [merge state rs-result]]
    [state: [mix-key state [x25519-dh eph.private rs-bytes]]]   # es
    # → s,se: send our static key encrypted + DH
    [s-enc2: [encrypt-and-hash state cfg.public-key].ciphertext]
    [write h s-enc2]
    [state: [mix-key state [x25519-dh cfg.private-key re-bytes]]]   # se
    # Split: derive send/recv keys
    [keys: [noise-split state true]]
    [send-ch: [init-nonce-ch]  recv-ch: [init-nonce-ch]]
    [NoiseConnection underlying: h  send-key: keys.send-key  recv-key: keys.recv-key
                     send-n: send-ch  recv-n: recv-ch]]

  noise-xx-accept: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h cfg@NoiseConfig]
    # Mirror of xx-connect: ← e  → e,ee,s,es  ← s,se
    # Responder state init: h = hash(protocol-name), ck = h, prologue mixed in.
    [protocol-name: [str "Noise_" NoisePattern.XX.name "_25519_ChaChaPoly_SHA256"]]
    [state: [NoiseState
      s: cfg.private-key  e: Absent.Absent  rs: Absent.Absent  re: Absent.Absent
      ck: [noise-init-h protocol-name]
      h:  [noise-init-h protocol-name]
      k:  Absent.Absent  n: 0]]
    [state: [mix-hash state cfg.prologue]]
    # ← e: receive initiator ephemeral public key
    [re-bytes: [read h 32]]
    [state: [mix-hash state re-bytes]]
    # → e,ee,s,es: send our ephemeral, DH(ee), send our static encrypted, DH(es)
    [eph: [x25519-keypair]]
    [state: [mix-hash state eph.public]]
    [write h eph.public]
    [state: [mix-key state [x25519-dh eph.private re-bytes]]]   # ee
    [s-enc: [encrypt-and-hash state cfg.public-key].ciphertext]
    [write h s-enc]
    [state: [mix-key state [x25519-dh cfg.private-key re-bytes]]]   # es
    # ← s,se: receive initiator static encrypted + DH(se)
    [rs-enc: [read h [+ 32 16]]]   # encrypted initiator static (32) + AEAD tag (16)
    [rs-result: [decrypt-and-hash state rs-enc]]
    [rs-bytes: rs-result.ciphertext  state: [merge state rs-result]]
    [state: [mix-key state [x25519-dh eph.private rs-bytes]]]   # se
    # Split: derive send/recv keys (responder is NOT initiator, so keys are swapped)
    [keys: [noise-split state false]]
    [send-ch: [init-nonce-ch]  recv-ch: [init-nonce-ch]]
    [NoiseConnection underlying: h  send-key: keys.send-key  recv-key: keys.recv-key
                     send-n: send-ch  recv-n: recv-ch]]

  # Noise_IK: initiator knows responder's static key. More efficient than XX.
  # Initiator: → e,es,s,ss  ← e,ee,se
  noise-ik-connect: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h cfg@NoiseConfig]
    # Requires cfg.remote-key to be set (responder's known static public key)
    [match cfg.remote-key
      [Absent.Absent]: [error "noise-ik-connect: remote-key required for IK pattern"]
      [let rs]:
        # State init: h = hash(protocol-name), ck = h, prologue mixed in.
        [protocol-name: [str "Noise_" NoisePattern.IK.name "_25519_ChaChaPoly_SHA256"]]
        [state: [NoiseState
          s: cfg.private-key  e: Absent.Absent  rs: rs  re: Absent.Absent
          ck: [noise-init-h protocol-name]
          h:  [noise-init-h protocol-name]
          k:  Absent.Absent  n: 0]]
        [state: [mix-hash state cfg.prologue]]
        # Mix responder static key into h (IK initiator knows rs at start)
        [state: [mix-hash state rs]]
        # → e,es,s,ss: send ephemeral, DH(es), send static encrypted, DH(ss)
        [eph: [x25519-keypair]]
        [state: [mix-hash state eph.public]]
        [write h eph.public]
        [state: [mix-key state [x25519-dh eph.private rs]]]   # es
        [s-enc: [encrypt-and-hash state cfg.public-key].ciphertext]
        [write h s-enc]
        [state: [mix-key state [x25519-dh cfg.private-key rs]]]   # ss
        # PSK injection for IKpsk2: mix PSK after ss if present (Noise spec §9.2)
        [state: [match cfg.psk
          [Absent.Absent]: state
          [let psk]: [mix-key state psk]]]
        # ← e,ee,se: receive responder ephemeral, DH(ee), DH(se)
        [re-bytes: [read h 32]]
        [state: [mix-hash state re-bytes]]
        [state: [mix-key state [x25519-dh eph.private re-bytes]]]   # ee
        [state: [mix-key state [x25519-dh cfg.private-key re-bytes]]]   # se
        # Split: derive send/recv keys
        [keys: [noise-split state true]]
        [send-ch: [init-nonce-ch]  recv-ch: [init-nonce-ch]]
        [NoiseConnection underlying: h  send-key: keys.send-key  recv-key: keys.recv-key
                         send-n: send-ch  recv-n: recv-ch]]]

  noise-ik-accept: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h cfg@NoiseConfig]
    # Mirror of ik-connect: ← e,es,s,ss  → e,ee,se
    # State init
    [protocol-name: [str "Noise_" NoisePattern.IK.name "_25519_ChaChaPoly_SHA256"]]
    [state: [NoiseState
      s: cfg.private-key  e: Absent.Absent  rs: Absent.Absent  re: Absent.Absent
      ck: [noise-init-h protocol-name]
      h:  [noise-init-h protocol-name]
      k:  Absent.Absent  n: 0]]
    [state: [mix-hash state cfg.prologue]]
    # Mix our static public key into h (IK: responder knows its own key is known)
    [state: [mix-hash state cfg.public-key]]
    # ← e,es,s,ss: receive initiator ephemeral, DH(es), receive encrypted static, DH(ss)
    [re-bytes: [read h 32]]
    [state: [mix-hash state re-bytes]]
    [state: [mix-key state [x25519-dh cfg.private-key re-bytes]]]   # es (responder: dh(s, re))
    [rs-enc: [read h [+ 32 16]]]   # encrypted initiator static (32) + tag (16)
    [rs-result: [decrypt-and-hash state rs-enc]]
    [rs-bytes: rs-result.ciphertext  state: [merge state rs-result]]
    [state: [mix-key state [x25519-dh cfg.private-key rs-bytes]]]   # ss
    # PSK injection for IKpsk2 (responder side)
    [state: [match cfg.psk
      [Absent.Absent]: state
      [let psk]: [mix-key state psk]]]
    # → e,ee,se: send our ephemeral, DH(ee), DH(se)
    [eph: [x25519-keypair]]
    [state: [mix-hash state eph.public]]
    [write h eph.public]
    [state: [mix-key state [x25519-dh eph.private re-bytes]]]   # ee
    [state: [mix-key state [x25519-dh eph.private rs-bytes]]]   # se (responder: dh(e, rs))
    # Split: derive send/recv keys (responder is NOT initiator)
    [keys: [noise-split state false]]
    [send-ch: [init-nonce-ch]  recv-ch: [init-nonce-ch]]
    [NoiseConnection underlying: h  send-key: keys.send-key  recv-key: keys.recv-key
                     send-n: send-ch  recv-n: recv-ch]]

  # Noise_NK: no static key for initiator (server auth only).
  # Initiator: → e,es  ← e,ee
  noise-nk-connect: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h cfg@NoiseConfig]
    [match cfg.remote-key
      [Absent.Absent]: [error "noise-nk-connect: remote-key (server static) required for NK pattern"]
      [let rs]:
        # State init: h = hash(protocol-name), ck = h, prologue mixed in.
        [protocol-name: [str "Noise_" NoisePattern.NK.name "_25519_ChaChaPoly_SHA256"]]
        [state: [NoiseState
          s: Absent.Absent  e: Absent.Absent  rs: rs  re: Absent.Absent
          ck: [noise-init-h protocol-name]
          h:  [noise-init-h protocol-name]
          k:  Absent.Absent  n: 0]]
        [state: [mix-hash state cfg.prologue]]
        # Mix responder static key into h (NK: initiator knows rs at start)
        [state: [mix-hash state rs]]
        # → e,es: send ephemeral public key, DH(es) with responder static
        [eph: [x25519-keypair]]
        [state: [mix-hash state eph.public]]
        [write h eph.public]
        [state: [mix-key state [x25519-dh eph.private rs]]]   # es
        # ← e,ee: receive responder ephemeral, DH(ee)
        [re-bytes: [read h 32]]
        [state: [mix-hash state re-bytes]]
        [state: [mix-key state [x25519-dh eph.private re-bytes]]]   # ee
        # Split: derive send/recv keys (initiator)
        [keys: [noise-split state true]]
        [send-ch: [init-nonce-ch]  recv-ch: [init-nonce-ch]]
        [NoiseConnection underlying: h  send-key: keys.send-key  recv-key: keys.recv-key
                         send-n: send-ch  recv-n: recv-ch]]]

  noise-nk-accept: [fn@[bind: [h]  constraint: [h: ByteStream]] [let h@h cfg@NoiseConfig]
    # Mirror of nk-connect: ← e,es  → e,ee
    # State init
    [protocol-name: [str "Noise_" NoisePattern.NK.name "_25519_ChaChaPoly_SHA256"]]
    [state: [NoiseState
      s: cfg.private-key  e: Absent.Absent  rs: Absent.Absent  re: Absent.Absent
      ck: [noise-init-h protocol-name]
      h:  [noise-init-h protocol-name]
      k:  Absent.Absent  n: 0]]
    [state: [mix-hash state cfg.prologue]]
    # Mix our static public key into h (NK: responder's static key is known a priori)
    [state: [mix-hash state cfg.public-key]]
    # ← e,es: receive initiator ephemeral, DH(es) with our static key
    [re-bytes: [read h 32]]
    [state: [mix-hash state re-bytes]]
    [state: [mix-key state [x25519-dh cfg.private-key re-bytes]]]   # es (responder: dh(s, re))
    # → e,ee: send our ephemeral, DH(ee)
    [eph: [x25519-keypair]]
    [state: [mix-hash state eph.public]]
    [write h eph.public]
    [state: [mix-key state [x25519-dh eph.private re-bytes]]]   # ee
    # Split: derive send/recv keys (responder is NOT initiator)
    [keys: [noise-split state false]]
    [send-ch: [init-nonce-ch]  recv-ch: [init-nonce-ch]]
    [NoiseConnection underlying: h  send-key: keys.send-key  recv-key: keys.recv-key
                     send-n: send-ch  recv-n: recv-ch]]

  # Accumulation loop for noise-read — reads whole Noise transport frames until
  # `remaining` bytes are collected. Noise frames may be shorter than `wanted`.
  noise-read-acc: [fn [let conn@NoiseConnection remaining@Int acc@[Seq Bytes]]
    [if [= remaining 0]
      [reduce concat [] acc]
      [block
        [len: [uint16 ByteOrder.BigEndian [read conn.underlying 2]]]
        [ct: [read conn.underlying len]]
        # recv-n channel holds exactly one value (atomic counter). Closed.Closed is impossible.
        [match [recv conn.recv-n]
          [Closed.Closed]: [error "Noise: recv-n channel closed unexpectedly"]
          [Result.Ok n]:
            [send conn.recv-n [+ n 1]]
            [plain: [match [chacha20-poly1305-open conn.recv-key [noise-nonce n] ct []]
              [Result.Ok p]:    p
              [Result.Error _]: [error "Noise: decryption failed"]]]
            [got: [min remaining [length plain]]]
            [noise-read-acc conn [- remaining got] [append [list [slice 0 got plain]] acc]]]]]]]

  init-nonce-ch: [fn []
    [ch: [channel 1]]
    [send ch 0]
    ch]

  bytes-zero: [fn [let n@Int]
    [reduce [fn [let acc _] [concat acc [bytes 0]]] [] [range 0 n]]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # Named domain type for ChaCha20-Poly1305 nonce counters per Noise spec §12.
  # Nonce = 32 zero bits || little-endian 64-bit counter (ChaCha20-Poly1305, RFC 7539).
  NoiseNonce: [type UInt64@[encoding: ByteOrder.LittleEndian]]

  NoisePattern: [type
    [XX     name: "XX"]
    [IK     name: "IK"]
    [IKpsk2 name: "IKpsk2"]
    [NK     name: "NK"]
    [XK     name: "XK"]
    [KK     name: "KK"]
    [IX     name: "IX"]]

  # DH algorithm selector (currently only X25519 is supported).
  NoiseDh: [type [X25519]]

  # Symmetric cipher selector for Noise transport messages.
  NoiseCipher: [type [ChaChaPoly] [AESGCM]]

  NoiseConfig: [type
    [pattern:    NoisePattern
     dh:         NoiseDh
     cipher:     NoiseCipher
     hash:       HkdfHash                # from crypto.llt (included above)
     private-key:[Bytes 32]
     public-key: [Bytes 32]
     remote-key: [or [Bytes 32] Absent]  # Absent = not required by pattern (e.g. XX)
     psk:        [or [Bytes 32] Absent]  # Absent = non-PSK pattern; [Bytes 32] = pre-shared key
     prologue:   Bytes]]

  NoiseState: [type
    [s:  [or [Bytes 32] Absent]   # local static key pair (present after s is set)
     e:  [or [Bytes 32] Absent]   # local ephemeral key pair
     rs: [or [Bytes 32] Absent]   # remote static public key
     re: [or [Bytes 32] Absent]   # remote ephemeral public key
     ck: [Bytes 32]               # chaining key
     h:  [Bytes 32]               # handshake hash
     k:  [or [Bytes 32] Absent]   # cipher key; Absent = no encryption yet (before mix-key)
     n:  NoiseNonce]]             # nonce counter; Noise spec §12: 64-bit little-endian

  # NoiseConnection is parametric over its underlying ByteStream h so Noise
  # can be stacked over any stream (Handle, TlsConnection, etc.).
  # send-n and recv-n are separate nonce counters — one writer per direction.
  NoiseConnection: [type [h]   # h must satisfy ByteStream; enforced at instance sites
    [underlying: h
     send-key:   [Bytes 32]
     recv-key:   [Bytes 32]
     send-n:     [Channel NoiseNonce]   # 64-bit nonce counter (Noise spec §12)
     recv-n:     [Channel NoiseNonce]]]

  # NoiseTransportCodec: Bytes ↔ encrypted framed Bytes at the Noise transport layer.
  # Carries the NoiseConnection for send/recv keys and nonce counters.
  # encode: plaintext Bytes → 2-byte-length-prefixed AEAD ciphertext Bytes (noise-write format)
  # decode: framed ciphertext Bytes → decrypted plaintext Bytes (noise-read format)
  # Input/output are both Bytes — the codec sits at the plaintext/ciphertext boundary.
  NoiseTransportCodec: [type [h] [conn: [NoiseConnection h]]]

  noise-accept: [fn@[bind: [h]  return: [NoiseConnection h]  constraint: [h: ByteStream]] [let cfg@NoiseConfig h@h]
    [match cfg.pattern
      [NoisePattern.XX]:     [noise-xx-accept h cfg]
      [NoisePattern.IK]:     [noise-ik-accept h cfg]
      [NoisePattern.IKpsk2]: [noise-ik-accept h cfg]   # PSK injected via cfg.psk
      [NoisePattern.NK]:     [noise-nk-accept h cfg]
      _:                     [error [str "noise: pattern " [tag-of cfg.pattern] " not yet implemented (supported: XX IK IKpsk2 NK)"]]]]

  noise: [fn@[bind: [h]  return: [NoiseConnection h]  constraint: [h: ByteStream]] [let cfg@NoiseConfig h@h]
    [match cfg.pattern
      [NoisePattern.XX]:     [noise-xx-connect h cfg]
      [NoisePattern.IK]:     [noise-ik-connect h cfg]
      [NoisePattern.IKpsk2]: [noise-ik-connect h cfg]   # PSK injected via cfg.psk
      [NoisePattern.NK]:     [noise-nk-connect h cfg]
      _:                     [error [str "noise: pattern " [tag-of cfg.pattern] " not yet implemented (supported: XX IK IKpsk2 NK)"]]]]

  # Transport messages: 2-byte length prefix | ciphertext (includes 16-byte poly tag).
  noise-write: [fn [let conn@NoiseConnection data@Bytes]
    # send-n channel holds exactly one value (atomic counter). Closed.Closed is impossible.
    [match [recv conn.send-n]
      [Closed.Closed]: [error "Noise: send-n channel closed unexpectedly"]
      [Result.Ok n]:
        [send conn.send-n [+ n 1]]
        [ct: [chacha20-poly1305-seal conn.send-key [noise-nonce n] data []]]
        [write conn.underlying [concat [bytes ByteOrder.BigEndian [@UInt16 [length ct]]] ct]]]]

  noise-read: [fn [let conn@NoiseConnection wanted@Int]
    [noise-read-acc conn wanted []]]
]

# NoiseTransportCodec: plaintext Bytes ↔ framed ciphertext Bytes (Noise transport layer).
# encode: encrypts plaintext with send-key/send-n; prepends 2-byte length; returns framed ciphertext.
# decode: reads 2-byte length prefix from data, decrypts with recv-key/recv-n; returns plaintext.
# Nonce counters in conn advance atomically on each encode/decode call.
[instance@[bind: [h]] Codec
  [let c@[NoiseTransportCodec h] i@Bytes o@Bytes]:
  [encode: [fn [let codec@[NoiseTransportCodec h] plaintext@Bytes]
    [conn: codec.conn]
    [match [recv conn.send-n]
      [Closed.Closed]: [error "NoiseTransportCodec.encode: send-n channel closed"]
      [Result.Ok n]:
        [send conn.send-n [+ n 1]]
        [ct: [chacha20-poly1305-seal conn.send-key [noise-nonce n] plaintext []]]
        [concat [bytes ByteOrder.BigEndian [@UInt16 [length ct]]] ct]]]
  decode: [fn [let codec@[NoiseTransportCodec h] data@Bytes]
    [conn:  codec.conn]
    [ct-len: [uint16 ByteOrder.BigEndian [slice data 0 2]]]
    [ct:     [slice data 2 [+ 2 ct-len]]]
    [match [recv conn.recv-n]
      [Closed.Closed]: [error "NoiseTransportCodec.decode: recv-n channel closed"]
      [Result.Ok n]:
        [send conn.recv-n [+ n 1]]
        [match [chacha20-poly1305-open conn.recv-key [noise-nonce n] ct []]
          [Result.Ok p]:    p
          [Result.Error _]: [error "NoiseTransportCodec.decode: decryption failed"]]]]]]

# ── NoiseLayer typeclass — bidirectional noise ────────────────────────────────

[class [let NoiseLayer input output]
  noise: [Fn@output [NoiseConfig input]]]

[instance@[bind: [h]  constraint: [h: ByteStream]] NoiseLayer
  [let a@h b@[NoiseConnection h]]:
  [noise: [fn [let cfg@NoiseConfig h@h] [noise-accept cfg h]]]]

[instance@[bind: [h]  constraint: [h: ByteStream]] NoiseLayer
  [let a@[Channel h] b@[Channel [NoiseConnection h]]]:
  [noise: [fn [let cfg@NoiseConfig ch@[Channel h]]
    [channel-map [fn [let s@h] [noise-accept cfg s]] ch]]]]
