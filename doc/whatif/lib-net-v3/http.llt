# stdlib/protocols/http.llt — High-level HTTP: http-channel, fetch, middleware.
# Part of: lib-net-v3

[include %libdir "net.llt"]
[include %libdir "serve.llt"]
[include %libdir "compress.llt"]
[include %libdir "protocols/dns.llt"]   # for resolve, lookup-ips, resolve-address
[include %include-dir "http1.llt"]
[include %include-dir "http2.llt"]
[include %include-dir "http3.llt"]
[include %include-dir "tls13.llt"]

# ── Internal. ────────────────────────────────────────────────────────────────────────────────────

[
  # Alias the prelude async `timeout` before the public dict's `timeout` middleware shadows it.
  async-timeout:   timeout

  # SvcParams fields are accessed directly: sm.params.alpn, sm.params.port, etc.
  # No helper functions needed — the record type encodes the structure.

  http-protocol-race: [fn [let cap@NetCap host@String port@Int
                            alpn@[Seq String] addrs@[Seq IpAddress] ech@Bytes]
    [result-ch: [channel 1]
     h3?:       [any? [fn [let p] [= p "h3"]] alpn]
     h2?:       [any? [fn [let p] [= p "h2"]] alpn]]
    [h3-tasks: [if h3?
      [collect [map [fn [let e]
        [i: e.0  addr: e.1]
        [task
          [recv [timer-channel %clock [millis [* i 250]]]]
          [match [try [quic-h3-connect cap host addr port ech]]
            [Result.Ok h]:    [try [send result-ch h]]
            [Result.Error _]: null]]]
       [entries addrs]]] []]]
    [h2-tasks: [if h2?
      [collect [map [fn [let e]
        [i: e.0  addr: e.1]
        [task
          [recv [timer-channel %clock [millis [+ [if h3? 250 0] [* i 250]]]]]
          [match [try [tcp-h2-connect cap host addr port ech]]
            [Result.Ok h]:    [try [send result-ch h]]
            [Result.Error _]: null]]]
       [entries addrs]]] []]]
    [match [recv result-ch]
      [Closed.Closed]: [error "http-connect: all protocol connection attempts failed"]
      [Result.Ok result]:
        [par-map [fn [let t] [cancel-task t]] [append h3-tasks h2-tasks]]
        result]]

  quic-h3-connect: [fn [let cap@NetCap sni@String addr@IpAddress port@Int ech@Bytes]
    [quic-connect cap [addr: addr  port: [@Port port]]
                  [sni: sni  alpn: ["h3"]  ech: ech  trust-roots: SystemRoots]]]

  # tls-with-sni: wrap a TcpHandle into a TlsHandle with explicit SNI.
  # Used when the TcpHandle.addr is an IP address (from SVCB IP hints) so automatic
  # SNI inference from [Hostname h] is unavailable. Subject-last: TcpHandle is last.
  # The handshake fires later when tls-commit is called (by h2, h3, or tls-commit directly).
  tls-with-sni: [fn [let sni@String alpn@[Seq String] ech@Bytes trust-roots h@TcpHandle]
    [TlsHandle [handle: h  sni: sni  alpn: alpn  ech: ech  trust-roots: trust-roots]]]

  tcp-h2-connect: [fn [let cap@NetCap sni@String addr@IpAddress port@Int ech@Bytes]
    [tcp-connect cap [addr: addr  port: [@Port port]]]
      | [tls-with-sni sni ["h2"] ech SystemRoots]
      | tls-commit]

  scheme-default-port: [fn [let scheme@String]
    [match scheme "https": 443  "http": 80  _: 443]]

  # max-decompressed: ceiling on decompressed output size (bytes).
  # Default 256 MB. Enforced by the Rust builtins (builtin-gzip-decode etc.)
  # which error if decompressed output would exceed the limit — prevents zip bombs.
  # codec-for-encoding returns a CompressedCodec whose decode field closes over the limit.
  decompress-response: [fn [let resp@RawResponse  max-decompressed@[type: Int  default: 268435456]]
    [ce: [get? resp.headers "content-encoding"]]
    [body:
      [match [codec-for-encoding [or ce "identity"]]
        [let c@CompressedCodec]:
          [if [= c.name "identity"]
            resp.body
            [match [try [c.decode resp.body]] [Result.Ok b]: b [Result.Error _]: resp.body]]
        null: resp.body]]
    [if [= body resp.body]
      resp
      [RawResponse [status: resp.status  headers: resp.headers  body: body]]]]
]

# ── Public API. ───────────────────────────────────────────────────────────────────────────────────

[
  # HTTP error type — callers distinguish application-level failures from transport failures.
  # Transport failures (TCP, TLS, DNS) surface as NetError or TlsError from the connect layer.
  HttpError: [type
    [StatusError      status@Int  body@Bytes]   # 4xx/5xx response; body may contain error detail
    [ProtocolError    reason@String]             # HTTP/2 or HTTP/3 framing violation
    [TooManyRedirects url@Url]                  # redirect loop or depth limit exceeded
    [InvalidResponse  reason@String]]            # unparseable response (truncated, corrupt, etc.)

  SvcbRecord: [type
    [AliasMode  target@String]           # SvcPriority=0 (RFC 9460 §3): redirect to target
    [ServiceMode                         # SvcPriority>0: connection hints
      priority@Int                       # lower = more preferred when multiple records exist
      target@[or String Absent]          # Absent/"." = use original QNAME (RFC 9460 §2.5.2)
      params@SvcParams                   # fully-typed SvcParams — access via params.alpn etc.
      other@[Map Int Bytes]]]            # unknown SvcParamKeys not in the known set (1,3,4,5,6)

  http-channel:  [fn [let cap@NetCap port@Port]
    [http1-serve [tcp-listen-port cap port]]]

  https-channel: [fn [let cap@NetCap port@Port cert@TlsServerConfig]
    [http1-serve [[tcp-listen-port cap port] | [tls-serve cert]]]]

  resolve-svcb: [fn [let cap@NetCap host@String depth@Int]
    [if [> depth 3]
      null
      [match [try [await [task [resolve cap DnsQtype.HTTPS host]]]]
        [Result.Ok resp]:
          [records: resp.answers]
          # RFC 9460 §3: AliasMode = prio 0; ServiceMode = prio > 0.
          # When multiple ServiceMode records exist, sort by priority (lowest first).
          [aliases:  [filter [fn [let r] [match r [dnsRecord.HttpsRecord prio: 0]: true _: false]] records]]
          [services: [filter [fn [let r] [match r [dnsRecord.HttpsRecord prio: p]: [> p 0] _: false]] records]]
          [if [not [empty? aliases]]
            # Follow the first AliasMode redirect (depth-limited)
            [match [get aliases 0]
              [dnsRecord.HttpsRecord target: target]: [resolve-svcb cap target [+ depth 1]]]
            # Return the highest-priority (lowest prio number) ServiceMode record
            [best: [reduce [fn [let a b]
              [match [a [b]]
                [[dnsRecord.HttpsRecord prio: pa] [dnsRecord.HttpsRecord prio: pb]]:
                  [if [<= pa pb] a b]]]
              [get services 0] services]]
            [match best
              [dnsRecord.HttpsRecord prio: prio  target: target  params: params]:
                # RFC 9460 §8: verify mandatory param compliance before accepting ServiceMode record
                # Known SvcParamKeys: 1=alpn, 3=port, 4=ipv4hint, 5=ech, 6=ipv6hint
                [known-keys: [1 3 4 5 6]]
                # params.mandatory is [or [Seq Int] Absent] — Absent means no mandatory keys.
                [mandatory-valid?: [match params.mandatory
                  [Absent.Absent]: true
                  [let mkeys]:     [all? [fn [let key] [any? [fn [let k] [= key k]] known-keys]] mkeys]]]
                [if mandatory-valid?
                  SvcbRecord.ServiceMode
                    priority: prio
                    target:   [if [or [= target "."] [= target ""]] Absent.Absent target]
                    params:   params
                    other:    params.other   # pass through unknown SvcParams from dns.llt parsing
                  # Mandatory param violation — skip this record and fall through
                  null]]
        [Result.Error _]: null]]]

  http-connect: [fn [let cap@NetCap host@String port@Int]
    [svcb-task: [task [resolve-svcb cap host 0]]
     v6-task:   [task [lookup-ips cap DnsQtype.AAAA host]]
     v4-task:   [task [lookup-ips cap DnsQtype.A    host]]]
    [svcb: [match [async-timeout [millis 50] svcb-task]
      [Result.Ok r]: r  [Result.Error _]: null]]
    [match svcb
      [let sm: SvcbRecord.ServiceMode]:
        [p: sm.params]
        # Use IP hints to skip A/AAAA round-trips; fall back to DNS if absent
        [v6: [match p.ipv6-hint
          [Absent.Absent]: [match [try [await v6-task]] [Result.Ok a]: a [Result.Error _]: []]
          [let hints]:     [map IpAddress.Ipv6 hints]]]
        [v4: [match p.ipv4-hint
          [Absent.Absent]: [await v4-task]
          [let hints]:     [map IpAddress.Ipv4 hints]]]
        [connect-host: [match sm.target [Absent.Absent]: host  [let t]: t]]
        [use-port:     [match p.port [Absent.Absent]: port  [let q]: q]]
        [alpn:         [match p.alpn [Absent.Absent]: []    [let a]: a]]
        [ech:          [match p.ech  [Absent.Absent]: [bytes 0]  [let e]: e]]
        [http-protocol-race cap connect-host use-port alpn [interleave v6 v4] ech]
      null:
        # No SVCB — Happy Eyeballs TCP + TLS with H2/H1.1 ALPN negotiation.
        [addrs: [interleave
          [match [try [await v6-task]] [Result.Ok a]: a [Result.Error _]: []]
          [match [try [await v4-task]] [Result.Ok a]: a [Result.Error _]: []]]]
        [$addrs | [happy-connect cap port] | [tls-with-sni host ["h2" "http/1.1"] [] SystemRoots] | h2]]

  # fetch: high-level HTTP request. Returns [or RawResponse HttpError].
  # Transport failures (DNS, TCP, TLS) surface as NetError or TlsError from http-connect.
  fetch: [fn@[return: [or RawResponse HttpError]] [let cap@NetCap url@Url  max-decompressed@[type: Int  default: 268435456]]
    [host: [or url.host [error "fetch: URL has no host"]]]
    [port: [or url.port [scheme-default-port url.scheme]]]
    [conn: [http-connect cap host port]]
    [decompress-response
      [await [http-request conn [method: "GET"  path: url.path  headers: []  body: []  host: host]]]
      max-decompressed]]

  fetch-h1: [fn [let cap@NetCap url@Url]
    [host: [or url.host [error "fetch-h1: no host"]]]
    [port: [or url.port [scheme-default-port url.scheme]]]
    [raw:  [connect cap [host-port [hostname host] port] Tcp]]
    [http1-request raw "GET" url.path [] [] host]]

  headers-map: [fn [let req@RawRequest] req.headers]

  # SECURITY: disable compression on endpoints that reflect user-controlled
  # input alongside secrets in the same compressed stream — CRIME/BREACH attacks
  # exploit compression ratio leakage when attacker-controlled and secret bytes
  # share a compressed context.
  #
  # registry: optional user codecs passed through to negotiate-encoding.
  compression: [fn [let registry@[type: [Map String CompressedCodec]  default: []]
                        handler@[Fn [RawRequest] RawResponse]]
    [fn [let req@RawRequest]
      [resp: [handler req]]
      [ae: [get? req.headers "accept-encoding"]]
      [if [null? ae]
        resp
        [block
          [codec: [negotiate-encoding ae registry]]
          [if [= codec.name "identity"]
            resp
            [RawResponse
              [status:  resp.status
               headers: [merge resp.headers ["content-encoding": codec.name]]
               body:    [codec.encode resp.body]]]]]]]]

  logging: [fn [let handler@[Fn [RawRequest] RawResponse]]
    [fn [let req@RawRequest]
      [t0:   [now %clock]]
      [resp: [handler req]]
      [log [str req.method " " req.path " → " resp.status " (" [timestamp-diff [now %clock] t0] "ms)"]]
      resp]]

  timeout: [fn [let ms@Int handler@[Fn [RawRequest] RawResponse]]
    [fn [let req@RawRequest]
      [match [try [await [async-timeout [millis ms] [task [handler req]]]]]
        [Result.Ok resp]:    resp
        [Result.Error _]:    [RawResponse [status: 503  headers: []  body: [str-bytes "Request timeout"]]]]]]

  cors: [fn [let origins@[Seq String] handler@[Fn [RawRequest] RawResponse]]
    [fn [let req@RawRequest]
      [origin:  [or [get? req.headers "origin"] "*"]]
      [allowed: [if [empty? origins] true [any? [fn [let o] [= o origin]] origins]]]
      [resp: [handler req]]
      [if allowed
        [RawResponse [status: resp.status  body: resp.body
          headers: [merge resp.headers
            ["access-control-allow-origin":  origin
             "access-control-allow-methods": "GET, POST, PUT, DELETE, OPTIONS"
             "access-control-allow-headers": "content-type, authorization"]]]]
        resp]]]

  auth: [fn [let check@[Fn [RawRequest] Bool] handler@[Fn [RawRequest] RawResponse]]
    [fn [let req@RawRequest]
      [if [check req]
        [handler req]
        [RawResponse [status: 401  headers: []  body: [str-bytes "Unauthorized"]]]]]]
]
