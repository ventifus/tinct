{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-6[1m]"
  },
  "permissions": {
    "allow": [
      "mcp__tracker__*",
      "mcp__mempalace-tinct__*"
    ],
    "deny": [
      "Bash",
      "Edit(/tmp/**)",
      "Edit(../**/tmp/**)",
      "Edit(**/*.py)",
      "Edit(**/*.sh)",
      "Edit(**/plugins/**)"
    ]
  },
  "mcpServers": {
    "mempalace-tinct": {
      "command": "python3",
      "args": ["-m", "mempalace.mcp_server", "--palace", "/home/adenton/Projects/tinct/.mempalace"],
      "type": "stdio"
    }
  }
}
